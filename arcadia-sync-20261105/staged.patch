+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/disable-tunnel.sh
@@ -0,0 +1,37 @@
+#!/bin/bash
+# Выключает туннель: выгружает агент туннеля, снимает метку «включён», возвращает пустой
+# PLAN_FACT_ALLOWED_ORIGINS и перезапускает сервер, чтобы он перестал принимать имя туннеля.
+# Метку снимаем первой: даже если выгрузка агента не удастся, туннель после перезапуска сам не поднимется.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=tunnel-common.sh
+. "$SCRIPT_DIR/tunnel-common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: disable-tunnel.sh'
+# Выключение не зависит от настроек туннеля (логин, порт, сервер): оно должно работать и при испорченных значениях.
+load_stand_config
+[ ! -L "$TUNNEL_FLAG" ] || fail 'Метка launchd/.tunnel-enabled не должна быть символической ссылкой.'
+
+rm -f -- "$TUNNEL_FLAG"
+if launchd_enabled; then
+  bootout_agent "$TUNNEL_LABEL"
+fi
+# В корпоративном режиме origin является частью зарегистрированного входа.
+# Остановка туннеля не должна портить конфигурацию и переводить сервер к локальному входу.
+if [ "$PLAN_FACT_AUTH_MODE" = corporate-idm ]; then
+  printf 'Туннель выключен. Зарегистрированный корпоративный адрес и режим входа сохранены.\n'
+  exit 0
+fi
+set_stand_setting PLAN_FACT_ALLOWED_ORIGINS ''
+printf 'Туннель выключен: агент выгружен, адрес убран из настроек стенда.\n'
+if ! launchd_enabled; then
+  printf 'Проверочная установка без автозапуска: сервер не перезапускается.\n'
+  exit 0
+fi
+if app_agent_loaded; then
+  printf 'Перезапускаю сервер, чтобы он перестал принимать имя туннеля…\n'
+  restart_app_agent
+  printf 'Сервер перезапущен и отвечает.\n'
+else
+  printf 'Сервер сейчас не запущен: новые настройки он примет при запуске.\n'
+fi
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/laptop/enable-tunnel.sh b/junk/padolskiye/plan_fact_minipc/deploy/laptop/enable-tunnel.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/enable-tunnel.sh
@@ -0,0 +1,75 @@
+#!/bin/bash
+# Включает туннель: записывает его адрес в PLAN_FACT_ALLOWED_ORIGINS (config.env), перезапускает сервер,
+# загружает агент туннеля и ждёт, пока /api/ready ответит через адрес туннеля (до 60 секунд).
+# Повторный запуск безопасен. После переустановки стенда (install.sh) запускайте его снова.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=tunnel-common.sh
+. "$SCRIPT_DIR/tunnel-common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: enable-tunnel.sh'
+load_tunnel_config strict
+if [ "$PLAN_FACT_AUTH_MODE" = corporate-idm ]; then
+  [ "$TUNNEL_URL" = "$PLAN_FACT_CORPORATE_PUBLIC_URL" ] || fail 'Адрес туннеля отличается от зарегистрированного корпоративного адреса. Настройки не изменены.'
+fi
+find_dk || fail "Не найден клиент dk. Установите: $TUNNEL_INSTALL_HINT"
+[ ! -L "$TUNNEL_FLAG" ] || fail 'Метка launchd/.tunnel-enabled не должна быть символической ссылкой.'
+
+WAIT=${PLANFACT_TUNNEL_WAIT_SECONDS:-60}
+POLL=${PLANFACT_TUNNEL_POLL_SECONDS:-2}
+[[ "$WAIT" =~ ^[0-9]{1,4}$ ]] || WAIT=60
+[[ "$POLL" =~ ^[1-9][0-9]{0,2}$ ]] || POLL=2
+
+# Всё, что может не получиться без изменений, проверяем до записи настроек.
+if launchd_enabled; then
+  [ -f "$AGENT_DIR/$TUNNEL_LABEL.plist" ] || fail 'Не найден установленный агент туннеля. Повторите установку из мастерской (deploy/laptop/install.sh).'
+  [ -f "$AGENT_DIR/$APP_LABEL.plist" ] || fail 'Не найден установленный агент сервера. Повторите установку из мастерской.'
+fi
+
+mark_enabled() {
+  : > "$TUNNEL_FLAG"
+  chmod 600 "$TUNNEL_FLAG"
+}
+
+set_stand_setting PLAN_FACT_ALLOWED_ORIGINS "$TUNNEL_URL"
+printf 'Адрес туннеля записан в настройки стенда: %s\n' "$TUNNEL_URL"
+if ! launchd_enabled; then
+  mark_enabled
+  printf 'Проверочная установка без автозапуска: сервер и агент туннеля не перезапускаются. Для ручной проверки перезапустите run-app.sh и запустите tunnel-run.sh --now.\n'
+  exit 0
+fi
+
+printf 'Перезапускаю сервер, чтобы он принял адрес туннеля…\n'
+restart_app_agent
+# Метка «включён» ставится только после того, как сервер поднялся: иначе после неудачи туннель всё равно
+# поднимался бы сам после перезагрузки.
+mark_enabled
+printf 'Включаю агент туннеля…\n'
+bootout_agent "$TUNNEL_LABEL"
+launchctl bootstrap "$LAUNCH_DOMAIN" "$AGENT_DIR/$TUNNEL_LABEL.plist" >/dev/null 2>&1 || fail 'Не удалось включить агент туннеля.'
+printf 'Жду ответа стенда через адрес туннеля (до %s секунд)…\n' "$WAIT"
+if wait_for_200 "$TUNNEL_URL/api/ready" "$WAIT" "$POLL"; then
+  printf 'Туннель включён: стенд отвечает через адрес туннеля (/api/ready — 200).\n'
+  printf 'Адрес для коллег: %s\n' "$TUNNEL_URL"
+  exit 0
+fi
+
+printf 'Через %s секунд адрес туннеля не ответил (последний код: %s).\n' "$WAIT" "$WAIT_LAST_CODE"
+case "$WAIT_LAST_CODE" in
+  000)
+    if [ "$WAIT_LAST_STATUS" -eq 60 ]; then
+      printf 'Сертификат адреса туннеля не принят: нужен внутренний сертификат Яндекса, как для браузера. Туннель при этом может работать: проверьте адрес в браузере.\n'
+    else
+      printf 'Адрес не открывается: проверьте сетевой доступ (bin/tunnel-check.sh) и logs/tunnel.log.\n'
+    fi ;;
+  403) printf 'Стенд отказал по имени (host_forbidden или origin_forbidden): адрес, с которым приходят запросы, не совпал с записанным в PLAN_FACT_ALLOWED_ORIGINS.\n' ;;
+  503) printf 'Сервер или корпоративная проверка доступа ещё не готовы. Проверьте безопасную диагностику /api/ready и подключение служб.\n' ;;
+  502|504) printf 'Tunneler не нашёл туннель: он ещё не поднялся или оборвался. Смотрите logs/tunnel.log.\n' ;;
+  *) printf 'Неожиданный ответ. Смотрите logs/tunnel.log и logs/app.stderr.log.\n' ;;
+esac
+if [ -f "$STAND/logs/tunnel.log" ] && [ ! -L "$STAND/logs/tunnel.log" ]; then
+  printf 'Последние строки logs/tunnel.log:\n'
+  tail -n 5 "$STAND/logs/tunnel.log"
+fi
+printf 'Агент туннеля остаётся включённым и продолжает попытки. Остановить: bin/disable-tunnel.sh.\n'
+exit 1
