+#!/bin/bash
+# Сервер PostgreSQL стенда (служба ru.planfact.mvp.postgres). Настройки — в конце pgdata/postgresql.conf
+# (их записывает install-django.sh): только сокет в закрытой папке стенда, без TCP.
+# shellcheck source=common-django.sh
+. "$(dirname -- "${BASH_SOURCE[0]}")/common-django.sh"
+[ -s "$PGDATA_DIR/PG_VERSION" ] || fail "Нет данных PostgreSQL в $PGDATA_DIR. Сначала выполните install-django.sh."
+private_dir "$STAND/run" "$PG_SOCKET_DIR" "$STAND/logs"
+if [ -d "$PG_LIBS" ] && [ -n "$(ls -A "$PG_LIBS" 2>/dev/null)" ]; then
+  export LD_LIBRARY_PATH="$PG_LIBS"
+fi
+# exec: процессом службы становится сам postgres, он и сообщает systemd о готовности (Type=notify).
+exec "$PG_BIN/postgres" -D "$PGDATA_DIR" >> "$STAND/logs/postgres.log" 2>&1
