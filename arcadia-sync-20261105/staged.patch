+"""Общие помощники тестов: настройки «как у стенда», HTTP-клиент к живому серверу, cookie."""
+
+from __future__ import annotations
+
+import http.client
+import json
+import os
+import re
+import tempfile
+from pathlib import Path
+from typing import Any
+
+from django.conf import settings
+from django.test import LiveServerTestCase
+
+from planfact import runtime
+from planfact.config import load_config
+
+TUNNEL_ORIGIN = "https://plan-fact.tunnel.example"
+GENERIC_FAILURE = {
+    "error": "Неверный логин или код. После 5 ошибок подряд вход блокируется на 15 минут.",
+    "code": "authentication_required",
+}
+LOGIN_REQUIRED = {"code": "login_required", "authMode": "access-code"}
+CLEARED_COOKIE = "plan_fact_session=; Path=/; HttpOnly; SameSite=Strict; Max-Age=0"
+WRONG_CODE = "ZZZZZ-ZZZZZ-ZZZZZ-ZZZZZ"
+APP_DIR = Path(__file__).resolve().parents[3] / "app"
+
+
+def stand_env(root: Path, **overrides: str) -> dict:
+    env = {
+        "NODE_ENV": "development",
+        "PLAN_FACT_AUTH_MODE": "access-code",
+        "PLAN_FACT_DATABASE_URL": os.environ.get("PLAN_FACT_DATABASE_URL", ""),
+        "PLAN_FACT_CODES_DIR": str(root / "codes"),
+        "PLAN_FACT_HOST": "127.0.0.1",
+        "PLAN_FACT_ALLOWED_ORIGINS": TUNNEL_ORIGIN,
+        "PLAN_FACT_SECURE_COOKIES": "false",
+        "PLAN_FACT_STATIC_DIR": str(APP_DIR),
+        "PLAN_FACT_EVENTS_HEARTBEAT_MS": "50",
+    }
+    env.update(overrides)
+    return env
+
+
+class Response:
+    def __init__(self, status: int, headers: list[tuple[str, str]], text: str):
+        self.status = status
+        self.headers = headers
+        self.text = text
+        try:
+            self.json = json.loads(text)
+        except ValueError:
+            self.json = None
+
+    def header(self, name: str) -> str | None:
+        values = [value for key, value in self.headers if key.lower() == name.lower()]
+        return ", ".join(values) if values else None
+
+
+class Api:
+    def __init__(self, base_url: str):
+        self.base_url = base_url
+        match = re.match(r"http://([^:/]+):(\d+)", base_url)
+        self.host = match.group(1)
+        self.port = int(match.group(2))
+
+    def call(self, method: str, path: str, *, body: Any = None, origin: str | None = None, cookie: str | None = None,
+             headers: dict | None = None, host: str | None = None, raw_body: bytes | None = None) -> Response:
+        connection = http.client.HTTPConnection(self.host, self.port, timeout=30)
+        request_headers = {"Host": host if host is not None else f"{self.host}:{self.port}"}
+        data = raw_body
+        if body is not None:
+            data = body.encode("utf-8") if isinstance(body, str) else json.dumps(body, ensure_ascii=False).encode("utf-8")
+            request_headers["Content-Type"] = "application/json"
+        if origin:
+            request_headers["Origin"] = origin
+        if cookie:
+            request_headers["Cookie"] = cookie
+        request_headers.update(headers or {})
+        try:
+            connection.putrequest(method, path, skip_host=True, skip_accept_encoding=True)
+            for name, value in request_headers.items():
+                connection.putheader(name, value)
+            if data is not None:
+                connection.putheader("Content-Length", str(len(data)))
+            connection.endheaders(data)
+            response = connection.getresponse()
+            text = response.read().decode("utf-8", errors="replace")
+            return Response(response.status, response.getheaders(), text)
+        finally:
+            connection.close()
+
+    def get(self, path: str, **options) -> Response:
+        return self.call("GET", path, **options)
+
+    def post(self, path: str, body: Any, **options) -> Response:
+        options.setdefault("origin", self.base_url)
+        return self.call("POST", path, body=body, **options)
+
+    def login(self, login: Any, code: Any, **options) -> Response:
+        options.setdefault("origin", self.base_url)
+        return self.call("POST", "/api/login", body={"login": login, "code": code}, **options)
+
+
+def session_cookie_of(response: Response, name: str = "plan_fact_session") -> tuple[str, list[str]]:
+    header = response.header("Set-Cookie")
+    assert header, "ответ должен ставить cookie сессии"
+    pair, *attributes = [part.strip() for part in header.split(";")]
+    assert re.fullmatch(rf"{re.escape(name)}=[A-Za-z0-9_-]{{43}}", pair), pair
+    return pair, attributes
+
+
+class StandTestCase(LiveServerTestCase):
+    """Живой сервер на случайном порту с настройками стенда; пользователи alice (superadmin) и bob (admin)."""
+
+    env_overrides: dict = {}
+    host = "127.0.0.1"
+
+    def setUp(self) -> None:
+        super().setUp()
+        self._tmp = tempfile.TemporaryDirectory(prefix="plan-fact-django-")
+        self.root = Path(self._tmp.name)
+        self.config = load_config(stand_env(self.root, **self.env_overrides))
+        self.service = runtime.configure(self.config)
+        self.api = Api(self.live_server_url)
+        self.users = {
+            "alice": self.service.provision_staff_account(staff_login="alice", name="Алиса", role="superadmin")["account"],
+            "bob": self.service.provision_staff_account(staff_login="bob", name="Боб", role="admin")["account"],
+        }
+        self.codes = {
+            "alice": self.service.issue_access_code("alice")["code"],
+            "bob": self.service.issue_access_code("bob")["code"],
+        }
+
+    def tearDown(self) -> None:
+        self.service.realtime.close()
+        runtime.configure(settings.PLAN_FACT)
+        self._tmp.cleanup()
+        super().tearDown()
+
+    def reconfigure(self, **overrides: str) -> None:
+        self.config = load_config(stand_env(self.root, **{**self.env_overrides, **overrides}))
+        self.service = runtime.configure(self.config)
+
+    def audit(self, action: str) -> list[dict]:
+        return [event for event in self.service.store.list_audit(limit=500) if event["action"] == action]
+
+    def access_code(self, login: str):
+        return self.service.store.get_access_code(self.users[login]["id"])
