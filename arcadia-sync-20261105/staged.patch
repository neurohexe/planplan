+for (const file of files) {
+  if (!fs.statSync(file).isFile()) continue;
+  const text = fs.readFileSync(file, 'utf8');
+  assert(!text.includes(token) && !text.includes(password), file);
+}
+NODE
+"$STAND/bin/uninstall.sh" >/dev/null
+check 'удаление стенда убирает и службы копии в Трекер' /bin/bash -c '! ls "$1" | grep -q offsite' _ "$UNITS"
