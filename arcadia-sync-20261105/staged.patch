+    if code and any(normalize_code(og(item, "code")) == code for item in nxt["locations"]):
+        raise DomainError("Код локации уже используется")
+    nxt["locations"].append({"id": identifier, "name": name, "code": clean_text(_p(payload, "code"), 80), "archived": False})
