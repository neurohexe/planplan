diff --git a/junk/padolskiye/plan_fact_minipc/backend/tests/corporate-http.test.js b/junk/padolskiye/plan_fact_minipc/backend/tests/corporate-http.test.js
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/backend/tests/corporate-http.test.js
@@ -0,0 +1,114 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+const crypto = require("node:crypto");
+const http = require("node:http");
+const { PlanFactHttpServer } = require("../src/http-server.js");
+const { CorporateLoginFlow } = require("../src/corporate-login.js");
+const { createIdentityProvider } = require("../src/identity-provider.js");
+const { loadConfig } = require("../src/config.js");
+const { RealtimeHub } = require("../src/realtime.js");
+
+const origin = "https://plan-fact.example.test";
+async function withServer(run, { unconfigured = false, deny = false } = {}) {
+  const config = { ...loadConfig({ NODE_ENV: "development", PLAN_FACT_AUTH_MODE: "corporate-idm", PLAN_FACT_ROLE_SOURCE: "tirole", PLAN_FACT_STORAGE_DRIVER: "sqlite", PLAN_FACT_DEPLOYMENT_PROFILE: "laptop-mvp", PLAN_FACT_SECURE_COOKIES: "true", PLAN_FACT_CORPORATE_PUBLIC_URL: origin, PLAN_FACT_ALLOWED_ORIGINS: origin, PLAN_FACT_IDM_SYSTEM_SLUG: "plan-fact-test", PLAN_FACT_TVM_SELF_ALIAS: "plan_fact", PLAN_FACT_IDM_REQUEST_URL: "https://idm.yandex-team.ru/system/plan-fact-test" }), port: 0 };
+  let loggedIn = false;
+  let verifierCalls = 0;
+  const session = { id: "fictional-session", user: { id: "alice", role: "member" } };
+  const service = {
+    async sessionByToken(token) { return loggedIn && token === "fictional-session-token" ? session : null; },
+    async loginWithStaff({ identity }) {
+      assert.deepEqual({ login: identity.login, uid: identity.uid }, { login: "alice", uid: "101" });
+      if (deny) throw Object.assign(new Error("Нет доступа к приложению"), { statusCode: 403 });
+      loggedIn = true;
+      return { session, token: "fictional-session-token" };
+    },
+    async authSummary() { return { user: { id: "alice", role: "member" } }; },
+    async stateFor(value) { if (!value) throw Object.assign(new Error("Войдите через Staff"), { statusCode: 401 }); return { revision: 0 }; },
+    async logout() { loggedIn = false; },
+    async readiness() { return { status: "ready" }; }
+  };
+  const adapter = {
+    diagnostics() { return { status: "ready" }; },
+    async begin() {
+      const state = crypto.randomBytes(24).toString("hex");
+      return { state, authorizationUrl: `https://oauth.yandex-team.ru/authorize?response_type=code&state=${state}` };
+    },
+    async complete() { verifierCalls++; return { login: "alice", uid: "101", expiresAt: Date.now() + 60_000 }; }
+  };
+  const server = new PlanFactHttpServer({ service, config, realtime: new RealtimeHub(), identityProvider: createIdentityProvider(config), corporateLogin: unconfigured ? null : new CorporateLoginFlow({ publicUrl: origin, adapter }) });
+  const address = await server.listen();
+  const base = `http://127.0.0.1:${address.port}`;
+  const request = (route, options = {}) => fetch(`${base}${route}`, { redirect: "manual", ...options });
+  const requestHost = (host) => new Promise((resolve, reject) => {
+    const req = http.get(`${base}/api/auth`, { headers: { Host: host, Origin: origin } }, response => { response.resume(); response.on("end", () => resolve(response.statusCode)); });
+    req.on("error", reject);
+  });
+  try { await run({ request, requestHost, verifierCalls: () => verifierCalls }); } finally { await server.close(); }
+}
+
+test("CorporateHTTP_LoginCallbackRefreshLogoutUsesApplicationSession", async () => {
+  await withServer(async ({ request, verifierCalls }) => {
+    const before = await request("/api/auth", { headers: { "x-plan-fact-staff-login": "alice", "x-plan-fact-staff-uid": "101" } });
+    assert.equal(before.status, 401);
+    assert.equal((await before.json()).authMode, "corporate-idm");
+    const start = await request("/api/corporate/login", { headers: { "x-forwarded-host": "evil.example", "x-forwarded-proto": "http" } });
+    assert.equal(start.status, 303);
+    const cookie = start.headers.getSetCookie()[0];
+    assert.match(cookie, /__Host-.*HttpOnly; SameSite=Lax/);
+    const state = new URL(start.headers.get("location")).searchParams.get("state");
+    const callback = await request(`/api/corporate/callback?state=${state}&token=fictional-exchange-token`, { headers: { Cookie: cookie.split(";")[0] } });
+    assert.equal(callback.status, 303);
+    assert.equal(callback.headers.get("location"), "/");
+    assert.equal(callback.headers.get("referrer-policy"), "no-referrer");
+    const applicationCookie = callback.headers.getSetCookie().find(value => value.startsWith("__Host-plan_fact_session="));
+    assert.match(applicationCookie, /HttpOnly; SameSite=Strict; Secure/);
+    assert.doesNotMatch(applicationCookie, /fictional-exchange-token/);
+    const headers = { Cookie: applicationCookie.split(";")[0] };
+    assert.equal((await request("/api/auth", { headers })).status, 200);
+    assert.equal((await request("/api/state", { headers })).status, 200);
+    assert.equal(verifierCalls(), 1, "Refresh must not ask for corporate-domain cookies");
+    assert.equal((await request("/api/state", { headers: { Cookie: `${headers.Cookie}; ${headers.Cookie}` } })).status, 401);
+    assert.equal((await request("/api/logout", { method: "POST", headers: { ...headers, Origin: origin, "Content-Type": "application/json" }, body: "{}" })).status, 200);
+    assert.equal((await request("/api/auth", { headers })).status, 401);
+  });
+});
+
+test("CorporateHTTP_OriginHostOldCodeIdmAndDirectIdentityCannotBypassLogin", async () => {
+  await withServer(async ({ request, requestHost }) => {
+    for (const route of ["/api/login", "/api/logout", "/api/mutate", "/api/locks/acquire"]) {
+      for (const suppliedOrigin of [null, "https://evil.example"]) {
+        const response = await request(route, { method: "POST", headers: { "Content-Type": "application/json", ...(suppliedOrigin ? { Origin: suppliedOrigin } : {}) }, body: '{"login":"alice","uid":"101","code":"fictional"}' });
+        assert.equal(response.status, 403, route);
+      }
+    }
+    assert.equal(await requestHost("evil.example"), 403);
+    assert.equal((await request("/api/login", { method: "POST", headers: { Origin: origin, "Content-Type": "application/json" }, body: "{}" })).status, 404);
+    assert.equal((await request("/idm/info/")).status, 403);
+    assert.equal((await request("/idm/add-role/", { method: "POST" })).status, 403);
+  });
+});
+
+test("CorporateHTTP_CallbackFailuresScrubParametersAndDistinguishNoRole", async () => {
+  await withServer(async ({ request }) => {
+    const start = await request("/api/corporate/login");
+    const state = new URL(start.headers.get("location")).searchParams.get("state");
+    const callback = await request(`/api/corporate/callback?state=${state}&token=fictional-exchange-token`, { headers: { Cookie: start.headers.getSetCookie()[0].split(";")[0] } });
+    assert.equal(callback.headers.get("location"), "/?login_error=no_access");
+    assert.equal((await request("/api/auth")).status, 401);
+    const replay = await request(`/api/corporate/callback?state=${state}&token=fictional-exchange-token`);
+    assert.equal(replay.headers.get("location"), "/?login_error=access_check_failed");
+    assert.doesNotMatch(await replay.text(), /fictional-exchange-token/);
+  }, { deny: true });
+});
+
+test("CorporateHTTP_UnconfiguredRealAdaptersKeepReadinessClosed", async () => {
+  await withServer(async ({ request }) => {
+    const ready = await request("/api/ready");
+    assert.equal(ready.status, 503);
+    assert.equal((await ready.json()).loginStatus, "not_configured");
+    assert.equal((await request("/api/corporate/login")).status, 503);
+    assert.equal((await request("/api/state")).status, 401);
+  }, { unconfigured: true });
+});
diff --git a/junk/padolskiye/plan_fact_minipc/backend/tests/corporate-identity-sessions.test.js b/junk/padolskiye/plan_fact_minipc/backend/tests/corporate-identity-sessions.test.js
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/backend/tests/corporate-identity-sessions.test.js
@@ -0,0 +1,257 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+const { inspect } = require("node:util");
+const { CorporateIdentitySessions } = require("../src/corporate-identity-sessions.js");
+
+const alice = Object.freeze({ login: "alice", uid: "101" });
+const ip = "192.0.2.1";
+const failure = { statusCode: 503, code: "corporate_identity_unavailable" };
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((yes, no) => { resolve = yes; reject = no; });
+  return { promise, resolve, reject };
+}
+
+function fixture(options = {}) {
+  let now = 1_800_000_000_000;
+  let calls = 0;
+  let verifier = async () => alice;
+  const sessions = new CorporateIdentitySessions({
+    clock: () => now,
+    verifyCredential: async (input) => { calls++; return verifier(input); },
+    ...options
+  });
+  return {
+    sessions, get now() { return now; }, get calls() { return calls; },
+    advance(ms) { now += ms; }, setVerifier(fn) { verifier = fn; },
+    bind(id = "session-alice", overrides = {}) {
+      return sessions.bind(id, { credential: "fictional-webauth-credential", identity: alice,
+        expiresAt: now + 3_600_000, clientIp: ip, ...overrides });
+    }
+  };
+}
+
+test("CorporateIdentitySessions_InitialLeaseUsesCallbackIdentityAndRenewsAfterThirtySeconds", async () => {
+  const f = fixture();
+  assert.deepEqual(f.bind(), alice);
+  assert.deepEqual(f.sessions.assertVerified("session-alice"), alice);
+  f.advance(30_000);
+  assert.deepEqual(await f.sessions.verify("session-alice", { clientIp: ip }), alice);
+  assert.equal(f.calls, 0);
+  f.advance(1);
+  assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  assert.deepEqual(await f.sessions.verify("session-alice", { clientIp: ip }), alice);
+  assert.equal(f.calls, 1);
+  assert.deepEqual(f.sessions.assertVerified("session-alice"), alice);
+});
+
+test("CorporateIdentitySessions_ServerExpiryErasesCredentialAndCannotBeRenewed", async () => {
+  const f = fixture();
+  f.bind(undefined, { expiresAt: f.now + 500 });
+  f.advance(500);
+  assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  await assert.rejects(f.sessions.verify("session-alice", { clientIp: ip }), failure);
+  assert.equal(f.calls, 0);
+});
+
+test("CorporateIdentitySessions_BindingKeepsUpstreamStartTimeAndRejectsStaleConfirmation", () => {
+  const f = fixture();
+  const verifiedAt = f.now;
+  f.advance(29_000);
+  f.bind(undefined, { verifiedAt });
+  assert.deepEqual(f.sessions.assertVerified("session-alice"), alice);
+  f.advance(1_001);
+  assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  assert.throws(() => f.bind(undefined, { verifiedAt }), failure);
+  for (const invalid of [f.now + 1, NaN, Infinity, -1, "1800000000000"]) {
+    assert.throws(() => f.bind(undefined, { verifiedAt: invalid }), failure);
+  }
+});
+
+test("CorporateIdentitySessions_ClockRollbackErasesAllConfirmations", async () => {
+  const f = fixture();
+  f.bind();
+  f.bind("session-bob", { identity: { login: "bob", uid: "102" } });
+  f.advance(10_000);
+  f.sessions.assertVerified("session-alice");
+  f.advance(-1);
+  assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  await assert.rejects(f.sessions.verify("session-bob", { clientIp: ip }), failure);
+  f.advance(30_001);
+  await assert.rejects(f.sessions.verify("session-alice", { clientIp: ip }), failure);
+  assert.equal(f.calls, 0);
+});
+
+test("CorporateIdentitySessions_NetworkErrorErasesConfirmationWithoutExposingCredential", async () => {
+  const secret = "fictional-opaque-secret-never-log";
+  const f = fixture();
+  f.bind(undefined, { credential: secret });
+  f.setVerifier(async () => { throw Object.assign(new Error(secret), { credential: secret }); });
+  f.advance(30_001);
+  await assert.rejects(f.sessions.verify("session-alice", { clientIp: ip }), error => {
+    assert.equal(error.code, failure.code);
+    assert.doesNotMatch(`${error.stack} ${JSON.stringify(error)} ${inspect(error)}`, new RegExp(secret));
+    return true;
+  });
+  assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  await assert.rejects(f.sessions.verify("session-alice", { clientIp: ip }), failure);
+  assert.equal(f.calls, 1);
+  assert.doesNotMatch(`${JSON.stringify(f.sessions)} ${inspect(f.sessions)}`, new RegExp(secret));
+});
+
+test("CorporateIdentitySessions_ChangedOrMalformedIdentityErasesAccess", async () => {
+  for (const identity of [{ login: "alice", uid: "102" }, { login: "bob", uid: "101" }, null,
+    { login: "alice", uid: "not-a-uid" }, { login: "alice", uid: 101 }]) {
+    const f = fixture();
+    f.bind();
+    f.setVerifier(async () => identity);
+    f.advance(30_001);
+    await assert.rejects(f.sessions.verify("session-alice", { clientIp: ip }), failure);
+    assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  }
+});
+
+test("CorporateIdentitySessions_ConcurrentVerificationSharesOneUpstreamCall", async () => {
+  const f = fixture();
+  const result = deferred();
+  f.bind();
+  f.advance(30_001);
+  f.setVerifier(() => result.promise);
+  const a = f.sessions.verify("session-alice", { clientIp: ip });
+  const b = f.sessions.verify("session-alice", { clientIp: ip });
+  assert.equal(f.calls, 1);
+  assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  result.resolve(alice);
+  assert.deepEqual(await Promise.all([a, b]), [alice, alice]);
+  assert.deepEqual(f.sessions.assertVerified("session-alice"), alice);
+});
+
+test("CorporateIdentitySessions_LateReplyCannotRestoreForgottenOrReboundSession", async () => {
+  for (const rebind of [false, true]) {
+    const f = fixture();
+    const result = deferred();
+    f.bind();
+    f.advance(30_001);
+    f.setVerifier(() => result.promise);
+    const pending = f.sessions.verify("session-alice", { clientIp: ip });
+    f.sessions.forget("session-alice");
+    const bob = { login: "bob", uid: "102" };
+    if (rebind) f.bind(undefined, { identity: bob, credential: "fictional-new-credential" });
+    result.resolve(alice);
+    await assert.rejects(pending, failure);
+    if (rebind) assert.deepEqual(f.sessions.assertVerified("session-alice"), bob);
+    else assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  }
+});
+
+test("CorporateIdentitySessions_LateFailureCannotEraseNewBinding", async () => {
+  const f = fixture();
+  const result = deferred();
+  f.bind();
+  f.advance(30_001);
+  f.setVerifier(() => result.promise);
+  const pending = f.sessions.verify("session-alice", { clientIp: ip });
+  f.bind();
+  result.reject(new Error("fictional-old-credential"));
+  await assert.rejects(pending, failure);
+  assert.deepEqual(f.sessions.assertVerified("session-alice"), alice);
+});
+
+test("CorporateIdentitySessions_ChangingIpRequiresNewServerCheckAndInvalidatesOldLease", async () => {
+  const f = fixture();
+  const result = deferred();
+  f.bind();
+  const nextIp = "192.0.2.2";
+  f.setVerifier(({ credential, clientIp }) => {
+    assert.equal(credential, "fictional-webauth-credential");
+    assert.equal(clientIp, nextIp);
+    return result.promise;
+  });
+  const pending = f.sessions.verify("session-alice", { clientIp: nextIp });
+  assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  result.resolve(alice);
+  await pending;
+  await f.sessions.verify("session-alice", { clientIp: nextIp });
+  assert.equal(f.calls, 1);
+  f.setVerifier(async ({ clientIp }) => { assert.equal(clientIp, ip); return alice; });
+  await f.sessions.verify("session-alice", { clientIp: ip });
+  assert.equal(f.calls, 2);
+});
+
+test("CorporateIdentitySessions_ConcurrentDifferentIpsFailClosed", async () => {
+  const f = fixture();
+  const result = deferred();
+  f.bind();
+  f.advance(30_001);
+  f.setVerifier(() => result.promise);
+  const a = f.sessions.verify("session-alice", { clientIp: ip });
+  await assert.rejects(f.sessions.verify("session-alice", { clientIp: "192.0.2.2" }), failure);
+  result.resolve(alice);
+  await assert.rejects(a, failure);
+  assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+});
+
+test("CorporateIdentitySessions_ResponseLatencyConsumesLeaseAndStaleReplyIsRejected", async () => {
+  for (const elapsed of [29_000, 30_001]) {
+    const f = fixture();
+    const result = deferred();
+    f.bind();
+    f.advance(30_001);
+    f.setVerifier(() => result.promise);
+    const pending = f.sessions.verify("session-alice", { clientIp: ip });
+    f.advance(elapsed);
+    result.resolve(alice);
+    if (elapsed > 30_000) await assert.rejects(pending, failure);
+    else {
+      await pending;
+      f.sessions.assertVerified("session-alice");
+      f.advance(1_001);
+    }
+    assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  }
+});
+
+test("CorporateIdentitySessions_ExpiryOrRollbackWhileVerifyingCannotInstallLease", async () => {
+  for (const rollback of [false, true]) {
+    const f = fixture();
+    const result = deferred();
+    f.bind(undefined, { expiresAt: f.now + 40_000 });
+    f.advance(30_001);
+    f.setVerifier(() => result.promise);
+    const pending = f.sessions.verify("session-alice", { clientIp: ip });
+    f.advance(rollback ? -1 : 10_000);
+    result.resolve(alice);
+    await assert.rejects(pending, failure);
+    assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  }
+});
+
+test("CorporateIdentitySessions_CapacityPrunesExpiredEntriesAndDoesNotEvictValidSessions", () => {
+  const f = fixture({ maxSessions: 1 });
+  f.bind(undefined, { expiresAt: f.now + 500 });
+  assert.throws(() => f.bind("session-bob"), failure);
+  assert.deepEqual(f.sessions.assertVerified("session-alice"), alice);
+  f.advance(500);
+  f.bind("session-bob", { identity: { login: "bob", uid: "102" } });
+  assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  assert.equal(f.sessions.assertVerified("session-bob").uid, "102");
+  f.sessions.clear();
+  assert.throws(() => f.sessions.assertVerified("session-bob"), failure);
+});
+
+test("CorporateIdentitySessions_InvalidBindingAndSettingsFailClosed", () => {
+  assert.throws(() => new CorporateIdentitySessions(), failure);
+  for (const options of [{ maxAgeMs: 30_001 }, { maxAgeMs: 0 }, { maxSessions: 0 },
+    { verifyCredential: null }, { clock: null }]) assert.throws(() => fixture(options), failure);
+  const f = fixture();
+  for (const invalid of [{ expiresAt: Infinity }, { expiresAt: f.now }, { credential: null },
+    { identity: { login: "alice", uid: "0" } }, { clientIp: "192.0.2.1\nsecret" }]) {
+    f.bind();
+    assert.throws(() => f.bind(undefined, invalid), failure);
+    assert.throws(() => f.sessions.assertVerified("session-alice"), failure);
+  }
+});
