+++ b/junk/padolskiye/plan_fact_minipc/backend/tests/sqlite-to-postgres-migration.test.js
@@ -0,0 +1,82 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+const { migrate } = require("../src/migrate-sqlite-to-postgres.js");
+const { PlanFactService } = require("../src/service.js");
+const { PostgresStore } = require("../src/postgres-store.js");
+const { SqliteStore } = require("../src/sqlite-store.js");
+
+function localDatabaseUrl() {
+  const raw = String(process.env.PLAN_FACT_MIGRATION_TEST_DATABASE_URL || "").trim();
+  if (!raw) return null;
+  const url = new URL(raw);
+  const localHost = url.hostname === "127.0.0.1" || url.hostname === "localhost";
+  if (!localHost || !url.pathname.endsWith("_test")) {
+    throw new Error("PLAN_FACT_MIGRATION_TEST_DATABASE_URL разрешён только для локальной БД с именем *_test");
+  }
+  return raw;
+}
+
+const databaseUrl = localDatabaseUrl();
+const config = databaseUrl ? {
+  storageDriver: "postgres",
+  databaseUrl,
+  databaseSsl: "disable",
+  databaseCaFile: null,
+  databasePoolMax: 4,
+  databaseStatementTimeoutMs: 30_000,
+  production: false
+} : null;
+
+test("SqliteToPostgresMigration_PreservesStateUsersAccessAndAudit", {
+  skip: databaseUrl ? false : "PLAN_FACT_MIGRATION_TEST_DATABASE_URL не задан"
+}, async () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "plan-fact-migration-"));
+  const sqlitePath = path.join(root, "source.sqlite");
+  const sqlite = new SqliteStore(sqlitePath, { initialState: PlanFactService.initialState });
+  const userId = crypto.randomUUID();
+  try {
+    await sqlite.createUser({
+      id: userId,
+      name: "Migration Test",
+      nameKey: "staff:migration.test",
+      staffLogin: "migration.test",
+      staffUid: "445566",
+      role: "superadmin",
+      locationAccess: { test_location: "edit" }
+    });
+    const state = await sqlite.getState();
+    await sqlite.commitStateMutation({
+      expectedRevision: state.revision,
+      nextState: { ...state, revision: state.revision + 1, migrationMarker: "preserved" },
+      audit: {
+        actorId: userId,
+        actorName: "Migration Test",
+        action: "test.sqlite_to_postgres",
+        mutationId: `migration-${crypto.randomUUID()}`
+      }
+    });
+  } finally {
+    sqlite.close();
+  }
+
+  try {
+    await migrate(sqlitePath, config);
+    const postgres = await PostgresStore.create(config, { initialState: PlanFactService.initialState });
+    try {
+      assert.equal((await postgres.getState()).migrationMarker, "preserved");
+      assert.equal(await postgres.countUsers(), 1);
+      assert.deepEqual(await postgres.getLocationAccess(userId), { test_location: "edit" });
+      assert.equal((await postgres.listAudit({ limit: 10 })).length, 1);
+    } finally {
+      await postgres.close();
+    }
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
