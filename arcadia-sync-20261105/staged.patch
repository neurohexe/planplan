+#!/bin/sh
+# Учебный PostgreSQL для тестов и ручных запусков: контейнер planfact-django-pg на 127.0.0.1:18771.
+# Случайный пароль лежит в .sandbox/django-postgres/password (права 600), строка подключения —
+# в .sandbox/django-postgres/env.sh. Пароль на экран не выводится.
+#
+#   sh backend_django/tools/dev-postgres.sh && . .sandbox/django-postgres/env.sh
+set -eu
+
+ROOT=$(cd "$(dirname "$0")/../.." && pwd)
+DIR="$ROOT/.sandbox/django-postgres"
+NAME=planfact-django-pg
+PORT=${PLAN_FACT_DEV_POSTGRES_PORT:-18771}
+
+umask 077
+mkdir -p "$DIR"
+if [ ! -s "$DIR/password" ]; then
+  LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32 >"$DIR/password"
+  printf '\n' >>"$DIR/password"
+fi
+PASSWORD=$(cat "$DIR/password")
+
+if ! docker inspect "$NAME" >/dev/null 2>&1; then
+  printf 'POSTGRES_USER=planfact\nPOSTGRES_DB=planfact\nPOSTGRES_PASSWORD=%s\n' "$PASSWORD" >"$DIR/container.env"
+  docker run -d --name "$NAME" --env-file "$DIR/container.env" -p "127.0.0.1:$PORT:5432" postgres:16 >/dev/null
+  rm -f "$DIR/container.env"
+elif [ "$(docker inspect -f '{{.State.Running}}' "$NAME")" != true ]; then
+  docker start "$NAME" >/dev/null
+fi
+
+printf 'export PLAN_FACT_DATABASE_URL=postgres://planfact:%s@127.0.0.1:%s/planfact\n' "$PASSWORD" "$PORT" >"$DIR/env.sh"
+
+attempt=0
+# По TCP: на время первичной настройки образ запускает временный сервер только на локальном сокете.
+until docker exec "$NAME" pg_isready -q -h 127.0.0.1 -U planfact -d planfact; do
+  attempt=$((attempt + 1))
+  if [ "$attempt" -ge 60 ]; then
+    echo "PostgreSQL в контейнере $NAME не ответил за 60 секунд" >&2
+    exit 1
+  fi
+  sleep 1
+done
+echo "PostgreSQL готов: 127.0.0.1:$PORT, строка подключения — $DIR/env.sh"
