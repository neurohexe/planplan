+"use strict";
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+const crypto = require("node:crypto");
+const { CorporateLoginFlow, assertCorporateModeAllowed } = require("../src/corporate-login.js");
+const { loadConfig } = require("../src/config.js");
+
+function fixture(overrides = {}) {
+  let now = 1_800_000_000_000;
+  let completes = 0;
+  const adapter = {
+    diagnostics() { return { status: "ready" }; },
+    async begin({ callbackUrl }) {
+      assert.equal(callbackUrl, "https://plan-fact.example.test/api/corporate/callback");
+      const state = crypto.randomBytes(24).toString("hex");
+      return { state, authorizationUrl: `https://oauth.yandex-team.ru/authorize?response_type=code&state=${state}`, context: { verifiedContract: true } };
+    },
+    async complete({ context }) {
+      completes++;
+      assert.equal(context.verifiedContract, true);
+      return { login: "alice", uid: "101", expiresAt: now + 60_000 };
+    },
+    ...overrides
+  };
+  const flow = new CorporateLoginFlow({ publicUrl: "https://plan-fact.example.test", adapter, clock: () => now });
+  return { flow, advance(ms) { now += ms; }, completes: () => completes };
+}
+
+async function attempt(flow) {
+  const result = await flow.begin();
+  return { cookie: result.cookie.split(";")[0], url: `/api/corporate/callback?state=${new URL(result.location).searchParams.get("state")}&token=fictional-exchange-token` };
+}
+
+test("CorporateLogin_BrowserBoundOneTimeAttemptAndVerifiedIdentity", async () => {
+  const f = fixture();
+  const a = await attempt(f.flow);
+  assert.deepEqual(await f.flow.complete(a.url, a.cookie), { login: "alice", uid: "101", expiresAt: 1_800_000_060_000 });
+  await assert.rejects(f.flow.complete(a.url, a.cookie), { code: "access_check_failed" });
+  assert.equal(f.completes(), 1);
+});
+
+test("CorporateLogin_MissingWrongDuplicateCookieAndStateDoNotReachVerifier", async () => {
+  for (const variant of ["missing", "other-browser", "duplicate", "wrong-state", "duplicate-state", "foreign-url"]) {
+    const f = fixture();
+    const a = await attempt(f.flow);
+    const b = await attempt(f.flow);
+    const cookie = variant === "missing" ? "" : variant === "other-browser" ? b.cookie : variant === "duplicate" ? `${a.cookie}; ${a.cookie}` : a.cookie;
+    const url = variant === "wrong-state" ? "/api/corporate/callback?state=wrong" : variant === "duplicate-state" ? `${a.url}&state=wrong` : variant === "foreign-url" ? `https://evil.example${a.url}` : a.url;
+    await assert.rejects(f.flow.complete(url, cookie), { code: "access_check_failed" });
+    assert.equal(f.completes(), 0, variant);
+  }
+});
+
+test("CorporateLogin_ExpiryAndConcurrentReplayFailClosed", async () => {
+  const f = fixture();
+  const expired = await attempt(f.flow);
+  f.advance(5 * 60_000);
+  await assert.rejects(f.flow.complete(expired.url, expired.cookie));
+  const current = await attempt(f.flow);
+  const results = await Promise.allSettled([f.flow.complete(current.url, current.cookie), f.flow.complete(current.url, current.cookie)]);
+  assert.equal(results.filter(r => r.status === "fulfilled").length, 1);
+  assert.equal(f.completes(), 1);
+});
+
+test("CorporateLogin_AdapterErrorsMalformedIdentityAndRedirectAreSanitized", async () => {
+  for (const complete of [async () => { throw new Error("secret-upstream-value"); }, async () => ({ login: "alice", uid: "101" }), async () => ({ login: "alice", uid: "101", expiresAt: 1 })]) {
+    const f = fixture({ complete });
+    const a = await attempt(f.flow);
+    await assert.rejects(f.flow.complete(a.url, a.cookie), error => error.code === "access_check_failed" && !JSON.stringify(error).includes("secret-upstream-value"));
+  }
+  const f = fixture({ async begin() { return { state: "a".repeat(32), authorizationUrl: "https://evil.example/" }; } });
+  await assert.rejects(f.flow.begin(), { code: "access_check_failed" });
+});
+
+test("CorporateLogin_DefaultAdapterCannotAuthenticateOrReportReady", async () => {
+  const flow = new CorporateLoginFlow({ publicUrl: "https://plan-fact.example.test" });
+  assert.equal(flow.diagnostics().status, "not_configured");
+  await assert.rejects(flow.begin(), { code: "access_check_failed" });
+});
+
+test("CorporateLogin_UpstreamMustNotReuseStateAcrossBrowsers", async () => {
+  const state = "fictional-state-must-be-unique";
+  const f = fixture({ async begin() { return { state, authorizationUrl: `https://oauth.yandex-team.ru/authorize?state=${state}`, context: { verifiedContract: true } }; } });
+  const first = await attempt(f.flow);
+  await assert.rejects(f.flow.begin(), { code: "access_check_failed" });
+  assert.equal((await f.flow.complete(first.url, first.cookie)).login, "alice");
+});
+
+test("CorporateConfig_RejectsUnsafeCombinationsAndUntrustedReturnAddress", () => {
+  const env = {
+    NODE_ENV: "development", PLAN_FACT_AUTH_MODE: "corporate-idm", PLAN_FACT_ROLE_SOURCE: "tirole",
+    PLAN_FACT_STORAGE_DRIVER: "sqlite", PLAN_FACT_DEPLOYMENT_PROFILE: "laptop-mvp", PLAN_FACT_HOST: "127.0.0.1",
+    PLAN_FACT_SECURE_COOKIES: "true", PLAN_FACT_CORPORATE_PUBLIC_URL: "https://plan-fact.example.test",
+    PLAN_FACT_ALLOWED_ORIGINS: "https://plan-fact.example.test", PLAN_FACT_IDM_SYSTEM_SLUG: "plan-fact-test", PLAN_FACT_TVM_SELF_ALIAS: "plan_fact",
+    PLAN_FACT_IDM_REQUEST_URL: "https://idm.yandex-team.ru/system/plan-fact-test"
+  };
+  assert.doesNotThrow(() => loadConfig(env));
+  for (const extra of [
+    { PLAN_FACT_ROLE_SOURCE: "app" }, { NODE_ENV: "production" }, { PLAN_FACT_STORAGE_DRIVER: "postgres" },
+    { PLAN_FACT_HOST: "0.0.0.0" }, { PLAN_FACT_SECURE_COOKIES: "false" }, { PLAN_FACT_DEPLOYMENT_PROFILE: "full" },
+    { PLAN_FACT_CORPORATE_PUBLIC_URL: "http://localhost" }, { PLAN_FACT_CORPORATE_PUBLIC_URL: "https://plan-fact.example.test/return" },
+    { PLAN_FACT_CORPORATE_PUBLIC_URL: "https://secret@plan-fact.example.test" }, { PLAN_FACT_ALLOWED_ORIGINS: "https://evil.example" },
+    { PLAN_FACT_IDM_SYSTEM_SLUG: "" }, { PLAN_FACT_IDM_REQUEST_URL: "" }, { PLAN_FACT_IDM_REQUEST_URL: "javascript:alert(1)" },
+    { PLAN_FACT_IDM_REQUEST_URL: "https://evil.example/request" }
+  ]) assert.throws(() => loadConfig({ ...env, ...extra }), JSON.stringify(extra));
+  assert.throws(() => assertCorporateModeAllowed({ authMode: "access-code", roleSource: "tirole" }));
+});
diff --git a/junk/padolskiye/plan_fact_minipc/backend/tests/corporate-roles.test.js b/junk/padolskiye/plan_fact_minipc/backend/tests/corporate-roles.test.js
