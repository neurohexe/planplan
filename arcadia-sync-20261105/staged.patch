+#!/bin/bash
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=common.sh
+. "$SCRIPT_DIR/common.sh"
+DELETE_DATA=false
+case "$#" in
+  0) ;;
+  1) [ "$1" = --delete-data ] || fail 'Использование: uninstall.sh [--delete-data]'; DELETE_DATA=true ;;
+  *) fail 'Использование: uninstall.sh [--delete-data]' ;;
+esac
+if [ "$DELETE_DATA" = true ]; then
+  # Удаляем только папку установленного стенда (в ней есть config.env) и называем её целиком.
+  [ -f "$STAND/config.env" ] && [ ! -L "$STAND/config.env" ] || fail "В папке $STAND нет config.env: это не стенд. Ничего не удалено."
+  printf 'Удалить папку стенда %s вместе с данными, кодами и копиями — точно? Введите «да»: ' "$STAND"
+  answer=''
+  read -r answer || true
+  if [ "$answer" != да ]; then
+    printf 'Удаление отменено.\n'
+    exit 0
+  fi
+fi
+stop_agents
+if launchd_enabled; then
+  # Удаляем из LaunchAgents только plist этого стенда; агентов другого стенда оставляем.
+  for file in "$STAND/launchd"/ru.planfact.mvp.*.plist; do
+    [ -f "$file" ] || continue
+    label=$(agent_label "$file")
+    agent_is_ours "$label" || continue
+    rm -f -- "$AGENT_DIR/$label.plist"
+  done
+fi
+for file in "$STAND/launchd"/ru.planfact.mvp.*.plist "$STAND/launchd"/ru.planfact.mvp.*.manual; do
+  [ -f "$file" ] || continue
+  rm -f -- "$file"
+done
+if [ "$DELETE_DATA" = true ]; then
+  rm -rf -- "$STAND"
+  printf 'Агенты и папка стенда удалены.\n'
+else
+  printf 'Агенты удалены. Данные, коды, резервные копии и настройки сохранены.\n'
+fi
