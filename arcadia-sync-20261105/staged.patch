+"""Текущее время и новые идентификаторы для правил данных.
+
+В JavaScript правила брали время из new Date() и идентификаторы из crypto.randomUUID(). Здесь те же
+величины берутся из одного места, чтобы тесты могли их зафиксировать и сверить результат
+со старой реализацией.
+"""
+
+from __future__ import annotations
+
+import contextvars
+import time
+import uuid
+from contextlib import contextmanager
+from typing import Callable, Iterator
+
+_clock: contextvars.ContextVar[Callable[[], int] | None] = contextvars.ContextVar("planfact_clock", default=None)
+_ids: contextvars.ContextVar[Callable[[], str] | None] = contextvars.ContextVar("planfact_ids", default=None)
+_selected_quarter: contextvars.ContextVar[str | None] = contextvars.ContextVar("planfact_selected_quarter", default=None)
+
+
+def now_ms() -> int:
+    """Date.now(): миллисекунды с 1970-01-01 UTC."""
+    override = _clock.get()
+    if override is not None:
+        return override()
+    return time.time_ns() // 1_000_000
+
+
+def new_id() -> str:
+    """crypto.randomUUID()."""
+    override = _ids.get()
+    if override is not None:
+        return override()
+    return str(uuid.uuid4())
+
+
+def selected_quarter_override() -> str | None:
+    return _selected_quarter.get()
+
+
+@contextmanager
+def fixed(clock: Callable[[], int] | None = None, ids: Callable[[], str] | None = None,
+          selected_quarter: str | None = None) -> Iterator[None]:
+    """Подменить часы, генератор идентификаторов и «выбранный квартал» (для тестов)."""
+    clock_token = _clock.set(clock) if clock is not None else None
+    ids_token = _ids.set(ids) if ids is not None else None
+    quarter_token = _selected_quarter.set(selected_quarter) if selected_quarter is not None else None
+    try:
+        yield
+    finally:
+        if quarter_token is not None:
+            _selected_quarter.reset(quarter_token)
+        if ids_token is not None:
+            _ids.reset(ids_token)
+        if clock_token is not None:
+            _clock.reset(clock_token)
