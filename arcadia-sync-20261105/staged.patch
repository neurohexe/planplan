+  grep -qx "TUNNELER_USERNAME=alice" "$1" && grep -qx "TUNNELER_HOST=ws1-tunnelerapi.tunneler-si.yandex-team.ru" "$1"
+' _ "$STUBS/dk.log"
+check 'первым в PATH стоит обёртка ssh из временной папки стенда' /bin/bash -c 'grep -q "^PATH_FIRST=.*/\.tunnel-run\.[A-Za-z0-9]*$" "$1"' _ "$STUBS/dk.log"
+check 'обёртка добавляет проверку связи: ServerAliveInterval 30, 3 попытки, BatchMode, ExitOnForwardFailure' /bin/bash -c '
+  grep -qx "serveraliveinterval 30" "$1" && grep -qx "serveralivecountmax 3" "$1" && grep -qx "batchmode yes" "$1" && grep -qx "exitonforwardfailure yes" "$1" && grep -qx "connecttimeout 10" "$1"
+' _ "$STUBS/dk.log"
+check 'временная папка с обёрткой ssh после выхода удалена' /bin/bash -c '! ls -A "$1" | grep -q "^\.tunnel-run\."' _ "$STAND_A"
+check 'в обычном режиме (агент) подробности ssh не включаются, а в обёртке нет алгоритмов ssh-rsa' /bin/bash -c 'grep -qx "DEBUG=" "$1" && ! grep "^SHIM: " "$1" | grep -q "ssh-rsa"' _ "$STUBS/dk.log"
+rm -f "$STAND_A/launchd/.tunnel-enabled"
+reset_logs
