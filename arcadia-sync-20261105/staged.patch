+def build_sequence(seed: int, initial: dict, length: int, start_ms: int = 1_793_700_000_000) -> dict:
+    generator = Generator(seed)
+    kinds = [kind for kind, weight in MUTATION_WEIGHTS for _ in range(weight)]
+    current = initial
+    steps = []
+    for index in range(length):
+        kind = generator.random.choice(kinds)
+        payload = json.loads(js.dumps(generator.payload_for(kind, current)))
+        # undefined в JSON не передать: генератор использует его только в значениях полей, которые
+        # тогда просто отсутствуют — одинаково для обеих реализаций.
+        step = {"type": kind, "payload": payload, "now": start_ms + index * 61_000, "idPrefix": f"s{seed}-{index}"}
+        outcome = run_python(step["now"], step["idPrefix"], lambda: mutations.apply_local_mutation(current, kind, payload))
+        if outcome["ok"]:
+            current = outcome["value"]
+        steps.append(step)
+    return {"seed": str(seed), "initial": initial, "steps": steps}
