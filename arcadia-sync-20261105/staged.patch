+// Задача 6, находка 6: счётчик ошибок не теряет попытки, даже когда их одновременно записывают несколько процессов с
+// одной базой. Каждая запись — транзакция BEGIN IMMEDIATE (recordAccessCodeFailure); без неё процессы читали бы одно и
+// то же значение и затирали бы ошибки друг друга.
+test("StoreAccessCode_FailuresFromParallelProcessesAreNeverLost", async () => {
+  const fixture = createFixture();
+  try {
+    const alice = await fixture.addUser("alice", "superadmin");
+    fixture.store.saveAccessCode({
+      userId: alice.id, codeHash: "aa", salt: "00", kdfParams: { algorithm: "scrypt" }, issuedAt: "2026-10-10T08:00:00.000Z"
+    });
+    const processes = 4;
+    const attempts = 150;
+    // Порог выше общего числа попыток: блокировка не наступит, и итог обязан быть ровно processes × attempts.
+    const worker = `
+      const { SqliteStore } = require(${JSON.stringify(STORE_PATH)});
+      const store = new SqliteStore(process.argv[1], { initialState: () => ({}) });
+      store.db.exec("PRAGMA busy_timeout = 60000");
+      process.stdin.once("data", () => {
+        for (let attempt = 0; attempt < ${attempts}; attempt += 1) {
+          store.recordAccessCodeFailure(process.argv[2], {
+            now: "2026-10-10T09:00:00.000Z", maxFailures: 1000000, lockMs: 60000
+          });
+        }
+        store.close();
+        process.exit(0);
+      });
+      process.stdout.write("ready\\n");
+    `;
+    const children = Array.from({ length: processes }, () => {
+      const child = spawn(process.execPath, ["--experimental-sqlite", "-e", worker, fixture.databasePath, alice.id]);
+      child.stderrText = "";
+      child.stderr.setEncoding("utf8").on("data", (chunk) => { child.stderrText += chunk; });
+      child.exited = new Promise((resolve) => child.once("exit", resolve));
+      return child;
+    });
+    // Все процессы открыли базу — и стартуют одновременно.
+    await Promise.all(children.map((child) => new Promise((resolve, reject) => {
+      child.stdout.setEncoding("utf8").once("data", resolve);
+      child.exited.then(() => reject(new Error(`процесс завершился до старта: ${child.stderrText}`)));
+    })));
+    for (const child of children) child.stdin.end("go\n");
+    const codes = await Promise.all(children.map((child) => child.exited));
+    assert.deepEqual(codes, Array(processes).fill(0), children.map((child) => child.stderrText).join("\n"));
+    assert.equal(fixture.store.getAccessCode(alice.id).failed_attempts, processes * attempts, "ни одна ошибка не потеряна");
+  } finally {
+    fixture.close();
+  }
+});
