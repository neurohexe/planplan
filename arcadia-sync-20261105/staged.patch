@@ -0,0 +1,28 @@
+"""Завершить все сеансы и снять блокировки записей (перенос deploy/laptop/close-sessions.mjs).
+
+Данные приложения не меняются. В отличие от SQLite, PostgreSQL позволяет сделать это при
+работающем сервере: открытые потоки событий закроются при следующей проверке сессии.
+"""
+
+from __future__ import annotations
+
+import uuid
+
+from django.core.management.base import BaseCommand
+from django.db import transaction
+
+from planfact.store import Store, now_iso
+
+
+class Command(BaseCommand):
+    help = "Завершить все сеансы пользователей и снять блокировки записей"
+
+    def handle(self, *args, **options) -> None:
+        store = Store()
+        with transaction.atomic():
+            sessions, locks = store.close_all_sessions()
+            store.append_audit({
+                "id": str(uuid.uuid4()), "actorName": "Обслуживание стенда", "action": "auth.sessions_cleared",
+                "payload": {"sessions": sessions, "locks": locks}, "createdAt": now_iso(),
+            })
+        self.stdout.write(f"Все сеансы завершены: {sessions}; блокировки освобождены: {locks}. Данные приложения сохранены.")
