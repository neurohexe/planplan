+  [ "$FINISHED" = true ] || [ "$status" -ne 0 ] || status=1
+  exit "$status"
+}
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+check() {
+  local title=$1
+  shift
+  "$@" || { printf 'Не пройдена проверка: %s\n' "$title" >&2; exit 1; }
+  PASSED=$((PASSED + 1))
