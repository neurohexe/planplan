+      querySelectorAll: (selector) => selector === "dialog" ? [dom.authDialog, dom.expenseDialog, dom.forecastDialog, dom.userAdminDialog] : [], getElementById: () => null
+    },
+    window: { clearTimeout() {}, clearInterval() {}, setInterval(fn) { effects.timers.push(fn); return effects.timers.length; } },
+    location: { protocol: "http:", search: "", pathname: "/", reload() { effects.reloads += 1; }, assign(url) { effects.redirects.push(url); } },
+    history: { replaceState(_state, _unused, url) { effects.historyUrl = url; } },
+    console: Object.fromEntries(["log", "warn", "error"].map((key) => [key, (...args) => effects.console.push(args)])),
+    fetch: async (url, options) => {
+      effects.requests.push({ url, options });
+      return fetchImpl(url, options);
+    },
+    uiDom: dom, effects
+  });
+  assert.match(SOURCE, /\}\)\(\);\s*$/);
+  vm.runInContext(SOURCE.replace(/\}\)\(\);\s*$/, `
+    sharedMode = true;
+    Object.assign(dom, globalThis.uiDom);
+    renderAll = () => { effects.renders += 1; renderUser(); };
+    translatePage = () => {};
+    updateStorageMode = () => { effects.storageUpdates += 1; };
+    setSaveStatus = () => {};
+    showToast = (message, isError) => effects.toasts.push({ message, isError });
+    globalThis.authTest = {
+      loadState, refreshAuthSummary, renderAuthDialog, openAuthDialog, retryCorporateLogin,
+      startCorporateLogin, handleSessionExpired, lockRequest, mutate, refreshSharedState,
+      logoutWithAccessCode, renderUser, renderAccessControls,
+      checkCorporateAccess, startCorporateAccessMonitor, locationPermissionClient, canManageUsersClient, canImportExpensesClient,
+      setLocationSearch(search) { location.search = search; },
+      setSession(mode, user, initialState) { authMode = mode; currentUser = user; if (initialState) state = initialState; },
+      snapshot: () => ({ mode: authMode, user: currentUser, state, managedUsers })
+    };
+  })();`), context, { filename: "app.js" });
+  return { api: context.authTest, dom, effects };
+}
