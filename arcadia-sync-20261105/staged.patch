+#!/bin/bash
+# Завершение всех сеансов при явной смене режима входа. Сервер должен быть остановлен.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+. "$SCRIPT_DIR/common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: close-sessions.sh (после остановки сервера)'
+load_stand_config
+[ -f "$PLAN_FACT_DATABASE" ] && [ ! -L "$PLAN_FACT_DATABASE" ] || fail 'Нужен обычный существующий файл базы.'
+# Сначала проверяем и слушающий порт, и открытый файл базы. Никакие коды не читаются.
+if lsof -t -- "$PLAN_FACT_DATABASE" >/dev/null 2>&1; then
+  fail 'База ещё открыта процессом. Остановите сервер и повторите завершение сеансов.'
+fi
+NODE_NO_WARNINGS=1 "$PLAN_FACT_NODE_BIN" --experimental-sqlite "$SCRIPT_DIR/close-sessions.mjs" "$STAND" "$PLAN_FACT_DATABASE" "$PLAN_FACT_PORT"
