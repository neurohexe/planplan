new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/restore.sh
@@ -0,0 +1,54 @@
+#!/bin/bash
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=maintenance-common.sh
+. "$SCRIPT_DIR/maintenance-common.sh"
+RESTORE_STAGE=''
+YES=false
+BACKUP_FILE=''
+finish_restore() {
+  local result=$?
+  [ -z "$RESTORE_STAGE" ] || rm -rf -- "$RESTORE_STAGE"
+  release_data_lock
+  exit "$result"
+}
+trap finish_restore EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+for argument in "$@"; do
+  case "$argument" in
+    --yes) YES=true ;;
+    *) [ -z "$BACKUP_FILE" ] || fail 'Использование: restore.sh <файл копии> [--yes]'; BACKUP_FILE=$argument ;;
+  esac
+done
+[ -n "$BACKUP_FILE" ] || fail 'Использование: restore.sh <файл копии> [--yes]'
+load_stand_config
+export NODE_NO_WARNINGS=1
+RESTORE_STAGE=$("$PLAN_FACT_NODE_BIN" --experimental-sqlite "$SCRIPT_DIR/backup-store.mjs" prepare-restore "$STAND" "$BACKUP_FILE")
+if [ "$YES" = false ]; then
+  printf 'Восстановить эту копию? Текущая база будет сохранена отдельно. Введите «да»: '
+  answer=''
+  read -r answer || true
+  if [ "$answer" != да ]; then
+    printf 'Восстановление отменено.\n'
+    exit 0
+  fi
+fi
+acquire_data_lock
+if systemd_enabled; then
+  require_user_systemd
+  agent_installed "$APP_LABEL" || fail 'Не найдена установленная служба сервера. Повторите установку.'
+  bootout_agent "$APP_LABEL"
+  "$PLAN_FACT_NODE_BIN" "$SCRIPT_DIR/maintenance-server.mjs" wait-stopped "$STAND"
+else
+  "$PLAN_FACT_NODE_BIN" "$SCRIPT_DIR/maintenance-server.mjs" stop-test "$STAND"
+fi
+"$PLAN_FACT_NODE_BIN" --experimental-sqlite "$SCRIPT_DIR/backup-store.mjs" apply-restore "$STAND" "$RESTORE_STAGE"
+if systemd_enabled; then
+  user_systemctl start "$APP_LABEL.service" >/dev/null 2>&1 || fail 'Не удалось запустить сервер после восстановления. Прежняя база сохранена в backups/before-restore-….'
+else
+  "$PLAN_FACT_NODE_BIN" "$SCRIPT_DIR/maintenance-server.mjs" start-test "$STAND"
+fi
+"$PLAN_FACT_NODE_BIN" "$SCRIPT_DIR/maintenance-server.mjs" wait-ready "$STAND"
+printf 'Восстановление завершено. Сервер отвечает и готов к работе.\n'
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/status.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/status.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/status.sh
@@ -0,0 +1,115 @@
+#!/bin/bash
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=common.sh
+. "$SCRIPT_DIR/common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: status.sh'
+load_stand_config
+printf 'Стенд: %s\n' "$STAND"
+http_code=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 3 "http://127.0.0.1:$PLAN_FACT_PORT/api/ready") || http_code=000
+if [ "$http_code" = 200 ]; then
+  printf 'Сервер отвечает и готов к работе.\n'
+else
+  printf 'Сервер пока не готов или не отвечает. Код ответа: %s.\n' "$http_code"
+fi
+if systemd_enabled; then
+  for label in $(stand_labels); do
+    unit=$(agent_unit "$label")
+    if agent_active "$label"; then
+      printf 'Служба %s работает.\n' "$unit"
+    elif [ -f "$SERVICE_DIR/$label.manual" ] && [ ! -f "$SERVICE_DIR/.$(agent_name "$label")-enabled" ]; then
+      printf 'Служба %s выключена (включается отдельно).\n' "$unit"
+    else
+      printf 'Служба %s не работает.\n' "$unit"
+    fi
+  done
+  linger=$(loginctl show-user "$(id -un)" --property=Linger --value 2>/dev/null) || linger=''
+  if [ "$linger" = yes ]; then
+    printf 'После перезагрузки стенд поднимется сам, без входа в систему.\n'
+  else
+    printf 'Внимание: после перезагрузки стенд поднимется только после входа в систему (linger выключен).\n'
+  fi
+else
+  printf 'Автозапуск не включён: проверочная установка.\n'
+fi
+# Слушающие адреса порта: четвёртая колонка вывода ss -Hltn (например, 127.0.0.1:18766).
+if listeners=$(ss -Hltn "sport = :$PLAN_FACT_PORT" 2>/dev/null); then
+  listeners=$(printf '%s\n' "$listeners" | awk 'NF >= 4 { print $4 }' | sort -u)
+  if [ -z "$listeners" ]; then
+    printf 'На порту %s нет слушающего сервера.\n' "$PLAN_FACT_PORT"
+  elif [ "$listeners" = "127.0.0.1:$PLAN_FACT_PORT" ]; then
+    printf 'Сервер доступен только на этом компьютере (127.0.0.1).\n'
+  else
+    printf 'Внимание: порт доступен не только через 127.0.0.1. Проверьте настройки стенда.\n'
+  fi
+else
+  printf 'Не удалось проверить, на каких адресах слушает сервер (нет команды ss).\n'
+fi
+# Шифрование диска: папка стенда должна лежать на зашифрованном разделе (LUKS, тип crypt в цепочке устройств).
+source_device=$(findmnt --noheadings --output SOURCE --target "$STAND" 2>/dev/null | head -n 1) || source_device=''
+device_types=''
+case "$source_device" in
+  /dev/*) device_types=$(lsblk --noheadings --inverse --output TYPE -- "${source_device%%\[*}" 2>/dev/null) || device_types='' ;;
+esac
+if [ -z "$device_types" ]; then
+  printf 'Не удалось проверить шифрование диска.\n'
+elif printf '%s\n' "$device_types" | grep -q -w crypt; then
+  printf 'Шифрование диска (LUKS) включено.\n'
+else
+  printf 'Внимание: папка стенда лежит на незашифрованном диске.\n'
+fi
+permissions_ok=true
+for directory in "$STAND" "$STAND/app" "$STAND/data" "$STAND/backups" "$STAND/backups/hourly" "$STAND/backups/daily" "$STAND/logs" "$STAND/codes" "$STAND/bin" "$SERVICE_DIR"; do
+  mode=$(file_mode "$directory" 2>/dev/null) || mode=''
+  if [ ! -d "$directory" ] || [ -L "$directory" ] || [ "$mode" != 700 ]; then
+    printf 'Внимание: для папки %s нужны права 700 — доступ только владельцу.\n' "$directory"
+    permissions_ok=false
+  fi
+done
+for file in "$STAND/config.env" "$PLAN_FACT_DATABASE"; do
+  [ -e "$file" ] || continue
+  mode=$(file_mode "$file" 2>/dev/null) || mode=''
+  if [ -L "$file" ] || [ "$mode" != 600 ]; then
+    printf 'Внимание: для файла %s нужны права 600 — чтение и запись только владельцу.\n' "$file"
+    permissions_ok=false
+  fi
+done
+# Папка secrets (токен Трекера и пароль копий) появляется только после enable-offsite-backup.sh.
+if [ -e "$STAND/secrets" ] || [ -L "$STAND/secrets" ]; then
+  mode=$(file_mode "$STAND/secrets" 2>/dev/null) || mode=''
+  if [ ! -d "$STAND/secrets" ] || [ -L "$STAND/secrets" ] || [ "$mode" != 700 ]; then
+    printf 'Внимание: для папки %s нужны права 700 — доступ только владельцу.\n' "$STAND/secrets"
+    permissions_ok=false
+  fi
+  for file in "$STAND/secrets/tracker-token" "$STAND/secrets/offsite-password"; do
+    [ -e "$file" ] || [ -L "$file" ] || continue
+    mode=$(file_mode "$file" 2>/dev/null) || mode=''
+    if [ -L "$file" ] || [ "$mode" != 600 ]; then
+      printf 'Внимание: для файла %s нужны права 600 — чтение и запись только владельцу.\n' "$file"
+      permissions_ok=false
+    fi
+  done
+fi
+[ "$permissions_ok" = false ] || printf 'Права папок и файлов настроены верно: доступ только владельцу.\n'
+if [ -f "$PLAN_FACT_DATABASE" ]; then
+  printf 'Размер базы: %s байт.\n' "$(file_size "$PLAN_FACT_DATABASE")"
+else
+  printf 'База ещё не создана: она появится при первом запуске.\n'
+fi
+NODE_NO_WARNINGS=1 "$PLAN_FACT_NODE_BIN" --experimental-sqlite "$SCRIPT_DIR/backup-store.mjs" status "$STAND"
+# Копия в Трекер (если включена): когда последняя ушла в тикет. Больше 26 часов — повод заглянуть в журнал.
+if [ -f "$SERVICE_DIR/.offsite-enabled" ]; then
+  sent_epoch=''
+  sent_day=''
+  sent_time=''
+  if [ -f "$STAND/backups/.offsite-last" ] && [ ! -L "$STAND/backups/.offsite-last" ]; then
+    read -r sent_epoch sent_day sent_time _ < "$STAND/backups/.offsite-last" || true
+  fi
+  if [[ "$sent_epoch" =~ ^[0-9]{1,12}$ ]]; then
+    printf 'Копия в Трекер (%s): последняя отправлена %s %s.\n' "${PLAN_FACT_OFFSITE_ISSUE:-тикет не задан}" "$sent_day" "$sent_time"
+    [ "$(( $(date +%s) - sent_epoch ))" -le 93600 ] || printf 'Внимание: копия в Трекер не уходила больше суток. Подробности — в logs/offsite.log.\n'
+  else
+    printf 'Внимание: копия в Трекер включена, но ещё ни разу не отправлена. Подробности — в logs/offsite.log.\n'
+  fi
+fi
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/test-install.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/test-install.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/test-install.sh
@@ -0,0 +1,366 @@
+#!/bin/bash
+# Проверки Linux-версии стенда (задача 34). Запускаются и на Mac: вместо systemctl, loginctl, ss, findmnt и lsblk —
+# заглушки, домашняя папка подменена, всё — в собственной .sandbox. Живой сервер — только на порту 18767.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)
+BASE_DIR="$PROJECT_ROOT/deploy/laptop"
+NODE_BINARY=$(command -v node)
+unset PLANFACT_HOME PLANFACT_LABEL_SUFFIX PLAN_FACT_TUNNEL_USERNAME
+PASSED=0
+SERVER_PID=''
+DIST_EXISTED=false
+[ ! -e "$PROJECT_ROOT/dist" ] || DIST_EXISTED=true
+mkdir -p "$PROJECT_ROOT/.sandbox"
+TEST_ROOT=$(mktemp -d "$PROJECT_ROOT/.sandbox/task-34.XXXXXX")
+FINISHED=false
+cleanup() {
+  local status=$?
+  if [ -n "$SERVER_PID" ]; then
+    kill -TERM "$SERVER_PID" 2>/dev/null || true
+    wait "$SERVER_PID" 2>/dev/null || true
+  fi
+  # Сервер, запущенный restore.sh в проверочном режиме, останавливаем по его pid-файлу.
+  for pid_file in "$TEST_ROOT"/home/*/data/app.pid; do
+    [ -f "$pid_file" ] || continue
+    kill -TERM "$(cat "$pid_file")" 2>/dev/null || true
+  done
+  rm -rf -- "$TEST_ROOT"
+  [ "$DIST_EXISTED" = true ] || rm -rf -- "$PROJECT_ROOT/dist"
+  rmdir "$PROJECT_ROOT/.sandbox" 2>/dev/null || true
+  # bash 3.2 после ошибки «unbound variable» выходит с кодом последней команды ловушки (0): без отметки о завершении это сбой.
+  [ "$FINISHED" = true ] || [ "$status" -ne 0 ] || status=1
+  exit "$status"
+}
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+check() {
+  local title=$1
+  shift
+  "$@" || { printf 'Не пройдена проверка: %s\n' "$title" >&2; exit 1; }
+  PASSED=$((PASSED + 1))
+  printf 'Пройдена проверка %s: %s.\n' "$PASSED" "$title"
+}
+# Запускает команду, сохраняет вывод в $LAST и код возврата в $LAST_STATUS; сам тест при этом не падает.
+LAST="$TEST_ROOT/last-output.txt"
+run() {
+  LAST_STATUS=0
+  "$@" > "$LAST" 2>&1 || LAST_STATUS=$?
+}
+failed_saying() { [ "$LAST_STATUS" -ne 0 ] && grep -q -F -- "$1" "$LAST"; }
+said() { [ "$LAST_STATUS" -eq 0 ] && grep -q -F -- "$1" "$LAST"; }
+port_is_free() { ! "$NODE_BINARY" -e 'const s=require("node:net").connect(Number(process.argv[1]),"127.0.0.1");s.on("connect",()=>process.exit(0));s.on("error",()=>process.exit(1));' "$1"; }
+check 'порт 18767 свободен' port_is_free 18767
+
+FAKE_HOME="$TEST_ROOT/home"
+UNITS="$FAKE_HOME/.config/systemd/user"
+STUBS="$TEST_ROOT/stubs"
+STATE="$TEST_ROOT/systemctl-state"
+mkdir -p "$FAKE_HOME" "$STUBS" "$STATE"
+export HOME="$FAKE_HOME" STUB_SYSTEMCTL_DIR="$STATE" STUB_UNIT_DIR="$UNITS"
+: > "$STATE/enabled.txt"
+: > "$STATE/active.txt"
+: > "$STATE/calls.log"
+# Модель пользовательского systemd: списки включённых и работающих служб. Служить может только файл из
+# ~/.config/systemd/user подменённой домашней папки; без --user (системные службы) — недопустимое обращение.
+cat > "$STUBS/systemctl" <<'SH'
+#!/bin/bash
+[ -n "${STUB_SYSTEMCTL_DIR:-}" ] && [ "${1:-}" = --user ] || { printf 'Недопустимое обращение к systemctl в тесте.\n' >&2; exit 99; }
+shift
+printf '%s\n' "$*" >> "$STUB_SYSTEMCTL_DIR/calls.log"
+[ ! -f "$STUB_SYSTEMCTL_DIR/broken" ] || exit 1
+remove() { { grep -vx -- "$2" "$STUB_SYSTEMCTL_DIR/$1.txt" || true; } > "$STUB_SYSTEMCTL_DIR/$1.new"; mv "$STUB_SYSTEMCTL_DIR/$1.new" "$STUB_SYSTEMCTL_DIR/$1.txt"; }
+add() { remove "$1" "$2"; printf '%s\n' "$2" >> "$STUB_SYSTEMCTL_DIR/$1.txt"; }
+known() { [ -f "$STUB_UNIT_DIR/$1" ] || { printf 'Unit %s not found.\n' "$1" >&2; exit 5; }; }
+command=$1
+shift
+case "$command" in
+  show-environment|daemon-reload) exit 0 ;;
+  is-active) [ "$1" = --quiet ] && shift; grep -qx -- "$1" "$STUB_SYSTEMCTL_DIR/active.txt" ;;
+  enable) for unit in "$@"; do known "$unit"; add enabled "$unit"; done ;;
+  disable) for unit in "$@"; do known "$unit"; remove enabled "$unit"; done ;;
+  start|restart) for unit in "$@"; do known "$unit"; add active "$unit"; done ;;
+  stop) for unit in "$@"; do known "$unit"; remove active "$unit"; done ;;
+  *) printf 'Неизвестная команда заглушки systemctl: %s\n' "$command" >&2; exit 98 ;;
+esac
+SH
+cat > "$STUBS/loginctl" <<'SH'
+#!/bin/bash
+[ -f "$STUB_SYSTEMCTL_DIR/linger" ] && printf 'yes\n' || printf 'no\n'
+SH
+# ss: слушает ли кто-нибудь порт — проверяется настоящим подключением; адрес берётся из STUB_SS_ADDRESS.
+cat > "$STUBS/ss" <<'SH'
+#!/bin/bash
+port=${2##*:}
+if node -e 'const s=require("node:net").connect(Number(process.argv[1]),"127.0.0.1");s.on("connect",()=>process.exit(0));s.on("error",()=>process.exit(1));' "$port"; then
+  printf 'LISTEN 0      511        %s:%s      0.0.0.0:*\n' "${STUB_SS_ADDRESS:-127.0.0.1}" "$port"
+fi
+SH
+cat > "$STUBS/findmnt" <<'SH'
+#!/bin/bash
+printf '/dev/mapper/vgubuntu-root\n'
+SH
+cat > "$STUBS/lsblk" <<'SH'
+#!/bin/bash
+[ "${*: -1}" = /dev/mapper/vgubuntu-root ] || exit 1
+if [ "${STUB_DISK:-crypt}" = crypt ]; then printf 'lvm\ncrypt\npart\ndisk\n'; else printf 'lvm\npart\ndisk\n'; fi
+SH
+# Любая случайная попытка обратиться к launchd — ошибка.
+cat > "$STUBS/launchctl" <<'SH'
+#!/bin/bash
+printf 'Недопустимое обращение к launchd в тесте Linux-версии.\n' >&2
+exit 99
+SH
+chmod 700 "$STUBS"/*
+export PATH="$STUBS:$PATH"
+
+# 1. Проверочная установка без systemd: структура, права, состав скриптов, файлы служб.
+STAND="$FAKE_HOME/PlanFactMVP"
+run env PLANFACT_HOME="$STAND" /bin/bash "$SCRIPT_DIR/install.sh" --no-systemd --no-start
+check 'проверочная установка проходит без обращений к systemd' said 'Проверочная установка: автозапуск не включён'
+check 'в проверочной установке systemctl не вызывался' test ! -s "$STATE/calls.log"
+
+check 'структура, права и состав скриптов: Linux-версии поверх общих' "$NODE_BINARY" - "$STAND" "$SCRIPT_DIR" "$BASE_DIR" <<'NODE'
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const [root, linux, base] = process.argv.slice(2);
+const mode = (file) => fs.statSync(file).mode & 0o777;
+for (const directory of ['', 'app', 'data', 'backups', 'backups/hourly', 'backups/daily', 'logs', 'codes', 'bin', 'systemd']) {
+  assert.equal(fs.lstatSync(path.join(root, directory)).isSymbolicLink(), false);
+  assert.equal(mode(path.join(root, directory)), 0o700, directory);
+}
+assert.equal(mode(path.join(root, 'config.env')), 0o600);
+assert(fs.existsSync(path.join(root, 'systemd/.no-systemd')));
+assert(!fs.existsSync(path.join(root, 'launchd')));
+const bin = fs.readdirSync(path.join(root, 'bin'));
+assert(!bin.some((name) => /^test-.*\.sh$/.test(name)));
+const scripts = (directory) => fs.readdirSync(directory).filter((name) => /\.(sh|mjs)$/.test(name) && !name.startsWith('test-'));
+for (const name of scripts(linux)) assert.deepEqual(fs.readFileSync(path.join(root, 'bin', name)), fs.readFileSync(path.join(linux, name)), name);
+for (const name of scripts(base).filter((name) => !scripts(linux).includes(name))) {
+  assert.deepEqual(fs.readFileSync(path.join(root, 'bin', name)), fs.readFileSync(path.join(base, name)), name);
+}
+assert.deepEqual(bin.sort(), [...new Set([...scripts(base), ...scripts(linux)])].sort());
+for (const name of bin.filter((name) => name.endsWith('.sh'))) assert.equal(mode(path.join(root, 'bin', name)), 0o700, name);
+for (const name of bin.filter((name) => name !== 'install.sh')) {
+  assert(!/launchctl|osascript|fdesetup|plutil|LaunchAgents|caffeinate|open -e|stat -f|lsof|launchd\/\./.test(fs.readFileSync(path.join(root, 'bin', name), 'utf8')), name);
+}
+NODE
+
+check 'файлы служб: шесть служб, четыре таймера, ручные туннель и копия в Трекер, пути внутри стенда' "$NODE_BINARY" - "$STAND" <<'NODE'
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const root = process.argv[2];
+const directory = path.join(root, 'systemd');
+const files = fs.readdirSync(directory).filter((name) => !name.startsWith('.')).sort();
+assert.deepEqual(files, [
+  'ru.planfact.mvp.app.service', 'ru.planfact.mvp.backup.service', 'ru.planfact.mvp.backup.timer',
+  'ru.planfact.mvp.healthcheck.service', 'ru.planfact.mvp.healthcheck.timer',
+  'ru.planfact.mvp.logrotate.service', 'ru.planfact.mvp.logrotate.timer',
+  'ru.planfact.mvp.offsite.manual', 'ru.planfact.mvp.offsite.service', 'ru.planfact.mvp.offsite.timer',
+  'ru.planfact.mvp.tunnel.manual', 'ru.planfact.mvp.tunnel.service'
+]);
+const read = (name) => fs.readFileSync(path.join(directory, name), 'utf8');
+for (const name of files.filter((name) => !name.endsWith('.manual'))) {
+  const text = read(name);
+  assert(!/\{\{|~\//.test(text), name);
+  assert.equal(fs.statSync(path.join(directory, name)).mode & 0o777, 0o600, name);
+  for (const line of text.split('\n').filter((line) => /^(ExecStart|WorkingDirectory|Standard(Output|Error))=/.test(line))) {
+    const value = line.replace(/^[^=]+=(append:)?/, '').replace(/^\/bin\/bash /, '');
+    assert(value === root || value.startsWith(root + '/'), line);
+  }
+  if (name.endsWith('.service')) assert(text.includes(`Environment=PLANFACT_HOME=${root}\n`), name);
+}
+const app = read('ru.planfact.mvp.app.service');
+assert(app.includes('Restart=always\n') && app.includes('RestartSec=10\n') && app.includes('WantedBy=default.target'));
+assert(/\nEnvironment=PLAN_FACT_NODE_BIN=\/\S+\n/.test(app));
+assert(app.includes(`ExecStart=/bin/bash ${root}/bin/run-app.sh\n`));
+const tunnel = read('ru.planfact.mvp.tunnel.service');
+assert(tunnel.includes('Restart=on-failure\n') && tunnel.includes('RestartSec=30\n'));
+assert(tunnel.includes(`StandardOutput=append:${root}/logs/tunnel.log\n`));
+assert(read('ru.planfact.mvp.backup.timer').includes('OnUnitActiveSec=1h\n'));
+assert(read('ru.planfact.mvp.backup.timer').includes('OnActiveSec=30s\n'));
+assert(read('ru.planfact.mvp.healthcheck.timer').includes('OnUnitActiveSec=5min\n'));
+assert(read('ru.planfact.mvp.logrotate.timer').includes('OnUnitActiveSec=1h\n'));
+for (const name of ['backup', 'healthcheck', 'logrotate']) assert(read(`ru.planfact.mvp.${name}.service`).includes('Type=oneshot\n'));
+NODE
+
+run "$NODE_BINARY" "$STAND/bin/render-template.mjs" unit "$SCRIPT_DIR/systemd/ru.planfact.mvp.app.service.template" "$TEST_ROOT/bad.service" "$TEST_ROOT/стенд с пробелом" "$NODE_BINARY"
+check 'путь с пробелом или кириллицей в файл службы не попадает' failed_saying 'Путь для службы systemd'
+check 'после отказа файл службы не создан' test ! -e "$TEST_ROOT/bad.service"
+run env PLANFACT_HOME="$TEST_ROOT/стенд с пробелом" /bin/bash "$SCRIPT_DIR/install.sh" --no-systemd --no-start
+check 'установка в папку с пробелом отказывает понятной ошибкой' failed_saying 'Путь для службы systemd'
+
+# Повторная установка сохраняет config.env побайтово.
+printf '\n# Настройка, которую повторная установка обязана сохранить\nPLAN_FACT_PORT=18767\n' >> "$STAND/config.env"
+cp "$STAND/config.env" "$TEST_ROOT/original-config.env"
+run env PLANFACT_HOME="$STAND" /bin/bash "$SCRIPT_DIR/install.sh" --no-systemd --no-start
+check 'повторная установка сохраняет config.env побайтово' cmp -s "$TEST_ROOT/original-config.env" "$STAND/config.env"
+
+# 2. Живой сервер в проверочной установке.
+check 'обёртка заводит суперадминов alice и bob' "$STAND/bin/add-superadmins.sh" alice bob
+"$STAND/bin/issue-code.sh" alice > "$TEST_ROOT/issue-output.txt"
+check 'выдача кода печатает путь и команды открытия для Linux, без самого кода' "$NODE_BINARY" - "$STAND" "$TEST_ROOT/issue-output.txt" <<'NODE'
+const assert = require('node:assert/strict'), fs = require('node:fs');
+const root = process.argv[2], output = fs.readFileSync(process.argv[3], 'utf8');
+const file = root + '/codes/alice.txt';
+const lines = output.trimEnd().split('\n');
+assert.equal(lines.length, 3);
+assert.equal(lines[0], file);
+assert(lines[1].startsWith('Откройте файл на экране мини-ПК командой: xdg-open '));
+assert(lines[2].startsWith('или в терминале: less '));
+assert.equal(fs.statSync(file).mode & 0o777, 0o600);
+const code = fs.readFileSync(file, 'utf8').split('\n')[0];
+assert(/^[0-9A-HJKMNP-TV-Z]{5}(?:-[0-9A-HJKMNP-TV-Z]{5}){3}$/.test(code));
+assert(!output.includes(code));
+NODE
+
+start_server() {
+  local stand=$1 port=$2 attempt
+  "$stand/bin/run-app.sh" &
+  SERVER_PID=$!
+  for attempt in $(seq 1 50); do
+    if [ "$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 1 "http://127.0.0.1:$port/api/ready" || true)" = 200 ]; then
+      return 0
+    fi
+    kill -0 "$SERVER_PID" 2>/dev/null || { printf 'Сервер завершился до проверки готовности.\n' >&2; return 1; }
+    sleep 0.1
+  done
+  printf 'Сервер не стал готов за 5 секунд.\n' >&2
+  return 1
+}
+stop_server() {
+  kill -TERM "$SERVER_PID"
+  wait "$SERVER_PID" || true
+  SERVER_PID=''
+}
+check 'run-app.sh запускает сервер, /api/ready отвечает 200 на 18767' start_server "$STAND" 18767
+run "$STAND/bin/status.sh"
+check 'status.sh: готовность, только 127.0.0.1, LUKS, права, размер базы, проверочный режим' /bin/bash -c '
+  for text in "готов к работе" "Сервер доступен только на этом компьютере (127.0.0.1)" "Шифрование диска (LUKS) включено" \
+    "Права папок и файлов настроены верно" "Размер базы:" "проверочная установка"; do grep -q -F -- "$text" "$1" || { echo "нет: $text" >&2; exit 1; }; done' _ "$LAST"
+run env STUB_DISK=plain STUB_SS_ADDRESS=0.0.0.0 "$STAND/bin/status.sh"
+check 'status.sh предупреждает о незашифрованном диске и внешнем адресе' /bin/bash -c 'grep -q "незашифрованном диске" "$1" && grep -q "не только через 127.0.0.1" "$1"' _ "$LAST"
+chmod 644 "$STAND/config.env"
+run "$STAND/bin/status.sh"
+check 'status.sh замечает слишком открытые права config.env' grep -q 'для файла .*config.env нужны права 600' "$LAST"
+chmod 600 "$STAND/config.env"
+
+run "$STAND/bin/healthcheck.sh"
+check 'проверка готовности при работающем сервере проходит молча' /bin/bash -c '[ "$1" -eq 0 ] && [ ! -e "$2/logs/.healthcheck-down" ]' _ "$LAST_STATUS" "$STAND"
+run "$STAND/bin/backup.sh"
+check 'резервная копия создаётся' /bin/bash -c '[ "$1" -eq 0 ] && ls "$2"/backups/hourly/*.sqlite >/dev/null' _ "$LAST_STATUS" "$STAND"
+run "$STAND/bin/close-sessions.sh"
+# На настоящем Linux раньше срабатывает поиск открытой базы в /proc; на Mac /proc нет, отказывает проверка порта.
+if [ -d /proc/self/fd ]; then
+  check 'завершение сеансов отказывает, пока база открыта сервером (поиск в /proc)' failed_saying 'База ещё открыта процессом'
+else
+  check 'завершение сеансов отказывает, пока сервер работает' failed_saying 'Сервер ещё работает'
+fi
+stop_server
+check 'после остановки порт 18767 свободен' port_is_free 18767
+
+run "$STAND/bin/healthcheck.sh"
+check 'сбой записан в журнал проверки, уведомлений macOS нет' /bin/bash -c '[ "$1" -ne 0 ] && grep -q "Стенд не отвечает" "$2/logs/healthcheck.log" && [ -f "$2/logs/.healthcheck-down" ]' _ "$LAST_STATUS" "$STAND"
+
+# Восстановление в проверочном режиме: restore.sh сам запускает тестовый сервер и ждёт готовности.
+backup_file=$(ls "$STAND"/backups/hourly/*.sqlite | head -n 1)
+run "$STAND/bin/restore.sh" "$backup_file" --yes
+check 'восстановление из копии поднимает сервер и он отвечает' said 'Восстановление завершено'
+run "$STAND/bin/healthcheck.sh"
+check 'после восстановления проверка отмечает, что стенд снова работает' /bin/bash -c '[ "$1" -eq 0 ] && grep -q "Стенд снова работает" "$2/logs/healthcheck.log" && [ ! -e "$2/logs/.healthcheck-down" ]' _ "$LAST_STATUS" "$STAND"
+PLAN_FACT_PORT=18767 PLAN_FACT_NODE_BIN="$NODE_BINARY" "$NODE_BINARY" "$STAND/bin/maintenance-server.mjs" stop-test "$STAND"
+check 'тестовый сервер восстановления остановлен' port_is_free 18767
+run "$STAND/bin/close-sessions.sh"
+check 'при остановленном сервере сеансы завершаются' said 'Все сеансы завершены'
+check 'в логи не попадает выданный тестовый код' "$NODE_BINARY" -e 'const fs=require("node:fs"),a=require("node:assert/strict"),root=process.argv[1],code=fs.readFileSync(root+"/codes/alice.txt","utf8").split("\n")[0];for(const f of fs.readdirSync(root+"/logs"))if(f.endsWith(".log"))a(!fs.readFileSync(root+"/logs/"+f,"utf8").includes(code));' "$STAND"
+
+# 3. Установка с systemd (заглушка): автозапуск, запуск, остановка, два стенда, удаление.
+run env PLANFACT_HOME="$STAND" /bin/bash "$SCRIPT_DIR/install.sh" --no-start
+check 'установка с systemd предупреждает о linger' said 'sudo loginctl enable-linger'
+check 'файлы служб скопированы в ~/.config/systemd/user с правами 600' /bin/bash -c '
+  for file in "$1"/systemd/ru.planfact.mvp.*.service "$1"/systemd/ru.planfact.mvp.*.timer; do
+    cmp -s "$file" "$2/$(basename "$file")" || exit 1
+    [ "$(node -e "console.log((require(\"node:fs\").statSync(process.argv[1]).mode&0o777).toString(8))" "$2/$(basename "$file")")" = 600 ] || exit 1
+  done
+  [ ! -e "$1/systemd/.no-systemd" ]' _ "$STAND" "$UNITS"
+check 'автозапуск включён у сервера и трёх таймеров, но не у туннеля' /bin/bash -c '
+  [ "$(sort "$1/enabled.txt" | tr "\n" " ")" = "ru.planfact.mvp.app.service ru.planfact.mvp.backup.timer ru.planfact.mvp.healthcheck.timer ru.planfact.mvp.logrotate.timer " ]' _ "$STATE"
+check 'с флагом --no-start ничего не запущено' test ! -s "$STATE/active.txt"
+run "$STAND/bin/start.sh"
+check 'start.sh запускает сервер и таймеры, туннель — нет' /bin/bash -c '
+  [ "$(sort "$1/active.txt" | tr "\n" " ")" = "ru.planfact.mvp.app.service ru.planfact.mvp.backup.timer ru.planfact.mvp.healthcheck.timer ru.planfact.mvp.logrotate.timer " ]' _ "$STATE"
+check 'все обращения к systemctl — только --user' /bin/bash -c '! grep -q -- "--system" "$1/calls.log"' _ "$STATE"
+touch "$STATE/linger"
+run "$STAND/bin/status.sh"
+check 'status.sh показывает службы и linger' /bin/bash -c 'grep -q "Служба ru.planfact.mvp.app.service работает" "$1" && grep -q "Служба ru.planfact.mvp.tunnel.service выключена" "$1" && grep -q "поднимется сам, без входа" "$1"' _ "$LAST"
+
+# Второй стенд без суффикса не может занять службы первого.
+SECOND="$FAKE_HOME/PlanFactMVP-rehearsal"
+run env PLANFACT_HOME="$SECOND" /bin/bash "$SCRIPT_DIR/install.sh" --no-start
+check 'репетиция без суффикса не перезаписывает службы настоящего стенда' failed_saying 'другого стенда'
+check 'службы настоящего стенда не изменились' cmp -s "$STAND/systemd/ru.planfact.mvp.app.service" "$UNITS/ru.planfact.mvp.app.service"
