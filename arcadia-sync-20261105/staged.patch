+from django.apps import AppConfig
+from django.db.backends.signals import connection_created
+
+
+def _json_as_text(sender, connection, **kwargs) -> None:
+    """Колонки json читаются как текст: разбор делает приложение (порядок ключей и числа — как в JavaScript)."""
+    if connection.vendor == "postgresql":
+        from psycopg.types.string import TextLoader
+
+        connection.connection.adapters.register_loader("json", TextLoader)
+
+
+class PlanFactConfig(AppConfig):
+    name = "planfact"
+    verbose_name = "План Факт"
+    default_auto_field = "django.db.models.BigAutoField"
+
+    def ready(self) -> None:
+        connection_created.connect(_json_as_text, dispatch_uid="planfact-json-as-text")
diff --git a/junk/padolskiye/plan_fact_minipc/backend_django/planfact/config.py b/junk/padolskiye/plan_fact_minipc/backend_django/planfact/config.py
