+def apply_local_mutation(current: dict, kind: str, payload: dict, normalized: dict | None = None) -> dict:
+    """applyLocalMutation(current, type, payload): новое состояние или DomainError.
+
+    normalized — уже вычисленный normalizeState(deepClone(current)): сервер считает его один раз и для
+    правила, и для сравнения записей до и после изменения."""
+    if kind not in SERVER_MUTATIONS:
+        raise DomainError("Неизвестная операция")
+    nxt = clone(normalized) if normalized is not None else normalize_state(clone(current))
+    now = dates.now_iso()
+
+    if kind == "importBudget":
+        protected = budget_import_records(nxt)
+        imported = normalize_state(budget_import.apply_budget_import(nxt, payload))
+        preserve_budget_import_records(current, protected, imported)
+        imported["revision"] = nxt["revision"] + 1
+        return imported
+
+    if kind == "importExpenses":
+        imported = normalize_state(expense_import.apply_expense_import(nxt, payload))
+        imported["revision"] = nxt["revision"] + 1
+        return imported
+
+    if kind == "saveTrackerManualMapping":
+        _save_tracker_manual_mapping(nxt, payload, now)
+        nxt["revision"] += 1
+        return nxt
+
+    if kind == "deleteTrackerManualMapping":
+        issue_key = normalize_code(_p(payload, "issueKey"))
+        mappings = og(nxt.get("trackerSync", UNDEF), "manualMappings")
+        if truthy(mappings) and is_dict(mappings):
+            mappings.pop(issue_key, None)
+        nxt["revision"] += 1
+        return nxt
+
+    handler = _HANDLERS[kind]
+    handler(nxt, payload, now)
+    nxt["revision"] += 1
+    return nxt
+
+
+def _save_tracker_manual_mapping(nxt: dict, payload: dict, now: str) -> None:
+    issue_key = normalize_code(_p(payload, "issueKey"))
+    article = _find(nxt["articles"], lambda item: strict_eq(og(item, "id"), _p(payload, "articleId")) and not truthy(og(item, "archived")))
+    location = _find(nxt["locations"], lambda item: strict_eq(og(item, "id"), _p(payload, "locationId")) and not truthy(og(item, "archived")))
+    if not _TRACKER_KEY_RE.match(issue_key):
+        raise DomainError("Некорректный ключ тикета Tracker")
+    if article is None or not normalize_code(og(article, "code")):
+        raise DomainError("Выберите активный проект с кодом")
+    if location is None or not normalize_code(og(location, "code")):
+        raise DomainError("Выберите активную локацию с кодом")
+    if not truthy(nxt.get("trackerSync", UNDEF)):
+        nxt["trackerSync"] = create_initial_state()["trackerSync"]
+    tracker = nxt["trackerSync"]
+    if not truthy(tracker.get("manualMappings", UNDEF)):
+        tracker["manualMappings"] = {}
+    tracker["manualMappings"][issue_key] = {
+        "articleId": article["id"],
+        "locationId": location["id"],
+        "service": clean_text(_p(payload, "service"), 120),
+        "cfo": clean_text(_p(payload, "cfo"), 160),
+        "legalEntity": clean_text(_p(payload, "legalEntity"), 160),
+        "updatedAt": now,
+    }
+    remember_both = _p(payload, "applyToSimilar") is True
+    if _p(payload, "rememberProject") is True or remember_both:
+        project_code = normalize_code(_p(payload, "sourceProjectCode"))
+        if not project_code:
+            raise DomainError("Не удалось определить исходный код проекта Tracker")
+        if not truthy(tracker.get("projectMappings", UNDEF)):
+            tracker["projectMappings"] = {}
+        tracker["projectMappings"][project_code] = {"articleId": article["id"], "updatedAt": now}
+    if _p(payload, "rememberLocation") is True or remember_both:
+        location_code = normalize_code(_p(payload, "sourceLocationCode"))
+        if not location_code:
+            raise DomainError("Не удалось определить исходный код офиса Tracker")
+        if not truthy(tracker.get("locationMappings", UNDEF)):
+            tracker["locationMappings"] = {}
+        tracker["locationMappings"][location_code] = {"locationId": location["id"], "updatedAt": now}
+    linked_expenses = [
+        expense for expense in nxt["expenses"]
+        if og(expense, "sourceType") == tracker_sync.SOURCE_TYPE and normalize_code(og(expense, "sourceKey")) == issue_key
+    ]
+    for expense in linked_expenses:
+        period_locks.assert_expense_editable(nxt, expense)
+    linked_forecasts = [ticket for ticket in nxt["forecastTickets"] if normalize_code(tracker_issue_key_from_ticket(ticket)) == issue_key]
+    for ticket in linked_forecasts:
+        for allocation in or_(og(ticket, "allocations"), []):
+            period_locks.assert_month_editable(nxt, _month_key(og(allocation, "expectedDate")))
+    author = clean_text(_p(payload, "author"), 80)
+    for expense in linked_expenses:
+        expense["articleId"] = article["id"]
+        expense["subarticleId"] = None
+        expense["locationId"] = location["id"]
+        snapshot = og(expense, "sourceSnapshot")
+        if truthy(snapshot) and (is_dict(snapshot) or is_list(snapshot)):
+            expense["sourceSnapshot"] = {
+                **(snapshot if is_dict(snapshot) else dict(entries(snapshot))),
+                "projectCode": normalize_code(og(article, "code")),
+                "locationCode": normalize_code(og(location, "code")),
+            }
+        expense["updatedAt"] = now
+        expense["updatedBy"] = author or CURRENT_ACTOR_NAME
+        _push_history(expense, {"changedAt": now, "changedBy": expense["updatedBy"], "action": "tracker-manual-mapping"})
+    for ticket in linked_forecasts:
+        for allocation in or_(og(ticket, "allocations"), []):
+            allocation["articleId"] = article["id"]
+            allocation["subarticleId"] = None
+            allocation["locationId"] = location["id"]
+        ticket["sourceService"] = or_(clean_text(_p(payload, "service"), 120), og(ticket, "sourceService"))
+        ticket["sourceCostCenter"] = or_(clean_text(_p(payload, "cfo"), 160), og(ticket, "sourceCostCenter"))
+        ticket["sourceLegalEntity"] = or_(clean_text(_p(payload, "legalEntity"), 160), og(ticket, "sourceLegalEntity"))
+        ticket["updatedAt"] = now
+        ticket["updatedBy"] = author or CURRENT_ACTOR_NAME
+        _push_history(ticket, {"changedAt": now, "changedBy": ticket["updatedBy"], "action": "tracker-manual-mapping"})
+    affected = uniq(
+        key for key in [
+            *(og(expense, "quarterKey") for expense in linked_expenses),
+            *(og(allocation, "quarterKey") for ticket in linked_forecasts for allocation in or_(og(ticket, "allocations"), [])),
+        ] if period_locks.test(_QUARTER_RE, key)
+    )
+    for quarter in affected:
+        attributes_key = f"{S(location['id'])}|{S(quarter)}"
+        if not truthy(og(nxt["projectAttributes"], attributes_key)):
+            nxt["projectAttributes"][attributes_key] = {}
+        existing = or_(og(nxt["projectAttributes"][attributes_key], pk(article["id"])), {})
+        nxt["projectAttributes"][attributes_key][pk(article["id"])] = {
+            "service": clean_text(_p(payload, "service"), 120) or or_(og(existing, "service"), ""),
+            "legalEntity": clean_text(_p(payload, "legalEntity"), 160) or or_(og(existing, "legalEntity"), ""),
+            "cfo": clean_text(_p(payload, "cfo"), 160) or or_(og(existing, "cfo"), ""),
+            "location": location.get("name", UNDEF),
+        }
+
+
+_month_key = month_key_from_date_input
+
+
+def _ticket_and_allocation(nxt: dict, payload: dict) -> tuple[Any, Any]:
+    ticket = _find(nxt["forecastTickets"], lambda item: strict_eq(og(item, "id"), _p(payload, "ticketId")))
+    allocation = _find(og(ticket, "allocations"), lambda item: strict_eq(og(item, "id"), _p(payload, "allocationId"))) if ticket is not None else None
+    return ticket, allocation
