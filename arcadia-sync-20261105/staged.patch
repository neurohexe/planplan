+  return {
+    value, innerHTML: "", textContent: "", max: "", hidden: false, disabled: false, open: false,
+    dataset: {}, style: {}, parentElement: {}, classList: { toggle() {}, add() {}, remove() {} },
+    closest() { return this; }, reset() {}, focus() {},
+    showModal() { this.open = true; }, close() { this.open = false; }
+  };
+}
+
+// Реальные рендеринг, обработчик раскрытия и форма; DOM заменён простыми элементами.
+// Замыкание открывается только в тестовой копии, рабочий API не расширяется.
+function ui(state = fixture(), options = {}) {
+  const dom = new Proxy({}, {
+    get(target, key) {
+      return target[key] ||= element(/Filter$/.test(key) ? "all" : "");
+    }
+  });
+  const context = vm.createContext({
+    require: createRequire(APP_PATH), uiDom: dom, initialState: state, uiOptions: options,
+    document: { documentElement: { dataset: {}, style: {} }, addEventListener() {}, querySelectorAll: () => [], getElementById: () => null },
+    localStorage: { getItem: () => null, setItem() {} },
+    window: { clearTimeout() {}, setInterval: () => 1 },
+    console
+  });
+  vm.runInContext(SOURCE.replace(/\}\)\(\);\s*$/, `
+    state = initialState;
+    selectedYear = 2099; selectedQuarter = 4;
+    selectedLocation = uiOptions.location || "office-a";
+    currencyDisplayMode = uiOptions.currency || "original";
+    sharedMode = uiOptions.shared !== false;
+    Object.assign(dom, Object.fromEntries([
+      "overviewSearch", "overviewArticleFilter", "overviewResponsibleFilter", "overviewBudgetTypeFilter",
+      "overviewServiceFilter", "overviewLegalFilter", "overviewLocationFilter", "overviewTableBody",
+      "overviewPeriodLabel", "overviewQuarterStatus", "currencyDisplayMode", "summaryPlan", "summaryFact",
+      "summaryForecast", "summaryBalance", "summaryProgress", "summaryExpenseCount", "summaryForecastCount",
+      "summaryProgressBar", "expensesNavCount", "forecastNavCount", "recentExpenses",
+      "expenseForm", "expenseFormError", "expenseId", "expenseDate", "expenseArticle", "expenseSubarticle",
+      "expenseCurrency", "expenseCurrencyField", "expenseTicket", "expenseComment", "expenseAmount",
+      "expenseForecastTicketId", "expenseForecastAllocationId", "expenseForecastSourceNote",
+      "expenseDateCaption", "expenseSubmitBtn", "expenseModalTitle", "expenseAutoDate", "expenseDialog"
+    ].map(key => [key, uiDom[key]])));
+    renderExchangeRates = () => {};
+    populateArticleControls = () => {};
+    globalThis.expenseUi = { renderOverview, handleOverviewProjectToggle, openExpenseDialog };
+  })();`), context, { filename: APP_PATH });
+  return {
+    api: context.expenseUi, dom,
+    toggle() {
+      context.expenseUi.handleOverviewProjectToggle({ target: {
+        closest: () => ({ closest: () => ({ dataset: { overviewProjectId: "furniture" } }) })
+      } });
+    }
+  };
+}
+
+function detailRows(html, subarticle, location = "office-a") {
+  return [...html.matchAll(/<tr\b[^>]*>[\s\S]*?<\/tr>/g)].map((match) => match[0]).filter((row) =>
+    row.includes(`data-overview-subarticle-id="${subarticle}"`)
+    && row.includes(`data-overview-location-id="${location}"`));
+}
+
+function text(html) {
+  return html.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
+}
+
