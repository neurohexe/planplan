+"""Хранилище PostgreSQL (перенос backend/src/sqlite-store.js на модели Django).
+
+Время хранится в колонках timestamptz, наружу отдаётся строкой ISO с миллисекундами и «Z», как
+раньше. Одновременные запросы разводятся транзакциями и блокировками строк PostgreSQL: изменение
+состояния держит блокировку строки application_state, счётчик ошибок кода — строки access_codes,
+вход — строки пользователя.
+"""
+
+from __future__ import annotations
+
+import uuid
+from datetime import datetime, timedelta, timezone as dt_timezone
+from typing import Any
+
+from django.db import IntegrityError, connection, transaction
+from django.db.models import Q
+
+from planfact.domain import js
+from planfact.domain.dates import iso as js_iso
+from planfact.domain.dates import parse as js_parse
+from planfact.errors import AppError
+from planfact.models import (
+    AccessCode, AppSession, AppUser, ApplicationState, AuditEvent, EditLock, PersonalWarningState, SyncJob,
+    UserLocationAccess,
+)
+
+
+def now_dt() -> datetime:
+    moment = datetime.now(dt_timezone.utc)
+    return moment.replace(microsecond=moment.microsecond // 1000 * 1000)
+
+
+def iso(value: datetime | None) -> str | None:
+    """datetime → строка как toISOString()."""
+    if value is None:
+        return None
+    moment = value.astimezone(dt_timezone.utc)
+    return f"{moment:%Y-%m-%dT%H:%M:%S}.{moment.microsecond // 1000:03d}Z"
+
+
+def from_iso(value: str | None) -> datetime | None:
+    if value is None:
+        return None
+    milliseconds = js_parse(value)
+    if milliseconds != milliseconds:
+        raise ValueError(f"Некорректное время: {value}")
+    return datetime(1970, 1, 1, tzinfo=dt_timezone.utc) + timedelta(milliseconds=milliseconds)
+
+
+def now_iso() -> str:
+    return iso(now_dt())
+
+
+def user_row(user: AppUser) -> dict:
+    """Строка users в том виде, в каком её отдавал прежний SQLite-код (поля snake_case)."""
+    return {
+        "id": user.id,
+        "name": user.name,
+        "name_key": user.name_key,
+        "staff_login": user.staff_login,
+        "staff_uid": user.staff_uid,
+        "role": user.role,
+        "default_location_access": user.default_location_access,
+        "active": user.active,
+        "created_at": iso(user.created_at),
+        "updated_at": iso(user.updated_at),
+    }
+
+
+def public_user(user: AppUser | None, access: dict | None = None) -> dict | None:
+    if user is None:
+        return None
+    return {
+        "id": user.id,
+        "name": user.name,
+        "staffLogin": user.staff_login,
+        "staffUidBound": bool(user.staff_uid),
+        "role": user.role,
+        "active": user.active,
+        "archived": not user.active,
+        "defaultLocationAccess": user.default_location_access or "hidden",
+        "locationAccess": access if access is not None else {},
+        "createdAt": iso(user.created_at),
+        "updatedAt": iso(user.updated_at),
+    }
+
+
+def _session_dict(session: AppSession) -> dict:
+    user = session.user
+    return {
+        "id": session.id,
+        "userId": user.id,
+        "createdAt": iso(session.created_at),
+        "expiresAt": iso(session.expires_at),
+        "authMode": session.auth_mode,
+        "authRole": session.auth_role,
+        "authExpiresAt": iso(session.auth_expires_at),
+        "ip": session.ip,
+        "user": user_row(user),
+    }
+
+
+def _lock_dict(lock: EditLock) -> dict:
+    return {
+        "resource_type": lock.resource_type,
+        "resource_id": lock.resource_id,
+        "owner_user_id": lock.owner_user_id,
+        "owner_session_id": lock.owner_session_id,
+        "token_hash": lock.token_hash,
+        "acquired_at": iso(lock.acquired_at),
+        "expires_at": iso(lock.expires_at),
+        "owner_name": lock.owner_user.name,
+    }
+
+
+def audit_limit(limit: Any) -> int:
+    """Math.min(500, Math.max(1, Number(limit) || 100))."""
+    number = js.to_number(limit)
+    if not js.truthy(number):
+        return 100
+    if number == float("inf"):
+        return 500
+    if number == float("-inf"):
+        return 1
+    return min(500, max(1, int(number)))
+
+
+class Store:
+    # --- состояние
+
+    def ensure_state(self, initial_state: dict) -> None:
+        """Создаёт строку состояния, если её ещё нет (INSERT … ON CONFLICT DO NOTHING)."""
+        if ApplicationState.objects.filter(singleton=1).exists():
+            return
+        with connection.cursor() as cursor:
+            cursor.execute(
+                "INSERT INTO application_state(singleton, revision, schema_version, body_json, updated_at) "
+                "VALUES (1, %s, %s, %s, %s) ON CONFLICT (singleton) DO NOTHING",
+                [int(initial_state.get("revision") or 0), int(initial_state.get("schemaVersion") or 1),
+                 js.dumps(initial_state), now_dt()],
+            )
+
+    def get_state(self, *, for_update: bool = False, initial_state=None) -> dict:
+        rows = ApplicationState.objects.select_for_update() if for_update else ApplicationState.objects
+        try:
+            row = rows.get(singleton=1)
+        except ApplicationState.DoesNotExist:
+            if initial_state is None:
+                raise
+            # Как при запуске прежнего сервера: пустая база получает начальное состояние.
+            self.ensure_state(initial_state())
+            row = rows.get(singleton=1)
+        body = row.body_json if isinstance(row.body_json, dict) else {}
+        return {**body, "revision": row.revision, "schemaVersion": row.schema_version}
+
+    def check_ready(self) -> dict:
+        row = ApplicationState.objects.filter(singleton=1).values("revision").first()
+        if row is None:
+            raise RuntimeError("application_state is not initialized")
+        return {"revision": int(row["revision"])}
+
+    def save_state(self, state: dict, expected_revision: int) -> bool:
+        updated = ApplicationState.objects.filter(singleton=1, revision=int(expected_revision)).update(
+            revision=int(state["revision"]), schema_version=int(state["schemaVersion"]), body_json=state, updated_at=now_dt()
+        )
+        return updated == 1
+
+    # --- пользователи
+
+    def get_user(self, user_id: Any) -> AppUser | None:
+        if not isinstance(user_id, str):
+            return None
+        return AppUser.objects.filter(id=user_id).first()
+
+    def get_user_by_staff_login(self, login: str) -> AppUser | None:
+        return AppUser.objects.filter(staff_login=login).first()
+
+    def list_users(self) -> list[dict]:
+        users = list(AppUser.objects.order_by("name_key", "id"))
+        access = self._access_for([user.id for user in users])
+        return [public_user(user, access.get(user.id, {})) for user in users]
+
+    def public_user(self, user_id: str) -> dict | None:
+        user = self.get_user(user_id)
+        return public_user(user, self.get_location_access(user.id) if user else {})
+
+    def create_user(self, data: dict) -> dict:
+        with transaction.atomic():
+            user = AppUser.objects.create(
+                id=data["id"], name=data["name"], name_key=data["nameKey"], staff_login=data["staffLogin"],
+                staff_uid=data.get("staffUid") or None, role=data["role"],
+                default_location_access="view" if data.get("defaultLocationAccess") == "view" else "hidden",
+                active=True, created_at=from_iso(data["createdAt"]) if data.get("createdAt") else now_dt(),
+                created_by_id=data.get("createdById") or None,
+            )
+            self.replace_location_access(user.id, data.get("locationAccess") or {})
+        return self.public_user(user.id)
+
+    def update_user(self, user_id: str, changes: dict) -> dict | None:
+        with transaction.atomic():
+            user = AppUser.objects.select_for_update().filter(id=user_id).first()
+            if user is None:
+                return None
+            expect = changes.get("expect")
+            if expect and ((expect.get("active") and not user.active) or (expect.get("role") and user.role != expect["role"])):
+                raise AppError("Доступ сотрудника изменился в IDM: обновите страницу и повторите", 409, "idm_access_changed")
+            for field, key in (("name", "name"), ("name_key", "nameKey"), ("staff_login", "staffLogin"), ("staff_uid", "staffUid"),
+                               ("role", "role"), ("default_location_access", "defaultLocationAccess")):
+                if changes.get(key) is not None:
+                    setattr(user, field, changes[key])
+            if changes.get("active") is not None:
+                user.active = bool(changes["active"])
+            user.updated_at = from_iso(changes["updatedAt"]) if changes.get("updatedAt") else now_dt()
+            user.updated_by_id = changes.get("updatedById") or None
+            user.save()
+            if changes.get("locationAccess") is not None:
+                self.replace_location_access(user.id, changes["locationAccess"])
+        return self.public_user(user_id)
+
+    def get_location_access(self, user_id: str) -> dict:
+        return self._access_for([user_id]).get(user_id, {})
+
+    def _access_for(self, user_ids: list[str]) -> dict[str, dict]:
+        result: dict[str, dict] = {user_id: {} for user_id in user_ids}
+        for row in UserLocationAccess.objects.filter(user_id__in=user_ids).order_by("user_id", "location_id"):
+            result[row.user_id][row.location_id] = row.access
+        return result
+
+    def replace_location_access(self, user_id: str, access: dict) -> None:
+        UserLocationAccess.objects.filter(user_id=user_id).delete()
+        UserLocationAccess.objects.bulk_create([
