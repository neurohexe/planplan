+"""Ошибки приложения с HTTP-статусом и кодом (перенос backend/src/errors.js)."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+class AppError(Exception):
+    def __init__(self, message: str, status: int = 400, code: str = "bad_request", details: dict[str, Any] | None = None):
+        super().__init__(message)
+        self.message = message
+        self.status = status
+        self.code = code
+        self.details = details
+
+
+class AuthenticationError(AppError):
+    def __init__(self, message: str = "Требуется вход"):
+        super().__init__(message, 401, "authentication_required")
+
+
+class AuthorizationError(AppError):
+    def __init__(self, message: str = "Недостаточно прав"):
+        super().__init__(message, 403, "forbidden")
+
+
+class ConflictError(AppError):
+    def __init__(self, message: str, details: dict[str, Any] | None = None):
+        super().__init__(message, 409, "conflict", details)
+
+
+class LockedError(AppError):
+    def __init__(self, message: str, details: dict[str, Any] | None = None):
+        super().__init__(message, 423, "locked", details)
+
+
+class DomainError(AppError):
+    """Отказ правила данных: throw new Error(…) в app.js.
+
+    Раньше сервер отвечал на такие отказы 500 «Внутренняя ошибка сервера», и пользователь не видел
+    причину. Теперь это 400 с текстом правила: запись не применяется, как и раньше.
+    """
+
+    def __init__(self, message: str, status: int = 400, code: str = "bad_request"):
+        super().__init__(message, status, code)
