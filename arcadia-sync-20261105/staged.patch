+AUTH_RELEASE_BACKUP="$PLANFACT_HOME/backups/auth-idm-before-switch"
+"$PLANFACT_HOME/bin/stop.sh"
+# Проверить отсутствие ручного процесса сервера; затем сохранить текущую БД штатным backup.
+"$PLANFACT_HOME/bin/backup.sh"
+"$PLANFACT_HOME/bin/close-sessions.sh"
+# Сохранить текущие app/bin в новую приватную папку, затем восстановить предыдущие копии.
+mv "$PLANFACT_HOME/app" "$AUTH_RELEASE_BACKUP/corporate-app"
+mv "$PLANFACT_HOME/bin" "$AUTH_RELEASE_BACKUP/corporate-bin"
+cp -R "$AUTH_RELEASE_BACKUP/app" "$PLANFACT_HOME/app"
+cp -R "$AUTH_RELEASE_BACKUP/bin" "$PLANFACT_HOME/bin"
+cp -p "$AUTH_RELEASE_BACKUP/config.env" "$PLANFACT_HOME/config.env"
+"$PLANFACT_HOME/bin/start.sh"
