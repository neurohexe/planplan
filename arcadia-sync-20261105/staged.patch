+const { createIdentityProvider } = require("../src/identity-provider.js");
+const { PlanFactHttpServer } = require("../src/http-server.js");
+
+const origin = "https://plan-fact.example.test";
+function envFor(root) {
+  return { PATH: process.env.PATH, NODE_ENV: "development", PLAN_FACT_AUTH_MODE: "corporate-idm", PLAN_FACT_ROLE_SOURCE: "tirole", PLAN_FACT_STORAGE_DRIVER: "sqlite", PLAN_FACT_DEPLOYMENT_PROFILE: "laptop-mvp", PLAN_FACT_SECURE_COOKIES: "true", PLAN_FACT_CORPORATE_PUBLIC_URL: origin, PLAN_FACT_ALLOWED_ORIGINS: origin, PLAN_FACT_IDM_SYSTEM_SLUG: "plan-fact-test", PLAN_FACT_TVM_SELF_ALIAS: "plan_fact", PLAN_FACT_IDM_REQUEST_URL: "https://idm.yandex-team.ru/system/plan-fact-test", PLAN_FACT_DATABASE: path.join(root, "db.sqlite"), PLAN_FACT_CODES_DIR: path.join(root, "codes") };
+}
+
+test("CorporateIntegration_RealServiceHttpSessionDowngradeAndRevocation", async (t) => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "plan-fact-corporate-integration-"));
+  const config = { ...loadConfig(envFor(root)), port: 0 };
+  let assignments = { "/role/admin/": [{}], "/role/member/": [{}] };
+  const roles = new CorporateRoles({ systemSlug: config.idmSystemSlug, source: async () => ({ systemSlug: config.idmSystemSlug, confirmedAt: Date.now(), body: { revision: crypto.randomUUID(), born_date: 1, user: { "101": assignments }, tvm: {} } }) });
+  const store = new SqliteStore(config.databasePath, { initialState: PlanFactService.initialState });
+  const realtime = new RealtimeHub();
+  const service = new PlanFactService({ store, config, realtime, roles });
+  const adapter = {
+    diagnostics() { return { status: "ready" }; },
+    async begin() { const state = crypto.randomBytes(24).toString("hex"); return { state, authorizationUrl: `https://oauth.yandex-team.ru/authorize?state=${state}` }; },
+    async complete() { return { login: "alice", uid: "101", expiresAt: Date.now() + 60_000 }; }
+  };
+  const server = new PlanFactHttpServer({ service, config, realtime, identityProvider: createIdentityProvider(config), corporateLogin: new CorporateLoginFlow({ publicUrl: origin, adapter }) });
+  await roles.refresh();
+  const address = await server.listen();
+  const base = `http://127.0.0.1:${address.port}`;
+  let stream;
+  try {
+    const start = await fetch(`${base}/api/corporate/login`, { redirect: "manual" });
+    const state = new URL(start.headers.get("location")).searchParams.get("state");
+    const callback = await fetch(`${base}/api/corporate/callback?state=${state}&token=fictional`, { redirect: "manual", headers: { Cookie: start.headers.getSetCookie()[0].split(";")[0] } });
+    assert.equal(callback.headers.get("location"), "/");
+    const cookie = callback.headers.getSetCookie().find(value => value.startsWith("__Host-plan_fact_session=")).split(";")[0];
+    const headers = { Cookie: cookie, Origin: origin, "Content-Type": "application/json" };
+    assert.equal((await (await fetch(`${base}/api/auth`, { headers })).json()).user.role, "admin");
+    const before = await store.getState();
+    const events = await fetch(`${base}/api/events`, { headers });
+    stream = events.body.getReader();
+    assert.match(Buffer.from((await stream.read()).value).toString(), /event: ready/);
+    const startedAt = Date.now();
+    assignments = { "/role/member/": [{}] };
+    await roles.refresh();
+    const ended = Buffer.from((await stream.read()).value).toString();
+    assert.match(ended, /event: session-ended/);
+    assert.match(ended, /corporate_role_changed/);
+    const applicationDelayMs = Date.now() - startedAt;
+    assert.ok(applicationDelayMs < 60_000);
+    t.diagnostic(`Локальный тест с подставным источником: снижение роли и завершение SSE за ${applicationDelayMs} мс; доставка от IDM не измерена.`);
+    assert.equal((await (await fetch(`${base}/api/auth`, { headers })).json()).user.role, "member");
+    const forbidden = await fetch(`${base}/api/mutate`, { method: "POST", headers, body: JSON.stringify({ type: "addLocation", payload: { id: "office-new", name: "Fictional office" }, baseRevision: before.revision, mutationId: "corporate-admin-denied" }) });
+    assert.equal(forbidden.status, 403);
+    assert.equal((await store.getState()).revision, before.revision);
+    assignments = {};
+    await roles.refresh();
+    assert.equal((await fetch(`${base}/api/state`, { headers })).status, 401);
+    assert.equal(store.db.prepare("SELECT COUNT(*) AS n FROM sessions").get().n, 0);
+    assert.equal(store.db.prepare("SELECT COUNT(*) AS n FROM users").get().n, 1);
+    assert.ok(store.listAudit({ limit: 100 }).some(item => item.action === "auth.corporate_access_revoked"));
+  } finally {
+    await stream?.cancel();
+    await server.close();
+    store.close();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("CorporateCLI_ForbiddenProvisioningNeverCreatesDatabaseOrCodes", () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "plan-fact-corporate-cli-"));
+  try {
+    for (const args of [["bootstrap-superadmin"], ["provision-staff-access"], ["issue-access-code", "alice"]]) {
+      const result = spawnSync(process.execPath, ["--experimental-sqlite", path.join(__dirname, "../src/cli.js"), ...args], { encoding: "utf8", env: envFor(root), timeout: 5000 });
+      assert.equal(result.status, 1);
+      assert.match(result.stderr, /только в IDM/);
+      assert.equal(fs.existsSync(path.join(root, "db.sqlite")), false);
+      assert.equal(fs.existsSync(path.join(root, "codes")), false);
+    }
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
