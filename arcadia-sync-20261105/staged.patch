+class RealtimeHubLimitTests(SimpleTestCase):
+    def test_streams_are_capped_per_session_and_per_server(self):
+        hub = RealtimeHub(heartbeat_ms=60_000, max_streams=6)
+        first = [hub.subscribe("session-a") for _ in range(4)]
+        with self.assertRaises(AppError) as per_session:
+            hub.subscribe("session-a")
+        self.assertEqual((per_session.exception.status, per_session.exception.code), (429, "too_many_streams"))
+        second = [hub.subscribe("session-b") for _ in range(2)]
+        with self.assertRaises(AppError) as per_server:
+            hub.subscribe("session-c")
+        self.assertEqual((per_server.exception.status, per_server.exception.code), (503, "too_many_streams"))
+        hub.unsubscribe(second[0])
+        hub.unsubscribe(first[0])
+        self.assertEqual(hub.connected(), 4)
+        hub.subscribe("session-c")
+        hub.subscribe("session-a")
+        self.assertEqual(hub.connected(), 6)
+
