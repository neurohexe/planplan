+            if record.locked_until is not None and record.locked_until > moment:
+                return {"failedAttempts": record.failed_attempts, "lockedUntil": iso(record.locked_until), "locked": True}
+            failed = (0 if record.locked_until is not None else record.failed_attempts) + 1
+            locked_until = moment + timedelta(milliseconds=lock_ms) if failed >= max_failures else None
+            record.failed_attempts = failed
+            record.locked_until = locked_until
+            record.last_failed_at = moment
