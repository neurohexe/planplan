+
+@unittest.skipUnless(parity.node_binary() and parity.js_sources_available(), "нет Node или исходников app/*.js")
+class DomainParityTests(SimpleTestCase):
+    def in_zone(self, zone: str):
+        previous = os.environ.get("TZ")
+
+        class Zone:
+            def __enter__(self_inner):
+                os.environ["TZ"] = zone
+                time.tzset()
+
+            def __exit__(self_inner, *exc):
+                if previous is None:
+                    os.environ.pop("TZ", None)
+                else:
+                    os.environ["TZ"] = previous
+                time.tzset()
+
+        return Zone()
+
+    def assert_no_problems(self, problems: list[str]) -> None:
+        self.assertEqual(problems, [], "\n" + "\n".join(problems[:10]))
+
+    def test_mutation_sequences_match_javascript(self):
+        initial = json.loads(js.dumps(parity.state_module.normalize_state(parity.state_module.create_initial_state())))
+        seeded = parity.seeded_state()
+        seeded["closedPeriods"]["months"]["2026-09"] = {"closedAt": "2026-10-01T00:00:00.000Z", "closedBy": "Учебный тест"}
+        count, length = (300, 60) if LONG else (24, 30)
+        for zone_index, zone in enumerate(ZONES):
+            with self.subTest(zone=zone), self.in_zone(zone):
+                first_seed = 100 + zone_index * count
+                sequences = [parity.build_sequence(seed, seeded if seed % 3 else initial, length) for seed in range(first_seed, first_seed + count)]
+                problems: list[str] = []
+                for start in range(0, len(sequences), 50):
+                    problems += parity.compare_sequences(sequences[start:start + 50], {"TZ": zone})
+                self.assert_no_problems(problems)
+
+    def test_normalization_and_rules_match_javascript(self):
+        rng = random.Random(77)
+        states = parity.sample_states(range(500, 540 if LONG else 506), 40)
+        now = 1_793_700_000_000
+        calls = []
+        for index, state in enumerate(states):
+            for variant in range(6):
+                candidate = parity.corrupt(state, rng) if variant < 4 else parity.legacy(state, rng)
+                calls.append({"fn": "normalizeState", "args": [candidate], "now": now + index, "idPrefix": f"n{index}-{variant}"})
+            for user in USERS:
+                location_ids = [location["id"] for location in state.get("locations", [])]
+                access = {location: rng.choice(["view", "edit", "hidden", "bogus"]) for location in location_ids if rng.random() < 0.6}
+                for resource_type, resource_id in [("budget", "default|2026-Q4"), ("expense", state.get("expenses", [{}])[0].get("id", "missing") if state.get("expenses") else "missing"), ("forecast", "missing")]:
+                    calls.append({"fn": "authorizeLock", "args": [{"resourceType": resource_type, "resourceId": resource_id, "state": state, "user": user, "access": access}], "now": now})
+                calls.append({"fn": "assertImportLocations", "args": [state, state, user, access], "now": now})
+                calls.append({"fn": "warningLocation", "args": [state, {"locationId": "default"}], "now": now})
+                calls.append({"fn": "locationAccess", "args": [user, access, "default"], "now": now})
+                calls.append({"fn": "projectState", "args": [state, user, access, {"w1": rng.choice(["fp-1", "other"])}], "now": now})
+                calls.append({"fn": "visibleState", "args": [state, {**user, "locationAccess": access}], "now": now})
+                for kind, _weight in parity.MUTATION_WEIGHTS + [("importState", 1), ("syncTrackerExpenses", 1), ("dismissTrackerWarning", 1)]:
+                    generator = parity.Generator(index * 31 + len(calls))
+                    payload = json.loads(js.dumps(generator.payload_for(kind, state))) if kind in dict(parity.MUTATION_WEIGHTS) else {"id": "x"}
+                    calls.append({"fn": "authorizeMutation",
+                                  "args": [{"type": kind, "payload": payload, "state": state, "user": user, "access": access}], "now": now})
+                    calls.append({"fn": "mutationLocationIds", "args": [kind, payload, state], "now": now})
+                    calls.append({"fn": "lockResource", "args": [kind, payload], "now": now})
+                    calls.append({"fn": "auditEntity", "args": [kind, payload], "now": now})
+                    calls.append({"fn": "canRetryCreateMutation", "args": [kind, payload, state], "now": now})
+                    calls.append({"fn": "sanitizeAuditPayload", "args": [{**payload, "lockToken": "s", "nested": [{"token": "t"}]}], "now": now})
+                    calls.append({"fn": "cleanPayload", "args": [payload, user], "now": now})
+        for index in range(1, len(states)):
+            for user in USERS[:2]:
+                calls.append({"fn": "stampActor", "args": [states[index - 1], states[index], user], "now": now})
+            calls.append({"fn": "changedLocationIds", "args": [states[index - 1], states[index]], "now": now})
+        for value in ["ABCDE-FGHJK-MNPQR-STVWX", " abcde fghjk mnpqr stvwx ", "OIL0-1", None, 12345, "x" * 100, ["a"], "o0Ii1Ll"]:
+            calls.append({"fn": "normalizeAccessCode", "args": [value], "now": now})
+        for url in parity.URL_CORPUS:
+            calls.append({"fn": "safeUrl", "args": [url], "now": now})
+        problems: list[str] = []
+        for start in range(0, len(calls), 2000):
+            problems += parity.compare_calls(calls[start:start + 2000])
+        self.assert_no_problems(problems)
+
+    def test_date_parsing_matches_v8(self):
+        samples = parity.date_corpus(5000 if LONG else 1500)
+        for zone in ("Europe/Moscow", "America/New_York", "Australia/Lord_Howe"):
+            with self.subTest(zone=zone), self.in_zone(zone):
+                calls = [{"fn": "dateParse", "args": [sample], "now": 0} for sample in samples]
+                self.assert_no_problems(parity.compare_calls(calls, {"TZ": zone}))
