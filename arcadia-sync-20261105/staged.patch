+"""Личные коды доступа (перенос части backend/src/service.js и identity-provider.js).
+
+Код — 20 символов Crockford Base32 (100 бит), вид XXXXX-XXXXX-XXXXX-XXXXX. В базе хранится только
+scrypt-хэш с солью и параметрами рядом: коды, выданные прежним сервером на Node, продолжают работать.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+import re
+import secrets
+from typing import Any
+
+from planfact.domain.js import JS_WS, S, js_len, js_slice, js_trim, nullish, truthy
+from planfact.errors import AppError
+
+ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
+CODE_LENGTH = 20
+GROUP_LENGTH = 5
+KDF = {"algorithm": "scrypt", "N": 16384, "r": 8, "p": 1, "keylen": 32}
+SALT_BYTES = 16
+MAX_FAILURES = 5
+LOCK_MS = 15 * 60 * 1000
+FAILURE_MESSAGE = "Неверный логин или код. После 5 ошибок подряд вход блокируется на 15 минут."
+# Как у crypto.scrypt в Node: параметры, требующие больше 32 МиБ памяти, отвергаются.
+SCRYPT_MAXMEM = 32 * 1024 * 1024
+AUDIT_LOGIN_MAX_ALPHANUMERICS = 15
+
+_STAFF_LOGIN_RE = re.compile(r"[a-z0-9][a-z0-9._-]{1,63}\Z")
+_SEPARATORS_RE = re.compile("(?:" + JS_WS + "|-)+")
+_CODE_RE = re.compile(r"[0-9A-HJKMNP-TV-Z]{20}\Z")
+_HEX_PAIR_RE = re.compile(r"[0-9a-fA-F]{2}")
+
+
+def normalize_staff_login(value: Any) -> str:
+    login = js_trim(S(value if truthy(value) else "")).lower()
+    if not _STAFF_LOGIN_RE.match(login):
+        raise AppError("Некорректный Staff login", 400, "staff_login_invalid")
+    return login
+
+
+def generate_access_code() -> str:
+    # 256 делится на 32 без остатка, поэтому «байт & 31» выбирает символы поровну, без смещения.
+    symbols = [ALPHABET[byte & 31] for byte in secrets.token_bytes(CODE_LENGTH)]
+    return "-".join("".join(symbols[start:start + GROUP_LENGTH]) for start in range(0, CODE_LENGTH, GROUP_LENGTH))
+
+
+def normalize_access_code(value: Any) -> str:
+    """Регистр, пробелы и дефисы не важны; O читается как 0, I и L — как 1. Длиннее 64 символов — обрезается."""
+    text = S(nullish(value, "")).upper()
+    text = _SEPARATORS_RE.sub("", text).replace("O", "0").replace("I", "1").replace("L", "1")
+    return js_slice(text, 0, 64)
+
+
+def looks_like_access_code(value: Any) -> bool:
+    return _CODE_RE.match(normalize_access_code(value)) is not None
+
+
+def parse_kdf(text: Any) -> dict | None:
+    try:
+        params = json.loads(text)
+        n, r, p, keylen = params["N"], params["r"], params["p"], params["keylen"]
+    except (TypeError, ValueError, KeyError):
+        return None
+    if params.get("algorithm") != "scrypt":
+        return None
+    if not all(type(value) is int or (type(value) is float and value.is_integer()) for value in (n, r, p, keylen)):
+        return None
+    if keylen < 16 or keylen > 64:
+        return None
+    return {"algorithm": "scrypt", "N": int(n), "r": int(r), "p": int(p), "keylen": int(keylen)}
+
+
+def _salt_bytes(salt_hex: str) -> bytes:
+    """Buffer.from(hex, "hex"): разбор останавливается на первой неверной паре, как в Node."""
+    result = bytearray()
+    for start in range(0, len(salt_hex) - 1, 2):
+        pair = salt_hex[start:start + 2]
+        if not _HEX_PAIR_RE.fullmatch(pair):
+            break
+        result.append(int(pair, 16))
+    return bytes(result)
+
+
+def derive_key(code: str, salt_hex: str, kdf: dict) -> bytes | None:
+    try:
+        return hashlib.scrypt(
+            code.encode("utf-8"), salt=_salt_bytes(salt_hex), n=kdf["N"], r=kdf["r"], p=kdf["p"],
+            dklen=kdf["keylen"], maxmem=SCRYPT_MAXMEM,
+        )
+    except (ValueError, OverflowError, MemoryError):
+        return None
+
+
+def hash_new_code(code: str) -> tuple[str, str]:
+    salt = secrets.token_hex(SALT_BYTES)
+    derived = derive_key(normalize_access_code(code), salt, KDF)
+    if derived is None:
+        raise RuntimeError("scrypt не смог вычислить хэш кода")
+    return derived.hex(), salt
+
+
+def safe_equal(left: Any, right: Any) -> bool:
+    """Сравнение за постоянное время (как safeEqual в security.js)."""
+    a = S(left if truthy(left) else "").encode("utf-8")
+    b = S(right if truthy(right) else "").encode("utf-8")
+    return len(a) == len(b) and hmac.compare_digest(a, b)
+
+
+def audit_login_value(value: Any) -> str:
+    """Введённый логин для журнала: код доступа (целиком или похожий) туда не попадает."""
+    text = js_trim(S(nullish(value, "")))
+    if not text:
+        return ""
+    if looks_like_access_code(text):
+        return "[похоже на код доступа]"
+    try:
+        login = normalize_staff_login(text)
+    except AppError:
+        login = None
+    if login and len(re.sub(r"[^a-z0-9]", "", login)) <= AUDIT_LOGIN_MAX_ALPHANUMERICS:
+        return text
+    return f"[скрыто, длина {js_len(text)}]"
+
+
+DUMMY_SALT = secrets.token_hex(SALT_BYTES)
