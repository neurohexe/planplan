+def clean_payload(payload: Any, user: dict) -> dict:
+    """Копия payload: автор подставляется сервером, служебные поля клиента отбрасываются."""
+    safe = clone(payload) if truthy(payload) and is_dict(payload) else {}
+    safe["author"] = user["name"]
+    safe["actor"] = user["name"]
+    safe.pop("createdById", None)
+    safe.pop("updatedById", None)
+    return safe
+
+
+def _mask(value: Any) -> Any:
+    if is_list(value):
+        return [_mask(item) for item in value]
+    if is_dict(value):
+        return {key: ("***" if key in SENSITIVE_PAYLOAD_KEYS else _mask(item)) for key, item in value.items()}
+    return value
