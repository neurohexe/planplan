+# Persistent: если в это время компьютер был выключен или спал, копия уйдёт сразу после включения.
+[Unit]
+Description=План Факт MVP: копия в Трекер раз в сутки
+
+[Timer]
+OnCalendar=*-*-* 23:59:00 Asia/Tashkent
+Persistent=true
+AccuracySec=1min
+
+[Install]
+WantedBy=timers.target
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/systemd/ru.planfact.mvp.tunnel.service.template b/junk/padolskiye/plan_fact_minipc/deploy/linux/systemd/ru.planfact.mvp.tunnel.service.template
