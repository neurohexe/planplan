+// Создаёт базу SQLite прежним сервером (backend/src) с вымышленными данными — для теста переноса.
+// Запуск: node --experimental-sqlite make_node_stand.js <путь к базе>; ответ — JSON на stdout.
+"use strict";
+
+const path = require("node:path");
+
+const repo = process.env.PLAN_FACT_REPO_ROOT || path.resolve(__dirname, "..", "..", "..");
+const { PlanFactService } = require(path.join(repo, "backend", "src", "service.js"));
+const { SqliteStore } = require(path.join(repo, "backend", "src", "sqlite-store.js"));
+const { RealtimeHub } = require(path.join(repo, "backend", "src", "realtime.js"));
+const { loadConfig } = require(path.join(repo, "backend", "src", "config.js"));
+
+async function main(databasePath) {
+  const config = loadConfig({
+    PLAN_FACT_AUTH_MODE: "access-code", PLAN_FACT_STORAGE_DRIVER: "sqlite", PLAN_FACT_DATABASE: databasePath,
+    PLAN_FACT_REQUIRE_LOCKS: "false"
+  });
+  const store = new SqliteStore(config.databasePath, { initialState: PlanFactService.initialState });
+  const service = new PlanFactService({ store, config, realtime: new RealtimeHub() });
+  await service.provisionStaffAccount({ staffLogin: "alice", name: "Алиса", role: "superadmin" });
+  await service.provisionStaffAccount({ staffLogin: "bob", name: "Боб", role: "admin" });
+  const codes = {
+    alice: (await service.issueAccessCode("alice")).code,
+    bob: (await service.issueAccessCode("bob")).code
+  };
+  const login = async (name) => service.loginWithAccessCode({ login: name, code: codes[name], ip: "127.0.0.1", userAgent: "node" });
+  const alice = await login("alice");
+  const run = async (type, payload, id) => service.mutate(alice.session, {
+    type, payload, mutationId: id, baseRevision: store.getState().revision
+  });
+  await run("addLocation", { id: "msk", name: "Москва", code: "MSK" }, "node-loc-msk");
+  await run("addArticle", { id: "p1", name: "Уборка", code: "P1" }, "node-article-p1");
+  await run("saveBudget", { locationId: "msk", quarterKey: "2026-Q4", items: [
+    { articleId: "p1", currency: "RUB", months: { "2026-10": 100, "2026-11": 200.5, "2026-12": 0.1 } }
+  ] }, "node-budget-msk");
+  await run("addExpense", { id: "e1", locationId: "msk", articleId: "p1", currency: "RUB", amount: 120.25,
+    ticketUrl: "https://example.com/TEST-1", expenseDate: "2026-10-14", comment: "Вымышленный расход" }, "node-expense-e1");
+  await run("addComment", { id: "c1", expenseId: "e1", text: "Комментарий" }, "node-comment-c1");
+  await run("addForecast", { id: "f1", allocationId: "a1", locationId: "msk", articleId: "p1", currency: "RUB", amount: 90,
+    ticketUrl: "https://example.com/TEST-2", expectedDate: "2026-11-14" }, "node-forecast-f1");
+  await run("saveAccount", { staffLogin: "carol", name: "Кэрол", role: "user", locationAccess: { msk: "view" } }, "node-account-carol");
+  codes.carol = (await service.issueAccessCode("carol")).code;
+  const bob = await login("bob");
+  const row = store.db.prepare("SELECT body_json, revision FROM application_state").get();
+  store.close();
+  process.stdout.write(JSON.stringify({ codes, bodyJson: row.body_json, revision: row.revision, bobToken: bob.token }));
+}
+
+main(process.argv[2]).catch((error) => {
+  process.stderr.write(String(error && error.stack));
+  process.exitCode = 1;
+});
diff --git a/junk/padolskiye/plan_fact_minipc/backend_django/planfact/tests/parity.py b/junk/padolskiye/plan_fact_minipc/backend_django/planfact/tests/parity.py
