@@ -0,0 +1,22 @@
+# Ручная служба (рядом лежит метка .manual): install.sh её не включает. Включает и выключает её только
+# enable-tunnel.sh / disable-tunnel.sh. Пока нет метки systemd/.tunnel-enabled, tunnel-run.sh сразу выходит
+# с кодом 0 и systemd её не перезапускает; любая неудача (код не 0) перезапускается через 30 секунд.
+[Unit]
+Description=План Факт MVP: туннель Tunneler
+StartLimitIntervalSec=0
+
+[Service]
+Type=simple
+ExecStart=/bin/bash {{BIN}}/tunnel-run.sh
+Environment=PLANFACT_HOME={{STAND}}
+WorkingDirectory={{STAND}}
+Restart=on-failure
+RestartSec=30
+TimeoutStopSec=20
+StandardOutput=append:{{LOGS}}/tunnel.log
+StandardError=append:{{LOGS}}/tunnel.log
+UMask=0077
+NoNewPrivileges=yes
+
+[Install]
+WantedBy=default.target
