+# сервера (в часовом поясе процесса). Им заменяется дата расхода, если она неверна, — только для текста отказа.
+_STARTUP_QUARTER = _quarter_of(context.now_ms())
+
+
+def current_quarter_key() -> str:
+    """selectedQuarterKey() на сервере."""
+    return context.selected_quarter_override() or _STARTUP_QUARTER
+
+
+def budget_store_key(location_id: Any, quarter: Any) -> str:
+    return f"{S(location_id)}|{S(quarter)}"
+
+
+def budget_item_key(article_id: Any, subarticle_id: Any) -> Any:
+    return f"{S(article_id)}|{S(subarticle_id)}" if truthy(subarticle_id) else article_id
+
+
+def normalize_currency_amounts(value: Any, legacy_currency: Any) -> dict:
+    fallback = normalize_currency_code(legacy_currency) or DEFAULT_CURRENCY
+    number = to_number(value)
+    if is_finite(number) and value is not None and value != "":
+        return {fallback: number} if number >= 0 else {}
+    if not truthy(value) or not is_dict(value):
+        return {}
+    amounts: dict = {}
+    for currency, raw_amount in value.items():
+        code = normalize_currency_code(currency)
+        amount = to_number(raw_amount)
+        if code and is_finite(amount) and amount >= 0:
+            amounts[code] = amount
+    return amounts
+
+
+def normalize_monthly_currency_amounts(value: Any, quarter: Any) -> dict:
+    if not truthy(value) or not is_dict(value):
+        return {}
+    month_keys = quarter_month_keys(quarter)
+    if len(month_keys) != 3:
+        return {}
+    result: dict = {}
+    for currency, raw_months in value.items():
+        code = normalize_currency_code(currency)
+        if not code or not truthy(raw_months) or not is_dict(raw_months):
+            continue
+        if not any(month_key in raw_months for month_key in month_keys):
+            continue
+        months = {}
+        for month_key in month_keys:
+            amount = to_number(raw_months.get(month_key, UNDEF))
+            months[month_key] = amount if is_finite(amount) and amount >= 0 else 0
+        result[code] = months
+    return result
+
+
+def sum_month_amounts(value: Any, quarter: Any) -> Any:
+    total: Any = 0
+    for month_key in quarter_month_keys(quarter):
+        amount = to_number(og(value, month_key))
+        total = add(total, amount if truthy(amount) else 0)
+    return total
+
+
+def remap_monthly_budget_store(store: Any, from_quarter: Any, to_quarter: Any) -> dict:
+    if not truthy(store) or not (is_dict(store) or is_list(store)):
+        return {}
+    from_months = quarter_month_keys(from_quarter)
+    to_months = quarter_month_keys(to_quarter)
+    if len(from_months) != 3 or len(to_months) != 3:
+        return {}
+    result: dict = {}
+    for item_key, currencies in entries(store):
+        if not truthy(currencies) or not is_dict(currencies):
+            continue
+        for currency, months in currencies.items():
+            code = normalize_currency_code(currency)
+            if not code or not truthy(months) or not is_dict(months):
+                continue
+            result.setdefault(item_key, {})
+            remapped = {}
+            for index, month_key in enumerate(to_months):
+                amount = to_number(months.get(from_months[index], UNDEF))
+                remapped[month_key] = amount if truthy(amount) else 0
+            result[item_key][code] = remapped
+    return result
+
+
+def catalog_currency_code(value: Any) -> str:
+    code = js_trim(S(or_(value, ""))).upper()
+    return code if _CATALOG_CODE_RE.match(code) else ""
+
+
+def normalize_currency_catalog(value: Any, required_codes: dict | None = None) -> list[dict]:
+    codes: dict = {"RUB": True}
+    if not is_list(value):
+        for code in CURRENCY_CODES:
+            codes[code] = True
+    for code in (required_codes or {}):
+        codes[code] = True
+    for item in (value if is_list(value) else []):
+        code = catalog_currency_code(item if is_str(item) else og(item, "code"))
+        if code:
+            codes[code] = True
+    return [{"code": code} for code in sort_strings(codes.keys())]
+
+
+def collect_state_currency_codes(source: Any) -> dict:
+    codes: dict = {}
+    for store in values(or_(og(source, "budgets"), {})):
+        for amounts in values(or_(store, {})):
+            for code in keys(or_(amounts, {})):
+                normalized = catalog_currency_code(code)
+                if normalized:
+                    codes[normalized] = True
+    for item in or_(og(source, "expenses"), []):
+        code = catalog_currency_code(og(item, "currency"))
+        if code:
+            codes[code] = True
+    for ticket in or_(og(source, "forecastTickets"), []):
+        for item in or_(og(ticket, "allocations"), []):
+            code = catalog_currency_code(og(item, "currency"))
+            if code:
+                codes[code] = True
+    return codes
+
+
+def normalize_exchange_rate_periods(value: Any) -> dict:
+    normalized: dict = {}
+    if not truthy(value) or not (is_dict(value) or is_list(value)):
+        return normalized
+    for quarter, rates in entries(value):
+        if not _QUARTER_RE.match(quarter) or not truthy(rates) or not (is_dict(rates) or is_list(rates)):
+            continue
+        period: dict = {}
+        for currency, entry in entries(rates):
+            code = catalog_currency_code(currency)
+            if not code or code == "RUB":
+                continue
+            rate = positive_number(entry if is_number(entry) else og(entry, "rateToRub"))
+            if not truthy(rate):
+                continue
+            period[code] = {
+                "rateToRub": rate,
+                "direction": "rubToCurrency" if og(entry, "direction") == "rubToCurrency" else "currencyToRub",
+            }
+        if period:
+            normalized[quarter] = period
+    return normalized
