+    def test_russian_sorting_matches_icu(self):
+        calls = [{"fn": "localeCompare", "args": pair, "now": 0} for pair in parity.collation_corpus(20000 if LONG else 4000)]
+        self.assert_no_problems(parity.compare_calls(calls))
