+#!/bin/bash
+# Метки агентов двух стендов на одном ноутбуке (задача 10): «настоящий» без суффикса и репетиция с PLANFACT_LABEL_SUFFIX.
+# Всё — в собственной .sandbox: домашняя папка подменена, вместо launchctl, curl и dk — заглушки, сервер не запускается.
+set -euo pipefail
+umask 077
