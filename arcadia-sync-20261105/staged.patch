+def plural_expenses(count: int) -> str:
+    mod10 = count % 10
+    mod100 = count % 100
+    if 11 <= mod100 <= 14:
+        return "расходов"
+    if mod10 == 1:
+        return "расход"
+    if 2 <= mod10 <= 4:
+        return "расхода"
+    return "расходов"
+
+
+def budget_item_has_values(current: dict, item_key: str) -> bool:
+    for collection in (current.get("budgets", UNDEF), current.get("monthlyBudgets", UNDEF)):
+        for store in values(or_(collection, {})):
+            currencies = og(store, item_key)
+            if not truthy(currencies) or not (is_dict(currencies) or is_list(currencies)):
+                continue
+            for value in values(currencies):
+                if truthy(value) and (is_dict(value) or is_list(value)):
+                    if any(to_number(amount) != 0 for amount in values(value)):
+                        return True
+                elif to_number(value) != 0:
+                    return True
+    return False
+
