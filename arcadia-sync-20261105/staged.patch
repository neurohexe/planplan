+    def record_access_code_failure(self, user_id: str, *, now: str, max_failures: int, lock_ms: int) -> dict | None:
+        """Неверный код: счётчик +1; на max_failures-й ошибке подряд ставится блокировка. Пока логин
+        заблокирован, ничего не меняется: новые попытки блокировку не продлевают."""
+        moment = from_iso(now)
+        with transaction.atomic():
+            record = AccessCode.objects.select_for_update().filter(user_id=user_id).first()
+            if record is None:
