+"use strict";
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+const fs = require("node:fs/promises");
+const path = require("node:path");
+const { spawnSync } = require("node:child_process");
+const { pathToFileURL } = require("node:url");
+
+const workspace = path.resolve(__dirname, "../..");
+const helperPath = path.join(workspace, "scripts/corporate-tvmtool-config.mjs");
+const helper = import(pathToFileURL(helperPath));
+const defaults = { tvmId: "1001", systemSlug: "fixture-app", selfAlias: "fixture", port: "18768", proxyPort: "18769" };
+
+async function directory(t) {
+  await fs.mkdir(path.join(workspace, ".sandbox"), { recursive: true });
+  const root = await fs.mkdtemp(path.join(workspace, ".sandbox/tvm-config-test-"));
