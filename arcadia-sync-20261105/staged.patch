+#!/bin/bash
+# Установка версии на Django рядом с работающим стендом (задача 41). Прежний сервер всё это время работает:
+#  - программы PostgreSQL 16 (пакеты Ubuntu 24.04 из комплекта) распаковываются в папку стенда, без прав
+#    администратора; библиотеки, которых нет в системе, берутся из комплекта;
+#  - окружение Python с пакетами из комплекта, без интернета;
+#  - база PostgreSQL в pgdata/ и служба ru.planfact.mvp.postgres;
+#  - проверка: перенос данных с копии базы SQLite и пробный сервер на запасном порту.
+# Переключение стенда — отдельно: switch-to-django.sh.
+# Использование: bash install-django.sh <папка распакованного комплекта>
+set -euo pipefail
+umask 077
+[ "$#" -eq 1 ] || { printf 'Использование: install-django.sh <папка распакованного комплекта>\n' >&2; exit 2; }
+BUNDLE=$(CDPATH= cd -- "$1" && pwd -P)
+# shellcheck source=common-django.sh
+. "$BUNDLE/deploy/linux/django/common-django.sh"
+TRIAL_PORT=${PLANFACT_DJANGO_TRIAL_PORT:-18769}
+INSTALL_LOG="$STAND/logs/django-install.log"
+
+say '1/7. Проверяю комплект и компьютер.'
+[ "$(id -u)" != 0 ] || fail 'Запускайте от учётной записи стенда, не от root.'
+[ ! -e "$ACTIVE_MARK" ] || fail 'Стенд уже работает на Django: обновление работающей версии этим скриптом не делается.'
+[ -f "$BUNDLE/VERSION" ] || fail 'В комплекте нет файла VERSION.'
+arch=$(version_value arch "$BUNDLE/VERSION")
+case "$(uname -m)/$arch" in
+  x86_64/amd64 | aarch64/arm64) ;;
+  *) fail "Комплект собран для $arch, а этот компьютер — $(uname -m)." ;;
+esac
+(cd "$BUNDLE" && sha256sum --check --quiet --strict MANIFEST.sha256) || fail 'Файлы комплекта повреждены: не совпали SHA-256.'
+python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' || fail 'Нужен Python 3.12 или новее (python3).'
+python3 -c 'import venv, sqlite3' || fail 'В Python нет модулей venv или sqlite3.'
+for tool in dpkg-deb ldd curl sha256sum; do
+  command -v "$tool" > /dev/null || fail "Нет программы $tool."
+done
+[ -f /usr/share/zoneinfo/UTC ] || fail 'Нет базы часовых поясов /usr/share/zoneinfo (пакет tzdata).'
+user_systemctl show-environment > /dev/null || fail 'Не работает systemctl --user.'
+[ -f "$UNIT_DIR/$APP_UNIT" ] || fail "Нет службы $APP_UNIT: сначала нужен установленный стенд."
+load_django_config
+pg_client_env
+maintenance_lock
+if [ -f "$DJANGO_HOME/VERSION" ] && [ -s "$PGDATA_DIR/PG_VERSION" ]; then
+  pg_safety_dump "$STAND/backups/install-$(date +%Y%m%d-%H%M%S)/before.dump"
+fi
+[ -n "$SQLITE_DATABASE" ] && [ -f "$SQLITE_DATABASE" ] || fail 'Не найдена база SQLite прежнего сервера (PLAN_FACT_DATABASE в config.env).'
+[ "$TRIAL_PORT" != "$PLAN_FACT_PORT" ] || fail 'Пробный порт совпадает с портом стенда.'
+private_dir "$STAND/run" "$STAND/logs" "$STAND/backups"
+printf '\n== %s установка %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$(version_value commit "$BUNDLE/VERSION")" >> "$INSTALL_LOG"
+
+say '2/7. Распаковываю PostgreSQL и пакеты Python (прежний сервер работает).'
+STAGE=$(mktemp -d "$STAND/.django-install.XXXXXX")
+TRIAL_PID=''
+TRIAL_DATABASE=''
+cleanup() {
+  local status=$?
+  if [ -n "$TRIAL_PID" ]; then
+    kill -TERM "$TRIAL_PID" 2> /dev/null || true
+    wait "$TRIAL_PID" 2> /dev/null || true
+  fi
+  if [ -n "$TRIAL_DATABASE" ]; then
+    terminate_database_connections "$TRIAL_DATABASE" || true
+    pg_tool dropdb --if-exists "$TRIAL_DATABASE" || true
+  fi
+  rm -rf -- "$STAGE"
+  [ "$status" -eq 0 ] || printf 'Установка не завершена. Прежний сервер не затронут. Подробности: %s\n' "$INSTALL_LOG" >&2
+  exit "$status"
+}
+trap cleanup EXIT
+NEW="$STAGE/django"
+mkdir -p "$NEW/postgres/lib" "$STAGE/pool"
+for deb in "$BUNDLE"/debs/*.deb; do
+  case "$(basename -- "$deb")" in
+    postgresql-16_* | postgresql-client-16_*) dpkg-deb -x "$deb" "$NEW/postgres" ;;
+    *) dpkg-deb -x "$deb" "$STAGE/pool" ;;
+  esac
+done
+chmod 700 "$NEW/postgres"
+new_bin="$NEW/postgres/usr/lib/postgresql/16/bin"
+new_pkglib="$NEW/postgres/usr/lib/postgresql/16/lib"
+[ -x "$new_bin/postgres" ] || fail 'В комплекте нет программ PostgreSQL 16.'
+# Ускоритель запросов JIT выключен (jit = off), его библиотека LLVM в комплект не входит.
+rm -rf -- "$new_pkglib"/llvmjit*.so "$new_pkglib/bitcode"
+# Библиотеки, которых нет в системе: ldd по программам и модулям, пока не найдутся все.
+missing=''
+for round in 1 2 3 4 5 6 7 8; do
+  missing=$(for file in "$new_bin"/* "$new_pkglib"/*.so "$NEW/postgres/lib"/*; do
+    [ -f "$file" ] || continue
+    LD_LIBRARY_PATH="$NEW/postgres/lib" ldd "$file" 2> /dev/null || true
+  done | awk '$2 == "=>" && $3 == "not" { print $1 }' | sort -u)
+  [ -n "$missing" ] || break
+  for library in $missing; do
+    found=$(find "$STAGE/pool" -name "$library" \( -type f -o -type l \) | head -n 1)
+    [ -n "$found" ] || fail "PostgreSQL нужна библиотека $library, а в системе и в комплекте её нет."
+    cp -L -- "$found" "$NEW/postgres/lib/$library"
+  done
+done
+[ -z "$missing" ] || fail 'Не удалось подобрать библиотеки для PostgreSQL.'
+pg_version=$(LD_LIBRARY_PATH="$NEW/postgres/lib" "$new_bin/postgres" --version) || fail 'Программа postgres не запускается.'
+say "   $pg_version; библиотек из комплекта: $(find "$NEW/postgres/lib" -type f | wc -l | tr -d ' ')."
+
+python3 -m venv --without-pip "$NEW/venv"
+pip_wheel=$(find "$BUNDLE/wheels/bootstrap" -name 'pip-*.whl' | head -n 1)
+[ -n "$pip_wheel" ] || fail 'В комплекте нет pip.'
+"$NEW/venv/bin/python" "$pip_wheel/pip" install --quiet --no-index --no-cache-dir --disable-pip-version-check \
+  --find-links "$BUNDLE/wheels" -r "$BUNDLE/backend_django/requirements.txt" >> "$INSTALL_LOG" 2>&1 ||
+  fail 'Не удалось установить пакеты Python из комплекта.'
+"$NEW/venv/bin/python" -c 'import django, gunicorn, ada_url; from psycopg import pq; assert pq.__impl__ == "binary", pq.__impl__' ||
+  fail 'Пакеты Python установились неполностью.'
+cp -R "$BUNDLE/backend_django" "$NEW/backend_django"
+mkdir -p "$NEW/bin" "$NEW/systemd"
+cp "$BUNDLE"/deploy/linux/django/*.sh "$NEW/bin/"
+cp "$BUNDLE"/deploy/linux/django/systemd/*.template "$NEW/systemd/"
+cp "$BUNDLE/VERSION" "$NEW/VERSION"
+chmod 700 "$NEW/bin/"*.sh
+
+# В папке установки могут быть и чужие файлы (например, своё окружение Python): их не трогаем,
+# заменяем только свои части.
+PARTS=(backend_django venv postgres bin systemd VERSION)
+if [ -d "$DJANGO_HOME" ]; then
+  ours=false
+  [ -f "$DJANGO_HOME/VERSION" ] && [ -f "$DJANGO_HOME/bin/common-django.sh" ] && ours=true
+  if [ "$ours" = true ]; then
+    # Повторная установка до переключения: служба PostgreSQL пользуется программами прежней установки.
+    user_systemctl stop "$PG_UNIT" 2> /dev/null || true
+    previous="$DJANGO_HOME/.previous-$(date +%Y%m%d-%H%M%S)"
+    mkdir -m 700 "$previous"
+    for part in "${PARTS[@]}"; do
+      [ ! -e "$DJANGO_HOME/$part" ] || mv -- "$DJANGO_HOME/$part" "$previous/"
+    done
+    say "   Прежняя установка перенесена в $previous."
+  else
+    for part in "${PARTS[@]}"; do
+      [ ! -e "$DJANGO_HOME/$part" ] || fail "В $DJANGO_HOME уже есть $part, и это не установка версии на Django. Ничего не меняю."
+    done
+  fi
+else
+  mkdir -m 700 -p "$DJANGO_HOME"
+fi
+for part in "${PARTS[@]}"; do
+  mv -- "$NEW/$part" "$DJANGO_HOME/$part"
+done
+say "   Установлено в $DJANGO_HOME."
+
+say '3/7. Готовлю данные PostgreSQL.'
+if [ ! -s "$PGDATA_DIR/PG_VERSION" ]; then
+  [ ! -e "$PGDATA_DIR" ] || [ -z "$(ls -A "$PGDATA_DIR")" ] || fail "Папка $PGDATA_DIR не пуста, но это не данные PostgreSQL."
+  pg_tool initdb --pgdata="$PGDATA_DIR" --encoding=UTF8 --locale=C.UTF-8 --data-checksums \
+    --auth-local=peer --auth-host=reject >> "$INSTALL_LOG" 2>&1 || fail 'initdb не создал данные PostgreSQL.'
+  cat >> "$PGDATA_DIR/postgresql.conf" << EOF
+
+# --- План Факт (задача 41): только сокет в закрытой папке стенда, без TCP ---
+listen_addresses = ''
+port = $PG_PORT
+unix_socket_directories = '$PG_SOCKET_DIR'
+unix_socket_permissions = 0700
+max_connections = 60
+shared_buffers = 256MB
+jit = off
+max_parallel_workers_per_gather = 0
+timezone = 'UTC'
+log_timezone = 'UTC'
+lc_messages = 'C'
+log_line_prefix = '%m [%p] '
+EOF
+  say '   Созданы новые данные PostgreSQL.'
+else
+  say '   Данные PostgreSQL уже есть, оставляю их.'
+fi
+
+say '4/7. Включаю службу PostgreSQL.'
+private_dir "$UNIT_DIR"
+render_unit "$DJANGO_HOME/systemd/postgres.service.template" "$UNIT_DIR/$PG_UNIT"
+user_systemctl daemon-reload
+user_systemctl enable "$PG_UNIT" >> "$INSTALL_LOG" 2>&1
+user_systemctl restart "$PG_UNIT" || fail "Служба $PG_UNIT не запустилась: смотрите logs/postgres.log."
+pg_client_env
+for _ in $(seq 1 60); do
+  pg_tool pg_isready --quiet --dbname=postgres && break
+  sleep 1
+done
+pg_tool pg_isready --quiet --dbname=postgres || fail 'PostgreSQL не отвечает: смотрите logs/postgres.log.'
+
+say '5/7. Создаю базу и таблицы.'
+exists=$(pg_tool psql --no-psqlrc --dbname=postgres --tuples-only --no-align \
+  --command "SELECT 1 FROM pg_database WHERE datname = '$PG_DATABASE'")
+[ "$exists" = 1 ] || pg_tool createdb --encoding=UTF8 "$PG_DATABASE"
+bash "$DJANGO_BIN/django-manage.sh" migrate --noinput >> "$INSTALL_LOG" 2>&1 || fail 'Миграции базы не применились.'
+bash "$DJANGO_BIN/django-manage.sh" check >> "$INSTALL_LOG" 2>&1 || fail 'Проверка Django не пройдена.'
+
+say '6/7. Проверяю перенос данных на копии базы SQLite (прежняя база не меняется).'
+trial_copy="$STAGE/plan-fact-trial.sqlite"
+sqlite_snapshot "$SQLITE_DATABASE" "$trial_copy"
+TRIAL_DATABASE="planfact_trial_$(date +%s)_$RANDOM"
+pg_tool createdb --template=template0 "$TRIAL_DATABASE"
+PLANFACT_DJANGO_DATABASE="$TRIAL_DATABASE" bash "$DJANGO_BIN/django-manage.sh" migrate --noinput >> "$INSTALL_LOG" 2>&1
+PLANFACT_DJANGO_DATABASE="$TRIAL_DATABASE" bash "$DJANGO_BIN/django-manage.sh" import_sqlite "$trial_copy" | tee -a "$INSTALL_LOG"
+
+say "7/7. Пробный запуск сервера на Django на порту $TRIAL_PORT."
+PLANFACT_DJANGO_DATABASE="$TRIAL_DATABASE" PLANFACT_DJANGO_SERVE_PORT=$TRIAL_PORT bash "$DJANGO_BIN/django-manage.sh" serve --no-migrate >> "$STAND/logs/django-trial.log" 2>&1 &
+TRIAL_PID=$!
+wait_ready "$TRIAL_PORT" 90 || fail 'Пробный сервер не ответил готовностью: смотрите logs/django-trial.log.'
+page=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 5 "http://127.0.0.1:$TRIAL_PORT/")
+state=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 5 "http://127.0.0.1:$TRIAL_PORT/api/state")
+[ "$page" = 200 ] || fail "Пробный сервер не отдал главную страницу (HTTP $page)."
+[ "$state" = 401 ] || fail "Пробный сервер без входа ответил на /api/state HTTP $state вместо 401."
+say "   /api/ready — 200, главная страница — 200, данные без входа — 401."
+kill -TERM "$TRIAL_PID"
+wait "$TRIAL_PID" 2> /dev/null || true
+TRIAL_PID=''
+
+say "Готово: версия на Django установлена и проверена, прежний сервер работает как раньше."
+say "Переключение стенда: bash $DJANGO_BIN/switch-to-django.sh"
