+#!/bin/bash
+# Общие функции туннеля (задача 9). Подключает common.sh, добавляет настройки туннеля,
+# поиск клиента dk, проверки сети и безопасную правку config.env.
+set -euo pipefail
+umask 077
+TUNNEL_COMMON_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=common.sh
+. "$TUNNEL_COMMON_DIR/common.sh"
+
+TUNNEL_LABEL=$(stand_label tunnel)
+# Метка «туннель включён» (рядом с .no-launchd): без неё агент туннеля сразу выходит и ничего не поднимает.
+TUNNEL_FLAG="$STAND/launchd/.tunnel-enabled"
+TUNNEL_BALANCER_HOST=tun-balancer.si.yandex-team.ru
+# Значения по умолчанию совпадают с config.env.template, чтобы старый config.env без этих строк тоже работал.
+TUNNEL_DEFAULT_HOST=ws1-tunnelerapi.tunneler-si.yandex-team.ru
+TUNNEL_DEFAULT_PORT=28766
+TUNNEL_DOMAIN=yandex.ru
+TUNNEL_INSTALL_HINT='npm install -g @yandex-int/devkit --registry=https://npm.yandex-team.ru/'
+
+tunnel_stamp() { date '+%Y-%m-%d %H:%M:%S'; }
+
+# Логин, сервер и порт закрепляют адрес: https://<логин>-<порт>-ws1.tunneler-si.yandex.ru
+# Логин берётся из учётной записи macOS (она совпадает со Staff-логином), если не задан PLAN_FACT_TUNNEL_USERNAME.
+tunnel_settings() {
+  TUNNEL_USER=${PLAN_FACT_TUNNEL_USERNAME:-$(id -un)}
+  TUNNEL_HOST=${PLAN_FACT_TUNNEL_HOST:-$TUNNEL_DEFAULT_HOST}
+  TUNNEL_PORT=${PLAN_FACT_TUNNEL_REMOTE_PORT:-$TUNNEL_DEFAULT_PORT}
+  [[ "$TUNNEL_USER" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || fail 'Логин для адреса туннеля: строчные латинские буквы, цифры и дефисы, первая — буква. Задайте PLAN_FACT_TUNNEL_USERNAME в config.env.'
+  [[ "$TUNNEL_HOST" =~ ^ws[1-9]-tunnelerapi\.tunneler-si\.yandex-team\.ru$ ]] || fail 'PLAN_FACT_TUNNEL_HOST должен иметь вид ws1-tunnelerapi.tunneler-si.yandex-team.ru (ws1…ws9).'
+  [[ "$TUNNEL_PORT" =~ ^[0-9]{4,5}$ ]] && [ "$((10#$TUNNEL_PORT))" -ge 2000 ] && [ "$((10#$TUNNEL_PORT))" -le 50000 ] || fail 'PLAN_FACT_TUNNEL_REMOTE_PORT должен быть числом от 2000 до 50000.'
+  TUNNEL_PORT=$((10#$TUNNEL_PORT))
+  TUNNEL_IDENT=${TUNNEL_HOST%%-*}
+  TUNNEL_URL="https://$TUNNEL_USER-$TUNNEL_PORT-$TUNNEL_IDENT.tunneler-si.$TUNNEL_DOMAIN"
+}
+
+# strict — стенд должен быть установлен; optional — для проверки до установки (берутся значения по умолчанию).
+load_tunnel_config() {
+  STAND_INSTALLED=false
+  if [ "${1:-strict}" = optional ] && { [ ! -f "$STAND/config.env" ] || [ -L "$STAND/config.env" ]; }; then
+    PLAN_FACT_PORT=18766
+  else
+    load_stand_config
+    STAND_INSTALLED=true
+  fi
+  tunnel_settings
+}
+
+tunnel_node() {
+  local binary=${PLAN_FACT_NODE_BIN:-}
+  [ -n "$binary" ] || binary=$(command -v node) || fail 'Не найден Node. Нужен Node 22.5 или новее.'
+  printf '%s\n' "$binary"
+}
+
+# Ищет клиент dk: путь из PLAN_FACT_TUNNEL_DK_BIN (если задан, то только он), затем рядом с настоящим Node —
+# туда его кладёт npm install -g, — затем в PATH. Результат: DK_BIN и DK_NODE_DIR; код 1, если клиента нет.
+find_dk() {
+  local node candidate
+  DK_BIN=''
+  node=$(tunnel_node)
+  DK_NODE_DIR=$("$node" -p 'require("node:path").dirname(process.execPath)') || return 1
+  if [ -n "${PLAN_FACT_TUNNEL_DK_BIN:-}" ]; then
+    candidate=$PLAN_FACT_TUNNEL_DK_BIN
+    case "$candidate" in /*) ;; *) return 1 ;; esac
+    [ -f "$candidate" ] && [ -x "$candidate" ] || return 1
+    DK_BIN=$candidate
+    return 0
+  fi
+  for candidate in "$DK_NODE_DIR/dk" "$(command -v dk || true)"; do
+    [ -n "$candidate" ] && [ -f "$candidate" ] && [ -x "$candidate" ] || continue
+    DK_BIN=$candidate
+    return 0
+  done
+  return 1
+}
+
+# Версия клиента для сообщений: «0.5.2» из «@yandex-int/devkit/0.5.2 darwin-arm64 node-v22…».
+dk_version() {
+  local line
+  line=$(PATH="$DK_NODE_DIR:/usr/bin:/bin:/usr/sbin:/sbin" "$DK_BIN" --version 2>/dev/null | head -n 1) || line=''
+  line=$(printf '%s\n' "$line" | sed -n 's|^@[^/]*/[^/]*/\([0-9][^ ]*\).*|\1|p')
+  printf '%s\n' "${line:-неизвестна}"
+}
+
+# Проверка порта TCP за 5 секунд. Печатает ok или причину: timeout, dns, refused, noroute, error.
+tcp_probe() {
+  local family='' output
+  [ "${3:-}" != 6 ] || family=-6
+  # shellcheck disable=SC2086
+  if output=$(nc $family -vz -G 5 "$1" "$2" 2>&1); then
+    printf 'ok\n'
+    return 0
+  fi
+  case "$output" in
+    *'timed out'*) printf 'timeout\n' ;;
+    *'nodename nor servname'*|*'Name or service not known'*|*getaddrinfo*) printf 'dns\n' ;;
+    *refused*) printf 'refused\n' ;;
+    *'No route'*|*'unreachable'*) printf 'noroute\n' ;;
+    *) printf 'error\n' ;;
+  esac
+  return 1
+}
+
+# Адрес сервера Tunneler так, как берёт его dk: первый в списке API, по IPv6. Печатает «адрес порт».
+# dk не проверяет сертификат API; здесь список нужен только для проверки порта, поэтому при отказе
+# сертификата повторяем запрос так же.
+tunnel_instance() {
+  local node body status url="https://$TUNNEL_HOST/api/v1/instances?format=ipv6"
+  node=$(tunnel_node)
+  if body=$(curl --noproxy '*' --silent --show-error --ipv6 --max-time 8 "$url" 2>/dev/null); then
+    :
+  else
+    status=$?
+    case "$status" in
+      35|51|58|59|60|77|83|91) body=$(curl --noproxy '*' --silent --show-error --ipv6 --insecure --max-time 8 "$url" 2>/dev/null) || return 1 ;;
+      *) return 1 ;;
+    esac
+  fi
+  printf '%s' "$body" | "$node" -e '
+let text = "";
+process.stdin.on("data", (chunk) => { text += chunk; }).on("end", () => {
+  try {
+    const first = JSON.parse(text)[0];
+    const [rawAddress, port] = Array.isArray(first) ? first : String(first).split(/:(?=\d+$)/);
+    const address = String(rawAddress).replace(/^\[|\]$/g, "");
+    if (!/^[0-9A-Za-z:.-]+$/.test(address) || !/^\d{1,5}$/.test(String(port)) || Number(port) < 1 || Number(port) > 65535) process.exit(1);
+    console.log(`${address} ${port}`);
+  } catch { process.exit(1); }
+});'
+}
+
+# Ждёт ответа 200 по адресу: wait_for_200 <адрес> <секунд> <пауза между попытками>. Время считается по часам,
+# а не по числу пауз: запрос, который «висит», тоже занимает время (до 5 секунд на попытку).
+# Код ответа — в WAIT_LAST_CODE, код возврата curl (60 — сертификат не принят) — в WAIT_LAST_STATUS.
+wait_for_200() {
+  local url=$1 limit=$2 pause=$3 started code
+  started=$(date +%s)
+  WAIT_LAST_CODE=000
+  WAIT_LAST_STATUS=0
+  while :; do
+    WAIT_LAST_STATUS=0
+    code=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 5 "$url") || WAIT_LAST_STATUS=$?
+    [ "$WAIT_LAST_STATUS" -eq 0 ] || code=000
+    WAIT_LAST_CODE=$code
+    [ "$code" != 200 ] || return 0
+    [ "$(( $(date +%s) - started ))" -lt "$limit" ] || return 1
+    sleep "$pause"
+  done
+}
+
+app_agent_loaded() { launchctl print "$LAUNCH_DOMAIN/$APP_LABEL" >/dev/null 2>&1; }
+
+# Перезапускает сервер, чтобы он прочитал новый config.env (только при включённом launchd).
+restart_app_agent() {
+  local label=$APP_LABEL
+  [ -f "$AGENT_DIR/$label.plist" ] || fail 'Не найден установленный агент сервера. Повторите установку из мастерской.'
+  bootout_agent "$label"
+  "$PLAN_FACT_NODE_BIN" "$TUNNEL_COMMON_DIR/maintenance-server.mjs" wait-stopped "$STAND"
+  launchctl bootstrap "$LAUNCH_DOMAIN" "$AGENT_DIR/$label.plist" >/dev/null 2>&1 || fail 'Не удалось запустить сервер. Проверьте logs/app.stderr.log.'
+  wait_for_200 "http://127.0.0.1:$PLAN_FACT_PORT/api/ready" "${PLANFACT_APP_WAIT_SECONDS:-30}" 1 \
+    || fail "Сервер не стал готов после перезапуска (код ответа $WAIT_LAST_CODE). Проверьте logs/app.stderr.log."
+}
+
+# Заменяет (или добавляет) строку ИМЯ='значение' в config.env: во временный файл рядом, затем атомарная замена.
+# Остальные строки не меняются; повторяющиеся строки с тем же именем сворачиваются в одну на месте первой.
+set_stand_setting() {
+  local name=$1 value=$2 temporary
+  [[ "$name" =~ ^PLAN_FACT_[A-Z_]+$ ]] || fail 'Неверное имя настройки.'
+  [[ "$value" =~ ^[A-Za-z0-9:/.,_-]*$ ]] || fail 'Значение настройки содержит недопустимые символы.'
+  [ -f "$STAND/config.env" ] && [ ! -L "$STAND/config.env" ] || fail 'config.env должен быть обычным файлом.'
+  temporary=$(mktemp "$STAND/.config.env.XXXXXX")
+  if ! awk -v name="$name" -v value="$value" -v quote="'" '
+    index($0, name "=") == 1 { if (!done) { print name "=" quote value quote; done = 1 }; next }
+    { print }
+    END { if (!done) { print name "=" quote value quote } }
+  ' "$STAND/config.env" > "$temporary"; then
+    rm -f -- "$temporary"
+    fail 'Не удалось подготовить новый config.env.'
+  fi
+  chmod 600 "$temporary"
+  mv -f -- "$temporary" "$STAND/config.env"
+}
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/laptop/tunnel-run.sh b/junk/padolskiye/plan_fact_minipc/deploy/laptop/tunnel-run.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/tunnel-run.sh
@@ -0,0 +1,105 @@
+#!/bin/bash
+# Поднимает туннель Tunneler: 127.0.0.1:<порт стенда> → закреплённый адрес. Запускает launchd (агент
+# ru.planfact.mvp.tunnel); вручную — только для диагностики: tunnel-run.sh --now.
+# Секретов не читает и не печатает: ключ ssh берёт у агента skotty сам ssh.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=tunnel-common.sh
+. "$SCRIPT_DIR/tunnel-common.sh"
+
+NOW=false
+case "$#:${1:-}" in
+  0:) ;;
+  1:--now) NOW=true ;;
+  *) fail 'Использование: tunnel-run.sh [--now]' ;;
+esac
+
+STARTED=$(date +%s)
+PAUSE=${PLANFACT_TUNNEL_PAUSE_SECONDS:-90}
+[[ "$PAUSE" =~ ^[0-9]{1,4}$ ]] || PAUSE=90
+SHIM_DIR=''
+DK_PID=''
+PAUSE_PID=''
+STOPPING=false
+log() { printf '%s %s\n' "$(tunnel_stamp)" "$*"; }
+
+finish() {
+  local code=$?
+  trap - EXIT
+  [ -z "$SHIM_DIR" ] || rm -rf -- "$SHIM_DIR"
+  # Быстрая неудача (нет доступа, клиента или сети) не должна превращаться в частые попытки войти на Tunneler.
+  # При ручном запуске (--now) паузы нет: результат нужен сразу.
+  if [ "$code" -ne 0 ] && [ "$STOPPING" = false ] && [ "$NOW" = false ] && [ "$(( $(date +%s) - STARTED ))" -lt 120 ]; then
+    log "Пауза $PAUSE с перед следующей попыткой."
+    sleep "$PAUSE" &
+    PAUSE_PID=$!
+    wait "$PAUSE_PID" || true
+  fi
+  exit "$code"
+}
+
+# launchd (bootout) или Ctrl-C: останавливаем dk и его ssh и выходим спокойно, без паузы.
+stop_signal() {
+  STOPPING=true
+  if [ -n "$DK_PID" ]; then
+    pkill -TERM -P "$DK_PID" 2>/dev/null || true
+    kill -TERM "$DK_PID" 2>/dev/null || true
+    wait "$DK_PID" 2>/dev/null || true
+  fi
+  [ -z "$PAUSE_PID" ] || kill "$PAUSE_PID" 2>/dev/null || true
+  log 'Туннель остановлен.'
+  exit 0
+}
+trap finish EXIT
+trap stop_signal TERM INT HUP
+
+load_tunnel_config strict
+if [ "$NOW" = false ] && [ ! -f "$TUNNEL_FLAG" ]; then
+  log 'Туннель не включён (нет метки launchd/.tunnel-enabled). Включить: bin/enable-tunnel.sh.'
+  exit 0
+fi
+find_dk || fail "Не найден клиент dk. Установите: $TUNNEL_INSTALL_HINT"
+
+# dk запускает ssh без проверки связи: после обрыва сети соединение может «зависнуть» и ничего не передавать.
+# Обёртка добавляет ключи, по которым ssh сам завершается примерно через 90 секунд молчания сервера,
+# а dk и launchd поднимают туннель заново. Для OpenSSH 9+ FAQ Tunneler иногда советует разрешить алгоритмы
+# ssh-rsa; не трогая ~/.ssh/config, это можно включить только для туннеля: PLAN_FACT_TUNNEL_SSH_RSA=yes в config.env.
+SSH_EXTRA=''
+[ "${PLAN_FACT_TUNNEL_SSH_RSA:-no}" != yes ] || SSH_EXTRA=' -o HostkeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa'
+# Папки прошлых запусков, которые не успели удалиться (аварийное завершение, отключение питания), убираем;
+# папку работающего сейчас запуска (в ней записан номер его процесса) не трогаем.
+for stale in "$STAND"/.tunnel-run.*; do
+  [ -d "$stale" ] && [ ! -L "$stale" ] || continue
+  owner=''
+  read -r owner < "$stale/pid" 2>/dev/null || owner=''
+  if [[ "$owner" =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then
+    continue
+  fi
+  rm -rf -- "$stale"
+done
+SHIM_DIR=$(mktemp -d "$STAND/.tunnel-run.XXXXXX")
+printf '%s\n' "$$" > "$SHIM_DIR/pid"
+cat > "$SHIM_DIR/ssh" <<SH
+#!/bin/bash
+exec /usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes$SSH_EXTRA "\$@"
+SH
+chmod 700 "$SHIM_DIR/ssh"
+# У launchd короткий PATH: Node (для dk) и ssh указываем сами.
+export PATH="$SHIM_DIR:$DK_NODE_DIR:/usr/bin:/bin:/usr/sbin:/sbin"
+export TUNNELER_USERNAME="$TUNNEL_USER" TUNNELER_HOST="$TUNNEL_HOST"
+# Агент ключей skotty обычно приходит от launchd; если нет — берём его сокет из домашней папки.
+if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -S "$HOME/.skotty/sock/default.sock" ]; then
+  export SSH_AUTH_SOCK="$HOME/.skotty/sock/default.sock"
+fi
+# Ручной запуск (--now) — это диагностика: dk печатает подробности ssh (в журнал агента они не попадают).
+[ "$NOW" = false ] || export DEBUG=ssh-tun
+
+[ "$NOW" = false ] || log 'Ручной запуск для диагностики: если агент туннеля включён, сначала остановите его (bin/disable-tunnel.sh) — два туннеля на один порт не уживутся.'
+log "Запускаю туннель: 127.0.0.1:$PLAN_FACT_PORT → $TUNNEL_URL (сервер Tunneler $TUNNEL_HOST, клиент dk $(dk_version))."
+"$DK_BIN" tun "$PLAN_FACT_PORT:$TUNNEL_PORT" "--user=$TUNNEL_USER" "--realm=$TUNNEL_DOMAIN" &
+DK_PID=$!
+if wait "$DK_PID"; then code=0; else code=$?; fi
+DK_PID=''
+log "Клиент dk завершился (код $code): туннель не работает, launchd запустит его заново."
+exit 1
