+test("LoginWithAccessCode_EveryKindOfFailureLooksTheSame", async (t) => {
+  const fixture = createFixture();
+  try {
+    const alice = await fixture.addUser("alice", "superadmin");
+    const bob = await fixture.addUser("bob");
+    await fixture.addUser("carol");
+    const { code } = await fixture.service.issueAccessCode("alice");
+    const bobCode = (await fixture.service.issueAccessCode("bob")).code;
+    fixture.store.updateUser(bob.id, { active: false, updatedById: alice.id });
+    const scrypt = t.mock.method(crypto, "scrypt");
+
+    const cases = [
+      ["unknown_login", { login: "ghost", code }],
+      ["unknown_login", { login: "../../etc/passwd", code }],
+      ["unknown_login", { login: "", code }],
+      ["unknown_login", {}],
+      ["inactive", { login: "bob", code: bobCode }],
+      ["no_code", { login: "carol", code }],
+      ["wrong_code", { login: "alice", code: WRONG_CODE }],
+      ["wrong_code", { login: "alice", code: "" }],
+      ["wrong_code", { login: "alice", code: WRONG_CODE }],
+      ["wrong_code", { login: "alice", code: WRONG_CODE }],
+      ["wrong_code", { login: "alice", code: WRONG_CODE }],
+      ["locked", { login: "alice", code }]
+    ];
+    const signatures = new Set();
+    for (const [reason, credentials] of cases) {
+      const callsBefore = scrypt.mock.callCount();
+      const { error, event } = await failedLogin(fixture, credentials);
+      assertGenericFailure(error);
+      signatures.add(JSON.stringify({
+        name: error.name, message: error.message, statusCode: error.statusCode, code: error.code, details: error.details
+      }));
+      assert.equal(event.payload.reason, reason, `причина в журнале: ${reason}`);
+      // scrypt считается один раз и с одними и теми же затратами, какой бы ни была причина отказа.
+      assert.equal(scrypt.mock.callCount() - callsBefore, 1, `scrypt для случая «${reason}»`);
+      const [, salt, keylen, options] = scrypt.mock.calls.at(-1).arguments;
+      assert.equal(salt.length, 16);
+      assert.equal(keylen, 32);
+      assert.deepEqual({ N: options.N, r: options.r, p: options.p }, { N: 16384, r: 8, p: 1 });
+    }
+    assert.equal(signatures.size, 1, "снаружи все отказы выглядят одинаково");
+
+    // Внутренняя причина и логин — только в журнале.
+    const reasons = auditEvents(fixture, "auth.access_code_failed").map((event) => event.payload.reason);
+    assert.deepEqual(
+      [...new Set(reasons)].sort(),
+      ["inactive", "locked", "no_code", "unknown_login", "wrong_code"]
+    );
+    const unknown = auditEvents(fixture, "auth.access_code_failed").find((event) => event.payload.login === "ghost");
+    assert.equal(unknown.entityId, null);
+    assert.equal(unknown.payload.ip, "127.0.0.1");
+
+    // Длинный логин в журнал не пишется — только его длина: в нём мог оказаться код (задача 6, находка 1).
+    const long = await failedLogin(fixture, { login: "x".repeat(200), code });
+    assert.equal(long.event.payload.login, "[скрыто, длина 200]");
+    assertGenericFailure(long.error);
+  } finally {
+    fixture.close();
+  }
+});
