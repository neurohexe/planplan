+def validate_expense_payload(current: dict, payload: dict) -> None:
+    location_id = _p(payload, "locationId")
+    if not truthy(location_id) or strict_eq(location_id, ALL_LOCATIONS):
+        raise DomainError("Выберите локацию")
+    loc = _find(current["locations"], lambda item: strict_eq(og(item, "id"), location_id))
+    if loc is None or truthy(og(loc, "archived")):
+        raise DomainError("Локация не найдена или архивирована")
+    article = _find(current["articles"], lambda item: strict_eq(og(item, "id"), _p(payload, "articleId")) and not truthy(og(item, "archived")))
+    if article is None:
+        raise DomainError("Выберите проект")
+    subarticle_id = resolve_optional_subarticle(article, _p(payload, "subarticleId"))
+    amount = to_number(_p(payload, "amount"))
+    if not is_finite(amount) or amount <= 0:
+        raise DomainError("Введите сумму больше нуля")
+    currency = normalize_currency_code(_p(payload, "currency"))
+    if not currency:
+        raise DomainError("Выберите валюту расхода")
+    expense_date = _p(payload, "expenseDate")
+    expense_quarter = quarter_key_from_date_input(expense_date) if valid_date_input(expense_date) else current_quarter_key()
+    planned = planned_currencies_for_selection(current, location_id, expense_quarter, _p(payload, "articleId"), subarticle_id)
+    if planned and currency not in planned:
+        scope = "выбранной статьи проекта" if truthy(subarticle_id) else "проекта"
+        raise DomainError(f"Для {scope} в этом квартале нет бюджета в {currency}")
+    if not safe_http_url(_p(payload, "ticketUrl")):
+        raise DomainError("Укажите корректную ссылку на тикет")
+    if not valid_date_input(expense_date):
+        raise DomainError("Укажите корректную дату расхода")
+
+
+def validate_forecast_payload(current: dict, payload: dict) -> None:
+    location_id = _p(payload, "locationId")
+    if not truthy(location_id) or strict_eq(location_id, ALL_LOCATIONS):
+        raise DomainError("Выберите локацию")
+    location = _find(current["locations"], lambda item: strict_eq(og(item, "id"), location_id))
+    if location is None or truthy(og(location, "archived")):
+        raise DomainError("Локация не найдена или архивирована")
+    article = _find(current["articles"], lambda item: strict_eq(og(item, "id"), _p(payload, "articleId")) and not truthy(og(item, "archived")))
+    if article is None:
+        raise DomainError("Выберите проект")
+    subarticle_id = resolve_optional_subarticle(article, _p(payload, "subarticleId"))
+    amount = to_number(_p(payload, "amount"))
+    if not is_finite(amount) or amount <= 0:
+        raise DomainError("Введите сумму прогноза больше нуля")
+    currency = normalize_currency_code(_p(payload, "currency"))
+    if not currency:
+        raise DomainError("Выберите валюту прогноза")
+    if not valid_date_input(_p(payload, "expectedDate")):
+        raise DomainError("Укажите корректную ожидаемую дату")
+    quarter = quarter_key_from_date_input(_p(payload, "expectedDate"))
+    planned = planned_currencies_for_selection(current, location_id, quarter, _p(payload, "articleId"), subarticle_id)
+    if planned and currency not in planned:
+        scope = "выбранной статьи проекта" if truthy(subarticle_id) else "проекта"
+        raise DomainError(f"Для {scope} в этом квартале нет бюджета в {currency}")
+    if not safe_http_url(_p(payload, "ticketUrl")):
+        raise DomainError("Укажите корректную ссылку на тикет")
+
