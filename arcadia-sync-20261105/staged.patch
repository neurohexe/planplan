+"""Импорт отчёта по ЗП (прогнозы) — серверная часть app/expense-import.js.
+
+Файл Excel разбирает браузер; на сервер приходят разобранные строки отчёта. Здесь перенесены
+построение предпросмотра (в объёме, который влияет на результат) и применение импорта.
+"""
+
+from __future__ import annotations
+
+import functools
+import re
+from typing import Any
+
+from planfact.errors import DomainError
+
+from . import dates, period_locks
+from .budget_import import clean_text, comparison_key, fnv_hash, normalize_code, normalize_currency_code
+from .common import safe_http_url
+from .context import now_ms
+from .js import (
+    S, UNDEF, clone, dumps, entries, g, includes, is_dict, is_finite, is_list, is_str, js_floor, js_max, js_slice, keys,
+    map_get, nullish, og, or_, pk, sort_strings, spread, strict_eq, strict_ne, tail, to_base36, to_number, truthy, uniq,
+)
+
+SOURCE_TYPE = "expense-report"
+SOURCE_TICKET_KEY_VERSION = 1
+STATUS_MODES = ("forecast",)
+DATE_FIELDS = ("expected", "reservation")
+SKIP_MAPPING = "__skip__"
+
+_ISO_DATE_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})\Z")
+_ISO_DATE_PREFIX_RE = re.compile(r"([0-9]{4})-([0-9]{2})-[0-9]{2}\Z")
+_ACTIVE_STATUSES = tuple(comparison_key(item) for item in ("В работе", "Предварительно утвержден", "Утвержден"))
+_RELEASED_STATUSES = tuple(comparison_key(item) for item in ("Отклонен", "Не завершен"))
+
+
+def valid_iso_date(value: Any) -> Any:
+    match = _ISO_DATE_RE.match(S(or_(value, "")))
+    if not match:
+        return ""
+    year, month, day = int(match.group(1)), int(match.group(2)), int(match.group(3))
+    ok = year >= 100 and 1 <= month <= 12 and 1 <= day <= _days_in_month(year, month)
+    return value if ok else ""
+
+
+def _days_in_month(year: int, month: int) -> int:
+    leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
+    return (31, 29 if leap else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)[month - 1]
+
+
+def mapping_key(row: Any) -> str:
+    return dumps([
+        normalize_code(og(row, "locationCode")), normalize_code(og(row, "projectCode")), normalize_code(og(row, "programCode")),
+        comparison_key(og(row, "procurementCategory")), normalize_code(og(row, "gaapCode")), normalize_currency_code(og(row, "currency")),
+    ])
+
+
+def normalize_status_mode(value: Any) -> str:
+    return value if is_str(value) and value in STATUS_MODES else "forecast"
+
+
+def normalize_date_field(value: Any) -> str:
+    return value if is_str(value) and value in DATE_FIELDS else "expected"
+
+
+def source_forecast_ticket_key(row: Any) -> str:
+    request_number = clean_text(S(nullish(og(row, "requestNumber"), "")), 80)
+    return f"{SOURCE_TYPE}:ticket:v{SOURCE_TICKET_KEY_VERSION}:{request_number}" if request_number else ""
+
+
+def forecast_status_lifecycle(status: Any, amount: Any) -> str:
+    number = to_number(amount)
+    if not is_finite(number) or number <= 0:
+        return "review"
+    key = comparison_key(status)
+    if key in _ACTIVE_STATUSES:
+        return "active"
+    if key in _RELEASED_STATUSES:
+        return "released"
+    return "review"
+
+
+def forecast_status_reason(status: Any, lifecycle: str) -> str:
+    if lifecycle == "active":
+        return "Деньги зарезервированы"
+    if lifecycle == "released":
+        return f"Резерв освобождён: {S(or_(status, 'статус источника'))}"
+    if comparison_key(status) == comparison_key("Закрыт"):
+        return "Закрытый тикет требует подтверждения оплаты"
+    return f"Требует проверки: {S(or_(status, 'статус не задан'))}"
+
+
+def forecast_allocation_base_key(row: Any) -> str:
+    ticket_key = source_forecast_ticket_key(row)
+    if not ticket_key:
+        return ""
+    identity = [
+        normalize_currency_code(og(row, "currency")), normalize_code(og(row, "cfoCode")), normalize_code(og(row, "projectCode")),
+        normalize_code(og(row, "programCode")), normalize_code(og(row, "serviceCode")), normalize_code(og(row, "locationCode")),
+        comparison_key(og(row, "procurementCategory")), normalize_code(og(row, "gaapCode")),
+        comparison_key(og(row, "supplier")), comparison_key(og(row, "ticketUrl")),
+    ]
+    return f"{ticket_key}:allocation:{dumps(identity)}"
+
+
+def quarter_key_from_date(value: Any) -> str:
+    match = _ISO_DATE_PREFIX_RE.match(S(or_(value, "")))
+    if not match:
+        return ""
+    return f"{match.group(1)}-Q{S(js_floor((to_number(match.group(2)) - 1) / 3) + 1)}"
+
+
+def state_location(state: dict, code: Any) -> list:
+    wanted = normalize_code(code)
+    return [location for location in or_(state.get("locations", UNDEF), []) if normalize_code(og(location, "code")) == wanted]
+
+
+def state_project(state: dict, row: Any) -> list:
+    wanted = normalize_code(og(row, "projectCode"))
+    matches = [
+        article for article in or_(state.get("articles", UNDEF), [])
+        if not truthy(og(article, "archived")) and normalize_code(og(article, "code")) == wanted
+    ]
+    if len(matches) <= 1:
+        return matches
+    exact = [article for article in matches if comparison_key(og(article, "name")) == comparison_key(og(row, "projectName"))]
+    return exact if len(exact) == 1 else matches
+
+
+def amount_currencies(value: Any) -> list[str]:
+    return list(value.keys()) if truthy(value) and is_dict(value) else []
+
+
+def budgeted_subarticles(state: dict, location_id: Any, article: dict, currency: Any, quarter: str) -> list:
+    store = or_(og(og(state, "budgets"), f"{S(location_id)}|{quarter}"), {})
+    result = []
+    for subarticle in or_(og(article, "subarticles"), []):
+        amounts = og(store, f"{S(og(article, 'id'))}|{S(og(subarticle, 'id'))}")
+        amount = to_number(og(amounts, pk(currency)))
+        if amount != 0 and is_finite(amount):
+            result.append(subarticle)
+    return result
+
+
+def budgeted_subarticles_any_period(state: dict, location_id: Any, article: dict, currency: Any) -> list:
+    ids: dict = {}
+    prefix = f"{S(location_id)}|"
+    for store_key, store in entries(or_(og(state, "budgets"), {})):
+        if not store_key.startswith(prefix) or not truthy(store) or not (is_dict(store) or is_list(store)):
+            continue
+        for subarticle in or_(og(article, "subarticles"), []):
+            amount = to_number(og(og(store, f"{S(og(article, 'id'))}|{S(og(subarticle, 'id'))}"), pk(currency)))
+            if is_finite(amount) and amount != 0:
+                ids[pk(og(subarticle, "id"))] = True
+    return [subarticle for subarticle in or_(og(article, "subarticles"), []) if pk(og(subarticle, "id")) in ids]
+
+
+def matching_subarticle_by_source(article: dict, row: Any) -> Any:
+    names = {name for name in (comparison_key(og(row, field)) for field in ("programName", "procurementCategory", "gaapName")) if name}
+    matches = [
+        subarticle for subarticle in or_(og(article, "subarticles"), [])
+        if not truthy(og(subarticle, "archived")) and comparison_key(og(subarticle, "name")) in names
+    ]
+    return matches[0] if len(matches) == 1 else None
+
+
+def automatic_subarticle(state: dict, location: dict, article: dict, row: Any, expense_date: Any) -> Any:
+    exact = matching_subarticle_by_source(article, row)
+    if exact is not None:
+        return exact
+    current = budgeted_subarticles(state, og(location, "id"), article, og(row, "currency"), quarter_key_from_date(expense_date))
+    if len(current) == 1:
+        return current[0]
+    any_period = budgeted_subarticles_any_period(state, og(location, "id"), article, og(row, "currency"))
+    if len(any_period) == 1:
+        return any_period[0]
+    active = [subarticle for subarticle in or_(og(article, "subarticles"), []) if not truthy(og(subarticle, "archived"))]
+    return active[0] if len(active) == 1 else None
+
+
+def planned_currencies(state: dict, location_id: Any, article_id: Any, subarticle_id: Any, expense_date: Any) -> list[str]:
+    store = or_(og(og(state, "budgets"), f"{S(location_id)}|{quarter_key_from_date(expense_date)}"), {})
+    if truthy(subarticle_id):
+        return amount_currencies(og(store, f"{S(article_id)}|{S(subarticle_id)}"))
+    currencies = uniq(amount_currencies(og(store, pk(article_id))))
+    prefix = f"{S(article_id)}|"
+    for item_key, item_values in (store.items() if is_dict(store) else []):
+        if not item_key.startswith(prefix):
+            continue
+        currencies = uniq([*currencies, *amount_currencies(item_values)])
+    return sort_strings(currencies)
+
+
+def expense_comment(row: Any) -> str:
+    parts = [f"ЗП №{S(og(row, 'requestNumber'))}", f"Поставщик: {S(og(row, 'supplier'))}" if truthy(og(row, "supplier")) else "",
+             og(row, "description")]
+    return clean_text(" · ".join(S(part) for part in parts if truthy(part)), 500)
+
+
+def desired_forecast_allocation(row: Any, location: dict, article: dict, subarticle: Any, expected_date: Any, source_file: Any,
+                                allocation_key: str) -> dict:
+    lifecycle = forecast_status_lifecycle(og(row, "status"), og(row, "amount"))
+    amount = to_number(og(row, "amount"))
+    return {
+        "sourceAllocationKey": allocation_key,
+        "locationId": og(location, "id"),
+        "articleId": og(article, "id"),
+        "subarticleId": or_(og(subarticle, "id"), None),
+        "currency": og(row, "currency"),
+        "amount": js_max(0, amount if truthy(amount) else 0),
+        "expectedDate": expected_date,
+        "quarterKey": quarter_key_from_date(expected_date),
+        "lifecycle": lifecycle,
+        "lifecycleSource": "source",
+        "stale": False,
+        "comment": expense_comment(row),
+        "sourceFile": clean_text(source_file, 200),
+        "sourceStatus": og(row, "status"),
+        "sourceReservationDate": og(row, "reservationDate"),
+        "sourceExpectedDate": og(row, "expectedDate"),
+        "sourceRow": og(row, "sourceRow"),
+        "convertedExpenseId": None,
+        "convertedAmount": None,
+        "releaseReason": forecast_status_reason(og(row, "status"), lifecycle) if lifecycle == "released" else "",
+    }
+
+
+def forecast_allocation_changed(existing: dict, desired: dict) -> bool:
+    for field in ("locationId", "articleId", "subarticleId", "currency"):
+        if strict_ne(og(existing, field), desired[field]):
+            return True
+    if strict_ne(to_number(og(existing, "amount")), to_number(desired["amount"])):
+        return True
+    for field in ("expectedDate", "lifecycle", "lifecycleSource"):
+        if strict_ne(og(existing, field), desired[field]):
+            return True
+    if og(existing, "stale") is True:
+        return True
+    for field in ("comment", "sourceStatus", "sourceReservationDate", "sourceExpectedDate"):
+        if strict_ne(og(existing, field), desired[field]):
+            return True
+    return False
+
+
+def ticket_lifecycle(allocations: Any) -> str:
+    states = uniq(og(allocation, "lifecycle") for allocation in or_(allocations, []))
+    if includes(states, "active"):
+        return "active"
+    if includes(states, "review"):
+        return "review"
+    if len(states) == 1 and includes(states, "converted"):
+        return "converted"
+    if includes(states, "converted") and includes(states, "released"):
+        return "converted"
+    return "released"
+
+
+def _compare_source_rows(left: Any, right: Any) -> int:
+    diff = to_number(g(left, "sourceRow")) - to_number(g(right, "sourceRow"))
+    if diff != diff or diff == 0:
+        return 0
+    return -1 if diff < 0 else 1
+
+
+def build_expense_import_preview(state: Any, raw_rows: Any, options: dict) -> dict:
+    """Предпросмотр импорта. Группы сопоставления статей (только для экрана) не строятся: на результат
+    применения они не влияют."""
+    if not truthy(state) or not is_dict(state):
+        raise DomainError("Нет текущего состояния приложения")
+    if not is_list(raw_rows) or not raw_rows:
