+    "sharedProfile", "sharedProfileName", "sharedProfileRole", "sharedProfileLogin", "profileDescription",
+    "adminUsersDescription", "userLoginLabel"
+  ].map((key) => [key, element()]));
+  const effects = { requests: [], writes: [], console: [], toasts: [], reloads: 0, redirects: [], streams: [], timers: [], renders: 0, storageUpdates: 0 };
+  const values = new Map();
+  const storage = {
+    getItem: (key) => values.get(key) ?? null,
+    setItem(key, value) { effects.writes.push([key, value]); values.set(key, value); },
+    removeItem(key) { values.delete(key); }
+  };
+  class TestEventSource {
+    constructor(url) { this.url = url; this.listeners = {}; this.closed = false; effects.streams.push(this); }
+    addEventListener(type, handler) { this.listeners[type] = handler; }
+    close() { this.closed = true; }
+    emit(type, payload) { this.listeners[type]?.({ data: JSON.stringify(payload) }); }
+  }
+  const context = vm.createContext({
+    URL, URLSearchParams, AbortSignal, EventSource: TestEventSource,
+    require: createRequire(path.join(APP_ROOT, "app.js")),
+    PLAN_FACT_RUNTIME: { mode: "server" },
+    localStorage: storage, sessionStorage: storage,
+    document: {
