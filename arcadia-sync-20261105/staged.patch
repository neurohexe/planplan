+"""Бизнес-логика сервера: вход по коду, сессии, состояние, изменения, блокировки, журнал
+(перенос backend/src/service.js для режима access-code).
+
+Изменение данных выполняется в одной транзакции с блокировкой строки application_state: проверка
+ревизии, прав и блокировки записи, применение правила, запись состояния и журнала идут без
+вмешательства параллельных запросов, как в прежнем однопоточном сервере.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import re
+import secrets
+import uuid
+from datetime import timedelta
+from typing import Any
+
+from django.db import transaction
+
+from planfact import access_codes
+from planfact.config import ACCESS_CODE_AUTH_MODE, Config
+from planfact.domain import context, js, rules
+from planfact.domain.mutations import apply_local_mutation
+from planfact.domain.state import create_initial_state, normalize_state
+from planfact.errors import AppError, AuthenticationError, AuthorizationError, ConflictError, LockedError
+from planfact.realtime import RealtimeHub
+from planfact.store import Store, audit_limit, from_iso, iso, now_dt, public_user
+
+_MUTATION_ID_RE = re.compile(r"[A-Za-z0-9._:-]{8,200}\Z")
+ALLOWED_LOCK_TYPES = ("expense", "forecast", "budget", "project", "location")
+
+
+def random_token(size: int = 32) -> str:
+    """crypto.randomBytes(32).toString("base64url")."""
+    return secrets.token_urlsafe(size)
+
+
+def token_hash(token: Any) -> str:
+    return hashlib.sha256(js.S(token if js.truthy(token) else "").encode("utf-8")).hexdigest()
+
+
+def normalize_name(value: Any, max_length: int = 80) -> str:
+    return js.js_slice(js.collapse_ws(js.js_trim(value)), 0, max_length) if isinstance(value, str) else ""
+
+
+def audit_client(ip: Any, user_agent: Any) -> dict:
+    return {
+        "ip": js.js_slice(js.S(ip), 0, 64) if js.truthy(ip) else None,
+        "userAgent": js.js_slice(js.S(user_agent if js.truthy(user_agent) else ""), 0, 500),
+    }
+
+
+def public_session_user(row: dict, access: dict | None = None) -> dict:
+    return {
+        "id": row["id"],
+        "name": row["name"],
+        "staffLogin": row["staff_login"],
+        "staffUidBound": bool(row["staff_uid"]),
+        "role": row["role"],
+        "active": row["active"] is True,
+        "defaultLocationAccess": row["default_location_access"] or "hidden",
+        "locationAccess": access if access is not None else {},
+    }
+
+
+def _previous(collection: str, *states: dict) -> list[dict]:
+    """Прежние записи по id: в исходном виде (как хранились) и в приведённом (после normalizeState)."""
+    result = []
+    for state in states:
+        mapping: dict = {}
+        for item in js.or_(state.get(collection), []):
+            identifier = js.og(item, "id")
+            if isinstance(identifier, str):
+                mapping[identifier] = item
+        result.append(mapping)
+    return result
+
+
+def _unchanged(item: Any, versions: list[dict]) -> bool | None:
+    """None — записи не было; True — запись совпадает с прежней в исходном или приведённом виде.
+    Сравниваются сами структуры (быстрее, чем текст JSON; порядок полей значения не имеет)."""
+    identifier = js.og(item, "id")
+    if not isinstance(identifier, str):
+        return None
+    known = [mapping[identifier] for mapping in versions if identifier in mapping]
+    if not known:
+        return None
+    return any(item == previous for previous in known)
+
+
+def stamp_changes(before: dict, baseline: dict, after: dict, actor: dict) -> dict:
+    """stampActor из domain.js: новые записи получают автора, изменённые — того, кто изменил.
+
+    Отличие от прежнего сервера: запись считается изменённой, только если отличается от прежней и в
+    исходном, и в приведённом виде. Прежний сервер сравнивал с исходным видом, и только что добавленная
+    (короткая) запись при следующем же изменении данных получала «изменил» другого пользователя."""
+    for collection in ("expenses", "forecastTickets"):
+        versions = _previous(collection, before, baseline)
+        for item in js.or_(after.get(collection), []):
+            unchanged = _unchanged(item, versions)
+            if unchanged is None:
+                item["createdBy"] = actor["name"]
+                item["createdById"] = actor["id"]
+            elif not unchanged:
+                item["updatedBy"] = actor["name"]
+                item["updatedById"] = actor["id"]
+    previous_comments = {js.og(item, "id") for item in js.or_(before.get("comments"), []) if isinstance(js.og(item, "id"), str)}
+    for item in js.or_(after.get("comments"), []):
+        if js.og(item, "id") not in previous_comments:
+            item["createdBy"] = actor["name"]
+            item["createdById"] = actor["id"]
+    return after
+
+
+def changed_location_ids(before: dict, baseline: dict, after: dict) -> list:
+    """changedLocationIds из domain.js с тем же уточнением, что и stamp_changes."""
+    ids: list = []
+    expense_versions = _previous("expenses", before, baseline)
+    for item in js.or_(after.get("expenses"), []):
+        if not _unchanged(item, expense_versions):
+            ids.append(js.og(item, "locationId"))
+    ticket_versions = _previous("forecastTickets", before, baseline)
+    for ticket in js.or_(after.get("forecastTickets"), []):
+        if not _unchanged(ticket, ticket_versions):
+            ids.extend(rules.ticket_locations(ticket))
+    if not js.uniq(ids) and js.dumps(before) != js.dumps(after) and js.dumps(baseline) != js.dumps(after):
+        for item in js.or_(after.get("expenses"), []):
+            ids.append(js.og(item, "locationId"))
+        for ticket in js.or_(after.get("forecastTickets"), []):
+            ids.extend(rules.ticket_locations(ticket))
+    return [value for value in js.uniq(ids) if js.truthy(value)]
+
+
+def _ms(value: str | None) -> float:
+    if value is None:
+        return float("inf")
+    return from_iso(value).timestamp() * 1000
+
+
+class PlanFactService:
+    def __init__(self, store: Store, config: Config, realtime: RealtimeHub):
+        self.store = store
+        self.config = config
+        self.realtime = realtime
+
+    # --- состояние
+
+    @staticmethod
+    def initial_state() -> dict:
+        return normalize_state(create_initial_state())
+
+    def get_state(self, *, for_update: bool = False) -> dict:
+        return self.store.get_state(for_update=for_update, initial_state=self.initial_state)
+
+    def session_mode(self) -> str:
+        return self.config.auth_mode or "legacy"
+
+    def readiness(self) -> dict:
+        try:
+            result = self.store.check_ready()
+        except RuntimeError:
+            # Пустая база получает начальное состояние, как при запуске прежнего сервера.
+            self.store.ensure_state(self.initial_state())
+            result = self.store.check_ready()
+        return {"status": "ready", "storageDriver": "postgres", "revision": int(result["revision"] or 0)}
+
+    # --- пользователи (технические процедуры)
+
+    def provision_staff_account(self, *, staff_login: Any, name: Any, role: Any, allow_existing: bool = False,
+                                audit_action: str = "staff_access.provisioned") -> dict:
+        login = access_codes.normalize_staff_login(staff_login)
+        normalized_name = normalize_name(name) or login
+        if role not in ("user", "admin", "superadmin"):
+            raise AppError("Некорректная роль для provisioning")
+        existing = self.store.get_user_by_staff_login(login)
+        if existing is not None:
+            if not allow_existing:
+                raise ConflictError("Пользователь с таким Staff login уже существует")
+            if not existing.active or existing.role != role:
+                raise ConflictError(f"Staff login {login} уже существует с другим статусом или ролью")
+            return {"account": self.store.public_user(existing.id), "created": False}
+        user = self.store.create_user({
+            "id": str(uuid.uuid4()), "name": normalized_name, "nameKey": f"staff:{login}", "staffLogin": login,
+            "staffUid": None, "role": role, "defaultLocationAccess": "hidden", "locationAccess": {}, "createdAt": iso(now_dt()),
+        })
+        self.store.append_audit({
+            "actorName": "Техническая процедура", "action": audit_action, "entityType": "user", "entityId": user["id"],
+            "payload": {"staffLogin": login, "role": role, "defaultLocationAccess": user["defaultLocationAccess"]},
+        })
+        return {"account": user, "created": True}
+
+    def provision_staff_accounts(self, accounts: list[dict]) -> list[dict]:
+        if not accounts:
+            raise AppError("Список Staff-аккаунтов для provisioning пуст")
+        normalized = []
+        for account in accounts:
+            login = access_codes.normalize_staff_login(account.get("staffLogin"))
+            if account.get("role") not in ("user", "admin", "superadmin"):
+                raise AppError(f"Некорректная роль для Staff login {login}")
+            normalized.append({"staffLogin": login, "name": normalize_name(account.get("name")) or login, "role": account["role"]})
+        seen: set[str] = set()
+        for account in normalized:
+            if account["staffLogin"] in seen:
+                raise AppError(f"Staff login {account['staffLogin']} указан несколько раз")
+            seen.add(account["staffLogin"])
+            existing = self.store.get_user_by_staff_login(account["staffLogin"])
+            if existing is not None and (not existing.active or existing.role != account["role"]):
+                raise ConflictError(f"Staff login {account['staffLogin']} уже существует с другим статусом или ролью")
+        return [
+            self.provision_staff_account(staff_login=account["staffLogin"], name=account["name"], role=account["role"], allow_existing=True)
+            for account in normalized
+        ]
+
+    def provision_superadmin(self, *, staff_login: Any, name: Any) -> dict:
+        return self.provision_staff_account(staff_login=staff_login, name=name, role="superadmin", audit_action="superadmin.provisioned")["account"]
+
+    # --- сессии
+
+    def auth_summary(self, session: dict | None = None) -> dict:
+        return {"user": self.session_user(session) if session else None, "authentication": "staff-webauth"}
+
+    def session_user(self, session: dict | None) -> dict | None:
+        if not session or not session.get("user"):
+            return None
+        return public_session_user(session["user"], self.store.get_location_access(session["userId"]))
+
+    def session_by_token(self, token: str | None, *, touch: bool = True) -> dict | None:
+        if not token:
+            return None
+        session = self.store.get_session_by_token_hash(token_hash(token))
+        if session is None:
+            return None
+        try:
+            self.require_session(session)
+        except AppError:
+            return None
+        return self.touch_session(session) if touch else session
+
+    def touch_session(self, session: dict) -> dict:
+        now = context.now_ms()
+        remaining = _ms(session["expiresAt"]) - now
+        if remaining <= self.config.session_max_age_ms / 2:
+            expires = js_iso_ms(min(now + self.config.session_max_age_ms, _ms(session.get("authExpiresAt"))))
+            self.store.touch_session(session["id"], expires)
+            session["expiresAt"] = expires
+        return session
+
+    def open_session(self, user, *, ip: Any, user_agent: Any, audit_action: str, audit_payload: dict) -> dict:
+        """Общая часть входа: закрыть прежнюю сессию в realtime, создать новую (у пользователя она одна),
+        записать вход в журнал."""
+        now = context.now_ms()
+        previous = self.store.get_active_user_session(user.id)
+        if previous:
+            self.realtime.close_session(previous["id"], "session_replaced")
+        token = random_token()
+        session_id = str(uuid.uuid4())
+        self.store.create_session({
+            "id": session_id, "userId": user.id, "tokenHash": token_hash(token), "createdAt": js_iso_ms(now),
+            "expiresAt": js_iso_ms(now + self.config.session_max_age_ms), "authMode": self.session_mode(), "authRole": None,
+            "authExpiresAt": None, "ip": ip, "userAgent": js.js_slice(js.S(user_agent if js.truthy(user_agent) else ""), 0, 500),
+        })
+        session = self.store.get_session_by_token_hash(token_hash(token))
+        self.store.append_audit({
+            "actorId": user.id, "actorName": user.name, "sessionId": session_id, "action": audit_action, "entityType": "user",
+            "entityId": user.id, "payload": {**audit_payload, "replacedPreviousSession": bool(previous)},
+        })
+        return {"token": token, "session": session, "user": self.session_user(session)}
+
+    def issue_access_code(self, login: Any) -> dict:
+        """Новый личный код. Код возвращается только вызывающему: в базе остаётся один хэш."""
+        staff_login = access_codes.normalize_staff_login(login)
+        user = self.store.get_user_by_staff_login(staff_login)
+        if user is None:
+            raise AppError(
+                f"Пользователь {staff_login} не найден: сначала заведите его (superadmin — командой "
+                "provision_staff_access, остальных — в интерфейсе)", 404, "not_found",
+            )
+        if not user.active:
+            raise AppError(f"Доступ пользователя {staff_login} отключён: код не выдаётся", 403, "staff_access_disabled")
+        code = access_codes.generate_access_code()
+        code_hash, salt = access_codes.hash_new_code(code)
+        self.store.save_access_code(user_id=user.id, code_hash=code_hash, salt=salt, kdf_params=access_codes.KDF,
+                                    issued_at=js_iso_ms(context.now_ms()))
+        # Прежние сессии закрываются так же, как при выходе: блокировки записей, сами сессии, realtime.
+        previous = self.store.get_active_user_session(user.id)
+        self.store.delete_locks_by_user(user.id)
+        self.store.delete_user_sessions(user.id)
+        if previous:
+            self.realtime.close_session(previous["id"], "access_code_reissued")
+        self.store.append_audit({
+            "actorName": "Техническая процедура", "action": "auth.access_code_issued", "entityType": "user",
+            "entityId": user.id, "payload": {"login": staff_login, "closedSession": bool(previous)},
+        })
+        return {"login": staff_login, "code": code}
+
+    def login_with_access_code(self, *, login: Any, code: Any, ip: Any, user_agent: Any) -> dict:
+        """Любая неудача выглядит одинаково (401 с общим текстом); причина — только в журнале."""
+        at = now_dt()
+        try:
+            staff_login = access_codes.normalize_staff_login(login)
+        except AppError:
+            staff_login = None
+        user = self.store.get_user_by_staff_login(staff_login) if staff_login else None
+        record = self.store.get_access_code(user.id) if user is not None else None
+        kdf = access_codes.parse_kdf(record.kdf_params) if record is not None else None
+        # scrypt считается всегда и с теми же затратами, какой бы ни была причина отказа.
+        derived = access_codes.derive_key(
+            access_codes.normalize_access_code(code), record.salt if kdf else access_codes.DUMMY_SALT, kdf or access_codes.KDF
+        )
+        if user is None:
+            reason = "unknown_login"
+        elif not user.active:
+            reason = "inactive"
+        elif record is None or kdf is None or derived is None:
+            reason = "no_code"
+        elif record.locked_until is not None and record.locked_until > at:
+            reason = "locked"
+        elif not access_codes.safe_equal(derived.hex(), record.code_hash):
+            reason = "wrong_code"
+        else:
+            reason = None
+        if reason is None and not self.store.reset_access_code_failures(user.id, now=iso(at), code_hash=record.code_hash):
+            # Пока проверялся код, логин успели заблокировать или код заменили.
+            reason = "locked"
+        if reason is not None:
+            failure = (
+                self.store.record_access_code_failure(user.id, now=iso(at), max_failures=access_codes.MAX_FAILURES,
+                                                      lock_ms=access_codes.LOCK_MS)
+                if reason == "wrong_code" else None
+            )
+            payload = {
+                "reason": reason,
+                "login": user.staff_login if user is not None else access_codes.audit_login_value(login),
+                **audit_client(ip, user_agent),
+            }
+            if failure:
+                payload.update({"failedAttempts": failure["failedAttempts"], "lockedUntil": failure["lockedUntil"]})
+            self.store.append_audit({
+                "action": "auth.access_code_failed", "entityType": "user", "entityId": user.id if user is not None else None,
+                "payload": payload,
+            })
+            raise AuthenticationError(access_codes.FAILURE_MESSAGE)
+        return self.open_session(user, ip=ip, user_agent=user_agent, audit_action="auth.access_code_login",
+                                 audit_payload={"login": user.staff_login, **audit_client(ip, user_agent)})
+
+    def logout(self, session: dict | None, *, reason: str | None = None) -> None:
+        if not session:
+            return
+        self.store.release_session_locks(session["id"])
+        self.store.delete_session(session["id"])
+        self.store.append_audit({
+            "actorId": session["userId"], "actorName": session["user"]["name"], "sessionId": session["id"],
+            "action": "auth.logout", "entityType": "user", "entityId": session["userId"],
+            "payload": {"reason": reason} if reason else {},
+        })
+        self.realtime.close_session(session["id"], reason or "logout")
+
+    def require_session(self, session: dict | None) -> dict:
+        if not session:
+            raise AuthenticationError()
+        if (session.get("authMode") or self.session_mode()) != self.session_mode():
+            self.logout(session, reason="auth_mode_changed")
+            raise AuthenticationError()
+        return session
+
+    # --- состояние для пользователя
+
+    def state_for(self, session: dict | None) -> dict:
+        self.require_session(session)
+        state = self.get_state()
+        user = self.session_user(session)
+        warnings = self.store.hidden_warnings(session["userId"])
+        return {"user": user, "state": rules.project_state(state, user, user["locationAccess"], warnings, copy=False)}
+
+    def projected_state_for_session(self, session: dict, state: dict, user: dict, access: dict) -> dict:
+        return rules.project_state(state, user, access, self.store.hidden_warnings(session["userId"]), copy=False)
+
+    # --- управление пользователями (superadmin)
+
+    def _superadmin(self, session: dict | None) -> dict:
+        self.require_session(session)
+        actor = self.session_user(session)
+        if actor["role"] != "superadmin":
+            raise AuthorizationError("Пользователями и доступами управляет только superadmin")
+        return actor
+
+    def list_managed_users(self, session: dict | None) -> list[dict]:
+        actor = self._superadmin(session)
+        return [item for item in self.store.list_users() if item["role"] != "superadmin" or item["id"] == actor["id"]]
+
+    def save_account(self, session: dict, payload: dict, mutation_id: str | None = None) -> dict:
+        actor = self._superadmin(session)
+        state = self.get_state()
+        valid_locations = {js.og(item, "id") for item in state.get("locations", []) if isinstance(js.og(item, "id"), str)}
+        requested = {
+            location_id: level for location_id, level in js.entries(js.or_(payload.get("locationAccess", js.UNDEF), {}))
+            if location_id in valid_locations and level in ("hidden", "view", "edit")
+        }
+        staff_login = access_codes.normalize_staff_login(payload.get("staffLogin"))
+        name = normalize_name(payload.get("name")) or staff_login
+        role = "admin" if payload.get("role") == "admin" else "user"
+        default_access = "view" if role == "user" and payload.get("defaultLocationAccess") == "view" else "hidden"
+        existing = self.store.get_user(payload.get("id")) if js.truthy(payload.get("id")) else None
+        if js.truthy(payload.get("id")) and existing is None:
+            raise AppError("Пользователь не найден", 404, "not_found")
+        if existing is not None and existing.role == "superadmin":
+            raise AuthorizationError("Аккаунты superadmin управляются только технически")
+        if existing is not None and existing.staff_uid and existing.staff_login != staff_login:
+            raise AppError("Привязанный Staff login обновляется автоматически при корпоративном входе")
+        duplicate = self.store.get_user_by_staff_login(staff_login)
+        if duplicate is not None and (existing is None or duplicate.id != existing.id):
+            raise ConflictError("Пользователь с таким Staff login уже существует")
+        identity_changed = existing is not None and existing.staff_login != staff_login
+        access = requested if role == "user" else {}
+        if existing is not None:
+            result = self.store.update_user(existing.id, {
+                "name": name, "nameKey": f"staff:{staff_login}", "staffLogin": staff_login, "role": role,
+                "defaultLocationAccess": default_access, "locationAccess": access, "updatedById": actor["id"],
+            })
+        else:
+            result = self.store.create_user({
+                "id": str(uuid.uuid4()), "name": name, "nameKey": f"staff:{staff_login}", "staffLogin": staff_login, "staffUid": None,
+                "role": role, "defaultLocationAccess": default_access, "locationAccess": access, "createdById": actor["id"],
+            })
+        self.store.append_audit({
+            "actorId": actor["id"], "actorName": actor["name"], "sessionId": session["id"],
+            "action": "account.updated" if existing is not None else "account.created", "mutationId": mutation_id,
+            "entityType": "user", "entityId": result["id"],
+            "payload": {"staffLogin": staff_login, "name": result["name"], "role": result["role"],
+                        "defaultLocationAccess": default_access, "locationAccess": result["locationAccess"]},
+        })
+        if identity_changed:
+            old = self.store.get_active_user_session(existing.id)
+            self.store.delete_user_sessions(existing.id)
+            if old:
+                self.realtime.close_session(old["id"], "staff_identity_changed")
+        return result
+
+    def archive_account(self, session: dict, payload: dict, mutation_id: str | None = None) -> dict:
+        actor = self._superadmin(session)
+        archived = payload.get("archived") is True
+        target = self.store.get_user(payload.get("id"))
+        if target is None:
+            raise AppError("Пользователь не найден", 404, "not_found")
+        if target.role == "superadmin":
+            raise AuthorizationError("Аккаунты superadmin управляются только технически")
+        if target.id == actor["id"]:
+            raise AuthorizationError("Нельзя отключить собственный аккаунт")
+        if not archived and not target.staff_login:
+            raise AppError("Сначала укажите Staff login, затем включите пользователя", 400, "staff_login_required")
+        account = self.store.update_user(target.id, {"active": not archived, "updatedById": actor["id"]})
+        if archived:
+            self.store.delete_user_sessions(target.id)
+            self.store.delete_locks_by_user(target.id)
+        self.store.append_audit({
+            "actorId": actor["id"], "actorName": actor["name"], "sessionId": session["id"],
+            "action": "account.disabled" if archived else "account.enabled", "mutationId": mutation_id,
+            "entityType": "user", "entityId": target.id, "payload": {"targetName": target.name},
+        })
+        return account
+
+    # --- блокировки записей
+
+    def acquire_lock(self, session: dict | None, payload: dict) -> dict:
+        self.require_session(session)
+        resource_type = payload.get("resourceType")
+        resource_id = payload.get("resourceId")
+        if resource_type not in ALLOWED_LOCK_TYPES or not isinstance(resource_type, str) or not js.js_trim(
+            js.S(resource_id if js.truthy(resource_id) else "")
+        ):
+            raise AppError("Некорректный ресурс блокировки")
+        actor = self.session_user(session)
+        rules.authorize_lock(resource_type, js.S(resource_id), self.get_state(), actor, actor["locationAccess"])
+        token = random_token()
+        now = context.now_ms()
+        expires_at = js_iso_ms(now + self.config.lock_ttl_ms)
+        result = self.store.acquire_lock({
+            "resourceType": resource_type, "resourceId": js.S(resource_id), "userId": session["userId"], "sessionId": session["id"],
+            "tokenHash": token_hash(token), "now": js_iso_ms(now), "expiresAt": expires_at,
+        })
+        if not result["acquired"]:
+            lock = result["lock"]
+            raise LockedError(f"Запись редактирует {lock['owner_name']}", {"ownerName": lock["owner_name"], "expiresAt": lock["expires_at"]})
+        return {"resourceType": resource_type, "resourceId": js.S(resource_id), "lockToken": token, "expiresAt": expires_at}
+
+    def heartbeat_lock(self, session: dict | None, payload: dict) -> dict:
+        self.require_session(session)
+        expires_at = js_iso_ms(context.now_ms() + self.config.lock_ttl_ms)
+        if not self.store.refresh_lock(payload.get("resourceType"), js.S(payload.get("resourceId", js.UNDEF)), session["id"],
+                                       token_hash(payload.get("lockToken")), expires_at):
+            raise LockedError("Блокировка потеряна или истекла")
+        return {"expiresAt": expires_at}
+
+    def release_lock(self, session: dict | None, payload: dict) -> dict:
+        self.require_session(session)
+        return {"released": self.store.release_lock(payload.get("resourceType"), js.S(payload.get("resourceId", js.UNDEF)),
+                                                    session["id"], token_hash(payload.get("lockToken")))}
+
+    def assert_mutation_lock(self, session: dict, kind: str, payload: dict) -> None:
+        if not self.config.require_locks:
+            return
+        resource = rules.lock_resource(kind, payload)
+        if resource is None:
+            return
+        lock = self.store.get_lock(resource["resourceType"], js.S(resource["resourceId"]))
+        if lock is None or lock["owner_session_id"] != session["id"] or lock["token_hash"] != token_hash(payload.get("lockToken")):
+            raise LockedError(
+                f"Запись редактирует {lock['owner_name']}" if lock
+                else "Сначала откройте запись в режиме редактирования и получите блокировку",
+                {"ownerName": lock["owner_name"], "expiresAt": lock["expires_at"]} if lock else None,
+            )
+
+    # --- изменение данных
+
+    def mutate(self, session: dict | None, command: dict) -> dict:
+        self.require_session(session)
+        kind = js.S(command.get("type") if js.truthy(command.get("type")) else "")
+        mutation_id = js.S(command.get("mutationId")) if js.truthy(command.get("mutationId")) else str(uuid.uuid4())
+        if not _MUTATION_ID_RE.match(mutation_id):
+            raise AppError("Некорректный mutationId", 400, "invalid_mutation_id")
+        idempotent = self.store.find_audit_by_mutation_id(mutation_id)
+        if idempotent:
+            return {**self.state_for(session), "idempotent": True, "auditEventId": idempotent["id"]}
+        actor = self.session_user(session)
+        access = actor["locationAccess"]
+        raw_payload = command.get("payload")
+        # Массив вместо объекта — то же, что пустой объект (у массива в JavaScript нет нужных полей).
+        raw_payload = raw_payload if isinstance(raw_payload, dict) else {}
+
+        if kind == "saveAccount":
+            with transaction.atomic():
+                account = self.save_account(session, raw_payload, mutation_id)
+            return {**self.state_for(session), "account": account}
+        if kind == "archiveAccount":
+            with transaction.atomic():
+                account = self.archive_account(session, raw_payload, mutation_id)
+            return {**self.state_for(session), "account": account}
+        if kind == "dismissTrackerWarning":
+            return self.dismiss_warning(session, raw_payload, mutation_id)
+
+        base_revision = js.to_number(command.get("baseRevision", js.UNDEF))
+        if not js.is_integer(base_revision):
+            current = self.get_state()
+            raise ConflictError("Некорректная ревизия данных", {
+                "state": self.projected_state_for_session(session, current, actor, access)
+            })
+
+        with transaction.atomic():
+            before = self.get_state(for_update=True)
+            repeated = self.store.find_audit_by_mutation_id(mutation_id)
+            if repeated:
+                event_id = repeated["id"]
+                result = None
+            else:
+                retryable = rules.can_retry_create_mutation(kind, raw_payload, before)
+                if base_revision != before["revision"] and not retryable:
+                    raise ConflictError("Данные уже изменились. Получена актуальная версия.", {
+                        "state": self.projected_state_for_session(session, before, actor, access)
+                    })
+                rules.authorize_mutation(kind, raw_payload, before, actor, access)
+                self.assert_mutation_lock(session, kind, raw_payload)
+                payload = rules.clean_payload(raw_payload, actor)
+                # Сравниваем и с приведённым к полному виду состоянием «до»: только что добавленная запись
+                # хранится в коротком виде, и прежний сервер принимал её нормализацию за правку — ставил
+                # «изменил» чужим записям и учитывал их локации при проверке прав импорта.
+                baseline = normalize_state(js.clone(before))
+                after = apply_local_mutation(before, kind, payload, normalized=baseline)
+                after = stamp_changes(before, baseline, after, actor)
+                after["revision"] = before["revision"] + 1
+                if kind == "importExpenses":
+                    locations_changed = changed_location_ids(before, baseline, after)
+                    if not locations_changed or any(not rules.can_edit(actor, access, item) for item in locations_changed):
+                        raise AuthorizationError("Импорт затрагивает локацию без права редактирования")
+                entity = rules.audit_entity(kind, payload)
+                locations = rules.mutation_location_ids(kind, payload, before)
+                if not self.store.save_state(after, before["revision"]):
+                    raise ConflictError("Состояние было изменено параллельно", {
+                        "state": self.projected_state_for_session(session, self.get_state(), actor, access)
+                    })
+                event_id = self.store.append_audit({
+                    "revision": after["revision"], "actorId": actor["id"], "actorName": actor["name"], "sessionId": session["id"],
+                    "action": f"mutation.{kind}", "mutationId": mutation_id, **entity,
+                    "locationId": locations[0] if len(locations) == 1 else None,
+                    "payload": rules.sanitize_audit_payload(payload),
+                })
+                result = after
+                # Рассылается всем подключённым сессиям без учёта прав на локации, поэтому событие
+                # не раскрывает, кто и где внёс изменение.
+                transaction.on_commit(lambda: self.realtime.publish({
+                    "type": "state-changed", "revision": after["revision"], "mutationType": kind,
+                }))
+        if result is None:
+            return {**self.state_for(session), "idempotent": True, "auditEventId": event_id}
+        return {
+            "user": actor,
+            "state": rules.project_state(result, actor, access, self.store.hidden_warnings(actor["id"]), copy=False),
+            "auditEventId": event_id,
+        }
+
+    def dismiss_warning(self, session: dict, payload: dict, mutation_id: str) -> dict:
+        actor = self.session_user(session)
+        state = self.get_state()
+        warning = next(
+            (item for item in js.or_(js.og(state.get("trackerSync"), "warnings"), []) if js.strict_eq(js.og(item, "id"), payload.get("id", js.UNDEF))),
+            None,
+        )
+        if warning is None:
+            raise AppError("Предупреждение не найдено", 404, "not_found")
+        location_id = rules.warning_location(state, warning)
+        access = actor["locationAccess"]
+        if not js.truthy(location_id) or (not rules.is_admin(actor) and not rules.can_edit(actor, access, location_id)):
+            raise AuthorizationError()
+        fingerprint = js.S(js.or_(warning.get("fingerprint"), ""))
+        with transaction.atomic():
+            self.store.hide_warning(actor["id"], warning["id"], fingerprint)
+            self.store.append_audit({
+                "revision": state["revision"], "actorId": actor["id"], "actorName": actor["name"], "sessionId": session["id"],
+                "action": "tracker.warning_hidden_personally", "mutationId": mutation_id, "entityType": "tracker_warning",
+                "entityId": warning["id"], "payload": {"fingerprint": js.or_(warning.get("fingerprint"), ""), "locationId": location_id},
+            })
+        return self.state_for(session)
+
+    def request_tracker_sync(self, session: dict | None, payload: dict) -> dict:
+        self.require_session(session)
+        actor = self.session_user(session)
+        access = actor["locationAccess"]
+        state = self.get_state()
+        all_ids = js.uniq(item["id"] for item in state.get("locations", []) if not js.truthy(item.get("archived")))
+        location_ids = payload.get("locationIds", js.UNDEF)
+        if location_ids is js.UNDEF or location_ids is None:
+            location_ids = []
+        if not isinstance(location_ids, list):
+            raise TypeError("locationIds.map is not a function")
+        requested = js.uniq(js.S(item) for item in location_ids)
+        selected = requested if requested else [item for item in all_ids if rules.can_view(actor, access, item)]
+        if any(item not in all_ids or not rules.can_view(actor, access, item) for item in selected):
+            raise AuthorizationError("Нет доступа к одной из выбранных локаций")
+        existing = self.store.active_sync_job("tracker")
+        if existing:
+            return {"jobId": existing["id"], "joined": True}
+        with transaction.atomic():
+            job_id = self.store.create_sync_job({
+                "kind": "tracker", "requestedById": actor["id"], "sessionId": session["id"],
+                "scope": {"locationIds": selected}, "cancelIfSessionEnds": False,
+            })
+            self.store.append_audit({
+                "actorId": actor["id"], "actorName": actor["name"], "sessionId": session["id"], "action": "tracker.sync_requested",
+                "entityType": "sync_job", "entityId": job_id, "payload": {"locationIds": selected},
+            })
+        self.realtime.publish({"type": "tracker-sync-queued", "jobId": job_id, "locationIds": selected})
+        return {"jobId": job_id, "joined": False}
+
+    def list_audit(self, session: dict | None, *, actor_id: Any = None, before: Any = None, limit: Any = None) -> list[dict]:
+        self.require_session(session)
+        before_dt = None
+        if before:
+            milliseconds = js_parse_ms(before)
+            if milliseconds != milliseconds:
+                raise AppError("Некорректный параметр before", 400, "invalid_before")
+            before_dt = from_iso(js_iso_ms(milliseconds))
+        actor = self.session_user(session)
+        if rules.is_admin(actor):
+            return self.store.list_audit(actor_id=actor_id or None, limit=limit, before=before_dt)
+        access = actor["locationAccess"]
+        visible = {location_id for location_id, level in access.items() if level in ("view", "edit")}
+        rows = self.store.list_audit(limit=500, before=before_dt)
+        count = audit_limit(limit)
+        return [
+            event for event in rows
+            if event["actorId"] == actor["id"] or (event["locationId"] and event["locationId"] in visible)
+        ][:count]
+
+
+def js_iso_ms(milliseconds: float) -> str:
+    from planfact.domain.dates import iso as domain_iso
+
+    return domain_iso(milliseconds)
+
+
+def js_parse_ms(value: Any) -> float:
+    from planfact.domain.dates import parse
+
+    return parse(value)
+
+
+__all__ = ["PlanFactService", "public_user", "timedelta", "ACCESS_CODE_AUTH_MODE"]
