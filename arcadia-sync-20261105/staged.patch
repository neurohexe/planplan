+"""Настройки Django. Всё, что относится к стенду, читается из переменных PLAN_FACT_* (planfact/config.py)."""
+
+import os
+import secrets
+import sys
+
+from planfact.config import BACKEND_DIR, database_settings, load_config
+
+PLAN_FACT = load_config()
+
+# Подписи Django (сессии, CSRF) приложение не использует: вход и защита запросов — свои, как в прежнем
+# сервере. Ключ нужен самому Django; если его не задали, он случайный на каждый запуск.
+SECRET_KEY = os.environ.get("PLAN_FACT_DJANGO_SECRET_KEY") or secrets.token_urlsafe(50)
+DEBUG = os.environ.get("PLAN_FACT_DJANGO_DEBUG") == "1"
+# Имя сайта проверяет само приложение (ответ 403 host_forbidden, как раньше), поэтому Django пропускает любое.
+ALLOWED_HOSTS = ["*"]
+
+INSTALLED_APPS = ["planfact"]
+MIDDLEWARE: list[str] = []
+ROOT_URLCONF = "planfact_site.urls"
+WSGI_APPLICATION = "planfact_site.wsgi.application"
+TEMPLATES: list = []
+
+if PLAN_FACT.database_url:
+    DATABASES = {
+        "default": database_settings(
+            PLAN_FACT.database_url,
+            ssl_mode=PLAN_FACT.database_ssl,
+            statement_timeout_ms=PLAN_FACT.database_statement_timeout_ms,
+        )
+    }
+else:
+    # Без адреса базы работают только команды, которым база не нужна (например, check);
+    # сервер при запуске сообщит понятную ошибку.
+    DATABASES = {"default": {"ENGINE": "django.db.backends.postgresql", "NAME": "planfact"}}
+
+DEFAULT_AUTO_FIELD = "django.db.models.BigAutoField"
+USE_TZ = True
+TIME_ZONE = PLAN_FACT.time_zone
+USE_I18N = False
+LANGUAGE_CODE = "ru"
+# Размер тела запроса ограничивает само приложение (PLAN_FACT_MAX_REQUEST_BYTES, 4 КБ для входа).
+DATA_UPLOAD_MAX_MEMORY_SIZE = None
+DATA_UPLOAD_MAX_NUMBER_FIELDS = None
+APPEND_SLASH = False
+
+LOGGING = {
+    "version": 1,
+    "disable_existing_loggers": False,
+    "formatters": {"plain": {"format": "%(message)s"}},
+    "handlers": {"stderr": {"class": "logging.StreamHandler", "stream": sys.stderr, "formatter": "plain"}},
+    "loggers": {
+        "planfact": {"handlers": ["stderr"], "level": "INFO", "propagate": False},
+        "django": {"handlers": ["stderr"], "level": "WARNING", "propagate": False},
+        # Ответы 4xx и 5xx не пишутся отдельной строкой: внутренние ошибки записывает сам обработчик
+        # («Plan Fact request failed …»), без тела запроса, как прежний сервер.
+        "django.request": {"handlers": [], "level": "CRITICAL", "propagate": False},
+    },
+}
+
+TEST_RUNNER = "django.test.runner.DiscoverRunner"
+BASE_DIR = BACKEND_DIR
+
+# Статику и медиа Django приложение не использует (интерфейс отдаёт сам обработчик из PLAN_FACT_STATIC_DIR).
+# Адреса нужны только тестовому серверу Django, который без них не запускается.
+STATIC_URL = "/__django-static-unused__/"
+MEDIA_URL = "/__django-media-unused__/"
