@@ -0,0 +1,359 @@
+#!/bin/bash
+# Проверки переезда стенда (задача 13): deploy/move/pack.sh на «старом» и deploy/move/unpack.sh на «новом» стенде.
+# Живой тест только в собственной .sandbox: два стенда без launchd/systemd на портах 18785 и 18786,
+# выдуманные логины alice, bob, carol и выдуманный пароль архива. Работает на macOS и на Linux.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)
+case "$(uname -s)" in
+  Darwin) KIND=laptop; MARKER_DIR=launchd; NO_AUTOSTART=--no-launchd ;;
+  Linux) KIND=linux; MARKER_DIR=systemd; NO_AUTOSTART=--no-systemd ;;
+  *) printf 'Тест рассчитан на macOS или Linux.\n' >&2; exit 1 ;;
+esac
+NODE_BINARY=$(command -v node)
+OLD_PORT=18785
+NEW_PORT=18786
+PASSWORD='vydumannyj-parol-13'
+PASSED=0
+DIST_EXISTED=false
+[ ! -e "$PROJECT_ROOT/dist" ] || DIST_EXISTED=true
+mkdir -p "$PROJECT_ROOT/.sandbox"
+TEST_ROOT=$(mktemp -d "$PROJECT_ROOT/.sandbox/task-13.XXXXXX")
+if [ "$KIND" = laptop ]; then
+  # На Mac пути с пробелами и кавычкой проверяют экранирование в скриптах переезда.
+  OLD="$TEST_ROOT/старый стенд & 'кавычка'"
+  NEW="$TEST_ROOT/новый стенд"
+else
+  # Linux-установщик принимает только латинские пути без пробелов (файлы служб systemd).
+  OLD="$TEST_ROOT/old-stand"
+  NEW="$TEST_ROOT/new-stand"
+fi
+FAKE_HOME="$TEST_ROOT/home"
+# prepare-new.sh пишет журнал тестов мастерской в .sandbox; чужой журнал не трогаем, свой убираем.
+PREPARE_LOG="$PROJECT_ROOT/.sandbox/prepare-npm-test.log"
+PREPARE_LOG_EXISTED=false
+[ ! -e "$PREPARE_LOG" ] || PREPARE_LOG_EXISTED=true
+FINISHED=false
+cleanup() {
+  local status=$?
+  [ "$PREPARE_LOG_EXISTED" = true ] || rm -f -- "$PREPARE_LOG"
+  for stand in "$OLD" "$NEW"; do
+    if [ -f "$stand/data/app.pid" ] && [ -f "$stand/bin/maintenance-server.mjs" ]; then
+      PLANFACT_HOME="$stand" bash -c 'set -a; . "$1/config.env"; set +a; "$PLAN_FACT_NODE_BIN" "$1/bin/maintenance-server.mjs" stop-test "$1"' _ "$stand" >/dev/null 2>&1 || true
+    fi
+  done
+  rm -rf -- "$TEST_ROOT"
+  [ "$DIST_EXISTED" = true ] || rm -rf -- "$PROJECT_ROOT/dist"
+  rmdir "$PROJECT_ROOT/.sandbox" 2>/dev/null || true
+  # bash 3.2 после ошибки «unbound variable» выходит с кодом последней команды ловушки (0): без отметки о завершении это сбой.
+  [ "$FINISHED" = true ] || [ "$status" -ne 0 ] || status=1
+  exit "$status"
+}
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+check() {
+  local title=$1
+  shift
+  "$@" || { printf 'Не пройдена проверка: %s\n' "$title" >&2; exit 1; }
+  PASSED=$((PASSED + 1))
+  printf 'Пройдена проверка %s: %s.\n' "$PASSED" "$title"
+}
+# Команда должна завершиться ошибкой; вывод — в $TEST_ROOT/result.txt.
+fails() {
+  if "$@" > "$TEST_ROOT/result.txt" 2>&1; then return 1; fi
+}
+said() { grep -q -- "$1" "$TEST_ROOT/result.txt"; }
+port_is_free() {
+  "$NODE_BINARY" -e '
+const socket = require("node:net").connect({ host: "127.0.0.1", port: Number(process.argv[1]) });
+socket.once("connect", () => { socket.destroy(); process.exit(1); });
+socket.once("error", () => process.exit(0));' "$1"
+}
+ports_are_free() { port_is_free "$OLD_PORT" && port_is_free "$NEW_PORT"; }
+# Архив без служебных данных macOS (._файлы, xattr): иначе подложные архивы отклонялись бы по другой причине.
+clean_tar() {
+  local version
+  version=$(tar --version 2>/dev/null) || version=''
+  case "$version" in
+    *bsdtar*) COPYFILE_DISABLE=1 tar --no-acls --no-xattrs --no-mac-metadata -c -z -f - "$@" ;;
+    *) tar -c -z -f - "$@" ;;
+  esac
+}
+server() { PLANFACT_HOME="$1" bash -c 'set -a; . "$1/config.env"; set +a; NODE_NO_WARNINGS=1 "$PLAN_FACT_NODE_BIN" "$1/bin/maintenance-server.mjs" "$2" "$1"' _ "$1" "$2"; }
+ready() { [ "$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 2 "http://127.0.0.1:$1/api/ready")" = 200 ]; }
+logins_are() {
+  NODE_NO_WARNINGS=1 "$NODE_BINARY" --experimental-sqlite - "$1" "$2" <<'NODE'
+const { DatabaseSync } = require('node:sqlite'), assert = require('node:assert/strict');
+const db = new DatabaseSync(process.argv[2], { readOnly: true });
+try { assert.deepEqual(db.prepare('SELECT staff_login FROM users ORDER BY staff_login').all().map((row) => row.staff_login), JSON.parse(process.argv[3])); }
+finally { db.close(); }
+NODE
+}
+# Снимок состояния стенда для проверок «ничего не изменено»: пользователи, файлы кодов и служебные папки.
+stand_state() {
+  NODE_NO_WARNINGS=1 "$NODE_BINARY" --experimental-sqlite - "$1" <<'NODE'
+const fs = require('node:fs'), crypto = require('node:crypto'), { DatabaseSync } = require('node:sqlite');
+const root = process.argv[2];
+const db = new DatabaseSync(root + '/data/plan-fact.sqlite', { readOnly: true });
+let users; try { users = db.prepare('SELECT staff_login FROM users ORDER BY staff_login').all().map((row) => row.staff_login); } finally { db.close(); }
+const codes = fs.readdirSync(root + '/codes').sort().map((name) => name + ':' + crypto.createHash('sha256').update(fs.readFileSync(root + '/codes/' + name)).digest('hex'));
+const backups = fs.readdirSync(root + '/backups').filter((name) => !['hourly', 'daily'].includes(name)).sort();
+console.log(JSON.stringify({ users, codes, backups }));
+NODE
+}
+same_state() { [ "$(stand_state "$1")" = "$2" ]; }
+encrypt_test_archive() { "$OPENSSL" enc -e -aes-256-cbc -md sha256 -pbkdf2 -iter 200000 -salt -pass fd:3 -out "$1" 3< <(printf '%s\n' "$PASSWORD"); }
