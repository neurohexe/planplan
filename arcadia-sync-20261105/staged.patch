+class AccessCodeConcurrencyTests(ServiceTestMixin, TransactionTestCase):
+    def test_failures_from_parallel_requests_are_never_lost(self):
+        self.service.issue_access_code("alice")
+        errors = []
+
+        def attempt():
+            try:
+                self.login("alice", "ZZZZZ-ZZZZZ-ZZZZZ-ZZZZZ")
+            except AuthenticationError:
+                pass
+            except Exception as error:  # noqa: BLE001
+                errors.append(error)
+            finally:
+                connection.close()
+
+        threads = [threading.Thread(target=attempt) for _ in range(4)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+        self.assertEqual(errors, [])
+        self.assertEqual(AccessCode.objects.get(user_id=self.alice["id"]).failed_attempts, 4)
+
