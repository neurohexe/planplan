--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/close-sessions.mjs
@@ -0,0 +1,54 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import net from 'node:net';
+import crypto from 'node:crypto';
+import { DatabaseSync } from 'node:sqlite';
+
+const [root, database, portText] = process.argv.slice(2);
+const port = Number(portText);
+try {
+  if (!root || !database || !path.isAbsolute(root) || !path.isAbsolute(database) || !Number.isInteger(port) || port < 1 || port > 65535) {
+    throw new Error('Неверные параметры выбранного стенда.');
+  }
+  const relative = path.relative(root, database);
+  if (!relative || relative === '..' || relative.startsWith(`..${path.sep}`)) throw new Error('База должна находиться внутри стенда.');
+  let current = root;
+  for (const component of ['', ...relative.split(path.sep)]) {
+    if (component) current = path.join(current, component);
+    if (fs.lstatSync(current).isSymbolicLink()) throw new Error('Путь базы не должен содержать символические ссылки.');
+  }
+  if (!fs.statSync(database).isFile()) throw new Error('База должна быть обычным существующим файлом.');
+  for (const suffix of ['-wal', '-shm']) {
+    let info;
+    try { info = fs.lstatSync(database + suffix); }
+    catch (error) { if (error.code === 'ENOENT') continue; throw error; }
+    if (!info.isFile() || info.isSymbolicLink()) throw new Error('Служебные файлы базы не должны быть символическими ссылками.');
+  }
+  await new Promise((resolve, reject) => {
+    const socket = net.createConnection({ host: '127.0.0.1', port });
+    socket.once('connect', () => { socket.destroy(); reject(new Error('Сервер ещё работает. Сначала остановите его.')); });
+    socket.once('error', (error) => {
+      socket.destroy();
+      if (error.code === 'ECONNREFUSED') resolve();
+      else reject(new Error('Не удалось безопасно проверить остановку сервера.'));
+    });
+    socket.setTimeout(1500, () => { socket.destroy(); reject(new Error('Не удалось подтвердить остановку сервера.')); });
+  });
+  const db = new DatabaseSync(database);
+  try {
+    db.exec('PRAGMA foreign_keys = ON; PRAGMA busy_timeout = 5000; BEGIN IMMEDIATE');
+    const locks = Number(db.prepare('DELETE FROM edit_locks').run().changes);
+    const sessions = Number(db.prepare('DELETE FROM sessions').run().changes);
+    db.prepare(`INSERT INTO audit_events(id, actor_name, action, payload_json, created_at)
+      VALUES (?, ?, ?, ?, ?)`)
+      .run(crypto.randomUUID(), 'Обслуживание стенда', 'auth.sessions_cleared', JSON.stringify({ sessions, locks }), new Date().toISOString());
+    db.exec('COMMIT');
+    console.log(`Все сеансы завершены: ${sessions}; блокировки освобождены: ${locks}. Данные приложения сохранены.`);
+  } catch (error) {
+    try { db.exec('ROLLBACK'); } catch {}
+    throw error;
+  } finally { db.close(); }
+} catch (error) {
+  console.error(`Ошибка: ${error.message}`);
+  process.exitCode = 1;
+}
