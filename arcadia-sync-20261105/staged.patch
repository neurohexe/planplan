+check 'с --delete-token удаляется только токен, пароль копий остаётся' /bin/bash -c '[ "$1" -eq 0 ] && [ ! -e "$2/secrets/tracker-token" ] && [ -f "$2/secrets/offsite-password" ]' _ "$LAST_STATUS" "$STAND"
+
+# 10. Секреты нигде не печатаются.
+check 'токен и пароль не попали в вывод, журналы, настройки, файлы служб и запросы' "$NODE_BINARY" - "$STAND" "$ALL_OUTPUT" "$TRACKER" "$TOKEN" "$PASSWORD" <<'NODE'
+const fs = require('node:fs'), path = require('node:path'), assert = require('node:assert/strict');
+const [root, output, tracker, token, password] = process.argv.slice(2);
+const files = [output, path.join(root, 'config.env'), path.join(tracker, 'calls.log'), path.join(tracker, 'comment.json')];
+for (const name of fs.readdirSync(path.join(root, 'logs'))) files.push(path.join(root, 'logs', name));
