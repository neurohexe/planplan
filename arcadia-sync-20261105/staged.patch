+def _add_forecast(nxt: dict, payload: dict, now: str) -> None:
+    validate_forecast_payload(nxt, payload)
+    period_locks.assert_month_editable(nxt, _month_key(_p(payload, "expectedDate")))
+    article = _find(nxt["articles"], lambda item: strict_eq(og(item, "id"), _p(payload, "articleId")))
+    ticket_id = clean_text(_p(payload, "id"), 160) or new_id()
+    allocation_id = clean_text(_p(payload, "allocationId"), 160) or new_id()
+    if any(strict_eq(og(item, "id"), ticket_id) or any(strict_eq(og(part, "id"), allocation_id)
+        for part in or_(og(item, "allocations"), [])) for item in nxt["forecastTickets"]):
+        raise DomainError("Запись с таким идентификатором уже существует")
+    nxt["forecastTickets"].append({
+        "id": ticket_id,
+        "sourceType": None,
+        "sourceTicketKey": None,
+        "sourceRequestNumber": clean_text(_p(payload, "requestNumber"), 80) or ticket_label(_p(payload, "ticketUrl")),
+        "ticketUrl": safe_http_url(_p(payload, "ticketUrl")),
+        "description": clean_text(_p(payload, "comment"), 500),
+        "supplier": "",
+        "sourceFile": None,
+        "sourceStatus": None,
+        "lifecycle": "active",
+        "createdAt": now,
+        "createdBy": _author(payload),
+        "createdById": None,
+        "updatedAt": None,
+        "updatedBy": None,
+        "updatedById": None,
+        "lastImportedAt": None,
+        "history": [],
+        "allocations": [{
+            "id": allocation_id,
+            "sourceAllocationKey": None,
+            "locationId": _p(payload, "locationId"),
+            "articleId": _p(payload, "articleId"),
+            "subarticleId": resolve_optional_subarticle(article, _p(payload, "subarticleId")),
+            "currency": normalize_currency_code(_p(payload, "currency")),
+            "amount": to_number(_p(payload, "amount")),
+            "expectedDate": _p(payload, "expectedDate"),
+            "quarterKey": quarter_key_from_date_input(_p(payload, "expectedDate")),
+            "lifecycle": "active",
+            "lifecycleSource": "manual",
+            "stale": False,
+            "comment": clean_text(_p(payload, "comment"), 500),
+            "sourceFile": None,
+            "sourceStatus": None,
+            "sourceReservationDate": None,
+            "sourceExpectedDate": None,
+            "sourceRow": None,
+            "convertedExpenseId": None,
+            "convertedAmount": None,
+            "releaseReason": "",
+        }],
+    })
