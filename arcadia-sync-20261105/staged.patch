+import { fileURLToPath } from "node:url";
+
+const projectRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const outputRoot = join(projectRoot, "dist");
+const publicRoot = join(outputRoot, "app");
+const backendRoot = join(outputRoot, "backend");
+
+const staticFiles = [
+  "app.js",
+  "budget-import.js",
+  "expense-import.js",
+  "graphite.css",
+  "index.html",
+  "nav-drawer.css",
+  "nav-drawer.js",
+  "period-locks.js",
+  "plan-fact-chart.css",
+  "plan-fact-chart.js",
+  "runtime-config.js",
+  "styles.css",
+  "tracker-sync.js"
+];
+
+// Страница не должна ссылаться на файл, который не попадёт на стенд.
+const pageAssets = [...(await readFile(join(projectRoot, "app", "index.html"), "utf8"))
+  .matchAll(/<(?:script|link)\b[^>]*\b(?:src|href)="([^"]+)"/g)]
+  .map((match) => match[1]);
+const missingPageAssets = pageAssets.filter((file) => !staticFiles.includes(file));
+if (missingPageAssets.length) {
+  throw new Error(`index.html ссылается на файлы вне сборки: ${missingPageAssets.sort().join(", ")}`);
+}
+
+await rm(outputRoot, { recursive: true, force: true });
+await mkdir(publicRoot, { recursive: true });
+await mkdir(join(backendRoot, "src"), { recursive: true });
+await mkdir(join(backendRoot, "migrations", "sqlite"), { recursive: true });
+await mkdir(join(backendRoot, "migrations", "postgres"), { recursive: true });
+
+for (const file of staticFiles) {
+  await copyFile(join(projectRoot, "app", file), join(publicRoot, file));
+}
+
+const backendFiles = [
+  "access-control.js",
+  "cli.js",
+  "config.js",
+  "corporate-identity-sessions.js",
+  "corporate-login.js",
+  "corporate-roles.js",
+  "domain.js",
+  "errors.js",
+  "http-server.js",
+  "identity-provider.js",
+  "idm.js",
+  "index.js",
+  "migrate-sqlite-to-postgres.js",
+  "postgres-store.js",
+  "realtime.js",
+  "security.js",
+  "service.js",
+  "sqlite-store.js",
+  "store-factory.js",
+  "time.js",
+  "tirole-freshness-proxy.js",
+  "tirole-source.js",
+  "webauth-corporate-adapter.js"
+];
+
+// Список backend/src явный, но новый файл не должен тихо выпасть из сборки и образа.
+const missingBackendFiles = (await readdir(join(projectRoot, "backend", "src")))
+  .filter((file) => file.endsWith(".js") && !backendFiles.includes(file));
+if (missingBackendFiles.length) {
+  throw new Error(`backend/src не включён в сборку: ${missingBackendFiles.sort().join(", ")}`);
+}
+
+for (const file of backendFiles) {
+  await copyFile(join(projectRoot, "backend", "src", file), join(backendRoot, "src", file));
+}
+
+await copyFile(join(projectRoot, "backend", "package.json"), join(backendRoot, "package.json"));
+await copyFile(join(projectRoot, "backend", "package-lock.json"), join(backendRoot, "package-lock.json"));
+// Все миграции обязательны: сервер применяет их по номерам при старте.
+for (const dialect of ["sqlite", "postgres"]) {
+  const directory = join(projectRoot, "backend", "migrations", dialect);
+  const migrations = (await readdir(directory)).filter((file) => /^\d+_.+\.sql$/.test(file)).sort();
+  for (const file of migrations) {
+    await copyFile(join(directory, file), join(backendRoot, "migrations", dialect, file));
+  }
+}
