+#!/bin/bash
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=common.sh
+. "$SCRIPT_DIR/common.sh"
+DELETE_DATA=false
+case "$#" in
+  0) ;;
+  1) [ "$1" = --delete-data ] || fail 'Использование: uninstall.sh [--delete-data]'; DELETE_DATA=true ;;
+  *) fail 'Использование: uninstall.sh [--delete-data]' ;;
+esac
+if [ "$DELETE_DATA" = true ]; then
+  # Удаляем только папку установленного стенда (в ней есть config.env) и называем её целиком.
+  [ -f "$STAND/config.env" ] && [ ! -L "$STAND/config.env" ] || fail "В папке $STAND нет config.env: это не стенд. Ничего не удалено."
+  printf 'Удалить папку стенда %s вместе с данными, кодами и копиями — точно? Введите «да»: ' "$STAND"
+  answer=''
+  read -r answer || true
+  if [ "$answer" != да ]; then
+    printf 'Удаление отменено.\n'
+    exit 0
+  fi
+fi
+stop_agents
+if systemd_enabled; then
+  # Выключаем автозапуск и удаляем из папки служб только файлы этого стенда; службы другого стенда оставляем.
+  for label in $(stand_labels); do
+    agent_is_ours "$label" || continue
+    for unit in $(agent_files "$label"); do
+      [ ! -e "$UNIT_DIR/$unit" ] || user_systemctl disable "$unit" >/dev/null 2>&1 || fail "Не удалось выключить автозапуск $unit."
+      rm -f -- "$UNIT_DIR/$unit"
+    done
+  done
+  user_systemctl daemon-reload >/dev/null 2>&1 || fail 'systemd не перечитал папку служб (daemon-reload).'
+fi
+for file in "$SERVICE_DIR"/ru.planfact.mvp.*.service "$SERVICE_DIR"/ru.planfact.mvp.*.timer "$SERVICE_DIR"/ru.planfact.mvp.*.manual; do
+  [ -f "$file" ] || continue
+  rm -f -- "$file"
+done
+if [ "$DELETE_DATA" = true ]; then
+  rm -rf -- "$STAND"
+  printf 'Службы и папка стенда удалены.\n'
+else
+  printf 'Службы удалены. Данные, коды, резервные копии и настройки сохранены.\n'
+fi
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/move/move-check.mjs b/junk/padolskiye/plan_fact_minipc/deploy/move/move-check.mjs
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/move/move-check.mjs
@@ -0,0 +1,142 @@
+// Переезд стенда (задача 13): проверки для pack.sh и unpack.sh. Только стандартные средства Node.
+// Имена и содержимое файлов с кодами не печатаются; из базы читаются только число пользователей и ревизия данных.
+import fs from 'node:fs';
+import path from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+
+const SNAPSHOT = /^plan-fact-\d{8}-\d{4}\.sqlite$/;
+// Имя файла кода — логин (правило STAFF_LOGIN_PATTERN и запрет «..» из cli.js) с расширением .txt.
+const CODE_FILE = /^[a-z0-9][a-z0-9._-]{1,63}\.txt$/;
+const MANIFEST = 'planfact-move.txt';
+// Служебный файл Finder: в архив не попадает, наличие в папке codes не мешает упаковке.
+const FINDER = '.DS_Store';
+
+class UserError extends Error {}
+
+function info(file) { return fs.lstatSync(file, { throwIfNoEntry: false }); }
+function codeName(name) { return CODE_FILE.test(name) && !name.includes('..'); }
+function lines(file) { return fs.readFileSync(file, 'utf8').split('\n').filter((line) => line !== ''); }
+
+// Имена файлов кодов в папке. Ссылки, вложенные папки и посторонние файлы — отказ: в архив попадает только понятное.
+function codeFiles(directory) {
+  const folder = info(directory);
+  if (!folder?.isDirectory()) throw new UserError('Папка codes не найдена или это не обычная папка.');
+  const names = [];
+  for (const name of fs.readdirSync(directory)) {
+    const entry = info(path.join(directory, name));
+    if (name === FINDER && entry.isFile()) continue;
+    if (!entry.isFile() || !codeName(name)) {
+      throw new UserError('В папке codes есть посторонний файл, папка или ссылка (не <логин>.txt). Ничего не удаляйте — напишите Стефании.');
+    }
+    names.push(name);
+  }
+  return names.sort();
+}
+
+// Самая новая копия в backups/hourly, созданная не раньше начала упаковки (секунды Unix).
+function latestSnapshot(folder, startedAt) {
+  const names = fs.readdirSync(folder).filter((name) => SNAPSHOT.test(name) && info(path.join(folder, name))?.isFile()).sort();
+  const latest = names.pop();
+  if (!latest) throw new UserError('Свежая резервная копия не найдена.');
+  if (fs.statSync(path.join(folder, latest)).mtimeMs < Number(startedAt) * 1000 - 2000) {
+    throw new UserError('Свежая резервная копия не создалась: самая новая копия старше начала упаковки.');
+  }
+  return latest;
+}
+
+// Сводка без содержимого: целостность, ревизия данных и число пользователей.
+function summary(file) {
+  const db = new DatabaseSync(file, { readOnly: true });
+  try {
+    db.exec('PRAGMA busy_timeout = 5000');
+    const rows = db.prepare('PRAGMA integrity_check').all();
+    if (rows.length !== 1 || rows[0].integrity_check !== 'ok') throw new UserError('Проверка целостности базы не вернула ok.');
+    const revision = db.prepare('SELECT revision FROM application_state WHERE singleton = 1').get()?.revision ?? 0;
+    const users = db.prepare('SELECT count(*) AS count FROM users').get().count;
+    return { revision: Number(revision), users: Number(users) };
+  } finally { db.close(); }
+}
+
+function expectedNames(snapshot, codes) {
+  return [MANIFEST, snapshot, 'codes/', ...codes.map((name) => `codes/${name}`)].sort();
+}
+
+// Проверка упакованного архива: список tar -t совпадает с тем, что упаковывали.
+function checkPacked(namesFile, snapshot, codesDirectory) {
+  const actual = lines(namesFile).map((name) => (name === 'codes' ? 'codes/' : name)).sort();
+  const expected = expectedNames(snapshot, codeFiles(codesDirectory));
+  if (JSON.stringify(actual) !== JSON.stringify(expected)) throw new UserError('Состав архива не совпал с упакованными файлами.');
+}
+
+// Проверка архива до распаковки. names — вывод tar -t, types — вывод tar -tv (первый символ строки — тип записи).
+// Допустимы только описание, одна копия базы, папка codes и файлы <логин>.txt в ней; ссылки и особые файлы — отказ.
+// Печатает имя копии базы и число кодов.
+function checkArchive(namesFile, typesFile) {
+  const names = lines(namesFile), types = lines(typesFile);
+  if (names.length !== types.length || names.length > 10000) throw new UserError('Не удалось разобрать список файлов архива.');
+  if (types.some((line) => line[0] !== '-' && line[0] !== 'd')) throw new UserError('В архиве есть ссылки или особые файлы. Архив отклонён.');
+  const seen = new Set();
+  let snapshot = '', codes = 0, manifest = false, folder = false;
+  for (const raw of names) {
+    const name = raw === 'codes' ? 'codes/' : raw;
+    if (seen.has(name)) throw new UserError('В архиве повторяются файлы. Архив отклонён.');
+    seen.add(name);
+    if (name === MANIFEST) manifest = true;
+    else if (name === 'codes/') folder = true;
+    else if (SNAPSHOT.test(name) && !snapshot) snapshot = name;
+    else if (name.startsWith('codes/') && codeName(name.slice('codes/'.length))) codes += 1;
+    else throw new UserError('В архиве есть неожиданные файлы. Архив отклонён.');
+  }
+  if (!manifest || !snapshot || !folder) throw new UserError('В архиве не хватает описания, копии базы или папки codes. Архив отклонён.');
+  console.log(`${snapshot} ${codes}`);
+}
+
+function readManifest(file) {
+  const values = {};
+  for (const line of lines(file)) {
+    const match = line.match(/^([a-z]+)=(.*)$/);
+    if (match) values[match[1]] = match[2];
+  }
+  return values;
+}
+
+// Проверка распакованных файлов: ровно ожидаемые обычные файлы, описание сходится с копией базы и папкой codes.
+// Печатает ревизию, число пользователей и время копии из описания.
+function checkTree(directory, snapshot, codesCount) {
+  const top = fs.readdirSync(directory).sort();
+  if (JSON.stringify(top) !== JSON.stringify(['codes', MANIFEST, snapshot].sort())) throw new UserError('Распакованные файлы не совпали со списком архива.');
+  for (const name of [MANIFEST, snapshot]) {
+    const entry = info(path.join(directory, name));
+    if (!entry.isFile() || entry.nlink !== 1) throw new UserError('Распакованный файл не является обычным файлом.');
+  }
+  const codes = info(path.join(directory, 'codes'));
+  if (!codes.isDirectory()) throw new UserError('Распакованная папка codes не является папкой.');
+  const names = codeFiles(path.join(directory, 'codes'));
+  for (const name of names) {
+    if (info(path.join(directory, 'codes', name)).nlink !== 1) throw new UserError('Файл кода в архиве — жёсткая ссылка. Архив отклонён.');
+  }
+  const manifest = readManifest(path.join(directory, MANIFEST));
+  const database = summary(path.join(directory, snapshot));
+  if (manifest.format !== '1' || manifest.database !== snapshot || manifest.codes !== String(names.length)
+    || names.length !== Number(codesCount) || manifest.revision !== String(database.revision) || manifest.users !== String(database.users)) {
+    throw new UserError('Описание архива не совпало с его содержимым. Архив отклонён.');
+  }
+  console.log(`${database.revision} ${database.users} ${manifest.created || 'неизвестно'}`);
+}
+
+try {
+  const [command, ...args] = process.argv.slice(2);
+  switch (command) {
+    case 'codes-count': console.log(codeFiles(args[0]).length); break;
+    case 'latest-snapshot': console.log(latestSnapshot(args[0], args[1])); break;
+    case 'summary': { const result = summary(args[0]); console.log(`${result.revision} ${result.users}`); break; }
+    case 'check-packed': checkPacked(args[0], args[1], args[2]); break;
+    case 'check-archive': checkArchive(args[0], args[1]); break;
+    case 'check-tree': checkTree(args[0], args[1], args[2]); break;
+    default: throw new UserError('Неизвестная команда проверки переезда.');
+  }
+} catch (error) {
+  // Сообщения SQLite и пути к файлам кодов не печатаем.
+  console.error(`Ошибка: ${error instanceof UserError ? error.message : 'не удалось прочитать файлы переезда'}`);
+  process.exitCode = 1;
+}
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/move/move-common.sh b/junk/padolskiye/plan_fact_minipc/deploy/move/move-common.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/move/move-common.sh
@@ -0,0 +1,140 @@
+#!/bin/bash
+# Переезд стенда на другой компьютер (задача 13): общие функции pack.sh, unpack.sh и prepare-new.sh.
+# Архив переезда — tar.gz с копией базы, папкой codes и описанием planfact-move.txt, зашифрованный паролем
+# владельца: openssl enc -aes-256-cbc -md sha256 -pbkdf2 -iter 200000. LibreSSL на Mac и OpenSSL на Linux
+# понимают друг друга (проверено в задаче 35). Пароль читается без отображения, хранится только в переменной
+# этого процесса и уходит в openssl через отдельный дескриптор (fd 3): его нет ни в аргументах команд, ни в файлах.
+set -euo pipefail
+umask 077
+MOVE_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+PROJECT_ROOT=$(CDPATH= cd -- "$MOVE_DIR/../.." && pwd -P)
+MOVE_PASSWORD=''
+MOVE_ARCHIVE_PATTERN='planfact-move-*.tar.gz.enc'
+
+fail() { printf 'Ошибка: %s\n' "$*" >&2; exit 1; }
+say() { printf '%s\n' "$*"; }
+
+# Папка стенда: PLANFACT_HOME (для проверок) или ~/PlanFactMVP. В ней должен быть установленный стенд.
+move_stand() {
+  STAND=${PLANFACT_HOME:-$HOME/PlanFactMVP}
+  case "$STAND" in /*) ;; *) fail 'PLANFACT_HOME должен быть полным путём, начиная с /.' ;; esac
+  [ ! -L "$STAND" ] || fail 'Папка стенда не должна быть символической ссылкой.'
+  [ -d "$STAND" ] || fail "Не найдена папка стенда $STAND. Сначала установите стенд."
+  STAND=$(CDPATH= cd -- "$STAND" && pwd -P)
+  [ -f "$STAND/config.env" ] && [ ! -L "$STAND/config.env" ] || fail "В папке $STAND нет config.env: стенд не установлен."
+}
+
+move_require_node() {
+  local version
+  case "$1" in /*) ;; *) fail 'Путь к Node должен быть полным (PLAN_FACT_NODE_BIN в config.env).' ;; esac
+  [ -x "$1" ] || fail "Не найден Node: $1."
+  version=$("$1" --version) || fail 'Не удалось запустить Node.'
+  [[ "$version" =~ ^v([0-9]+)\.([0-9]+)\. ]] || fail 'Не удалось узнать версию Node.'
+  if [ "${BASH_REMATCH[1]}" -gt 22 ] || { [ "${BASH_REMATCH[1]}" -eq 22 ] && [ "${BASH_REMATCH[2]}" -ge 5 ]; }; then
+    return 0
+  fi
+  fail 'Нужен Node 22.5 или новее.'
+}
+
+# Настройки стенда. Переезд работает со стандартной раскладкой: база data/plan-fact.sqlite и папка codes внутри стенда.
+move_config() {
+  set -a
+  # shellcheck disable=SC1091
+  . "$STAND/config.env"
+  set +a
+  NODE=${PLAN_FACT_NODE_BIN:-}
+  move_require_node "$NODE"
+  [[ "${PLAN_FACT_PORT:-}" =~ ^[0-9]{1,5}$ ]] || fail 'В config.env неверный номер порта.'
+  [ "${PLAN_FACT_DATABASE:-}" = "$STAND/data/plan-fact.sqlite" ] || fail 'База стенда должна лежать в data/plan-fact.sqlite внутри папки стенда.'
+  CODES=${PLAN_FACT_CODES_DIR:-}
+  [ "$CODES" = "$STAND/codes" ] || fail 'Папка кодов должна быть codes внутри папки стенда (PLAN_FACT_CODES_DIR).'
+  [ ! -L "$CODES" ] || fail 'Папка codes не должна быть символической ссылкой.'
+}
+
+move_node() { NODE_NO_WARNINGS=1 "$NODE" --experimental-sqlite "$MOVE_DIR/move-check.mjs" "$@"; }
+
+# Проверочная установка без автозапуска (так работают автотесты): сервером управляет maintenance-server.mjs.
+move_test_install() { [ -f "$STAND/launchd/.no-launchd" ] || [ -f "$STAND/systemd/.no-systemd" ]; }
+
+move_require_tunnel_off() {
+  if [ -e "$STAND/launchd/.tunnel-enabled" ] || [ -e "$STAND/systemd/.tunnel-enabled" ]; then
+    fail "$1"
+  fi
+}
+
+# Код ответа /api/ready стенда; 000 — сервер не ответил.
+move_ready_code() {
+  local code
+  code=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 3 \
+    "http://127.0.0.1:$PLAN_FACT_PORT/api/ready" 2>/dev/null) || code=000
+  printf '%s\n' "$code"
+}
+
+move_private_directory() {
+  [ ! -L "$1" ] || fail 'Служебные папки стенда не должны быть символическими ссылками.'
+  mkdir -p -- "$1"
+  chmod 700 "$1"
+}
+
+move_sha256() {
+  local line
+  if command -v sha256sum >/dev/null 2>&1; then
+    line=$(sha256sum < "$1")
+  else
+    line=$(shasum -a 256 < "$1")
+  fi
+  printf '%s\n' "${line%% *}"
+}
+
+# Пароль архива. new — придумать и повторить (не короче 12 символов), existing — ввести один раз.
+move_read_password() {
+  local mode=$1 first='' second=''
+  if [ "$mode" = new ]; then
+    printf 'Придумайте пароль архива: не короче 12 символов, лучше латинские буквы и цифры\n' >&2
+    printf '(на другом компьютере раскладка клавиатуры может отличаться). Символы при вводе не отображаются.\n' >&2
+  else
+    printf 'Введите пароль архива — тот, что придумали на старом компьютере. Символы не отображаются.\n' >&2
+  fi
+  printf 'Пароль: ' >&2
+  IFS= read -r -s first || first=''
+  printf '\n' >&2
+  if [ "$mode" = new ]; then
+    if [ "${#first}" -lt 12 ] || [ "${#first}" -gt 1024 ]; then
+      first=''
+      fail 'Пароль должен быть не короче 12 символов. Архив не создан.'
+    fi
+    printf 'Повторите пароль: ' >&2
+    IFS= read -r -s second || second=''
+    printf '\n' >&2
+    if [ "$first" != "$second" ]; then
+      first=''
+      second=''
+      fail 'Пароли не совпали. Архив не создан, запустите команду ещё раз.'
+    fi
+    second=''
+  elif [ -z "$first" ]; then
+    fail 'Пароль не введён. Ничего не изменено.'
+  fi
+  MOVE_PASSWORD=$first
+  first=''
+}
+
+move_openssl() {
+  command -v openssl >/dev/null 2>&1 || fail 'Не найдена команда openssl.'
+  openssl enc "$@" -aes-256-cbc -md sha256 -pbkdf2 -iter 200000 -pass fd:3 3< <(printf '%s\n' "$MOVE_PASSWORD")
+}
+# Шифрует стандартный ввод в файл $1.
+move_encrypt() { move_openssl -e -salt -out "$1"; }
+# Расшифровывает файл $1 в стандартный вывод.
+move_decrypt() { move_openssl -d -in "$1"; }
+
+# Архив в формате ustar без служебных данных macOS (._файлы, xattr, ACL): GNU tar на Linux читает его без предупреждений.
+# Аргументы — как у tar после -f -: -C <папка> <имя> …
+move_tar_create() {
+  local version
+  version=$(tar --version 2>/dev/null) || version=''
+  case "$version" in
+    *bsdtar*) COPYFILE_DISABLE=1 tar --format ustar --no-acls --no-fflags --no-xattrs --no-mac-metadata --exclude .DS_Store -c -z -f - "$@" ;;
+    *) tar --format=ustar --no-acls --no-selinux --no-xattrs --exclude=.DS_Store -c -z -f - "$@" ;;
+  esac
+}
