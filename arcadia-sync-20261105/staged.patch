+"use strict";
+
+// Вход через сайт в режиме access-code (задача 3): настоящий сервер на случайном порту, база во
+// временной папке, пользователи alice и bob — как у тестового стенда.
+
+const assert = require("node:assert/strict");
+const { spawn, spawnSync } = require("node:child_process");
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const http = require("node:http");
+const net = require("node:net");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+const cli = require("../src/cli.js");
+const { accessCodesDirectory, loadConfig } = require("../src/config.js");
+const { PlanFactHttpServer } = require("../src/http-server.js");
+const { AccessCodeIdentityProvider, createIdentityProvider } = require("../src/identity-provider.js");
+const { RealtimeHub } = require("../src/realtime.js");
+const { PlanFactService, normalizeAccessCode } = require("../src/service.js");
+const { createStore } = require("../src/store-factory.js");
+
+const INDEX_PATH = path.join(__dirname, "..", "src", "index.js");
+const CLI_PATH = path.join(__dirname, "..", "src", "cli.js");
+const TUNNEL_ORIGIN = "https://plan-fact.tunnel.example";
+const GENERIC_FAILURE = {
+  error: "Неверный логин или код. После 5 ошибок подряд вход блокируется на 15 минут.",
+  code: "authentication_required"
+};
+const LOGIN_REQUIRED = { code: "login_required", authMode: "access-code" };
+const CLEARED_COOKIE = "plan_fact_session=; Path=/; HttpOnly; SameSite=Strict; Max-Age=0";
+// Заведомо неверный код правильного вида.
+const WRONG_CODE = "ZZZZZ-ZZZZZ-ZZZZZ-ZZZZZ";
+
+// Настройки как у стенда (MVP-PLAN, раздел 3), только база и каталог кодов — во временной папке.
+function standEnv(root, overrides = {}) {
+  return {
+    NODE_ENV: "development",
+    PLAN_FACT_AUTH_MODE: "access-code",
+    PLAN_FACT_STORAGE_DRIVER: "sqlite",
+    PLAN_FACT_DATABASE: path.join(root, "data", "plan-fact.sqlite"),
+    PLAN_FACT_CODES_DIR: path.join(root, "codes"),
+    PLAN_FACT_HOST: "127.0.0.1",
+    PLAN_FACT_ALLOWED_ORIGINS: TUNNEL_ORIGIN,
+    PLAN_FACT_SECURE_COOKIES: "false",
+    ...overrides
+  };
+}
+
+function client(baseUrl) {
+  async function call(method, pathname, { body, origin, cookie, headers = {} } = {}) {
+    const response = await fetch(`${baseUrl}${pathname}`, {
+      method,
+      redirect: "manual",
+      headers: {
+        ...(body === undefined ? {} : { "Content-Type": "application/json" }),
+        ...(origin ? { Origin: origin } : {}),
+        ...(cookie ? { Cookie: cookie } : {}),
+        ...headers
+      },
+      body: body === undefined || typeof body === "string" ? body : JSON.stringify(body)
+    });
+    const text = await response.text();
+    let json = null;
+    try { json = JSON.parse(text); } catch {}
+    return { status: response.status, headers: response.headers, text, json };
+  }
+  return {
+    // GET браузер шлёт без Origin, а POST со страницы стенда — с Origin этого же адреса.
+    get: (pathname, options = {}) => call("GET", pathname, options),
+    post: (pathname, body, options = {}) => call("POST", pathname, { origin: baseUrl, ...options, body }),
+    login: (login, code, options = {}) => call("POST", "/api/login", { origin: baseUrl, ...options, body: { login, code } })
+  };
+}
+
+// heartbeatMs — как часто поток /api/events шлёт сигнал «соединение живо» (на стенде — раз в 25 секунд).
+async function withServer(callback, envOverrides = {}, { heartbeatMs } = {}) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "plan-fact-access-http-"));
+  const config = { ...loadConfig(standEnv(root, envOverrides)), port: 0 };
+  // Режим access-code наружу не ходит: провайдеру входа подсунут fetch, который записывает любой вызов.
+  const externalCalls = [];
+  const identityProvider = createIdentityProvider(config, {
+    fetchFn: async (url) => {
+      externalCalls.push(String(url));
+      throw new Error("внешний вызов не ожидался");
+    }
+  });
+  const realtime = new RealtimeHub({ heartbeatMs });
+  const store = await createStore(config, PlanFactService.initialState);
+  const service = new PlanFactService({ store, config, realtime });
+  const server = new PlanFactHttpServer({ service, config, realtime, identityProvider });
+  try {
+    const { port } = await server.listen();
+    const baseUrl = `http://127.0.0.1:${port}`;
+    const users = {
+      alice: (await service.provisionStaffAccount({ staffLogin: "alice", name: "Алиса", role: "superadmin" })).account,
+      bob: (await service.provisionStaffAccount({ staffLogin: "bob", name: "Боб", role: "admin" })).account
+    };
+    const codes = {
+      alice: (await service.issueAccessCode("alice")).code,
+      bob: (await service.issueAccessCode("bob")).code
+    };
+    await callback({ api: client(baseUrl), baseUrl, codes, identityProvider, root, service, store, users });
+  } finally {
+    await server.close();
+    store.close();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+  assert.deepEqual(externalCalls, [], "режим входа не должен обращаться к внешним сервисам");
+}
+
+// Set-Cookie → пара для заголовка Cookie и атрибуты по порядку. С Secure-cookie имя — __Host-plan_fact_session.
+function sessionCookieOf(response, { name = "plan_fact_session" } = {}) {
+  const header = response.headers.get("set-cookie");
+  assert.ok(header, "ответ должен ставить cookie сессии");
+  const [pair, ...attributes] = header.split(";").map((part) => part.trim());
+  assert.match(pair, new RegExp(`^${name}=[A-Za-z0-9_-]{43}$`));
+  return { cookie: pair, attributes };
+}
+
+// Запрос с любым заголовком Host — так приходит браузер, когда чужое имя сайта вдруг указывает на 127.0.0.1
+// (DNS rebinding). fetch подменить Host не даёт, поэтому — node:http.
+function rawRequest(baseUrl, { method = "GET", pathname = "/api/ready", host, headers = {}, body } = {}) {
+  return new Promise((resolve, reject) => {
+    const request = http.request({
+      host: "127.0.0.1",
+      port: new URL(baseUrl).port,
+      method,
+      path: pathname,
+      setHost: false,
+      headers: { Host: host, ...headers }
+    }, (response) => {
+      let text = "";
+      response.setEncoding("utf8").on("data", (chunk) => { text += chunk; });
+      response.on("end", () => {
+        let json = null;
+        try { json = JSON.parse(text); } catch {}
+        resolve({ status: response.statusCode, headers: response.headers, text, json });
+      });
+    });
+    request.on("error", reject);
+    request.end(body);
+  });
+}
+
+// Поток /api/events: копит пришедший текст; ended — сервер закрыл поток.
+async function openEvents(baseUrl, cookie) {
+  const controller = new AbortController();
+  const response = await fetch(`${baseUrl}/api/events`, { headers: { Cookie: cookie }, signal: controller.signal });
+  assert.equal(response.status, 200);
+  const stream = { text: "", ended: false, close: () => controller.abort() };
+  (async () => {
+    const decoder = new TextDecoder();
+    try {
+      for await (const chunk of response.body) stream.text += decoder.decode(chunk, { stream: true });
+      stream.ended = true;
+    } catch {
+      // Поток закрыл сам тест.
+    }
+  })();
+  return stream;
+}
+
+async function waitUntil(condition, message, timeoutMs = 5_000) {
+  const deadline = Date.now() + timeoutMs;
+  while (!condition()) {
+    if (Date.now() > deadline) assert.fail(message);
+    await new Promise((resolve) => setTimeout(resolve, 20));
+  }
+}
+
+// Проверка одного кода (scrypt) ждёт, пока тест её не отпустит: так она заканчивается позже остальных попыток, как на
+// занятом сервере. Остальные вызовы scrypt — настоящие.
+function holdScryptFor(t, code) {
+  const scrypt = crypto.scrypt;
+  const password = normalizeAccessCode(code);
+  let release;
+  const released = new Promise((resolve) => { release = resolve; });
+  let markStarted;
+  const started = new Promise((resolve) => { markStarted = resolve; });
+  t.mock.method(crypto, "scrypt", (input, ...rest) => {
+    if (input !== password) return scrypt(input, ...rest);
+    markStarted();
+    released.then(() => scrypt(input, ...rest));
+  });
+  return { started, release };
+}
+
+function auditEvents(store, action) {
+  return store.listAudit({ limit: 500 }).filter((event) => event.action === action);
+}
+
+function locationById(state, id) {
+  return state.locations.find((item) => item.id === id);
+}
+
+function renameLocation(api, cookie, { baseRevision, name, mutationId }) {
+  return api.post("/api/mutate", {
+    type: "updateLocation",
+    baseRevision,
+    mutationId,
+    payload: { id: "default", name, code: "" }
+  }, { cookie });
+}
+
+function freePort() {
+  return new Promise((resolve, reject) => {
+    const probe = net.createServer();
+    probe.once("error", reject);
+    probe.listen(0, "127.0.0.1", () => {
+      const { port } = probe.address();
+      probe.close(() => resolve(port));
+    });
+  });
+}
