@@ -0,0 +1,120 @@
+"""Обновления в реальном времени по /api/events (перенос backend/src/realtime.js).
+
+Поток Server-Sent Events держит один рабочий поток сервера. Сессию поток проверяет при каждом
+сигнале «соединение живо»: её закрывают и другие процессы (команда выдачи кода), и отключение
+пользователя. Рассылка — внутри одного процесса сервера, поэтому сервер запускается одним
+процессом с несколькими потоками (команда serve так и делает).
+"""
+
+from __future__ import annotations
+
+import queue
+import threading
+import time
+from typing import Callable, Iterator
+
+from planfact.domain import js
+from planfact.errors import AppError
+
+_CLOSE = "close"
+_EVENT = "event"
+
+
+class Subscriber:
+    def __init__(self, session_id: str, is_active: Callable[[], bool] | None):
+        self.session_id = session_id
+        self.is_active = is_active
+        self.queue: queue.Queue = queue.Queue()
+
+
+def session_ended(reason: str) -> str:
+    return f"event: session-ended\ndata: {js.dumps({'reason': reason})}\n\n"
+
+
+MAX_STREAMS_PER_SESSION = 4
+
+
+class RealtimeHub:
+    def __init__(self, heartbeat_ms: int = 25_000, max_streams: int = 16):
+        self.heartbeat_ms = heartbeat_ms
+        # Поток событий занимает рабочий поток сервера на всё время соединения, поэтому их число
+        # ограничено: иначе один пользователь мог бы занять все потоки и остановить стенд.
+        self.max_streams = max_streams
+        self._lock = threading.Lock()
+        self._clients: dict[str, set[Subscriber]] = {}
+
+    def subscribe(self, session_id: str, is_active: Callable[[], bool] | None = None) -> Subscriber:
+        subscriber = Subscriber(session_id, is_active)
+        with self._lock:
+            clients = self._clients.setdefault(session_id, set())
+            if len(clients) >= MAX_STREAMS_PER_SESSION:
+                raise AppError("Слишком много открытых потоков событий в этой сессии", 429, "too_many_streams")
+            if sum(len(items) for items in self._clients.values()) >= self.max_streams:
+                raise AppError("Сервер занят: потоков событий слишком много, попробуйте позже", 503, "too_many_streams")
+            clients.add(subscriber)
+        return subscriber
+
+    def unsubscribe(self, subscriber: Subscriber) -> None:
+        with self._lock:
+            clients = self._clients.get(subscriber.session_id)
+            if clients is not None:
+                clients.discard(subscriber)
+                if not clients:
+                    self._clients.pop(subscriber.session_id, None)
+
+    def publish(self, event: dict) -> None:
+        body = f"event: {event.get('type') or 'message'}\ndata: {js.dumps(event)}\n\n"
+        with self._lock:
+            subscribers = [subscriber for clients in self._clients.values() for subscriber in clients]
+        for subscriber in subscribers:
+            subscriber.queue.put((_EVENT, body))
+
+    def close_session(self, session_id: str, reason: str = "session_replaced") -> None:
+        with self._lock:
+            clients = self._clients.pop(session_id, set())
+        for subscriber in clients:
+            subscriber.queue.put((_CLOSE, session_ended(reason)))
+
+    def close(self) -> None:
+        with self._lock:
+            subscribers = [subscriber for clients in self._clients.values() for subscriber in clients]
+            self._clients.clear()
+        for subscriber in subscribers:
+            subscriber.queue.put((_CLOSE, ""))
+
+    def connected(self) -> int:
+        with self._lock:
+            return sum(len(clients) for clients in self._clients.values())
+
+    def stream(self, subscriber: Subscriber) -> Iterator[str]:
+        interval = self.heartbeat_ms / 1000
+        try:
+            yield "retry: 3000\n"
+            yield f"event: ready\ndata: {js.dumps({'connected': True})}\n\n"
+            next_beat = time.monotonic() + interval
+            while True:
+                timeout = max(0.0, next_beat - time.monotonic())
+                try:
+                    kind, body = subscriber.queue.get(timeout=timeout)
+                except queue.Empty:
+                    kind, body = None, None
+                if kind == _CLOSE:
+                    if body:
+                        yield body
+                    return
+                if kind == _EVENT:
+                    yield body
+                if time.monotonic() < next_beat:
+                    continue
+                next_beat = time.monotonic() + interval
+                if subscriber.is_active is not None:
+                    try:
+                        active = bool(subscriber.is_active())
+                    except Exception:  # noqa: BLE001 — недоступная проверка закрывает поток
+                        active = False
+                    if not active:
+                        yield session_ended("session_closed")
+                        return
+                yield ": heartbeat\n\n"
+        finally:
+            self.unsubscribe(subscriber)
