+"""Таблицы PostgreSQL.
+
+Бизнес-данные (локации, проекты, бюджеты, расходы, прогнозы, комментарии) — один документ JSON
+с номером ревизии в application_state, как в прежнем сервере: так изменения применяются целиком
+и проверяются по ревизии. Пользователи, права по локациям, сессии, коды доступа, журнал,
+блокировки записей и личные скрытия предупреждений — отдельные таблицы.
+
+Документ хранится в колонке типа json (а не jsonb): jsonb переставляет ключи объектов, а правила
+сравнивают записи до и после изменения как текст JSON. Названия таблиц и колонок — прежние.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from django.db import models
+from django.db.models import Q
+
+from planfact.domain import js
+
+
+class OrderedJSONField(models.Field):
+    """JSON с сохранённым порядком ключей и числами как в JavaScript (колонка json)."""
+
+    description = "JSON с сохранённым порядком ключей"
+
+    def db_type(self, connection) -> str:
+        return "json"
+
+    def from_db_value(self, value: Any, expression, connection) -> Any:
+        if value is None:
+            return None
+        if isinstance(value, (bytes, str)):
+            # Текст записан самим приложением (или прежним сервером): очистка строк не нужна.
+            return js.loads(value, sanitize=False)
+        return value
+
+    def to_python(self, value: Any) -> Any:
+        if isinstance(value, str):
+            return js.loads(value)
+        return value
+
+    def get_prep_value(self, value: Any) -> Any:
+        if value is None:
+            return None
+        return js.dumps(value)
+
+
+ROLE_CHOICES = ("user", "admin", "superadmin")
+
+
+class AppUser(models.Model):
+    id = models.TextField(primary_key=True)
+    name = models.TextField()
+    name_key = models.TextField(unique=True)
+    staff_login = models.TextField(null=True)
+    staff_uid = models.TextField(null=True)
+    role = models.TextField()
+    default_location_access = models.TextField(default="hidden")
+    active = models.BooleanField(default=True)
+    created_at = models.DateTimeField()
+    created_by = models.ForeignKey("self", null=True, on_delete=models.PROTECT, related_name="+", db_column="created_by_id")
+    updated_at = models.DateTimeField(null=True)
+    updated_by = models.ForeignKey("self", null=True, on_delete=models.PROTECT, related_name="+", db_column="updated_by_id")
+
+    class Meta:
+        db_table = "users"
+        constraints = [
+            models.CheckConstraint(condition=Q(role__in=ROLE_CHOICES), name="users_role_check"),
+            models.CheckConstraint(condition=Q(default_location_access__in=("hidden", "view")), name="users_default_access_check"),
+            models.CheckConstraint(condition=Q(active=False) | Q(staff_login__isnull=False), name="active_user_requires_staff_login"),
+            models.UniqueConstraint(fields=["staff_login"], condition=Q(staff_login__isnull=False), name="users_staff_login_unique"),
+            models.UniqueConstraint(fields=["staff_uid"], condition=Q(staff_uid__isnull=False), name="users_staff_uid_unique"),
+        ]
+
+    def __str__(self) -> str:
+        return f"{self.staff_login or self.id} ({self.role})"
+
+
+class UserLocationAccess(models.Model):
+    user = models.ForeignKey(AppUser, on_delete=models.CASCADE, related_name="location_access", db_column="user_id")
+    location_id = models.TextField()
+    access = models.TextField()
+
+    class Meta:
+        db_table = "user_location_access"
+        constraints = [
+            models.UniqueConstraint(fields=["user", "location_id"], name="user_location_access_unique"),
+            models.CheckConstraint(condition=Q(access__in=("hidden", "view", "edit")), name="user_location_access_access_check"),
+        ]
+
+
+class AppSession(models.Model):
+    id = models.TextField(primary_key=True)
+    user = models.OneToOneField(AppUser, on_delete=models.CASCADE, related_name="session", db_column="user_id")
+    token_hash = models.TextField(unique=True)
+    created_at = models.DateTimeField()
+    last_seen_at = models.DateTimeField()
+    expires_at = models.DateTimeField()
+    ip = models.TextField(null=True)
+    user_agent = models.TextField(null=True)
+    auth_mode = models.TextField(default="legacy")
+    auth_role = models.TextField(null=True)
+    auth_expires_at = models.DateTimeField(null=True)
+
+    class Meta:
+        db_table = "sessions"
+        indexes = [models.Index(fields=["expires_at"], name="sessions_expiry_idx")]
+
+
+class AccessCode(models.Model):
+    user = models.OneToOneField(AppUser, primary_key=True, on_delete=models.CASCADE, related_name="access_code", db_column="user_id")
+    code_hash = models.TextField()
+    salt = models.TextField()
+    kdf_params = models.TextField()
+    issued_at = models.DateTimeField()
+    failed_attempts = models.IntegerField(default=0)
+    locked_until = models.DateTimeField(null=True)
+    last_failed_at = models.DateTimeField(null=True)
+
+    class Meta:
+        db_table = "access_codes"
+        constraints = [models.CheckConstraint(condition=Q(failed_attempts__gte=0), name="access_codes_failed_attempts_check")]
+
+
+class AuditEvent(models.Model):
+    """Журнал действий. Записи неизменяемы: UPDATE и DELETE запрещены триггерами в базе."""
+
+    id = models.TextField(primary_key=True)
+    revision = models.IntegerField(null=True)
+    actor = models.ForeignKey(AppUser, null=True, on_delete=models.PROTECT, related_name="+", db_column="actor_id", db_index=False)
+    actor_name = models.TextField()
+    session_id = models.TextField(null=True)
+    action = models.TextField()
+    mutation_id = models.TextField(null=True, unique=True)
+    entity_type = models.TextField(null=True)
+    entity_id = models.TextField(null=True)
+    location_id = models.TextField(null=True)
+    payload_json = OrderedJSONField()
+    before_json = OrderedJSONField(null=True)
+    after_json = OrderedJSONField(null=True)
+    reverses_event = models.ForeignKey("self", null=True, on_delete=models.PROTECT, related_name="+", db_column="reverses_event_id")
+    created_at = models.DateTimeField()
+
+    class Meta:
+        db_table = "audit_events"
+        indexes = [
+            models.Index(fields=["revision"], name="audit_revision_idx"),
+            models.Index(fields=["actor", "created_at"], name="audit_actor_idx"),
+            models.Index(fields=["entity_type", "entity_id", "created_at"], name="audit_entity_idx"),
+            models.Index(fields=["location_id", "created_at"], name="audit_location_idx"),
+            models.Index(fields=["-created_at", "-id"], name="audit_created_idx"),
+        ]
+
+
+class EditLock(models.Model):
+    resource_type = models.TextField()
+    resource_id = models.TextField()
+    owner_user = models.ForeignKey(AppUser, on_delete=models.CASCADE, related_name="+", db_column="owner_user_id")
+    owner_session_id = models.TextField()
+    token_hash = models.TextField()
+    acquired_at = models.DateTimeField()
+    expires_at = models.DateTimeField()
+
+    class Meta:
+        db_table = "edit_locks"
+        constraints = [models.UniqueConstraint(fields=["resource_type", "resource_id"], name="edit_locks_resource_unique")]
+        indexes = [models.Index(fields=["expires_at"], name="edit_locks_expiry_idx")]
+
+
+class PersonalWarningState(models.Model):
+    user = models.ForeignKey(AppUser, on_delete=models.CASCADE, related_name="+", db_column="user_id")
+    warning_id = models.TextField()
+    fingerprint = models.TextField()
+    hidden_at = models.DateTimeField()
+
+    class Meta:
+        db_table = "personal_warning_state"
+        constraints = [models.UniqueConstraint(fields=["user", "warning_id"], name="personal_warning_state_unique")]
+
+
+SYNC_STATUSES = ("queued", "running", "waiting_for_locks", "succeeded", "partially_succeeded", "failed", "cancelled")
+
+
+class SyncJob(models.Model):
+    id = models.TextField(primary_key=True)
+    kind = models.TextField()
+    status = models.TextField()
+    requested_by = models.ForeignKey(AppUser, null=True, on_delete=models.PROTECT, related_name="+", db_column="requested_by_id")
+    session_id = models.TextField(null=True)
+    scope_json = OrderedJSONField()
+    result_json = OrderedJSONField(null=True)
+    error_text = models.TextField(null=True)
+    created_at = models.DateTimeField()
+    started_at = models.DateTimeField(null=True)
+    finished_at = models.DateTimeField(null=True)
+    cancel_if_session_ends = models.BooleanField(default=False)
+
+    class Meta:
+        db_table = "sync_jobs"
+        constraints = [models.CheckConstraint(condition=Q(status__in=SYNC_STATUSES), name="sync_jobs_status_check")]
+        indexes = [models.Index(fields=["kind", "status", "created_at"], name="sync_jobs_status_idx")]
+
+
+class ApplicationState(models.Model):
+    """Документ бизнес-данных с ревизией: одна строка (singleton = 1)."""
+
+    singleton = models.SmallIntegerField(primary_key=True, default=1)
+    revision = models.IntegerField()
+    schema_version = models.IntegerField()
+    body_json = OrderedJSONField()
+    updated_at = models.DateTimeField()
+
+    class Meta:
+        db_table = "application_state"
+        constraints = [models.CheckConstraint(condition=Q(singleton=1), name="application_state_singleton_check")]
