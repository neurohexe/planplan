+test("AccessCodeMode_ServerProcessStartsAndAnnouncesTheMode", async () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "plan-fact-access-start-"));
+  const port = await freePort();
+  const child = spawn(process.execPath, ["--experimental-sqlite", INDEX_PATH], {
+    env: { PATH: process.env.PATH, HOME: root, ...standEnv(root, { PLAN_FACT_PORT: String(port) }) },
+    stdio: ["ignore", "pipe", "pipe"]
+  });
+  let stdout = "";
+  let stderr = "";
+  child.stdout.setEncoding("utf8").on("data", (chunk) => { stdout += chunk; });
+  child.stderr.setEncoding("utf8").on("data", (chunk) => { stderr += chunk; });
+  const exited = new Promise((resolve) => child.once("exit", (code, signal) => resolve({ code, signal })));
+  try {
+    const deadline = Date.now() + 20_000;
+    while (!stdout.includes("auth_mode access-code")) {
+      if (child.exitCode !== null || Date.now() > deadline) assert.fail(`сервер не запустился: ${stderr}`);
+      await new Promise((resolve) => setTimeout(resolve, 50));
+    }
+    assert.match(stdout, new RegExp(`^Plan Fact backend: http://127\\.0\\.0\\.1:${port}$`, "m"));
+    assert.match(stdout, /^auth_mode access-code secure_cookies=off$/m);
+    assert.doesNotMatch(stdout + stderr, /webauth_self_check/, "WebAuth при запуске не проверяется");
+
+    const response = await fetch(`http://127.0.0.1:${port}/api/auth`);
+    assert.equal(response.status, 401);
+    assert.deepEqual(await response.json(), LOGIN_REQUIRED);
+  } finally {
+    child.kill("SIGTERM");
+    const timer = setTimeout(() => child.kill("SIGKILL"), 10_000);
+    const { code } = await exited;
+    clearTimeout(timer);
+    fs.rmSync(root, { recursive: true, force: true });
+    assert.equal(code, 0, "сервер штатно останавливается по SIGTERM");
+  }
+});
