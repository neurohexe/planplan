+def _restore_forecast_ticket(nxt: dict, payload: dict, now: str) -> None:
+    ticket = _find(nxt["forecastTickets"], lambda item: strict_eq(og(item, "id"), _p(payload, "ticketId")))
+    if ticket is None:
+        raise DomainError("Прогнозный тикет не найден")
+    released = [
+        allocation for allocation in ticket["allocations"]
+        if og(allocation, "lifecycle") == "released" and og(allocation, "lifecycleSource") == "manual"
+    ]
+    if not released:
+        raise DomainError("В тикете нет освобождённого резерва")
+    imported = og(ticket, "sourceType") == expense_import.SOURCE_TYPE
+    for allocation in released:
+        period_locks.assert_month_editable(nxt, _month_key(og(allocation, "expectedDate")))
+        allocation["lifecycle"] = (
+            expense_import.forecast_status_lifecycle(og(allocation, "sourceStatus"), og(allocation, "amount")) if imported else "active"
+        )
+        allocation["lifecycleSource"] = "source" if imported else "manual"
+        allocation["releaseReason"] = ""
+    ticket["lifecycle"] = expense_import.ticket_lifecycle(ticket["allocations"])
+    ticket["updatedAt"] = now
+    ticket["updatedBy"] = _author(payload)
+    _push_history(ticket, {"changedAt": now, "changedBy": ticket["updatedBy"], "action": "forecast-restore"})
