@@ -0,0 +1,44 @@
+#!/bin/bash
+# Общие функции резервного копирования и проверки готовности.
+set -euo pipefail
+umask 077
+MAINTENANCE_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=common.sh
+. "$MAINTENANCE_DIR/common.sh"
+DATA_LOCK_OWNED=false
+
+private_directory() {
+  local directory=$1
+  [ ! -L "$directory" ] || fail 'Служебные каталоги не должны быть символическими ссылками.'
+  mkdir -p -- "$directory"
+  chmod 700 "$directory"
+}
+
+ordinary_or_missing() {
+  [ ! -L "$1" ] && { [ ! -e "$1" ] || [ -f "$1" ]; } || fail 'Служебный файл должен быть обычным файлом.'
+}
+
+maintenance_log() {
+  local name=$1 message=$2
+  private_directory "$STAND/logs"
+  ordinary_or_missing "$STAND/logs/$name"
+  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$message" >> "$STAND/logs/$name"
+  chmod 600 "$STAND/logs/$name"
+}
+
+acquire_data_lock() {
+  private_directory "$STAND/backups"
+  if ! mkdir "$STAND/backups/.maintenance-lock" 2>/dev/null; then
+    fail 'Резервное копирование или восстановление уже выполняется. Если процесс аварийно завершился, проверьте backups/.maintenance-lock.'
+  fi
+  DATA_LOCK_OWNED=true
+  printf '%s\n' "$$" > "$STAND/backups/.maintenance-lock/owner.pid"
+}
+
+release_data_lock() {
+  if [ "$DATA_LOCK_OWNED" = true ]; then
+    rm -f -- "$STAND/backups/.maintenance-lock/owner.pid"
+    rmdir -- "$STAND/backups/.maintenance-lock"
+    DATA_LOCK_OWNED=false
+  fi
+}
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/laptop/maintenance-server.mjs b/junk/padolskiye/plan_fact_minipc/deploy/laptop/maintenance-server.mjs
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/maintenance-server.mjs
@@ -0,0 +1,111 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import net from 'node:net';
+import { execFileSync, spawn } from 'node:child_process';
+import { setTimeout as delay } from 'node:timers/promises';
+
+const [command, root] = process.argv.slice(2);
+const port = Number(process.env.PLAN_FACT_PORT);
+const pidFile = path.join(root, 'data', 'app.pid');
+const expectedCommand = `${process.env.PLAN_FACT_NODE_BIN} --experimental-sqlite ${path.join(root, 'app/backend/src/index.js')}`;
+
+function fileInfo(file) {
+  try { return fs.lstatSync(file); }
+  catch (error) { if (error.code === 'ENOENT') return null; throw error; }
+}
+
+function testMode() {
+  if (!fileInfo(path.join(root, 'launchd/.no-launchd'))?.isFile()) throw new Error('Управление тестовым процессом разрешено только без launchd.');
+  for (const file of [root, path.join(root, 'data'), pidFile]) {
+    if (fileInfo(file)?.isSymbolicLink()) throw new Error('Папка данных и pid-файл не должны быть ссылками.');
+  }
+  if (fileInfo(pidFile) && !fileInfo(pidFile).isFile()) throw new Error('Pid-файл должен быть обычным файлом.');
+}
+
+function pid() {
+  if (!fileInfo(pidFile)) return null;
+  const text = fs.readFileSync(pidFile, 'utf8').trim();
+  if (!/^[1-9]\d{0,9}$/.test(text) || Number(text) <= 1) throw new Error('Неверный номер тестового процесса в data/app.pid.');
+  return Number(text);
+}
+
+function processInfo(number) {
+  try {
+    const text = execFileSync('/bin/ps', ['-p', String(number), '-o', 'stat=', '-o', 'command='], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
+    const match = text.match(/^(\S+)\s+(.*)$/);
+    if (!match || match[1].startsWith('Z')) return null;
+    return match[2];
+  } catch { return null; }
+}
+
+async function listening() {
+  return new Promise((resolve) => {
+    const connection = net.createConnection({ host: '127.0.0.1', port });
+    let finished = false;
+    const finish = (value) => { if (!finished) { finished = true; connection.destroy(); resolve(value); } };
+    connection.once('connect', () => finish(true));
+    connection.once('error', () => finish(false));
+    connection.setTimeout(500, () => finish(true));
+  });
+}
+
+async function waitUntil(predicate, message) {
+  const deadline = Date.now() + 30000;
+  while (Date.now() < deadline) {
+    if (await predicate(deadline)) return;
+    await delay(Math.min(200, Math.max(0, deadline - Date.now())));
+  }
+  throw new Error(message);
+}
+
+async function stopTest() {
+  testMode();
+  const number = pid();
+  if (number) {
+    const current = processInfo(number);
+    if (current && current !== expectedCommand) throw new Error('Pid-файл указывает на другой процесс. Он не будет остановлен.');
+    if (current) {
+      process.kill(number, 'SIGTERM');
+      await waitUntil(() => !processInfo(number), 'Тестовый сервер не остановился за 30 секунд.');
+    }
+  }
+  if (await listening()) throw new Error('На порту остался сервер без подтверждённого pid-файла. Восстановление остановлено.');
+  fs.rmSync(pidFile, { force: true });
+}
+
+async function startTest() {
+  testMode();
+  const number = pid();
+  if ((number && processInfo(number)) || await listening()) throw new Error('Тестовый сервер или его порт уже занят.');
+  fs.rmSync(pidFile, { force: true });
+  const child = spawn('/bin/bash', [path.join(root, 'bin/run-app.sh')], {
+    detached: true, stdio: 'ignore', env: { ...process.env, PLANFACT_HOME: root }
+  });
+  await new Promise((resolve, reject) => { child.once('spawn', resolve); child.once('error', reject); });
+  try { fs.writeFileSync(pidFile, `${child.pid}\n`, { flag: 'wx', mode: 0o600 }); }
+  catch (error) { child.kill('SIGTERM'); throw error; }
+  child.unref();
+}
+
+try {
+  switch (command) {
+    case 'stop-test': await stopTest(); break;
+    case 'start-test': await startTest(); break;
+    case 'wait-stopped': await waitUntil(async () => !await listening(), 'Сервер не освободил порт за 30 секунд.'); break;
+    case 'wait-ready':
+      await waitUntil(async (deadline) => {
+        try {
+          const response = await fetch(`http://127.0.0.1:${port}/api/ready`, {
+            signal: AbortSignal.timeout(Math.max(1, Math.min(1000, deadline - Date.now()))), redirect: 'manual'
+          });
+          await response.body?.cancel();
+          return response.status === 200;
+        } catch { return false; }
+      }, 'Сервер не стал готов за 30 секунд. Прежняя база сохранена в backups/before-restore-…; проверьте logs/app.stderr.log.');
+      break;
+    default: throw new Error('Неизвестная команда управления тестовым сервером.');
+  }
+} catch (error) {
+  console.error(`Ошибка: ${error.code || error.message}`);
+  process.exitCode = 1;
+}
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/laptop/render-template.mjs b/junk/padolskiye/plan_fact_minipc/deploy/laptop/render-template.mjs
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/render-template.mjs
@@ -0,0 +1,19 @@
+// Только стандартные средства Node. Bash-значения и XML экранируются отдельно.
+import { readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+const [kind, source, target, stand, node] = process.argv.slice(2);
+const shellQuote = (value) => `'${value.replaceAll("'", "'\\''")}'`;
+const xmlQuote = (value) => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;')
+  .replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&apos;');
+const values = {
+  STAND: stand, NODE: node, BIN: join(stand, 'bin'), LOGS: join(stand, 'logs'),
+  DATABASE: join(stand, 'data', 'plan-fact.sqlite'),
+  STATIC: join(stand, 'app', 'app'), CODES: join(stand, 'codes')
+};
+if (!['config', 'plist'].includes(kind)) throw new Error('Неизвестный вид шаблона.');
+const content = readFileSync(source, 'utf8').replace(/\{\{([A-Z_]+)\}\}/g, (_, key) => {
+  if (!(key in values)) throw new Error(`Неизвестная подстановка ${key}.`);
+  return (kind === 'config' ? shellQuote : xmlQuote)(values[key]);
+});
+writeFileSync(target, content, { mode: 0o600, flag: 'wx' });
