+"""Семантика JavaScript для точного переноса правил из app/*.js.
+
+Правила изменения данных раньше выполнялись в JavaScript (app.js и модули рядом). Перенос на Python
+обязан давать тот же результат, поэтому здесь собраны помощники, которые ведут себя как JavaScript:
+истинность значений, Number(), String(), JSON.stringify, длина и срезы строк по UTF-16, пробелы
+из \\s, Math.round и т. д. Обычные операторы Python в этих местах ведут себя иначе (например,
+пустой список в Python ложен, а в JavaScript истинен), поэтому переносимый код пользуется только
+этими функциями.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import re
+from typing import Any, Iterable
+
+
+class _Undefined:
+    """Значение undefined: отсутствующее поле объекта (в отличие от null = None)."""
+
+    __slots__ = ()
+    _instance = None
+
+    def __new__(cls):
+        if cls._instance is None:
+            cls._instance = super().__new__(cls)
+        return cls._instance
+
+    def __bool__(self) -> bool:
+        return False
+
+    def __repr__(self) -> str:
+        return "undefined"
+
+    def __reduce__(self):
+        return (_Undefined, ())
+
+
+UNDEF = _Undefined()
+NAN = float("nan")
+INF = float("inf")
+
+# Пробелы и переводы строк из \s и String.prototype.trim() в JavaScript. В Python \s шире
+# (например, \x1c-\x1f и \x85) и не включает ﻿, поэтому набор задан явно.
+JS_WS_CHARS = (
+    "\t\n\v\f\r \u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a"
+    "\u2028\u2029\u202f\u205f\u3000\ufeff"
+)
+JS_WS = "[" + re.escape(JS_WS_CHARS) + "]"
+_WS_RUN_RE = re.compile(JS_WS + "+")
+_WS_SET = frozenset(JS_WS_CHARS)
+
+
+# ---------------------------------------------------------------------------
+# Типы и истинность
+
+
+def is_nullish(value: Any) -> bool:
+    return value is None or value is UNDEF
+
+
+def is_number(value: Any) -> bool:
+    """typeof value === "number" (bool в Python — тоже int, его исключаем)."""
+    return type(value) in (int, float)
+
+
+def is_str(value: Any) -> bool:
+    return isinstance(value, str)
+
+
+def is_dict(value: Any) -> bool:
+    return isinstance(value, dict)
+
+
+def is_list(value: Any) -> bool:
+    return isinstance(value, list)
+
+
+def is_obj(value: Any) -> bool:
+    """value && typeof value === "object": объект или массив, но не null."""
+    return isinstance(value, (dict, list))
+
+
+def is_plain_obj(value: Any) -> bool:
+    """value && typeof value === "object" && !Array.isArray(value)."""
+    return isinstance(value, dict)
+
+
+def truthy(value: Any) -> bool:
+    if value is None or value is UNDEF or value is False:
+        return False
+    if value is True:
+        return True
+    if type(value) in (int, float):
+        return not (value == 0 or value != value)
+    if isinstance(value, str):
+        return len(value) > 0
+    return True
+
+
+def falsy(value: Any) -> bool:
+    return not truthy(value)
+
+
+def or_(value: Any, fallback: Any) -> Any:
+    """value || fallback (fallback вычисляется заранее; для дорогих значений — or_lazy)."""
+    return value if truthy(value) else fallback
+
+
+def nullish(value: Any, fallback: Any) -> Any:
+    """value ?? fallback."""
+    return fallback if value is None or value is UNDEF else value
+
+
+def is_finite(value: Any) -> bool:
+    """Number.isFinite(value): без приведения типов."""
+    return type(value) in (int, float) and math.isfinite(value)
+
+
+def is_integer(value: Any) -> bool:
+    """Number.isInteger(value)."""
+    if type(value) is int:
+        return True
+    return type(value) is float and math.isfinite(value) and value.is_integer()
+
+
+def is_nan(value: Any) -> bool:
