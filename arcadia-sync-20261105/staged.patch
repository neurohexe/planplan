@@ -0,0 +1,68 @@
+// Таблица порядка символов для localeCompare(…, "ru") из ICU, встроенного в Node.
+// Запуск: node tools/gen-collation-ru.js > planfact/domain/data/collation_ru.json
+"use strict";
+
+const ranges = [
+  [0x20, 0x7e], [0xa0, 0x24f], [0x2b0, 0x2ff], [0x300, 0x36f], [0x370, 0x3ff], [0x400, 0x52f],
+  [0x1e00, 0x1eff], [0x2000, 0x206f], [0x20a0, 0x20c0], [0x2100, 0x214f], [0x2190, 0x21ff],
+  [0x2200, 0x22ff], [0x2460, 0x24ff], [0x2500, 0x257f], [0x3000, 0x3003], [0xfb00, 0xfb06], [0xfeff, 0xfeff],
+  [0x09, 0x0d], [0x85, 0x85]
+];
+const chars = [];
+for (const [from, to] of ranges) {
+  for (let code = from; code <= to; code += 1) {
+    const ch = String.fromCodePoint(code);
+    if (ch.normalize("NFC") !== ch) continue;
+    chars.push(ch);
+  }
+}
+const full = new Intl.Collator("ru").compare;
+const base = new Intl.Collator("ru", { sensitivity: "base" }).compare;
+const accent = new Intl.Collator("ru", { sensitivity: "accent" }).compare;
+
+const ignorable = [];
+const ordered = [];
+for (const ch of chars) {
+  if (full(ch, "") === 0) ignorable.push(ch);
+  else ordered.push(ch);
+}
+const primaryIgnorable = ordered.filter((ch) => base(ch, "") === 0);
+const weighted = ordered.filter((ch) => base(ch, "") !== 0);
+weighted.sort((a, b) => full(a, b) || (a < b ? -1 : a > b ? 1 : 0));
+const table = {};
+let p = 0;
+let s = 0;
+let t = 0;
+let previous = null;
+for (const ch of weighted) {
+  if (previous !== null) {
+    if (base(previous, ch) !== 0) { p += 1; s = 0; t = 0; }
+    else if (accent(previous, ch) !== 0) { s += 1; t = 0; }
+    else if (full(previous, ch) !== 0) { t += 1; }
+  }
+  table[ch] = [p + 1, s, t];
+  previous = ch;
+}
+// Символы, равные паре латинских или кириллических букв на первичном уровне (ß = ss, æ = ae и т. п.).
+const letters = "abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя".split("");
+const expansions = {};
+for (const ch of weighted) {
+  for (const a of letters) {
+    for (const b of letters) {
+      const pair = a + b;
+      if (base(ch, pair) === 0) {
+        const sign = Math.sign(full(ch, pair));
+        expansions[ch] = [pair, sign];
+      }
+    }
+  }
+}
+process.stdout.write(JSON.stringify({
+  generatedBy: "tools/gen-collation-ru.js",
+  icu: process.versions.icu,
+  unicode: process.versions.unicode,
+  table,
+  ignorable,
+  primaryIgnorable,
+  expansions
+}));
