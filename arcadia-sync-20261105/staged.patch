+test("CorporateTvmConfig_WritesOnlyEnvReferencesWithPrivatePermissionsAndExactDaemonFlags", async (t) => {
+  const root = await directory(t);
+  const { writeCorporateTvmtoolConfig } = await helper;
+  const result = await writeCorporateTvmtoolConfig({ ...defaults, configDir: path.join(root, "fixture") });
+  assert.deepEqual(JSON.parse(await fs.readFile(result.configFile, "utf8")), {
+    backends: { tirole_url: "http://127.0.0.1:18769" },
+    clients: { fixture: { self_tvm_id: 1001, secret: "env:PLAN_FACT_TVM_SECRET", roles_for_idm_slug: "fixture-app", dsts: {} } },
+    port: 18768
+  });
+  assert.equal((await fs.stat(result.configFile)).mode & 0o777, 0o600);
+  assert.equal((await fs.stat(path.dirname(result.configFile))).mode & 0o777, 0o700);
+  assert.equal((await fs.stat(result.cacheDir)).mode & 0o777, 0o700);
+  assert.deepEqual(result.requiredEnvironment, ["PLAN_FACT_TVM_SECRET", "TVMTOOL_LOCAL_AUTHTOKEN"]);
+  assert.deepEqual(result.daemonArguments, ["--config", result.configFile, "--cache-dir", result.cacheDir, "--dangerous-interface", "127.0.0.1"]);
+});
+
+test("CorporateTvmConfig_RefusesOverwriteSymlinksAndNonPrivateDirectory", async (t) => {
+  const root = await directory(t);
+  const { writeCorporateTvmtoolConfig } = await helper;
+  const options = { ...defaults, configDir: path.join(root, "fixture") };
+  const result = await writeCorporateTvmtoolConfig(options);
+  const original = await fs.readFile(result.configFile, "utf8");
+  await assert.rejects(writeCorporateTvmtoolConfig(options), /перезапись запрещена/);
+  assert.equal(await fs.readFile(result.configFile, "utf8"), original);
+  const linked = path.join(root, "linked");
+  await fs.symlink(path.dirname(result.configFile), linked);
+  await assert.rejects(writeCorporateTvmtoolConfig({ ...defaults, configDir: linked }), /ссыл/);
+  const shared = path.join(root, "shared");
+  await fs.mkdir(shared, { mode: 0o755 });
+  await fs.chmod(shared, 0o755);
+  await assert.rejects(writeCorporateTvmtoolConfig({ ...defaults, configDir: shared }), /0700/);
+  const linkedFile = path.join(root, "linked-file");
+  await fs.mkdir(linkedFile, { mode: 0o700 });
+  await fs.symlink(result.configFile, path.join(linkedFile, "tvmtool.json"));
+  await assert.rejects(writeCorporateTvmtoolConfig({ ...defaults, configDir: linkedFile }), /уже существует/);
+});
