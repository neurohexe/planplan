+"""Общие помощники из app/app.js, которыми пользуются правила данных."""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+from ada_url import URL
+
+from . import budget_import, context, dates
+from .js import (
+    S, UNDEF, add, entries, is_dict, is_finite, is_list, is_number, is_str, js_floor, js_slice, js_trim, keys, og,
+    or_, sort_strings, to_number, truthy, values,
+)
+
+CURRENCY_CODES = (
+    "AED", "AMD", "AOA", "AZN", "BDT", "BOB", "BRL", "CDF", "CHF", "CLP", "CNY", "COP",
+    "ETB", "EUR", "GEL", "GHS", "ILS", "KGS", "KZT", "MAD", "MZN", "NAD", "NPR", "OMR",
+    "PEN", "PKR", "QAR", "RUB", "TRY", "USD", "UZS", "XAF", "XOF", "ZAR", "ZMW",
+)
+DEFAULT_CURRENCY = "RUB"
+ALL_LOCATIONS = "__all__"
+
+_QUARTER_RE = re.compile(r"([0-9]{4})-Q([1-4])\Z")
+_MONTH_PREFIX_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+_CATALOG_CODE_RE = re.compile(r"[A-Z]{3}\Z")
+
+
+def clean_text(value: Any, max_length: int) -> str:
+    """cleanText() из app.js: trim и обрезка (без схлопывания пробелов, в отличие от импорта бюджета)."""
+    return js_slice(js_trim(value), 0, max_length) if is_str(value) else ""
+
+
+def normalize_code(value: Any) -> str:
+    return clean_text(value, 80).upper()
+
+
+normalize_currency_code = budget_import.normalize_currency_code
+normalize_budget_type = budget_import.normalize_budget_type
+
+
+def positive_number(value: Any) -> Any:
+    number = to_number(value)
+    return number if is_finite(number) and number > 0 else 0
+
+
+def safe_http_url(value: Any) -> str:
+    """new URL(String(value || "")).href для http/https, иначе пустая строка (разбор по стандарту WHATWG,
+    тем же движком ada, что и в Node)."""
+    try:
+        url = URL(S(or_(value, "")))
+    except ValueError:
+        return ""
+    return url.href if url.protocol in ("http:", "https:") else ""
+
+
+def ticket_label(value: Any) -> Any:
+    try:
+        url = URL(S(value))
+    except ValueError:
+        return value if truthy(value) else "Тикет"
+    parts = [part for part in url.pathname.split("/") if part]
+    last_part = parts[-1] if parts else ""
+    return last_part or url.hostname
+
+
+def valid_iso_datetime(value: Any) -> bool:
+    return dates.valid_iso_datetime(value)
+
+
+def valid_date_input(value: Any) -> bool:
+    return dates.valid_date_input(value)
+
+
+def quarter_key(year: Any, quarter: Any) -> str:
+    return f"{S(year)}-Q{S(quarter)}"
+
+
+def period_from_date_input(value: Any) -> tuple[Any, Any]:
+    if not is_str(value):
+        raise TypeError("value.split is not a function")
+    parts = [to_number(part) for part in value.split("-")]
+    year = parts[0]
+    month = parts[1] if len(parts) > 1 else to_number(UNDEF)
+    return year, add(js_floor((month - 1) / 3), 1)
+
+
+def quarter_key_from_date_input(value: Any) -> str:
+    year, quarter = period_from_date_input(value)
+    return quarter_key(year, quarter)
+
+
+def month_key_from_date_input(value: Any) -> str:
+    match = _MONTH_PREFIX_RE.match(S(or_(value, "")))
+    return f"{match.group(1)}-{match.group(2)}" if match else ""
+
+
+def quarter_month_keys(value: Any) -> list[str]:
+    """quarterMonthKeysFromQuarterKey()."""
+    match = _QUARTER_RE.match(S(or_(value, "")))
+    if not match:
+        return []
+    year = to_number(match.group(1))
+    first_month = (to_number(match.group(2)) - 1) * 3 + 1
+    return [f"{S(year)}-{S(first_month + offset).rjust(2, '0')}" for offset in (0, 1, 2)]
+
+
+def _quarter_of(ms: float) -> str:
+    year, month, _day = dates.local_parts(ms)
+    return quarter_key(year, (month - 1) // 3 + 1)
+
+
