--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/django/switch-to-django.sh
@@ -0,0 +1,94 @@
+#!/bin/bash
+# Переключение стенда с прежнего сервера (Node и SQLite) на версию на Django (задача 41).
+# Перерыв для людей — около минуты: остановка прежнего сервера, финальная копия базы SQLite, перенос данных
+# в PostgreSQL со сверкой SHA-256, запуск сервера на Django на том же порту. Адрес стенда и личные коды
+# прежние, войти нужно заново. База SQLite не меняется. Если новый сервер не ответил готовностью,
+# скрипт сам возвращает прежний. Откат позже — rollback-to-node.sh.
+# Сначала — install-django.sh. Использование: bash switch-to-django.sh
+# shellcheck source=common-django.sh
+. "$(dirname -- "${BASH_SOURCE[0]}")/common-django.sh"
+[ "$#" -le 1 ] || fail 'Использование: switch-to-django.sh [--keep-postgres|--replace-postgres]'
+mode=${1:-}
+case "$mode" in '' | --keep-postgres | --replace-postgres) ;; *) fail 'Неизвестный режим переключения.' ;; esac
+[ ! -e "$ACTIVE_MARK" ] || fail 'Стенд уже работает на Django.'
+[ -x "$DJANGO_VENV/bin/python" ] && [ -f "$DJANGO_HOME/VERSION" ] || fail 'Версия на Django не установлена: сначала install-django.sh.'
+load_django_config
+[ -n "$SQLITE_DATABASE" ] && [ -f "$SQLITE_DATABASE" ] || fail 'Не найдена база SQLite прежнего сервера.'
+grep -q 'run-app.sh' "$UNIT_DIR/$APP_UNIT" || fail "Служба $APP_UNIT — не прежний сервер. Переключение остановлено."
+user_systemctl is-active --quiet "$PG_UNIT" || fail "Не работает служба PostgreSQL $PG_UNIT."
+pg_client_env
+maintenance_lock
+pg_tool pg_isready --quiet || fail 'PostgreSQL не отвечает.'
+
+stamp=$(date +%Y%m%d-%H%M%S)
+copy_dir="$STAND/backups/before-django-$stamp"
+private_dir "$NODE_UNITS_SAVED" "$copy_dir"
+pg_safety_dump "$copy_dir/postgres-before.dump"
+case "$mode" in
+  --keep-postgres) say 'Сохраняю PostgreSQL. Изменения, сделанные только в Node после отката, переноситься не будут.' ;;
+  --replace-postgres) say 'PostgreSQL будет заменена SQLite; её прежние данные сохранены в postgres-before.dump.' ;;
+esac
+cp -- "$UNIT_DIR/$APP_UNIT" "$UNIT_DIR/$BACKUP_UNIT" "$NODE_UNITS_SAVED/"
+
+restore_node() {
+  say 'Возвращаю прежний сервер.'
+  user_systemctl stop "$APP_UNIT" 2> /dev/null || true
+  cp -- "$NODE_UNITS_SAVED/$APP_UNIT" "$UNIT_DIR/$APP_UNIT"
+  cp -- "$NODE_UNITS_SAVED/$BACKUP_UNIT" "$UNIT_DIR/$BACKUP_UNIT"
+  rm -f -- "$ACTIVE_MARK"
+  user_systemctl daemon-reload
+  user_systemctl start "$APP_UNIT"
+  if wait_ready "$PLAN_FACT_PORT" 60; then
+    say 'Прежний сервер снова работает, данные в нём прежние.'
+  else
+    say 'ВНИМАНИЕ: прежний сервер не ответил готовностью, смотрите logs/app.stderr.log.'
+  fi
+}
+PHASE=prepare
+finish() {
+  local status=$?
+  if [ "$status" -ne 0 ] && [ "$PHASE" = switching ]; then
+    printf 'Переключение не удалось (код %s).\n' "$status" >&2
+    restore_node
+  fi
+  exit "$status"
+}
+trap finish EXIT
+
+say "1/5. Останавливаю прежний сервер ($(date '+%H:%M:%S'))."
+PHASE=switching
+user_systemctl stop "$APP_UNIT"
+
+say "2/5. Копия базы SQLite: $copy_dir/plan-fact.sqlite"
+sqlite_snapshot "$SQLITE_DATABASE" "$copy_dir/plan-fact.sqlite"
+
+say '3/5. Переношу данные в PostgreSQL.'
+if [ "$mode" != --keep-postgres ]; then
+  extra=()
+  [ "$mode" != --replace-postgres ] || extra+=(--discard-newer-postgres)
+  bash "$DJANGO_BIN/django-manage.sh" import_sqlite --replace "${extra[@]}" "$copy_dir/plan-fact.sqlite" | tee "$copy_dir/import.log"
+  grep -q 'совпадает' "$copy_dir/import.log" || fail 'Перенос не подтвердил совпадение данных.'
+fi
+
+say '4/5. Запускаю сервер на Django на прежнем порту.'
+render_unit "$DJANGO_HOME/systemd/app.service.template" "$UNIT_DIR/$APP_UNIT"
+render_unit "$DJANGO_HOME/systemd/backup.service.template" "$UNIT_DIR/$BACKUP_UNIT"
+printf 'switched_at=%s\ncommit=%s\nsqlite_copy=%s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')" \
+  "$(version_value commit)" "$copy_dir/plan-fact.sqlite" > "$ACTIVE_MARK"
+user_systemctl daemon-reload
+user_systemctl enable "$APP_UNIT" > /dev/null 2>&1
+user_systemctl start "$APP_UNIT"
+wait_ready "$PLAN_FACT_PORT" 90 || fail 'Сервер на Django не ответил готовностью.'
+PHASE=done
+say "   Стенд работает на Django ($(date '+%H:%M:%S')): http://127.0.0.1:$PLAN_FACT_PORT/"
+
+say '5/5. Первая резервная копия PostgreSQL.'
+flock -u 9
+shopt -s nullglob
+latest=()
+if user_systemctl start "$BACKUP_UNIT" && latest=("$PG_BACKUPS"/hourly/plan-fact-*.dump) && [ "${#latest[@]}" -gt 0 ]; then
+  say "   Готово: ${latest[${#latest[@]} - 1]}"
+else
+  say 'ВНИМАНИЕ: резервная копия не создалась, смотрите logs/backup.log. Стенд при этом работает.'
+fi
+say "Откат на прежний сервер: bash $DJANGO_BIN/rollback-to-node.sh --yes"
