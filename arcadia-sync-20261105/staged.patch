+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const { createRequire } = require("node:module");
+const test = require("node:test");
+const vm = require("node:vm");
+const { createInitialState, normalizeState } = require("../app.js");
+
+const APP_PATH = path.resolve(__dirname, "../app.js");
+const SOURCE = fs.readFileSync(APP_PATH, "utf8");
+const UI_KEY = "plan-fact-budget-ui-v1";
+
+function fixture() {
+  return normalizeState({
+    ...createInitialState(),
+    locations: ["office-a", "office-b"].map((id) => ({ id, name: id, archived: false })),
+    articles: [{ id: "furniture", name: "Тестовая мебель", archived: false, subarticles: [{ id: "chairs", name: "Тестовые стулья" }] }],
+    budgets: {
+      "office-b|2026-Q3": { "furniture|chairs": { RUB: 300 } },
+      "office-b|2026-Q4": { "furniture|chairs": { RUB: 400 } },
+      "office-b|2027-Q1": { "furniture|chairs": { RUB: 500 } }
+    }
+  });
+}
+
+// Настоящие смена периода, renderAll и загрузка выбора после новой загрузки
+// приложения. Заменена только отрисовка отдельных блоков страницы.
+function openPage(storage, inputState) {
+  const context = vm.createContext({
+    require: createRequire(APP_PATH), inputState, console,
+    localStorage: {
+      getItem: (key) => storage.get(key) ?? null,
+      setItem: (key, value) => storage.set(key, String(value))
+    },
+    fetch() { throw new Error("Смена периода не должна записывать данные на сервер"); }
+  });
+  vm.runInContext(SOURCE.replace(/\}\)\(\);\s*$/, `
+    state = inputState;
+    sharedMode = true;
+    currentUser = { id: "alice", role: "superadmin" };
+    selectedLocation = loadSelectedLocation();
+    Object.assign(dom, {
+      yearSelect: { value: String(selectedYear) },
+      quarterSelect: { value: String(selectedQuarter) }
+    });
+    populateArticleControls = renderLocations = renderUser = renderOverview =
+      renderExpenses = renderForecasts = renderBudgetEditor = renderDataPage =
+      renderAccessControls = translatePage = () => {};
+    globalThis.page = {
+      changePeriod(year, quarter) {
+        dom.yearSelect.value = String(year);
+        dom.quarterSelect.value = String(quarter);
+        handlePeriodChange();
+      },
+      snapshot() {
+        return {
+          year: selectedYear, quarter: selectedQuarter, locationId: selectedLocation,
+          planned: budgetAmountsFor(selectedQuarterKey(), "furniture|chairs").RUB || 0
+        };
+      }
+    };
+    renderAll();
+  })();`), context, { filename: APP_PATH });
+  return {
+    changePeriod: context.page.changePeriod,
+    snapshot: () => JSON.parse(JSON.stringify(context.page.snapshot()))
+  };
+}
+
+for (const { title, locationId, year, quarter, planned } of [
+  { title: "AllLocationsStayVisibleAcrossYearChange", locationId: "__all__", year: 2027, quarter: 1, planned: 500 },
+  { title: "SelectedOfficeSurvivesQuarterChangeAndReload", locationId: "office-b", year: 2026, quarter: 3, planned: 300 }
+]) {
+  test(`PeriodSelection_${title}`, () => {
+    const state = fixture();
+    const originalState = JSON.stringify(state);
+    const storage = new Map([[UI_KEY, JSON.stringify({ year: 2026, quarter: 4, locationId })]]);
+    const page = openPage(storage, state);
+    assert.equal(page.snapshot().planned, 400);
+
+    page.changePeriod(year, quarter);
+    const expected = { year, quarter, locationId, planned };
+    assert.deepEqual(page.snapshot(), expected, "смена периода не должна скрыть бюджет выбранного офиса");
+    assert.deepEqual(openPage(storage, state).snapshot(), expected, "после обновления страницы остаётся тот же бюджет");
+    assert.equal(JSON.stringify(state), originalState, "меняется только выбор экрана, бюджет остаётся прежним");
+  });
+}
