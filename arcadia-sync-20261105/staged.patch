+def _convert_forecast_allocation(nxt: dict, payload: dict, now: str) -> None:
+    ticket, allocation = _ticket_and_allocation(nxt, payload)
+    if ticket is None or allocation is None:
+        raise DomainError("Прогнозное распределение не найдено")
+    if og(allocation, "lifecycle") not in ("active", "review"):
+        raise DomainError("Этот прогноз уже освобождён или оплачен")
+    expense_date = _p(payload, "expenseDate")
+    amount = to_number(_p(payload, "amount"))
+    if not valid_date_input(expense_date):
+        raise DomainError("Укажите корректную дату расхода")
+    if strict_ne(quarter_key_from_date_input(expense_date), og(allocation, "quarterKey")):
+        raise DomainError("Фактическая оплата должна относиться к тому же кварталу; для другого квартала сначала измените бюджет")
+    if not is_finite(amount) or amount <= 0:
+        raise DomainError("Введите фактическую сумму больше нуля")
+    ticket_url = safe_http_url(_p(payload, "ticketUrl")) or og(ticket, "ticketUrl")
+    if not truthy(ticket_url):
+        raise DomainError("Укажите ссылку на тикет фактического расхода")
+    period_locks.assert_month_editable(nxt, _month_key(og(allocation, "expectedDate")))
+    period_locks.assert_month_editable(nxt, _month_key(expense_date))
+    expense_id = _p(payload, "expenseId") if truthy(_p(payload, "expenseId")) else new_id()
+    if any(strict_eq(og(item, "id"), expense_id) for item in nxt["expenses"]):
+        raise DomainError("Запись с таким идентификатором уже существует")
+    nxt["expenses"].append({
+        "id": expense_id,
+        "locationId": og(allocation, "locationId"),
+        "articleId": og(allocation, "articleId"),
+        "subarticleId": og(allocation, "subarticleId"),
+        "currency": og(allocation, "currency"),
+        "amount": amount,
+        "ticketUrl": ticket_url,
+        "comment": or_(or_(clean_text(_p(payload, "comment"), 500), og(allocation, "comment")), og(ticket, "description")),
+        "expenseDate": expense_date,
+        "quarterKey": quarter_key_from_date_input(expense_date),
+        "createdAt": now,
+        "createdBy": _author(payload),
+        "createdById": None,
+        "updatedAt": None,
+        "updatedBy": None,
+        "updatedById": None,
+        "status": "active",
+        "history": [],
+        "forecastTicketId": og(ticket, "id"),
+        "forecastAllocationId": og(allocation, "id"),
+    })
+    refresh_forecast_conversion_state(nxt, ticket, allocation)
+    if not truthy(og(ticket, "ticketUrl")):
+        ticket["ticketUrl"] = ticket_url
+    ticket["updatedAt"] = now
+    ticket["updatedBy"] = _author(payload)
+    _push_history(ticket, {
+        "changedAt": now,
+        "changedBy": ticket["updatedBy"],
+        "action": "forecast-convert",
+        "allocationId": og(allocation, "id"),
+        "expenseId": expense_id,
+        "forecastAmount": og(allocation, "amount"),
+        "actualAmount": amount,
+    })
