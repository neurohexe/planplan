+def corrupt(value: Any, rng: random.Random, depth: int = 0) -> Any:
+    if depth > 6:
+        return value
+    if isinstance(value, dict):
+        out = {}
+        for key, item in value.items():
+            roll = rng.random()
+            if roll < 0.04:
+                continue
+            out[key] = rng.choice(_JUNK) if roll < 0.08 else corrupt(item, rng, depth + 1)
+        if rng.random() < 0.05:
+            out[rng.choice(["extra", "__proto__", "id", "currency"])] = rng.choice(_JUNK)
+        return out
+    if isinstance(value, list):
+        out = [corrupt(item, rng, depth + 1) for item in value if rng.random() > 0.05]
+        if out and rng.random() < 0.1:
+            out.append(json.loads(json.dumps(rng.choice(out))))
+        if rng.random() < 0.05:
+            out.append(rng.choice(_JUNK))
+        return out
+    if isinstance(value, str) and rng.random() < 0.05:
+        return rng.choice(["  " + value + "  ", value.upper(), value[:3], "", value + "|x", "2026-02-30", "not-a-date"])
+    if isinstance(value, (int, float)) and not isinstance(value, bool) and rng.random() < 0.05:
+        return rng.choice([-value, str(value), 0, None, value * 1e6])
+    return value
