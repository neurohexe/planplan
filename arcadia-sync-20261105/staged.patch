+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-open.sh
@@ -0,0 +1,36 @@
+#!/bin/bash
+# Открывает копию из Трекера (.pfbak): расшифровывает её в backups/ стенда и проверяет целостность.
+# Пароль берётся из secrets/offsite-password; если файла нет или указан --ask-password, его спрашивают
+# (ввод не отображается). Рабочую базу не меняет: вернуть копию в стенд — отдельной командой bin/restore.sh.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=offsite-common.sh
+. "$SCRIPT_DIR/offsite-common.sh"
+USAGE='Использование: offsite-open.sh <файл .pfbak из Трекера> [--ask-password]'
+ARCHIVE=''
+ASK=false
+for argument in "$@"; do
+  case "$argument" in
+    --ask-password) ASK=true ;;
+    -*) fail "$USAGE" ;;
+    *) [ -z "$ARCHIVE" ] || fail "$USAGE"; ARCHIVE=$argument ;;
+  esac
+done
+[ -n "$ARCHIVE" ] || fail "$USAGE"
+load_stand_config
+[ -f "$ARCHIVE" ] && [ ! -L "$ARCHIVE" ] || fail 'Файл копии не найден или это не обычный файл.'
+private_directory "$STAND/backups"
+OUTPUT="$STAND/backups/offsite-restored-$(date +%Y%m%d-%H%M%S).sqlite"
+if [ "$ASK" = false ] && secret_file_ok "$OFFSITE_PASSWORD_FILE"; then
+  offsite_node open "$ARCHIVE" "$OUTPUT" < "$OFFSITE_PASSWORD_FILE"
+else
+  printf 'Пароль копий (символы не отображаются): ' >&2
+  answer=''
+  IFS= read -r -s answer || true
+  printf '\n' >&2
+  printf '%s\n' "$answer" | offsite_node open "$ARCHIVE" "$OUTPUT"
+  answer=''
+fi
+printf 'Копия расшифрована и проверена: %s\n' "$OUTPUT"
+printf 'Чтобы вернуть её в стенд, выполните: %s/bin/restore.sh %s\n' "$STAND" "$OUTPUT"
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/render-template.mjs b/junk/padolskiye/plan_fact_minipc/deploy/linux/render-template.mjs
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/render-template.mjs
@@ -0,0 +1,25 @@
+// Только стандартные средства Node. Bash-значения экранируются, в файлы служб systemd попадают только безопасные пути.
+import { readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+const [kind, source, target, stand, node] = process.argv.slice(2);
+const shellQuote = (value) => `'${value.replaceAll("'", "'\\''")}'`;
+// В файлах служб systemd по-особому читает пробелы, кавычки, %, $ и \. Такие пути не экранируем, а отклоняем:
+// путь стенда и Node на Linux — обычные латинские пути.
+const unitValue = (value) => {
+  if (!/^\/[A-Za-z0-9/._+-]*$/.test(value) || value.includes('/../') || value.endsWith('/..')) {
+    throw new Error('Путь для службы systemd должен состоять из латинских букв, цифр и знаков / . _ + -');
+  }
+  return value;
+};
+const values = {
+  STAND: stand, NODE: node, BIN: join(stand, 'bin'), LOGS: join(stand, 'logs'),
+  DATABASE: join(stand, 'data', 'plan-fact.sqlite'),
+  STATIC: join(stand, 'app', 'app'), CODES: join(stand, 'codes')
+};
+if (!['config', 'unit'].includes(kind)) throw new Error('Неизвестный вид шаблона.');
+const content = readFileSync(source, 'utf8').replace(/\{\{([A-Z_]+)\}\}/g, (_, key) => {
+  if (!(key in values)) throw new Error(`Неизвестная подстановка ${key}.`);
+  return (kind === 'config' ? shellQuote : unitValue)(values[key]);
+});
+writeFileSync(target, content, { mode: 0o600, flag: 'wx' });
