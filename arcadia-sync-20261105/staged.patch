+#!/bin/bash
+# Задача 13, шаг 4 на СТАРОМ компьютере: зашифрованный архив для переезда стенда.
+# Запускать после bin/disable-tunnel.sh и bin/stop.sh: сервер стенда должен быть остановлен, туннель выключен.
+# Делает свежую резервную копию штатным bin/backup.sh и кладёт её вместе с папкой codes и описанием
+# в backups/move/planfact-move-<дата>.tar.gz.enc, рядом — файл контрольной суммы .sha256.
+# Пароль придумывает и вводит владелец. Рабочую базу, коды и настройки скрипт не меняет;
+# имена и содержимое кодов не печатает. Повторный запуск заменяет прежний архив в backups/move.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=move-common.sh
+. "$SCRIPT_DIR/move-common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: pack.sh'
+
+WORK=''
+finish() {
+  local result=$?
+  MOVE_PASSWORD=''
+  [ -z "$WORK" ] || rm -rf -- "$WORK"
+  exit "$result"
+}
+trap finish EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+
+move_stand
+move_config
+[ -x "$STAND/bin/backup.sh" ] || fail 'Не найден bin/backup.sh стенда.'
+move_require_tunnel_off 'Туннель стенда ещё включён. Сначала выполните bin/disable-tunnel.sh и bin/stop.sh.'
+[ "$(move_ready_code)" = 000 ] || fail 'Сервер стенда ещё работает. Сначала выполните bin/disable-tunnel.sh и bin/stop.sh.'
+[ -f "$PLAN_FACT_DATABASE" ] && [ ! -L "$PLAN_FACT_DATABASE" ] || fail 'Не найдена база стенда data/plan-fact.sqlite.'
+CODES_COUNT=$(move_node codes-count "$CODES")
+
+STARTED=$(date +%s)
+say 'Делаю свежую резервную копию базы…'
+"$STAND/bin/backup.sh" < /dev/null
+SNAPSHOT=$(move_node latest-snapshot "$STAND/backups/hourly" "$STARTED")
+SUMMARY=$(move_node summary "$STAND/backups/hourly/$SNAPSHOT")
+REVISION=${SUMMARY% *}
+USERS=${SUMMARY#* }
+COPY_TIME="${SNAPSHOT:16:2}.${SNAPSHOT:14:2}.${SNAPSHOT:10:4} ${SNAPSHOT:19:2}:${SNAPSHOT:21:2}"
+say "Копия базы от $COPY_TIME проверена: ревизия данных $REVISION, пользователей $USERS. Личных кодов в папке codes: $CODES_COUNT."
+
+OUT_DIR="$STAND/backups/move"
+move_private_directory "$STAND/backups"
+move_private_directory "$OUT_DIR"
+WORK=$(mktemp -d "$STAND/backups/.move-pack.XXXXXX")
+STAMP=$(date +%Y%m%d-%H%M%S)
+NAME="planfact-move-$STAMP.tar.gz.enc"
+SUMS="planfact-move-$STAMP.sha256"
+{
+  printf 'format=1\n'
+  printf 'created=%s\n' "$COPY_TIME"
+  printf 'database=%s\n' "$SNAPSHOT"
+  printf 'codes=%s\n' "$CODES_COUNT"
+  printf 'revision=%s\n' "$REVISION"
+  printf 'users=%s\n' "$USERS"
+} > "$WORK/planfact-move.txt"
+
+move_read_password new
+say 'Шифрую архив…'
+if ! move_tar_create -C "$WORK" planfact-move.txt -C "$STAND/backups/hourly" "$SNAPSHOT" -C "$STAND" codes \
+  | move_encrypt "$WORK/archive.part" 2> "$WORK/openssl.log"; then
+  fail 'Не удалось создать зашифрованный архив. Прежние файлы не изменены.'
+fi
+say 'Проверяю, что архив открывается этим паролем…'
+if ! move_decrypt "$WORK/archive.part" 2> "$WORK/openssl.log" | tar -t -z -f - > "$WORK/names.txt" 2> "$WORK/tar.log"; then
+  fail 'Созданный архив не открылся при проверке. Запустите команду ещё раз.'
+fi
+MOVE_PASSWORD=''
+move_node check-packed "$WORK/names.txt" "$SNAPSHOT" "$CODES"
+HASH=$(move_sha256 "$WORK/archive.part")
+
+# В папке переезда остаётся только новый архив: так на флешку не попадёт устаревший.
+for file in "$OUT_DIR"/planfact-move-*.tar.gz.enc "$OUT_DIR"/planfact-move-*.sha256; do
+  [ ! -f "$file" ] || rm -f -- "$file"
+done
+mv -- "$WORK/archive.part" "$OUT_DIR/$NAME"
+printf '%s  %s\n' "$HASH" "$NAME" > "$OUT_DIR/$SUMS"
+chmod 600 "$OUT_DIR/$NAME" "$OUT_DIR/$SUMS"
+
+say ''
+say 'Готово. Архив для переезда зашифрован и проверен.'
+say "Папка: $OUT_DIR"
+say "Скопируйте на флешку ОБА файла: $NAME и $SUMS."
+say "Контрольная сумма архива (SHA-256): $HASH"
+say 'Пароль никуда не записывайте и не пересылайте: он понадобится один раз — на новом компьютере.'
+say 'Стенд на этом компьютере остаётся остановленным. Вернуть его: bin/start.sh и bin/enable-tunnel.sh.'
+if [ "$(uname -s)" = Darwin ] && [ -z "${PLANFACT_MOVE_NO_FINDER:-}" ]; then
+  open -R "$OUT_DIR/$NAME" 2>/dev/null || true
+fi
