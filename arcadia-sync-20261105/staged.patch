+def _copy_budget(nxt: dict, payload: dict, now: str) -> None:
+    source_quarter = _p(payload, "from")
+    target_quarter = _p(payload, "to")
+    if not period_locks.test(_QUARTER_RE, source_quarter) or not period_locks.test(_QUARTER_RE, target_quarter):
+        raise DomainError("Некорректный квартал")
+    period_locks.assert_quarter_editable(nxt, target_quarter)
+    closed_month = next(
+        (month_key for month_key in quarter_month_keys(target_quarter) if period_locks.is_month_closed(nxt, month_key)), None
+    )
+    if closed_month:
+        raise DomainError(f"Нельзя копировать бюджет: месяц {closed_month} закрыт. Сначала переоткройте его.")
+    location_id = _p(payload, "locationId")
+    if not truthy(location_id) or strict_eq(location_id, ALL_LOCATIONS):
+        raise DomainError("Выберите локацию")
+    to_key = f"{S(location_id)}|{S(target_quarter)}"
+    from_key = f"{S(location_id)}|{S(source_quarter)}"
+    nxt["budgets"][to_key] = clone(or_(og(nxt["budgets"], from_key), {}))
+    if not truthy(nxt.get("monthlyBudgets", UNDEF)):
+        nxt["monthlyBudgets"] = {}
+    copied_monthly = remap_monthly_budget_store(og(nxt["monthlyBudgets"], from_key), source_quarter, target_quarter)
+    if copied_monthly:
+        nxt["monthlyBudgets"][to_key] = copied_monthly
+    else:
+        nxt["monthlyBudgets"].pop(to_key, None)
+    for collection in ("responsibleGroups", "projectAttributes"):
+        if not truthy(nxt.get(collection, UNDEF)):
+            nxt[collection] = {}
+        copied = clone(or_(og(nxt[collection], from_key), {}))
+        if keys(copied):
+            nxt[collection][to_key] = copied
+        else:
+            nxt[collection].pop(to_key, None)
+
