+# База PostgreSQL стенда (задача 41). Только сокет в папке стенда, без TCP. Ставит install-django.sh.
+[Unit]
+Description=План Факт MVP: база PostgreSQL
+StartLimitIntervalSec=0
+
+[Service]
+Type=notify
+ExecStart=/bin/bash {{DJANGO_BIN}}/run-postgres.sh
+Environment=PLANFACT_HOME={{STAND}}
+WorkingDirectory={{STAND}}
+Restart=always
+RestartSec=5
+TimeoutStartSec=300
+TimeoutStopSec=120
+# Быстрая остановка PostgreSQL (SIGINT главному процессу), остальным процессам — после неё.
+KillMode=mixed
+KillSignal=SIGINT
+UMask=0077
+NoNewPrivileges=yes
+
+[Install]
+WantedBy=default.target
