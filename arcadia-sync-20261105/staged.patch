+"""Запуск сервера: gunicorn, один процесс с несколькими потоками (поток /api/events и рассылка
+событий работают внутри процесса, как в прежнем однопроцессном сервере на Node)."""
+
+from __future__ import annotations
+
+import sys
+
+from django.conf import settings
+from django.core.management import call_command
+from django.core.management.base import BaseCommand
+from django.db import connections
+
+from planfact.config import assert_supported
+from planfact.errors import AppError
+
+
+class Command(BaseCommand):
+    help = "Запустить сервер «План Факт» на PLAN_FACT_HOST:PLAN_FACT_PORT"
+
+    def add_arguments(self, parser) -> None:
+        parser.add_argument("--no-migrate", action="store_true", help="не применять миграции базы при запуске")
+
+    def handle(self, *args, **options) -> None:
+        config = settings.PLAN_FACT
+        try:
+            assert_supported(config)
+            if not options["no_migrate"]:
+                call_command("migrate", interactive=False, verbosity=0)
+            from planfact.runtime import get_service
+
+            service = get_service()
+            service.store.ensure_state(service.initial_state())
+        except AppError as error:
+            sys.stderr.write(f"Plan Fact backend failed to start: {error.message[:500]}\n")
+            sys.exit(1)
+        except Exception as error:  # noqa: BLE001 — например, база недоступна
+            sys.stderr.write(f"Plan Fact backend failed to start: {str(error)[:500]}\n")
+            sys.exit(1)
+        finally:
+            # Соединения с базой не должны достаться рабочему процессу gunicorn после fork.
+            connections.close_all()
+        from planfact import runtime
+
+        runtime._service = None
+        _run_gunicorn(config)
+
+
+def _run_gunicorn(config) -> None:
+    import gunicorn.http.wsgi as gunicorn_wsgi
+    from gunicorn.app.base import BaseApplication
+
+    # Заголовок Server не раскрывает программное обеспечение сервера (прежний сервер его не отправлял).
+    gunicorn_wsgi.SERVER = "plan-fact"
+
+    from planfact_site.wsgi import application
+
+    def when_ready(server) -> None:
+        sys.stdout.write(f"Plan Fact backend: http://{config.host}:{config.port}\n")
+        # Режим стенда виден в логе сразу: вход по личным кодам, внешних проверок нет.
+        sys.stdout.write(f"auth_mode access-code secure_cookies={'on' if config.secure_cookies else 'off'}\n")
+        sys.stdout.write(f"time_zone={config.time_zone}\n")
+        sys.stdout.flush()
+
+    class PlanFactServer(BaseApplication):
+        def load_config(self) -> None:
+            host = f"[{config.host}]" if ":" in config.host else config.host
+            options = {
+                "bind": f"{host}:{config.port}",
+                "workers": 1,
+                "worker_class": "gthread",
+                "threads": config.threads,
+                "timeout": 120,
+                "graceful_timeout": 5,
+                "keepalive": 5,
+                # Заголовкам X-Forwarded-* gunicorn не доверяет: через туннель любой запрос приходит
+                # с 127.0.0.1, и иначе их мог бы подставить кто угодно (схема http/https участвует
+                # в проверке Origin). Доверенный прокси задаётся только PLAN_FACT_TRUSTED_PROXY_IPS.
+                "forwarded_allow_ips": "",
+                "secure_scheme_headers": {},
+                "proxy_protocol": False,
+                "accesslog": None,
+                "errorlog": "-",
+                "loglevel": "warning",
+                "proc_name": "planfact",
+                "when_ready": when_ready,
+            }
+            for key, value in options.items():
+                self.cfg.set(key, value)
+
+        def load(self):
+            return application
+
+    PlanFactServer().run()
