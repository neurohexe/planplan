+#!/bin/bash
+# Завершение всех сеансов при явной смене режима входа. Сервер должен быть остановлен.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+. "$SCRIPT_DIR/common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: close-sessions.sh (после остановки сервера)'
+load_stand_config
+[ -f "$PLAN_FACT_DATABASE" ] && [ ! -L "$PLAN_FACT_DATABASE" ] || fail 'Нужен обычный существующий файл базы.'
+# Сначала проверяем и открытый файл базы, и слушающий порт. Никакие коды не читаются.
+# Открытые файлы ищем в /proc: ссылки fd/* процессов пользователя (без отдельных утилит).
+open_by=$("$PLAN_FACT_NODE_BIN" - "$PLAN_FACT_DATABASE" <<'NODE'
+const fs = require('node:fs');
+const path = require('node:path');
+const target = fs.realpathSync(process.argv[2]);
+let entries = [];
+try { entries = fs.readdirSync('/proc'); } catch { process.exit(0); }
+for (const pid of entries.filter((name) => /^\d+$/.test(name))) {
+  let fds = [];
+  try { fds = fs.readdirSync(path.join('/proc', pid, 'fd')); } catch { continue; }
+  for (const fd of fds) {
+    try { if (fs.readlinkSync(path.join('/proc', pid, 'fd', fd)) === target) { console.log(pid); process.exit(0); } } catch {}
+  }
+}
+NODE
+) || open_by=''
+[ -z "$open_by" ] || fail 'База ещё открыта процессом. Остановите сервер и повторите завершение сеансов.'
+NODE_NO_WARNINGS=1 "$PLAN_FACT_NODE_BIN" --experimental-sqlite "$SCRIPT_DIR/close-sessions.mjs" "$STAND" "$PLAN_FACT_DATABASE" "$PLAN_FACT_PORT"
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/common.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/common.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/common.sh
@@ -0,0 +1,251 @@
+#!/bin/bash
+# Общие функции скриптов стенда на Linux (мини-ПК). Настройки читаются только из выбранного стенда.
+# Вместо агентов launchd — пользовательские службы systemd (systemctl --user) в ~/.config/systemd/user.
+set -euo pipefail
+umask 077
+
+LAPTOP_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+if [ -n "${PLANFACT_HOME:-}" ]; then
+  STAND=$PLANFACT_HOME
+elif [ "$(basename -- "$LAPTOP_DIR")" = bin ]; then
+  # Установленные скрипты управляют только своим стендом. Если его config.env пропал, они откажут сами,
+  # а не перейдут молча к ~/PlanFactMVP (иначе uninstall.sh репетиции удалил бы настоящий стенд).
+  STAND=$(CDPATH= cd -- "$LAPTOP_DIR/.." && pwd -P)
+else
+  STAND="$HOME/PlanFactMVP"
+fi
+
+fail() { printf 'Ошибка: %s\n' "$*" >&2; exit 1; }
+
+case "$STAND" in
+  /*) ;;
+  *) fail 'PLANFACT_HOME должен быть полным путём, начиная с /.' ;;
+esac
+[ ! -L "$STAND" ] || fail 'Папка стенда не должна быть символической ссылкой.'
+if [ -d "$STAND" ]; then
+  STAND=$(CDPATH= cd -- "$STAND" && pwd -P)
+fi
+case "$STAND" in
+  /|"$HOME"|"$HOME/"|*/..|*/.) fail 'Выберите отдельную папку для стенда.' ;;
+esac
+export PLANFACT_HOME="$STAND"
+# Папка пользовательских служб systemd. XDG_CONFIG_HOME не учитываем: путь должен быть предсказуемым.
+UNIT_DIR="$HOME/.config/systemd/user"
+# Копии служб стенда и служебные метки (.no-systemd, .label-suffix, .tunnel-enabled).
+SERVICE_DIR="$STAND/systemd"
+
+# PLANFACT_DJANGO_LEGACY_GUARD: прежние команды не должны менять застывшую SQLite.
+if [ -e "$SERVICE_DIR/.backend-django" ]; then
+  case "$(basename -- "$0")" in
+    healthcheck.sh | rotate-logs.sh | tunnel-run.sh | enable-tunnel.sh | disable-tunnel.sh | tunnel-check.sh | disable-offsite-backup.sh | offsite-open.sh) ;;
+    issue-code.sh) fail 'Стенд работает на Django. Используйте ~/planfact/bin/django-manage.sh issue_access_code <логин>.' ;;
+    close-sessions.sh) fail 'Стенд работает на Django. Используйте ~/planfact/bin/django-manage.sh close_sessions.' ;;
+    backup.sh) fail 'Стенд работает на Django. Используйте ~/planfact/bin/backup-postgres.sh.' ;;
+    restore.sh) fail 'Стенд работает на Django. Используйте ~/planfact/bin/restore-postgres.sh.' ;;
+    status.sh) fail 'Стенд работает на Django. Используйте ~/planfact/bin/status-django.sh.' ;;
+    *) fail 'Стенд работает на Django. Прежняя команда SQLite запрещена; используйте ~/planfact/bin/.' ;;
+  esac
+fi
+
+# Имена служб — ru.planfact.mvp.<имя><суффикс>.service (и .timer для периодических). Второй стенд на том же
+# компьютере (репетиция) получает свой суффикс, например PLANFACT_LABEL_SUFFIX=.rehearsal →
+# ru.planfact.mvp.app.rehearsal.service, и не задевает служб настоящего стенда. Установщик записывает суффикс
+# в systemd/.label-suffix; дальше скрипты стенда берут его оттуда.
+LABEL_PREFIX=ru.planfact.mvp
+LABEL_SUFFIX_FILE="$SERVICE_DIR/.label-suffix"
+# Проверяет суффикс и кладёт его в LABEL_SUFFIX_VALUE: «rehearsal» и «.rehearsal» дают «.rehearsal».
+parse_label_suffix() {
+  local value=${1#.}
+  [ -z "$value" ] || [[ "$value" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || fail 'Суффикс меток PLANFACT_LABEL_SUFFIX: строчные латинские буквы, цифры и дефисы, например .rehearsal.'
+  LABEL_SUFFIX_VALUE=${value:+.$value}
+}
+parse_label_suffix "${PLANFACT_LABEL_SUFFIX:-}"
+LABEL_SUFFIX=$LABEL_SUFFIX_VALUE
+if [ -e "$LABEL_SUFFIX_FILE" ] || [ -L "$LABEL_SUFFIX_FILE" ]; then
+  [ -f "$LABEL_SUFFIX_FILE" ] && [ ! -L "$LABEL_SUFFIX_FILE" ] || fail 'systemd/.label-suffix должен быть обычным файлом.'
+  stored_label_suffix=''
+  read -r stored_label_suffix < "$LABEL_SUFFIX_FILE" || true
+  parse_label_suffix "$stored_label_suffix"
+  if [ -n "${PLANFACT_LABEL_SUFFIX:-}" ] && [ "$LABEL_SUFFIX" != "$LABEL_SUFFIX_VALUE" ]; then
+    fail "Стенд $STAND установлен с другими метками служб (суффикс: ${LABEL_SUFFIX_VALUE:-нет}). Уберите PLANFACT_LABEL_SUFFIX или укажите тот же суффикс."
+  fi
+  LABEL_SUFFIX=$LABEL_SUFFIX_VALUE
+fi
+# Метка службы этого стенда по имени: app → ru.planfact.mvp.app (с суффиксом стенда).
+stand_label() { printf '%s.%s%s\n' "$LABEL_PREFIX" "$1" "$LABEL_SUFFIX"; }
+# Имя службы по её метке: ru.planfact.mvp.tunnel.rehearsal → tunnel.
+agent_name() {
+  local name=${1#"$LABEL_PREFIX".}
+  printf '%s\n' "${name%"$LABEL_SUFFIX"}"
+}
+APP_LABEL=$(stand_label app)
+
+require_node() {
+  local binary=$1 version major minor
+  case "$binary" in /*) ;; *) fail 'Путь к Node должен быть абсолютным.' ;; esac
+  [ -x "$binary" ] || fail 'Не найден Node. Нужен Node 22.5 или новее.'
+  version=$("$binary" --version) || fail 'Не удалось запустить Node.'
+  if [[ "$version" =~ ^v([0-9]+)\.([0-9]+)\. ]]; then
+    major=${BASH_REMATCH[1]}
+    minor=${BASH_REMATCH[2]}
+    if [ "$major" -gt 22 ] || { [ "$major" -eq 22 ] && [ "$minor" -ge 5 ]; }; then
+      return
+    fi
+  fi
+  fail 'Нужен Node 22.5 или новее. Обновите Node перед установкой.'
+}
+
+load_stand_config() {
+  [ -f "$STAND/config.env" ] && [ ! -L "$STAND/config.env" ] || fail 'Не найден обычный файл config.env. Сначала установите стенд.'
+  set -a
+  # shellcheck disable=SC1091
+  . "$STAND/config.env"
+  set +a
+  # config.env не меняет выбор стенда и папку служб.
+  export PLANFACT_HOME="$STAND"
+  require_node "${PLAN_FACT_NODE_BIN:-}"
+  [ "${NODE_ENV:-}" = development ] || fail 'В config.env требуется NODE_ENV=development.'
+  case "${PLAN_FACT_AUTH_MODE:-}" in
+    access-code|corporate-idm) ;;
+    *) fail 'В config.env допустимы только access-code или corporate-idm.' ;;
+  esac
+  [ "${PLAN_FACT_STORAGE_DRIVER:-}" = sqlite ] || fail 'В config.env требуется хранилище SQLite.'
+  [ "${PLAN_FACT_HOST:-}" = 127.0.0.1 ] || fail 'Сервер должен слушать только 127.0.0.1.'
+  [[ "${PLAN_FACT_PORT:-}" =~ ^[0-9]{1,5}$ ]] || fail 'В config.env неверный номер порта.'
+  [ "$((10#$PLAN_FACT_PORT))" -ge 1 ] && [ "$((10#$PLAN_FACT_PORT))" -le 65535 ] || fail 'Порт должен быть от 1 до 65535.'
+  # При установке проверяется новая копия кода до замены работающей; при запуске — установленная.
+  # Ошибка настройки останавливает команду, без возврата к личным кодам.
+  if [ "$PLAN_FACT_AUTH_MODE" = corporate-idm ] || [ "${PLAN_FACT_ROLE_SOURCE:-}" = tirole ]; then
+    "$PLAN_FACT_NODE_BIN" - "${1:-$STAND/app}/backend/src/config.js" <<'NODE'
+try { require(process.argv[2]).loadConfig(); }
+catch (error) { console.error(`Ошибка конфигурации: ${error.message}`); process.exit(1); }
+NODE
+  fi
+  # Настройки файлов не должны увести команды из выбранной папки стенда.
+  "$PLAN_FACT_NODE_BIN" - "$STAND" <<'NODE'
+const path = require('node:path');
+const root = process.argv[2];
+for (const key of ['PLAN_FACT_DATABASE', 'PLAN_FACT_STATIC_DIR', 'PLAN_FACT_CODES_DIR']) {
+  const value = process.env[key] || '';
+  const relative = path.relative(root, path.resolve(value));
+  if (!path.isAbsolute(value) || !relative || relative === '..' || relative.startsWith(`..${path.sep}`)) {
+    console.error('Ошибка: пути базы, страниц и кодов должны находиться внутри папки стенда.');
+    process.exit(1);
+  }
+}
+NODE
+}
+
+# Метка службы по имени файла: …/ru.planfact.mvp.backup.timer → ru.planfact.mvp.backup.
+agent_label() {
+  local name
+  name=$(basename -- "$1")
+  name=${name%.service}
+  name=${name%.timer}
+  [[ "$name" =~ ^ru\.planfact\.mvp\.[a-z0-9][a-z0-9.-]*$ ]] || fail 'Неверное имя службы стенда.'
+  printf '%s\n' "$name"
+}
+
+# Главный файл службы: таймер у периодических (резервные копии, проверка, журналы), иначе сама служба.
+agent_unit() {
+  if [ -f "$SERVICE_DIR/$1.timer" ]; then printf '%s.timer\n' "$1"; else printf '%s.service\n' "$1"; fi
+}
+# Все файлы службы в папке стенда: .service и, если есть, .timer.
+agent_files() {
+  local suffix
+  for suffix in service timer; do
+    [ ! -f "$SERVICE_DIR/$1.$suffix" ] || printf '%s.%s\n' "$1" "$suffix"
+  done
+}
+# Метки служб этого стенда — по файлам .service в systemd/ стенда, а не все ru.planfact.mvp.* в системе.
+stand_labels() {
+  local file
+  for file in "$SERVICE_DIR"/ru.planfact.mvp.*.service; do
+    [ -f "$file" ] || continue
+    agent_label "$file"
+  done
+}
+
+systemd_enabled() { [ ! -f "$SERVICE_DIR/.no-systemd" ]; }
+
+user_systemctl() { systemctl --user "$@"; }
+
+# Без пользовательского systemd (например, в сеансе без входа пользователя) службами управлять нельзя.
+require_user_systemd() {
+  command -v systemctl >/dev/null 2>&1 || fail 'Не найден systemctl. Стенд для Linux рассчитан на систему с systemd.'
+  user_systemctl show-environment >/dev/null 2>&1 \
+    || fail 'Пользовательский systemd недоступен в этом сеансе. Войдите в систему под своей учётной записью (локально или по ssh) и повторите.'
+}
+
+# Служба принадлежит этому стенду, если в папке служб лежат те же копии файлов, что в systemd/ стенда (или их там нет).
+# Другой копией с той же меткой управляет другой стенд на этом компьютере: её не останавливаем и не удаляем.
+agent_is_ours() {
+  local unit
+  for unit in $(agent_files "$1"); do
+    [ ! -e "$UNIT_DIR/$unit" ] || cmp -s -- "$UNIT_DIR/$unit" "$SERVICE_DIR/$unit" || return 1
+  done
+}
+
+agent_installed() {
+  local unit
+  for unit in $(agent_files "$1"); do
+    [ -f "$UNIT_DIR/$unit" ] || return 1
+  done
+  [ -n "$(agent_files "$1")" ]
+}
+
+agent_active() { user_systemctl is-active --quiet "$(agent_unit "$1")" 2>/dev/null; }
+
+# Останавливает службу (и таймер, и саму службу). systemctl stop ждёт завершения процесса сам: до TimeoutStopSec
+# из файла службы, затем systemd завершает его принудительно.
+# Службу, которой нет в папке служб, systemd не знает: останавливать нечего.
+bootout_agent() {
+  local label=$1 unit units=''
+  for unit in "$label.timer" "$label.service"; do
+    [ ! -f "$UNIT_DIR/$unit" ] || units="$units $unit"
+  done
+  [ -n "$units" ] || return 0
+  # shellcheck disable=SC2086
+  user_systemctl stop $units >/dev/null 2>&1 || fail "Не удалось остановить службу $label."
+}
+
+# Запускает службу заново (таймер — у периодических; первый запуск таймер делает сразу).
+bootstrap_agent() {
+  local label=$1
+  user_systemctl restart "$(agent_unit "$label")" >/dev/null 2>&1 || fail "Не удалось запустить службу $label."
+}
+
+# Останавливает только службы этого стенда.
+stop_agents() {
+  local label
+  systemd_enabled || return 0
+  require_user_systemd
+  for label in $(stand_labels); do
+    if ! agent_is_ours "$label"; then
+      printf 'Служба %s установлена другим стендом — не трогаю её.\n' "$label" >&2
+      continue
+    fi
+    bootout_agent "$label"
+  done
+}
+
+start_agents() {
+  local label
+  systemd_enabled || fail 'Это проверочная установка без автозапуска. Используйте bin/run-app.sh для ручной проверки.'
+  require_user_systemd
+  for label in $(stand_labels); do
+    # Ручную службу включает её собственный скрипт (например, enable-tunnel.sh). Здесь возвращаем в работу только ту,
+    # что уже была включена: рядом лежит метка systemd/.<имя>-enabled (для туннеля — .tunnel-enabled).
+    if [ -f "$SERVICE_DIR/$label.manual" ] && [ ! -f "$SERVICE_DIR/.$(agent_name "$label")-enabled" ]; then
+      continue
+    fi
+    agent_installed "$label" || fail "Не найдена установленная служба $label. Повторите установку из мастерской."
+    agent_is_ours "$label" || fail "Служба $label установлена другим стендом. Повторите установку из мастерской."
+    bootout_agent "$label"
+    bootstrap_agent "$label"
+  done
+}
+
+# Права и размер файла — через Node: у stat на Linux и macOS разные ключи, а Node есть всегда.
+file_mode() { "$PLAN_FACT_NODE_BIN" -e 'const fs = require("node:fs"); try { console.log((fs.lstatSync(process.argv[1]).mode & 0o777).toString(8)); } catch { process.exit(1); }' "$1"; }
+file_size() { "$PLAN_FACT_NODE_BIN" -e 'console.log(require("node:fs").statSync(process.argv[1]).size)' "$1"; }
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/config.env.template b/junk/padolskiye/plan_fact_minipc/deploy/linux/config.env.template
