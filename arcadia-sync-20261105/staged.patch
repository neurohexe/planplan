+#!/bin/bash
+# Живой тест только в собственной .sandbox, на 18767, без launchd и GUI.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)
+NODE_BINARY=$(command -v node)
+PASSED=0
+GUARD_PID=''
+DIST_EXISTED=false
+[ ! -e "$PROJECT_ROOT/dist" ] || DIST_EXISTED=true
+mkdir -p "$PROJECT_ROOT/.sandbox"
+TEST_ROOT=$(mktemp -d "$PROJECT_ROOT/.sandbox/task-08.XXXXXX")
+TEST_STAND="$TEST_ROOT/стенд с пробелами & 'кавычкой'"
+FINISHED=false
+cleanup() {
+  local status=$?
+  if [ -n "$GUARD_PID" ]; then
+    kill -TERM "$GUARD_PID" 2>/dev/null || true
+    wait "$GUARD_PID" 2>/dev/null || true
+  fi
+  if [ -f "$TEST_STAND/data/app.pid" ] && [ -f "$TEST_STAND/bin/maintenance-server.mjs" ]; then
+    "$NODE_BINARY" "$TEST_STAND/bin/maintenance-server.mjs" stop-test "$TEST_STAND" >/dev/null 2>&1 || true
+  fi
+  rm -rf -- "$TEST_ROOT"
+  [ "$DIST_EXISTED" = true ] || rm -rf -- "$PROJECT_ROOT/dist"
+  rmdir "$PROJECT_ROOT/.sandbox" 2>/dev/null || true
+  # bash 3.2 после ошибки «unbound variable» выходит с кодом последней команды ловушки (0): без отметки о завершении это сбой.
+  [ "$FINISHED" = true ] || [ "$status" -ne 0 ] || status=1
+  exit "$status"
+}
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+check() {
+  local title=$1
+  shift
+  "$@" || { printf 'Не пройдена проверка: %s\n' "$title" >&2; exit 1; }
+  PASSED=$((PASSED + 1))
+  printf 'Пройдена проверка %s: %s.\n' "$PASSED" "$title"
+}
+fails() {
+  if "$@" > "$TEST_ROOT/expected-error.txt" 2>&1; then return 1; fi
+}
+port_is_free() { ! lsof -nP -iTCP:18767 -sTCP:LISTEN >/dev/null 2>&1; }
+server_command() { "$NODE_BINARY" "$TEST_STAND/bin/maintenance-server.mjs" "$1" "$TEST_STAND"; }
+ready() { [ "$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 1 http://127.0.0.1:18767/api/ready)" = 200 ]; }
+logins_are() {
+  NODE_NO_WARNINGS=1 "$NODE_BINARY" --experimental-sqlite - "$1" "$2" <<'NODE'
+const { DatabaseSync } = require('node:sqlite'), assert = require('node:assert/strict');
+const db = new DatabaseSync(process.argv[2], { readOnly: true });
+try {
+  assert.deepEqual(db.prepare('SELECT staff_login FROM users ORDER BY staff_login').all().map((row) => row.staff_login), JSON.parse(process.argv[3]));
+} finally { db.close(); }
+NODE
+}
+check 'порт 18767 свободен' port_is_free
+mkdir "$TEST_ROOT/guard-bin"
+cat > "$TEST_ROOT/guard-bin/launchctl" <<'SH'
+#!/bin/bash
+printf 'Ошибка: тест не должен обращаться к настоящему launchd.\n' >&2
+exit 99
+SH
+cat > "$TEST_ROOT/guard-bin/osascript" <<'SH'
+#!/bin/bash
+printf '%s\n' "$*" >> "$PLANFACT_NOTIFICATION_TEST_LOG"
+SH
+chmod 700 "$TEST_ROOT/guard-bin/"*
+export PATH="$TEST_ROOT/guard-bin:$PATH"
+export PLANFACT_HOME="$TEST_STAND"
+export PLANFACT_NO_NOTIFICATIONS=1
+export PLANFACT_NOTIFICATION_TEST_LOG="$TEST_ROOT/notifications.txt"
+/bin/bash "$SCRIPT_DIR/install.sh" --no-launchd --no-start
+printf '\nPLAN_FACT_PORT=18767\n' >> "$TEST_STAND/config.env"
+set -a
+. "$TEST_STAND/config.env"
+set +a
+export NODE_NO_WARNINGS=1
+check 'новые скрипты и расписания установлены, тестовые скрипты исключены' "$NODE_BINARY" - "$TEST_STAND" <<'NODE'
+const fs = require('node:fs'), assert = require('node:assert/strict'), { execFileSync } = require('node:child_process');
+const root = process.argv[2];
+assert(fs.existsSync(root + '/launchd/.no-launchd'));
+assert(!fs.readdirSync(root + '/bin').some((name) => /^test-.*\.sh$/.test(name)));
+for (const name of ['backup', 'restore', 'healthcheck']) assert.equal(fs.statSync(root + '/bin/' + name + '.sh').mode & 0o777, 0o700);
+for (const [name, interval] of [['backup', 3600], ['healthcheck', 300]]) {
+  const file = root + '/launchd/ru.planfact.mvp.' + name + '.plist';
+  const plist = JSON.parse(execFileSync('/usr/bin/plutil', ['-convert', 'json', '-o', '-', '--', file]));
+  assert.equal(plist.Label, 'ru.planfact.mvp.' + name);
+  assert.equal(plist.StartInterval, interval);
+  assert.deepEqual(plist.ProgramArguments, ['/bin/bash', root + '/bin/' + name + '.sh']);
+  if (name === 'backup') assert.equal(plist.RunAtLoad, true);
+}
+NODE
+"$TEST_STAND/bin/backup.sh" > "$TEST_ROOT/no-database.txt" 2>&1
+check 'без базы копирование тихо завершается успешно' test ! -s "$TEST_ROOT/no-database.txt"
+"$TEST_STAND/bin/status.sh" > "$TEST_ROOT/empty-status.txt"
+check 'статус сообщает об отсутствии копий' grep -q 'Резервные копии пока не созданы' "$TEST_ROOT/empty-status.txt"
+check 'выдуманные данные alice созданы штатной CLI' "$TEST_STAND/bin/add-superadmins.sh" alice
+check 'выдуманный тестовый сервер запущен без launchd' server_command start-test
+check 'сервер готов на 127.0.0.1:18767' server_command wait-ready
+OLD_PID=$(cat "$TEST_STAND/data/app.pid")
+check 'резервная копия сделана при работающем сервере' "$TEST_STAND/bin/backup.sh"
+ORIGINAL=$("$NODE_BINARY" -e 'const fs=require("node:fs"),root=process.argv[1];console.log(root+"/backups/hourly/"+fs.readdirSync(root+"/backups/hourly").filter(n=>/^plan-fact-\d{8}-\d{4}\.sqlite$/.test(n)).sort().pop());' "$TEST_STAND")
+cp "$ORIGINAL" "$TEST_ROOT/original.sqlite"
+ORIGINAL="$TEST_ROOT/original.sqlite"
+check 'копия целая, содержит alice; права файлов 600, папок 700' "$NODE_BINARY" --experimental-sqlite - "$TEST_STAND" "$ORIGINAL" <<'NODE'
+const fs = require('node:fs'), assert = require('node:assert/strict'), { DatabaseSync } = require('node:sqlite');
+const [root, original] = process.argv.slice(2);
+for (const folder of ['hourly', 'daily']) {
+  const directory = root + '/backups/' + folder;
+  assert.equal(fs.statSync(directory).mode & 0o777, 0o700);
+  const names = fs.readdirSync(directory); assert.equal(names.length, 1);
+  assert(/^plan-fact-\d{8}-\d{4}\.sqlite$/.test(names[0]));
+  const file = directory + '/' + names[0]; assert.equal(fs.statSync(file).mode & 0o777, 0o600);
+  const db = new DatabaseSync(file, { readOnly: true });
+  try { assert.equal(db.prepare('PRAGMA integrity_check').get().integrity_check, 'ok'); assert.deepEqual(db.prepare('SELECT staff_login FROM users').all().map(r=>r.staff_login), ['alice']); }
+  finally { db.close(); }
+}
+assert.deepEqual(fs.readFileSync(original), fs.readFileSync(root + '/backups/daily/' + fs.readdirSync(root + '/backups/daily')[0]));
+NODE
+check 'при копировании сервер не перезапускался' /bin/bash -c 'test "$(cat "$1/data/app.pid")" = "$2" && kill -0 "$2"' _ "$TEST_STAND" "$OLD_PID"
+check 'готовность после копирования — HTTP 200' ready
+check 'данные изменены: добавлен выдуманный bob' "$TEST_STAND/bin/add-superadmins.sh" bob
+check 'изменённая база содержит alice и bob' logins_are "$PLAN_FACT_DATABASE" '["alice","bob"]'
+check 'повторное копирование в тот же день проходит' "$TEST_STAND/bin/backup.sh"
+check 'первая ежедневная копия не заменяется повторной' "$NODE_BINARY" - "$TEST_STAND" "$ORIGINAL" <<'NODE'
+const fs=require('node:fs'), assert=require('node:assert/strict'), root=process.argv[2];
+const names=fs.readdirSync(root+'/backups/daily'); assert.equal(names.length,1);
+assert.deepEqual(fs.readFileSync(root+'/backups/daily/'+names[0]),fs.readFileSync(process.argv[3]));
+NODE
+printf 'Это повреждённая копия, не SQLite.\n' > "$TEST_ROOT/corrupt.sqlite"
+check 'повреждённая копия отклоняется до остановки сервера' fails "$TEST_STAND/bin/restore.sh" "$TEST_ROOT/corrupt.sqlite" --yes
+check 'несуществующая копия отклоняется до остановки сервера' fails "$TEST_STAND/bin/restore.sh" "$TEST_ROOT/missing.sqlite" --yes
+printf 'нет\n' | "$TEST_STAND/bin/restore.sh" "$ORIGINAL" > "$TEST_ROOT/cancelled.txt"
+check 'без подтверждения восстановление отменяется' grep -q 'Восстановление отменено' "$TEST_ROOT/cancelled.txt"
+check 'после отказов исходный сервер жив, архивы не создавались' "$NODE_BINARY" - "$TEST_STAND" "$OLD_PID" <<'NODE'
+const fs=require('node:fs'),assert=require('node:assert/strict'),root=process.argv[2];
+assert.equal(fs.readFileSync(root+'/data/app.pid','utf8').trim(),process.argv[3]);
+process.kill(Number(process.argv[3]),0);
+assert(!fs.readdirSync(root+'/backups').some(n=>n.startsWith('before-restore-')||n.startsWith('.restore-')||n==='.maintenance-lock'));
+NODE
+/bin/sleep 30 &
+GUARD_PID=$!
+printf '%s\n' "$GUARD_PID" > "$TEST_STAND/data/app.pid"
+wrong_pid_result=0
+if "$TEST_STAND/bin/restore.sh" "$ORIGINAL" --yes > "$TEST_ROOT/wrong-pid.txt" 2>&1; then wrong_pid_result=1; fi
+printf '%s\n' "$OLD_PID" > "$TEST_STAND/data/app.pid"
+check 'неверный pid-файл не позволяет остановить посторонний тестовый процесс' /bin/bash -c 'test "$1" -eq 0 && kill -0 "$2" && kill -0 "$3" && grep -q "указывает на другой процесс" "$4"' _ "$wrong_pid_result" "$GUARD_PID" "$OLD_PID" "$TEST_ROOT/wrong-pid.txt"
+kill -TERM "$GUARD_PID"
