diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/maintenance-server.mjs b/junk/padolskiye/plan_fact_minipc/deploy/linux/maintenance-server.mjs
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/maintenance-server.mjs
@@ -0,0 +1,111 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import net from 'node:net';
+import { execFileSync, spawn } from 'node:child_process';
+import { setTimeout as delay } from 'node:timers/promises';
+
+const [command, root] = process.argv.slice(2);
+const port = Number(process.env.PLAN_FACT_PORT);
+const pidFile = path.join(root, 'data', 'app.pid');
+const expectedCommand = `${process.env.PLAN_FACT_NODE_BIN} --experimental-sqlite ${path.join(root, 'app/backend/src/index.js')}`;
+
+function fileInfo(file) {
+  try { return fs.lstatSync(file); }
+  catch (error) { if (error.code === 'ENOENT') return null; throw error; }
+}
+
+function testMode() {
+  if (!fileInfo(path.join(root, 'systemd/.no-systemd'))?.isFile()) throw new Error('Управление тестовым процессом разрешено только без systemd.');
+  for (const file of [root, path.join(root, 'data'), pidFile]) {
+    if (fileInfo(file)?.isSymbolicLink()) throw new Error('Папка данных и pid-файл не должны быть ссылками.');
+  }
+  if (fileInfo(pidFile) && !fileInfo(pidFile).isFile()) throw new Error('Pid-файл должен быть обычным файлом.');
+}
+
+function pid() {
+  if (!fileInfo(pidFile)) return null;
+  const text = fs.readFileSync(pidFile, 'utf8').trim();
+  if (!/^[1-9]\d{0,9}$/.test(text) || Number(text) <= 1) throw new Error('Неверный номер тестового процесса в data/app.pid.');
+  return Number(text);
+}
+
+function processInfo(number) {
+  try {
+    const text = execFileSync(fs.existsSync('/bin/ps') ? '/bin/ps' : '/usr/bin/ps', ['-p', String(number), '-o', 'stat=', '-o', 'command='], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
+    const match = text.match(/^(\S+)\s+(.*)$/);
+    if (!match || match[1].startsWith('Z')) return null;
+    return match[2];
+  } catch { return null; }
+}
+
+async function listening() {
+  return new Promise((resolve) => {
+    const connection = net.createConnection({ host: '127.0.0.1', port });
+    let finished = false;
+    const finish = (value) => { if (!finished) { finished = true; connection.destroy(); resolve(value); } };
+    connection.once('connect', () => finish(true));
+    connection.once('error', () => finish(false));
+    connection.setTimeout(500, () => finish(true));
+  });
+}
+
+async function waitUntil(predicate, message) {
+  const deadline = Date.now() + 30000;
+  while (Date.now() < deadline) {
+    if (await predicate(deadline)) return;
+    await delay(Math.min(200, Math.max(0, deadline - Date.now())));
+  }
+  throw new Error(message);
+}
+
+async function stopTest() {
+  testMode();
+  const number = pid();
+  if (number) {
+    const current = processInfo(number);
+    if (current && current !== expectedCommand) throw new Error('Pid-файл указывает на другой процесс. Он не будет остановлен.');
+    if (current) {
+      process.kill(number, 'SIGTERM');
+      await waitUntil(() => !processInfo(number), 'Тестовый сервер не остановился за 30 секунд.');
+    }
+  }
+  if (await listening()) throw new Error('На порту остался сервер без подтверждённого pid-файла. Восстановление остановлено.');
+  fs.rmSync(pidFile, { force: true });
+}
+
+async function startTest() {
+  testMode();
+  const number = pid();
+  if ((number && processInfo(number)) || await listening()) throw new Error('Тестовый сервер или его порт уже занят.');
+  fs.rmSync(pidFile, { force: true });
+  const child = spawn('/bin/bash', [path.join(root, 'bin/run-app.sh')], {
+    detached: true, stdio: 'ignore', env: { ...process.env, PLANFACT_HOME: root }
+  });
+  await new Promise((resolve, reject) => { child.once('spawn', resolve); child.once('error', reject); });
+  try { fs.writeFileSync(pidFile, `${child.pid}\n`, { flag: 'wx', mode: 0o600 }); }
+  catch (error) { child.kill('SIGTERM'); throw error; }
+  child.unref();
+}
+
+try {
+  switch (command) {
+    case 'stop-test': await stopTest(); break;
+    case 'start-test': await startTest(); break;
+    case 'wait-stopped': await waitUntil(async () => !await listening(), 'Сервер не освободил порт за 30 секунд.'); break;
+    case 'wait-ready':
+      await waitUntil(async (deadline) => {
+        try {
+          const response = await fetch(`http://127.0.0.1:${port}/api/ready`, {
+            signal: AbortSignal.timeout(Math.max(1, Math.min(1000, deadline - Date.now()))), redirect: 'manual'
+          });
+          await response.body?.cancel();
+          return response.status === 200;
+        } catch { return false; }
+      }, 'Сервер не стал готов за 30 секунд. Прежняя база сохранена в backups/before-restore-…; проверьте logs/app.stderr.log.');
+      break;
+    default: throw new Error('Неизвестная команда управления тестовым сервером.');
+  }
+} catch (error) {
+  console.error(`Ошибка: ${error.code || error.message}`);
+  process.exitCode = 1;
+}
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-backup.mjs b/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-backup.mjs
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-backup.mjs
@@ -0,0 +1,124 @@
+// Копия в Трекер (задача 36): шифрование резервной копии паролем копий, открытие архива и ответы API Трекера.
+// Только стандартные средства Node. Пароль, токен и содержимое базы не печатаются.
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import zlib from 'node:zlib';
+import { DatabaseSync } from 'node:sqlite';
+
+// Архив .pfbak: заголовок (метка PFBK, версия, параметры scrypt, соль, iv), затем AES-256-GCM от gzip-копии и тег.
+// Заголовок входит в проверку подлинности: подмена параметров или данных обнаруживается при открытии.
+const MAGIC = Buffer.from('PFBK');
+const VERSION = 1;
+const SCRYPT = { log2N: 16, r: 8, p: 1 };
+const HEADER_LENGTH = MAGIC.length + 4 + 16 + 12;
+const TAG_LENGTH = 16;
+const MAX_DATABASE = 1024 ** 3;
+const ARCHIVE_NAME = /^plan-fact-\d{8}-\d{4}\.pfbak$/;
+
+class UserError extends Error {}
+
+function regularFile(file) {
+  if (!fs.lstatSync(file, { throwIfNoEntry: false })?.isFile()) throw new UserError('Ожидался существующий обычный файл.');
+}
+
+function integrity(file) {
+  const connection = new DatabaseSync(file, { readOnly: true });
+  try {
+    const rows = connection.prepare('PRAGMA integrity_check').all();
+    if (rows.length !== 1 || rows[0].integrity_check !== 'ok') throw new UserError('Проверка целостности копии не вернула ok.');
+  } finally { connection.close(); }
+}
+
+function password(text) {
+  const value = text.endsWith('\n') ? text.slice(0, -1) : text;
+  if (value.length < 12 || value.length > 1024 || /[\r\n]/.test(value)) {
+    throw new UserError('Пароль копий должен быть одной строкой не короче 12 символов.');
+  }
+  return value;
+}
+
+function key(secret, salt, { log2N, r, p }) {
+  // Параметры из заголовка ограничены: чужой файл не заставит выделить лишнюю память.
+  if (log2N < 15 || log2N > 17 || r !== 8 || p !== 1) throw new UserError('Неизвестные параметры архива.');
+  const N = 2 ** log2N;
+  return crypto.scryptSync(secret, salt, 32, { N, r, p, maxmem: 256 * N * r });
+}
+
+function unseal(sealed, secret) {
+  if (sealed.length < HEADER_LENGTH + TAG_LENGTH || !sealed.subarray(0, MAGIC.length).equals(MAGIC) || sealed[4] !== VERSION) {
+    throw new UserError('Это не архив копии План Факта или он другой версии.');
+  }
+  const header = sealed.subarray(0, HEADER_LENGTH);
+  const [log2N, r, p] = sealed.subarray(5, 8);
+  const decipher = crypto.createDecipheriv('aes-256-gcm', key(secret, sealed.subarray(8, 24), { log2N, r, p }), sealed.subarray(24, 36));
+  decipher.setAAD(header);
+  decipher.setAuthTag(sealed.subarray(sealed.length - TAG_LENGTH));
+  try {
+    return Buffer.concat([decipher.update(sealed.subarray(HEADER_LENGTH, sealed.length - TAG_LENGTH)), decipher.final()]);
+  } catch { throw new UserError('Пароль не подходит или архив повреждён.'); }
+}
+
+function seal(snapshot, output, passwordFile) {
+  regularFile(snapshot);
+  integrity(snapshot);
+  const secret = password(fs.readFileSync(passwordFile, 'utf8'));
+  const plain = zlib.gzipSync(fs.readFileSync(snapshot), { level: 9 });
+  const salt = crypto.randomBytes(16), iv = crypto.randomBytes(12);
+  const header = Buffer.concat([MAGIC, Buffer.from([VERSION, SCRYPT.log2N, SCRYPT.r, SCRYPT.p]), salt, iv]);
+  const cipher = crypto.createCipheriv('aes-256-gcm', key(secret, salt, SCRYPT), iv);
+  cipher.setAAD(header);
+  const sealed = Buffer.concat([header, cipher.update(plain), cipher.final(), cipher.getAuthTag()]);
+  // До отправки убеждаемся, что архив открывается тем же паролем и даёт ту же копию.
+  if (!unseal(sealed, secret).equals(plain)) throw new UserError('Проверка зашифрованного архива не прошла.');
+  fs.writeFileSync(output, sealed, { mode: 0o600, flag: 'wx' });
+}
+
+// Пароль приходит через стандартный ввод: из secrets/offsite-password или с клавиатуры (offsite-open.sh).
+function open(archive, output) {
+  regularFile(archive);
+  const plain = unseal(fs.readFileSync(archive), password(fs.readFileSync(0, 'utf8')));
+  let database;
+  try { database = zlib.gunzipSync(plain, { maxOutputLength: MAX_DATABASE }); }
+  catch { throw new UserError('Архив расшифрован, но копия внутри повреждена.'); }
+  const temporary = `${output}.part`;
+  fs.writeFileSync(temporary, database, { mode: 0o600, flag: 'wx' });
+  try {
+    integrity(temporary);
+    // Готовый файл не перезаписываем: ссылка не создаётся, если такое имя уже есть.
+    fs.linkSync(temporary, output);
+  } finally { fs.rmSync(temporary, { force: true }); }
+}
+
+function attachmentId(response) {
+  let id;
+  try { id = JSON.parse(fs.readFileSync(response, 'utf8')).id; } catch { id = undefined; }
+  if (typeof id === 'number') id = String(id);
+  if (typeof id !== 'string' || !/^[A-Za-z0-9_/-]{1,100}$/.test(id)) throw new UserError('Трекер вернул непонятный ответ на загрузку файла.');
+  console.log(id);
+}
+
+function commentBody(archive, name, id) {
+  regularFile(archive);
+  if (!ARCHIVE_NAME.test(name) || !/^[A-Za-z0-9_/-]{1,100}$/.test(id ?? '')) throw new UserError('Неверное имя архива или номер вложения.');
+  const data = fs.readFileSync(archive);
+  const time = new Intl.DateTimeFormat('ru-RU', { timeZone: 'Asia/Tashkent', dateStyle: 'short', timeStyle: 'short' }).format(new Date());
+  const text = [
+    `Резервная копия План Факт MVP: ${name}`,
+    `Создана ${time} по Ташкенту. Архив зашифрован паролем копий стенда.`,
+    `Размер: ${data.length} байт. SHA-256: ${crypto.createHash('sha256').update(data).digest('hex')}`,
+    'Как открыть: скачать файл и выполнить на стенде bin/offsite-open.sh <файл>, затем bin/restore.sh <расшифрованный файл>.'
+  ].join('\n');
+  process.stdout.write(JSON.stringify({ text, attachmentIds: [id] }));
+}
+
+const [command, ...args] = process.argv.slice(2);
+const commands = { seal: [seal, 3], open: [open, 2], 'attachment-id': [attachmentId, 1], 'comment-body': [commentBody, 3] };
+try {
+  const [handler, count] = commands[command] ?? [];
+  if (!handler || args.length !== count) throw new UserError('Неизвестная команда копии в Трекер.');
+  handler(...args);
+} catch (error) {
+  // Не печатаем содержимое базы, SQL и произвольные сообщения SQLite.
+  console.error(`Ошибка: ${error instanceof UserError ? error.message : (error.code || 'ошибка SQLite или файлов')}`);
+  process.exitCode = 1;
+}
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-backup.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-backup.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-backup.sh
@@ -0,0 +1,65 @@
+#!/bin/bash
+# Копия в Трекер: свежая проверенная копия базы сжимается, шифруется паролем копий и прикладывается комментарием
+# к тикету PLAN_FACT_OFFSITE_ISSUE. Запускается таймером ru.planfact.mvp.offsite.timer (23:59 по Ташкенту)
+# и пробно — из enable-offsite-backup.sh. Сетевые сбои повторяет: по умолчанию 3 попытки с паузой 5 минут.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=offsite-common.sh
+. "$SCRIPT_DIR/offsite-common.sh"
+
+WORK=''
+FINISHED=false
+finish_offsite() {
+  local result=$?
+  # bash 3.2 после ошибки «unbound variable» передаёт ловушке код 0: успех — только если скрипт дошёл до конца.
+  [ "$FINISHED" = true ] || [ "$result" -ne 0 ] || result=1
+  [ -z "$WORK" ] || rm -rf -- "$WORK"
+  release_data_lock
+  if [ "$result" -ne 0 ]; then
+    maintenance_log offsite.log "Копия в Трекер не отправлена (код $result)." || true
+  fi
+  exit "$result"
+}
+trap finish_offsite EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+[ "$#" -eq 0 ] || fail 'Использование: offsite-backup.sh'
+load_offsite_config
+ATTEMPTS=${PLANFACT_OFFSITE_ATTEMPTS:-3}
+PAUSE=${PLANFACT_OFFSITE_RETRY_SECONDS:-300}
+[[ "$ATTEMPTS" =~ ^[1-9]$ ]] || ATTEMPTS=3
+[[ "$PAUSE" =~ ^[0-9]{1,4}$ ]] || PAUSE=300
+[ -f "$PLAN_FACT_DATABASE" ] && [ ! -L "$PLAN_FACT_DATABASE" ] || fail 'Базы ещё нет: отправлять нечего.'
+
+# Свежая копия — под общей блокировкой резервного копирования, как в backup.sh; дальше работаем с её отдельной копией.
+acquire_data_lock
+NODE_NO_WARNINGS=1 "$PLAN_FACT_NODE_BIN" --experimental-sqlite "$SCRIPT_DIR/backup-store.mjs" backup "$STAND" >/dev/null
+latest=''
+for file in "$STAND/backups/hourly/"plan-fact-*.sqlite; do
+  [ -f "$file" ] && [ ! -L "$file" ] || continue
+  latest=$file
+done
+[ -n "$latest" ] || fail 'Свежая резервная копия не найдена.'
+WORK=$(mktemp -d "$STAND/backups/.offsite-XXXXXX")
+cp -- "$latest" "$WORK/snapshot.sqlite"
+release_data_lock
+
+name=$(basename -- "$latest" .sqlite).pfbak
+offsite_node seal "$WORK/snapshot.sqlite" "$WORK/$name" "$OFFSITE_PASSWORD_FILE"
+rm -f -- "$WORK/snapshot.sqlite"
+offsite_say "Копия $name зашифрована и проверена. Отправляю в ${PLAN_FACT_OFFSITE_ISSUE}…"
+attempt=1
+until offsite_upload "$WORK/$name" "$name" "$WORK"; do
+  if [ "$OFFSITE_TRANSIENT" != true ] || [ "$attempt" -ge "$ATTEMPTS" ]; then
+    fail "$OFFSITE_ERROR"
+  fi
+  offsite_say "Попытка $attempt из $ATTEMPTS не удалась. $OFFSITE_ERROR Повтор через $PAUSE с."
+  sleep "$PAUSE"
+  attempt=$((attempt + 1))
+done
+ordinary_or_missing "$OFFSITE_STATE"
+printf '%s %s %s\n' "$(date +%s)" "$(date '+%d.%m.%Y %H:%M')" "$name" > "$OFFSITE_STATE"
+chmod 600 "$OFFSITE_STATE"
+offsite_say "Готово: копия $name приложена к $PLAN_FACT_OFFSITE_ISSUE."
+FINISHED=true
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-common.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-common.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-common.sh
@@ -0,0 +1,104 @@
+#!/bin/bash
+# Копия в Трекер (задача 36): раз в сутки свежая проверенная копия базы шифруется паролем копий и прикладывается
+# комментарием к тикету PLAN_FACT_OFFSITE_ISSUE. Токен Трекера и пароль копий лежат в secrets/ стенда (папка 700,
+# файлы 600); вводит их владелец через bin/enable-offsite-backup.sh. Скрипты значения не печатают и не передают
+# в командной строке (её видят другие процессы): токен уходит в curl через стандартный ввод.
+set -euo pipefail
+umask 077
+OFFSITE_COMMON_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=maintenance-common.sh
+. "$OFFSITE_COMMON_DIR/maintenance-common.sh"
+
+OFFSITE_LABEL=$(stand_label offsite)
+# Метка «копия в Трекер включена»: по ней start.sh и повторная установка возвращают таймер в работу.
+OFFSITE_FLAG="$SERVICE_DIR/.offsite-enabled"
+OFFSITE_SECRETS="$STAND/secrets"
+OFFSITE_TOKEN_FILE="$OFFSITE_SECRETS/tracker-token"
+OFFSITE_PASSWORD_FILE="$OFFSITE_SECRETS/offsite-password"
+# Последняя успешная отправка: секунды, дата, время и имя архива (секретов нет).
+OFFSITE_STATE="$STAND/backups/.offsite-last"
+OFFSITE_API=https://st-api.yandex-team.ru/v2
+# Токен — одна строка без пробелов и кавычек. Больше 255 повторов регулярные выражения bash на macOS не принимают.
+OFFSITE_TOKEN_PATTERN='^[A-Za-z0-9._-]{16,255}$'
+
+offsite_say() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
+offsite_node() { NODE_NO_WARNINGS=1 "$PLAN_FACT_NODE_BIN" --experimental-sqlite "$OFFSITE_COMMON_DIR/offsite-backup.mjs" "$@"; }
+valid_issue() { [[ "$1" =~ ^[A-Z][A-Z0-9]{1,30}-[1-9][0-9]{0,9}$ ]]; }
+
+# Секрет — непустой обычный файл (не ссылка) этого пользователя с правами 600.
+secret_file_ok() {
+  [ -f "$1" ] && [ ! -L "$1" ] && [ -s "$1" ] || return 1
+  [ "$(file_mode "$1")" = 600 ] || return 1
+  "$PLAN_FACT_NODE_BIN" -e 'process.exit(require("node:fs").lstatSync(process.argv[1]).uid === process.getuid() ? 0 : 1)' "$1"
+}
+
+require_secret() {
+  local file=$1 title=$2
+  [ -d "$OFFSITE_SECRETS" ] && [ ! -L "$OFFSITE_SECRETS" ] && [ "$(file_mode "$OFFSITE_SECRETS")" = 700 ] \
+    || fail 'Папка secrets стенда должна существовать и иметь права 700. Включите копию в Трекер: bin/enable-offsite-backup.sh <тикет>.'
+  secret_file_ok "$file" || fail "$title: нужен обычный файл $file с правами 600. Введите его заново: bin/enable-offsite-backup.sh <тикет>."
+}
+
+load_offsite_config() {
+  load_stand_config
+  valid_issue "${PLAN_FACT_OFFSITE_ISSUE:-}" \
+    || fail 'В config.env не задан тикет для копий (PLAN_FACT_OFFSITE_ISSUE). Включите копию в Трекер: bin/enable-offsite-backup.sh <тикет>.'
+  command -v curl >/dev/null 2>&1 || fail 'Не найдена команда curl.'
+  if [ -n "${PLAN_FACT_OFFSITE_CA_FILE:-}" ]; then
+    [ -f "$PLAN_FACT_OFFSITE_CA_FILE" ] || fail 'Файл сертификата из PLAN_FACT_OFFSITE_CA_FILE не найден.'
+  fi
+  require_secret "$OFFSITE_TOKEN_FILE" 'Токен Трекера'
+  require_secret "$OFFSITE_PASSWORD_FILE" 'Пароль копий'
+}
+
+# Запрос к API Трекера: ответ — в файл $1, код HTTP — в OFFSITE_HTTP_CODE, код завершения curl — в OFFSITE_CURL_STATUS.
+# Заголовок с токеном curl читает из стандартного ввода (--config -), поэтому токена нет среди аргументов процесса.
+tracker_curl() {
+  local output=$1 token=''
+  shift
+  IFS= read -r token < "$OFFSITE_TOKEN_FILE" || true
+  [[ "$token" =~ $OFFSITE_TOKEN_PATTERN ]] \
+    || fail "Токен Трекера в secrets/tracker-token имеет неверный вид. Введите его заново: bin/enable-offsite-backup.sh --replace-token ${PLAN_FACT_OFFSITE_ISSUE:-<тикет>}."
+  OFFSITE_CURL_STATUS=0
+  OFFSITE_HTTP_CODE=$(printf 'header = "Authorization: OAuth %s"\n' "$token" \
+    | curl --config - --noproxy '*' --silent --connect-timeout 20 --max-time 900 \
+      ${PLAN_FACT_OFFSITE_CA_FILE:+--cacert "$PLAN_FACT_OFFSITE_CA_FILE"} \
+      --output "$output" --write-out '%{http_code}' "$@" 2>/dev/null) || OFFSITE_CURL_STATUS=$?
+  token=''
+}
+
+# Понятное объяснение сбоя шага $1 — в OFFSITE_ERROR; OFFSITE_TRANSIENT=true, если повтор может помочь.
+offsite_explain() {
+  local step=$1
+  OFFSITE_TRANSIENT=false
+  case "$OFFSITE_CURL_STATUS" in
+    0) ;;
+    6) OFFSITE_ERROR="$step: не найден адрес st-api.yandex-team.ru."; OFFSITE_TRANSIENT=true; return ;;
+    7|28) OFFSITE_ERROR="$step: Трекер недоступен по сети (нет соединения или истекло время ожидания)."; OFFSITE_TRANSIENT=true; return ;;
+    35|58|60|77) OFFSITE_ERROR="$step: сертификат Трекера не принят. Нужен внутренний корневой сертификат Яндекса (PLAN_FACT_OFFSITE_CA_FILE в config.env)."; return ;;
+    *) OFFSITE_ERROR="$step: сбой соединения с Трекером (код curl $OFFSITE_CURL_STATUS)."; OFFSITE_TRANSIENT=true; return ;;
+  esac
+  case "$OFFSITE_HTTP_CODE" in
+    401) OFFSITE_ERROR="$step: Трекер не принял токен — он неверный или просрочен. Введите новый: bin/enable-offsite-backup.sh --replace-token $PLAN_FACT_OFFSITE_ISSUE." ;;
+    403) OFFSITE_ERROR="$step: у владельца токена нет прав на тикет $PLAN_FACT_OFFSITE_ISSUE." ;;
+    404) OFFSITE_ERROR="$step: тикет $PLAN_FACT_OFFSITE_ISSUE не найден или не виден владельцу токена." ;;
+    413) OFFSITE_ERROR="$step: файл слишком большой для Трекера." ;;
+    429|5??) OFFSITE_ERROR="$step: Трекер временно не отвечает (код $OFFSITE_HTTP_CODE)."; OFFSITE_TRANSIENT=true ;;
+    *) OFFSITE_ERROR="$step: неожиданный ответ Трекера (код $OFFSITE_HTTP_CODE)." ;;
+  esac
+}
+
+# Загружает архив $1 под именем $2 и прикладывает его комментарием к тикету. Рабочие файлы — в папке $3.
+offsite_upload() {
+  local file=$1 name=$2 work=$3 id
+  OFFSITE_TRANSIENT=false
+  OFFSITE_ERROR=''
+  tracker_curl "$work/attachment.json" -X POST -F "file=@$file;filename=$name;type=application/octet-stream" \
+    "$OFFSITE_API/attachments?filename=$name"
+  case "$OFFSITE_HTTP_CODE" in 200|201) ;; *) offsite_explain 'Загрузка файла'; return 1 ;; esac
+  id=$(offsite_node attachment-id "$work/attachment.json") || { OFFSITE_ERROR='Трекер вернул непонятный ответ на загрузку файла.'; return 1; }
+  offsite_node comment-body "$file" "$name" "$id" > "$work/comment.json" || { OFFSITE_ERROR='Не удалось подготовить комментарий.'; return 1; }
+  tracker_curl "$work/comment-response.json" -X POST -H 'Content-Type: application/json' --data-binary "@$work/comment.json" \
+    "$OFFSITE_API/issues/$PLAN_FACT_OFFSITE_ISSUE/comments?isAddToFollowers=false"
+  case "$OFFSITE_HTTP_CODE" in 200|201) ;; *) offsite_explain 'Комментарий в тикет'; return 1 ;; esac
+}
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-open.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/offsite-open.sh
new file mode 100755
