+"""Завести пользователей по логинам (перенос provision-staff-access из backend/src/cli.js).
+
+Логины берутся из PLAN_FACT_STAFF_SUPERADMINS и PLAN_FACT_STAFF_USERS (через запятую) или из
+параметров --superadmins и --users. Повторный запуск ничего не дублирует.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+from django.core.management.base import BaseCommand
+
+from planfact import access_codes
+from planfact.errors import AppError
+
+
+def staff_login_list(value: str | None) -> list[str]:
+    result: list[str] = []
+    for item in str(value or "").split(","):
+        if item.strip():
+            login = access_codes.normalize_staff_login(item.strip())
+            if login not in result:
+                result.append(login)
+    return result
+
+
+def staff_provisioning_plan(superadmins_text: str | None, users_text: str | None) -> list[dict]:
+    superadmins = staff_login_list(superadmins_text)
+    users = staff_login_list(users_text)
+    if not superadmins and not users:
+        raise AppError("Задайте PLAN_FACT_STAFF_SUPERADMINS и/или PLAN_FACT_STAFF_USERS")
+    overlap = [login for login in users if login in superadmins]
+    if overlap:
+        raise AppError(f"Staff login указан в двух ролях: {', '.join(overlap)}")
+    return [
+        *({"staffLogin": login, "name": login, "role": "superadmin"} for login in superadmins),
+        *({"staffLogin": login, "name": login, "role": "user"} for login in users),
+    ]
+
+
+class Command(BaseCommand):
+    help = "Завести суперадминов и пользователей по логинам"
+
+    def add_arguments(self, parser) -> None:
+        parser.add_argument("--superadmins", default=None, help="логины через запятую")
+        parser.add_argument("--users", default=None, help="логины через запятую")
+
+    def handle(self, *args, **options) -> None:
+        from planfact.runtime import get_service
+
+        try:
+            plan = staff_provisioning_plan(
+                options["superadmins"] if options["superadmins"] is not None else os.environ.get("PLAN_FACT_STAFF_SUPERADMINS"),
+                options["users"] if options["users"] is not None else os.environ.get("PLAN_FACT_STAFF_USERS"),
+            )
+            results = get_service().provision_staff_accounts(plan)
+        except AppError as error:
+            sys.stderr.write(f"{error.message}\n")
+            sys.exit(1)
+        for result in results:
+            account = result["account"]
+            self.stdout.write(f"{'Создан' if result['created'] else 'Уже настроен'} {account['role']}: {account['staffLogin']}")
+        created = len([item for item in results if item["created"]])
+        self.stdout.write(f"Provisioning завершён: создано {created}, уже было {len(results) - created}")
