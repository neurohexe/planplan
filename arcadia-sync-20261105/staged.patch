--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/backend/tests/tirole-source.test.js
@@ -0,0 +1,264 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+const http = require("node:http");
+const { gzipSync } = require("node:zlib");
+const { createTiroleFreshnessProxy, hash } = require("../src/tirole-freshness-proxy.js");
+const { createVerifiedTiroleSource } = require("../src/tirole-source.js");
+const { CorporateRoles } = require("../src/corporate-roles.js");
+
+const snapshot = (revision = "r1", bornDate = 1_700_000_000) => ({
+  revision, born_date: bornDate, tvm: {}, user: { "101": { "/role/admin/": [{}] } }
+});
+const config = { baseUrl: "http://127.0.0.1:18767", selfAlias: "fixture", systemSlug: "fixture-app", localToken: "fixture-local-token" };
+
+async function fixture(t) {
+  let now = 1_800_000_000_000;
+  let mono = 10_000;
+  let body = snapshot();
+  let upstreamReply = () => new Response(JSON.stringify(body));
+  const upstreamCalls = [];
+  const proxy = createTiroleFreshnessProxy({ systemSlug: config.systemSlug, port: 0 }, {
+    clock: () => now, monotonic: () => mono,
+    fetch: async (url, options) => { upstreamCalls.push({ url: String(url), options }); return upstreamReply(); }
+  });
+  await proxy.listen();
+  t.after(() => proxy.close());
+  const source = createVerifiedTiroleSource({ ...config, proxy }, {
+    clock: () => now,
+    fetch: async (url, options) => {
+      assert.equal(String(url), "http://127.0.0.1:18767/v2/roles?self=fixture");
+      assert.equal(options.headers.Authorization, "fixture-local-token");
+      assert.equal(options.redirect, "error");
+      return new Response(JSON.stringify(body));
+    }
+  });
+  return {
+    proxy, source, upstreamCalls, get now() { return now; },
+    get body() { return body; }, set body(value) { body = value; },
+    set upstreamReply(value) { upstreamReply = value; },
+    advance(ms) { now += ms; mono += ms; }, wall(ms) { now += ms; }, monotonic(ms) { mono += ms; },
+    request({ revision, path = "/v1/get_actual_roles?system_slug=fixture-app&lib_version=1.4.2", headers = {}, method = "GET" } = {}) {
+      return fetch(`${proxy.baseUrl}${path}`, { method,
+        headers: { "X-Ya-Service-Ticket": "fixture-service-ticket", ...(revision ? { "If-None-Match": `"${revision}"` } : {}), ...headers } });
+    }
+  };
+}
+
+test("TiroleProxy_OnlyRealUpstreamResponseConfirmsExactSlugAndRawSnapshot", async (t) => {
+  const f = await fixture(t);
+  await assert.rejects(f.source(), { code: "corporate_roles_unavailable" });
+  assert.equal((await f.request()).status, 200);
+  const result = await f.source();
+  assert.deepEqual(result, { body: f.body, systemSlug: "fixture-app", confirmedAt: f.now });
+  const call = f.upstreamCalls[0];
+  assert.equal(call.url, "https://tirole-api.yandex.net/v1/get_actual_roles?system_slug=fixture-app&lib_version=1.4.2");
+  assert.equal(call.options.headers["X-Ya-Service-Ticket"], "fixture-service-ticket");
+  assert.equal(call.options.headers.Authorization, undefined);
+  assert.equal(call.options.redirect, "error");
+  const confirmedAt = result.confirmedAt;
+  f.advance(30_000);
+  assert.equal((await f.source()).confirmedAt, confirmedAt);
+  f.body.user["101"] = { "/role/member/": [{}] };
+  await assert.rejects(f.source(), { code: "corporate_roles_unavailable" });
+});
+
+test("TiroleProxy_CompressedMetadataBindsDecodedRawBytes_SizeAndHash", async (t) => {
+  const f = await fixture(t);
+  const raw = Buffer.from(JSON.stringify(f.body));
+  const compressed = gzipSync(raw);
+  f.upstreamReply = () => new Response(compressed, { headers: {
+    "X-Tirole-Compression": `1:gzip:${raw.length}:${hash(raw).toUpperCase()}`
+  } });
+  const response = await f.request();
+  assert.equal(response.status, 200);
+  assert.deepEqual(Buffer.from(await response.arrayBuffer()), compressed);
+  assert.equal((await f.source()).body.revision, "r1");
+  f.upstreamReply = () => new Response(compressed, { headers: { "X-Tirole-Compression": `1:gzip:${raw.length + 1}:${hash(raw)}` } });
+  assert.equal((await f.request()).status, 200);
+  await assert.rejects(f.source(), { statusCode: 503 });
+  f.upstreamReply = () => new Response(compressed, { headers: { "X-Tirole-Compression": "2:gzip:10:unknown" } });
+  assert.equal((await f.request()).status, 502);
+  await assert.rejects(f.source(), { statusCode: 503 });
+});
+
+test("TiroleProxy_Upstream304ConfirmsOnlyPreviouslyBoundRevision_ColdStartRequires200", async (t) => {
+  const f = await fixture(t);
+  f.upstreamReply = () => new Response(null, { status: 304 });
+  assert.equal((await f.request()).status, 502);
+  await assert.rejects(f.source(), { statusCode: 503 });
+  assert.equal((await f.request({ revision: "r2" })).status, 502);
+  await assert.rejects(f.source(), { statusCode: 503 });
+  assert.equal((await f.request({ revision: "r1" })).status, 502);
+  assert.equal(f.upstreamCalls.at(-1).options.headers["If-None-Match"], undefined);
+  f.upstreamReply = () => new Response(JSON.stringify(f.body));
+  assert.equal((await f.request({ revision: "r1" })).status, 200);
+  const previous = (await f.source()).confirmedAt;
+  f.advance(90_000);
+  assert.equal((await f.source()).confirmedAt, previous);
+  f.upstreamReply = () => new Response(null, { status: 304 });
+  assert.equal((await f.request({ revision: "r1" })).status, 304);
+  assert.equal(f.upstreamCalls.at(-1).options.headers["If-None-Match"], '"r1"');
+  assert.equal((await f.source()).confirmedAt, f.now);
+  f.body.user["101"] = { "/role/member/": [{}] };
+  await assert.rejects(f.source(), { statusCode: 503 });
+});
+
+test("TiroleProxy_TenMinuteBoundarySleepAndClockRollbackFailClosed", async (t) => {
+  for (const moveClock of ["advance", "monotonic", "wall"]) {
+    const f = await fixture(t);
+    await f.request();
+    await f.source();
+    f[moveClock](600_000);
+    await f.source();
+    f[moveClock](1);
+    await assert.rejects(f.source(), { statusCode: 503 });
+  }
+  for (const moveClock of ["wall", "monotonic"]) {
+    const f = await fixture(t);
+    await f.request();
+    await f.source();
+    f[moveClock](-1);
+    await assert.rejects(f.source(), { statusCode: 503 });
+  }
+});
+
+test("TiroleProxy_RestartRequiresNewUpstreamProofAndRejectsCacheRollback", async (t) => {
+  const f = await fixture(t);
+  await f.request();
+  await f.source();
+  f.advance(1_000);
+  f.body = snapshot("r2", 1_700_000_001);
+  await f.request();
+  await f.source();
+  f.body = snapshot("r1");
+  await f.request();
+  await assert.rejects(f.source(), { statusCode: 503 });
+  // Even increasing born_date cannot make a previously superseded revision new.
+  f.body = snapshot("r1", 1_700_000_002);
+  await f.request();
+  await assert.rejects(f.source(), { statusCode: 503 });
+  await f.proxy.close();
+  await f.proxy.listen();
+  await assert.rejects(f.source(), { statusCode: 503 });
+});
+
+test("TiroleProxy_NetworkErrorsRedirectsAndOversizeInvalidateOldProofWithoutSecrets", async (t) => {
+  const f = await fixture(t);
+  for (const reply of [
+    () => { throw new Error("fixture-service-ticket fixture-local-token"); },
+    () => new Response("fixture-service-ticket", { status: 401 }),
+    () => new Response("fixture-service-ticket", { status: 302 }),
+    () => new Response("{}", { headers: { "Content-Length": "2097153" } }),
+    () => new Response("x".repeat(2097153))
+  ]) {
+    f.upstreamReply = () => new Response(JSON.stringify(f.body));
+    await f.request();
+    await f.source();
+    f.upstreamReply = reply;
+    const response = await f.request();
+    assert.equal(response.status, 502);
+    assert.equal(await response.text(), '{"error":"roles_upstream_unavailable"}');
+    await assert.rejects(f.source(), (error) => error.statusCode === 503 && !error.message.includes("fixture"));
+  }
+});
+
+test("TiroleProxy_DoesNotForwardOtherSlugsPathsCredentialsOrBrowserRequests", async (t) => {
+  const f = await fixture(t);
+  for (const options of [
+    { path: "/v1/get_actual_roles?system_slug=another-app&lib_version=1.4.2" },
+    { path: "/v1/get_actual_roles?system_slug=fixture-app&system_slug=another-app&lib_version=1.4.2" },
+    { path: "/v1/get_actual_roles?system_slug=fixture-app&lib_version=1.4.2&other=x" },
+    { path: "/ping" }, { method: "POST" },
+    { headers: { Origin: "https://example.test" } },
+    { headers: { Cookie: "fixture-cookie" } },
+    { headers: { Authorization: "fixture-local-token" } },
+    { headers: { "X-Ya-Service-Ticket": "" } },
+    { headers: { "If-None-Match": 'W/"r1"' } }
+  ]) {
+    assert.ok((await f.request(options)).status >= 400, JSON.stringify(options));
+  }
+  // fetch overwrites Host; use the raw HTTP client to test the actual header.
+  await new Promise((resolve, reject) => {
+    http.get(`${f.proxy.baseUrl}/v1/get_actual_roles?system_slug=fixture-app&lib_version=1.4.2`, {
+      headers: { Host: "example.test", "X-Ya-Service-Ticket": "fixture-service-ticket" }
+    }, (response) => {
+      response.resume();
+      response.on("end", () => { assert.equal(response.statusCode, 400); resolve(); });
+    }).on("error", reject);
+  });
+  assert.equal(f.upstreamCalls.length, 0);
+  await assert.rejects(f.source(), { statusCode: 503 });
+});
+
+test("TiroleProxy_ConcurrentOlderSuccessCannotOverwriteNewerFailureOrProof", async (t) => {
+  const f = await fixture(t);
+  let resolveFirst;
+  let started;
+  const firstStarted = new Promise((resolve) => { started = resolve; });
+  f.upstreamReply = () => { started(); return new Promise((resolve) => { resolveFirst = resolve; }); };
+  const first = f.request();
+  await firstStarted;
+  f.upstreamReply = () => new Response(null, { status: 503 });
+  assert.equal((await f.request()).status, 502);
+  resolveFirst(new Response(JSON.stringify(f.body)));
+  assert.equal((await first).status, 502);
+  await assert.rejects(f.source(), { statusCode: 503 });
+});
+
+test("TiroleSource_ClosedSnapshotInvalidatesCorporateRolesAndNotifiesSessions", async (t) => {
+  const f = await fixture(t);
+  const roles = new CorporateRoles({ systemSlug: config.systemSlug, source: f.source, clock: () => f.now });
+  const notifications = [];
+  roles.subscribe(({ available }) => notifications.push(available));
+  await f.request();
+  await roles.refresh();
+  assert.equal(roles.roleFor("101"), "admin");
+  f.advance(1_000);
+  f.body = { ...snapshot("r2", 1_700_000_001), user: {} };
+  await f.request();
+  await roles.refresh();
+  assert.equal(roles.roleFor("101"), null);
+  f.upstreamReply = () => { throw new Error("offline"); };
+  await f.request();
+  await assert.rejects(roles.refresh(), { statusCode: 503 });
+  assert.throws(() => roles.roleFor("101"), { statusCode: 503 });
+  assert.deepEqual(notifications, [true, true, false]);
+});
+
+test("TiroleSource_ActualWireFormatAllowsAbsentEmptyMaps_ButNotMalformedMaps", async (t) => {
+  const f = await fixture(t);
+  delete f.body.tvm;
+  await f.request();
+  assert.deepEqual((await f.source()).body, { ...f.body, tvm: {} });
+  f.body = { revision: "r2", born_date: 1_700_000_001 };
+  await f.request();
+  assert.deepEqual((await f.source()).body, { ...f.body, tvm: {}, user: {} });
+  for (const field of ["user", "tvm"]) {
+    for (const value of [null, [], "bad"]) {
+      f.body = { revision: "r3", born_date: 1_700_000_002, [field]: value };
+      await f.request();
+      await assert.rejects(f.source(), { statusCode: 503 });
+    }
+  }
+});
+
+test("TiroleSource_RejectsUntrustedAddressWrongBindingAndBadLocalResponses", async (t) => {
+  const f = await fixture(t);
+  for (const change of [
+    { baseUrl: "https://example.test" }, { baseUrl: "http://localhost:18767" },
+    { baseUrl: "http://127.0.0.1.evil.test" }, { baseUrl: "http://user@127.0.0.1:18767" },
+    { baseUrl: "http://127.0.0.1:18767/path" }, { systemSlug: "another-app" },
+    { localToken: "" }, { localToken: "fixture\r\ntoken" }
+  ]) assert.throws(() => createVerifiedTiroleSource({ ...config, proxy: f.proxy, ...change }));
+  await f.request();
+  for (const reply of [
+    () => new Response(null, { status: 304 }), () => new Response(null, { status: 302 }),
+    () => new Response("fixture-local-token"), () => { throw new Error("fixture-local-token"); },
+    () => new Response(JSON.stringify({ ...f.body, user: null }))
+  ]) {
+    const source = createVerifiedTiroleSource({ ...config, proxy: f.proxy }, { fetch: reply });
+    await assert.rejects(source(), (error) => error.statusCode === 503 && !error.message.includes("fixture"));
+  }
+});
