+    PLAN_FACT_IDM_REQUEST_URL: "https://idm.yandex-team.ru/system/fixture-app" }), port: 0 };
+  let now = Date.now();
+  let verification = "ok";
+  const calls = [];
+  const adapter = new WebAuthCorporateAdapter({ publicUrl: origin, clock: () => now, fetchFn: async (url, options) => {
+    calls.push({ path: url.pathname, headers: options.headers });
+    if (url.pathname === "/save_oauth_token") return new Response(null, { status: 302, headers: {
