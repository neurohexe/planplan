+#!/bin/bash
+# Задача 13, шаг 6 на НОВОМ компьютере: распаковка архива переезда и восстановление стенда.
+# Берёт архив planfact-move-….tar.gz.enc из домашней папки (или путь из аргумента), сверяет контрольную сумму
+# из .sha256 рядом, спрашивает пароль, проверяет состав архива и после «да» владельца:
+#   1) восстанавливает базу штатным bin/restore.sh (нынешняя база сохраняется в backups/before-restore-…);
+#   2) кладёт папку codes с правами 700/600 (нынешние коды — в backups/codes-before-move-…);
+#   3) запускает стенд (bin/start.sh), показывает bin/status.sh и проверяет /api/ready;
+#   4) удаляет использованный архив и его .sha256.
+# Туннель не включает: это отдельный шаг bin/enable-tunnel.sh. Имена и содержимое кодов не печатает.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=move-common.sh
+. "$SCRIPT_DIR/move-common.sh"
+[ "$#" -le 1 ] || fail 'Использование: unpack.sh [файл архива]'
+
+WORK=''
+finish() {
+  local result=$?
+  MOVE_PASSWORD=''
+  [ -z "$WORK" ] || rm -rf -- "$WORK"
+  exit "$result"
+}
+trap finish EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+
+move_stand
+move_config
+for script in restore.sh start.sh status.sh; do
+  [ -x "$STAND/bin/$script" ] || fail "Не найден bin/$script стенда. Сначала обновите стенд: deploy/move/prepare-new.sh."
+done
+move_require_tunnel_off 'Туннель на этом стенде включён. Сначала выполните bin/disable-tunnel.sh на этом компьютере.'
+
+if [ "$#" -eq 1 ]; then
+  ARCHIVE=$1
+  case "$ARCHIVE" in /*) ;; *) ARCHIVE="$PWD/$ARCHIVE" ;; esac
+else
+  ARCHIVE=''
+  found=0
+  for file in "$HOME"/$MOVE_ARCHIVE_PATTERN; do
+    [ -f "$file" ] || continue
+    ARCHIVE=$file
+    found=$((found + 1))
+  done
+  [ "$found" -gt 0 ] || fail 'В домашней папке нет архива planfact-move-….tar.gz.enc. Скопируйте с флешки в домашнюю папку оба файла: .tar.gz.enc и .sha256.'
+  [ "$found" -eq 1 ] || fail 'В домашней папке несколько архивов planfact-move-…. Оставьте только последний (с его .sha256) или укажите путь к архиву после команды.'
+fi
+case "$(basename -- "$ARCHIVE")" in
+  planfact-move-*.tar.gz.enc) ;;
+  *) fail 'Ожидался файл архива переезда planfact-move-….tar.gz.enc.' ;;
+esac
+[ -f "$ARCHIVE" ] && [ ! -L "$ARCHIVE" ] || fail "Не найден файл архива $ARCHIVE."
+SUMS="${ARCHIVE%.tar.gz.enc}.sha256"
+[ -f "$SUMS" ] && [ ! -L "$SUMS" ] || fail "Рядом с архивом нет файла $(basename -- "$SUMS"). Скопируйте с флешки оба файла."
+expected=''
+expected_name=''
+read -r expected expected_name < "$SUMS" || true
+[[ "$expected" =~ ^[0-9a-f]{64}$ ]] && [ "$expected_name" = "$(basename -- "$ARCHIVE")" ] \
+  || fail "Файл $(basename -- "$SUMS") не подходит к этому архиву."
+
+move_private_directory "$STAND/backups"
+WORK=$(mktemp -d "$STAND/backups/.move-unpack.XXXXXX")
+# Дальше работаем с собственной копией архива: подмена файла после проверки суммы ничего не изменит.
+cp -- "$ARCHIVE" "$WORK/archive.enc"
+[ "$(move_sha256 "$WORK/archive.enc")" = "$expected" ] \
+  || fail 'Контрольная сумма не совпала: архив повреждён при переносе. Скопируйте его с флешки заново. Ничего не изменено.'
+say "Архив найден: $ARCHIVE"
+say 'Контрольная сумма совпала: архив дошёл без повреждений.'
+
+move_read_password existing
+if ! move_decrypt "$WORK/archive.enc" 2> "$WORK/openssl.log" | tar -t -z -f - > "$WORK/names.txt" 2> "$WORK/tar.log" \
+  || ! move_decrypt "$WORK/archive.enc" 2> "$WORK/openssl.log" | tar -t -v -z -f - > "$WORK/types.txt" 2> "$WORK/tar.log"; then
+  fail 'Пароль не подходит или архив повреждён. Ничего не изменено — запустите команду ещё раз.'
+fi
+CONTENT=$(move_node check-archive "$WORK/names.txt" "$WORK/types.txt")
+SNAPSHOT=${CONTENT% *}
+CODES_COUNT=${CONTENT#* }
+mkdir -m 700 "$WORK/files"
+if ! move_decrypt "$WORK/archive.enc" 2> "$WORK/openssl.log" | tar -x -z -f - -C "$WORK/files" 2> "$WORK/tar.log"; then
+  fail 'Не удалось распаковать архив. Ничего не изменено.'
+fi
+MOVE_PASSWORD=''
+DETAILS=$(move_node check-tree "$WORK/files" "$SNAPSHOT" "$CODES_COUNT")
+REVISION=${DETAILS%% *}
+rest=${DETAILS#* }
+USERS=${rest%% *}
+COPY_TIME=${rest#* }
+
+say ''
+say "Архив открыт и проверен: копия базы от $COPY_TIME — ревизия данных $REVISION, пользователей $USERS; личных кодов: $CODES_COUNT."
+say 'Сейчас на этом компьютере:'
+say '  1) база стенда будет заменена базой из архива (нынешняя сохранится в backups/before-restore-…);'
+say '  2) папка codes будет заменена кодами из архива (нынешняя сохранится в backups/codes-before-move-…);'
+say '  3) стенд будет запущен и проверен. Туннель не включается.'
+printf 'Продолжить? Введите «да»: '
+answer=''
+read -r answer || true
+if [ "$answer" != да ]; then
+  say 'Переезд отменён. Ничего не изменено.'
+  exit 0
+fi
+
+"$STAND/bin/restore.sh" "$WORK/files/$SNAPSHOT" --yes < /dev/null
+SAVED_CODES="$STAND/backups/codes-before-move-$(date +%Y%m%d-%H%M%S)"
+if [ -e "$CODES" ]; then
+  mv -- "$CODES" "$SAVED_CODES"
+  chmod 700 "$SAVED_CODES"
+fi
+mv -- "$WORK/files/codes" "$CODES"
+chmod 700 "$CODES"
+find "$CODES" -type f -exec chmod 600 {} +
+rm -rf -- "$WORK"
+WORK=''
+say "Коды разложены (файлов: $CODES_COUNT): папка codes — права 700, файлы — 600."
+
+if move_test_install; then
+  say 'Проверочная установка без автозапуска: службы не запускаются, сервер уже поднят восстановлением.'
+else
+  "$STAND/bin/start.sh" < /dev/null
+fi
+code=000
+for _ in $(seq 1 30); do
+  code=$(move_ready_code)
+  [ "$code" != 200 ] || break
+  sleep 1
+done
+say ''
+"$STAND/bin/status.sh" < /dev/null || true
+say ''
+[ "$code" = 200 ] || fail "Стенд не ответил на /api/ready (код $code). Пришлите Стефании этот вывод. Старый компьютер не трогайте: его база цела."
+if LIVE=$(move_node summary "$PLAN_FACT_DATABASE"); then
+  say "Проверка: /api/ready — 200; в базе стенда ревизия данных ${LIVE% *}, пользователей ${LIVE#* }."
+else
+  say 'Проверка: /api/ready — 200. Сводку по базе прочитать не удалось — это не мешает работе стенда.'
+fi
+
+if rm -f -- "$ARCHIVE" "$SUMS" 2> /dev/null; then
+  say "Использованный архив удалён: $ARCHIVE"
+else
+  say "Не удалось удалить архив $ARCHIVE — удалите его вручную."
+fi
+say 'Удалите оба файла planfact-move-… и с флешки.'
+say "Следующий шаг — включить туннель: bash $STAND/bin/enable-tunnel.sh"
