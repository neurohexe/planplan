+"use strict";
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+const { WebAuthCorporateAdapter, WEBAUTH_CALLBACK_PATH } = require("../src/webauth-corporate-adapter.js");
+const { CorporateLoginFlow } = require("../src/corporate-login.js");
+
+const origin = "https://plan-fact.example.test";
+const state = "https%3A%2F%2Fplan-fact.example.test%2F:fictional-proof";
+const credential = "fictional-encrypted-corporate-cookie";
+function challenge() {
+  return new Response(null, { status: 401, headers: {
+    "Webauth-Csrf-State": encodeURIComponent(state), "Webauth-Csrf-Token": "fictional-csrf",
+    "Webauth-Oauth-App-Id": "fictional-client"
+  } });
+}
+function saved() {
+  return new Response(null, { status: 302, headers: {
+    Location: `${origin}/`, "Set-Cookie": `webauth_oauth_token=${credential}; Path=/; Secure; HttpOnly; SameSite=None`
+  } });
+}
+function verified(uid = "101") {
+  return new Response(null, { status: 200, headers: { "X-Webauth-Login": "alice", "X-Webauth-Uid": uid } });
+}
+function fixture() {
+  let now = 1_800_000_000_000;
+  const calls = [];
+  const replies = [];
+  const adapter = new WebAuthCorporateAdapter({ publicUrl: origin, clock: () => now, fetchFn: async (url, options) => {
+    calls.push({ url: new URL(url), options });
+    if (!replies.length) throw new Error(`unexpected request ${credential}`);
+    return replies.shift();
+  } });
+  return { adapter, calls, replies, clock: () => now, advance(ms) { now += ms; } };
+}
+async function finish(f) {
+  f.replies.push(challenge(), saved(), verified());
+  const start = await f.adapter.begin({ clientIp: "192.0.2.1" });
+  const url = new URL(WEBAUTH_CALLBACK_PATH, origin);
+  url.searchParams.set("state", start.state);
+  url.searchParams.set("token", "fictional-callback-wrapper");
+  return f.adapter.complete({ url, state: start.state, context: start.context, clientIp: "192.0.2.1" });
+}
+
+test("RealWebAuth_UsesCentralClientAndPreservesStateEncoding", async () => {
+  const f = fixture(); f.replies.push(challenge());
+  const start = await f.adapter.begin({ clientIp: "192.0.2.1" });
+  assert.equal(new URL(start.authorizationUrl).searchParams.get("state"), state);
+  assert.equal(new URL(start.authorizationUrl).searchParams.get("client_id"), "fictional-client");
+  assert.equal(start.state, state);
+  assert.equal(f.calls[0].url.href, "https://webauth.yandex-team.ru/check_oauth_token");
+  assert.equal(f.calls[0].options.headers["Webauth-Retpath"], `${origin}/`);
+  assert.equal(f.calls[0].options.headers["X-Forwarded-For-Y"], "192.0.2.1");
+  assert.equal(f.calls[0].options.headers.Cookie, undefined);
+  assert.equal(f.calls[0].options.redirect, "manual");
+});
+
+test("RealWebAuth_Gateway403AndIncompleteChallengesNeverStartLogin", async () => {
+  for (const response of [new Response("Access denied", { status: 403 }), new Response(null, { status: 401 }), new Response(null, { status: 200 })]) {
+    const f = fixture(); f.replies.push(response);
+    await assert.rejects(f.adapter.begin(), { code: "corporate_identity_unavailable" });
+    assert.equal(f.adapter.diagnostics().status, "unavailable");
+  }
+});
+
+test("RealWebAuth_SaveThenOnlineCheckKeepsCredentialOutOfIdentityAndBrowser", async () => {
+  const f = fixture(); const result = await finish(f);
+  assert.deepEqual(result, { login: "alice", uid: "101", expiresAt: f.clock() + 86_400_000 });
+  assert.equal(f.calls[1].url.pathname, "/save_oauth_token");
+  assert.equal(f.calls[1].url.searchParams.get("state"), state);
+  assert.equal(f.calls[1].options.headers.Cookie, "webauth_csrf_token=fictional-csrf");
+  assert.equal(f.calls[2].url.pathname, "/check_oauth_token");
+  assert.equal(f.calls[2].options.headers.Cookie, `webauth_oauth_token=${credential}`);
+  assert.equal(f.calls[2].options.headers["Webauth-Authorization"], undefined);
+  assert.doesNotMatch(JSON.stringify(result), /cookie|credential|token/);
+  f.adapter.bindSession({ id: "session-a", user: { staff_uid: "101" } }, result);
+  assert.equal(f.adapter.assertVerified("session-a").uid, "101");
+});
+
+test("RealWebAuth_RejectsBadSaveRedirectDuplicateCookiesAndMissingIdentity", async () => {
+  const bad = [
+    new Response(null, { status: 302, headers: { Location: "https://evil.example/", "Set-Cookie": `webauth_oauth_token=${credential}` } }),
+    new Response(null, { status: 200 }),
+    new Response(null, { status: 302, headers: { Location: `${origin}/`, "Set-Cookie": "webauth_oauth_token=" } })
+  ];
+  const duplicate = saved(); duplicate.headers.append("Set-Cookie", "webauth_oauth_token=fictional-other"); bad.push(duplicate);
+  for (const response of bad) {
+    const f = fixture(); f.replies.push(challenge(), response);
+    const start = await f.adapter.begin();
+    const url = new URL(WEBAUTH_CALLBACK_PATH, origin); url.searchParams.set("state", state); url.searchParams.set("token", "fictional-wrapper");
+    await assert.rejects(f.adapter.complete({ url, state, context: start.context }), { code: "corporate_identity_unavailable" });
+  }
+  const f = fixture(); f.replies.push(challenge(), saved(), verified("not-a-corporate-uid"));
+  const start = await f.adapter.begin();
+  const url = new URL(WEBAUTH_CALLBACK_PATH, origin); url.searchParams.set("state", state); url.searchParams.set("token", "fictional-wrapper");
+  await assert.rejects(f.adapter.complete({ url, state, context: start.context }), { code: "corporate_identity_unavailable" });
+});
+
+test("RealWebAuth_RevocationAndRestartDenyAnOtherwiseValidApplicationSession", async () => {
+  const f = fixture(); const result = await finish(f);
+  const session = { id: "session-a", user: { staff_uid: "101" } };
+  f.adapter.bindSession(session, result);
+  f.advance(30_001); f.replies.push(new Response(null, { status: 401 }));
+  await assert.rejects(f.adapter.verifySession(session, { clientIp: "192.0.2.1" }), { code: "corporate_identity_unavailable" });
+  assert.throws(() => f.adapter.assertVerified(session.id));
+  await assert.rejects(fixture().adapter.verifySession(session));
+});
+
+test("RealWebAuth_FlowUsesDocumentedCallbackWithOneTimeBrowserBinding", async () => {
+  const f = fixture();
+  const flow = new CorporateLoginFlow({ publicUrl: origin, callbackPath: WEBAUTH_CALLBACK_PATH, adapter: f.adapter, clock: f.clock });
+  f.replies.push(challenge(), saved(), verified());
+  const start = await flow.begin();
+  const url = new URL(WEBAUTH_CALLBACK_PATH, origin); url.searchParams.set("state", state); url.searchParams.set("token", "fictional-wrapper");
+  const cookie = start.cookie.split(";")[0];
+  const result = await flow.complete(url.href, cookie);
+  const session = { id: "session-a", user: { staff_uid: "101" } };
+  flow.bindSession(session, result);
+  assert.equal(flow.assertVerified(session.id).login, "alice");
+  await assert.rejects(flow.complete(url.href, cookie));
+  flow.forget(session.id); assert.throws(() => flow.assertVerified(session.id));
+});
+
+test("RealWebAuth_ErrorsAndDiagnosticsNeverExposeUpstreamSecrets", async () => {
+  const f = fixture();
+  await assert.rejects(f.adapter.begin(), error => !String(error).includes(credential) && !error.cause);
+  assert.doesNotMatch(JSON.stringify(f.adapter), /fictional|credential/);
+  assert.doesNotMatch(JSON.stringify(f.adapter.diagnostics()), /fictional|credential/);
+});
