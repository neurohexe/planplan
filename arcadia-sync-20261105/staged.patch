+class AccessCodeTests(ServiceTestMixin, TestCase):
+    def test_generated_codes_have_the_crockford_format(self):
+        for _ in range(50):
+            self.assertRegex(access_codes.generate_access_code(), CODE_RE)
+
+    def test_generation_has_no_bias_and_takes_twenty_bytes_in_order(self):
+        with mock.patch.object(access_codes.secrets, "token_bytes", return_value=bytes(range(20))) as source:
+            self.assertEqual(access_codes.generate_access_code(), "01234-56789-ABCDE-FGHJK")
+        source.assert_called_once_with(20)
+        counts: dict[str, int] = {}
+        for start in range(0, 256, 20):
+            chunk = bytes((start + offset) % 256 for offset in range(20))
+            with mock.patch.object(access_codes.secrets, "token_bytes", return_value=chunk):
+                for symbol in access_codes.generate_access_code().replace("-", ""):
+                    counts[symbol] = counts.get(symbol, 0) + 1
+        self.assertEqual(len(counts), 32)
+
+    def test_normalization_ignores_case_spaces_and_hyphens_and_folds_look_alikes(self):
+        self.assertEqual(access_codes.normalize_access_code(" abcde-fghjk mnpqr\tstvwx "), "ABCDEFGHJKMNPQRSTVWX")
+        self.assertEqual(access_codes.normalize_access_code("oOiIlL"), "001111")
+        self.assertEqual(access_codes.normalize_access_code("x" * 100), "X" * 64)
+        self.assertEqual(access_codes.normalize_access_code(None), "")
+
+    def test_issue_stores_only_the_scrypt_hash_with_fresh_salt(self):
+        first = self.service.issue_access_code("alice")["code"]
+        record = AccessCode.objects.get(user_id=self.alice["id"])
+        self.assertRegex(first, CODE_RE)
+        self.assertNotIn(first, record.code_hash + record.salt + record.kdf_params)
+        self.assertEqual(js.loads(record.kdf_params), {"algorithm": "scrypt", "N": 16384, "r": 8, "p": 1, "keylen": 32})
+        self.assertEqual(len(bytes.fromhex(record.salt)), 16)
+        expected = access_codes.derive_key(access_codes.normalize_access_code(first), record.salt, access_codes.KDF).hex()
+        self.assertEqual(record.code_hash, expected)
+        self.service.issue_access_code("alice")
+        self.assertNotEqual(AccessCode.objects.get(user_id=self.alice["id"]).salt, record.salt)
+
+    def test_issue_refuses_unknown_disabled_and_invalid_users(self):
+        with self.assertRaisesMessage(AppError, "Пользователь mallory не найден"):
+            self.service.issue_access_code("mallory")
+        dave = self.service.provision_staff_account(staff_login="dave", name="dave", role="user")["account"]
