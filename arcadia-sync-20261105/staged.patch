+"use strict";
+
+const assert = require("node:assert/strict");
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const path = require("node:path");
+const test = require("node:test");
+
+const projectRoot = path.join(__dirname, "..", "..");
+// Отпечаток сверен 2026-10-07 по трём источникам: crls.yandex.net,
+// цепочка webauth.yandex-team.ru и системное хранилище macOS.
+const YANDEX_INTERNAL_ROOT_CA_SHA256 =
+  "E3:C3:19:26:46:53:6B:C4:FF:AE:6D:D3:43:24:EF:9D:D8:D3:B1:6D:FA:13:A2:4E:13:18:0E:F1:4B:A2:1B:BA";
+
+test("RuntimeTrust_VendoredYandexRootCaIsThePinnedCertificate", () => {
+  const pem = fs.readFileSync(path.join(projectRoot, "deploy", "certs", "YandexInternalRootCA.pem"));
+  const certificate = new crypto.X509Certificate(pem);
+  assert.match(certificate.subject, /CN=YandexInternalRootCA/);
+  assert.equal(certificate.ca, true);
+  assert.equal(certificate.fingerprint256, YANDEX_INTERNAL_ROOT_CA_SHA256);
+  const yearAhead = Date.now() + 365 * 24 * 60 * 60 * 1000;
+  assert.ok(Date.parse(certificate.validTo) > yearAhead, "корневой сертификат истекает меньше чем через год");
+});
+
+test("RuntimeTrust_ImageTrustsYandexRootCaForWebAuth", () => {
+  const dockerfile = fs.readFileSync(path.join(projectRoot, "Dockerfile.deploy"), "utf8");
+  assert.match(dockerfile, /^COPY .*deploy\/certs\/YandexInternalRootCA\.pem \/srv\/plan-fact\/certs\/YandexInternalRootCA\.pem$/m);
+  assert.match(dockerfile, /^ENV NODE_EXTRA_CA_CERTS=\/srv\/plan-fact\/certs\/YandexInternalRootCA\.pem$/m);
+});
