+"use strict";
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+const { createRequire } = require("node:module");
+const test = require("node:test");
+const app = require("../app.js");
+const APP = path.resolve(__dirname, "../app.js");
+const SOURCE = fs.readFileSync(APP, "utf8");
+
+function fixture(revision = 1) {
+  const state = app.applyLocalMutation(app.normalizeState(app.createInitialState()), "addArticle", { id:"p", name:"Учебный проект" });
+  state.revision = revision;
+  state.permissions = { canManageBudget: true, canManageUsers: true, locations: { default: "edit" } };
+  return state;
+}
+function response(status, state) {
+  return { status, ok: status < 400, json: async () => ({ state, user: { id: "alice", name: "Алиса", role: "superadmin" } }) };
+}
+function ui(fetch, accept = false, signalFactory = AbortSignal) {
+  const effects = { calls: [], confirmations: [], renders: 0, statuses: [] };
+  const nodes = new Proxy({}, { get(target, key) {
+    return target[key] ||= { value: "", textContent: "", innerHTML: "typed values", open: false,
+      querySelectorAll: () => [], classList: { add() {}, remove() {}, toggle() {} }, close() { this.open = false; } };
+  } });
+  let id = 0;
+  const context = vm.createContext({
+    require: createRequire(APP), URL, URLSearchParams, AbortSignal: signalFactory, console,
+    crypto: { randomUUID: () => `fixture-attempt-${++id}` },
+    localStorage: { getItem: () => null, setItem() {} },
+    window: { setTimeout: () => 1, clearTimeout() {}, confirm(message) { effects.confirmations.push(message); return accept; } },
+    fetch: async (url, options) => { effects.calls.push({ url, options }); return fetch(url, options); },
+    nodes, effects, initialState: fixture()
+  });
+  vm.runInContext(SOURCE.replace(/\}\)\(\);\s*$/, `
+    sharedMode = true; authMode = 'access-code'; currentUser = {id:'alice', name:'Алиса', role:'superadmin'};
+    state = initialState; selectedLocation = 'default';
+    selectedYear = 2026; selectedQuarter = 4;
+    Object.assign(dom, Object.fromEntries(['expenseDialog','forecastDialog','userAdminDialog','expenseId',
+      'expenseForecastTicketId','expenseFormError','expenseForm','expenseArticle','expenseSubarticle','expenseCurrency',
+      'expenseDate','expenseAmount','expenseTicket','expenseComment','expenseForecastAllocationId','locationNameInput']
+      .map(key => [key,nodes[key]])));
+    renderAll = () => { effects.renders += 1; };
+    showToast = () => {};
+    setSaveStatus = (text) => effects.statuses.push(text);
+    renderBudgetEditControls = () => {};
+    resetExpenseDialogPresentation = () => {};
+    saveSelectedLocation = () => {};
+    expenseForecastContext = () => null;
+    globalThis.page = {
+      mutate, rememberEdit, refreshSharedState, guardSave, saveExpense, closeExpenseDialog, selectLocation,
+      state: () => state, setState: value => { state=value; },
+      lock: value => { activeEditLock=value; }, activeLock: () => activeEditLock,
+      dirtyBudget: () => { budgetEditMode=true; budgetDirty=true; dom.budgetEditorBody=nodes.budgetEditorBody; },
+      renderBudget: renderBudgetEditor,
+      budgetPermission: canManageBudgetClient,
+      stubSave: fn => { mutate=fn; }
+    };
+  })();`), context, { filename: APP });
+  return { page: context.page, nodes, effects };
+}
+
+test("ConcurrentSave_DoubleSubmissionSendsOneMutation", async () => {
+  let finish;
+  const f = ui(() => new Promise(resolve => { finish = resolve; }));
+  const payload = { id: "new", name: "Офис" };
+  const first = f.page.mutate("addLocation", payload);
