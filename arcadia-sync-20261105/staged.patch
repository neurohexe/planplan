+"""Закрытие периодов (месяц / квартал) — перенос app/period-locks.js.
+
+Закрытый период блокирует изменение финансовых данных во всех локациях сразу. Месяц закрывается
+операционно; квартал — только после закрытия всех трёх месяцев и с контрольным снимком.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+from planfact.errors import DomainError
+
+from . import dates
+from .js import S, UNDEF, add, entries, is_dict, is_finite, is_list, js_ceil, js_trim, keys, og, or_, pk, sub, tail, to_number, truthy, uniq
+
+SCHEMA_VERSION = 15
+
+MONTH_KEY_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])\Z")
+QUARTER_KEY_RE = re.compile(r"([0-9]{4})-Q([1-4])\Z")
+_MONTH_PREFIX_RE = re.compile(r"([0-9]{4})-(0[1-9]|1[0-2])")
+
+
+def test(regex: re.Pattern, value: Any) -> bool:
+    """regex.test(value): значение приводится к строке."""
+    return regex.match(S(value)) is not None
+
+
+def quarter_of_month(month_number: Any) -> Any:
+    return js_ceil(to_number(month_number) / 3)
+
+
+def month_key_from_date(iso_date: Any) -> str:
+    match = _MONTH_PREFIX_RE.match(S(or_(iso_date, "")))
+    return f"{match.group(1)}-{match.group(2)}" if match else ""
+
+
+def quarter_key_of_month(month_key: Any) -> str:
+    match = MONTH_KEY_RE.match(S(or_(month_key, "")))
+    if not match:
+        return ""
+    return f"{match.group(1)}-Q{S(quarter_of_month(match.group(2)))}"
+
+
+def quarter_key_from_date(iso_date: Any) -> str:
+    return quarter_key_of_month(month_key_from_date(iso_date))
+
+
+def quarter_months(quarter_key: Any) -> list[str]:
+    match = QUARTER_KEY_RE.match(S(or_(quarter_key, "")))
+    if not match:
+        return []
+    year = to_number(match.group(1))
+    first_month = (to_number(match.group(2)) - 1) * 3 + 1
+    return [f"{S(year)}-{S(first_month + offset).rjust(2, '0')}" for offset in (0, 1, 2)]
+
+
+def ensure_closed_periods(state: Any) -> Any:
+    current = state if truthy(state) else {}
+    if not truthy(current.get("closedPeriods", UNDEF)):
+        current["closedPeriods"] = {}
+    closed = current["closedPeriods"]
+    if not truthy(closed.get("months", UNDEF)):
+        closed["months"] = {}
+    if not truthy(closed.get("quarters", UNDEF)):
+        closed["quarters"] = {}
+    if not is_dict(closed["months"]) and not is_list(closed["months"]):
+        closed["months"] = {}
+    if not is_dict(closed["quarters"]) and not is_list(closed["quarters"]):
+        closed["quarters"] = {}
+    if not is_list(current.get("periodCloseHistory", UNDEF)):
+        current["periodCloseHistory"] = []
+    return current
+
+
+def is_month_closed(state: Any, month_key: Any) -> bool:
+    if not test(MONTH_KEY_RE, or_(month_key, "")):
+        return False
+    entry = og(og(og(state, "closedPeriods"), "months"), pk(month_key))
+    return truthy(entry) and truthy(og(entry, "closedAt"))
+
+
+def is_quarter_closed(state: Any, quarter_key: Any) -> bool:
+    if not test(QUARTER_KEY_RE, or_(quarter_key, "")):
+        return False
+    entry = og(og(og(state, "closedPeriods"), "quarters"), pk(quarter_key))
+    return truthy(entry) and truthy(og(entry, "closedAt"))
+
+
+def quarter_status(state: Any, quarter_key: Any) -> str:
+    if not test(QUARTER_KEY_RE, or_(quarter_key, "")):
+        return "open"
+    if is_quarter_closed(state, quarter_key):
+        return "closed"
+    months = quarter_months(quarter_key)
+    closed_count = len([month for month in months if is_month_closed(state, month)])
+    return "ready_to_close" if closed_count == len(months) else "open"
+
+
+def expense_month_key(expense: Any) -> str:
+    if not truthy(expense) or not truthy(og(expense, "expenseDate")):
+        return ""
+    return month_key_from_date(og(expense, "expenseDate"))
+
+
+def forecast_allocation_month_key(allocation: Any) -> str:
+    return month_key_from_date(og(allocation, "expectedDate"))
+
+
+def forecast_allocation_quarter_key(allocation: Any) -> str:
+    quarter = og(allocation, "quarterKey")
+    if truthy(quarter) and test(QUARTER_KEY_RE, quarter):
+        return quarter
+    return quarter_key_of_month(forecast_allocation_month_key(allocation))
+
+
+def forecast_allocations(state: Any) -> list[tuple[Any, Any]]:
+    result = []
+    for ticket in or_(og(state, "forecastTickets"), []):
+        for allocation in or_(og(ticket, "allocations"), []):
+            result.append((ticket, allocation))
+    return result
+
+
+def unresolved_forecast_allocations(state: Any, period_key: Any, level: str) -> list[tuple[Any, Any]]:
+    result = []
+    for ticket, allocation in forecast_allocations(state):
+        if not truthy(allocation) or to_number(og(allocation, "amount")) <= 0:
+            continue
+        if og(allocation, "lifecycle") not in ("active", "review"):
+            continue
+        if level == "month":
+            matches = forecast_allocation_month_key(allocation) == period_key
+        else:
+            matches = forecast_allocation_quarter_key(allocation) == period_key
+        if matches:
+            result.append((ticket, allocation))
+    return result
+
+
+def assert_no_unresolved_forecasts(state: Any, period_key: Any, level: str) -> None:
+    unresolved = unresolved_forecast_allocations(state, period_key, level)
+    if not unresolved:
+        return
+    active = len([1 for _, allocation in unresolved if og(allocation, "lifecycle") == "active"])
+    review = len(unresolved) - active
+    details = " и ".join(
+        item for item in (f"{active} активных" if active else "", f"{review} на проверке" if review else "") if item
+    )
+    raise DomainError(
+        f"Нельзя закрыть {period_label(period_key)}: осталось {details} прогнозных распределений. "
+        "Оплатите, освободите или перенесите их."
+    )
+
+
+def assert_month_editable(state: Any, month_key: Any) -> None:
+    if is_month_closed(state, month_key):
+        quarter_key = quarter_key_of_month(month_key)
+        suffix = " (квартал закрыт — сначала переоткройте квартал)" if is_quarter_closed(state, quarter_key) else ""
+        raise DomainError(f"Месяц {S(month_key)} закрыт. Сначала переоткройте его{suffix}.")
+
+
+def assert_quarter_editable(state: Any, quarter_key: Any) -> None:
+    if is_quarter_closed(state, quarter_key):
+        raise DomainError(f"Квартал {S(quarter_key)} закрыт. Сначала переоткройте его, чтобы менять данные.")
+
+
+def assert_expense_editable(state: Any, expense: Any) -> None:
+    month_key = expense_month_key(expense)
+    if not month_key:
+        return
+    assert_month_editable(state, month_key)
+
+
+def period_label(period_key: Any) -> str:
+    text = S(or_(period_key, ""))
+    if MONTH_KEY_RE.match(text):
+        return f"месяц {S(period_key)}"
+    if QUARTER_KEY_RE.match(text):
+        return f"квартал {S(period_key)}"
+    return text
+
+
+def push_history(state: dict, action: str, level: str, period_key: Any, actor: Any, reason: Any) -> None:
+    history = state.get("periodCloseHistory", UNDEF)
+    state["periodCloseHistory"] = tail(history, 199) if is_list(history) else []
+    state["periodCloseHistory"].append({
+        "action": action,
+        "level": level,
+        "periodKey": period_key,
+        "at": dates.now_iso(),
+        "actor": or_(actor, "Не указано"),
+        "reason": or_(reason, ""),
+    })
+
+
+def close_month(state: dict, month_key: Any, meta: dict) -> dict:
+    if not test(MONTH_KEY_RE, or_(month_key, "")):
+        raise DomainError("Некорректный ключ месяца")
+    ensure_closed_periods(state)
+    quarter_key = quarter_key_of_month(month_key)
+    if is_quarter_closed(state, quarter_key):
+        raise DomainError(f"Квартал {quarter_key} закрыт. Сначала переоткройте квартал, затем работайте с месяцем.")
+    if is_month_closed(state, month_key):
+        raise DomainError(f"Месяц {S(month_key)} уже закрыт")
+    assert_no_unresolved_forecasts(state, month_key, "month")
+    state["closedPeriods"]["months"][pk(month_key)] = {
+        "closedAt": dates.now_iso(),
+        "closedBy": or_(meta.get("actor", UNDEF), "Не указано"),
+    }
+    push_history(state, "close", "month", month_key, meta.get("actor", UNDEF), meta.get("reason", UNDEF))
+    return state
+
+
+def close_quarter(state: dict, quarter_key: Any, meta: dict) -> dict:
+    if not test(QUARTER_KEY_RE, or_(quarter_key, "")):
+        raise DomainError("Некорректный ключ квартала")
+    ensure_closed_periods(state)
+    if is_quarter_closed(state, quarter_key):
+        raise DomainError(f"Квартал {S(quarter_key)} уже закрыт")
+    months = quarter_months(quarter_key)
+    closed_count = len([month for month in months if is_month_closed(state, month)])
+    if closed_count != len(months):
+        raise DomainError(
+            f"Нельзя закрыть квартал: закрыто {closed_count} из {len(months)} месяцев. Сначала закройте все месяцы."
+        )
+    assert_no_unresolved_forecasts(state, quarter_key, "quarter")
+    snapshot = period_close_snapshot(state, quarter_key)
+    state["closedPeriods"]["quarters"][pk(quarter_key)] = {
+        "closedAt": dates.now_iso(),
+        "closedBy": or_(meta.get("actor", UNDEF), "Не указано"),
+        "snapshot": snapshot,
+    }
+    push_history(state, "close", "quarter", quarter_key, meta.get("actor", UNDEF), meta.get("reason", UNDEF))
+    return state
+
+
+def reopen_month(state: dict, month_key: Any, meta: dict) -> dict:
+    if not test(MONTH_KEY_RE, or_(month_key, "")):
+        raise DomainError("Некорректный ключ месяца")
+    ensure_closed_periods(state)
+    quarter_key = quarter_key_of_month(month_key)
+    if is_quarter_closed(state, quarter_key):
+        raise DomainError(f"Квартал {quarter_key} закрыт. Сначала переоткройте квартал, затем отдельный месяц.")
+    if not is_month_closed(state, month_key):
+        raise DomainError(f"Месяц {S(month_key)} не закрыт")
+    reason = meta.get("reason", UNDEF)
+    if not truthy(reason) or not js_trim(S(reason)):
+        raise DomainError("Укажите причину переоткрытия месяца")
+    state["closedPeriods"]["months"].pop(pk(month_key), None)
+    push_history(state, "reopen", "month", month_key, meta.get("actor", UNDEF), reason)
+    return state
+
+
+def reopen_quarter(state: dict, quarter_key: Any, meta: dict) -> dict:
+    if not test(QUARTER_KEY_RE, or_(quarter_key, "")):
+        raise DomainError("Некорректный ключ квартала")
+    ensure_closed_periods(state)
+    if not is_quarter_closed(state, quarter_key):
+        raise DomainError(f"Квартал {S(quarter_key)} не закрыт")
+    reason = meta.get("reason", UNDEF)
+    if not truthy(reason) or not js_trim(S(reason)):
+        raise DomainError("Укажите причину переоткрытия квартала")
+    state["closedPeriods"]["quarters"].pop(pk(quarter_key), None)
+    push_history(state, "reopen", "quarter", quarter_key, meta.get("actor", UNDEF), reason)
+    return state
+
+
+def period_close_snapshot(state: Any, quarter_key: Any) -> Any:
+    """Контрольный снимок квартала: план, факт и остаток по локации, проекту и валюте."""
+    if not test(QUARTER_KEY_RE, or_(quarter_key, "")):
+        return None
+    locations = [loc for loc in or_(og(state, "locations"), []) if not truthy(og(loc, "archived"))]
+    articles = [article for article in or_(og(state, "articles"), []) if not truthy(og(article, "archived"))]
+    expenses = [
+        expense for expense in or_(og(state, "expenses"), [])
+        if og(expense, "quarterKey") == quarter_key and og(expense, "status") != "canceled"
+    ]
+    forecasts = [
+        allocation for _, allocation in forecast_allocations(state)
+        if forecast_allocation_quarter_key(allocation) == quarter_key and og(allocation, "lifecycle") == "active"
+    ]
+    budgets = or_(og(state, "budgets"), {})
+
+    by_location: dict = {}
+    for loc in locations:
+        by_article: dict = {}
+        for article in articles:
+            active_subs = [sub_item for sub_item in or_(og(article, "subarticles"), []) if not truthy(og(sub_item, "archived"))]
+            item_keys = [f"{S(og(article, 'id'))}|{S(og(sub_item, 'id'))}" for sub_item in active_subs] if active_subs else [
+                og(article, "id")
+            ]
+            plan_by_currency: dict = {}
+            fact_by_currency: dict = {}
+            forecast_by_currency: dict = {}
+            for item_key in item_keys:
+                store = og(budgets, f"{S(og(loc, 'id'))}|{S(quarter_key)}")
+                amounts = og(store, pk(item_key))
+                if truthy(amounts) and (is_dict(amounts) or is_list(amounts)):
+                    for currency, amount in entries(amounts):
+                        number = to_number(amount)
+                        if not currency or not is_finite(number) or number == 0:
+                            continue
+                        plan_by_currency[currency] = add(or_(plan_by_currency.get(currency, UNDEF), 0), number)
+            for expense in expenses:
+                if og(expense, "locationId") == og(loc, "id") and og(expense, "articleId") == og(article, "id"):
+                    currency = og(expense, "currency")
+                    if not truthy(currency):
+                        continue
+                    key = pk(currency)
+                    amount = to_number(og(expense, "amount"))
+                    fact_by_currency[key] = add(or_(fact_by_currency.get(key, UNDEF), 0), amount if truthy(amount) else 0)
+            for allocation in forecasts:
+                if og(allocation, "locationId") == og(loc, "id") and og(allocation, "articleId") == og(article, "id"):
+                    currency = og(allocation, "currency")
+                    if not truthy(currency):
+                        continue
+                    key = pk(currency)
+                    amount = to_number(og(allocation, "amount"))
+                    forecast_by_currency[key] = add(or_(forecast_by_currency.get(key, UNDEF), 0), amount if truthy(amount) else 0)
+            currencies = uniq([*keys(plan_by_currency), *keys(fact_by_currency), *keys(forecast_by_currency)])
+            if not currencies:
+                continue
+            article_key = pk(og(article, "id"))
+            by_article[article_key] = {}
+            for currency in currencies:
+                plan = or_(plan_by_currency.get(currency, UNDEF), 0)
+                fact = or_(fact_by_currency.get(currency, UNDEF), 0)
+                forecast = or_(forecast_by_currency.get(currency, UNDEF), 0)
+                by_article[article_key][currency] = {
+                    "plan": plan,
+                    "fact": fact,
+                    "forecast": forecast,
+                    "balance": sub(plan, fact),
+                    "free": sub(sub(plan, fact), forecast),
+                }
+        if by_article:
+            by_location[pk(og(loc, "id"))] = by_article
+    return {"quarterKey": quarter_key, "at": dates.now_iso(), "byLocation": by_location}
+
+
+__all__ = [
+    "SCHEMA_VERSION", "MONTH_KEY_RE", "QUARTER_KEY_RE", "test", "month_key_from_date", "quarter_key_of_month",
+    "quarter_key_from_date", "quarter_months", "ensure_closed_periods", "is_month_closed", "is_quarter_closed",
+    "quarter_status", "assert_month_editable", "assert_quarter_editable", "assert_expense_editable",
+    "close_month", "close_quarter", "reopen_month", "reopen_quarter", "period_close_snapshot",
+]
