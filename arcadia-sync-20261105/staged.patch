+      isActive = options.isActive;
+      return subscribe(sessionId, response, options);
+    };
+    const events = await f.request("/api/events", { headers });
+    assert.equal(events.status, 200);
+    const reader = events.body.getReader();
+    try {
+      await reader.read();
+      const sessionByToken = f.service.sessionByToken.bind(f.service);
+      let reads = 0;
+      f.service.sessionByToken = async (...args) => {
+        const live = await sessionByToken(...args);
+        // The second lookup follows online identity verification. Its await
+        // must not let an expired proof count as an active stream afterwards.
+        if (++reads === 2) f.advance(30_001);
+        return live;
+      };
+      await assert.rejects(isActive(), { code: "corporate_identity_unavailable" });
+    } finally { await reader.cancel(); }
+  });
+});
