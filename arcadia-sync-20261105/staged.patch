+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+const { DatabaseSync } = require("node:sqlite");
+const { PlanFactService, sanitizeAuditPayload } = require("../src/service.js");
+const { SqliteStore } = require("../src/sqlite-store.js");
+
+function createFixture(realtimeOverride = null) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "plan-fact-sqlite-"));
+  const store = new SqliteStore(path.join(root, "plan-fact.sqlite"), {
+    initialState: PlanFactService.initialState
+  });
+  const realtime = realtimeOverride || {
+    closeSession() {},
+    publish() {}
+  };
+  const service = new PlanFactService({
+    store,
+    realtime,
+    config: {
+      sessionMaxAgeMs: 24 * 60 * 60 * 1000,
+      lockTtlMs: 120_000,
+      requireLocks: true
+    }
+  });
+  return {
+    service,
+    store,
+    close() {
+      store.close();
+      fs.rmSync(root, { recursive: true, force: true });
+    }
+  };
+}
+
+test("AuditPayload_MasksSensitiveKeysRecursively", () => {
+  assert.deepEqual(sanitizeAuditPayload({
+    token: "top-level",
+    nested: {
+      pin: "nested-pin",
+      rows: [{ lockToken: "nested-lock", value: "visible" }]
+    }
+  }), {
+    token: "***",
+    nested: {
+      pin: "***",
+      rows: [{ lockToken: "***", value: "visible" }]
+    }
+  });
+});
+
+test("RealtimeStateChanged_DoesNotExposeActorIdentity", async () => {
+  const events = [];
+  const fixture = createFixture({
+    closeSession() {},
+    publish(event) { events.push(event); }
+  });
+  try {
+    await fixture.service.provisionSuperadmin({ staffLogin: "owner", name: "Owner" });
+    const { session } = await fixture.service.loginWithStaff({
+      identity: { login: "owner", uid: "owner-uid" }
+    });
+    await fixture.service.mutate(session, {
+      type: "addLocation",
+      mutationId: "location-no-actor-metadata",
+      baseRevision: 0,
+      payload: { id: "office", name: "Office" }
+    });
+
+    assert.deepEqual(events.at(-1), {
+      type: "state-changed",
+      revision: 1,
+      mutationType: "addLocation"
+    });
+  } finally {
+    fixture.close();
+  }
+});
+
+test("Migration_CreatesSchemaAndPersistsInitialState", () => {
+  const fixture = createFixture();
+  try {
+    const state = fixture.store.getState();
+    assert.equal(state.schemaVersion, 15);
+    assert.equal(state.revision, 0);
+    assert.deepEqual(fixture.store.listUsers(), []);
+  } finally {
+    fixture.close();
+  }
+});
+
+test("StaffMigration_DisablesLegacyPinAccountsAndPreservesAclAudit", () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "plan-fact-legacy-"));
+  const databasePath = path.join(root, "plan-fact.sqlite");
+  const db = new DatabaseSync(databasePath);
+  try {
+    const migrations = path.join(__dirname, "..", "migrations", "sqlite");
+    db.exec(fs.readFileSync(path.join(migrations, "001_initial.sql"), "utf8"));
+    db.prepare("INSERT INTO schema_migrations(version, applied_at) VALUES (1, ?)").run(new Date().toISOString());
+    db.exec(fs.readFileSync(path.join(migrations, "002_audit_location.sql"), "utf8"));
+    db.prepare("INSERT INTO schema_migrations(version, applied_at) VALUES (2, ?)").run(new Date().toISOString());
+    db.prepare(`
+      INSERT INTO users(
+        id, name, name_key, role, pin_salt, pin_hash, must_change_pin, active, created_at
+      ) VALUES (?, ?, ?, ?, ?, ?, 0, 1, ?)
+    `).run("legacy", "Legacy", "legacy", "user", "salt", "hash", new Date().toISOString());
+    db.prepare("INSERT INTO user_location_access(user_id, location_id, access) VALUES (?, ?, ?)")
+      .run("legacy", "office", "view");
+    db.prepare(`
+      INSERT INTO audit_events(id, actor_id, actor_name, action, payload_json, created_at)
+      VALUES (?, ?, ?, ?, '{}', ?)
+    `).run("audit", "legacy", "Legacy", "legacy.event", new Date().toISOString());
+  } finally {
+    db.close();
+  }
+
+  const store = new SqliteStore(databasePath, { initialState: PlanFactService.initialState });
+  try {
+    const legacy = store.getUser("legacy");
+    assert.equal(legacy.active, 0);
+    assert.equal(legacy.staff_login, null);
+    assert.deepEqual(store.getLocationAccess("legacy"), { office: "view" });
+    assert.equal(store.listAudit({ limit: 10 }).length, 1);
+    const columns = store.db.prepare("PRAGMA table_info(users)").all().map((column) => column.name);
+    assert.equal(columns.includes("pin_hash"), false);
+    assert.deepEqual(store.db.prepare("PRAGMA foreign_key_check").all(), []);
+  } finally {
+    store.close();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("StaffLogin_BindsStableUidAndReturnsProjectedState", async () => {
+  const fixture = createFixture();
+  try {
+    const user = await fixture.service.provisionSuperadmin({ staffLogin: "reviewer", name: "Reviewer" });
+    const result = await fixture.service.loginWithStaff({
+      identity: { login: "reviewer", uid: "112233" },
+      ip: "127.0.0.1",
+      userAgent: "node:test"
+    });
+
+    assert.equal(result.user.role, "superadmin");
+    assert.equal(result.user.staffLogin, "reviewer");
+    assert.equal(result.user.staffUidBound, true);
+    assert.ok(result.token.length >= 40);
+    assert.equal(result.session.userId, user.id);
+    assert.equal((await fixture.service.stateFor(result.session)).state.revision, 0);
+    assert.equal(fixture.store.getUser(user.id).staff_uid, "112233");
+    assert.doesNotThrow(() => fixture.service.assertStaffIdentity(result.session, {
+      login: "reviewer",
+      uid: "112233"
+    }));
+  } finally {
+    fixture.close();
+  }
+});
+
+test("StaffLogin_DeniesUnknownLoginAndUidMismatch", async () => {
+  const fixture = createFixture();
+  try {
+    await fixture.service.provisionSuperadmin({ staffLogin: "reviewer", name: "Reviewer" });
+    await assert.rejects(
+      fixture.service.loginWithStaff({ identity: { login: "unknown", uid: "998877" } }),
+      (error) => error.statusCode === 403 && error.code === "staff_access_not_provisioned"
+    );
+    await fixture.service.loginWithStaff({ identity: { login: "reviewer", uid: "112233" } });
+    await assert.rejects(
+      fixture.service.loginWithStaff({ identity: { login: "reviewer", uid: "998877" } }),
+      (error) => error.statusCode === 403 && error.code === "staff_identity_mismatch"
+    );
+  } finally {
+    fixture.close();
+  }
+});
+
+test("StaffLogin_AtomicallyBindsOnlyOneUidOnConcurrentFirstLogin", async () => {
+  const fixture = createFixture();
+  try {
+    const user = await fixture.service.provisionSuperadmin({ staffLogin: "reviewer", name: "Reviewer" });
+    const attempts = await Promise.allSettled([
+      fixture.service.loginWithStaff({ identity: { login: "reviewer", uid: "uid-first" } }),
+      fixture.service.loginWithStaff({ identity: { login: "reviewer", uid: "uid-second" } })
+    ]);
+    assert.equal(attempts.filter((result) => result.status === "fulfilled").length, 1);
+    const rejected = attempts.find((result) => result.status === "rejected");
+    assert.equal(rejected.reason.code, "staff_identity_mismatch");
+    const boundUid = fixture.store.getUser(user.id).staff_uid;
+    assert.ok(["uid-first", "uid-second"].includes(boundUid));
+    const winner = attempts.find((result) => result.status === "fulfilled");
+    assert.equal(winner.value.session.user.staff_uid, boundUid);
+  } finally {
+    fixture.close();
+  }
+});
+
+test("StaffLogin_TracksRenamedLoginByStableUid", async () => {
+  const fixture = createFixture();
+  try {
+    const user = await fixture.service.provisionSuperadmin({ staffLogin: "reviewer", name: "Reviewer" });
+    await fixture.service.loginWithStaff({ identity: { login: "reviewer", uid: "112233" } });
+    const renamed = await fixture.service.loginWithStaff({
+      identity: { login: "reviewer.renamed", uid: "112233" }
+    });
+    assert.equal(renamed.user.staffLogin, "reviewer.renamed");
+    assert.equal(fixture.store.getUser(user.id).staff_login, "reviewer.renamed");
+  } finally {
+    fixture.close();
+  }
+});
+
+test("StaffIdentity_UsesServerSideRoleAndLocationMatrix", async () => {
+  const fixture = createFixture();
+  try {
+    await fixture.service.provisionSuperadmin({ staffLogin: "owner", name: "Owner" });
+    const { session: ownerSession } = await fixture.service.loginWithStaff({
+      identity: { login: "owner", uid: "10001" }
+    });
+    let revision = 0;
+    for (const location of [
+      { id: "allowed", name: "Allowed" },
+      { id: "forbidden", name: "Forbidden" }
+    ]) {
+      const result = await fixture.service.mutate(ownerSession, {
+        type: "addLocation",
+        mutationId: `location-${location.id}`,
+        baseRevision: revision,
+        payload: location
+      });
+      revision = result.state.revision;
+    }
+    await fixture.service.saveAccount(ownerSession, {
+      staffLogin: "analyst",
+      name: "Analyst",
+      role: "user",
+      defaultLocationAccess: "view",
+      locationAccess: { allowed: "edit", forbidden: "hidden" }
+    });
+    const { session } = await fixture.service.loginWithStaff({
+      identity: { login: "analyst", uid: "10002" }
+    });
+    const projection = await fixture.service.stateFor(session);
+    assert.deepEqual(projection.state.locations.map((item) => item.id), ["default", "allowed"]);
+    assert.equal(projection.state.permissions.locations.allowed, "edit");
+    assert.equal(projection.state.permissions.locations.forbidden, undefined);
+  } finally {
+    fixture.close();
+  }
+});
+
+test("StaffProvisioning_CreatesRosterIdempotentlyWithHiddenUserAccess", async () => {
+  const fixture = createFixture();
+  try {
+    const accounts = [
+      { staffLogin: "owner", name: "Owner", role: "superadmin" },
+      { staffLogin: "analyst", name: "Analyst", role: "user", defaultLocationAccess: "view" }
+    ];
+    const created = await fixture.service.provisionStaffAccounts(accounts);
+    assert.deepEqual(created.map((item) => item.created), [true, true]);
+    assert.equal(created[0].account.role, "superadmin");
+    assert.equal(created[1].account.role, "user");
+    assert.equal(created[1].account.defaultLocationAccess, "hidden");
+    assert.deepEqual(created[1].account.locationAccess, {});
+
+    const repeated = await fixture.service.provisionStaffAccounts(accounts);
+    assert.deepEqual(repeated.map((item) => item.created), [false, false]);
+    assert.equal(fixture.store.countUsers(), 2);
+    assert.equal(
+      fixture.store.listAudit({ limit: 10 })
+        .filter((event) => event.action === "staff_access.provisioned").length,
+      2
+    );
+  } finally {
+    fixture.close();
+  }
