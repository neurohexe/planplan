+assert(/^Резервная копия План Факт MVP: plan-fact-\d{8}-\d{4}\.pfbak\n/.test(body.text));' "$TRACKER"
+check 'архив зашифрован: учебной записи и заголовка SQLite в нём не видно' /bin/bash -c '! grep -q -a "alice" "$1" && ! grep -q -a "SQLite format" "$1" && [ "$(head -c 4 "$1")" = PFBK ]' _ "$TRACKER/received.pfbak"
