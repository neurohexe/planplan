+"""Завести первого суперадмина (перенос bootstrap-superadmin из backend/src/cli.js)."""
+
+from __future__ import annotations
+
+import os
+import sys
+
+from django.core.management.base import BaseCommand
+
+from planfact.errors import AppError
+
+
+class Command(BaseCommand):
+    help = "Завести суперадмина: логин из PLAN_FACT_BOOTSTRAP_STAFF_LOGIN или с клавиатуры"
+
+    def handle(self, *args, **options) -> None:
+        from planfact.runtime import get_service
+
+        login = os.environ.get("PLAN_FACT_BOOTSTRAP_STAFF_LOGIN") or input("Staff login superadmin: ").strip()
+        name = os.environ.get("PLAN_FACT_BOOTSTRAP_DISPLAY_NAME") or input(f"Отображаемое имя [{login}]: ").strip() or login
+        try:
+            account = get_service().provision_superadmin(staff_login=login, name=name)
+        except AppError as error:
+            sys.stderr.write(f"{error.message}\n")
+            sys.exit(1)
+        self.stdout.write(f"Создан superadmin: {account['staffLogin']}")
