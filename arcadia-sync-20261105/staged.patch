+def _update_location(nxt: dict, payload: dict, now: str) -> None:
+    loc = _find(nxt["locations"], lambda item: strict_eq(og(item, "id"), _p(payload, "id")))
+    if loc is None:
+        raise DomainError("Локация не найдена")
+    name = clean_text(_p(payload, "name"), 120)
+    if not name:
+        raise DomainError("Введите название локации")
+    code = normalize_code(_p(payload, "code"))
+    if code and code != normalize_code(og(loc, "code")) and any(
+        item is not loc and normalize_code(og(item, "code")) == code for item in nxt["locations"]
+    ):
+        raise DomainError("Код локации уже используется")
+    loc["name"] = name
+    loc["code"] = clean_text(_p(payload, "code"), 80)
+
+
+def _archive_location(nxt: dict, payload: dict, now: str) -> None:
+    loc = _find(nxt["locations"], lambda item: strict_eq(og(item, "id"), _p(payload, "id")))
+    if loc is None:
