+    identifier = clean_text(_p(payload, "id"), 80) or new_id()
+    if identifier == ALL_LOCATIONS or any(strict_eq(og(item, "id"), identifier) for item in nxt["locations"]):
+        raise DomainError("Локация с таким кодом уже существует")
