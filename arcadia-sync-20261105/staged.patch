+"use strict";
+const assert = require("node:assert/strict");
+const crypto = require("node:crypto");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+const { SqliteStore } = require("../src/sqlite-store.js");
+const { PostgresStore } = require("../src/postgres-store.js");
+const { PlanFactService } = require("../src/service.js");
+
+async function exercise(store, expire) {
+  const id = crypto.randomUUID();
+  await store.createUser({ id, name:"Fictional lock owner", nameKey:`test-${id}`, staffLogin:`alice-${id.slice(0,8)}`, role:"admin", defaultLocationAccess:"hidden", locationAccess:{} });
+  const resourceId = `lock-${id}`;
+  const input = { resourceType:"expense", resourceId, userId:id, sessionId:`fictional-${id}`,
+    tokenHash:"fictional-first-hash", now:new Date().toISOString(), expiresAt:new Date(Date.now()+120000).toISOString() };
+  assert.equal((await store.acquireLock(input)).acquired, true);
+  assert.equal((await store.acquireLock({...input,tokenHash:"fictional-second-hash"})).acquired, true);
+  assert.equal((await store.acquireLock({...input,sessionId:"another-session"})).acquired, false);
+  assert.equal(await store.refreshLock("expense",resourceId,input.sessionId,input.tokenHash,input.expiresAt),false);
+  assert.equal(await store.refreshLock("expense",resourceId,input.sessionId,"fictional-second-hash",input.expiresAt),true);
+  await expire(resourceId);
+  assert.equal(await store.refreshLock("expense",resourceId,input.sessionId,"fictional-second-hash",input.expiresAt),false);
+  assert.equal((await store.acquireLock(input)).acquired,true);
+  await store.deleteLocksByUser(id);
+}
+
+test("LockOwnership_SQLite_RotatesOwnTokenAndDoesNotReviveExpiredLock", async () => {
+  const directory=fs.mkdtempSync(path.join(os.tmpdir(),"plan-fact-lock42-"));
+  const store=new SqliteStore(path.join(directory,"state.sqlite"),{initialState:PlanFactService.initialState});
+  try { await exercise(store,id=>store.db.prepare("UPDATE edit_locks SET expires_at=? WHERE resource_id=?").run("2000-01-01T00:00:00.000Z",id)); }
+  finally { store.close(); fs.rmSync(directory,{recursive:true,force:true}); }
+});
+
+test("LockOwnership_PostgreSQL_RotatesOwnTokenAndDoesNotReviveExpiredLock", {skip:!process.env.PLAN_FACT_TEST_DATABASE_URL}, async () => {
+  const url=new URL(process.env.PLAN_FACT_TEST_DATABASE_URL);
+  assert.ok(["127.0.0.1","localhost"].includes(url.hostname) && url.pathname.endsWith("_test"),"Only an isolated local *_test database is permitted");
