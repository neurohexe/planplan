+FROM node:22-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
+
+ENV NODE_ENV=production \
+    PLAN_FACT_HOST=0.0.0.0 \
+    PLAN_FACT_PORT=8080 \
+    PLAN_FACT_STATIC_DIR=/srv/plan-fact/public \
+    PLAN_FACT_DEPLOYMENT_PROFILE=postgres-only
+
+WORKDIR /srv/plan-fact/backend
+
+COPY --chown=node:node backend/package.json backend/package-lock.json ./
+RUN npm ci --omit=dev --ignore-scripts \
+    && npm cache clean --force
+
+ARG PLAN_FACT_BUILD_COMMIT=unknown
+ARG PLAN_FACT_BACKEND_VERSION=0.1.0
+ENV PLAN_FACT_BUILD_COMMIT=${PLAN_FACT_BUILD_COMMIT} \
+    PLAN_FACT_BACKEND_VERSION=${PLAN_FACT_BACKEND_VERSION}
+LABEL org.opencontainers.image.revision=${PLAN_FACT_BUILD_COMMIT}
+
+RUN mkdir -p /srv/plan-fact/backend/var /srv/plan-fact/public /srv/plan-fact/app \
+    && chown -R node:node /srv/plan-fact
+
+COPY --chown=node:node backend/src ./src
+COPY --chown=node:node backend/migrations ./migrations
+COPY --chown=node:node app/app.js app/budget-import.js app/expense-import.js app/period-locks.js app/tracker-sync.js /srv/plan-fact/app/
+COPY --chown=node:node app/app.js app/budget-import.js app/expense-import.js app/period-locks.js app/tracker-sync.js /srv/plan-fact/public/
+COPY --chown=node:node app/index.html app/styles.css /srv/plan-fact/public/
+
+# webauth.yandex-team.ru подписан YandexInternalCA, которого нет во встроенном списке
+# корневых сертификатов Node. Без этого сертификата каждый вход по Staff давал бы 503.
+COPY --chown=node:node deploy/certs/YandexInternalRootCA.pem /srv/plan-fact/certs/YandexInternalRootCA.pem
+ENV NODE_EXTRA_CA_CERTS=/srv/plan-fact/certs/YandexInternalRootCA.pem
+
+USER node
+EXPOSE 8080
+
+CMD ["node", "--experimental-sqlite", "src/index.js"]
