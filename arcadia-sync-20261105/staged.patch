+check 'обычное выключение сохраняет токен и пароль' /bin/bash -c '[ -f "$1/secrets/tracker-token" ] && [ -f "$1/secrets/offsite-password" ]' _ "$STAND"
+"$STAND/bin/stop.sh" >/dev/null
+"$STAND/bin/start.sh" >/dev/null
+check 'выключенная копия в Трекер не запускается вместе со стендом' /bin/bash -c '! grep -q offsite "$1/active.txt"' _ "$STATE"
