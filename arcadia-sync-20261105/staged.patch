@@ -0,0 +1,40 @@
+"""Единственный экземпляр сервиса и концентратора событий на процесс."""
+
+from __future__ import annotations
+
+import threading
+
+from django.conf import settings
+
+from planfact.config import Config
+from planfact.realtime import RealtimeHub
+from planfact.service import PlanFactService
+from planfact.store import Store
+
+_lock = threading.Lock()
+_service: PlanFactService | None = None
+
+
+def _hub(config: Config) -> RealtimeHub:
+    # Не больше половины рабочих потоков сервера — остальные всегда свободны для обычных запросов.
+    return RealtimeHub(config.heartbeat_ms, max_streams=max(1, config.threads // 2))
+
+
+def get_service() -> PlanFactService:
+    global _service
+    if _service is None:
+        with _lock:
+            if _service is None:
+                config: Config = settings.PLAN_FACT
+                _service = PlanFactService(Store(), config, _hub(config))
+    return _service
+
+
+def configure(config: Config) -> PlanFactService:
+    """Заменить настройки (тесты: другой адрес туннеля, Secure-cookie и т. п.)."""
+    global _service
+    with _lock:
+        if _service is not None:
