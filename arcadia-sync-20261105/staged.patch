+# Настройки тестового стенда. Секретов в этом файле нет.
+# Полные пути создаёт установщик; файл можно подключать стандартным bash.
+PLAN_FACT_NODE_BIN={{NODE}}
+NODE_ENV=development
+# Исходный режим. Повторная установка сохраняет существующий config.env полностью.
+# Подготовка corporate-idm описана в config.corporate.env.example; одного переключателя недостаточно.
+PLAN_FACT_AUTH_MODE=access-code
+PLAN_FACT_STORAGE_DRIVER=sqlite
+PLAN_FACT_ROLE_SOURCE=app
+PLAN_FACT_DEPLOYMENT_PROFILE=full
+PLAN_FACT_DATABASE={{DATABASE}}
+PLAN_FACT_HOST=127.0.0.1
+PLAN_FACT_PORT=18766
+PLAN_FACT_STATIC_DIR={{STATIC}}
+PLAN_FACT_CODES_DIR={{CODES}}
+PLAN_FACT_SECURE_COOKIES=true
+PLAN_FACT_ALLOWED_ORIGINS=''
+# Туннель (задача 9): сервер Tunneler и постоянный удалённый порт закрепляют адрес стенда
+# https://<логин>-<порт>-ws1.tunneler-si.yandex.ru. Логин берётся из учётной записи macOS
+# (можно задать PLAN_FACT_TUNNEL_USERNAME). PLAN_FACT_ALLOWED_ORIGINS выше пишут enable-tunnel.sh и disable-tunnel.sh.
+PLAN_FACT_TUNNEL_HOST=ws1-tunnelerapi.tunneler-si.yandex-team.ru
+PLAN_FACT_TUNNEL_REMOTE_PORT=28766
+# Только если в logs/tunnel.log видно, что ssh не договаривается с Tunneler (FAQ Tunneler, OpenSSH 9+),
+# разрешите алгоритмы ssh-rsa для одного туннеля, не меняя ~/.ssh/config:
+# PLAN_FACT_TUNNEL_SSH_RSA=yes
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/laptop/disable-tunnel.sh b/junk/padolskiye/plan_fact_minipc/deploy/laptop/disable-tunnel.sh
