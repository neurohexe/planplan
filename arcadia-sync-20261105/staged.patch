+"""Помощники с семантикой JavaScript: проверки без Node (значения взяты из Node 22)."""
+
+from __future__ import annotations
+
+import math
+import os
+import time
+
+from django.test import SimpleTestCase
+
+from planfact.domain import collation, dates, js
+from planfact.domain.common import quarter_key_from_date_input, safe_http_url, ticket_label
+
+
+class JsSemanticsTests(SimpleTestCase):
+    def test_numbers_print_like_javascript(self):
+        cases = {1: "1", 1.0: "1", 1.5: "1.5", 0.1 + 0.2: "0.30000000000000004", 1e21: "1e+21", 1e-7: "1e-7", 1.5e16: "15000000000000000",
+                 1e-6: "0.000001", -0.0: "0", 100.0: "100", float("nan"): "NaN", float("inf"): "Infinity", 2.5e-7: "2.5e-7"}
+        for value, expected in cases.items():
+            self.assertEqual(js.number_to_string(value), expected, repr(value))
+
+    def test_number_conversion_follows_ecmascript(self):
+        self.assertEqual(js.to_number(" 12 "), 12)
+        self.assertEqual(js.to_number("0x10"), 16)
+        self.assertEqual(js.to_number(""), 0)
+        self.assertEqual(js.to_number(None), 0)
+        self.assertTrue(math.isnan(js.to_number(js.UNDEF)))
+        self.assertEqual(js.to_number([5]), 5)
+        self.assertTrue(math.isnan(js.to_number([1, 2])))
+        self.assertTrue(math.isnan(js.to_number("1_000")))
+        self.assertEqual(js.to_number("1e3"), 1000)
+        self.assertEqual(js.to_number(True), 1)
+        self.assertTrue(math.isnan(js.to_number("inf")))
+
+    def test_truthiness_and_rounding_follow_javascript(self):
+        self.assertTrue(js.truthy([]))
+        self.assertTrue(js.truthy({}))
+        self.assertFalse(js.truthy(float("nan")))
+        self.assertFalse(js.truthy(js.UNDEF))
+        self.assertEqual(js.js_round(2.5), 3)
+        self.assertEqual(js.js_round(-2.5), -2)
+        self.assertEqual(js.js_round(0.49999999999999994), 0)
+        self.assertEqual(js.js_mod(-7, 3), -1)
+        self.assertEqual(js.to_base36(js.imul(2166136261, 16777619) & 0xFFFFFFFF), "1efc4f")
+
+    def test_strings_are_measured_and_sliced_in_utf16_units(self):
+        self.assertEqual(js.js_len("а😀б"), 4)
+        self.assertEqual(js.js_slice("а😀б", 0, 3), "а😀")
+        self.assertEqual(js.js_slice("а😀б", 0, 2), "а", "половина эмодзи не сохраняется")
+        self.assertEqual(js.js_trim(" ﻿ x 　"), "x")
+        self.assertEqual(js.collapse_ws("a \t\n b"), "a b")
+
+    def test_json_matches_json_stringify(self):
+        self.assertEqual(js.dumps({"a": 1.0, "b": [js.UNDEF, float("nan")], "c": js.UNDEF, "d": 'x "y'}), '{"a":1,"b":[null,null],"d":"x \\"y"}')
+        self.assertEqual(js.clone({"a": js.UNDEF, "b": [js.UNDEF]}), {"b": [None]})
+        with self.assertRaises(ValueError):
+            js.loads("NaN")
+
+    def test_strict_equality_distinguishes_types(self):
+        self.assertFalse(js.strict_eq(True, 1))
+        self.assertTrue(js.strict_eq(1, 1.0))
+        self.assertFalse(js.strict_eq(None, js.UNDEF))
+        self.assertFalse(js.strict_eq({}, {}))
+
