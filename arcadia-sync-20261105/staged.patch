+printf 'Главные администраторы настроены: %s.\n' "$logins"
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/laptop/backup-store.mjs b/junk/padolskiye/plan_fact_minipc/deploy/laptop/backup-store.mjs
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/backup-store.mjs
@@ -0,0 +1,192 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+
+const [command, root, argument] = process.argv.slice(2);
+const database = process.env.PLAN_FACT_DATABASE;
+const snapshotName = /^plan-fact-\d{8}-\d{4}\.sqlite$/;
+const backups = path.join(root, 'backups');
+
+function stat(file) {
+  try { return fs.lstatSync(file); }
+  catch (error) { if (error.code === 'ENOENT') return null; throw error; }
+}
+
+// Проверяем каждый компонент пути: ссылка внутри стенда не должна увести
+// копирование, удаление или перенос за его границы.
+function insideStand(file) {
+  const relative = path.relative(root, path.resolve(file));
+  if (!path.isAbsolute(file) || relative === '..' || relative.startsWith(`..${path.sep}`)) {
+    throw new Error('Путь должен находиться внутри выбранного стенда.');
+  }
+  let current = root;
+  for (const component of ['', ...relative.split(path.sep).filter(Boolean)]) {
+    if (component) current = path.join(current, component);
+    if (stat(current)?.isSymbolicLink()) throw new Error('Пути стенда не должны содержать символических ссылок.');
+  }
+}
+
+function directory(file) {
+  insideStand(file);
+  fs.mkdirSync(file, { recursive: true, mode: 0o700 });
+  if (!fs.lstatSync(file).isDirectory()) throw new Error('Ожидалась папка стенда.');
+  fs.chmodSync(file, 0o700);
+}
+
+function regularFile(file, optional = false) {
+  const info = stat(file);
+  if (optional && !info) return false;
+  if (!info?.isFile() || info.isSymbolicLink()) throw new Error('Ожидался существующий обычный файл базы или копии.');
+  return true;
+}
+
+function integrity(file) {
+  regularFile(file);
+  const connection = new DatabaseSync(file, { readOnly: true });
+  try {
+    connection.exec('PRAGMA busy_timeout = 5000');
+    const rows = connection.prepare('PRAGMA integrity_check').all();
+    if (rows.length !== 1 || rows[0].integrity_check !== 'ok') {
+      throw new Error('Проверка целостности копии не вернула ok.');
+    }
+  } finally { connection.close(); }
+}
+
+function stamp(now = new Date(), seconds = false) {
+  const pad = (value) => String(value).padStart(2, '0');
+  return `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}${seconds ? pad(now.getSeconds()) : ''}`;
+}
+
+function snapshots(folder) {
+  insideStand(folder);
+  if (!stat(folder)) return [];
+  return fs.readdirSync(folder).filter((name) => snapshotName.test(name) && stat(path.join(folder, name))?.isFile())
+    .sort().reverse();
+}
+
+function rotate(folder, keep) {
+  const files = snapshots(folder);
+  for (const name of files.slice(keep)) fs.unlinkSync(path.join(folder, name));
+  for (const name of files.slice(0, keep)) fs.chmodSync(path.join(folder, name), 0o600);
+}
+
+function backup() {
+  insideStand(database);
+  if (!regularFile(database, true)) return;
+  for (const suffix of ['-wal', '-shm']) {
+    insideStand(database + suffix);
+    regularFile(database + suffix, true);
+  }
+  const hourly = path.join(backups, 'hourly'), daily = path.join(backups, 'daily');
+  for (const folder of [backups, hourly, daily]) directory(folder);
+  const temporary = fs.mkdtempSync(path.join(backups, '.backup-'));
+  try {
+    const file = path.join(temporary, 'snapshot.sqlite');
+    const connection = new DatabaseSync(database, { readOnly: true });
+    try {
+      connection.exec('PRAGMA busy_timeout = 5000');
+      connection.prepare('VACUUM INTO ?').run(file);
+    } finally { connection.close(); }
+    integrity(file);
+    fs.chmodSync(file, 0o600);
+    const time = stamp(), name = `plan-fact-${time}.sqlite`;
+    const target = path.join(hourly, name);
+    regularFile(target, true);
+    fs.renameSync(file, target);
+    // За сутки сохраняем первую успешную копию, даже при ручных повторах.
+    if (!snapshots(daily).some((item) => item.startsWith(`plan-fact-${time.slice(0, 8)}-`))) {
+      const dailyFile = path.join(temporary, 'daily.sqlite');
+      fs.copyFileSync(target, dailyFile, fs.constants.COPYFILE_EXCL);
+      integrity(dailyFile);
+      fs.chmodSync(dailyFile, 0o600);
+      regularFile(path.join(daily, name), true);
+      fs.renameSync(dailyFile, path.join(daily, name));
+    }
+    rotate(hourly, 48);
+    rotate(daily, 14);
+    console.log('Резервная копия создана и проверена.');
+  } finally { fs.rmSync(temporary, { recursive: true, force: true }); }
+}
+
+function prepareRestore(source) {
+  regularFile(source);
+  // Неверный путь назначения отклоняем тоже до остановки работающего сервера.
+  for (const suffix of ['', '-wal', '-shm']) {
+    insideStand(database + suffix);
+    regularFile(database + suffix, true);
+  }
+  directory(backups);
+  // Проверяем собственную копию выбранного файла до остановки сервера:
+  // последующее изменение исходного файла не подменит проверенные данные.
+  const temporary = fs.mkdtempSync(path.join(backups, '.restore-'));
+  try {
+    const file = path.join(temporary, 'verified.sqlite');
+    fs.copyFileSync(source, file, fs.constants.COPYFILE_EXCL);
+    fs.chmodSync(file, 0o600);
+    integrity(file);
+    console.log(temporary);
+  } catch (error) {
+    fs.rmSync(temporary, { recursive: true, force: true });
+    throw error;
+  }
+}
+
+function applyRestore(temporary) {
+  insideStand(temporary);
+  if (path.dirname(temporary) !== backups || !path.basename(temporary).startsWith('.restore-')) {
+    throw new Error('Неверная временная папка восстановления.');
+  }
+  const verified = path.join(temporary, 'verified.sqlite');
+  insideStand(verified);
+  integrity(verified);
+  directory(path.dirname(database));
+  const files = ['', '-wal', '-shm'].map((suffix) => database + suffix);
+  for (const file of files) { insideStand(file); regularFile(file, true); }
+  const previous = fs.mkdtempSync(path.join(backups, `before-restore-${stamp(new Date(), true)}-`));
+  const moved = [];
+  try {
+    for (const file of files) {
+      if (!stat(file)) continue;
+      const destination = path.join(previous, path.basename(file));
+      fs.renameSync(file, destination);
+      moved.push([file, destination]);
+      fs.chmodSync(destination, 0o600);
+    }
+    fs.chmodSync(verified, 0o600);
+    fs.renameSync(verified, database);
+  } catch (error) {
+    // Если сам перенос не завершился, возвращаем уже перенесённые файлы.
+    for (const [file, destination] of moved.reverse()) {
+      if (!stat(file)) fs.renameSync(destination, file);
+    }
+    throw error;
+  }
+  // Все прежние sidecar-файлы уже перенесены. Новый сервер создаст свои.
+  console.log(`Прежняя база и её служебные файлы сохранены: ${previous}`);
+}
+
+function status() {
+  const hourly = snapshots(path.join(backups, 'hourly')), daily = snapshots(path.join(backups, 'daily'));
+  const latest = [...hourly, ...daily].sort().pop();
+  if (latest) {
+    const time = latest.slice('plan-fact-'.length, -'.sqlite'.length);
+    console.log(`Последняя резервная копия: ${time.slice(6, 8)}.${time.slice(4, 6)}.${time.slice(0, 4)} ${time.slice(9, 11)}:${time.slice(11, 13)}.`);
+  } else console.log('Резервные копии пока не созданы.');
+  console.log(`Копий: почасовых — ${hourly.length}, ежедневных — ${daily.length}.`);
+}
+
+try {
+  insideStand(root);
+  switch (command) {
+    case 'backup': backup(); break;
+    case 'prepare-restore': prepareRestore(argument); break;
+    case 'apply-restore': applyRestore(argument); break;
+    case 'status': status(); break;
+    default: throw new Error('Неизвестная команда резервного копирования.');
+  }
+} catch (error) {
+  // Не печатаем содержимое базы, SQL и произвольные сообщения SQLite.
+  const detail = error.code || (error.message.startsWith('П') || error.message.startsWith('О') || error.message.startsWith('Н') ? error.message : 'ошибка SQLite или файлов');
+  console.error(`Ошибка: ${detail}`);
+  process.exitCode = 1;
+}
