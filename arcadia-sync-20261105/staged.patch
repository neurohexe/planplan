+"""Даты как в JavaScript (движок V8 в Node 22).
+
+* parse() повторяет Date.parse(): сначала формат ISO из ECMAScript, затем «старый» разбор V8,
+  который принимает очень многое ("Nov 3 2026", "2026/11/03", даже "hello 5"). Правила проверяли
+  даты через !isNaN(new Date(value)), поэтому для совпадения результата разбор перенесён по
+  устройству V8 (src/date/dateparser*), а не упрощённо.
+* iso() повторяет Date.prototype.toISOString().
+* Локальное время (часовой пояс процесса, переменная TZ) — как у Node на том же компьютере.
+"""
+
+from __future__ import annotations
+
+import math
+import re
+import time
+from typing import Any
+
+from . import context
+from .js import JS_WS_CHARS, NAN, is_str, to_str, truthy
+
+MS_PER_DAY = 86_400_000
+MAX_TIME_MS = 8.64e15
+MAX_TIME_BEFORE_UTC_MS = MAX_TIME_MS + 864_000_000
+
+_WS = frozenset(JS_WS_CHARS)
+_NONE = 2**31 - 1  # kNone в V8
+_MAX_SIGNIFICANT_DIGITS = 9
+
+
+# ---------------------------------------------------------------------------
+# Календарь (пролептический григорианский, любые годы)
+
+
+def days_from_civil(year: int, month: int, day: int) -> int:
+    year -= month <= 2
+    era = year // 400
+    yoe = year - era * 400
+    doy = (153 * (month + (-3 if month > 2 else 9)) + 2) // 5 + day - 1
+    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
+    return era * 146097 + doe - 719468
+
+
+def civil_from_days(days: int) -> tuple[int, int, int]:
+    days += 719468
+    era = days // 146097
+    doe = days - era * 146097
+    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
+    year = yoe + era * 400
+    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
+    mp = (5 * doy + 2) // 153
+    day = doy - (153 * mp + 2) // 5 + 1
+    month = mp + 3 if mp < 10 else mp - 9
+    return year + (month <= 2), month, day
+
+
+def _to_integer(value: float) -> float:
+    return float(math.trunc(value)) if math.isfinite(value) else value
+
+
+def make_day(year: float, month: float, date: float) -> float:
+    """MakeDay из V8 (src/date/date.cc)."""
+    if not (-1_000_000 <= year <= 1_000_000 and -10_000_000 <= month <= 10_000_000 and math.isfinite(date)):
+        return NAN
+    y = int(year)
+    m = int(month)
+    y += int(m / 12)
+    m = int(math.fmod(m, 12))
+    if m < 0:
+        m += 12
+        y -= 1
+    return float(days_from_civil(y, m + 1, 1) - 1) + _to_integer(date)
+
+
+def make_time(hour: float, minute: float, second: float, ms: float) -> float:
+    if not all(math.isfinite(value) for value in (hour, minute, second, ms)):
+        return NAN
+    return (
+        _to_integer(hour) * 3_600_000
+        + _to_integer(minute) * 60_000
+        + _to_integer(second) * 1_000
+        + _to_integer(ms)
+    )
+
+
+def time_clip(value: float) -> float:
+    if not math.isfinite(value) or abs(value) > MAX_TIME_MS:
+        return NAN
+    return float(math.trunc(value))
+
+
+# ---------------------------------------------------------------------------
+# Часовой пояс процесса
+
+
+_MIN_SECONDS = -62_135_596_800  # 0001-01-01
+_MAX_SECONDS = 253_402_300_799  # 9999-12-31
+_CYCLE_SECONDS = 146_097 * 86_400  # 400 лет
+
+
+def local_offset_ms(utc_ms: float) -> int:
+    """Смещение местного времени от UTC в момент utc_ms (как getTimezoneOffset(), но со знаком «+»)."""
+    seconds = math.floor(utc_ms / 1000)
+    if seconds > _MAX_SECONDS:
+        # Python не работает с годами после 9999. Григорианский календарь повторяется каждые
+        # 400 лет, а правила перехода на летнее время в далёком будущем зависят только от
+        # календаря, поэтому берём тот же момент, сдвинутый на целое число 400-летних циклов.
+        cycles = (seconds - _MAX_SECONDS) // _CYCLE_SECONDS + 1
+        seconds -= cycles * _CYCLE_SECONDS
+    elif seconds < _MIN_SECONDS:
+        seconds = _MIN_SECONDS
+    try:
+        return time.localtime(seconds).tm_gmtoff * 1000
+    except (OverflowError, OSError, ValueError):
+        return 0
+
+
+def local_to_utc(local_ms: float) -> float:
+    guess = local_ms - local_offset_ms(local_ms)
+    return local_ms - local_offset_ms(guess)
+
+
+# ---------------------------------------------------------------------------
+# toISOString
+
+
+def ymd_hms(ms: float) -> tuple[int, int, int, int, int, int, int]:
+    total = int(ms)
+    days, rest = divmod(total, MS_PER_DAY)
+    year, month, day = civil_from_days(days)
+    hour, rest = divmod(rest, 3_600_000)
+    minute, rest = divmod(rest, 60_000)
+    second, millisecond = divmod(rest, 1_000)
+    return year, month, day, hour, minute, second, millisecond
+
+
+def iso(ms: float) -> str:
+    """new Date(ms).toISOString()."""
+    if not math.isfinite(ms) or abs(ms) > MAX_TIME_MS:
+        raise ValueError("Invalid time value")
+    year, month, day, hour, minute, second, millisecond = ymd_hms(ms)
+    if 0 <= year <= 9999:
+        year_text = f"{year:04d}"
+    else:
+        year_text = ("+" if year > 0 else "-") + f"{abs(year):06d}"
+    return f"{year_text}-{month:02d}-{day:02d}T{hour:02d}:{minute:02d}:{second:02d}.{millisecond:03d}Z"
+
+
+def now_iso() -> str:
+    """new Date().toISOString()."""
+    return iso(context.now_ms())
+
+
+def local_parts(ms: float) -> tuple[int, int, int]:
+    """getFullYear(), getMonth()+1, getDate() в часовом поясе процесса."""
+    year, month, day, *_ = ymd_hms(ms + local_offset_ms(ms))
+    return year, month, day
+
+
+# ---------------------------------------------------------------------------
+# Date.parse по устройству V8
+
+_END, _NUMBER, _SYMBOL, _WHITE, _KEYWORD, _UNKNOWN, _INVALID = range(7)
+_KW_INVALID, _MONTH_NAME, _TIME_ZONE_NAME, _TIME_SEPARATOR, _AM_PM = range(5)
+
+_KEYWORDS = (
+    ("jan", _MONTH_NAME, 1), ("feb", _MONTH_NAME, 2), ("mar", _MONTH_NAME, 3), ("apr", _MONTH_NAME, 4),
+    ("may", _MONTH_NAME, 5), ("jun", _MONTH_NAME, 6), ("jul", _MONTH_NAME, 7), ("aug", _MONTH_NAME, 8),
+    ("sep", _MONTH_NAME, 9), ("oct", _MONTH_NAME, 10), ("nov", _MONTH_NAME, 11), ("dec", _MONTH_NAME, 12),
+    ("am\0", _AM_PM, 0), ("pm\0", _AM_PM, 12),
+    ("ut\0", _TIME_ZONE_NAME, 0), ("utc", _TIME_ZONE_NAME, 0), ("z\0\0", _TIME_ZONE_NAME, 0),
+    ("gmt", _TIME_ZONE_NAME, 0), ("cdt", _TIME_ZONE_NAME, -5), ("cst", _TIME_ZONE_NAME, -6),
+    ("edt", _TIME_ZONE_NAME, -4), ("est", _TIME_ZONE_NAME, -5), ("mdt", _TIME_ZONE_NAME, -6),
+    ("mst", _TIME_ZONE_NAME, -7), ("pdt", _TIME_ZONE_NAME, -7), ("pst", _TIME_ZONE_NAME, -8),
+    ("t\0\0", _TIME_SEPARATOR, 0),
+)
+
+
+class _Token:
+    __slots__ = ("kind", "value", "length", "ktype")
+
+    def __init__(self, kind: int, value: int = 0, length: int = 0, ktype: int = _KW_INVALID):
+        self.kind = kind
+        self.value = value
+        self.length = length
+        self.ktype = ktype
+
+    def is_number(self) -> bool:
+        return self.kind == _NUMBER
+
+    def is_symbol(self, symbol: str | None = None) -> bool:
+        return self.kind == _SYMBOL and (symbol is None or self.value == ord(symbol))
+
+    def is_sign(self) -> bool:
+        return self.kind == _SYMBOL and self.value in (43, 45)
+
+    def sign(self) -> int:
+        return 44 - self.value
+
+    def is_fixed_number(self, length: int) -> bool:
+        return self.kind == _NUMBER and self.length == length
+
+    def is_keyword_type(self, ktype: int) -> bool:
+        return self.kind == _KEYWORD and self.ktype == ktype
+
+    def is_keyword_z(self) -> bool:
+        return self.kind == _KEYWORD and self.ktype == _TIME_ZONE_NAME and self.length == 1 and self.value == 0
+
+
+def _keyword_lookup(prefix: list[str], length: int) -> tuple[int, int]:
+    for text, ktype, value in _KEYWORDS:
+        if all(prefix[index] == text[index] for index in range(3)) and (length <= 3 or ktype == _MONTH_NAME):
+            return ktype, value
+    return _KW_INVALID, 0
+
+
+class _Scanner:
+    def __init__(self, text: str):
+        end = text.find("\0")
+        self.text = text if end < 0 else text[:end]
+        self.pos = 0
+        self.next = self._scan()
+
+    def _ch(self) -> str:
+        return self.text[self.pos] if self.pos < len(self.text) else ""
+
+    def _scan(self) -> _Token:
+        start = self.pos
+        ch = self._ch()
+        if ch == "":
+            return _Token(_END)
+        if "0" <= ch <= "9":
+            while self._ch() == "0":
+                self.pos += 1
+            number = 0
+            count = 0
+            while "0" <= self._ch() <= "9":
+                if count < _MAX_SIGNIFICANT_DIGITS:
+                    number = number * 10 + ord(self._ch()) - 48
+                count += 1
+                self.pos += 1
+            return _Token(_NUMBER, number, self.pos - start)
+        if ch in ":-+.)":
+            self.pos += 1
+            return _Token(_SYMBOL, ord(ch), 1)
+        if ch >= "A" and ch not in _WS:
+            prefix = ["\0", "\0", "\0"]
+            length = 0
+            while self._ch() >= "A" and self._ch() not in _WS and self._ch() != "":
+                if length < 3:
+                    prefix[length] = chr(ord(self._ch()) | 0x20)
+                length += 1
+                self.pos += 1
+            ktype, value = _keyword_lookup(prefix, length)
+            return _Token(_KEYWORD, value, length, ktype)
+        if ch in _WS:
+            self.pos += 1
+            return _Token(_WHITE, 0, 1)
+        if ch == "(":
+            balance = 0
+            while True:
+                current = self._ch()
+                if current == ")":
+                    balance -= 1
+                elif current == "(":
+                    balance += 1
+                self.pos += 1
+                if not (balance > 0 and self._ch() != ""):
+                    break
+            return _Token(_UNKNOWN)
+        self.pos += 1
+        return _Token(_UNKNOWN)
+
+    def take(self) -> _Token:
+        result = self.next
+        self.next = self._scan()
+        return result
+
+    def skip_symbol(self, symbol: str) -> bool:
+        if self.next.is_symbol(symbol):
+            self.next = self._scan()
+            return True
+        return False
+
+
+def _between(value: int, low: int, high: int) -> bool:
+    return low <= value <= high
+
+
+class _Time:
+    def __init__(self):
+        self.comp = [0, 0, 0, 0]
+        self.index = 0
+        self.hour_offset = _NONE
+
+    def empty(self) -> bool:
+        return self.index == 0
+
+    def expecting(self, n: int) -> bool:
+        return (self.index == 1 and _between(n, 0, 59)) or (self.index == 2 and _between(n, 0, 59)) or (
+            self.index == 3 and _between(n, 0, 999)
+        )
+
+    def add(self, n: int) -> bool:
+        if self.index < 4:
+            self.comp[self.index] = n
+            self.index += 1
+            return True
+        return False
+
+    def add_final(self, n: int) -> bool:
+        if not self.add(n):
+            return False
+        while self.index < 4:
+            self.comp[self.index] = 0
+            self.index += 1
+        return True
+
+    def write(self) -> tuple[int, int, int, int] | None:
+        while self.index < 4:
+            self.comp[self.index] = 0
+            self.index += 1
+        hour, minute, second, millisecond = self.comp
+        if self.hour_offset != _NONE:
+            if not _between(hour, 0, 12):
+                return None
+            hour %= 12
+            hour += self.hour_offset
+        if not (_between(hour, 0, 23) and _between(minute, 0, 59) and _between(second, 0, 59) and _between(millisecond, 0, 999)):
+            if hour != 24 or minute != 0 or second != 0 or millisecond != 0:
+                return None
+        return hour, minute, second, millisecond
+
+
+class _Zone:
+    def __init__(self):
+        self.sign = _NONE
+        self.hour = _NONE
+        self.minute = _NONE
+
+    def set(self, offset_hours: int) -> None:
+        self.sign = -1 if offset_hours < 0 else 1
+        self.hour = offset_hours * self.sign
+        self.minute = 0
+
+    def set_sign(self, sign: int) -> None:
+        self.sign = -1 if sign < 0 else 1
+
+    def expecting(self, n: int) -> bool:
+        return self.hour != _NONE and self.minute == _NONE and _between(n, 0, 59)
+
+    def is_utc(self) -> bool:
+        return self.hour == 0 and self.minute == 0
+
+    def empty(self) -> bool:
+        return self.sign == _NONE and self.hour == _NONE and self.minute == _NONE
+
+    def write(self) -> tuple[bool, float | None]:
+        if self.sign != _NONE:
+            hour = 0 if self.hour == _NONE else self.hour
+            minute = 0 if self.minute == _NONE else self.minute
+            total = hour * 3600 + minute * 60
+            if total > 2**30 - 1:
+                return False, None
+            return True, float(-total if self.sign < 0 else total)
+        return True, None
+
+
+class _Day:
+    def __init__(self):
+        self.comp = [0, 0, 0]
+        self.index = 0
+        self.named_month = _NONE
+        self.iso = False
+
+    def empty(self) -> bool:
+        return self.index == 0
+
+    def add(self, n: int) -> bool:
+        if self.index < 3:
+            self.comp[self.index] = n
+            self.index += 1
+            return True
+        return False
+
+    def write(self) -> tuple[int, int, int] | None:
+        if self.index < 1:
+            return None
+        while self.index < 3:
+            self.comp[self.index] = 1
+            self.index += 1
+        year = 0
+        if self.named_month == _NONE:
+            if self.iso or not _between(self.comp[0], 1, 31):
+                year, month, day = self.comp
+            else:
+                month, day, year = self.comp
+        else:
+            month = self.named_month
+            if not _between(self.comp[0], 1, 31):
+                year, day = self.comp[0], self.comp[1]
+            else:
+                day, year = self.comp[0], self.comp[1]
+        if not self.iso:
+            if _between(year, 0, 49):
+                year += 2000
+            elif _between(year, 50, 99):
+                year += 1900
+        if not (-(2**30) <= year <= 2**30 - 1) or not _between(month, 1, 12) or not _between(day, 1, 31):
+            return None
+        return year, month - 1, day
+
+
+def _read_milliseconds(token: _Token) -> int:
+    number = token.value
+    length = token.length
+    if length == 1:
+        number *= 100
+    elif length == 2:
+        number *= 10
+    elif length > 3:
+        length = min(length, _MAX_SIGNIFICANT_DIGITS)
+        factor = 1
+        while length > 3:
+            factor *= 10
+            length -= 1
+        number //= factor
+    return number
+
+
+def _parse_es5(scanner: _Scanner, day: _Day, clock: _Time, zone: _Zone) -> _Token:
+    if scanner.next.is_sign():
+        sign_token = scanner.take()
+        if not scanner.next.is_fixed_number(6):
+            return sign_token
+        sign = sign_token.sign()
+        year = scanner.take().value
+        if sign < 0 and year == 0:
+            return sign_token
+        day.add(sign * year)
+    elif scanner.next.is_fixed_number(4):
+        day.add(scanner.take().value)
+    else:
+        return scanner.take()
+    if scanner.skip_symbol("-"):
+        if not scanner.next.is_fixed_number(2) or not _between(scanner.next.value, 1, 12):
+            return scanner.take()
+        day.add(scanner.take().value)
+        if scanner.skip_symbol("-"):
+            if not scanner.next.is_fixed_number(2) or not _between(scanner.next.value, 1, 31):
+                return scanner.take()
+            day.add(scanner.take().value)
+    if not scanner.next.is_keyword_type(_TIME_SEPARATOR):
+        if scanner.next.kind != _END:
+            return scanner.take()
+    else:
+        scanner.take()
+        if not scanner.next.is_fixed_number(2) or not _between(scanner.next.value, 0, 24):
+            return _Token(_INVALID)
+        hour_is_24 = scanner.next.value == 24
+        clock.add(scanner.take().value)
+        if not scanner.skip_symbol(":"):
+            return _Token(_INVALID)
+        if not scanner.next.is_fixed_number(2) or not _between(scanner.next.value, 0, 59) or (
+            hour_is_24 and scanner.next.value > 0
+        ):
+            return _Token(_INVALID)
+        clock.add(scanner.take().value)
+        if scanner.skip_symbol(":"):
+            if not scanner.next.is_fixed_number(2) or not _between(scanner.next.value, 0, 59) or (
+                hour_is_24 and scanner.next.value > 0
+            ):
+                return _Token(_INVALID)
+            clock.add(scanner.take().value)
+            if scanner.skip_symbol("."):
+                if not scanner.next.is_number() or (hour_is_24 and scanner.next.value > 0):
+                    return _Token(_INVALID)
+                clock.add(_read_milliseconds(scanner.take()))
+        if scanner.next.is_keyword_z():
+            scanner.take()
+            zone.set(0)
+        elif scanner.next.is_symbol("+") or scanner.next.is_symbol("-"):
+            zone.set_sign(1 if scanner.take().value == ord("+") else -1)
+            if scanner.next.is_fixed_number(4):
+                hourmin = scanner.take().value
+                hour, minute = divmod(hourmin, 100)
+                if not _between(hour, 0, 23) or not _between(minute, 0, 59):
+                    return _Token(_INVALID)
+                zone.hour = hour
+                zone.minute = minute
+            else:
+                if not scanner.next.is_fixed_number(2) or not _between(scanner.next.value, 0, 23):
+                    return _Token(_INVALID)
+                zone.hour = scanner.take().value
+                if not scanner.skip_symbol(":"):
+                    return _Token(_INVALID)
+                if not scanner.next.is_fixed_number(2) or not _between(scanner.next.value, 0, 59):
+                    return _Token(_INVALID)
+                zone.minute = scanner.take().value
+        if scanner.next.kind != _END:
+            return _Token(_INVALID)
+    if zone.empty() and clock.empty():
+        zone.set(0)
+    day.iso = True
+    return _Token(_END)
+
+
+def _parse_fields(text: str) -> tuple[tuple[int, int, int], tuple[int, int, int, int], float | None] | None:
+    scanner = _Scanner(text)
+    clock = _Time()
+    zone = _Zone()
+    day = _Day()
+    token = _parse_es5(scanner, day, clock, zone)
+    if token.kind == _INVALID:
+        return None
+    has_read_number = not day.empty()
+    while token.kind != _END:
+        if token.kind == _NUMBER:
+            has_read_number = True
+            n = token.value
+            if scanner.skip_symbol(":"):
+                if scanner.skip_symbol(":"):
+                    if not clock.empty():
+                        return None
+                    clock.add(n)
+                    clock.add(0)
+                else:
+                    if not clock.add(n):
+                        return None
+                    if scanner.next.is_symbol("."):
+                        scanner.take()
+            elif scanner.skip_symbol(".") and clock.expecting(n):
+                clock.add(n)
+                if not scanner.next.is_number():
+                    return None
+                ms = _read_milliseconds(scanner.take())
+                if ms < 0:
+                    return None
+                clock.add_final(ms)
+            elif zone.expecting(n):
+                zone.minute = n
+            elif clock.expecting(n):
+                clock.add_final(n)
+                peek = scanner.next
+                if peek.kind not in (_END, _WHITE) and not peek.is_keyword_z() and not peek.is_sign():
+                    return None
+            else:
+                if not day.add(n):
+                    return None
+                scanner.skip_symbol("-")
+        elif token.kind == _KEYWORD:
+            if token.ktype == _AM_PM and not clock.empty():
+                clock.hour_offset = token.value
+            elif token.ktype == _MONTH_NAME:
+                day.named_month = token.value
+                scanner.skip_symbol("-")
+            elif token.ktype == _TIME_ZONE_NAME and has_read_number:
+                zone.set(token.value)
+            else:
+                if has_read_number:
+                    return None
+                if scanner.next.is_number():
+                    return None
+        elif token.is_sign() and (zone.is_utc() or not clock.empty()):
+            zone.set_sign(token.sign())
+            n = 0
+            length = 0
+            if scanner.next.is_number():
+                number_token = scanner.take()
+                length = number_token.length
+                n = number_token.value
+            has_read_number = True
+            if scanner.next.is_symbol(":"):
+                zone.hour = n
+                zone.minute = _NONE
+            elif length in (1, 2):
+                zone.hour = n
+                zone.minute = 0
+            elif length in (3, 4):
+                zone.hour = n // 100
+                zone.minute = n % 100
+            else:
+                return None
+        elif (token.is_sign() or token.is_symbol(")")) and has_read_number:
+            return None
+        token = scanner.take()
+    date = day.write()
+    if date is None:
+        return None
+    clock_parts = clock.write()
+    if clock_parts is None:
+        return None
+    ok, offset = zone.write()
+    if not ok:
+        return None
+    return date, clock_parts, offset
+
+
+_CANONICAL_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})(?:T([0-9]{2}):([0-9]{2}):([0-9]{2})\.([0-9]{3})Z)?\Z")
+
+
+def _canonical(text: str) -> float | None:
+    """Быстрый путь для строк вида toISOString() и YYYY-MM-DD (так записаны почти все даты в данных).
+    Результат тот же, что у полного разбора; строки с выходом за допустимые поля разбираются полностью."""
+    match = _CANONICAL_RE.match(text)
+    if match is None:
+        return None
+    year, month, day = int(match.group(1)), int(match.group(2)), int(match.group(3))
+    if not (1 <= month <= 12 and 1 <= day <= 31):
+        return None
+    if match.group(4) is None:
+        return float(days_from_civil(year, 1, 1) + _DAYS_BEFORE_MONTH[month - 1] + _leap_shift(year, month) + day - 1) * MS_PER_DAY
+    hour, minute, second, millisecond = (int(match.group(index)) for index in (4, 5, 6, 7))
+    if not (hour <= 23 and minute <= 59 and second <= 59):
+        return None
+    days = days_from_civil(year, 1, 1) + _DAYS_BEFORE_MONTH[month - 1] + _leap_shift(year, month) + day - 1
+    return float(days * MS_PER_DAY + hour * 3_600_000 + minute * 60_000 + second * 1000 + millisecond)
+
+
+_DAYS_BEFORE_MONTH = (0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334)
+
+
+def _leap_shift(year: int, month: int) -> int:
+    return 1 if month > 2 and year % 4 == 0 and (year % 100 != 0 or year % 400 == 0) else 0
+
+
+def parse(value: Any) -> float:
+    """Date.parse(value) / new Date(value).getTime() для строк. NaN — недопустимая дата."""
+    text = value if is_str(value) else ""
+    quick = _canonical(text)
+    if quick is not None:
+        return quick
+    fields = _parse_fields(text)
+    if fields is None:
+        return NAN
+    (year, month, day), (hour, minute, second, millisecond), offset = fields
+    day_number = make_day(float(year), float(month), float(day))
+    moment = day_number * MS_PER_DAY + make_time(hour, minute, second, millisecond)
+    if not math.isfinite(moment):
+        return NAN
+    if offset is None:
+        if abs(moment) > MAX_TIME_BEFORE_UTC_MS:
+            return NAN
+        moment = local_to_utc(moment)
+    else:
+        moment -= offset * 1000.0
+        if abs(moment) > MAX_TIME_MS:
+            return NAN
+    return time_clip(moment)
+
+
+def valid_iso_datetime(value: Any) -> bool:
+    """typeof value === "string" && !Number.isNaN(new Date(value).getTime())."""
+    return is_str(value) and not math.isnan(parse(value))
+
+
+_DATE_INPUT_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})\Z")
+
+
+def _calendar_date_ok(year: int, month: int, day: int) -> bool:
+    # Конструкторы Date(y, m, d) и Date.UTC(y, m, d) переносят годы 0–99 в 1900–1999, поэтому
+    # такие даты в JavaScript не проходят проверку «год совпал».
+    if year < 100 or not 1 <= month <= 12 or day < 1:
+        return False
+    days_in_month = (31, 29 if (year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)) else 28, 31, 30, 31, 30,
+                     31, 31, 30, 31, 30, 31)[month - 1]
+    return day <= days_in_month
+
+
+def valid_date_input(value: Any) -> bool:
+    """validDateInput() из app.js: строка YYYY-MM-DD с существующей датой."""
+    match = _DATE_INPUT_RE.match(to_str(value if truthy(value) else ""))
+    if not match:
+        return False
+    if not is_str(value):
+        # В JavaScript дальше вызывается value.split(): у не-строки его нет, и правило падает.
+        raise TypeError("value.split is not a function")
+    return _calendar_date_ok(int(match.group(1)), int(match.group(2)), int(match.group(3)))
+
+
+def timezone_offset_minutes(ms: float) -> int:
+    """getTimezoneOffset() в V8: целые минуты, дробная часть отбрасывается (для местного среднего
+    времени до XIX века, например +2:30:17 в Москве, получается 150, а не 150,28)."""
+    return int(-local_offset_ms(ms) / 60000)
+
+
+def to_date_input_value(ms: float) -> str:
+    """toDateInputValue(new Date(ms)) из app.js: дата в часовом поясе процесса."""
+    return iso(ms - timezone_offset_minutes(ms) * 60000)[:10]
