+// Сверка переноса: та же логика в JavaScript (исходные app/*.js и backend/src/*.js).
+// Получает задание JSON на stdin, отвечает JSON на stdout. Часы и идентификаторы фиксированы,
+// чтобы результат совпадал с Python побайтно: new Date() → текущее «время» шага,
+// crypto.randomUUID() → "<префикс>-<номер>".
+"use strict";
+
+const path = require("node:path");
+
+const repo = process.env.PLAN_FACT_REPO_ROOT || path.resolve(__dirname, "..", "..", "..");
+
+const RealDate = Date;
+// «Запуск сервера»: app.js при загрузке запоминает выбранный квартал (selectedQuarterKey) по текущей дате.
+const STARTUP_MS = Number(process.env.PLAN_FACT_STARTUP_MS || 1790000000000);
+let fakeNow = STARTUP_MS;
+class FakeDate extends RealDate {
+  constructor(...args) {
+    if (args.length === 0) super(fakeNow);
+    else super(...args);
+  }
+
+  static now() {
+    return fakeNow;
+  }
+}
+globalThis.Date = FakeDate;
+
+let idPrefix = "id";
+let idCounter = 0;
+Object.defineProperty(globalThis, "crypto", {
+  configurable: true,
+  writable: true,
+  value: { randomUUID: () => `${idPrefix}-${++idCounter}` }
+});
+
+const app = require(path.join(repo, "app", "app.js"));
+const domain = require(path.join(repo, "backend", "src", "domain.js"));
+const accessControl = require(path.join(repo, "backend", "src", "access-control.js"));
+const service = require(path.join(repo, "backend", "src", "service.js"));
+
+function describeError(error) {
+  return {
+    ok: false,
+    error: String(error && error.message),
+    statusCode: error && error.statusCode ? error.statusCode : null,
+    code: error && error.code ? error.code : null,
+    name: error && error.constructor ? error.constructor.name : null
+  };
+}
+
+function run(step, fn) {
+  fakeNow = step.now;
+  idPrefix = step.idPrefix || "id";
+  idCounter = 0;
+  try {
+    return { ok: true, value: fn() };
+  } catch (error) {
+    return describeError(error);
+  }
+}
+
+function hiddenMap(value) {
+  return new Map(Object.entries(value || {}));
+}
+
+const calls = {
+  normalizeState: (input) => app.normalizeState(input),
+  applyLocalMutation: (state, type, payload) => app.applyLocalMutation(state, type, payload),
+  projectState: (state, user, access, hidden) => domain.projectState(state, user, access, hiddenMap(hidden)),
+  stampActor: (before, after, user) => domain.stampActor(before, after, user),
+  authorizeMutation: (input) => { domain.authorizeMutation(input); return true; },
+  authorizeLock: (input) => { domain.authorizeLock(input); return true; },
+  assertImportLocations: (before, after, user, access) => { domain.assertImportLocations(before, after, user, access); return true; },
+  mutationLocationIds: (type, payload, state) => domain.mutationLocationIds(type, payload, state),
+  changedLocationIds: (before, after) => domain.changedLocationIds(before, after),
+  lockResource: (type, payload) => domain.lockResource(type, payload),
+  auditEntity: (type, payload) => domain.auditEntity(type, payload),
+  warningLocation: (state, warning) => domain.warningLocation(state, warning),
+  visibleState: (state, account) => accessControl.visibleState(state, account),
+  locationAccess: (user, access, locationId) => domain.locationAccess(user, access, locationId),
+  sanitizeAuditPayload: (payload) => service.sanitizeAuditPayload(payload),
+  cleanPayload: (payload, user) => service.cleanPayload(payload, user),
+  canRetryCreateMutation: (type, payload, state) => service.canRetryCreateMutation(type, payload, state),
+  normalizeAccessCode: (value) => service.normalizeAccessCode(value),
+  dateParse: (value) => {
+    const time = new Date(value).getTime();
+    return Number.isNaN(time) ? null : time;
+  },
+  localeCompare: (left, right) => Math.sign(left.localeCompare(right, "ru")),
+  safeUrl: (value) => {
+    try {
+      const url = new URL(String(value || ""));
+      return ["http:", "https:"].includes(url.protocol) ? url.href : "";
+    } catch {
+      return "";
+    }
+  }
+};
+
+function main(input) {
+  if (input.mode === "sequences") {
+    return input.sequences.map((sequence) => {
+      let state = sequence.initial;
+      return sequence.steps.map((step) => {
+        const result = run(step, () => app.applyLocalMutation(state, step.type, step.payload));
+        if (result.ok) state = result.value;
+        return result;
+      });
+    });
+  }
+  if (input.mode === "calls") {
+    return input.calls.map((call) => run(call, () => calls[call.fn](...call.args)));
+  }
+  throw new Error(`unknown mode ${input.mode}`);
+}
+
+let raw = "";
+process.stdin.setEncoding("utf8");
+process.stdin.on("data", (chunk) => { raw += chunk; });
+process.stdin.on("end", () => {
+  const output = main(JSON.parse(raw));
+  process.stdout.write(JSON.stringify(output));
+});
