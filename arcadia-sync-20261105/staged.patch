+            session_id=event.get("sessionId") or None,
+            action=event["action"],
+            mutation_id=event.get("mutationId") or None,
+            entity_type=event.get("entityType") or None,
+            entity_id=js.S(event["entityId"]) if js.truthy(event.get("entityId")) else None,
+            location_id=js.S(event["locationId"]) if js.truthy(event.get("locationId")) else None,
+            payload_json=event.get("payload") or {},
+            before_json=event.get("before"),
+            after_json=event.get("after"),
+            reverses_event_id=event.get("reversesEventId") or None,
+            created_at=from_iso(event["createdAt"]) if event.get("createdAt") else now_dt(),
+        )
+        return event_id
+
+    def find_audit_by_mutation_id(self, mutation_id: str | None) -> dict | None:
+        if not mutation_id:
+            return None
+        row = AuditEvent.objects.filter(mutation_id=mutation_id).values("id").first()
+        return {"id": row["id"]} if row else None
+
+    def list_audit(self, *, actor_id: str | None = None, limit: Any = 100, before: datetime | None = None) -> list[dict]:
+        rows = AuditEvent.objects.all()
+        if actor_id:
+            rows = rows.filter(actor_id=actor_id)
+        if before is not None:
+            rows = rows.filter(created_at__lt=before)
+        count = audit_limit(limit)
+        return [
+            {
+                "id": row.id,
+                "revision": row.revision,
+                "actorId": row.actor_id,
+                "actorName": row.actor_name,
+                "sessionId": row.session_id,
+                "action": row.action,
+                "mutationId": row.mutation_id,
+                "entityType": row.entity_type,
+                "entityId": row.entity_id,
+                "locationId": row.location_id,
+                "payload": row.payload_json if row.payload_json is not None else {},
+                "reversesEventId": row.reverses_event_id,
+                "createdAt": iso(row.created_at),
+            }
+            for row in rows.order_by("-created_at", "-id")[:count]
+        ]
+
+    # --- блокировки записей
+
+    def cleanup_locks(self) -> None:
+        EditLock.objects.filter(expires_at__lte=now_dt()).delete()
+
+    def acquire_lock(self, data: dict) -> dict:
+        with transaction.atomic():
+            self.cleanup_locks()
+            EditLock.objects.bulk_create([EditLock(
+                resource_type=data["resourceType"], resource_id=data["resourceId"], owner_user_id=data["userId"],
+                owner_session_id=data["sessionId"], token_hash=data["tokenHash"], acquired_at=from_iso(data["now"]),
+                expires_at=from_iso(data["expiresAt"]),
+            )], ignore_conflicts=True)
+            lock = EditLock.objects.select_for_update().select_related("owner_user").get(
+                resource_type=data["resourceType"], resource_id=data["resourceId"]
+            )
+            if lock.owner_session_id == data["sessionId"] and lock.owner_user_id == data["userId"]:
+                lock.token_hash = data["tokenHash"]
+                lock.expires_at = from_iso(data["expiresAt"])
+                lock.save(update_fields=["token_hash", "expires_at"])
+                return {"acquired": True}
+            return {"acquired": False, "lock": _lock_dict(lock)}
+
+    def get_lock(self, resource_type: str, resource_id: str) -> dict | None:
+        self.cleanup_locks()
+        lock = EditLock.objects.select_related("owner_user").filter(resource_type=resource_type, resource_id=resource_id).first()
+        return _lock_dict(lock) if lock else None
+
+    def refresh_lock(self, resource_type: Any, resource_id: str, session_id: str, token_hash: str, expires_at: str) -> bool:
+        if not isinstance(resource_type, str):
+            return False
+        updated = EditLock.objects.filter(
+            resource_type=resource_type, resource_id=resource_id, owner_session_id=session_id, token_hash=token_hash,
+            expires_at__gt=now_dt(),
+        ).update(expires_at=from_iso(expires_at))
+        return updated == 1
+
+    def release_lock(self, resource_type: Any, resource_id: str, session_id: str, token_hash: str) -> bool:
+        if not isinstance(resource_type, str):
+            return False
+        deleted = EditLock.objects.filter(
+            resource_type=resource_type, resource_id=resource_id, owner_session_id=session_id, token_hash=token_hash
+        ).delete()[0]
+        return deleted == 1
+
+    def release_session_locks(self, session_id: str) -> None:
+        EditLock.objects.filter(owner_session_id=session_id).delete()
+
+    def delete_locks_by_user(self, user_id: str) -> None:
+        EditLock.objects.filter(owner_user_id=user_id).delete()
+
+    # --- личные скрытия предупреждений
