+    def test_initial_state_is_created_once_and_audit_is_immutable(self):
+        state = self.service.get_state()
+        self.assertEqual(state["revision"], 0)
+        self.assertEqual(state["locations"][0]["id"], "default")
+        self.service.store.ensure_state(self.service.initial_state())
+        self.assertEqual(self.service.get_state(), state)
+        event = AuditEvent.objects.first()
+        with self.assertRaises(DatabaseError), transaction.atomic():
+            AuditEvent.objects.filter(id=event.id).update(action="tampered")
+        with self.assertRaises(DatabaseError), transaction.atomic():
+            AuditEvent.objects.filter(id=event.id).delete()
+
+    def test_audit_payload_masks_sensitive_keys_recursively(self):
+        self.mutate(self.alice_session, "addArticle", {"id": "p", "name": "Проект", "code": "P", "token": "t",
+                                                        "nested": [{"lockToken": "x", "pin": 1}]}, "mask-test-1")
+        event = next(item for item in self.service.store.list_audit() if item["mutationId"] == "mask-test-1")
+        self.assertEqual(event["payload"]["token"], "***")
+        self.assertEqual(event["payload"]["nested"], [{"lockToken": "***", "pin": "***"}])
+        self.assertEqual(event["payload"]["author"], "Алиса")
+
+    def test_realtime_state_changed_does_not_expose_actor_identity(self):
+        published = []
+        with mock.patch.object(self.service.realtime, "publish", side_effect=published.append):
+            with self.captureOnCommitCallbacks(execute=True):
+                self.mutate(self.alice_session, "updateLocation", {"id": "default", "name": "Офис"})
+        self.assertEqual(published, [{"type": "state-changed", "revision": 1, "mutationType": "updateLocation"}])
+
+    def test_provisioning_is_idempotent_and_rejects_role_conflicts(self):
+        results = self.service.provision_staff_accounts([
+            {"staffLogin": "alice", "name": "alice", "role": "superadmin"}, {"staffLogin": "carol", "name": "carol", "role": "user"},
+        ])
+        self.assertEqual([item["created"] for item in results], [False, True])
+        self.assertEqual(results[1]["account"]["defaultLocationAccess"], "hidden")
+        with self.assertRaisesMessage(ConflictError, "Staff login bob уже существует с другим статусом или ролью"):
+            self.service.provision_staff_accounts([{"staffLogin": "dave", "role": "user"}, {"staffLogin": "bob", "role": "user"}])
+        self.assertIsNone(self.service.store.get_user_by_staff_login("dave"), "при конфликте никто не заводится")
+
+    def test_only_superadmin_manages_accounts_and_location_access(self):
+        with self.assertRaisesMessage(AppError, "Пользователями и доступами управляет только superadmin"):
+            self.service.list_managed_users(self.bob_session)
+        account = self.service.mutate(self.alice_session, {"type": "saveAccount", "mutationId": "save-carol-1", "payload": {
+            "staffLogin": " Carol ", "name": "  Кэрол   Иванова ", "role": "user", "defaultLocationAccess": "view",
+            "locationAccess": {"default": "edit", "missing": "edit", "x": "bogus"},
+        }})["account"]
+        self.assertEqual((account["staffLogin"], account["name"], account["defaultLocationAccess"], account["locationAccess"]),
+                         ("carol", "Кэрол Иванова", "view", {"default": "edit"}))
+        with self.assertRaisesMessage(AppError, "Аккаунты superadmin управляются только технически"):
+            self.service.mutate(self.alice_session, {"type": "archiveAccount", "mutationId": "arch-alice-1",
+                                                     "payload": {"id": self.alice["id"], "archived": True}})
+        archived = self.service.mutate(self.alice_session, {"type": "archiveAccount", "mutationId": "arch-bob-1",
+                                                            "payload": {"id": self.bob["id"], "archived": True}})["account"]
+        self.assertFalse(archived["active"])
+        self.assertIsNone(self.service.session_by_token(self.bob_token))
+        self.assertFalse(AppSession.objects.filter(user_id=self.bob["id"]).exists())
+
+    def test_logout_records_reason_and_removes_session(self):
+        self.service.logout(self.bob_session, reason="test_reason")
+        self.assertFalse(AppSession.objects.filter(id=self.bob_session["id"]).exists())
+        self.assertEqual(self.audit("auth.logout")[0]["payload"], {"reason": "test_reason"})
+
+    def test_independent_creates_rebase_on_current_revision(self):
+        self.mutate(self.alice_session, "addArticle", {"id": "p", "name": "Проект", "code": "P"})
+        base = self.service.get_state()["revision"]
+        expense = {"locationId": "default", "articleId": "p", "currency": "RUB", "amount": 10,
+                   "ticketUrl": "https://example.com/T-1", "expenseDate": "2026-11-03"}
+        self.mutate(self.alice_session, "addExpense", {**expense, "id": "e-alice"}, base=base)
+        self.mutate(self.bob_session, "addExpense", {**expense, "id": "e-bob"}, base=base)
+        self.assertEqual(sorted(item["id"] for item in self.service.get_state()["expenses"]), ["e-alice", "e-bob"])
+        with self.assertRaises(ConflictError):
+            self.mutate(self.bob_session, "updateLocation", {"id": "default", "name": "Офис"}, base=base)
+
+    def test_same_mutation_id_is_applied_once(self):
+        first = self.mutate(self.alice_session, "addLocation", {"id": "msk", "name": "Москва"}, "once-test-1")
+        again = self.mutate(self.alice_session, "addLocation", {"id": "msk", "name": "Москва"}, "once-test-1", base=0)
+        self.assertTrue(again["idempotent"])
