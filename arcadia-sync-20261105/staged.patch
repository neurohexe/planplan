+"use strict";
+
+// Задача 38: без плашки «Тестовый стенд» и с открытой локацией в шапке, пока меню задвинуто.
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const { createRequire } = require("node:module");
+const test = require("node:test");
+const vm = require("node:vm");
+const { createInitialState, normalizeState } = require("../app.js");
+
+const APP_ROOT = path.resolve(__dirname, "..");
+const APP_PATH = path.join(APP_ROOT, "app.js");
+const SOURCE = fs.readFileSync(APP_PATH, "utf8");
+const UI_KEY = "plan-fact-budget-ui-v1";
+const ALL = "__all__";
+
+function read(file) {
+  return fs.readFileSync(path.join(APP_ROOT, file), "utf8");
+}
+
+function locations(...items) {
+  return items.map(([id, name, code = "", archived = false]) => ({ id, name, code, archived }));
+}
+
+// Узел с названием: число записей innerHTML показывает, пересоздавалась ли подсказка.
+function fakeValue() {
+  return {
+    writes: 0, markup: "",
+    get innerHTML() { return this.markup; },
+    set innerHTML(value) { this.markup = value; this.writes += 1; }
+  };
+}
+
+// Настоящие renderLocations, selectLocation и renderAll из app.js; заменена только отрисовка
+// остальных блоков страницы.
+function openPage({ items, selected, user = { id: "alice", role: "superadmin" }, permissions, language = "ru",
+  storage = new Map() }) {
+  // С правами доступа (как у участника с общего сервера) пустой список не заменяется «Основной локацией».
+  const inputState = normalizeState({ ...createInitialState(), locations: items, ...(permissions ? { permissions } : {}) });
+  const field = { hidden: true };
+  const code = { textContent: "" };
+  const value = fakeValue();
+  const context = vm.createContext({
+    require: createRequire(APP_PATH), console, inputState, inputPermissions: permissions, inputUser: user,
+    inputLanguage: language, inputSelected: selected, field, code, value,
+    localStorage: {
+      getItem: (key) => storage.get(key) ?? null,
+      setItem: (key, item) => storage.set(key, String(item))
+    },
+    fetch() { throw new Error("Показ локации не должен записывать данные на сервер"); }
+  });
+  vm.runInContext(SOURCE.replace(/\}\)\(\);\s*$/, `
