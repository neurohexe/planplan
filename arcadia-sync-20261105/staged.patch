+if [ -f "$PG_BACKUPS/.last-restore-check" ]; then
+  say "  Последнее пробное восстановление: $(cat "$PG_BACKUPS/.last-restore-check")"
+else
+  say '  Пробное восстановление ещё не выполнено.'
+fi
+if grep -q PLANFACT_DJANGO_LEGACY_GUARD "$STAND/bin/common.sh"; then
+  say '  Прежние команды SQLite заблокированы для стенда Django.'
+else
+  say '  ВНИМАНИЕ: прежние команды SQLite ещё не защищены.'
