@@ -0,0 +1,115 @@
+#!/bin/bash
+# Обновление уже работающего Django: SQLite и каталог PostgreSQL не используются для замены данных.
+set -euo pipefail
+umask 077
+[ "$#" -eq 1 ] || { echo 'Использование: update-django.sh <распакованный комплект>' >&2; exit 2; }
+BUNDLE=$(CDPATH= cd -- "$1" && pwd -P)
+. "$BUNDLE/deploy/linux/django/common-django.sh"
+[ -e "$ACTIVE_MARK" ] || fail 'Стенд не работает на Django.'
+[ -f "$BUNDLE/VERSION" ] && [ -f "$DJANGO_HOME/VERSION" ] || fail 'Не найден VERSION.'
+(cd "$BUNDLE" && sha256sum --check --quiet --strict MANIFEST.sha256) || fail 'SHA-256 комплекта не совпали.'
+case "$(uname -m)/$(version_value arch "$BUNDLE/VERSION")" in x86_64/amd64 | aarch64/arm64) ;; *) fail 'Архитектура комплекта не подходит.' ;; esac
+[ "$(version_value postgresql)" = "$(version_value postgresql "$BUNDLE/VERSION")" ] || fail 'Обновление версии PostgreSQL требует отдельного переноса.'
+load_django_config
+pg_client_env
+maintenance_lock
+old_common="$STAND/bin/common.sh"
+expected_common=$(version_value legacy_common_sha256 "$BUNDLE/VERSION")
+actual_common=$(sha256sum "$old_common" | cut -d ' ' -f 1)
+new_common=$(sha256sum "$BUNDLE/deploy/linux/common.sh" | cut -d ' ' -f 1)
+installed_common=$(version_value legacy_guard_sha256)
+[ "$actual_common" = "$expected_common" ] || [ "$actual_common" = "$new_common" ] || [ "$actual_common" = "$installed_common" ] || fail 'Прежний common.sh изменён вручную; автоматическая замена остановлена.'
+[ -n "${PLAN_FACT_STATIC_DIR:-}" ] && [ -d "$PLAN_FACT_STATIC_DIR" ] && [ ! -L "$PLAN_FACT_STATIC_DIR" ] || fail 'Каталог интерфейса не найден или является ссылкой.'
+[ -d "$BUNDLE/static-app" ] || fail 'В комплекте нет интерфейса.'
+stamp=$(date +%Y%m%d-%H%M%S)
+STAGE=$(mktemp -d "$DJANGO_HOME/.update.XXXXXX")
+previous="$DJANGO_HOME/.previous-$stamp"
+backup="$STAND/backups/update-$stamp"
+private_dir "$STAGE/new" "$previous" "$backup"
+build_venv "$BUNDLE" "$STAGE/new" > "$backup/build.log" 2>&1
+copy_code "$BUNDLE" "$STAGE/new"
+export PLAN_FACT_DATABASE_URL
+(cd "$STAGE/new/backend_django" && "$STAGE/new/venv/bin/python" manage.py check)
+(cd "$STAGE/new/backend_django" && "$STAGE/new/venv/bin/python" manage.py migrate --plan) > "$backup/migrate-plan.log"
+PARTS=(backend_django venv bin systemd VERSION)
+timer="${BACKUP_UNIT%.service}.timer"
+timer_active=false
+user_systemctl is-active --quiet "$timer" && timer_active=true
+stopped=false
+swapped=false
+migrating=false
+done_update=false
+rollback_update() {
+  local status=$? part
+  trap - EXIT
+  if [ "$status" -ne 0 ] && [ "$swapped" = true ]; then
+    say 'Обновление не удалось. Возвращаю прежний код и сохраняю неудавшуюся версию.'
+    user_systemctl stop "$APP_UNIT" || true
+    mkdir -p "$STAGE/failed"
+    for part in "${PARTS[@]}"; do
+      if [ -e "$previous/$part" ]; then
+        [ ! -e "$DJANGO_HOME/$part" ] || mv -- "$DJANGO_HOME/$part" "$STAGE/failed/"
+        mv -- "$previous/$part" "$DJANGO_HOME/"
+      fi
+    done
+    if [ -d "$previous/static-app" ]; then
+      mv -- "$PLAN_FACT_STATIC_DIR" "$STAGE/failed/static-app"
+      mv -- "$previous/static-app" "$PLAN_FACT_STATIC_DIR"
+    fi
+    cp -- "$previous/legacy-common.sh" "$old_common"
+    cp -- "$previous/app.service" "$UNIT_DIR/$APP_UNIT"
+    cp -- "$previous/backup.service" "$UNIT_DIR/$BACKUP_UNIT"
+    if [ "$migrating" = true ]; then
+      SUMMARY_CODE="$STAGE/failed/backend_django"
+      SUMMARY_PYTHON="$STAGE/failed/venv/bin/python"
+      restore_db_from_dump "$backup/before.dump" || { say 'Не удалось автоматически вернуть базу; сервер оставлен остановленным.'; exit 1; }
+    fi
+    user_systemctl daemon-reload
+  fi
+  if [ "$stopped" = true ]; then
+    user_systemctl start "$APP_UNIT"
+    wait_ready "$PLAN_FACT_PORT" 60 || status=1
+  fi
+  [ "$timer_active" = false ] || user_systemctl start "$timer"
+  if [ "$done_update" = true ]; then rm -rf -- "$STAGE"; fi
+  exit "$status"
+}
+trap rollback_update EXIT
+user_systemctl stop "$timer"
+user_systemctl stop "$BACKUP_UNIT"
+stopped=true
+user_systemctl stop "$APP_UNIT"
+pg_safety_dump "$backup/before.dump"
+# Снимок читает новый код, не меняя текущую базу.
+(cd "$STAGE/new/backend_django" && "$STAGE/new/venv/bin/python" manage.py state_summary) > "$backup/before.summary"
+cp -- "$old_common" "$previous/legacy-common.sh"
+cp -- "$UNIT_DIR/$APP_UNIT" "$previous/app.service"
+cp -- "$UNIT_DIR/$BACKUP_UNIT" "$previous/backup.service"
+# Метка выставляется до первой замены: прерванная частичная замена тоже подлежит откату.
+swapped=true
+for part in "${PARTS[@]}"; do
+  mv -- "$DJANGO_HOME/$part" "$previous/"
+  mv -- "$STAGE/new/$part" "$DJANGO_HOME/"
+done
+cp -R -- "$BUNDLE/static-app" "$STAGE/static-app"
+mv -- "$PLAN_FACT_STATIC_DIR" "$previous/static-app"
+mv -- "$STAGE/static-app" "$PLAN_FACT_STATIC_DIR"
+cp -- "$BUNDLE/deploy/linux/common.sh" "$old_common"
+migrating=true
+bash "$DJANGO_BIN/django-manage.sh" migrate --noinput
+state_summary > "$backup/after.summary"
+cmp "$backup/before.summary" "$backup/after.summary" || fail 'При обновлении изменились данные.'
+check_dump "$backup/before.dump" "$backup/before.dump.summary" || fail 'Страховочный дамп не прошёл восстановление.'
+render_unit "$DJANGO_HOME/systemd/app.service.template" "$UNIT_DIR/$APP_UNIT"
+render_unit "$DJANGO_HOME/systemd/backup.service.template" "$UNIT_DIR/$BACKUP_UNIT"
+user_systemctl daemon-reload
+user_systemctl start "$APP_UNIT"
+wait_ready "$PLAN_FACT_PORT" 60 || fail 'Новый сервер не ответил готовностью.'
+for route in / /api/state; do
+  expected=200; [ "$route" != /api/state ] || expected=401
+  actual=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 5 "http://127.0.0.1:$PLAN_FACT_PORT$route")
+  [ "$actual" = "$expected" ] || fail "Проверка $route: HTTP $actual вместо $expected."
+done
+stopped=false
+done_update=true
+say "Установлен коммит $(version_value commit). Состояние и числа строк сохранены. Копия: $backup/before.dump"
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/systemd/ru.planfact.mvp.app.service.template b/junk/padolskiye/plan_fact_minipc/deploy/linux/systemd/ru.planfact.mvp.app.service.template
