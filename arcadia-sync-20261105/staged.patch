+#!/bin/bash
+# Восстановление с пробной распаковкой и сохранением прежней базы.
+. "$(dirname -- "${BASH_SOURCE[0]}")/common-django.sh"
+[ "$#" -ge 1 ] && [ "$#" -le 2 ] || fail 'Использование: restore-postgres.sh <копия.dump> [--yes]'
+[ "$#" -eq 1 ] || [ "$2" = --yes ] || fail 'Неизвестный параметр.'
+[ -f "$1" ] && [ ! -L "$1" ] || fail 'Не найден обычный файл дампа.'
+[ -e "$ACTIVE_MARK" ] || fail 'Восстановление предназначено для действующего стенда Django.'
+dump=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd -P)/$(basename -- "$1")
+load_django_config
+pg_client_env
+maintenance_lock
+stamp=$(date +%Y%m%d-%H%M%S)
+directory="$STAND/backups/restore-$stamp"
+private_dir "$directory"
+check_dump "$dump" "$directory/candidate.summary" || fail 'Дамп не прошёл пробное восстановление; стенд не изменён.'
+say 'Кандидат восстановления:'
+cat "$directory/candidate.summary"
+say 'Текущая база:'
+state_summary
+if [ "${2:-}" != --yes ]; then
+  read -r -p 'Заменить текущие данные этой копией? Введите да: ' answer
+  [ "$answer" = да ] || fail 'Восстановление отменено.'
+fi
+timer="${BACKUP_UNIT%.service}.timer"
+timer_active=false
+user_systemctl is-active --quiet "$timer" && timer_active=true
+stopped=false
+restored=false
+finish_restore() {
+  local status=$?
+  trap - EXIT
+  if [ "$status" -ne 0 ] && [ "$restored" = true ]; then
+    user_systemctl stop "$APP_UNIT" || true
+    terminate_database_connections "$PG_DATABASE"
+    failed_db="${PG_DATABASE}_failed_$(date +%s)"
+    pg_tool psql --no-psqlrc --dbname=postgres --set=ON_ERROR_STOP=1 --command "ALTER DATABASE $PG_DATABASE RENAME TO $failed_db"
+    pg_tool psql --no-psqlrc --dbname=postgres --set=ON_ERROR_STOP=1 --command "ALTER DATABASE $RESTORED_PREVIOUS_DATABASE RENAME TO $PG_DATABASE"
+  fi
+  [ "$stopped" = false ] || user_systemctl start "$APP_UNIT"
+  [ "$timer_active" = false ] || user_systemctl start "$timer"
+  exit "$status"
+}
+trap finish_restore EXIT
+user_systemctl stop "$timer"
+user_systemctl stop "$BACKUP_UNIT"
+stopped=true
+user_systemctl stop "$APP_UNIT"
+pg_safety_dump "$directory/before.dump"
+state_summary > "$directory/before.summary"
+restore_db_from_dump "$dump"
+restored=true
+state_summary > "$directory/after.summary"
+cmp "$directory/candidate.summary" "$directory/after.summary" || fail 'Восстановленная база не совпала с проверенной копией.'
+user_systemctl start "$APP_UNIT"
+wait_ready "$PLAN_FACT_PORT" 60 || fail 'Восстановленный сервер не ответил готовностью.'
+stopped=false
+say "Восстановление завершено. Страховочная копия: $directory/before.dump"
