+#!/bin/bash
+# Проверка перехода со старой версии и явного возврата. Только своя .sandbox, без launchd.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)
+NODE_BINARY=$(command -v node)
+KEEP=false
+case "${1:-}" in --keep) KEEP=true ;; '') ;; *) printf 'Использование: test-corporate-install.sh [--keep]\n' >&2; exit 1 ;; esac
+[ "$#" -le 1 ] || exit 1
+mkdir -p "$PROJECT_ROOT/.sandbox"
+TEST_ROOT=$(mktemp -d "$PROJECT_ROOT/.sandbox/auth-idm-install.XXXXXX")
+TEST_STAND="$TEST_ROOT/stand"
+SERVER_PID=''
+PASSED=0
+FINISHED=false
+stop_server() {
+  if [ -n "$SERVER_PID" ]; then
+    kill -TERM "$SERVER_PID" 2>/dev/null || true
+    wait "$SERVER_PID" 2>/dev/null || true
+    SERVER_PID=''
+  fi
+}
+cleanup() {
+  local result=$?
+  stop_server
+  if [ "$FINISHED" = true ] && [ "$KEEP" = true ]; then
+    printf 'Тестовая копия сохранена (сервер остановлен): %s\n' "$TEST_STAND"
+  else
+    rm -rf -- "$TEST_ROOT"
+  fi
+  [ "$FINISHED" = true ] || [ "$result" -ne 0 ] || result=1
+  exit "$result"
+}
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+check() {
+  local title=$1
+  shift
+  "$@" || { printf 'Не пройдена проверка: %s\n' "$title" >&2; exit 1; }
+  PASSED=$((PASSED + 1))
+  printf 'Пройдена проверка %s: %s.\n' "$PASSED" "$title"
+}
+fails() { if "$@" > "$TEST_ROOT/expected-error.txt" 2>&1; then return 1; fi; }
