+    def test_simultaneous_attempts_cannot_slip_past_the_lock(self):
+        def lock_state():
+            row = self.access_code("alice")
+            return row.failed_attempts, row.locked_until
+
+        with ThreadPoolExecutor(max_workers=16) as pool:
+            burst = list(pool.map(lambda _: self.api.login("alice", WRONG_CODE), range(40)))
+        self.assertEqual(len({f"{response.status} {response.text}" for response in burst}), 1)
+        self.assertEqual(burst[0].json, GENERIC_FAILURE)
+        failed, locked_until = lock_state()
+        self.assertEqual(failed, 5)
+        self.assertIsNotNone(locked_until)
+        with ThreadPoolExecutor(max_workers=11) as pool:
+            during = list(pool.map(lambda code: self.api.login("alice", code), [WRONG_CODE] * 10 + [self.codes["alice"]]))
+        for response in during:
+            self.assertEqual(response.status, 401)
+            self.assertEqual(response.json, GENERIC_FAILURE)
+        self.assertEqual(lock_state(), (failed, locked_until))
+
+        fresh = self.service.issue_access_code("alice")["code"]
+        started = threading.Event()
+        release = threading.Event()
+        original = access_codes.derive_key
+        wanted = access_codes.normalize_access_code(fresh)
+
+        def held(code, salt, kdf):
+            if code == wanted:
+                started.set()
+                release.wait(30)
+            return original(code, salt, kdf)
+
+        with mock.patch.object(access_codes, "derive_key", side_effect=held):
+            with ThreadPoolExecutor(max_workers=12) as pool:
+                pending = pool.submit(self.api.login, "alice", fresh)
+                self.assertTrue(started.wait(30))
+                wrong = list(pool.map(lambda _: self.api.login("alice", WRONG_CODE), range(11)))
+                self.assertTrue(all(response.status == 401 for response in wrong))
+                relocked = lock_state()
+                self.assertEqual(relocked[0], 5)
+                self.assertIsNotNone(relocked[1])
+                known = {event["id"] for event in self.audit("auth.access_code_failed")}
+                release.set()
+                late = pending.result(30)
+        self.assertEqual(late.status, 401, "верный код, проверенный уже после блокировки, не пускает")
+        self.assertEqual(late.json, GENERIC_FAILURE)
+        self.assertIsNone(late.header("Set-Cookie"))
+        self.assertEqual(lock_state(), relocked)
+        self.assertIsNone(self.service.store.get_active_user_session(self.users["alice"]["id"]))
+        added = [event for event in self.audit("auth.access_code_failed") if event["id"] not in known]
+        self.assertEqual([event["payload"]["reason"] for event in added], ["locked"])
