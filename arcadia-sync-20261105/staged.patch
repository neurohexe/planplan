+    def login(self, login: str, code: str) -> dict:
+        return self.service.login_with_access_code(login=login, code=code, ip="127.0.0.1", user_agent="test")
+
+    def audit(self, action: str) -> list[dict]:
+        return [event for event in self.service.store.list_audit(limit=500) if event["action"] == action]
+
+    def mutate(self, session: dict, kind: str, payload: dict, mutation_id: str | None = None, base: int | None = None) -> dict:
+        return self.service.mutate(session, {
+            "type": kind, "payload": payload, "mutationId": mutation_id or f"m-{kind}-{os.urandom(4).hex()}",
+            "baseRevision": self.service.get_state()["revision"] if base is None else base,
