+#!/bin/bash
+# Общие функции скриптов. Настройки читаются только из выбранного стенда.
+set -euo pipefail
+umask 077
+
+LAPTOP_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+if [ -n "${PLANFACT_HOME:-}" ]; then
+  STAND=$PLANFACT_HOME
+elif [ "$(basename -- "$LAPTOP_DIR")" = bin ]; then
+  # Установленные скрипты управляют только своим стендом. Если его config.env пропал, они откажут сами,
+  # а не перейдут молча к ~/PlanFactMVP (иначе uninstall.sh репетиции удалил бы настоящий стенд).
+  STAND=$(CDPATH= cd -- "$LAPTOP_DIR/.." && pwd -P)
+else
+  STAND="$HOME/PlanFactMVP"
+fi
+
+fail() { printf 'Ошибка: %s\n' "$*" >&2; exit 1; }
+
+case "$STAND" in
+  /*) ;;
+  *) fail 'PLANFACT_HOME должен быть полным путём, начиная с /.' ;;
+esac
+[ ! -L "$STAND" ] || fail 'Папка стенда не должна быть символической ссылкой.'
+if [ -d "$STAND" ]; then
+  STAND=$(CDPATH= cd -- "$STAND" && pwd -P)
+fi
+case "$STAND" in
+  /|"$HOME"|"$HOME/"|*/..|*/.) fail 'Выберите отдельную папку для стенда.' ;;
+esac
+export PLANFACT_HOME="$STAND"
+AGENT_DIR="$HOME/Library/LaunchAgents"
+LAUNCH_DOMAIN="gui/$(id -u)"
+
+# Метки агентов — ru.planfact.mvp.<имя><суффикс>. Второй стенд на том же ноутбуке (репетиция) получает свой
+# суффикс, например PLANFACT_LABEL_SUFFIX=.rehearsal → ru.planfact.mvp.app.rehearsal, и не задевает агентов
+# настоящего стенда. Установщик записывает суффикс в launchd/.label-suffix; дальше скрипты стенда берут его оттуда.
+LABEL_PREFIX=ru.planfact.mvp
+LABEL_SUFFIX_FILE="$STAND/launchd/.label-suffix"
+# Проверяет суффикс и кладёт его в LABEL_SUFFIX_VALUE: «rehearsal» и «.rehearsal» дают «.rehearsal».
+parse_label_suffix() {
+  local value=${1#.}
+  [ -z "$value" ] || [[ "$value" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || fail 'Суффикс меток PLANFACT_LABEL_SUFFIX: строчные латинские буквы, цифры и дефисы, например .rehearsal.'
+  LABEL_SUFFIX_VALUE=${value:+.$value}
+}
+parse_label_suffix "${PLANFACT_LABEL_SUFFIX:-}"
+LABEL_SUFFIX=$LABEL_SUFFIX_VALUE
+if [ -e "$LABEL_SUFFIX_FILE" ] || [ -L "$LABEL_SUFFIX_FILE" ]; then
+  [ -f "$LABEL_SUFFIX_FILE" ] && [ ! -L "$LABEL_SUFFIX_FILE" ] || fail 'launchd/.label-suffix должен быть обычным файлом.'
+  stored_label_suffix=''
+  read -r stored_label_suffix < "$LABEL_SUFFIX_FILE" || true
+  parse_label_suffix "$stored_label_suffix"
+  if [ -n "${PLANFACT_LABEL_SUFFIX:-}" ] && [ "$LABEL_SUFFIX" != "$LABEL_SUFFIX_VALUE" ]; then
+    fail "Стенд $STAND установлен с другими метками агентов (суффикс: ${LABEL_SUFFIX_VALUE:-нет}). Уберите PLANFACT_LABEL_SUFFIX или укажите тот же суффикс."
+  fi
+  LABEL_SUFFIX=$LABEL_SUFFIX_VALUE
+fi
+# Метка агента этого стенда по имени: app → ru.planfact.mvp.app (с суффиксом стенда).
+stand_label() { printf '%s.%s%s\n' "$LABEL_PREFIX" "$1" "$LABEL_SUFFIX"; }
+# Имя агента по его метке: ru.planfact.mvp.tunnel.rehearsal → tunnel.
+agent_name() {
+  local name=${1#"$LABEL_PREFIX".}
+  printf '%s\n' "${name%"$LABEL_SUFFIX"}"
+}
+APP_LABEL=$(stand_label app)
+
+require_node() {
+  local binary=$1 version major minor
+  case "$binary" in /*) ;; *) fail 'Путь к Node должен быть абсолютным.' ;; esac
+  [ -x "$binary" ] || fail 'Не найден Node. Нужен Node 22.5 или новее.'
+  version=$("$binary" --version) || fail 'Не удалось запустить Node.'
+  if [[ "$version" =~ ^v([0-9]+)\.([0-9]+)\. ]]; then
+    major=${BASH_REMATCH[1]}
+    minor=${BASH_REMATCH[2]}
+    if [ "$major" -gt 22 ] || { [ "$major" -eq 22 ] && [ "$minor" -ge 5 ]; }; then
+      return
+    fi
+  fi
+  fail 'Нужен Node 22.5 или новее. Обновите Node перед установкой.'
+}
+
+load_stand_config() {
+  [ -f "$STAND/config.env" ] && [ ! -L "$STAND/config.env" ] || fail 'Не найден обычный файл config.env. Сначала установите стенд.'
+  set -a
+  # shellcheck disable=SC1091
+  . "$STAND/config.env"
+  set +a
+  # config.env не меняет выбор стенда и адрес папки LaunchAgents.
+  export PLANFACT_HOME="$STAND"
+  require_node "${PLAN_FACT_NODE_BIN:-}"
+  [ "${NODE_ENV:-}" = development ] || fail 'В config.env требуется NODE_ENV=development.'
+  case "${PLAN_FACT_AUTH_MODE:-}" in
+    access-code|corporate-idm) ;;
+    *) fail 'В config.env допустимы только access-code или corporate-idm.' ;;
+  esac
+  [ "${PLAN_FACT_STORAGE_DRIVER:-}" = sqlite ] || fail 'В config.env требуется хранилище SQLite.'
+  [ "${PLAN_FACT_HOST:-}" = 127.0.0.1 ] || fail 'Сервер должен слушать только 127.0.0.1.'
+  [[ "${PLAN_FACT_PORT:-}" =~ ^[0-9]{1,5}$ ]] || fail 'В config.env неверный номер порта.'
+  [ "$((10#$PLAN_FACT_PORT))" -ge 1 ] && [ "$((10#$PLAN_FACT_PORT))" -le 65535 ] || fail 'Порт должен быть от 1 до 65535.'
+  # При установке проверяется новая копия кода до замены работающей; при запуске — установленная.
+  # Ошибка настройки останавливает команду, без возврата к личным кодам.
+  if [ "$PLAN_FACT_AUTH_MODE" = corporate-idm ] || [ "${PLAN_FACT_ROLE_SOURCE:-}" = tirole ]; then
+    "$PLAN_FACT_NODE_BIN" - "${1:-$STAND/app}/backend/src/config.js" <<'NODE'
+try { require(process.argv[2]).loadConfig(); }
+catch (error) { console.error(`Ошибка конфигурации: ${error.message}`); process.exit(1); }
+NODE
+  fi
+  # Настройки файлов не должны увести команды из выбранной папки стенда.
+  "$PLAN_FACT_NODE_BIN" - "$STAND" <<'NODE'
+const path = require('node:path');
+const root = process.argv[2];
+for (const key of ['PLAN_FACT_DATABASE', 'PLAN_FACT_STATIC_DIR', 'PLAN_FACT_CODES_DIR']) {
+  const value = process.env[key] || '';
+  const relative = path.relative(root, path.resolve(value));
+  if (!path.isAbsolute(value) || !relative || relative === '..' || relative.startsWith(`..${path.sep}`)) {
+    console.error('Ошибка: пути базы, страниц и кодов должны находиться внутри папки стенда.');
+    process.exit(1);
+  }
+}
+NODE
+}
+
+agent_label() {
+  local name
+  name=$(basename -- "$1")
+  name=${name%.plist}
+  [[ "$name" =~ ^ru\.planfact\.mvp\.[a-z0-9][a-z0-9.-]*$ ]] || fail 'Неверное имя агента стенда.'
+  printf '%s\n' "$name"
+}
+
+launchd_enabled() { [ ! -f "$STAND/launchd/.no-launchd" ]; }
+
+# Агент принадлежит этому стенду, если в LaunchAgents лежит та же копия plist, что в launchd/ стенда (или её там нет).
+# Другой копией с той же меткой управляет другой стенд на этом ноутбуке: её не останавливаем и не удаляем.
+agent_is_ours() {
+  [ ! -e "$AGENT_DIR/$1.plist" ] || cmp -s -- "$AGENT_DIR/$1.plist" "$STAND/launchd/$1.plist"
+}
+
+bootout_agent() {
+  local label=$1 limit=${PLANFACT_AGENT_STOP_SECONDS:-30} deadline
+  [[ "$limit" =~ ^[0-9]{1,3}$ ]] || limit=30
+  if launchctl print "$LAUNCH_DOMAIN/$label" >/dev/null 2>&1; then
+    launchctl bootout "$LAUNCH_DOMAIN/$label" >/dev/null 2>&1 || fail "Не удалось остановить агент $label."
+    # bootout возвращается сразу, а процесс агента ещё завершается: launchd держит метку, пока процесс жив.
+    # В это время повторная загрузка отказывает (Bootstrap failed: 5), а восстановление заменило бы базу под
+    # работающим сервером. Ждём выгрузки метки; через 20 секунд launchd завершает процесс принудительно.
+    deadline=$(( $(date +%s) + limit ))
+    while launchctl print "$LAUNCH_DOMAIN/$label" >/dev/null 2>&1; do
+      [ "$(date +%s)" -lt "$deadline" ] || fail "Агент $label не остановился за $limit с."
+      sleep 0.1
+    done
+  fi
+}
+
+# Останавливает только агентов этого стенда — их plist лежат в launchd/ стенда, а не все ru.planfact.mvp.* в LaunchAgents.
+stop_agents() {
+  local file label
+  launchd_enabled || return 0
+  for file in "$STAND/launchd"/ru.planfact.mvp.*.plist; do
+    [ -f "$file" ] || continue
+    label=$(agent_label "$file")
+    if ! agent_is_ours "$label"; then
+      printf 'Агент %s установлен другим стендом — не трогаю его.\n' "$label" >&2
+      continue
+    fi
+    bootout_agent "$label"
+  done
+}
+
+start_agents() {
+  local file label
+  launchd_enabled || fail 'Это проверочная установка без автозапуска. Используйте bin/run-app.sh для ручной проверки.'
+  for file in "$STAND/launchd"/ru.planfact.mvp.*.plist; do
+    [ -f "$file" ] || continue
+    label=$(agent_label "$file")
+    # Ручной агент включает его собственный скрипт (например, enable-tunnel.sh). Здесь возвращаем в работу только тот,
+    # что уже был включён: рядом лежит метка launchd/.<имя>-enabled (для туннеля — .tunnel-enabled).
+    if [ -f "$STAND/launchd/$label.manual" ] && [ ! -f "$STAND/launchd/.$(agent_name "$label")-enabled" ]; then
+      continue
+    fi
+    [ -f "$AGENT_DIR/$label.plist" ] || fail "Не найден установленный агент $label. Повторите установку из мастерской."
+    agent_is_ours "$label" || fail "Агент $label в LaunchAgents установлен другим стендом. Повторите установку из мастерской."
+    bootout_agent "$label"
+    launchctl bootstrap "$LAUNCH_DOMAIN" "$AGENT_DIR/$label.plist" >/dev/null 2>&1 || fail "Не удалось включить агент $label."
+  done
+}
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/laptop/config.corporate.env.example b/junk/padolskiye/plan_fact_minipc/deploy/laptop/config.corporate.env.example
