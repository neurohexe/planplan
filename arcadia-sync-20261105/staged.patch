+"""Сравнение строк как localeCompare(…, "ru") в JavaScript.
+
+Порядок символов взят из ICU, встроенного в Node (tools/gen-collation-ru.js → data/collation_ru.json):
+кириллица идёт раньше латиницы, регистр и диакритика различаются на втором и третьем уровне,
+знаки препинания и цифры — раньше букв. Сравнение многоуровневое, как в алгоритме Unicode Collation:
+сначала буквы без учёта ударений и регистра, затем ударения, затем регистр.
+"""
+
+from __future__ import annotations
+
+import functools
+import json
+import unicodedata
+from pathlib import Path
+
+_DATA = json.loads((Path(__file__).parent / "data" / "collation_ru.json").read_text(encoding="utf-8"))
+_TABLE: dict[str, tuple[int, int, int]] = {ch: tuple(weights) for ch, weights in _DATA["table"].items()}
+_IGNORABLE = frozenset(_DATA["ignorable"])
+_PRIMARY_IGNORABLE = frozenset(_DATA["primaryIgnorable"])
+_EXPANSIONS: dict[str, tuple[str, int]] = {ch: (pair, sign) for ch, (pair, sign) in _DATA["expansions"].items()}
+_UNKNOWN_BASE = max(weights[0] for weights in _TABLE.values()) + 1
+
+
+def _weights(ch: str) -> tuple[float, float, float] | None:
+    if ch in _IGNORABLE:
+        return None
+    weights = _TABLE.get(ch)
+    if weights is not None:
+        return weights
+    return (_UNKNOWN_BASE + ord(ch), 0, 0)
+
+
+@functools.lru_cache(maxsize=65536)
+def ru_key(text: str) -> tuple[tuple, tuple, tuple]:
+    primaries: list[float] = []
+    secondaries: list[float] = []
+    tertiaries: list[float] = []
+    for ch in unicodedata.normalize("NFC", text):
+        if ch in _PRIMARY_IGNORABLE:
+            secondaries.append(10_000 + ord(ch))
+            continue
+        expansion = _EXPANSIONS.get(ch)
+        if expansion is not None:
+            pair, sign = expansion
+            parts = [_TABLE[item] for item in pair]
+            for index, (p, s, t) in enumerate(parts):
+                primaries.append(p)
+                secondaries.append(s)
+                tertiaries.append(t + (0.5 * sign if index == 0 else 0))
+            continue
+        weights = _weights(ch)
+        if weights is None:
+            continue
+        p, s, t = weights
+        primaries.append(p)
+        secondaries.append(s)
+        tertiaries.append(t)
+    return tuple(primaries), tuple(secondaries), tuple(tertiaries)
+
+
+def ru_compare(left: str, right: str) -> int:
+    """left.localeCompare(right, "ru"): -1, 0 или 1."""
+    a = ru_key(left)
+    b = ru_key(right)
+    return -1 if a < b else (1 if a > b else 0)
+
+
+def ru_sorted(items, key=None):
+    """[...items].sort((a, b) => a.localeCompare(b, "ru")) — сортировка устойчивая, как в JavaScript."""
+    if key is None:
+        return sorted(items, key=ru_key)
+    return sorted(items, key=lambda item: ru_key(key(item)))
