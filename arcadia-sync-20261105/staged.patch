+#!/usr/bin/env python3
+"""Read-only localhost bridge between the Plan Fact SPA and Yandex Tracker."""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+from concurrent.futures import ThreadPoolExecutor, as_completed
+import subprocess
+import sys
+import threading
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import urlparse
+
+
+HOST = "127.0.0.1"
+PORT = int(os.environ.get("PLAN_FACT_TRACKER_PORT", "18766"))
+QUEUE = "TAXIASSIST"
+BRIDGE_SCHEMA_VERSION = 5
+MAX_ISSUES = int(os.environ.get("PLAN_FACT_TRACKER_MAX_ISSUES", "5000"))
+SEARCH_SCOPES = {"mine", "queue"}
+ISSUE_KEY_PATTERN = re.compile(r"^TAXIASSIST-\d+$")
+PAYMENT_ROBOT = "robot-planer-oebs"
+TRACKER_BASE_URL = "https://st-api.yandex-team.ru"
+TRACKER_ORG_ID = "0"
+KEYCHAIN_SERVICE = "PlanFactBudget.YandexTracker"
+_RUNTIME_TOKEN = ""
+_RUNTIME_TOKEN_LOCK = threading.Lock()
+PAYMENT_COMMENT_PATTERN = re.compile(
+    r"Document\s+.+?\s+from\s+\d{2}\.\d{2}\.\d{4}\s+for\s+"
+    r"[0-9][0-9\s.,]*?\s+[A-Z]{3}\s+will be paid\s+\d{2}\.\d{2}\.\d{4}",
+    re.IGNORECASE,
+)
+
+
+def _normalize_tracker_token(value: object) -> str:
+    """Normalize pasted/stored OAuth tokens without ever logging their value."""
+    token = str(value or "").strip()
+    if len(token) >= 2 and token[0] == token[-1] and token[0] in {"'", '"'}:
+        token = token[1:-1].strip()
+    token = re.sub(r"^(?:Bearer|OAuth)\s+", "", token, flags=re.IGNORECASE)
+    token = "".join(token.split())
+    if len(token) < 20 or any(ord(character) < 33 or ord(character) > 126 for character in token):
+        return ""
+    return token
+
+
+def _environment_tracker_token() -> str:
+    return _normalize_tracker_token(
+        os.environ.get("PLAN_FACT_TRACKER_TOKEN")
+        or os.environ.get("STARTREK_ROBOT_TOKEN")
+        or os.environ.get("STARTREK_TOKEN")
+        or ""
+    )
+
+
+def _runtime_tracker_token() -> str:
+    with _RUNTIME_TOKEN_LOCK:
+        return _RUNTIME_TOKEN
+
+
+def _cache_tracker_token(token: str) -> None:
+    global _RUNTIME_TOKEN
+    with _RUNTIME_TOKEN_LOCK:
+        _RUNTIME_TOKEN = token
+
+
+def _keychain_token(account: str) -> str:
+    if not account:
+        return ""
+    try:
+        result = subprocess.run(
+            ["/usr/bin/security", "find-generic-password", "-a", account, "-s", KEYCHAIN_SERVICE, "-w"],
+            capture_output=True,
+            timeout=15,
+            check=False,
+        )
+    except (FileNotFoundError, subprocess.TimeoutExpired):
+        return ""
+    return _normalize_tracker_token(result.stdout.decode("utf-8", errors="ignore")) if result.returncode == 0 else ""
+
+
+def _tracker_token_present() -> bool:
+    if _environment_tracker_token() or _runtime_tracker_token():
+        return True
+    if sys.platform == "darwin":
+        account = (os.environ.get("PLAN_FACT_KEYCHAIN_ACCOUNT") or os.environ.get("USER") or "").strip()
+        return len(_keychain_token(account)) >= 20
+    return False
+
+
+def _store_tracker_token(token: str) -> None:
+    token = _normalize_tracker_token(token)
+    if not token:
+        raise ValueError("Токен выглядит некорректно. Скопируйте его целиком.")
+    if sys.platform == "darwin":
+        account = (os.environ.get("PLAN_FACT_KEYCHAIN_ACCOUNT") or os.environ.get("USER") or "").strip()
+        if not account:
+            raise RuntimeError("Не удалось определить пользователя macOS для Keychain.")
+        result = subprocess.run(
+            [
+                "/usr/bin/security", "add-generic-password", "-U", "-a", account,
+                "-s", KEYCHAIN_SERVICE, "-l", "План Факт — Yandex Tracker", "-w",
+            ],
+            input=f"{token}\n".encode("utf-8"),
+            capture_output=True,
+            timeout=15,
+            check=False,
+        )
+        if result.returncode != 0:
+            raise RuntimeError("Не удалось сохранить токен в Keychain.")
+    elif sys.platform == "win32":
+        import winreg
+
+        with winreg.CreateKey(winreg.HKEY_CURRENT_USER, r"Environment") as key:
+            winreg.SetValueEx(key, "STARTREK_TOKEN", 0, winreg.REG_SZ, token)
+        os.environ["STARTREK_TOKEN"] = token
+    else:
+        raise RuntimeError("Автоматическое сохранение токена поддерживается только на Windows и macOS.")
+    # Keychain can lag behind an immediately following read in a background app.
+    # Keep the validated token only in this bridge process so the first sync can
+    # start at once; persistence remains delegated to Keychain/Windows storage.
+    _cache_tracker_token(token)
+
+
+class TrackerAPIError(RuntimeError):
+    """Safe Tracker error that never includes request headers or the token."""
+
+
+def _load_tracker_token() -> str:
+    environment_token = _environment_tracker_token()
+    if environment_token:
+        return environment_token
+    runtime_token = _runtime_tracker_token()
+    if runtime_token:
+        return runtime_token
+    if sys.platform != "darwin":
+        raise TrackerAPIError(
+            "Токен Tracker не задан. На macOS запустите start-plan-fact.command; "
+            "на другой системе задайте PLAN_FACT_TRACKER_TOKEN."
+        )
+    account = (os.environ.get("PLAN_FACT_KEYCHAIN_ACCOUNT") or os.environ.get("USER") or "").strip()
+    if not account:
+        raise TrackerAPIError("Не удалось определить пользователя macOS для доступа к Keychain.")
+    token = _keychain_token(account)
+    if len(token) < 20:
+        raise TrackerAPIError(
+            "Токен Tracker не найден в Keychain. Перезапустите start-plan-fact.command "
+            "и сохраните персональный токен."
+        )
+    return token
+
+
+class TrackerClient:
+    """Minimal read-only Tracker API client backed by macOS Keychain."""
+
+    def __init__(self, timeout=60):
+        self._token = _load_tracker_token()
+        self._timeout = timeout
+
+    def _request(self, path, method="GET", data=None, return_headers=False, retries=3):
+        body = json.dumps(data, ensure_ascii=False).encode("utf-8") if data is not None else None
+        headers = {
+            "Authorization": f"Bearer {self._token}",
+            "X-Org-Id": TRACKER_ORG_ID,
+        }
+        if data is not None:
+            headers["Content-Type"] = "application/json"
+        request = urllib.request.Request(
+            f"{TRACKER_BASE_URL}{path}", data=body, headers=headers, method=method
+        )
+        for attempt in range(retries):
+            try:
+                with urllib.request.urlopen(request, timeout=self._timeout) as response:
+                    raw = response.read()
+                    payload = json.loads(raw) if raw else {}
+                    return (payload, dict(response.headers)) if return_headers else payload
+            except urllib.error.HTTPError as error:
+                transient = error.code >= 500 or error.code == 429
+                if transient and attempt < retries - 1:
+                    time.sleep(2 * (attempt + 1))
+                    continue
+                messages = ""
+                try:
+                    error_payload = json.loads(error.read().decode("utf-8", errors="replace"))
+                    values = error_payload.get("errorMessages") or []
+                    messages = str(values[0] if isinstance(values, list) and values else "")[:300]
+                except (json.JSONDecodeError, AttributeError, IndexError):
+                    pass
+                hint = " Проверьте токен в Keychain и права в Tracker." if error.code in {401, 403} else ""
+                if messages:
+                    messages = messages.replace(self._token, "***")
+                detail = f" ({messages})" if messages else ""
+                raise TrackerAPIError(f"Tracker API вернул HTTP {error.code}{detail}.{hint}") from None
+            except urllib.error.URLError as error:
+                if attempt < retries - 1:
+                    time.sleep(2 * (attempt + 1))
+                    continue
+                raise TrackerAPIError(f"Tracker недоступен по сети: {str(error.reason)[:200]}") from None
+
+    def _paginate(self, path, body=None, method="GET", per_page=100):
+        items = []
+        page = 1
+        while True:
+            separator = "&" if "?" in path else "?"
+            chunk, headers = self._request(
+                f"{path}{separator}perPage={per_page}&page={page}",
+                method=method,
+                data=body,
+                return_headers=True,
+            )
+            if not isinstance(chunk, list):
+                raise TrackerAPIError("Tracker вернул неожиданный формат списка тикетов.")
+            items.extend(chunk)
+            total = int(headers.get("X-Total-Count", len(items)))
+            if len(items) >= total or len(chunk) < per_page:
+                return items
+            page += 1
+
+    def me(self):
+        return self._request("/v3/myself")
+
+    def search(self, query_filter=None, keys=None, order=None, per_page=100):
+        body = {}
+        if query_filter:
+            body["filter"] = query_filter
+        if keys:
+            body["keys"] = keys
+        if order:
+            body["order"] = order
+        return self._paginate("/v3/issues/_search", body=body, method="POST", per_page=per_page)
+
+    def get_comments(self, key):
+        encoded_key = urllib.parse.quote(str(key), safe="")
+        comments, headers = self._request(
+            f"/v3/issues/{encoded_key}/comments?perPage=100000", return_headers=True
+        )
+        if not isinstance(comments, list):
+            raise TrackerAPIError("Tracker вернул неожиданный формат комментариев.")
+        total = int(headers.get("X-Total-Count", len(comments)))
+        if len(comments) < total:
+            raise TrackerAPIError(f"Tracker вернул только {len(comments)} из {total} комментариев.")
+        return comments
+
+
+def _compact_issue(issue: dict, payment_comments=None) -> dict:
+    """Return only fields required by tracker-sync.js; never expose ACLs/comments."""
+    return {
+        "key": issue.get("key"),
+        "summary": issue.get("summary"),
+        "description": issue.get("description"),
+        "createdAt": issue.get("createdAt"),
+        "updatedAt": issue.get("updatedAt"),
+        "orderAmountWithoutVat": issue.get("orderAmountWithoutVat"),
+        "orderCurrency": issue.get("orderCurrency"),
+        "orderStatusPa": issue.get("orderStatusPa"),
+        "orderIdPa": issue.get("orderIdPa"),
+        "poNumbers": issue.get("poNumbers"),
+        "orderProject": issue.get("orderProject"),
+        "orderGeography": issue.get("orderGeography"),
+        "orderGroup": issue.get("orderGroup"),
+        "orderCostCenter": issue.get("orderCostCenter"),
+        "orderService": issue.get("orderService"),
+        "oe": issue.get("oe"),
+        "startDateOfServices": issue.get("startDateOfServices"),
+        "endDateOfServices": issue.get("endDateOfServices"),
+        "paymentComments": payment_comments or [],
+        "status": {
+            "key": (issue.get("status") or {}).get("key"),
+            "display": (issue.get("status") or {}).get("display"),
+        },
+    }
+
+
+def _is_expense_candidate(issue: dict) -> bool:
+    """Keep the financial TAXIASSIST form, excluding unrelated legacy tickets."""
+    amount = str(issue.get("orderAmountWithoutVat") or "").strip()
+    currency = str(issue.get("orderCurrency") or "").strip()
+    description = str(issue.get("description") or "")
+    if not amount:
+        amount = _legacy_description_field(description, "Сумма без НДС")
+    if not currency:
+        currency = _legacy_description_field(description, "Валюта")
+    return bool(amount and currency)
+
+
+def _legacy_description_field(description: str, label: str) -> str:
+    match = re.search(
+        rf"(?:^|\n){re.escape(label)}\s*:\s*\n([^\n\r]+)",
+        str(description or ""),
+        re.IGNORECASE,
+    )
+    return match.group(1).strip() if match else ""
+
+
+def _plain_field(value) -> str:
+    if isinstance(value, dict):
+        value = value.get("display") or value.get("name") or value.get("key") or value.get("id")
+    return str(value or "").strip()
+
+
+def _is_forecast_issue(issue: dict) -> bool:
+    value = _plain_field(issue.get("orderGroup")).casefold().replace("ё", "е")
+    return value in {"прогноз", "forecast"}
+
+
+def _quarter_key_from_date(value) -> str:
+    match = re.match(r"^(\d{4})-(0[1-9]|1[0-2])-", str(value or ""))
+    if not match:
+        return ""
+    return f"{match.group(1)}-Q{(int(match.group(2)) - 1) // 3 + 1}"
+
+
+def _payment_date_from_text(value) -> str:
+    match = PAYMENT_COMMENT_PATTERN.search(str(value or ""))
+    if not match:
+        return ""
+    date_match = re.search(r"will be paid\s+(\d{2})\.(\d{2})\.(\d{4})", match.group(0), re.IGNORECASE)
+    return f"{date_match.group(3)}-{date_match.group(2)}-{date_match.group(1)}" if date_match else ""
+
+
+def _compact_payment_comment(comment: dict, period_key=""):
+    author = comment.get("createdBy") or comment.get("author") or {}
+    author_id = (
+        str(author.get("id") or author.get("login") or "").strip()
+        if isinstance(author, dict)
+        else _plain_field(author)
+    ).casefold()
+    if author_id != PAYMENT_ROBOT:
+        return None
+    match = PAYMENT_COMMENT_PATTERN.search(str(comment.get("text") or ""))
+    if not match:
+        return None
+    if period_key and _quarter_key_from_date(_payment_date_from_text(match.group(0))) != period_key:
+        return None
+    return {
+        "id": str(comment.get("id") or ""),
+        "longId": str(comment.get("longId") or ""),
+        "createdAt": comment.get("createdAt"),
+        "authorId": PAYMENT_ROBOT,
+        # Only the payment sentence is exposed to the browser. Names, links and
+        # the rest of the operational comment remain inside Tracker.
+        "text": match.group(0),
+    }
+
+
+def _issue_key(issue: dict) -> str:
+    return str(issue.get("key") or "").strip().upper()
+
+
+def _search_scope(payload: dict) -> str:
+    value = str(payload.get("searchScope") or "mine").strip().lower()
+    if value not in SEARCH_SCOPES:
+        raise ValueError("Неизвестная область поиска Tracker. Используйте mine или queue.")
+    return value
+
+
+def _known_issue_keys(payload: dict, field="knownIssueKeys") -> list:
+    values = payload.get(field)
+    if not isinstance(values, list):
+        return []
+    keys = []
+    seen = set()
+    for value in values:
+        key = str(value or "").strip().upper()
+        if not ISSUE_KEY_PATTERN.fullmatch(key) or key in seen:
+            continue
+        seen.add(key)
+        keys.append(key)
+    if len(keys) > MAX_ISSUES:
+        raise ValueError(f"Передано больше {MAX_ISSUES} ранее связанных тикетов.")
+    return keys
+
+
+class TrackerService:
+    def __init__(self) -> None:
+        self.client = TrackerClient()
+        configured_login = (
+            os.environ.get("PLAN_FACT_TRACKER_LOGIN")
+            or os.environ.get("ACTOR_LOGIN")
+            or ""
+        ).strip()
+        if configured_login:
+            self.login = configured_login
+        else:
+            myself = self.client.me()
+            self.login = str(myself.get("login") or myself.get("id") or "").strip()
+        if not self.login:
+            raise RuntimeError(
+                "Не удалось определить пользователя Tracker. Задайте PLAN_FACT_TRACKER_LOGIN."
+            )
+
+    def sync(self, payload=None) -> dict:
+        request = payload if isinstance(payload, dict) else {}
+        search_scope = _search_scope(request)
+        period_key = str(request.get("periodKey") or "").strip()
+        if period_key and not re.fullmatch(r"\d{4}-Q[1-4]", period_key):
+            raise ValueError("Некорректный квартал синхронизации.")
+        known_forecast_key_set = set(_known_issue_keys(request, "knownForecastIssueKeys"))
+        known_keys = list(dict.fromkeys(_known_issue_keys(request) + list(known_forecast_key_set)))
+        query_filter = {"queue": QUEUE}
+        if search_scope == "mine":
+            query_filter["createdBy"] = self.login
+        scoped_issues = self.client.search(
+            query_filter=query_filter,
+            order="createdAt",
+            per_page=100,
+        )
+        if len(scoped_issues) > MAX_ISSUES:
+            scope_label = self.login if search_scope == "mine" else "всей очереди"
+            raise RuntimeError(
+                f"Выборка {QUEUE} для {scope_label} содержит больше {MAX_ISSUES} тикетов."
+            )
+        known_key_set = set(known_keys)
+        scoped_by_key = {
+            _issue_key(issue): issue for issue in scoped_issues if ISSUE_KEY_PATTERN.fullmatch(_issue_key(issue))
+        }
+        candidates = [issue for issue in scoped_issues if _is_expense_candidate(issue)]
+        combined_by_key = {_issue_key(issue): issue for issue in candidates}
+
+        # Ранее импортированные расходы контролируются при любом режиме поиска.
+        # Поэтому сохраняем в ответе их тикеты даже при очищенных финансовых полях
+        # и дочитываем ключи, которые не входят в выбранную область mine/queue.
+        for key in known_keys:
+            if key in scoped_by_key:
+                combined_by_key[key] = scoped_by_key[key]
+        missing_known_keys = [key for key in known_keys if key not in scoped_by_key]
+        for offset in range(0, len(missing_known_keys), 100):
+            linked_issues = self.client.search(keys=missing_known_keys[offset : offset + 100], per_page=100)
+            for issue in linked_issues:
+                key = _issue_key(issue)
+                if key in known_key_set:
+                    combined_by_key[key] = issue
+
+        issues = sorted(
+            combined_by_key.values(),
+            key=lambda issue: str(issue.get("createdAt") or ""),
+        )
+        payment_comments_by_key = {}
+        period_start = ""
+        if period_key:
+            year, quarter = period_key.split("-Q")
+            period_start = f"{year}-{(int(quarter) - 1) * 3 + 1:02d}-01"
+        payment_issue_keys = []
+        for issue in issues:
+            should_check_payments = _is_forecast_issue(issue) or _issue_key(issue) in known_forecast_key_set
+            if not should_check_payments and period_start:
+                should_check_payments = str(issue.get("updatedAt") or "")[:10] >= period_start
+            if not should_check_payments:
+                continue
+            payment_issue_keys.append(_issue_key(issue))
+
+        def load_payment_comments(key):
+            compact_comments = []
+            for comment in self.client.get_comments(key):
+                compact = _compact_payment_comment(comment, period_key)
+                if compact:
+                    compact_comments.append(compact)
+            return key, compact_comments
+
+        # Долгоживущих закупок может быть много; независимые read-only запросы
+        # комментариев выполняются параллельно, чтобы уложиться в таймаут UI.
+        with ThreadPoolExecutor(max_workers=min(8, max(1, len(payment_issue_keys)))) as executor:
+            futures = [executor.submit(load_payment_comments, key) for key in payment_issue_keys]
+            for future in as_completed(futures):
+                key, compact_comments = future.result()
+                payment_comments_by_key[key] = compact_comments
+        forecast_issues = [issue for issue in candidates if _is_forecast_issue(issue)]
+        return {
+            "queue": QUEUE,
+            "bridgeSchemaVersion": BRIDGE_SCHEMA_VERSION,
+            "searchScope": search_scope,
+            "selectionComplete": True,
+            "issues": [
+                _compact_issue(issue, payment_comments_by_key.get(_issue_key(issue), []))
+                for issue in issues
+            ],
+            "issueCount": len(candidates),
+            "forecastIssueCount": len(forecast_issues),
+            "paymentEventCount": sum(len(items) for items in payment_comments_by_key.values()),
+            "scannedIssueCount": len(scoped_issues),
+            "knownIssueCount": sum(1 for key in known_keys if key in combined_by_key),
+        }
+
+
+class TrackerHTTPServer(ThreadingHTTPServer):
+    """Bind immediately; initialize the network client lazily on first sync."""
+
+    def __init__(self, server_address, request_handler_class) -> None:
+        super().__init__(server_address, request_handler_class)
+        self._tracker_service = None
+        self._tracker_service_lock = threading.Lock()
+
+    def get_tracker_service(self) -> TrackerService:
+        if self._tracker_service is not None:
+            return self._tracker_service
+        with self._tracker_service_lock:
+            if self._tracker_service is None:
+                self._tracker_service = TrackerService()
+        return self._tracker_service
+
+    def reset_tracker_service(self) -> None:
+        with self._tracker_service_lock:
+            self._tracker_service = None
+
+
+def _allowed_origin(origin) -> bool:
+    if not origin:
+        return True
+    if origin == "null":
+        return True
+    try:
+        parsed = urlparse(origin)
+    except ValueError:
+        return False
+    return parsed.scheme in {"http", "https"} and parsed.hostname in {"127.0.0.1", "localhost"}
+
+
+class Handler(BaseHTTPRequestHandler):
+    server_version = "PlanFactTrackerBridge/1.0"
+
+    def _cors(self) -> None:
+        origin = self.headers.get("Origin")
+        self.send_header("Access-Control-Allow-Origin", origin or "null")
+        self.send_header("Vary", "Origin")
+        self.send_header("Access-Control-Allow-Headers", "Content-Type")
+        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
+
+    def _json(self, status: int, payload: dict, *, cors: bool = True) -> None:
+        if cors and not _allowed_origin(self.headers.get("Origin")):
+            status = 403
+            payload = {"error": "Источник запроса не разрешён"}
+            cors = False
+        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
+        self.send_response(status)
+        if cors:
+            self._cors()
+        self.send_header("Content-Type", "application/json; charset=utf-8")
+        self.send_header("Content-Length", str(len(body)))
+        self.send_header("Cache-Control", "no-store")
+        self.end_headers()
+        self.wfile.write(body)
+
+    def do_OPTIONS(self) -> None:  # noqa: N802
+        if not _allowed_origin(self.headers.get("Origin")):
+            self._json(403, {"error": "Источник запроса не разрешён"}, cors=False)
+            return
+        self.send_response(204)
+        self._cors()
+        self.end_headers()
+
+    def do_GET(self) -> None:  # noqa: N802
+        if self.path == "/health":
+            self._json(200, {"ok": True, "queue": QUEUE, "bridgeSchemaVersion": BRIDGE_SCHEMA_VERSION})
+            return
+        if self.path == "/tracker/token/status":
+            self._json(200, {"configured": _tracker_token_present()})
+            return
+        else:
+            self._json(404, {"error": "Не найдено"})
+
+    def do_POST(self) -> None:  # noqa: N802
+        if not _allowed_origin(self.headers.get("Origin")):
+            self._json(403, {"error": "Источник запроса не разрешён"}, cors=False)
+            return
+        if self.path not in {"/tracker/sync", "/tracker/token"}:
+            self._json(404, {"error": "Не найдено"})
+            return
+        try:
+            length = min(int(self.headers.get("Content-Length", "0") or 0), 100_000)
+            payload = json.loads(self.rfile.read(length)) if length else {}
+            if not isinstance(payload, dict):
+                raise ValueError("Тело запроса должно быть JSON-объектом.")
+            if self.path == "/tracker/token":
+                _store_tracker_token(payload.get("token", ""))
+                self.server.reset_tracker_service()  # type: ignore[attr-defined]
+                self._json(200, {"configured": True})
+                return
+            if not _tracker_token_present():
+                self._json(428, {"code": "token_required", "error": "Для синхронизации настройте токен Tracker."})
+                return
+            result = self.server.get_tracker_service().sync(payload)  # type: ignore[attr-defined]
+            self._json(200, result)
+        except Exception as error:  # Tracker client already masks the token.
+            self._json(502, {"error": str(error)[:1000]})
+
+    def log_message(self, format_string: str, *args) -> None:
+        sys.stderr.write("[tracker-bridge] " + format_string % args + "\n")
+
+
+def main() -> None:
+    server = TrackerHTTPServer((HOST, PORT), Handler)
+    print(f"Plan Fact Tracker bridge: http://{HOST}:{PORT} ({QUEUE})", flush=True)
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        server.server_close()
+
+
+if __name__ == "__main__":
+    main()
