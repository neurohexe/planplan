+"use strict";
+
+const assert = require("node:assert/strict");
+const crypto = require("node:crypto");
+const test = require("node:test");
+
+function testUrls() {
+  const values = String(process.env.PLAN_FACT_MULTI_INSTANCE_TEST_URLS || "")
+    .split(",")
+    .map((value) => value.trim())
+    .filter(Boolean);
+  if (!values.length) return null;
+  if (values.length !== 2) throw new Error("PLAN_FACT_MULTI_INSTANCE_TEST_URLS должен содержать два URL");
+  for (const value of values) {
+    const url = new URL(value);
+    if (url.protocol !== "http:" || !["127.0.0.1", "localhost"].includes(url.hostname)) {
+      throw new Error("Multi-instance тест разрешён только для локальных HTTP URL");
+    }
+  }
+  return values;
+}
+
+const urls = testUrls();
+const origin = "http://plan-fact.local.test";
+
+async function jsonRequest(baseUrl, pathname, {
+  method = "GET",
+  body = null,
+  cookie = null,
+  identity = { login: "test_admin", uid: "10001" }
+} = {}) {
+  const headers = {
+    Origin: origin,
+    "X-Plan-Fact-Staff-Login": identity.login,
+    "X-Plan-Fact-Staff-Uid": identity.uid
+  };
+  if (body != null) headers["Content-Type"] = "application/json";
+  if (cookie) headers.Cookie = cookie;
+  const response = await fetch(`${baseUrl}${pathname}`, {
+    method,
+    headers,
+    body: body == null ? undefined : JSON.stringify(body)
+  });
+  const payload = await response.json();
+  return { response, payload, cookie: response.headers.get("set-cookie")?.split(";", 1)[0] || null };
+}
+
+test("PostgresHttp_TwoBackendInstancesRetryIndependentCreates", {
+  skip: urls ? false : "PLAN_FACT_MULTI_INSTANCE_TEST_URLS не задан"
+}, async () => {
+  const ownerIdentities = [
+    { login: "test_admin", uid: "10001" },
+    { login: "test_admin", uid: "10002" }
+  ];
+  const ownerAttempts = await Promise.all(ownerIdentities.map((identity, index) =>
+    jsonRequest(urls[index], "/api/auth", { identity })));
+  assert.deepEqual(ownerAttempts.map(({ response }) => response.status).sort(), [200, 403]);
+  const ownerIndex = ownerAttempts.findIndex(({ response }) => response.status === 200);
+  const auth = ownerAttempts[ownerIndex];
+  const ownerIdentity = ownerIdentities[ownerIndex];
+  assert.equal(auth.payload.user.staffLogin, "test_admin");
+  assert.ok(auth.cookie);
+
+  const suffix = crypto.randomUUID();
+  const createSecond = await jsonRequest(urls[0], "/api/mutate", {
+    method: "POST",
+    cookie: auth.cookie,
+    identity: ownerIdentity,
+    body: {
+      type: "saveAccount",
+      mutationId: `account-${suffix}`,
+      payload: { staffLogin: `second.${suffix}`, name: `Second Admin ${suffix}`, role: "admin" }
+    }
+  });
+  assert.equal(createSecond.response.status, 200);
+
+  const secondIdentity = { login: `second.${suffix}`, uid: `uid-${suffix}` };
+  const secondLogin = await jsonRequest(urls[1], "/api/auth", { identity: secondIdentity });
+  assert.equal(secondLogin.response.status, 200);
+  assert.ok(secondLogin.cookie);
+
+  const [firstState, secondState] = await Promise.all([
+    jsonRequest(urls[0], "/api/state", { cookie: auth.cookie, identity: ownerIdentity }),
+    jsonRequest(urls[1], "/api/state", { cookie: secondLogin.cookie, identity: secondIdentity })
+  ]);
+  assert.equal(firstState.payload.state.revision, secondState.payload.state.revision);
+  const baseRevision = firstState.payload.state.revision;
+  const locationIds = [`first-${suffix}`, `second-${suffix}`];
+  const results = await Promise.all([
+    jsonRequest(urls[0], "/api/mutate", {
+      method: "POST",
+      cookie: auth.cookie,
+      identity: ownerIdentity,
+      body: {
+        type: "addLocation",
+        mutationId: `location-first-${suffix}`,
+        baseRevision,
+        payload: { id: locationIds[0], name: "First concurrent location" }
+      }
+    }),
+    jsonRequest(urls[1], "/api/mutate", {
+      method: "POST",
+      cookie: secondLogin.cookie,
+      identity: secondIdentity,
+      body: {
+        type: "addLocation",
+        mutationId: `location-second-${suffix}`,
+        baseRevision,
+        payload: { id: locationIds[1], name: "Second concurrent location" }
+      }
+    })
+  ]);
+  assert.deepEqual(results.map(({ response }) => response.status).sort(), [200, 200]);
+
+  const finalStates = await Promise.all([
+    jsonRequest(urls[0], "/api/state", { cookie: auth.cookie, identity: ownerIdentity }),
+    jsonRequest(urls[1], "/api/state", { cookie: secondLogin.cookie, identity: secondIdentity })
+  ]);
+  assert.equal(finalStates[0].payload.state.revision, baseRevision + 2);
+  assert.equal(finalStates[1].payload.state.revision, baseRevision + 2);
+  const persistedIds = new Set(finalStates[0].payload.state.locations.map((item) => item.id));
+  assert.equal(locationIds.filter((id) => persistedIds.has(id)).length, 2);
+});
