+#!/usr/bin/env node
+
+import { constants } from "node:fs";
+import fs from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const WORKSPACE = path.resolve(fileURLToPath(new URL("..", import.meta.url)));
+const FLAGS = new Map([
+  ["--config-dir", "configDir"], ["--tvm-id", "tvmId"], ["--system", "systemSlug"],
+  ["--alias", "selfAlias"], ["--port", "port"], ["--proxy-port", "proxyPort"]
+]);
+
+const fail = (message) => { throw new Error(message); };
+const integer = (value, min, max, label) => {
+  if (!/^[0-9]+$/.test(String(value ?? ""))) fail(`Некорректный параметр ${label}`);
+  const number = Number(value);
+  if (!Number.isSafeInteger(number) || number < min || number > max) fail(`Некорректный параметр ${label}`);
+  return number;
+};
+
+export function parseArgs(args, env = {}) {
+  const options = {};
+  for (let index = 0; index < args.length; index += 2) {
+    const name = FLAGS.get(args[index]);
+    const value = args[index + 1];
+    if (!name || Object.hasOwn(options, name) || !value || value.startsWith("--")) fail("Укажите каждый поддерживаемый параметр один раз");
+    options[name] = value;
+  }
+  if (!Object.hasOwn(options, "tvmId") && env.PLAN_FACT_TVM_ID) options.tvmId = env.PLAN_FACT_TVM_ID;
+  return options;
+}
+
+async function statMaybe(target) {
+  try { return await fs.lstat(target); }
+  catch (error) { if (error.code === "ENOENT") return null; throw error; }
+}
+
+async function privateDirectory(target) {
+  const relative = path.relative(WORKSPACE, target);
+  let current = WORKSPACE;
+  for (const part of relative.split(path.sep)) {
+    current = path.join(current, part);
+    let stat = await statMaybe(current);
+    if (!stat) {
+      await fs.mkdir(current, { mode: 0o700 });
+      await fs.chmod(current, 0o700);
+      stat = await fs.lstat(current);
+    }
+    if (stat.isSymbolicLink() || !stat.isDirectory()) fail("Каталог конфигурации не должен проходить через ссылки или файлы");
+    if (typeof process.getuid === "function" && stat.uid !== process.getuid()) fail("Каталог должен принадлежать текущему пользователю");
+  }
+  const stat = await fs.lstat(target);
+  if ((stat.mode & 0o777) !== 0o700) fail("Каталог конфигурации должен иметь права 0700");
+  if (await fs.realpath(target) !== target) fail("Каталог конфигурации не должен проходить через символические ссылки");
+}
+
+export async function writeCorporateTvmtoolConfig(options) {
+  const tvmId = integer(options.tvmId, 1, 4_294_967_295, "--tvm-id");
+  const port = integer(options.port, 18_767, 65_535, "--port");
+  const proxyPort = integer(options.proxyPort, 18_767, 65_535, "--proxy-port");
+  if (port === proxyPort) fail("Порты tvmtool и проверки актуальности должны различаться");
+  if (!/^[a-z0-9][a-z0-9_-]{0,99}$/.test(options.systemSlug || "")) fail("Некорректный параметр --system");
+  if (!/^[a-zA-Z0-9_-]{1,100}$/.test(options.selfAlias || "")) fail("Некорректный параметр --alias");
+  if (typeof options.configDir !== "string" || !options.configDir || /[\x00-\x1f\x7f]/.test(options.configDir)) fail("Укажите --config-dir внутри .sandbox");
+  const configDir = path.resolve(WORKSPACE, options.configDir);
+  const relative = path.relative(path.join(WORKSPACE, ".sandbox"), configDir);
+  if (!relative || relative === ".." || relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative)) fail("Конфигурация разрешена только в отдельном каталоге внутри .sandbox");
+  await privateDirectory(configDir);
