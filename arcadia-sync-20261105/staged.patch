+    const result = await writeCorporateTvmtoolConfig(parseArgs(process.argv.slice(2), process.env));
+    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
+  } catch (error) {
+    // Do not echo command-line values or underlying filesystem/HTTP errors.
+    const allowed = /^(Некорректный параметр --|Укажите |Каталог |Конфигурация разрешена |Файл конфигурации уже |Порты tvmtool)/;
