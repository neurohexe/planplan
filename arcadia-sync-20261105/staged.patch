+test("CorporateTvmConfig_RequiresExplicitValidSettingsAndSandboxPorts", async (t) => {
+  const root = await directory(t);
+  const { writeCorporateTvmtoolConfig, parseArgs } = await helper;
+  const options = { ...defaults, configDir: path.join(root, "valid") };
+  for (const change of [
+    { tvmId: undefined }, { tvmId: "1.5" }, { tvmId: "0" }, { tvmId: "4294967296" },
+    { port: "18766" }, { proxyPort: "18766" }, { port: "18769" }, { proxyPort: "65536" },
+    { systemSlug: "../fixture" }, { selfAlias: "fixture/bad" },
