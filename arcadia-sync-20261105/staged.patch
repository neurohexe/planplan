+"use strict";
+
+const assert = require("node:assert/strict");
+const crypto = require("node:crypto");
+const test = require("node:test");
+const { PlanFactService } = require("../src/service.js");
+const { PostgresStore, poolOptions } = require("../src/postgres-store.js");
+
+function testDatabaseUrl() {
+  const raw = String(process.env.PLAN_FACT_TEST_DATABASE_URL || "").trim();
+  if (!raw) return null;
+  const url = new URL(raw);
+  const localHost = url.hostname === "127.0.0.1" || url.hostname === "localhost";
+  if (!localHost || !url.pathname.endsWith("_test")) {
+    throw new Error("PLAN_FACT_TEST_DATABASE_URL разрешён только для локальной БД с именем *_test");
+  }
+  return raw;
+}
+
+const databaseUrl = testDatabaseUrl();
+const config = databaseUrl ? {
+  databaseUrl,
+  databaseSsl: "disable",
+  databaseCaFile: null,
+  databasePoolMax: 4,
+  databaseStatementTimeoutMs: 30_000,
+  production: false
+} : null;
+
+test("PostgresConfig_RejectsInsecureProductionTls", () => {
+  const base = {
+    databaseUrl: "postgres://user@db.example/plan_fact",
+    databaseCaFile: null,
+    databasePoolMax: 10,
+    databaseStatementTimeoutMs: 30_000,
+    production: true
+  };
+  assert.throws(() => poolOptions({ ...base, databaseSsl: "disable" }), /TLS/);
+  assert.throws(() => poolOptions({
+    ...base,
+    databaseSsl: "verify-full",
+    databaseUrl: `${base.databaseUrl}?sslmode=verify-full`
+  }), /sslmode/);
+  assert.equal(poolOptions({ ...base, databaseSsl: "verify-full" }).ssl.rejectUnauthorized, true);
+});
+
+test("PostgresStore_TwoInstancesCommitOneRevisionAndPersistAfterReconnect", {
+  skip: databaseUrl ? false : "PLAN_FACT_TEST_DATABASE_URL не задан"
+}, async () => {
+  const first = await PostgresStore.create(config, { initialState: PlanFactService.initialState });
+  const second = await PostgresStore.create(config, { initialState: PlanFactService.initialState });
+  let expectedRevision;
+  try {
+    const current = await first.getState();
+    expectedRevision = current.revision;
+    const nextState = {
+      ...current,
+      revision: expectedRevision + 1,
+      postgresSmoke: crypto.randomUUID()
+    };
+    const results = await Promise.all([
+      first.commitStateMutation({
+        mutationId: `pg-test-${crypto.randomUUID()}`,
+        expectedRevision,
+        nextState,
+        audit: { actorName: "Тест", action: "test.postgres.concurrent" }
+      }),
+      second.commitStateMutation({
+        mutationId: `pg-test-${crypto.randomUUID()}`,
+        expectedRevision,
+        nextState: { ...nextState, postgresSmoke: crypto.randomUUID() },
+        audit: { actorName: "Тест", action: "test.postgres.concurrent" }
+      })
+    ]);
+    assert.deepEqual(results.map((item) => item.saved).sort(), [false, true]);
+  } finally {
+    await Promise.all([first.close(), second.close()]);
+  }
+
+  const reopened = await PostgresStore.create(config, { initialState: PlanFactService.initialState });
+  try {
+    assert.equal((await reopened.getState()).revision, expectedRevision + 1);
+  } finally {
+    await reopened.close();
+  }
+});
+
+test("PostgresStore_IdmRolesAreAtomicAndSerializedPerLogin", {
+  skip: databaseUrl ? false : "PLAN_FACT_TEST_DATABASE_URL не задан"
+}, async () => {
+  const store = await PostgresStore.create(config, { initialState: PlanFactService.initialState });
+  const staffLogin = `idm-${crypto.randomUUID().slice(0, 8)}`;
+  const closedSessions = [];
+  try {
+    const service = new PlanFactService({
+      store,
+      realtime: { closeSession(id) { closedSessions.push(id); }, publish() {} },
+      config: { sessionMaxAgeMs: 24 * 60 * 60 * 1000, lockTtlMs: 120_000, requireLocks: true, roleSource: "idm" }
+    });
+    // Два одновременных запроса IDM про нового сотрудника: один аккаунт и обе роли.
+    const results = await Promise.all([
+      service.idmAddRole({ login: staffLogin, role: "user" }),
+      service.idmAddRole({ login: staffLogin, role: "admin" })
+    ]);
+    assert.equal(results.filter((item) => item.created).length, 1);
+    const user = await store.getUserByStaffLogin(staffLogin);
+    assert.equal(user.role, "admin");
+    assert.deepEqual(
+      (await service.listIdmRoles()).filter((item) => item.login === staffLogin).map((item) => item.path),
+      ["/role/admin/", "/role/user/"]
+    );
+
+    await store.replaceLocationAccess(user.id, { office: "edit" });
+    const { session } = await service.loginWithStaff({
+      identity: { login: staffLogin, uid: `${staffLogin}-uid` },
+      ip: "127.0.0.1",
+      userAgent: "idm-postgres-test"
+    });
+    assert.equal((await service.idmRemoveRole({ login: staffLogin, role: "admin", fired: false })).effectiveRole, "user");
+    const last = await service.idmRemoveRole({ login: staffLogin, role: "user", fired: true });
+    assert.deepEqual([last.wasGranted, last.deactivated], [true, true]);
+    assert.deepEqual(closedSessions, [session.id]);
+
+    const revoked = await store.getUserByStaffLogin(staffLogin);
+    assert.equal(revoked.active, 0);
+    assert.equal(revoked.default_location_access, "hidden");
+    assert.deepEqual(await store.getLocationAccess(revoked.id), {});
+    assert.equal(await store.getActiveUserSession(revoked.id), null);
+    assert.equal((await service.listIdmRoles()).some((item) => item.login === staffLogin), false);
+    assert.equal((await service.idmRemoveRole({ login: staffLogin, role: "user", fired: true })).wasGranted, false);
+  } finally {
+    await store.close();
+  }
+});
+
+test("PostgresStore_IdmCardSaveRaceReactivationAndRenameStayConsistent", {
+  skip: databaseUrl ? false : "PLAN_FACT_TEST_DATABASE_URL не задан"
+}, async () => {
+  const store = await PostgresStore.create(config, { initialState: PlanFactService.initialState });
+  const suffix = crypto.randomUUID().slice(0, 8);
+  try {
+    const service = new PlanFactService({
+      store,
+      realtime: { closeSession() {}, publish() {} },
+      config: { sessionMaxAgeMs: 24 * 60 * 60 * 1000, lockTtlMs: 120_000, requireLocks: true, roleSource: "idm" }
+    });
+
+    // Сохранение карточки и отзыв роли одновременно: в любом порядке доступ не возвращается.
+    for (let attempt = 0; attempt < 8; attempt += 1) {
+      const staffLogin = `idmrace-${suffix}-${attempt}`;
+      await service.idmAddRole({ login: staffLogin, role: "user" });
+      const user = await store.getUserByStaffLogin(staffLogin);
+      const [revoke, save] = await Promise.allSettled([
+        service.idmRemoveRole({ login: staffLogin, role: "user", fired: true }),
+        store.updateUser(user.id, {
+          defaultLocationAccess: "view",
+          locationAccess: { office: "edit" },
+          expect: { active: true, role: "user" }
+        })
+      ]);
+      assert.equal(revoke.status, "fulfilled");
+      if (save.status === "rejected") assert.equal(save.reason.code, "idm_access_changed");
+      const stored = await store.getUserByStaffLogin(staffLogin);
+      assert.deepEqual([stored.active, stored.default_location_access], [0, "hidden"], `attempt ${attempt}`);
+      assert.deepEqual(await store.getLocationAccess(user.id), {}, `attempt ${attempt}`);
+    }
+
+    // Аккаунт, отключённый в обход IDM, при новой выдаче включается без прежних доступов.
+    const staffLogin = `idmfix-${suffix}`;
+    await service.idmAddRole({ login: staffLogin, role: "admin" });
+    const user = await store.getUserByStaffLogin(staffLogin);
+    await store.replaceLocationAccess(user.id, { office: "edit" });
+    await store.updateUser(user.id, { active: false, defaultLocationAccess: "view" });
+    const reactivated = await service.idmAddRole({ login: staffLogin, role: "user" });
+    assert.equal(reactivated.reactivated, true);
+    const restored = await store.getUserByStaffLogin(staffLogin);
+    assert.deepEqual([restored.active, restored.role, restored.default_location_access], [1, "user", "hidden"]);
+    assert.deepEqual(await store.getLocationAccess(user.id), {});
+
+    // Роль, изменённая в обход IDM, видна в get-roles одним снимком.
+    await store.updateUser(user.id, { role: "admin" });
+    assert.deepEqual(
+      (await service.listIdmRoles()).filter((item) => item.login === staffLogin).map((item) => item.path),
+      ["/role/admin/", "/role/user/"]
+    );
+
+    // Смена логина переносит записи IDM.
+    const renamedLogin = `idmfix-new-${suffix}`;
+    await store.renameStaffLogin(user.id, staffLogin, renamedLogin);
+    assert.equal((await store.getUser(user.id)).staff_login, renamedLogin);
+    const rows = (await store.pool.query(
+      "SELECT staff_login, role FROM idm_roles WHERE staff_login IN ($1, $2) ORDER BY staff_login, role",
+      [staffLogin, renamedLogin]
+    )).rows;
+    assert.deepEqual(rows.map((row) => `${row.staff_login}:${row.role}`), [`${renamedLogin}:user`]);
+  } finally {
+    await store.close();
+  }
+});
