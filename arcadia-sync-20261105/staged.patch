+#!/bin/bash
+# Задача 13, шаги 1–3 на НОВОМ компьютере: проверка компьютера, тесты мастерской и установка стенда без запуска.
+# Запуск из распакованной мастерской: bash <мастерская>/deploy/move/prepare-new.sh
+# Если стенд уже установлен (мини-ПК), обновляет его код и скрипты: база, коды и настройки сохраняются,
+# стенд остаётся остановленным до дня переезда. Туннель не включает, базу и личные коды не читает.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=move-common.sh
+. "$SCRIPT_DIR/move-common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: prepare-new.sh'
+case "$(uname -s)" in
+  Linux) KIND=linux ;;
+  Darwin) KIND=laptop ;;
+  *) fail 'Поддерживаются только Linux и macOS.' ;;
+esac
+STAND=${PLANFACT_HOME:-$HOME/PlanFactMVP}
+case "$STAND" in /*) ;; *) fail 'PLANFACT_HOME должен быть полным путём, начиная с /.' ;; esac
+
+# Node: тот, что записан в настройках установленного стенда, иначе из PATH или ~/.local/bin.
+NODE=''
+if [ -f "$STAND/config.env" ] && [ ! -L "$STAND/config.env" ]; then
+  NODE=$(set -a; . "$STAND/config.env"; printf '%s' "${PLAN_FACT_NODE_BIN:-}") || NODE=''
+fi
+[ -n "$NODE" ] || NODE=$(command -v node || true)
+[ -n "$NODE" ] || [ ! -x "$HOME/.local/bin/node" ] || NODE="$HOME/.local/bin/node"
+[ -n "$NODE" ] || fail 'Не найден Node 22.5 или новее. Сначала установите Node.'
+case "$NODE" in /*) ;; *) NODE="$(CDPATH= cd -- "$(dirname -- "$NODE")" && pwd -P)/$(basename -- "$NODE")" ;; esac
+move_require_node "$NODE"
+NODE_DIR=$(dirname -- "$NODE")
+
+say '1. Компьютер'
+if [ "$KIND" = linux ]; then
+  system=$( { . /etc/os-release && printf '%s' "${PRETTY_NAME:-Linux}"; } 2> /dev/null || printf 'Linux')
+else
+  system="macOS $(sw_vers -productVersion 2> /dev/null || true)"
+fi
+say "Учётная запись: $(id -un). Компьютер: $(hostname). Система: $system, процессор $(uname -m)."
+say "Node: $("$NODE" --version) ($NODE)."
+if [ "$KIND" = laptop ]; then
+  say "FileVault: $(fdesetup status 2> /dev/null | head -n 1 || printf 'проверить не удалось')"
+else
+  say 'Шифрование диска покажет состояние стенда в конце.'
+fi
+say "Свободно на диске: $(df -h "$HOME" | awk 'NR == 2 { print $4 }')."
+
+say ''
+say '2. Тесты мастерской'
+mkdir -p "$PROJECT_ROOT/.sandbox"
+chmod 700 "$PROJECT_ROOT/.sandbox"
+LOG="$PROJECT_ROOT/.sandbox/prepare-npm-test.log"
+status=0
+if [ -x "$NODE_DIR/npm" ]; then
+  (cd "$PROJECT_ROOT" && PATH="$NODE_DIR:$PATH" NPM_CONFIG_UPDATE_NOTIFIER=false "$NODE_DIR/npm" test) > "$LOG" 2>&1 || status=$?
+else
+  (cd "$PROJECT_ROOT" && PATH="$NODE_DIR:$PATH" "$NODE" --experimental-sqlite --test app/tests/*.test.js backend/tests/*.test.js) > "$LOG" 2>&1 || status=$?
+fi
+grep -E '^# (tests|pass|fail|skipped) ' "$LOG" || true
+[ "$status" -eq 0 ] || fail "Тесты не прошли (код $status) — установку не начинаю. Пришлите Стефании этот вывод; полный журнал: $LOG"
+
+say ''
+say '3. Установка стенда без запуска'
+# Проверочная установка без автозапуска (автотесты) обновляется так же, без автозапуска.
+TEST_INSTALL=false
+if [ -f "$STAND/launchd/.no-launchd" ] || [ -f "$STAND/systemd/.no-systemd" ]; then
+  TEST_INSTALL=true
+fi
+if [ "$TEST_INSTALL" = true ] && [ "$KIND" = laptop ]; then
+  PATH="$NODE_DIR:$PATH" /bin/bash "$PROJECT_ROOT/deploy/laptop/install.sh" --no-launchd --no-start < /dev/null
+elif [ "$TEST_INSTALL" = true ]; then
+  PATH="$NODE_DIR:$PATH" /bin/bash "$PROJECT_ROOT/deploy/linux/install.sh" --no-systemd --no-start < /dev/null
+else
+  PATH="$NODE_DIR:$PATH" /bin/bash "$PROJECT_ROOT/deploy/$KIND/install.sh" --no-start < /dev/null
+fi
+
+say ''
+say '4. Готовность туннеля (туннель не включаю)'
+if [ "$TEST_INSTALL" = true ]; then
+  say 'Проверочная установка без автозапуска: туннель не проверяю.'
+else
+  if [ "$KIND" = linux ] && ! grep -q '^PLAN_FACT_TUNNEL_USERNAME=' "$STAND/config.env"; then
+    say "Логин туннеля в config.env ещё не задан; сеть проверяю с логином учётной записи $(id -un)."
+    PLAN_FACT_TUNNEL_USERNAME=$(id -un) "$STAND/bin/tunnel-check.sh" < /dev/null > "$PROJECT_ROOT/.sandbox/prepare-tunnel-check.log" 2>&1 || true
+  else
+    "$STAND/bin/tunnel-check.sh" < /dev/null > "$PROJECT_ROOT/.sandbox/prepare-tunnel-check.log" 2>&1 || true
+  fi
+  cat "$PROJECT_ROOT/.sandbox/prepare-tunnel-check.log"
+  # Стенд этого компьютера только что остановлен вместе с туннелем: ответ адреса может прийти только с другого компьютера.
+  if grep -q 'Адрес туннеля отвечает' "$PROJECT_ROOT/.sandbox/prepare-tunnel-check.log"; then
+    say 'Пояснение к пункту 4: туннель на этом компьютере выключен, значит, по этому адресу сейчас отвечает'
+    say 'другой компьютер (старый, где работают коллеги). Для подготовки это нормально: итог «туннель работает»'
+    say 'относится к нему. Туннель этого компьютера проверим отдельно.'
+  fi
+fi
+
+say ''
+say '5. Состояние стенда'
+"$STAND/bin/status.sh" < /dev/null || true
+say ''
+say 'Готово: компьютер проверен, тесты прошли, стенд обновлён и остановлен до дня переезда. Туннель выключен.'
+say 'Пришлите Стефании весь вывод этой команды.'
