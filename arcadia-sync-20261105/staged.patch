+++ b/junk/padolskiye/plan_fact_minipc/backend_django/planfact/tests/parity.py
@@ -0,0 +1,669 @@
+"""Сверка переноса правил с исходным JavaScript.
+
+Python-реализация и исходные app/*.js получают одни и те же шаги с одинаковыми «часами» и
+идентификаторами; результаты сравниваются после каждого шага. Нужен Node 22 (переменная
+PLAN_FACT_NODE_BIN или node в PATH) и исходники рядом (app/, backend/src/).
+"""
+
+from __future__ import annotations
+
+import itertools
+import json
+import os
+import random
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any, Callable
+
+from planfact.domain import context, js, mutations, rules, state as state_module
+from planfact.errors import AppError
+from planfact import access_codes
+
+HARNESS = Path(__file__).with_name("js_harness.js")
+REPO_ROOT = Path(os.environ.get("PLAN_FACT_REPO_ROOT", Path(__file__).resolve().parents[3]))
+
+
+def node_binary() -> str | None:
+    configured = os.environ.get("PLAN_FACT_NODE_BIN")
+    if configured and Path(configured).exists():
+        return configured
+    found = shutil.which("node") or str(Path.home() / ".local" / "bin" / "node")
+    return found if found and Path(found).exists() else None
+
+
+def js_sources_available() -> bool:
+    return (REPO_ROOT / "app" / "app.js").exists() and (REPO_ROOT / "backend" / "src" / "domain.js").exists()
+
+
+def run_node(task: dict, env: dict | None = None) -> Any:
+    binary = node_binary()
+    if binary is None:
+        raise RuntimeError("Node не найден")
+    process_env = {**os.environ, "PLAN_FACT_REPO_ROOT": str(REPO_ROOT), **(env or {})}
+    result = subprocess.run(
+        [binary, str(HARNESS)], input=js.dumps(task), capture_output=True, text=True, env=process_env, check=False
+    )
+    if result.returncode != 0:
+        raise RuntimeError(f"Node завершился с ошибкой: {result.stderr[-2000:]}")
+    return json.loads(result.stdout)
+
+
+def _ids(prefix: str) -> Callable[[], str]:
+    counter = itertools.count(1)
+    return lambda: f"{prefix}-{next(counter)}"
+
+
+def describe(error: BaseException) -> dict:
+    if isinstance(error, AppError):
+        return {"ok": False, "error": error.message, "kind": "Error", "statusCode": error.status}
+    return {"ok": False, "error": f"{type(error).__name__}: {error}", "kind": "crash"}
+
+
+STARTUP_MS = 1_790_000_000_000
+
+
+def startup_quarter() -> str:
+    from planfact.domain import common
+    return common._quarter_of(STARTUP_MS)
+
+
+def run_python(now: int, prefix: str, fn: Callable[[], Any]) -> dict:
+    with context.fixed(clock=lambda: now, ids=_ids(prefix), selected_quarter=startup_quarter()):
+        try:
+            return {"ok": True, "value": json.loads(js.dumps(fn()))}
+        except Exception as error:  # noqa: BLE001 — сравнивается сам факт отказа
+            return describe(error)
+
+
+def python_sequence(initial: dict, steps: list[dict]) -> list[dict]:
+    current = initial
+    outcomes = []
+    for step in steps:
+        outcome = run_python(step["now"], step.get("idPrefix", "id"),
+                             lambda: mutations.apply_local_mutation(current, step["type"], step["payload"]))
+        if outcome["ok"]:
+            current = json.loads(js.dumps(outcome["value"]))
+        outcomes.append(outcome)
+    return outcomes
+
+
+def same_outcome(python: dict, node: dict) -> tuple[bool, str]:
+    if python["ok"] != node["ok"]:
+        return False, f"python ok={python['ok']} ({python.get('error')}), node ok={node['ok']} ({node.get('error')})"
+    if python["ok"]:
+        if js.dumps(python["value"]) != js.dumps(node["value"]):
+            return False, first_difference(python["value"], node["value"])
+        return True, ""
+    node_kind = "Error" if node.get("name") == "Error" else "crash"
+    if node_kind != python["kind"]:
+        return False, f"вид отказа: python {python['kind']} ({python['error']}), node {node.get('name')} ({node['error']})"
+    if node_kind == "Error" and python["error"] != node["error"]:
+        return False, f"текст отказа: python «{python['error']}», node «{node['error']}»"
+    if node_kind == "Error" and node.get("statusCode") and node["statusCode"] != python.get("statusCode"):
+        return False, f"статус: python {python.get('statusCode')}, node {node['statusCode']}"
+    return True, ""
+
+
+def first_difference(left: Any, right: Any, path: str = "$") -> str:
+    if type(left) is not type(right) and not (type(left) in (int, float) and type(right) in (int, float)):
+        return f"{path}: python {json.dumps(left, ensure_ascii=False)[:300]} / node {json.dumps(right, ensure_ascii=False)[:300]}"
+    if isinstance(left, dict):
+        if list(left.keys()) != list(right.keys()):
+            return f"{path}: ключи python {list(left.keys())} / node {list(right.keys())}"
+        for key in left:
+            if js.dumps(left[key]) != js.dumps(right[key]):
+                return first_difference(left[key], right[key], f"{path}.{key}")
+    if isinstance(left, list):
+        if len(left) != len(right):
+            return f"{path}: длина python {len(left)} / node {len(right)}"
+        for index, (a, b) in enumerate(zip(left, right)):
+            if js.dumps(a) != js.dumps(b):
+                return first_difference(a, b, f"{path}[{index}]")
+    return f"{path}: python {json.dumps(left, ensure_ascii=False)[:300]} / node {json.dumps(right, ensure_ascii=False)[:300]}"
+
+
+PYTHON_CALLS: dict[str, Callable[..., Any]] = {
+    "normalizeState": state_module.normalize_state,
+    "applyLocalMutation": mutations.apply_local_mutation,
+    "projectState": lambda state, user, access, hidden: rules.project_state(state, user, access, hidden or {}),
+    "stampActor": rules.stamp_actor,
+    "authorizeMutation": lambda data: rules.authorize_mutation(data["type"], data["payload"], data["state"], data["user"], data["access"]) or True,
+    "authorizeLock": lambda data: rules.authorize_lock(data["resourceType"], data["resourceId"], data["state"], data["user"], data["access"]) or True,
+    "assertImportLocations": lambda before, after, user, access: rules.assert_import_locations(before, after, user, access) or True,
+    "mutationLocationIds": rules.mutation_location_ids,
+    "changedLocationIds": rules.changed_location_ids,
+    "lockResource": rules.lock_resource,
+    "auditEntity": rules.audit_entity,
+    "warningLocation": rules.warning_location,
+    "visibleState": rules.visible_state,
+    "locationAccess": rules.location_access,
+    "sanitizeAuditPayload": rules.sanitize_audit_payload,
+    "cleanPayload": rules.clean_payload,
+    "canRetryCreateMutation": rules.can_retry_create_mutation,
+    "normalizeAccessCode": access_codes.normalize_access_code,
+    "safeUrl": lambda value: __import__("planfact.domain.common", fromlist=["safe_http_url"]).safe_http_url(value),
+    "dateParse": lambda value: (lambda ms: None if ms != ms else int(ms))(__import__("planfact.domain.dates", fromlist=["parse"]).parse(value)),
+    "localeCompare": lambda left, right: __import__("planfact.domain.collation", fromlist=["ru_compare"]).ru_compare(left, right),
+}
+
+
+def compare_calls(calls: list[dict], env: dict | None = None) -> list[str]:
+    node_results = run_node({"mode": "calls", "calls": calls}, env)
+    problems = []
+    for call, node in zip(calls, node_results):
+        args = json.loads(js.dumps(call["args"]))  # отдельная копия: часть функций меняет аргументы на месте, как в JS
+        python = run_python(call["now"], call.get("idPrefix", "id"), lambda: PYTHON_CALLS[call["fn"]](*args))
+        ok, why = same_outcome(python, node)
+        if not ok:
+            problems.append(f"{call['fn']}: {why}\n  аргументы: {js.dumps(call['args'])[:600]}")
+    return problems
+
+
+def compare_sequences(sequences: list[dict], env: dict | None = None) -> list[str]:
+    node_results = run_node({"mode": "sequences", "sequences": sequences}, env)
+    problems = []
+    for sequence, node_outcomes in zip(sequences, node_results):
+        python_outcomes = python_sequence(sequence["initial"], sequence["steps"])
+        for index, (step, python, node) in enumerate(zip(sequence["steps"], python_outcomes, node_outcomes)):
+            ok, why = same_outcome(python, node)
+            if not ok:
+                problems.append(
+                    f"цепочка {sequence['seed']}, шаг {index} {step['type']}: {why}\n  payload: {js.dumps(step['payload'])[:800]}"
+                )
+                break
+    return problems
+
+
+# ---------------------------------------------------------------------------
+# Генератор случайных шагов
+
+
+DATES = [
+    "2026-04-15", "2026-05-31", "2026-06-30", "2026-07-01", "2026-08-15", "2026-09-30", "2026-10-01", "2026-10-14",
+    "2026-11-03", "2026-11-30", "2026-12-31", "2027-01-15", "2027-02-28", "2027-03-31",
+]
+BAD_DATES = ["2026-02-30", "2026-13-01", "", None, 20261103, "2026-1-3", "0050-01-01", "2026-11-03T10:00:00Z", js.UNDEF]
+QUARTERS = ["2026-Q2", "2026-Q3", "2026-Q4", "2027-Q1"]
+BAD_QUARTERS = ["2026-Q5", "2026Q4", "", None, "2026-q4", 2026]
+MONTHS = ["2026-04", "2026-05", "2026-06", "2026-07", "2026-08", "2026-09", "2026-10", "2026-11", "2026-12", "2027-01", "2027-02", "2027-03"]
+CURRENCIES = ["RUB", "USD", "UZS", "KZT"]
+BAD_CURRENCIES = ["usd", " EUR ", "", None, "RUBX", 5, "ru"]
+URLS = [
+    "https://st.yandex-team.ru/TAXIASSIST-12", "https://example.com/TEST-1", "http://example.com/a b",
+    "https://пример.рф/путь?запрос=да", "https://EXAMPLE.com:443/x/../y?q=1#f", "https://st.yandex-team.ru/taxiassist-77",
+]
+BAD_URLS = ["ftp://example.com/x", "not a url", "", None, "javascript:alert(1)", "//example.com/x", 42]
+NAMES = [
+    "Офис", "  Офис   Москва ", "Ташкент-Сити", "Бишкек", "Moscow office", "Лилит", "Степанян Лилит", "Иванов Иван",
+    "Ёлкина", "елкина", "Æsir", "straße", "x" * 130, "Офис 😀 2",
+]
+BAD_NAMES = ["", "   ", None, 5, ["Офис"], {"name": "x"}]
+CODES = ["MSK", "TAS", "BSK", " msk ", "P1", "P2", "OPEX-1", "CAP-9", "LONGCODE" * 12]
+AMOUNTS = [100, 250.5, 1000, 0.1, 1e9, "300", "12.5", 7]
+BAD_AMOUNTS = [0, -5, "abc", None, True, float("inf"), "", [5], js.UNDEF]
+STATUSES = ["В работе", "Утвержден", "Предварительно утвержден", "Отклонен", "Не завершен", "Закрыт", "Черновик", "", None]
+
+
+class Generator:
+    def __init__(self, seed: int):
+        self.random = random.Random(seed)
+
+    def pick(self, items: list, bad: list | None = None, bad_rate: float = 0.12) -> Any:
+        if bad and self.random.random() < bad_rate:
+            return self.random.choice(bad)
+        return self.random.choice(items)
+
+    def maybe(self, rate: float = 0.5) -> bool:
+        return self.random.random() < rate
+
+    def existing(self, items: list, key: str = "id", fresh: str | None = None, miss_rate: float = 0.1) -> Any:
+        if not items or self.random.random() < miss_rate:
+            return fresh if fresh is not None else f"missing-{self.random.randrange(1000)}"
+        return items[self.random.randrange(len(items))].get(key)
+
+    def payload_for(self, kind: str, state: dict) -> dict:
+        locations = state.get("locations", [])
+        articles = state.get("articles", [])
+        expenses = state.get("expenses", [])
+        tickets = state.get("forecastTickets", [])
+        article = self.random.choice(articles) if articles else {}
+        subs = article.get("subarticles", []) if article else []
+        sub_id = self.random.choice(subs)["id"] if subs and self.maybe(0.8) else self.pick([None, "missing-sub", ""], None)
+        location_id = self.existing(locations)
+        author = self.pick(["Алиса", "Боб", "  Кэрол  "], [None, ""], 0.2)
+        if kind in ("addExpense", "updateExpense"):
+            payload = {
+                "locationId": location_id,
+                "articleId": article.get("id", "missing"),
+                "subarticleId": sub_id,
+                "currency": self.pick(CURRENCIES, BAD_CURRENCIES),
+                "amount": self.pick(AMOUNTS, BAD_AMOUNTS),
+                "ticketUrl": self.pick(URLS, BAD_URLS),
+                "comment": self.pick(["Вымышленный расход", "  ", "x" * 600, "Комментарий"], [None, 5]),
+                "expenseDate": self.pick(DATES, BAD_DATES),
+                "author": author,
+            }
+            if kind == "addExpense":
+                if self.maybe(0.6):
+                    payload["id"] = self.pick([f"expense-{self.random.randrange(10**6)}", ""], [None, 5])
+            else:
+                payload["id"] = self.existing(expenses)
+                if self.maybe(0.5) and expenses:
+                    source = next((item for item in expenses if item["id"] == payload["id"]), None)
+                    if source:
+                        for field in ("locationId", "articleId", "subarticleId", "currency"):
+                            payload[field] = source.get(field)
+            return payload
+        if kind in ("cancelExpense", "restoreExpense"):
+            return {"id": self.existing(expenses), "author": author}
+        if kind == "addComment":
+            return {"expenseId": self.existing(expenses), "text": self.pick(["Комментарий", " ок ", "x" * 1200], ["", None]),
+                    "id": self.pick([f"comment-{self.random.randrange(10**6)}", None, ""]), "author": author}
+        if kind in ("addForecast", "updateForecastAllocation"):
+            payload = {
+                "locationId": location_id,
+                "articleId": article.get("id", "missing"),
+                "subarticleId": sub_id,
+                "currency": self.pick(CURRENCIES, BAD_CURRENCIES),
+                "amount": self.pick(AMOUNTS, BAD_AMOUNTS),
+                "ticketUrl": self.pick(URLS, BAD_URLS),
+                "comment": self.pick(["Прогноз", "", "y" * 600]),
+                "expectedDate": self.pick(DATES, BAD_DATES),
+                "requestNumber": self.pick(["ЗП-1", "", None, "  12345  "]),
+                "author": author,
+            }
+            if kind == "addForecast":
+                if self.maybe(0.5):
+                    payload["id"] = f"forecast-{self.random.randrange(10**6)}"
+                    payload["allocationId"] = f"allocation-{self.random.randrange(10**6)}"
+            else:
+                ticket = self.random.choice(tickets) if tickets else {}
+                allocation = self.random.choice(ticket.get("allocations", [{}])) if ticket else {}
+                payload["ticketId"] = ticket.get("id", "missing")
+                payload["allocationId"] = allocation.get("id", "missing")
+                if self.maybe(0.6) and allocation:
+                    for field in ("locationId", "articleId", "subarticleId", "currency"):
