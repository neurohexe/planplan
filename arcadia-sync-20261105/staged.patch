+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+const { AppError } = require("../src/errors.js");
+const { PlanFactHttpServer } = require("../src/http-server.js");
+
+async function withServer(callback, configOverrides = {}, overrides = {}) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "plan-fact-http-"));
+  const publicDir = path.join(root, "public");
+  const backendDir = path.join(root, "backend");
+  fs.mkdirSync(publicDir);
+  fs.mkdirSync(backendDir);
+  fs.writeFileSync(path.join(publicDir, "index.html"), "<!doctype html><title>Plan Fact</title>");
+  fs.writeFileSync(path.join(backendDir, "secret.txt"), "must-not-be-public");
+
+  const realtime = { close() {} };
+  const service = {
+    async readiness() {
+      return { status: "ready", storageDriver: "postgres", revision: 7 };
+    },
+    async sessionByToken() {
+      return null;
+    },
+    async loginWithStaff({ identity }) {
+      const session = { id: "session", userId: "user", user: { staff_login: identity.login, staff_uid: identity.uid } };
+      return { token: "test-session-token", session };
+    },
+    assertStaffIdentity(session) {
+      return session;
+    },
+    async authSummary() {
+      return {
+        user: { id: "user", name: "Test User", staffLogin: "test.user", role: "user" },
+        authentication: "staff-webauth"
+      };
+    },
+    ...overrides.service
+  };
+  const identityProvider = {
+    async authenticate() {
+      return { login: "test.user", uid: "12345" };
+    },
+    ...overrides.identityProvider
+  };
+  const server = new PlanFactHttpServer({
+    service,
+    realtime,
+    identityProvider,
+    idm: overrides.idm || null,
+    config: {
+      host: "127.0.0.1",
+      port: 0,
+      production: true,
+      staticDir: publicDir,
+      allowedOrigins: [],
+      maxRequestBytes: 1024,
+      secureCookies: true,
+      backendVersion: "0.2.0-test",
+      buildCommit: "test-commit",
+      imageDigest: "sha256:test",
+      trustedProxyIps: [],
+      ...configOverrides
+    }
+  });
+
+  const address = await server.listen();
+  try {
+    await callback(`http://127.0.0.1:${address.port}`);
+  } finally {
+    await server.close();
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+}
