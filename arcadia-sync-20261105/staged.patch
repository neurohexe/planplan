+        self.service = runtime.configure(self.config)
+        self.alice = self.service.provision_staff_account(staff_login="alice", name="Алиса", role="superadmin")["account"]
+        self.bob = self.service.provision_staff_account(staff_login="bob", name="Боб", role="admin")["account"]
