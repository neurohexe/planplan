--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/backend_django/planfact/domain/rules.py
@@ -0,0 +1,482 @@
+"""Права и проекция состояния — перенос backend/src/domain.js и access-control.js, а также чистых
+помощников service.js (очистка payload, маскирование журнала, повтор создания)."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from planfact.errors import AppError
+
+from .js import (
+    S, UNDEF, clone, dumps, entries, has_own, is_dict, is_list, is_obj, js_trim, keys, map_get, og, or_, pk, spread,
+    strict_eq, truthy, uniq, values,
+)
+
+ADMIN_MUTATIONS = frozenset({
+    "importBudget", "saveBudget", "copyBudget",
+    "addLocation", "updateLocation", "archiveLocation", "deleteLocation",
+    "addArticle", "updateArticle", "archiveArticle", "deleteArticle",
+    "addSubarticle", "updateSubarticle", "deleteSubarticle",
+    "closePeriod", "reopenPeriod",
+})
+SYSTEM_MUTATIONS = frozenset({"syncTrackerExpenses", "recordTrackerSyncFailure"})
+EDIT_MUTATIONS = frozenset({
+    "addExpense", "updateExpense", "cancelExpense", "restoreExpense",
+    "addForecast", "updateForecastAllocation", "releaseForecastTicket",
+    "restoreForecastTicket", "convertForecastAllocation",
+    "saveTrackerManualMapping", "deleteTrackerManualMapping",
+})
+VIEW_WRITE_MUTATIONS = frozenset({"addComment", "importExpenses"})
+ACCESS_LEVELS = ("hidden", "view", "edit")
+
+
+def is_admin(user: Any) -> bool:
+    return og(user, "role") in ("admin", "superadmin")
+
+
+def location_access(user: Any, access: Any, location_id: Any) -> str:
+    active = og(user, "active")
+    if not truthy(active) and active is not UNDEF:
+        return "hidden"
+    if (og(user, "accessSource") == "tirole" and og(user, "accessScope") == "all-locations"
+            and og(user, "role") in ("member", "admin")):
+        return "edit"
+    if is_admin(user):
+        return "edit"
+    grants = or_(access, {})
+    key = pk(location_id)
+    if has_own(grants, key):
+        level = og(grants, key)
+        return "edit" if level == "edit" else ("view" if level == "view" else "hidden")
+    return "view" if og(user, "defaultLocationAccess") == "view" else "hidden"
+
+
+def can_view(user: Any, access: Any, location_id: Any) -> bool:
+    return location_access(user, access, location_id) != "hidden"
+
+
+def can_edit(user: Any, access: Any, location_id: Any) -> bool:
+    return location_access(user, access, location_id) == "edit"
+
+
+def ticket_locations(ticket: Any) -> list:
+    return uniq(location for location in (og(item, "locationId") for item in or_(og(ticket, "allocations"), [])) if truthy(location))
+
+
+def warning_location(state: Any, warning: Any) -> Any:
+    if truthy(og(warning, "locationId")):
+        return og(warning, "locationId")
+    expense = None
+    if truthy(og(warning, "expenseId")):
+        expense = next((item for item in or_(og(state, "expenses"), []) if strict_eq(og(item, "id"), og(warning, "expenseId"))), None)
+    if expense is not None and truthy(og(expense, "locationId")):
+        return og(expense, "locationId")
+    issue_key = S(or_(og(warning, "issueKey"), "")).upper()
+    if not issue_key:
+        return None
+    linked = next(
+        (item for item in or_(og(state, "expenses"), []) if S(or_(og(item, "sourceKey"), "")).upper() == issue_key), None
+    )
+    if linked is not None and truthy(og(linked, "locationId")):
+        return og(linked, "locationId")
+    ticket = next(
+        (item for item in or_(og(state, "forecastTickets"), [])
+         if S(or_(og(item, "sourceTicketKey"), or_(og(item, "sourceRequestNumber"), ""))).upper() == issue_key),
+        None,
+    )
+    if ticket is not None:
+        locations = ticket_locations(ticket)
+        return locations[0] if locations else None
+    return or_(og(og(og(og(state, "trackerSync"), "manualMappings"), issue_key), "locationId"), None)
+
+
+def relevant_article_ids(projected: dict) -> set:
+    ids: set = set()
+    for store in values(or_(projected.get("budgets"), {})):
+        for key in keys(or_(store, {})):
+            ids.add(key.split("|")[0])
+    for attributes in values(or_(projected.get("projectAttributes"), {})):
+        for key in keys(or_(attributes, {})):
+            ids.add(key)
+    for item in or_(projected.get("expenses"), []):
+        _add_hashable(ids, og(item, "articleId"))
+    for ticket in or_(projected.get("forecastTickets"), []):
+        for item in or_(og(ticket, "allocations"), []):
+            _add_hashable(ids, og(item, "articleId"))
+    return ids
+
+
+def _add_hashable(target: set, value: Any) -> None:
+    try:
+        target.add(value)
+    except TypeError:
+        pass
+
+
+def _contains(container: Any, value: Any) -> bool:
+    try:
+        return value in container
+    except TypeError:
+        return False
+
+
+# --- access-control.js
+
+
+def normalize_access(value: Any, fallback: str = "hidden") -> str:
+    return value if isinstance(value, str) and value in ACCESS_LEVELS else fallback
+
+
+def location_permission(account: Any, location_id: Any) -> str:
+    if not truthy(account) or truthy(og(account, "archived")) or og(account, "active") is False:
+        return "hidden"
+    if (og(account, "accessSource") == "tirole" and og(account, "accessScope") == "all-locations"
+            and og(account, "role") in ("member", "admin")):
+        return "edit"
+    if og(account, "role") in ("admin", "superadmin"):
+        return "edit"
+    grants = or_(og(account, "locationAccess"), {})
+    key = pk(location_id)
+    if has_own(grants, key):
+        return normalize_access(og(grants, key), "hidden")
+    return "view" if og(account, "defaultLocationAccess") == "view" else "hidden"
+
+
+def can_view_location(account: Any, location_id: Any) -> bool:
+    return location_permission(account, location_id) != "hidden"
+
+
+def visible_closed_periods(closed_periods: Any, visible_ids: set) -> dict:
+    source = closed_periods if truthy(closed_periods) and is_obj(closed_periods) else {}
+    quarters: dict = {}
+    for quarter_key, entry in entries(or_(og(source, "quarters"), {})):
+        snapshot = og(entry, "snapshot")
+        by_location: dict = {}
+        for location_id, value in entries(or_(og(snapshot, "byLocation"), {})):
+            if location_id in visible_ids:
+                by_location[location_id] = value
+        quarters[quarter_key] = {**spread(entry), "snapshot": {**spread(snapshot), "byLocation": by_location}} if truthy(snapshot) else entry
+    return {"months": spread(or_(og(source, "months"), {})), "quarters": quarters}
+
+
+def visible_state(state: dict, account: Any) -> dict:
+    visible_ids: dict = {}
+    for location in or_(state.get("locations"), []):
+        if can_view_location(account, og(location, "id")):
+            identifier = og(location, "id")
+            if isinstance(identifier, (str, int, float)) or identifier is None:
+                visible_ids[identifier] = True
+    visible_expense_ids: set = set()
+    for expense in or_(state.get("expenses"), []):
+        if _contains(visible_ids, og(expense, "locationId")):
+            _add_hashable(visible_expense_ids, og(expense, "id"))
+    tickets = []
+    for ticket in or_(state.get("forecastTickets"), []):
+        allocations = [item for item in or_(og(ticket, "allocations"), []) if _contains(visible_ids, og(item, "locationId"))]
+        projected_ticket = {**spread(ticket), "allocations": allocations}
+        if allocations:
+            tickets.append(projected_ticket)
+
+    def by_location(collection: Any) -> dict:
+        result: dict = {}
+        for key, value in entries(or_(collection, {})):
+            if key.split("|")[0] in visible_ids:
+                result[key] = value
+        return result
+
+    admin = og(account, "role") in ("admin", "superadmin")
+    return {
+        "schemaVersion": state.get("schemaVersion", UNDEF),
+        "revision": state.get("revision", UNDEF),
+        "locations": [location for location in or_(state.get("locations"), []) if _contains(visible_ids, og(location, "id"))],
+        "articles": or_(state.get("articles"), []),
+        "budgets": by_location(state.get("budgets")),
+        "monthlyBudgets": by_location(state.get("monthlyBudgets")),
+        "responsibleGroups": by_location(state.get("responsibleGroups")),
+        "projectAttributes": by_location(state.get("projectAttributes")),
+        "expenses": [expense for expense in or_(state.get("expenses"), []) if _contains(visible_ids, og(expense, "locationId"))],
+        "forecastTickets": tickets,
+        "comments": [comment for comment in or_(state.get("comments"), []) if _contains(visible_expense_ids, og(comment, "expenseId"))],
+        "imports": or_(state.get("imports"), []) if admin else [],
+        "closedPeriods": visible_closed_periods(state.get("closedPeriods"), visible_ids),
+        "periodCloseHistory": or_(state.get("periodCloseHistory"), []),
+        "expenseImports": or_(state.get("expenseImports"), []) if admin else [],
+    }
+
+
+# --- domain.js
+
+
+def project_state(state: dict, user: dict, access: Any, hidden_warnings: dict | None = None, *, copy: bool = True) -> dict:
+    hidden_warnings = hidden_warnings or {}
+    tirole = og(user, "accessSource") == "tirole"
+    account = {
+        **spread(user),
+        "archived": og(user, "active") is False,
+        "role": og(user, "role") if tirole else ("admin" if is_admin(user) else "user"),
+        "defaultLocationAccess": "view" if og(user, "defaultLocationAccess") == "view" else "hidden",
+        "locationAccess": or_(access, {}),
+    }
+    projected = visible_state(state, account)
+    visible_ids = uniq(og(item, "id") for item in projected["locations"])
+    article_ids = relevant_article_ids(projected)
+    projected["articles"] = [
+        item for item in or_(projected["articles"], [])
+        if _contains(article_ids, og(item, "id")) or is_admin(user) or tirole
+    ] if visible_ids else []
+    projected["currencyCatalog"] = or_(state.get("currencyCatalog"), []) if visible_ids else []
+    projected["exchangeRatesByQuarter"] = or_(state.get("exchangeRatesByQuarter"), {}) if visible_ids else {}
+    projected["legacyExchangeRates"] = {}
+    projected["trackerSync"] = {**spread(or_(state.get("trackerSync"), {})), "warnings": []}
+    warnings = []
+    for warning in or_(og(state.get("trackerSync"), "warnings"), []):
+        location_id = warning_location(state, warning)
+        if not truthy(location_id):
+            if is_admin(user):
+                warnings.append(warning)
+            continue
+        if not is_admin(user) and not can_edit(user, access, location_id):
+            continue
+        hidden = map_get(hidden_warnings, og(warning, "id"), None)
+        if hidden is None or hidden != S(or_(og(warning, "fingerprint"), "")):
+            warnings.append(warning)
+    projected["trackerSync"]["warnings"] = warnings
+    permissions: dict = {"role": or_(og(user, "role"), "user")}
+    if tirole:
+        permissions.update({"accessSource": "tirole", "accessScope": "all-locations"})
+    permissions["locations"] = {pk(identifier): location_access(user, access, identifier) for identifier in visible_ids}
+    permissions["canManageUsers"] = og(user, "role") == "superadmin"
+    permissions["canManageBudget"] = is_admin(user)
+    projected["permissions"] = permissions
+    # JSON.parse(JSON.stringify(projected)). Сервер отдаёт проекцию сразу в ответ и не меняет её,
+    # поэтому может обойтись без копии (copy=False): undefined и NaN всё равно уберёт запись в JSON.
+    return clone(projected) if copy else projected
+
+
+def mutation_location_ids(kind: str, payload: Any, state: dict) -> list:
+    result: list = []
+
+    def add(value: Any) -> None:
+        if truthy(value):
+            result.append(value)
+
+    if kind in ("addExpense", "addForecast", "saveBudget", "copyBudget"):
+        add(og(payload, "locationId"))
+    if kind in ("updateExpense", "cancelExpense", "restoreExpense"):
+        found = next((item for item in or_(state.get("expenses"), []) if strict_eq(og(item, "id"), og(payload, "id"))), None)
+        add(og(found, "locationId"))
+        add(og(payload, "locationId"))
+    if kind == "addComment":
+        found = next((item for item in or_(state.get("expenses"), []) if strict_eq(og(item, "id"), og(payload, "expenseId"))), None)
+        add(og(found, "locationId"))
+    if kind in ("updateForecastAllocation", "convertForecastAllocation"):
+        ticket = next((item for item in or_(state.get("forecastTickets"), []) if strict_eq(og(item, "id"), og(payload, "ticketId"))), None)
+        allocation = next(
+            (item for item in or_(og(ticket, "allocations"), []) if strict_eq(og(item, "id"), og(payload, "allocationId"))), None
+        ) if ticket is not None else None
+        add(og(allocation, "locationId"))
+        add(og(payload, "locationId"))
+    if kind in ("releaseForecastTicket", "restoreForecastTicket"):
+        ticket = next((item for item in or_(state.get("forecastTickets"), []) if strict_eq(og(item, "id"), og(payload, "ticketId"))), None)
+        for location in ticket_locations(ticket):
+            add(location)
+    if kind == "saveTrackerManualMapping":
+        add(og(payload, "locationId"))
+    if kind == "deleteTrackerManualMapping":
+        key = S(or_(og(payload, "issueKey"), "")).upper()
+        add(og(og(og(state.get("trackerSync"), "manualMappings"), key), "locationId"))
+    return [value for value in uniq(result) if truthy(value)]
+
+
+def changed_location_ids(before: dict, after: dict) -> list:
+    ids: list = []
+    before_expenses = {og(item, "id"): dumps(item) for item in or_(before.get("expenses"), []) if _hashable(og(item, "id"))}
+    for item in or_(after.get("expenses"), []):
+        if map_get(before_expenses, og(item, "id"), None) != dumps(item):
+            ids.append(og(item, "locationId"))
+    before_tickets = {og(item, "id"): dumps(item) for item in or_(before.get("forecastTickets"), []) if _hashable(og(item, "id"))}
+    for ticket in or_(after.get("forecastTickets"), []):
+        if map_get(before_tickets, og(ticket, "id"), None) != dumps(ticket):
+            ids.extend(ticket_locations(ticket))
+    if not uniq(ids) and dumps(before) != dumps(after):
+        for item in or_(after.get("expenses"), []):
+            ids.append(og(item, "locationId"))
+        for ticket in or_(after.get("forecastTickets"), []):
+            ids.extend(ticket_locations(ticket))
+    return [value for value in uniq(ids) if truthy(value)]
+
+
+def _hashable(value: Any) -> bool:
+    try:
+        hash(value)
+        return True
+    except TypeError:
+        return False
+
+
+def authorize_mutation(kind: str, payload: Any, state: dict, user: Any, access: Any) -> None:
+    if not truthy(user):
+        raise AppError("Требуется вход", 401, "authentication_required")
+    if kind == "importState":
+        raise AppError("Полное восстановление общей базы через интерфейс запрещено", 403, "forbidden")
+    if kind in SYSTEM_MUTATIONS:
+        raise AppError("Операция доступна только системному Tracker-агенту", 403, "forbidden")
+    if og(user, "accessSource") == "tirole" and kind in ("saveTrackerManualMapping", "deleteTrackerManualMapping", "dismissTrackerWarning"):
+        raise AppError("Tracker не включён в корпоративном режиме MVP", 403, "forbidden")
+    if kind in ADMIN_MUTATIONS:
+        if not is_admin(user):
+            raise AppError("Операция доступна только администратору", 403, "forbidden")
+        return
+    locations = mutation_location_ids(kind, payload, state)
+    if kind in EDIT_MUTATIONS:
+        if not locations or any(not can_edit(user, access, location) for location in locations):
+            raise AppError("Нет права редактирования выбранной локации", 403, "forbidden")
+        assert_record_author(kind, payload, state, user)
+        return
+    if kind in VIEW_WRITE_MUTATIONS:
+        if kind == "importExpenses":
+            if not is_admin(user) and og(user, "accessSource") != "tirole":
+                raise AppError("Операция доступна только администратору", 403, "forbidden")
+            return
+        if not locations or any(not can_view(user, access, location) for location in locations):
+            raise AppError("Нет доступа к выбранной локации", 403, "forbidden")
+        return
+    if kind == "dismissTrackerWarning":
+        return
+    raise AppError("Неизвестная или недоступная операция", 403, "forbidden")
+
+
+def assert_record_author(kind: str, payload: Any, state: dict, user: Any) -> None:
+    if is_admin(user):
+        return
+    record = None
+    if kind in ("updateExpense", "cancelExpense", "restoreExpense"):
+        record = next((item for item in state.get("expenses", []) if strict_eq(og(item, "id"), og(payload, "id"))), None)
+    elif kind in ("updateForecastAllocation", "releaseForecastTicket", "restoreForecastTicket", "convertForecastAllocation"):
+        record = next((item for item in state.get("forecastTickets", []) if strict_eq(og(item, "id"), og(payload, "ticketId"))), None)
+    else:
+        return
+    if record is None or not truthy(og(record, "createdById")) or not strict_eq(og(record, "createdById"), og(user, "id")):
+        raise AppError("Чужую запись может изменять только администратор", 403, "forbidden")
+
+
+def authorize_lock(resource_type: str, resource_id: str, state: dict, user: Any, access: Any) -> None:
+    if not truthy(user):
+        raise AppError("Требуется вход", 401, "authentication_required")
+    if is_admin(user):
+        return
+    if resource_type == "expense":
+        authorize_mutation("updateExpense", {"id": resource_id}, state, user, access)
+        return
+    if resource_type == "forecast":
+        ticket = next((item for item in state.get("forecastTickets", []) if strict_eq(og(item, "id"), resource_id)), None)
+        if ticket and truthy(og(ticket, "createdById")) and strict_eq(og(ticket, "createdById"), og(user, "id")) and any(
+            can_edit(user, access, location) for location in ticket_locations(ticket)
+        ):
+            return
+    raise AppError("Нет права редактирования выбранного ресурса", 403, "forbidden")
+
+
+def assert_import_locations(before: dict, after: dict, user: Any, access: Any) -> None:
+    locations = changed_location_ids(before, after)
+    if not locations or any(not can_edit(user, access, location) for location in locations):
+        raise AppError("Импорт затрагивает локацию без права редактирования", 403, "forbidden")
+
+
+def stamp_actor(before: dict, after: dict, user: dict) -> dict:
+    for collection in ("expenses", "forecastTickets"):
+        previous = {og(item, "id"): dumps(item) for item in or_(before.get(collection), []) if _hashable(og(item, "id"))}
+        for item in or_(after.get(collection), []):
+            old = map_get(previous, og(item, "id"), None)
+            if old is None:
+                item["createdBy"] = user["name"]
+                item["createdById"] = user["id"]
+            elif old != dumps(item):
+                item["updatedBy"] = user["name"]
+                item["updatedById"] = user["id"]
+    previous_comments = {og(item, "id") for item in or_(before.get("comments"), []) if _hashable(og(item, "id"))}
+    for item in or_(after.get("comments"), []):
+        if not _contains(previous_comments, og(item, "id")):
+            item["createdBy"] = user["name"]
+            item["createdById"] = user["id"]
+    return after
+
+
+def lock_resource(kind: str, payload: Any) -> dict | None:
+    if kind in ("updateExpense", "cancelExpense", "restoreExpense") and truthy(og(payload, "id")):
+        return {"resourceType": "expense", "resourceId": og(payload, "id")}
+    if kind in ("updateForecastAllocation", "releaseForecastTicket", "restoreForecastTicket", "convertForecastAllocation") and truthy(
+        og(payload, "ticketId")
+    ):
+        return {"resourceType": "forecast", "resourceId": og(payload, "ticketId")}
+    if kind == "saveBudget" and truthy(og(payload, "locationId")) and truthy(og(payload, "quarterKey")):
+        return {"resourceType": "budget", "resourceId": f"{S(og(payload, 'locationId'))}|{S(og(payload, 'quarterKey'))}"}
+    return None
+
+
+def audit_entity(kind: str, payload: Any) -> dict:
+    if "Expense" in kind:
+        return {"entityType": "expense", "entityId": or_(or_(og(payload, "id"), og(payload, "expenseId")), None)}
+    if "Forecast" in kind:
+        return {"entityType": "forecast", "entityId": or_(og(payload, "ticketId"), None)}
+    if kind == "addComment":
+        return {"entityType": "comment", "entityId": or_(og(payload, "id"), None)}
+    if kind in ("saveBudget", "copyBudget", "importBudget"):
+        location_id = og(payload, "locationId")
+        quarter = og(payload, "quarterKey")
+        return {"entityType": "budget", "entityId": f"{S(location_id)}|{S(quarter)}" if truthy(location_id) and truthy(quarter) else None}
+    if "Location" in kind:
+        return {"entityType": "location", "entityId": or_(og(payload, "id"), None)}
+    if "Article" in kind:
+        return {"entityType": "project", "entityId": or_(or_(og(payload, "articleId"), og(payload, "id")), None)}
+    return {"entityType": None, "entityId": None}
