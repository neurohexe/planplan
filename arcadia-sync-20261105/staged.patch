+class DateTests(SimpleTestCase):
+    def setUp(self):
+        self.previous = os.environ.get("TZ")
+        os.environ["TZ"] = "Europe/Moscow"
+        time.tzset()
+
+    def tearDown(self):
+        if self.previous is None:
+            os.environ.pop("TZ", None)
+        else:
+            os.environ["TZ"] = self.previous
+        time.tzset()
+
+    def test_parse_matches_v8(self):
+        cases = {
+            "2026-11-03T10:15:30.123Z": 1793700930123, "2026-11-03": 1793664000000, "2026-02-30": 1772409600000,
+            "2026-11-03 10:15:30": 1793690130000, "2026/11/03": 1793653200000, "Nov 3, 2026": 1793653200000, "1": 978296400000,
+            "hello 5": 988660800000, "3.11.2026": 1773176400000,
+        }
+        for text, expected in cases.items():
+            self.assertEqual(dates.parse(text), expected, text)
+        for text in ("13", "abc", "", "5 hello", "2026-13-01", "-000000-01-01T00:00:00Z", "2026-11-03T24:00:01Z", "1e3"):
+            self.assertTrue(math.isnan(dates.parse(text)), text)
+
+    def test_iso_and_local_dates(self):
+        self.assertEqual(dates.iso(0), "1970-01-01T00:00:00.000Z")
+        self.assertEqual(dates.iso(-62198755200000), "-000001-01-01T00:00:00.000Z")
+        self.assertEqual(dates.to_date_input_value(dates.parse("202")), "0201-12-31", "getTimezoneOffset в V8 — целые минуты")
+        self.assertTrue(dates.valid_date_input("2026-02-28"))
+        self.assertFalse(dates.valid_date_input("2026-02-29"))
+        self.assertFalse(dates.valid_date_input("0050-01-01"))
+        self.assertEqual(quarter_key_from_date_input("2026-11-03"), "2026-Q4")
+        self.assertEqual(quarter_key_from_date_input("2026"), "2026-QNaN")
+
