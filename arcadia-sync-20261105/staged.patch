+    def test_five_wrong_codes_lock_the_login_for_fifteen_minutes_and_count_restarts(self):
+        code = self.service.issue_access_code("alice")["code"]
+        start = now_dt()
+        moments = iter([start + timedelta(seconds=index) for index in range(6)])
+        with mock.patch("planfact.service.now_dt", side_effect=lambda: next(moments)):
+            for _ in range(5):
+                with self.assertRaises(AuthenticationError):
+                    self.login("alice", "ZZZZZ-ZZZZZ-ZZZZZ-ZZZZZ")
+            with self.assertRaises(AuthenticationError):
+                self.login("alice", code)
+        record = AccessCode.objects.get(user_id=self.alice["id"])
+        self.assertEqual(record.failed_attempts, 5)
+        self.assertEqual(record.locked_until, start + timedelta(seconds=4, minutes=15))
+        self.assertEqual([event["payload"]["reason"] for event in self.audit("auth.access_code_failed")][0], "locked")
+        with mock.patch("planfact.service.now_dt", return_value=start + timedelta(minutes=16)):
+            with self.assertRaises(AuthenticationError):
+                self.login("alice", "ZZZZZ-ZZZZZ-ZZZZZ-ZZZZZ")
+        record.refresh_from_db()
+        self.assertEqual((record.failed_attempts, record.locked_until), (1, None), "после блокировки счёт начинается заново")
+        with mock.patch("planfact.service.now_dt", return_value=start + timedelta(minutes=17)):
+            self.login("alice", code)
+        record.refresh_from_db()
+        self.assertEqual(record.failed_attempts, 0, "успешный вход обнуляет счётчик")
