+  assert.deepEqual(parseArgs(["--tvm-id", "1001", "--system", "fixture-app"]), { tvmId: "1001", systemSlug: "fixture-app" });
+  assert.deepEqual(parseArgs([], { PLAN_FACT_TVM_ID: "1002" }), { tvmId: "1002" });
+  assert.deepEqual(parseArgs(["--tvm-id", "1001"], { PLAN_FACT_TVM_ID: "1002" }), { tvmId: "1001" });
+  for (const args of [["--unknown", "x"], ["--port"], ["--port", "18768", "--port", "18769"], ["--port", "--system"]]) {
