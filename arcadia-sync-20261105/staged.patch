+        return {"failedAttempts": failed, "lockedUntil": iso(locked_until), "locked": locked_until is not None}
+
+    def reset_access_code_failures(self, user_id: str, *, now: str, code_hash: str) -> bool:
+        """Успешный вход обнуляет счётчик. False — пока проверялся код, логин успели заблокировать
+        или код заменили: такой вход надо отклонить."""
+        moment = from_iso(now)
+        updated = AccessCode.objects.filter(user_id=user_id, code_hash=code_hash).filter(
+            Q(locked_until__isnull=True) | Q(locked_until__lte=moment)
+        ).update(failed_attempts=0, locked_until=None)
+        return updated == 1
+
+    # --- журнал
+
+    def append_audit(self, event: dict) -> str:
+        event_id = event.get("id") or str(uuid.uuid4())
+        AuditEvent.objects.create(
+            id=event_id,
+            revision=event.get("revision"),
+            actor_id=event.get("actorId") or None,
