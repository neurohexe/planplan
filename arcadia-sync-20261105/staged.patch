+class EventStreamTests(StandTestCase):
+    def open_events(self, cookie: str):
+        import http.client
+
+        connection = http.client.HTTPConnection(self.api.host, self.api.port, timeout=10)
+        connection.request("GET", "/api/events", headers={"Cookie": cookie, "Host": f"{self.api.host}:{self.api.port}"})
+        response = connection.getresponse()
+        self.assertEqual(response.status, 200)
+        self.assertEqual(response.getheader("Content-Type"), "text/event-stream; charset=utf-8")
+        stream = {"text": "", "ended": False, "connection": connection}
+
+        def read():
+            try:
+                while True:
+                    chunk = response.read1(4096)
+                    if not chunk:
+                        break
+                    stream["text"] += chunk.decode("utf-8")
+                stream["ended"] = True
+            except Exception:  # noqa: BLE001 — поток закрыл сам тест
+                pass
+
+        threading.Thread(target=read, daemon=True).start()
+        return stream
+
+    def wait_until(self, condition, message: str, timeout: float = 10) -> None:
+        deadline = time.monotonic() + timeout
+        while not condition():
+            if time.monotonic() > deadline:
+                self.fail(message)
+            time.sleep(0.02)
+
+    def test_event_stream_ends_when_its_session_is_closed_elsewhere(self):
+        erin = self.service.provision_staff_account(staff_login="erin", name="erin", role="user")["account"]
