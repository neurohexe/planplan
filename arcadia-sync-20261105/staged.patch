+
+# --- запуск и остановка: каждый стенд — только своих агентов ------------------------------------------------
+/bin/bash "$STAND_R/bin/start.sh" > /dev/null
+/bin/bash "$STAND_S/bin/start.sh" > /dev/null
+check 'оба стенда запущены: загружены обычные агенты каждого, ручные агенты туннеля — нет' /bin/bash -c '
