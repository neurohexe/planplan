@@ -0,0 +1,133 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+const app = require("../app.js");
+
+const payload = {
+  quarterKey: "2026-Q3",
+  sourceFile: "budget.xlsx",
+  sourceRows: 976
+};
+
+function state(revision, imports = []) {
+  return { revision, imports };
+}
+
+function importRecord(id, overrides = {}) {
+  return {
+    id,
+    quarterKey: payload.quarterKey,
+    sourceFile: payload.sourceFile,
+    rows: payload.sourceRows,
+    ...overrides
+  };
+}
+
+test("подтверждает импорт, если после ошибки ответа на сервере появилась новая запись", () => {
+  const before = state(12, [importRecord("old")]);
+  const after = state(13, [importRecord("old"), importRecord("new")]);
+
+  assert.equal(app.serverMutationWasApplied("importBudget", payload, before, after), true);
+});
+
+test("не путает старую запись того же файла с новым импортом", () => {
+  const existing = importRecord("old");
+  const before = state(12, [existing]);
+  const after = state(13, [existing]);
+
+  assert.equal(app.serverMutationWasApplied("importBudget", payload, before, after), false);
+});
+
+test("не подтверждает импорт по чужому файлу или без роста ревизии", () => {
+  const before = state(12);
+  const wrongFile = state(13, [importRecord("new", { sourceFile: "other.xlsx" })]);
+  const sameRevision = state(12, [importRecord("new")]);
+
+  assert.equal(app.serverMutationWasApplied("importBudget", payload, before, wrongFile), false);
+  assert.equal(app.serverMutationWasApplied("importBudget", payload, before, sameRevision), false);
+});
+
+test("не признаёт другие типы мутаций по одному росту ревизии", () => {
+  assert.equal(app.serverMutationWasApplied("saveBudget", payload, state(12), state(13)), false);
+});
+
+test("подтверждает добавление расхода только по стабильному id и полям payload", () => {
+  const expensePayload = {
+    id: "expense-1",
+    locationId: "office",
+    articleId: "project",
+    subarticleId: "article",
+    currency: "RUB",
+    amount: 1250,
+    expenseDate: "2026-09-25",
+    ticketUrl: "https://st.yandex-team.ru/TEST-1",
+    comment: "Оплата"
+  };
+  const applied = { ...expensePayload, quarterKey: "2026-Q3", status: "active" };
+  const before = { revision: 20, expenses: [] };
+  const after = { revision: 21, expenses: [applied] };
+
+  assert.equal(app.serverMutationWasApplied("addExpense", expensePayload, before, after), true);
+  assert.equal(app.serverMutationWasApplied(
+    "addExpense",
+    expensePayload,
+    before,
+    { revision: 21, expenses: [{ ...applied, amount: 1300 }] }
+  ), false);
+});
+
+test("подтверждает обновление расхода только когда запись действительно изменилась", () => {
+  const expensePayload = {
+    id: "expense-1",
+    locationId: "office",
+    articleId: "project",
+    subarticleId: "",
+    currency: "RUB",
+    amount: 1400,
+    expenseDate: "2026-09-25",
+    ticketUrl: "",
+    comment: "Новая сумма"
+  };
+  const beforeExpense = { ...expensePayload, amount: 1200, comment: "Старая сумма" };
+  const afterExpense = { ...expensePayload, updatedAt: "2026-09-25T10:00:00.000Z" };
+
+  assert.equal(app.serverMutationWasApplied(
+    "updateExpense",
+    expensePayload,
+    { revision: 30, expenses: [beforeExpense] },
+    { revision: 31, expenses: [afterExpense] }
+  ), true);
+  assert.equal(app.serverMutationWasApplied(
+    "updateExpense",
+    expensePayload,
+    { revision: 30, expenses: [afterExpense] },
+    { revision: 31, expenses: [afterExpense] }
+  ), false);
+});
+
+test("персональный токен Tracker доступен только в локальном режиме", () => {
+  assert.equal(app.trackerPersonalTokenAllowed(false), true);
+  assert.equal(app.trackerPersonalTokenAllowed(true), false);
+});
+
+test("после HTTP-ошибки перечитывает состояние и возвращает только подтверждённый импорт", async (t) => {
+  const before = app.createInitialState();
+  before.revision = 12;
+  const after = app.createInitialState();
+  after.revision = 13;
+  after.imports = [importRecord("new", { importedAt: "2026-09-23T07:20:00.000Z" })];
+
+  const originalFetch = global.fetch;
+  t.after(() => { global.fetch = originalFetch; });
+  global.fetch = async () => ({
+    ok: true,
+    json: async () => ({ state: after, user: { id: "admin" } })
+  });
+
+  const recovered = await app.recoverCommittedServerMutation("importBudget", payload, before);
+
+  assert.equal(recovered.state.revision, 13);
+  assert.equal(recovered.state.imports[0].id, "new");
+  assert.equal(recovered.user.id, "admin");
+});
