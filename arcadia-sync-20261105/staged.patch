+#!/bin/bash
+# Возврат стенда с версии на Django на прежний сервер (Node и SQLite) — задача 41.
+# Прежний сервер продолжит с базой SQLite на момент переключения: изменения, сделанные на Django, в неё
+# не попадут (они остаются в PostgreSQL и в копиях backups/postgres). Поэтому нужен ключ --yes.
+# Служба PostgreSQL продолжает работать. Повторное переключение по умолчанию не удаляет новые данные.
+# shellcheck source=common-django.sh
+. "$(dirname -- "${BASH_SOURCE[0]}")/common-django.sh"
+[ "$#" -eq 1 ] && [ "$1" = --yes ] || fail 'Использование: rollback-to-node.sh --yes (изменения, сделанные на Django, в прежнюю базу не попадут).'
+[ -e "$ACTIVE_MARK" ] || fail 'Стенд сейчас работает не на Django.'
+[ -f "$NODE_UNITS_SAVED/$APP_UNIT" ] && [ -f "$NODE_UNITS_SAVED/$BACKUP_UNIT" ] || fail 'Нет сохранённых служб прежнего сервера.'
+load_django_config
+pg_client_env
+maintenance_lock
+directory="$STAND/backups/rollback-$(date +%Y%m%d-%H%M%S)"
+private_dir "$directory"
+cp -- "$UNIT_DIR/$APP_UNIT" "$directory/app.service"
+cp -- "$UNIT_DIR/$BACKUP_UNIT" "$directory/backup.service"
+cp -- "$ACTIVE_MARK" "$directory/active-mark"
+timer="${BACKUP_UNIT%.service}.timer"
+timer_active=false
+user_systemctl is-active --quiet "$timer" && timer_active=true
+finish_rollback() {
+  local status=$?
+  trap - EXIT
+  if [ "$status" -ne 0 ]; then
+    cp -- "$directory/app.service" "$UNIT_DIR/$APP_UNIT"
+    cp -- "$directory/backup.service" "$UNIT_DIR/$BACKUP_UNIT"
+    cp -- "$directory/active-mark" "$ACTIVE_MARK"
+    user_systemctl daemon-reload
+    user_systemctl start "$APP_UNIT"
+  fi
+  [ "$timer_active" = false ] || user_systemctl start "$timer"
+  exit "$status"
+}
+trap finish_rollback EXIT
+user_systemctl stop "$timer"
+user_systemctl stop "$BACKUP_UNIT"
+
+say "Останавливаю сервер на Django ($(date '+%H:%M:%S'))."
+user_systemctl stop "$APP_UNIT"
+pg_safety_dump "$directory/final-postgres.dump"
+state_summary > "$directory/postgres.summary"
+say 'Данные PostgreSQL перед возвратом:'
+cat "$directory/postgres.summary"
+python3 - "$SQLITE_DATABASE" <<'PY'
+import sqlite3, sys
+with sqlite3.connect(f'file:{sys.argv[1]}?mode=ro', uri=True) as db:
+    print('Ревизия старой SQLite:', db.execute('SELECT revision FROM application_state').fetchone()[0])
+PY
+cp -- "$NODE_UNITS_SAVED/$APP_UNIT" "$UNIT_DIR/$APP_UNIT"
+cp -- "$NODE_UNITS_SAVED/$BACKUP_UNIT" "$UNIT_DIR/$BACKUP_UNIT"
+rm -f -- "$ACTIVE_MARK"
+user_systemctl daemon-reload
+user_systemctl start "$APP_UNIT"
+wait_ready "$PLAN_FACT_PORT" 60 || fail 'Прежний сервер не ответил готовностью: смотрите logs/app.stderr.log.'
+say "Стенд снова работает на прежнем сервере ($(date '+%H:%M:%S')). PostgreSQL и его копии сохранены."
+say 'Возврат на Django: обычное переключение откажет при более новых данных PostgreSQL; --keep-postgres сохранит их, --replace-postgres явно заменит SQLite после копии.'
