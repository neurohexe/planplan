+"""HTTP API и раздача интерфейса (перенос backend/src/http-server.js для режима access-code).
+
+Порядок проверок прежний: сначала имя сайта (Host), затем Origin и тип тела для POST, затем
+маршруты. Ответы JSON несут те же заголовки безопасности, cookie сессии — те же атрибуты.
+"""
+
+from __future__ import annotations
+
+import ipaddress
+import logging
+import os
+import re
+from string import hexdigits
+from typing import Any
+from urllib.parse import parse_qs, quote
+
+from ada_url import URL
+from django.http import HttpResponse, StreamingHttpResponse
+
+from planfact import access_codes
+from planfact.config import ACCESS_CODE_AUTH_MODE, Config
+from planfact.domain import js
+from planfact.errors import AppError
+from planfact.runtime import get_service
+
+logger = logging.getLogger("planfact")
+
+SESSION_COOKIE = "plan_fact_session"
+# Стенд открыт через туннель на общем домене: соседняя страница может поставить cookie на весь домен.
+# Cookie с префиксом __Host- браузер принимает только от самого адреса (Secure, Path=/, без Domain).
+HOST_SESSION_COOKIE = f"__Host-{SESSION_COOKIE}"
+LOOPBACK_HOSTNAMES = frozenset({"127.0.0.1", "localhost", "[::1]"})
+LOGIN_MAX_REQUEST_BYTES = 4 * 1024
+LOGIN_FIELD_MAX_LENGTH = 64
+STATIC_CONTENT_TYPES = {
+    ".css": "text/css; charset=utf-8",
+    ".html": "text/html; charset=utf-8",
+    ".js": "text/javascript; charset=utf-8",
+    ".json": "application/json; charset=utf-8",
+    ".png": "image/png",
+    ".svg": "image/svg+xml",
+}
+SECURITY_HEADERS = {
+    "Content-Security-Policy": (
+        "default-src 'self'; base-uri 'none'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; "
+        "img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
+    ),
+    "Cross-Origin-Opener-Policy": "same-origin",
+    "Permissions-Policy": "camera=(), geolocation=(), microphone=()",
+    "Referrer-Policy": "same-origin",
+    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
+    "X-Content-Type-Options": "nosniff",
+    "X-Frame-Options": "DENY",
+    "X-Permitted-Cross-Domain-Policies": "none",
+}
+RUNTIME_CONFIG = b'globalThis.PLAN_FACT_RUNTIME = Object.freeze({ mode: "server" });\n'
+_HOST_RE = re.compile(r"(\[[0-9a-f:.]+\]|[a-z0-9.-]+)(?::[0-9]{1,5})?\Z")
+_URI_UNRESERVED = "-_.!~*'()"
+
+
+# ---------------------------------------------------------------------------
+# Ответы
+
+
+def _response(status: int, body: bytes, headers: dict) -> HttpResponse:
+    response = HttpResponse(body, status=status)
+    del response["Content-Type"]
+    for name, value in headers.items():
+        response[name] = value
+    return response
+
+
+def send_json(status: int, body: Any, pending: dict, extra: dict | None = None) -> HttpResponse:
+    raw = js.dumps(body).encode("utf-8")
+    return _response(status, raw, {
+        **pending,
+        **SECURITY_HEADERS,
+        "Content-Type": "application/json; charset=utf-8",
+        "Content-Length": str(len(raw)),
+        "Cache-Control": "no-store",
+        "X-Plan-Fact-API-Version": "1",
+        **(extra or {}),
+    })
+
+
+def send_buffer(status: int, body: bytes, content_type: str, pending: dict) -> HttpResponse:
+    return _response(status, body, {
+        **pending,
+        **SECURITY_HEADERS,
+        "Content-Type": content_type,
+        "Content-Length": str(len(body)),
+        "Cache-Control": "no-store" if content_type.startswith("text/html") else "public, max-age=300",
+    })
+
+
+# ---------------------------------------------------------------------------
+# Cookie, имя сайта, Origin, IP
+
+
+def decode_uri_component(text: str) -> str:
+    """decodeURIComponent: неверная последовательность — ошибка (ValueError)."""
+    chars: list[str] = []
+    buffer = bytearray()
+    index = 0
+    while index < len(text):
+        ch = text[index]
+        if ch == "%":
+            pair = text[index + 1:index + 3]
+            if len(pair) != 2 or any(c not in hexdigits for c in pair):
+                raise ValueError("URI malformed")
+            buffer.append(int(pair, 16))
+            index += 3
+            continue
+        if buffer:
+            chars.append(buffer.decode("utf-8"))
+            buffer.clear()
+        chars.append(ch)
+        index += 1
+    if buffer:
+        chars.append(buffer.decode("utf-8"))
+    return "".join(chars)
+
+
+def _decode_or_raw(value: str) -> str:
+    try:
+        return decode_uri_component(value)
+    except (ValueError, UnicodeDecodeError):
+        return value
+
+
+def cookie_values(header: str | None, name: str) -> list[str]:
+    """Все значения cookie с этим именем по порядку: повтор имени виден (в отличие от разбора Django)."""
+    values = []
+    for part in str(header or "").split(";"):
+        index = part.find("=")
+        if index < 0 or js.js_trim(part[:index]) != name:
+            continue
+        values.append(_decode_or_raw(js.js_trim(part[index + 1:])))
+    return values
+
+
+def session_cookie_name(config: Config) -> str:
+    return HOST_SESSION_COOKIE if config.auth_mode == ACCESS_CODE_AUTH_MODE and config.secure_cookies else SESSION_COOKIE
+
+
+def session_cookie(token: str, config: Config) -> str:
+    parts = [f"{session_cookie_name(config)}={quote(token, safe=_URI_UNRESERVED)}", "Path=/", "HttpOnly", "SameSite=Strict"]
+    if config.secure_cookies:
+        parts.append("Secure")
+    return "; ".join(parts)
+
+
+def clear_session_cookie(config: Config) -> str:
+    return f"{session_cookie('', config)}; Max-Age=0"
+
+
+def request_hostname(request) -> str | None:
+    """Имя из заголовка Host без порта, в нижнем регистре; None — если Host не похож на имя или адрес."""
+    match = _HOST_RE.match(js.js_trim(str(request.META.get("HTTP_HOST") or "")).lower())
+    return match.group(1) if match else None
+
+
+def allowed_hostnames(config: Config) -> frozenset:
+    names = set(LOOPBACK_HOSTNAMES)
+    for origin in config.allowed_origins:
+        try:
+            names.add(URL(origin).hostname)
+        except ValueError:
+            pass  # Не адрес — такой Origin и так ни с чем не совпадёт.
+    return frozenset(names)
+
+
+def normalize_ip(value: Any) -> str:
+    ip = js.js_trim(js.S(value if js.truthy(value) else ""))
+    if ip.startswith("[") and ip.endswith("]"):
+        ip = ip[1:-1]
+    if ip[:7].lower() == "::ffff:" and _is_ipv4(ip[7:]):
+        ip = ip[7:]
+    return ip if _is_ip(ip) else ""
+
+
+def _is_ipv4(value: str) -> bool:
+    try:
+        ipaddress.IPv4Address(value)
+        return True
+    except ValueError:
+        return False
+
+
+def _is_ip(value: str) -> bool:
+    try:
+        ipaddress.ip_address(value)
+        return True
+    except ValueError:
+        return False
+
+
+def _remote(request) -> str:
+    return str(request.META.get("REMOTE_ADDR") or "")
+
+
+def from_trusted_proxy(request, config: Config) -> bool:
+    if not config.trusted_proxy_ips:
+        return False
+    remote = _remote(request)
+    normalized = remote[7:] if remote.startswith("::ffff:") else remote
+    return normalized in config.trusted_proxy_ips
+
+
+def client_ip(request, config: Config) -> str:
+    """IP для журнала входа. X-Forwarded-For-Y на стенде может прислать кто угодно: заголовку верим
+    только от доверенного прокси (PLAN_FACT_TRUSTED_PROXY_IPS), иначе — адрес соединения."""
+    if from_trusted_proxy(request, config):
+        forwarded = str(request.META.get("HTTP_X_FORWARDED_FOR_Y") or "").split(",")[0]
+        return normalize_ip(forwarded) or normalize_ip(_remote(request))
+    return normalize_ip(_remote(request))
+
+
+def origin_allowed(request, config: Config) -> bool:
+    origin = request.META.get("HTTP_ORIGIN")
+    # В режиме access-code POST без Origin не пропускается: стенд открыт коллегам через туннель.
+    if not origin:
+        return False
+    # X-Forwarded-Proto учитывается только от доверенного прокси, иначе same-origin легко подделать.
+    forwarded = (
+        str(request.META.get("HTTP_X_FORWARDED_PROTO") or "").split(",")[0].strip() if from_trusted_proxy(request, config) else ""
+    )
+    protocol = forwarded or request.META.get("wsgi.url_scheme", "http")
+    host = request.META.get("HTTP_HOST")
+    same_origin = f"{protocol}://{host}" if host else None
+    return origin == same_origin or origin in config.allowed_origins
+
+
+# ---------------------------------------------------------------------------
+# Тело запроса
+
+
+def read_body(request, max_bytes: int) -> bytes:
+    declared = js.to_number(request.META.get("CONTENT_LENGTH") or 0)
+    if declared > max_bytes:
+        raise AppError("Запрос слишком большой", 413, "payload_too_large")
+    data = request.read(max_bytes + 1)
+    if len(data) > max_bytes:
+        raise AppError("Запрос слишком большой", 413, "payload_too_large")
+    return data
+
+
+def request_json(request, max_bytes: int) -> Any:
+    raw = read_body(request, max_bytes)
+    if not raw:
+        return {}
+    try:
+        return js.loads(raw.decode("utf-8", errors="replace"))
+    except (ValueError, RecursionError):
+        raise AppError("Некорректный JSON", 400, "invalid_json") from None
+
+
+def request_object(request, max_bytes: int) -> dict:
+    """Тело, которое должно быть объектом JSON (null, число или массив — некорректный запрос)."""
+    body = request_json(request, max_bytes)
+    if not isinstance(body, dict):
+        raise AppError("Некорректный JSON", 400, "invalid_json")
+    return body
+
+
+def login_field(value: Any) -> str:
+    """Из тела входа читаются только логин и код: не строка или длиннее 64 символов — пустое значение."""
+    return value if isinstance(value, str) and js.js_len(value) <= LOGIN_FIELD_MAX_LENGTH else ""
+
+
+def session_token(request, config: Config) -> str | None:
+    """Токен из cookie. Две cookie сессии сразу — признак подброшенной: тогда сессии нет."""
+    values = cookie_values(request.META.get("HTTP_COOKIE"), session_cookie_name(config))
+    return values[0] if len(values) == 1 else None
+
+
+def _static_relative(request) -> str:
+    """Путь файла интерфейса внутри PLAN_FACT_STATIC_DIR, раскодированный как decodeURIComponent."""
+    raw_uri = request.META.get("RAW_URI")
+    if raw_uri:
+        path = raw_uri.split("?", 1)[0].split("#", 1)[0]
+        if not path.startswith("/"):
+            # Запрос в абсолютной форме: http://host/путь.
+            rest = path.split("://", 1)[-1]
+            path = "/" + rest.split("/", 1)[1] if "/" in rest else "/"
+        return "index.html" if path == "/" else decode_uri_component(path[1:])
+    # Без RAW_URI (тестовый сервер Django) путь уже раскодирован, а неверные последовательности UTF-8
+    # снова закодированы через %: раскодируем ещё раз строго, чтобы они дали 400, как раньше.
+    path = request.path_info
+    return "index.html" if path == "/" else decode_uri_component(path[1:])
+
+
+# ---------------------------------------------------------------------------
+# Обработчик
+
+
+def dispatch(request) -> HttpResponse:
+    service = get_service()
+    config = service.config
+    # DNS rebinding: имя чужого сайта указывает на 127.0.0.1, и его страница шлёт запросы со своим Host.
+    # Стенд отвечает только на свои имена: 127.0.0.1, localhost и адреса из PLAN_FACT_ALLOWED_ORIGINS.
+    if request_hostname(request) not in allowed_hostnames(config):
+        return send_json(403, {"error": "Адрес стенда не разрешён", "code": "host_forbidden"}, {})
+    pending: dict[str, str] = {}
+    origin = request.META.get("HTTP_ORIGIN")
+    if origin and origin_allowed(request, config):
+        pending.update({"Access-Control-Allow-Origin": origin, "Access-Control-Allow-Credentials": "true", "Vary": "Origin"})
+    try:
+        return _route(request, service, config, pending)
+    except AppError as error:
+        if error.status >= 500:
+            _log_failure(error.code, error.message)
+        return _error_response(error.status, error.message, error.code, error.details, pending)
+    except Exception as error:  # noqa: BLE001 — любая внутренняя ошибка даёт общий ответ 500
+        _log_failure(getattr(error, "code", None), str(error))
+        return _error_response(500, "", "internal_error", None, pending)
+
+
+def _log_failure(code: Any, message: str) -> None:
+    logger.error("Plan Fact request failed %s", js.dumps({"code": code if isinstance(code, str) and code else "internal_error",
+                                                          "message": message[:500]}))
+
+
+def _error_response(status: int, message: str, code: str, details: Any, pending: dict) -> HttpResponse:
+    extra = details if isinstance(details, dict) else {}
+    body = {"error": "Внутренняя ошибка сервера" if status >= 500 else message, "code": code or "internal_error", **extra}
+    return send_json(status, body, pending)
+
+
+def _route(request, service, config: Config, pending: dict) -> HttpResponse:
+    method = request.method
+    path = request.path_info
+    if path == "/idm" or path.startswith("/idm/"):
+        # Ручки системы IDM относятся к корпоративному режиму, который в версии на Django не перенесён.
+        return send_json(404, {"code": 404, "fatal": "Интеграция с IDM выключена"}, pending)
+    if method == "OPTIONS":
+        if not origin_allowed(request, config):
+            raise AppError("Origin запрещён", 403, "origin_forbidden")
+        return _response(204, b"", {
+            **pending,
+            "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
+            "Access-Control-Allow-Headers": "Content-Type, X-Plan-Fact-Mutation-Id",
+            "Access-Control-Max-Age": "600",
+        })
+    if method == "POST" and not origin_allowed(request, config):
+        raise AppError("Origin запрещён", 403, "origin_forbidden")
+    if method == "POST" and not str(request.META.get("CONTENT_TYPE") or "").lower().startswith("application/json"):
+        raise AppError("Требуется Content-Type: application/json", 415, "unsupported_media_type")
+
+    metadata = {
+        "apiVersion": 1,
+        "backendVersion": config.backend_version or "0.2.0-django",
+        "buildCommit": config.build_commit or "unknown",
+        "imageDigest": config.image_digest or "unknown",
+    }
+    if method == "GET" and path in ("/health", "/api/health"):
+        return send_json(200, {"status": "ok", **metadata}, pending)
+    if method == "GET" and path in ("/ready", "/api/ready"):
+        try:
+            readiness = service.readiness()
+            if readiness["status"] != "ready":
+                raise RuntimeError("Dependencies not ready")
+            return send_json(200, {**readiness, **metadata}, pending)
+        except Exception:  # noqa: BLE001 — база недоступна или не готова
+            return send_json(503, {"status": "not_ready", **metadata}, pending)
+
+    def current_session(touch: bool = True) -> dict | None:
+        return service.session_by_token(session_token(request, config), touch=touch)
+
+    def auth_body(session: dict) -> dict:
+        return {**service.auth_summary(session), "authMode": ACCESS_CODE_AUTH_MODE}
+
+    if method == "GET" and path == "/api/auth":
+        session = current_session()
+        if session is None:
+            # Без сессии — 401 и режим входа: интерфейс покажет форму кода. Никаких редиректов.
+            return send_json(401, {"code": "login_required", "authMode": ACCESS_CODE_AUTH_MODE}, pending)
+        return send_json(200, auth_body(session), pending)
+    if method == "POST" and path == "/api/login":
+        return _login(request, service, config, pending, auth_body)
+    if method == "POST" and path == "/api/logout":
+        # Закрывается только сессия, токен которой предъявлен (POST уже прошёл проверку Origin,
+        # cookie SameSite=Strict).
+        service.logout(current_session(touch=False))
+        return send_json(200, {"ok": True}, pending, {"Set-Cookie": clear_session_cookie(config)})
+    if method == "GET" and path == "/api/state":
+        return send_json(200, service.state_for(current_session()), pending)
+    if method == "POST" and path == "/api/mutate":
+        body = request_object(request, config.max_request_bytes)
+        if not js.truthy(body.get("mutationId")):
+            header = request.META.get("HTTP_X_PLAN_FACT_MUTATION_ID")
+            body["mutationId"] = header if header is not None else js.UNDEF
+        return send_json(200, service.mutate(current_session(), body), pending)
+    if method == "GET" and path == "/api/admin/users":
+        return send_json(200, {"users": service.list_managed_users(current_session())}, pending)
+    if method == "POST" and path in ("/api/locks/acquire", "/api/locks/heartbeat", "/api/locks/release"):
+        body = request_object(request, config.max_request_bytes)
+        handler = {
+            "/api/locks/acquire": service.acquire_lock,
+            "/api/locks/heartbeat": service.heartbeat_lock,
+            "/api/locks/release": service.release_lock,
+        }[path]
+        return send_json(200, handler(current_session(), body), pending)
+    if method == "POST" and path == "/api/tracker/sync":
+        body = request_object(request, config.max_request_bytes)
+        return send_json(202, service.request_tracker_sync(current_session(), body), pending)
+    if method == "GET" and path == "/api/audit":
+        query = parse_qs(request.META.get("QUERY_STRING", ""), keep_blank_values=True)
+
+        def first(name: str) -> str | None:
+            return query[name][0] if name in query else None
+
+        events = service.list_audit(current_session(), actor_id=first("actorId"), before=first("before"), limit=first("limit"))
+        return send_json(200, {"events": events}, pending)
+    if method == "GET" and path == "/api/events":
+        return _events(request, service, config, pending, current_session)
+    if method == "GET" and config.static_dir is not None and not path.startswith("/api/"):
+        if path == "/runtime-config.js":
+            return send_buffer(200, RUNTIME_CONFIG, STATIC_CONTENT_TYPES[".js"], pending)
+        try:
+            relative = _static_relative(request)
+        except (ValueError, UnicodeError):
+            raise AppError("Некорректный URL", 400, "invalid_url") from None
+        root = str(config.static_dir)
+        if "\x00" not in relative:
+            file_path = os.path.normpath(os.path.join(root, relative))
+            if file_path != root and file_path.startswith(root + os.sep) and os.path.isfile(file_path):
+                with open(file_path, "rb") as handle:
+                    body = handle.read()
+                content_type = STATIC_CONTENT_TYPES.get(os.path.splitext(file_path)[1].lower(), "application/octet-stream")
+                return send_buffer(200, body, content_type, pending)
+    return send_json(404, {"error": "Endpoint не найден", "code": "not_found"}, pending)
+
+
+def _login(request, service, config: Config, pending: dict, auth_body) -> HttpResponse:
+    """POST /api/login. Тело запроса нигде не пишется в журнал и логи; любая неудача — один и тот же 401."""
+    body = request_json(request, min(config.max_request_bytes, LOGIN_MAX_REQUEST_BYTES))
+    login = login_field(js.og(body, "login"))
+    code = login_field(js.og(body, "code"))
+    existing = service.session_by_token(session_token(request, config), touch=False)
+    if existing is not None and not _session_belongs_to(existing, login):
+        # В этом браузере входит другой пользователь: прежняя сессия ему не принадлежит. Закрываем её
+        # и чистим cookie даже если новый вход завершится отказом.
+        service.logout(existing, reason="access_code_user_changed")
+        pending["Set-Cookie"] = clear_session_cookie(config)
+    result = service.login_with_access_code(
+        login=login, code=code, ip=client_ip(request, config), user_agent=request.META.get("HTTP_USER_AGENT")
+    )
+    return send_json(200, auth_body(result["session"]), pending, {"Set-Cookie": session_cookie(result["token"], config)})
+
+
+def _session_belongs_to(session: dict, login: str) -> bool:
+    try:
+        return session["user"]["staff_login"] == access_codes.normalize_staff_login(login)
+    except AppError:
+        return False
+
+
+def _events(request, service, config: Config, pending: dict, current_session) -> HttpResponse:
+    session = service.require_session(current_session())
+    token = session_token(request, config)
+
+    def is_active() -> bool:
+        # Сессию закрывают и другие процессы (команда выдачи кода), и отключение пользователя:
+        # поток проверяет её с каждым сигналом «соединение живо».
+        live = service.session_by_token(token, touch=False)
+        return live is not None and live["id"] == session["id"]
+
+    subscriber = service.realtime.subscribe(session["id"], is_active)
+    response = StreamingHttpResponse(service.realtime.stream(subscriber), status=200)
+    del response["Content-Type"]
+    for name, value in {
+        **pending,
+        "Content-Type": "text/event-stream; charset=utf-8",
+        "Cache-Control": "no-cache, no-transform",
+        "X-Accel-Buffering": "no",
+    }.items():
+        response[name] = value
+    return response
