+def _cancel_or_restore_expense(nxt: dict, payload: dict, now: str, cancel: bool) -> None:
+    expense = _find(nxt["expenses"], lambda item: strict_eq(og(item, "id"), _p(payload, "id")))
+    if expense is None:
+        raise DomainError("Расход не найден")
+    if cancel and og(expense, "status") == "canceled":
+        raise DomainError("Расход уже аннулирован")
+    if not cancel and og(expense, "status") != "canceled":
+        raise DomainError("Расход не аннулирован")
+    period_locks.assert_expense_editable(nxt, expense)
+    linked_ticket, linked_allocation = _linked(nxt, expense)
+    if linked_allocation is not None:
+        period_locks.assert_month_editable(nxt, _month_key(og(linked_allocation, "expectedDate")))
+    expense["status"] = "canceled" if cancel else "active"
+    expense["updatedAt"] = now
+    expense["updatedBy"] = _author(payload)
+    expense["history"].append({"changedAt": now, "changedBy": expense["updatedBy"], "action": "canceled" if cancel else "restored"})
+    if truthy(og(expense, "forecastTicketId")) and truthy(og(expense, "forecastAllocationId")):
+        if linked_ticket is not None and linked_allocation is not None:
+            refresh_forecast_conversion_state(nxt, linked_ticket, linked_allocation)
+            linked_ticket["updatedAt"] = now
+            linked_ticket["updatedBy"] = expense["updatedBy"]
+            linked_ticket["history"].append({
+                "changedAt": now,
+                "changedBy": expense["updatedBy"],
+                "action": "forecast-fact-canceled" if cancel else "forecast-fact-restored",
+                "expenseId": expense["id"],
+            })
