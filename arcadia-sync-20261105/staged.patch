--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/app/tests/corporate-auth.test.js
@@ -0,0 +1,53 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+
+const { classifyCorporateAuth, corporateLoginRedirectAllowed, translateToEnglish } = require("../app.js");
+
+function response(status, type = "basic") {
+  return { status, type, ok: status >= 200 && status < 300 };
+}
+
+test("CorporateAuth_BalancerRedirectAndUnauthorizedRequireSignIn", () => {
+  assert.equal(classifyCorporateAuth(response(0, "opaqueredirect")).kind, "login_required");
+  assert.equal(classifyCorporateAuth(response(401), { code: "authentication_required" }).kind, "login_required");
+  assert.equal(classifyCorporateAuth(response(200), { user: {} }).kind, "ok");
+});
+
+test("CorporateAuth_RefusalsGetClearMessagesWithoutRedirect", () => {
+  const notProvisioned = classifyCorporateAuth(response(403), { code: "staff_access_not_provisioned", error: "server text" });
+  assert.equal(notProvisioned.kind, "forbidden");
+  assert.match(notProvisioned.message, /ещё не открыт доступ/);
+  assert.equal(classifyCorporateAuth(response(403), { code: "staff_access_disabled" }).kind, "forbidden");
+  assert.equal(classifyCorporateAuth(response(403), { code: "other", error: "Особый отказ" }).message, "Особый отказ");
+
+  const unavailable = classifyCorporateAuth(response(503), { code: "webauth_unavailable", error: "Внутренняя ошибка сервера" });
+  assert.equal(unavailable.kind, "unavailable");
+  assert.match(unavailable.message, /временно недоступен/);
+  assert.equal(classifyCorporateAuth(response(500), { code: "internal_error" }).kind, "error");
+});
+
+test("CorporateAuth_RedirectGuardAllowsOneAutomaticAttemptPerWindow", () => {
+  const values = new Map();
+  const storage = {
+    getItem: (key) => values.get(key) ?? null,
+    setItem: (key, value) => values.set(key, value)
+  };
+  const start = 1_000_000;
+  assert.equal(corporateLoginRedirectAllowed(storage, start), true);
+  assert.equal(corporateLoginRedirectAllowed(storage, start + 60_000), false);
+  assert.equal(corporateLoginRedirectAllowed(storage, start + 2 * 60_000 + 1), true);
+
+  const broken = { getItem() { throw new Error("storage disabled"); }, setItem() {} };
+  assert.equal(corporateLoginRedirectAllowed(broken, start), false);
+});
+
+test("CorporateAuth_MessagesAreTranslated", () => {
+  for (const code of ["staff_access_not_provisioned", "staff_access_disabled", "staff_identity_mismatch"]) {
+    const { message } = classifyCorporateAuth(response(403), { code });
+    assert.doesNotMatch(translateToEnglish(message), /[А-Яа-яЁё]/, code);
+  }
+  const { message } = classifyCorporateAuth(response(503), { code: "webauth_unavailable" });
+  assert.doesNotMatch(translateToEnglish(message), /[А-Яа-яЁё]/);
+});
diff --git a/junk/padolskiye/plan_fact_minipc/app/tests/localization.test.js b/junk/padolskiye/plan_fact_minipc/app/tests/localization.test.js
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/app/tests/localization.test.js
@@ -0,0 +1,92 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const test = require("node:test");
+const vm = require("node:vm");
+
+const { csvCell, translateToEnglish } = require("../app.js");
+
+const APP_ROOT = path.resolve(__dirname, "..");
+const CYRILLIC = /[А-Яа-яЁё]/;
+
+function untranslated(values) {
+  return [...new Set(values)]
+    .filter((value) => CYRILLIC.test(value))
+    .filter((value) => CYRILLIC.test(translateToEnglish(value)))
+    .sort((left, right) => left.localeCompare(right, "ru"));
+}
+
+test("EnglishLocalization_CoversStaticPageTextAndAccessibleLabels", () => {
+  const html = fs.readFileSync(path.join(APP_ROOT, "index.html"), "utf8");
+  const values = [];
+  const add = (value) => values.push(String(value).replace(/\s+/g, " ").trim());
+
+  for (const match of html.matchAll(/>([^<>]+)</g)) add(match[1]);
+  for (const match of html.matchAll(/\b(?:placeholder|title|aria-label)=(['"])(.*?)\1/gs)) add(match[2]);
+
+  assert.deepEqual(untranslated(values), []);
+});
+
+test("EnglishLocalization_CoversSimpleRuntimeMessages", () => {
+  let source = fs.readFileSync(path.join(APP_ROOT, "app.js"), "utf8");
+  const dictionaryStart = source.indexOf("const EN = {");
+  const dictionaryEnd = source.indexOf("\n  };", dictionaryStart) + 5;
+  source = source.slice(0, dictionaryStart) + source.slice(dictionaryEnd);
+
+  const values = [];
+  const patterns = [
+    /(?:showToast|setSaveStatus|confirmAction|promptAction|Error)\(\s*("(?:\\.|[^"\\])*")/g,
+    /(?:textContent|title)\s*=\s*("(?:\\.|[^"\\])*")/g
+  ];
+  for (const pattern of patterns) {
+    for (const match of source.matchAll(pattern)) {
+      try {
+        values.push(vm.runInNewContext(match[1]));
+      } catch {
+        // The scanner intentionally covers only self-contained string literals.
+      }
+    }
+  }
+
+  assert.deepEqual(untranslated(values), []);
+});
+
+test("EnglishLocalization_TranslatesDynamicMessagesWithoutChangingUserData", () => {
+  assert.equal(translateToEnglish("4 квартал 2026"), "Q4 2026");
+  assert.equal(translateToEnglish("2026-Q4"), "Q4 2026");
+  assert.equal(translateToEnglish("01/10/2026 · 4 квартал 2026"), "01/10/2026 · Q4 2026");
+  assert.equal(
+    translateToEnglish("Выгрузка CSV учитывает выбранные фильтры: 2 расхода."),
+    "The CSV export respects the selected filters: 2 expenses."
+  );
+  assert.equal(
+    translateToEnglish("Источник: мои тикеты TAXIASSIST. Новые расходы: Q4 2026. Следующая автоматическая попытка: сейчас."),
+    "Source: my TAXIASSIST issues. New expenses: Q4 2026. Next automatic attempt: now."
+  );
+  assert.equal(
+    translateToEnglish("Удалить локацию «London»? Это действие нельзя отменить."),
+    "Delete location “London”? This action cannot be undone."
+  );
+  assert.equal(
+    translateToEnglish("Бюджет за Q4 2026 импортирован: 120 строк, 8 курсов"),
+    "Budget for Q4 2026 imported: 120 rows, 8 exchange rates"
+  );
+  assert.equal(
+    translateToEnglish("Бюджет за 4 квартал 2026 уже загружен. Обновить план из выбранного файла? Записанные расходы, прогнозы и комментарии сохранятся."),
+    "Budget for Q4 2026 is already loaded. Update the plan from the selected file? Recorded expenses, forecasts, and comments will be preserved."
+  );
+  assert.equal(translateToEnglish("Статус"), "Status");
+  assert.equal(translateToEnglish("План развития офиса"), "План развития офиса");
+  assert.equal(translateToEnglish("Итого инвестиций"), "Итого инвестиций");
+  assert.equal(translateToEnglish("User-entered project name"), "User-entered project name");
+});
+
+test("CsvExport_TreatsFormulaLikeValuesAsText", () => {
+  for (const value of ["=1+1", "+SUM(A1:A2)", "-1+2", "@command", "\tformula", "\rformula"]) {
+    assert.equal(csvCell(value).startsWith('"\''), true);
+  }
+  assert.equal(csvCell("ordinary value"), '"ordinary value"');
+  assert.equal(csvCell('value "with quotes"'), '"value ""with quotes"""');
+});
