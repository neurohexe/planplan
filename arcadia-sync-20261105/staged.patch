+LONG = os.environ.get("PLAN_FACT_PARITY_LONG") == "1"
+ZONES = ("Europe/Moscow", "Asia/Tashkent", "UTC", "America/New_York") if LONG else ("Asia/Tashkent", "America/New_York")
+USERS = [
+    {"id": "u1", "name": "Алиса", "role": "superadmin", "active": True, "defaultLocationAccess": "hidden"},
+    {"id": "u2", "name": "Боб", "role": "admin", "active": True, "defaultLocationAccess": "hidden"},
+    {"id": "u3", "name": "Кэрол", "role": "user", "active": True, "defaultLocationAccess": "view"},
+    {"id": "u4", "name": "Дэйв", "role": "user", "active": True, "defaultLocationAccess": "hidden"},
+    {"id": "u5", "name": "Ева", "role": "user", "active": False, "defaultLocationAccess": "view"},
+]
