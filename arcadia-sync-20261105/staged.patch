+#!/bin/bash
+# Проверяет, готов ли туннель: клиент dk, сетевой доступ к Tunneler, ответ адреса туннеля.
+# Ничего не меняет и работает даже до установки стенда. Код возврата 0 — туннель можно включать
+# или он уже работает; 1 — не хватает клиента, сетевого доступа или туннель включён, но не отвечает.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=tunnel-common.sh
+. "$SCRIPT_DIR/tunnel-common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: tunnel-check.sh'
+load_tunnel_config optional
+
+reason_text() {
+  case "$1" in
+    timeout) printf 'таймаут за 5 секунд: пропуск ещё не действует или вы вне корпоративной сети' ;;
+    dns) printf 'имя не находится: подключитесь к корпоративной сети или VPN' ;;
+    refused) printf 'соединение отклонено' ;;
+    noroute) printf 'нет маршрута: проверьте сеть и VPN' ;;
+    *) printf 'ошибка соединения' ;;
+  esac
+}
+
+ready=true
+balancer_ok=false
+printf 'Проверка туннеля Tunneler\n'
+printf 'Адрес для коллег: %s\n' "$TUNNEL_URL"
+if [ "$STAND_INSTALLED" = false ]; then
+  printf 'Стенд ещё не установлен: проверяю с настройками по умолчанию.\n'
+fi
+if [ -f "$TUNNEL_FLAG" ]; then
+  tunnel_enabled=true
+  printf 'Туннель включён (bin/disable-tunnel.sh выключает).\n'
+else
+  tunnel_enabled=false
+  printf 'Туннель выключен (bin/enable-tunnel.sh включает).\n'
+fi
+
+if find_dk; then
+  printf '1. Клиент dk: установлен, версия %s.\n' "$(dk_version)"
+else
+  printf '1. Клиент dk: не найден. Установите: %s\n' "$TUNNEL_INSTALL_HINT"
+  ready=false
+fi
+
+if reason=$(tcp_probe "$TUNNEL_BALANCER_HOST" 443); then
+  printf '2. Сетевой доступ до балансера %s, порт 443: есть.\n' "$TUNNEL_BALANCER_HOST"
+  balancer_ok=true
+else
+  printf '2. Сетевой доступ до балансера %s, порт 443: нет (%s).\n' "$TUNNEL_BALANCER_HOST" "$(reason_text "$reason")"
+  ready=false
+fi
+
+# Порт 2022 открыт до серверов Tunneler; их адрес, как и dk, берём у API (первый в списке, IPv6).
+if instance=$(tunnel_instance); then
+  instance_address=${instance% *}
+  instance_port=${instance#* }
+  if reason=$(tcp_probe "$instance_address" "$instance_port" 6); then
+    printf '3. Сетевой доступ до сервера Tunneler %s (%s), порт %s: есть.\n' "$TUNNEL_IDENT" "$instance_address" "$instance_port"
+  else
+    printf '3. Сетевой доступ до сервера Tunneler %s (%s), порт %s: нет (%s).\n' "$TUNNEL_IDENT" "$instance_address" "$instance_port" "$(reason_text "$reason")"
+    ready=false
+  fi
+else
+  printf '3. Сервер Tunneler %s: адрес у API %s получить не удалось, порт 2022 проверить нельзя (нужен доступ до балансера по IPv6).\n' "$TUNNEL_IDENT" "$TUNNEL_HOST"
+  ready=false
+fi
+
+address_ok=false
+if [ "$balancer_ok" = true ]; then
+  address_status=0
+  address_code=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 10 "$TUNNEL_URL/api/ready") || address_status=$?
+  if [ "$address_status" -eq 0 ] && [ "$address_code" = 200 ]; then
+    printf '4. Адрес туннеля отвечает: /api/ready — 200.\n'
+    address_ok=true
+  elif [ "$address_status" -eq 60 ]; then
+    printf '4. Адрес туннеля: браузер и curl не доверяют сертификату. Установите внутренний сертификат Яндекса.\n'
+  elif [ "$tunnel_enabled" = true ]; then
+    printf '4. Адрес туннеля не отвечает (код %s), хотя туннель включён: смотрите logs/tunnel.log.\n' "$address_code"
+  else
+    printf '4. Адрес туннеля не отвечает (код %s): туннель сейчас не поднят.\n' "$address_code"
+  fi
+else
+  printf '4. Адрес туннеля не проверялся: нет сетевого доступа до балансера.\n'
+fi
+
+if [ "$address_ok" = true ]; then
+  printf 'Итог: туннель работает, адрес открывается.\n'
+  exit 0
+fi
+if [ "$ready" = false ]; then
+  printf 'Итог: включать туннель рано. Если не хватает сетевого доступа, дождитесь одобрения заявок на доступ и запустите проверку снова.\n'
+  exit 1
+fi
+if [ "$tunnel_enabled" = true ]; then
+  printf 'Итог: доступ и клиент в порядке, но туннель включён и не отвечает. Смотрите logs/tunnel.log; выключить: bin/disable-tunnel.sh.\n'
+  printf 'Если в журнале ошибка доступа ssh (Permission denied), проверьте сертификат: ssh insecure@skotty.sec.yandex.net; при ошибке выполните skotty renew.\n'
+  exit 1
+fi
+printf 'Итог: доступ есть, клиент установлен — туннель можно включать: bin/enable-tunnel.sh.\n'
+exit 0
