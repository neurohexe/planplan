+        self._tmp = tempfile.TemporaryDirectory(prefix="plan-fact-import-")
+        self.root = Path(self._tmp.name)
+        self.database = self.root / "plan-fact.sqlite"
+        result = subprocess.run(
+            [parity.node_binary(), "--experimental-sqlite", str(SCRIPT), str(self.database)],
+            capture_output=True, text=True, timeout=120, env={**os.environ, "PLAN_FACT_REPO_ROOT": str(parity.REPO_ROOT)},
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.node = json.loads(result.stdout)
+        self.service = runtime.configure(load_config(stand_env(self.root)))
+
+    def tearDown(self) -> None:
+        runtime.configure(settings.PLAN_FACT)
+        self._tmp.cleanup()
