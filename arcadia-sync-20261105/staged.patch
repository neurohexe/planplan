+#!/bin/bash
+# Изолированные проверки отказов и порядка работы с дампом; службы и настоящий стенд не используются.
+set -euo pipefail
+umask 077
+ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd -P)
+mkdir -p "$ROOT/.sandbox"
+TEMP=$(mktemp -d "$ROOT/.sandbox/django-scripts.XXXXXX")
+trap 'rm -rf -- "$TEMP"' EXIT
+export PLANFACT_HOME="$TEMP/stand" PLANFACT_DJANGO_HOME="$TEMP/django"
+mkdir -p "$PLANFACT_HOME/systemd" "$PLANFACT_DJANGO_HOME"
+. "$ROOT/deploy/linux/django/common-django.sh"
+calls="$TEMP/calls"
+mode=ok
+pg_tool() {
+  printf '%s\n' "$1 $*" >> "$calls"
+  case "$1" in
+    pg_dump)
+      local previous='' item
+      for item in "$@"; do
+        if [ "$previous" = --file ]; then printf 'fictional dump\n' > "$item"; fi
+        previous=$item
+      done
+      [ "$mode" != dump-fails ] ;;
+    pg_restore)
+      [ "$mode" != restore-fails ] ;;
+  esac
+}
+database_summary() { printf 'revision=7\nsha256=fictional\n'; }
+pg_safety_dump "$TEMP/good.dump"
+[ -s "$TEMP/good.dump" ]
+python3 - "$TEMP/good.dump" <<'PY'
+import os, stat, sys
+assert stat.S_IMODE(os.stat(sys.argv[1]).st_mode) == 0o600
+PY
+mode=dump-fails
+if pg_safety_dump "$TEMP/bad.dump"; then echo 'Не обнаружен отказ pg_dump' >&2; exit 1; fi
+[ ! -e "$TEMP/bad.dump" ] && [ ! -e "$TEMP/bad.dump.tmp.$$" ]
+mode=ok
+check_dump "$TEMP/good.dump" "$TEMP/good.summary"
+grep -q '^revision=7$' "$TEMP/good.summary"
+grep -q createdb "$calls"
+grep -q dropdb "$calls"
+mode=restore-fails
+if check_dump "$TEMP/good.dump" "$TEMP/bad.summary"; then echo 'Не обнаружен отказ pg_restore' >&2; exit 1; fi
+[ ! -f "$TEMP/bad.summary" ]
+touch "$PLANFACT_HOME/systemd/.backend-django"
+cp "$ROOT/deploy/linux/common.sh" "$TEMP/common.sh"
+for command in issue-code close-sessions backup restore status offsite-backup install; do
+  printf '#!/bin/bash\n. "%s/common.sh"\necho UNEXPECTED_SUCCESS\n' "$TEMP" > "$TEMP/$command.sh"
+  if bash "$TEMP/$command.sh" > "$TEMP/refusal.log" 2>&1; then echo "Не заблокирована $command" >&2; exit 1; fi
+  grep -q Django "$TEMP/refusal.log"
+  if grep -q UNEXPECTED_SUCCESS "$TEMP/refusal.log"; then exit 1; fi
+done
+for command in healthcheck rotate-logs tunnel-run enable-tunnel disable-tunnel tunnel-check disable-offsite-backup offsite-open; do
+  printf '#!/bin/bash\n. "%s/common.sh"\necho ALLOWED\n' "$TEMP" > "$TEMP/$command.sh"
+  bash "$TEMP/$command.sh" > "$TEMP/allowed.log"
+  grep -q ALLOWED "$TEMP/allowed.log"
+done
+for script in "$ROOT"/deploy/linux/django/*.sh; do bash -n "$script"; done
+echo 'Проверены: целостность дампа, уборка незавершённого дампа, пробное восстановление, отказ повреждённого дампа, 7 запретов и 8 разрешённых служебных команд.'
