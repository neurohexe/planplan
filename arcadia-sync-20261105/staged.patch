+test("CorporateTvmConfig_CliDoesNotReadOrPrintSecrets_AndDoesNotStartDaemon", async (t) => {
+  const root = await directory(t);
+  const args = [helperPath, "--config-dir", path.join(root, "cli"), "--tvm-id", "1001", "--system", "fixture-app",
+    "--alias", "fixture", "--port", "18768", "--proxy-port", "18769"];
+  const child = spawnSync(process.execPath, args, { encoding: "utf8", env: {
+    PATH: process.env.PATH, PLAN_FACT_TVM_SECRET: "fixture-value-must-stay-secret", TVMTOOL_LOCAL_AUTHTOKEN: "fixture-auth-must-stay-secret"
+  } });
+  assert.equal(child.status, 0, child.stderr);
+  const result = JSON.parse(child.stdout);
+  assert.equal(result.proxyUrl, "http://127.0.0.1:18769");
+  const content = await fs.readFile(result.configFile, "utf8");
+  assert.doesNotMatch(`${child.stdout}${child.stderr}${content}`, /fixture-value-must-stay-secret|fixture-auth-must-stay-secret/);
+  assert.deepEqual(await fs.readdir(result.cacheDir), []);
+  const failed = spawnSync(process.execPath, args, { encoding: "utf8" });
