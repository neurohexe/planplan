+test("StoreAccessCode_CounterIsSharedAcrossConnections", async () => {
+  const fixture = createFixture();
+  const other = new SqliteStore(fixture.databasePath, { initialState: PlanFactService.initialState });
+  try {
+    const alice = await fixture.addUser("alice", "superadmin");
+    const save = (hash) => fixture.store.saveAccessCode({
+      userId: alice.id, codeHash: hash, salt: "00", kdfParams: { algorithm: "scrypt" }, issuedAt: "2026-10-10T08:00:00.000Z"
+    });
+    const rules = { maxFailures: 5, lockMs: LOCK_MS };
+    const now = "2026-10-10T09:00:00.000Z";
+    const lockedUntil = "2026-10-10T09:15:00.000Z";
+    assert.equal(fixture.store.recordAccessCodeFailure(alice.id, { now, ...rules }), null, "кода нет — считать нечего");
+
+    save("aa");
+    // Пять ошибок через два соединения к одной базе: ни одна не теряется.
+    const results = [fixture.store, other, fixture.store, other, fixture.store]
+      .map((store) => store.recordAccessCodeFailure(alice.id, { now, ...rules }));
+    assert.deepEqual(results.map((result) => result.failedAttempts), [1, 2, 3, 4, 5]);
+    assert.deepEqual(results.map((result) => result.locked), [false, false, false, false, true]);
+    assert.equal(results[4].lockedUntil, lockedUntil);
+
+    // Пока блокировка действует, новые ошибки её не меняют.
+    const during = other.recordAccessCodeFailure(alice.id, { now: "2026-10-10T09:10:00.000Z", ...rules });
+    assert.deepEqual({ ...during }, { failedAttempts: 5, lockedUntil, locked: true });
+    assert.deepEqual(accessState(fixture, alice.id), { failedAttempts: 5, lockedUntil });
+    assert.equal(fixture.store.resetAccessCodeFailures(alice.id, { now: "2026-10-10T09:10:00.000Z", codeHash: "aa" }), false);
+
+    // После окончания блокировки счёт начинается заново; сброс срабатывает только для того же кода.
+    const after = other.recordAccessCodeFailure(alice.id, { now: lockedUntil, ...rules });
+    assert.deepEqual({ ...after }, { failedAttempts: 1, lockedUntil: null, locked: false });
+    assert.equal(fixture.store.resetAccessCodeFailures(alice.id, { now: lockedUntil, codeHash: "other" }), false);
+    assert.equal(fixture.store.resetAccessCodeFailures(alice.id, { now: lockedUntil, codeHash: "aa" }), true);
+    assert.deepEqual(accessState(fixture, alice.id), { failedAttempts: 0, lockedUntil: null });
+
+    // Новая выдача кода сбрасывает и счётчик, и блокировку.
+    for (let attempt = 0; attempt < 5; attempt += 1) fixture.store.recordAccessCodeFailure(alice.id, { now, ...rules });
+    assert.equal(accessState(fixture, alice.id).lockedUntil, lockedUntil);
+    save("bb");
+    assert.deepEqual(accessState(fixture, alice.id), { failedAttempts: 0, lockedUntil: null });
+    assert.equal(fixture.store.getAccessCode(alice.id).last_failed_at, null);
+    assert.equal(fixture.store.getAccessCode(alice.id).code_hash, "bb");
