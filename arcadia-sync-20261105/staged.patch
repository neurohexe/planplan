+# Настройки тестового стенда. Секретов в этом файле нет.
+# Полные пути создаёт установщик; файл можно подключать стандартным bash.
+PLAN_FACT_NODE_BIN={{NODE}}
+NODE_ENV=development
+# Исходный режим. Повторная установка сохраняет существующий config.env полностью.
+# Подготовка corporate-idm описана в config.corporate.env.example; одного переключателя недостаточно.
+PLAN_FACT_AUTH_MODE=access-code
+PLAN_FACT_STORAGE_DRIVER=sqlite
+PLAN_FACT_ROLE_SOURCE=app
+PLAN_FACT_DEPLOYMENT_PROFILE=full
+PLAN_FACT_DATABASE={{DATABASE}}
+PLAN_FACT_HOST=127.0.0.1
+PLAN_FACT_PORT=18766
+PLAN_FACT_STATIC_DIR={{STATIC}}
+PLAN_FACT_CODES_DIR={{CODES}}
+PLAN_FACT_SECURE_COOKIES=true
+PLAN_FACT_ALLOWED_ORIGINS=''
+# Туннель (задача 9): сервер Tunneler и постоянный удалённый порт закрепляют адрес стенда
+# https://<логин>-<порт>-ws1.tunneler-si.yandex.ru. На Linux учётная запись компьютера (например, zomb-…)
+# не совпадает со Staff-логином владельца туннеля, поэтому логин задаётся явно, перед включением туннеля:
+# PLAN_FACT_TUNNEL_USERNAME=<Staff-логин владельца>
+# PLAN_FACT_ALLOWED_ORIGINS выше пишут enable-tunnel.sh и disable-tunnel.sh.
+PLAN_FACT_TUNNEL_HOST=ws1-tunnelerapi.tunneler-si.yandex-team.ru
+PLAN_FACT_TUNNEL_REMOTE_PORT=28766
+# Только если в logs/tunnel.log видно, что ssh не договаривается с Tunneler (FAQ Tunneler, OpenSSH 9+),
+# разрешите алгоритмы ssh-rsa для одного туннеля, не меняя ~/.ssh/config:
+# PLAN_FACT_TUNNEL_SSH_RSA=yes
+# Копия в Трекер (задача 36): тикет записывает bin/enable-offsite-backup.sh <тикет>. Токен Трекера и пароль копий
+# хранятся не здесь, а в папке secrets/ стенда. Если curl не принимает сертификат Трекера, укажите файл
+# внутреннего корневого сертификата Яндекса:
+# PLAN_FACT_OFFSITE_CA_FILE=<полный путь к сертификату>
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/disable-offsite-backup.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/disable-offsite-backup.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/disable-offsite-backup.sh
@@ -0,0 +1,34 @@
+#!/bin/bash
+# Выключает копию в Трекер: снимает метку «включена», выключает автозапуск таймера и останавливает его.
+# Токен и пароль копий остаются в secrets/ стенда. С флагом --delete-token файл токена Трекера удаляется;
+# пароль копий сохраняется — без него не открыть копии, уже отправленные в Трекер.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=offsite-common.sh
+. "$SCRIPT_DIR/offsite-common.sh"
+DELETE_TOKEN=false
+case "$#" in
+  0) ;;
+  1) [ "$1" = --delete-token ] || fail 'Использование: disable-offsite-backup.sh [--delete-token]'; DELETE_TOKEN=true ;;
+  *) fail 'Использование: disable-offsite-backup.sh [--delete-token]' ;;
+esac
+load_stand_config
+[ ! -L "$OFFSITE_FLAG" ] || fail 'Метка systemd/.offsite-enabled не должна быть символической ссылкой.'
+
+# Метку снимаем первой: даже если остановка не удастся, после перезапуска стенда таймер сам не включится.
+rm -f -- "$OFFSITE_FLAG"
+if systemd_enabled; then
+  require_user_systemd
+  if [ -f "$UNIT_DIR/$OFFSITE_LABEL.timer" ]; then
+    user_systemctl disable "$OFFSITE_LABEL.timer" >/dev/null 2>&1 || fail 'Не удалось выключить автозапуск таймера копии в Трекер.'
+  fi
+  bootout_agent "$OFFSITE_LABEL"
+fi
+printf 'Копия в Трекер выключена: таймер остановлен, ежедневной отправки больше нет.\n'
+if [ "$DELETE_TOKEN" = true ]; then
+  [ ! -L "$OFFSITE_TOKEN_FILE" ] && { [ ! -e "$OFFSITE_TOKEN_FILE" ] || [ -f "$OFFSITE_TOKEN_FILE" ]; } \
+    || fail 'secrets/tracker-token должен быть обычным файлом. Токен не удалён.'
+  rm -f -- "$OFFSITE_TOKEN_FILE"
+  printf 'Файл токена Трекера удалён с компьютера. Сам токен действует, пока его не отозвать на странице OAuth.\n'
+fi
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/disable-tunnel.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/disable-tunnel.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/disable-tunnel.sh
@@ -0,0 +1,41 @@
+#!/bin/bash
+# Выключает туннель: останавливает службу туннеля и выключает её автозапуск, снимает метку «включён», возвращает пустой
+# PLAN_FACT_ALLOWED_ORIGINS и перезапускает сервер, чтобы он перестал принимать имя туннеля.
+# Метку снимаем первой: даже если остановка службы не удастся, туннель после перезапуска сам не поднимется.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=tunnel-common.sh
+. "$SCRIPT_DIR/tunnel-common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: disable-tunnel.sh'
+# Выключение не зависит от настроек туннеля (логин, порт, сервер): оно должно работать и при испорченных значениях.
+load_stand_config
+[ ! -L "$TUNNEL_FLAG" ] || fail 'Метка systemd/.tunnel-enabled не должна быть символической ссылкой.'
+
+rm -f -- "$TUNNEL_FLAG"
+if systemd_enabled; then
+  require_user_systemd
+  if [ -f "$UNIT_DIR/$TUNNEL_LABEL.service" ]; then
+    user_systemctl disable "$TUNNEL_LABEL.service" >/dev/null 2>&1 || fail 'Не удалось выключить автозапуск службы туннеля.'
+  fi
+  bootout_agent "$TUNNEL_LABEL"
+fi
+# В корпоративном режиме origin является частью зарегистрированного входа.
+# Остановка туннеля не должна портить конфигурацию и переводить сервер к локальному входу.
+if [ "$PLAN_FACT_AUTH_MODE" = corporate-idm ]; then
+  printf 'Туннель выключен. Зарегистрированный корпоративный адрес и режим входа сохранены.\n'
+  exit 0
+fi
+set_stand_setting PLAN_FACT_ALLOWED_ORIGINS ''
+printf 'Туннель выключен: служба остановлена, адрес убран из настроек стенда.\n'
+if ! systemd_enabled; then
+  printf 'Проверочная установка без автозапуска: сервер не перезапускается.\n'
+  exit 0
+fi
+if app_agent_loaded; then
+  printf 'Перезапускаю сервер, чтобы он перестал принимать имя туннеля…\n'
+  restart_app_agent
+  printf 'Сервер перезапущен и отвечает.\n'
+else
+  printf 'Сервер сейчас не запущен: новые настройки он примет при запуске.\n'
+fi
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/enable-offsite-backup.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/enable-offsite-backup.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/enable-offsite-backup.sh
@@ -0,0 +1,96 @@
+#!/bin/bash
+# Включает копию в Трекер: спрашивает токен Трекера и пароль копий (ввод не отображается), кладёт их в secrets/
+# стенда (папка 700, файлы 600), тикет записывает в config.env, делает пробную отправку и только после её успеха
+# включает ежедневный таймер (23:59 по Ташкенту). Повторный запуск безопасен: введённые раньше токен и пароль
+# сохраняются, пока их не попросят заменить флагами --replace-token и --replace-password.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=offsite-common.sh
+. "$SCRIPT_DIR/offsite-common.sh"
+# Оттуда — безопасная запись настройки в config.env (set_stand_setting).
+# shellcheck source=tunnel-common.sh
+. "$SCRIPT_DIR/tunnel-common.sh"
+
+USAGE='Использование: enable-offsite-backup.sh <тикет, например ABC-123> [--replace-token] [--replace-password]'
+ISSUE=''
+REPLACE_TOKEN=false
+REPLACE_PASSWORD=false
+for argument in "$@"; do
+  case "$argument" in
+    --replace-token) REPLACE_TOKEN=true ;;
+    --replace-password) REPLACE_PASSWORD=true ;;
+    -*) fail "$USAGE" ;;
+    *) [ -z "$ISSUE" ] || fail "$USAGE"; ISSUE=$argument ;;
+  esac
+done
+valid_issue "$ISSUE" || fail "$USAGE"
+load_stand_config
+command -v curl >/dev/null 2>&1 || fail 'Не найдена команда curl.'
+[ ! -L "$OFFSITE_FLAG" ] || fail 'Метка systemd/.offsite-enabled не должна быть символической ссылкой.'
+if systemd_enabled; then
+  require_user_systemd
+  agent_installed "$OFFSITE_LABEL" || fail 'Не найдена установленная служба копии в Трекер. Повторите установку из мастерской (deploy/linux/install.sh).'
+fi
+private_directory "$OFFSITE_SECRETS"
+
+# Вопрос без отображения ввода; ответ — в OFFSITE_ANSWER. Подсказка идёт в stderr, чтобы не смешиваться с выводом.
+ask_secret() {
+  OFFSITE_ANSWER=''
+  printf '%s' "$1" >&2
+  IFS= read -r -s OFFSITE_ANSWER || true
+  printf '\n' >&2
+}
+# Значение пишется встроенной командой printf во временный файл рядом и переносится на место: в аргументы
+# процессов оно не попадает, а недописанный файл не заменит прежний.
+store_secret() {
+  local file=$1 value=$2 temporary
+  [ ! -L "$file" ] && { [ ! -e "$file" ] || [ -f "$file" ]; } || fail "Файл $file должен быть обычным файлом."
+  temporary=$(mktemp "$OFFSITE_SECRETS/.secret.XXXXXX")
+  printf '%s\n' "$value" > "$temporary"
+  chmod 600 "$temporary"
+  mv -f -- "$temporary" "$file"
+}
+
+if [ "$REPLACE_TOKEN" = true ] || ! secret_file_ok "$OFFSITE_TOKEN_FILE"; then
+  ask_secret 'Вставьте токен Трекера и нажмите Enter (символы не отображаются): '
+  [[ "$OFFSITE_ANSWER" =~ $OFFSITE_TOKEN_PATTERN ]] \
+    || fail 'Это не похоже на токен Трекера: нужна одна строка из латинских букв, цифр и знаков . _ -. Токен не сохранён.'
+  store_secret "$OFFSITE_TOKEN_FILE" "$OFFSITE_ANSWER"
+  OFFSITE_ANSWER=''
+  printf 'Токен сохранён в %s (права 600).\n' "$OFFSITE_TOKEN_FILE"
+fi
+
+if [ "$REPLACE_PASSWORD" = true ] || ! secret_file_ok "$OFFSITE_PASSWORD_FILE"; then
+  printf 'Придумайте пароль копий — не короче 12 символов. Им шифруется каждая копия. Сохраните его у себя,\n' >&2
+  printf 'например в менеджере паролей: без него копии из Трекера не открыть.\n' >&2
+  [ "$REPLACE_PASSWORD" = false ] || printf 'Копии, уже отправленные в Трекер, по-прежнему открываются только прежним паролем.\n' >&2
+  ask_secret 'Пароль копий (символы не отображаются): '
+  first=$OFFSITE_ANSWER
+  ask_secret 'Повторите пароль: '
+  [ "$first" = "$OFFSITE_ANSWER" ] || fail 'Пароли не совпали. Пароль не сохранён.'
+  [ "${#first}" -ge 12 ] && [ "${#first}" -le 1024 ] || fail 'Пароль должен быть не короче 12 символов. Пароль не сохранён.'
+  store_secret "$OFFSITE_PASSWORD_FILE" "$first"
+  first=''
+  OFFSITE_ANSWER=''
+  printf 'Пароль копий сохранён в %s (права 600).\n' "$OFFSITE_PASSWORD_FILE"
+fi
+
+set_stand_setting PLAN_FACT_OFFSITE_ISSUE "$ISSUE"
+printf 'Тикет для копий записан в настройки стенда: %s\n' "$ISSUE"
+printf 'Пробная отправка: свежая копия уходит в %s прямо сейчас…\n' "$ISSUE"
+if ! PLANFACT_OFFSITE_ATTEMPTS=1 /bin/bash "$SCRIPT_DIR/offsite-backup.sh"; then
+  printf 'Пробная отправка не удалась, ежедневная отправка не включена. Причина — в строке «Ошибка» выше.\n'
+  exit 1
+fi
+# Метка ставится только после успешной пробной отправки.
+: > "$OFFSITE_FLAG"
+chmod 600 "$OFFSITE_FLAG"
+if ! systemd_enabled; then
+  printf 'Проверочная установка без автозапуска: таймер не включается.\n'
+  exit 0
+fi
+user_systemctl enable "$OFFSITE_LABEL.timer" >/dev/null 2>&1 || fail 'Не удалось включить автозапуск таймера копии в Трекер.'
+user_systemctl restart "$OFFSITE_LABEL.timer" >/dev/null 2>&1 || fail 'Не удалось запустить таймер копии в Трекер.'
+printf 'Копия в Трекер включена: каждый день в 23:59 по Ташкенту. Если в это время компьютер выключен или спит, копия уйдёт после включения.\n'
+printf 'Журнал отправок: %s/logs/offsite.log. Выключить: bin/disable-offsite-backup.sh.\n' "$STAND"
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/enable-tunnel.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/enable-tunnel.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/enable-tunnel.sh
@@ -0,0 +1,78 @@
+#!/bin/bash
+# Включает туннель: записывает его адрес в PLAN_FACT_ALLOWED_ORIGINS (config.env), перезапускает сервер,
+# включает службу туннеля и ждёт, пока /api/ready ответит через адрес туннеля (до 60 секунд).
+# Повторный запуск безопасен. После переустановки стенда (install.sh) запускайте его снова.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=tunnel-common.sh
+. "$SCRIPT_DIR/tunnel-common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: enable-tunnel.sh'
+load_tunnel_config strict
+if [ "$PLAN_FACT_AUTH_MODE" = corporate-idm ]; then
+  [ "$TUNNEL_URL" = "$PLAN_FACT_CORPORATE_PUBLIC_URL" ] || fail 'Адрес туннеля отличается от зарегистрированного корпоративного адреса. Настройки не изменены.'
+fi
+find_dk || fail "Не найден клиент dk. Установите: $TUNNEL_INSTALL_HINT"
+[ ! -L "$TUNNEL_FLAG" ] || fail 'Метка systemd/.tunnel-enabled не должна быть символической ссылкой.'
+
+WAIT=${PLANFACT_TUNNEL_WAIT_SECONDS:-60}
+POLL=${PLANFACT_TUNNEL_POLL_SECONDS:-2}
+[[ "$WAIT" =~ ^[0-9]{1,4}$ ]] || WAIT=60
+[[ "$POLL" =~ ^[1-9][0-9]{0,2}$ ]] || POLL=2
+
+# Всё, что может не получиться без изменений, проверяем до записи настроек.
+if systemd_enabled; then
+  require_user_systemd
+  agent_installed "$TUNNEL_LABEL" || fail 'Не найдена установленная служба туннеля. Повторите установку из мастерской (deploy/linux/install.sh).'
+  agent_installed "$APP_LABEL" || fail 'Не найдена установленная служба сервера. Повторите установку из мастерской.'
+fi
+
+mark_enabled() {
+  : > "$TUNNEL_FLAG"
+  chmod 600 "$TUNNEL_FLAG"
+}
+
+set_stand_setting PLAN_FACT_ALLOWED_ORIGINS "$TUNNEL_URL"
+printf 'Адрес туннеля записан в настройки стенда: %s\n' "$TUNNEL_URL"
+if ! systemd_enabled; then
+  mark_enabled
+  printf 'Проверочная установка без автозапуска: сервер и служба туннеля не перезапускаются. Для ручной проверки перезапустите run-app.sh и запустите tunnel-run.sh --now.\n'
+  exit 0
+fi
+
+printf 'Перезапускаю сервер, чтобы он принял адрес туннеля…\n'
+restart_app_agent
+# Метка «включён» ставится только после того, как сервер поднялся: иначе после неудачи туннель всё равно
+# поднимался бы сам после перезагрузки.
+mark_enabled
+printf 'Включаю службу туннеля…\n'
+bootout_agent "$TUNNEL_LABEL"
+# Автозапуск после перезагрузки и сам запуск.
+user_systemctl enable "$TUNNEL_LABEL.service" >/dev/null 2>&1 || fail 'Не удалось включить автозапуск службы туннеля.'
+user_systemctl start "$TUNNEL_LABEL.service" >/dev/null 2>&1 || fail 'Не удалось запустить службу туннеля.'
+printf 'Жду ответа стенда через адрес туннеля (до %s секунд)…\n' "$WAIT"
+if wait_for_200 "$TUNNEL_URL/api/ready" "$WAIT" "$POLL"; then
+  printf 'Туннель включён: стенд отвечает через адрес туннеля (/api/ready — 200).\n'
+  printf 'Адрес для коллег: %s\n' "$TUNNEL_URL"
+  exit 0
+fi
+
+printf 'Через %s секунд адрес туннеля не ответил (последний код: %s).\n' "$WAIT" "$WAIT_LAST_CODE"
+case "$WAIT_LAST_CODE" in
+  000)
+    if [ "$WAIT_LAST_STATUS" -eq 60 ]; then
+      printf 'Сертификат адреса туннеля не принят: нужен внутренний сертификат Яндекса, как для браузера. Туннель при этом может работать: проверьте адрес в браузере.\n'
+    else
+      printf 'Адрес не открывается: проверьте сетевой доступ (bin/tunnel-check.sh) и logs/tunnel.log.\n'
+    fi ;;
+  403) printf 'Стенд отказал по имени (host_forbidden или origin_forbidden): адрес, с которым приходят запросы, не совпал с записанным в PLAN_FACT_ALLOWED_ORIGINS.\n' ;;
+  503) printf 'Сервер или корпоративная проверка доступа ещё не готовы. Проверьте безопасную диагностику /api/ready и подключение служб.\n' ;;
+  502|504) printf 'Tunneler не нашёл туннель: он ещё не поднялся или оборвался. Смотрите logs/tunnel.log.\n' ;;
+  *) printf 'Неожиданный ответ. Смотрите logs/tunnel.log и logs/app.stderr.log.\n' ;;
+esac
+if [ -f "$STAND/logs/tunnel.log" ] && [ ! -L "$STAND/logs/tunnel.log" ]; then
+  printf 'Последние строки logs/tunnel.log:\n'
+  tail -n 5 "$STAND/logs/tunnel.log"
+fi
+printf 'Служба туннеля остаётся включённой и продолжает попытки. Остановить: bin/disable-tunnel.sh.\n'
+exit 1
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/healthcheck.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/healthcheck.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/healthcheck.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+# Проверка готовности сервера раз в 5 минут (таймер systemd). На мини-ПК всплывающих уведомлений нет:
+# сбой и восстановление записываются в logs/healthcheck.log, а status.sh показывает текущее состояние.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=maintenance-common.sh
+. "$SCRIPT_DIR/maintenance-common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: healthcheck.sh'
+load_stand_config
+private_directory "$STAND/logs"
+DOWN_FILE="$STAND/logs/.healthcheck-down"
+ordinary_or_missing "$DOWN_FILE"
+
+http_code=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 5 "http://127.0.0.1:$PLAN_FACT_PORT/api/ready") || http_code=000
+if [ "$http_code" = 200 ]; then
+  if [ -f "$DOWN_FILE" ]; then
+    maintenance_log healthcheck.log 'Стенд снова работает.'
+    rm -f -- "$DOWN_FILE"
+  fi
+  exit 0
+fi
+maintenance_log healthcheck.log "Стенд не отвечает или не готов (HTTP $http_code)."
+if [ ! -f "$DOWN_FILE" ]; then
+  : > "$DOWN_FILE"
+  chmod 600 "$DOWN_FILE"
+fi
+exit 1
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/install.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/install.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/install.sh
@@ -0,0 +1,179 @@
+#!/bin/bash
+# Установка стенда на Linux (мини-ПК). Общие скрипты берутся из deploy/laptop, поверх них кладутся
+# Linux-версии из deploy/linux. Вместо агентов launchd — пользовательские службы systemd.
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=common.sh
+. "$SCRIPT_DIR/common.sh"
+
+NO_START=false
+NO_SYSTEMD=false
+for argument in "$@"; do
+  case "$argument" in
+    --no-start) NO_START=true ;;
+    --no-systemd) NO_SYSTEMD=true ;;
+    *) fail 'Использование: install.sh [--no-start] [--no-systemd]' ;;
+  esac
+done
+
+PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)
+BASE_DIR="$PROJECT_ROOT/deploy/laptop"
+[ -f "$PROJECT_ROOT/scripts/build-static.mjs" ] && [ -d "$BASE_DIR" ] || fail 'Запустите deploy/linux/install.sh из мастерской с исходниками.'
+[ "$STAND" != "$PROJECT_ROOT" ] || fail 'Папка стенда должна отличаться от мастерской.'
+NODE_BINARY=$(command -v node) || fail 'Не найден Node. Нужен Node 22.5 или новее.'
+case "$NODE_BINARY" in
+  /*) ;;
+  *) NODE_BINARY="$(CDPATH= cd -- "$(dirname -- "$NODE_BINARY")" && pwd -P)/$(basename -- "$NODE_BINARY")" ;;
+esac
+require_node "$NODE_BINARY"
+# curl нужен проверке готовности и туннелю; в настольной Ubuntu его может не быть.
+for tool in curl awk ps; do
+  command -v "$tool" >/dev/null 2>&1 || fail "Не найдена команда $tool. Установите её (например: sudo apt install $tool) и повторите установку."
+done
+[ "$NO_SYSTEMD" = true ] || require_user_systemd
+# Стенд, уже установленный без суффикса меток, на другие метки не переводим: прежние службы остались бы включены.
+if [ -n "$LABEL_SUFFIX" ] && [ ! -e "$LABEL_SUFFIX_FILE" ]; then
+  for file in "$SERVICE_DIR"/ru.planfact.mvp.*.service; do
+    [ ! -f "$file" ] || fail 'Стенд уже установлен без суффикса меток. Уберите PLANFACT_LABEL_SUFFIX или выберите другую папку.'
+  done
+fi
+
+STAGE=''
+DIST_EXISTED=false
+[ ! -e "$PROJECT_ROOT/dist" ] || DIST_EXISTED=true
+cleanup() {
+  [ -z "$STAGE" ] || rm -rf -- "$STAGE"
+  # Сборка нужна только на время установки: в мастерской её не оставляем, иначе git видит лишнюю папку dist/.
+  [ "$DIST_EXISTED" = true ] || rm -rf -- "$PROJECT_ROOT/dist"
+}
+trap cleanup EXIT
+
+printf 'Собираю страницы и сервер для установки…\n'
+"$NODE_BINARY" "$PROJECT_ROOT/scripts/build-static.mjs"
+for directory in "$STAND" "$STAND/app" "$STAND/data" "$STAND/backups" "$STAND/backups/hourly" "$STAND/backups/daily" "$STAND/logs" "$STAND/codes" "$STAND/bin" "$SERVICE_DIR"; do
+  [ ! -L "$directory" ] || fail 'Каталоги стенда не должны быть символическими ссылками.'
+  mkdir -p -- "$directory"
+  chmod 700 "$directory"
+done
+STAND=$(CDPATH= cd -- "$STAND" && pwd -P)
+SERVICE_DIR="$STAND/systemd"
+export PLANFACT_HOME="$STAND"
+STAGE=$(mktemp -d "$STAND/.install.XXXXXX")
+
+mkdir -p "$STAGE/app/backend" "$STAGE/bin" "$STAGE/systemd"
+cp -R "$PROJECT_ROOT/dist/app" "$STAGE/app/app"
+cp -R "$PROJECT_ROOT/dist/backend/src" "$STAGE/app/backend/src"
+cp -R "$PROJECT_ROOT/dist/backend/migrations" "$STAGE/app/backend/migrations"
+cp "$PROJECT_ROOT/dist/backend/package.json" "$STAGE/app/backend/package.json"
+# Сначала общие скрипты Mac-версии, затем Linux-версии поверх них: одноимённый файл из deploy/linux заменяет общий.
+for script in "$BASE_DIR"/*.sh "$BASE_DIR"/*.mjs "$SCRIPT_DIR"/*.sh "$SCRIPT_DIR"/*.mjs; do
+  [ -f "$script" ] || continue
+  case "$(basename -- "$script")" in test-*.sh) continue ;; esac
+  cp "$script" "$STAGE/bin/"
+done
+find "$STAGE" -type d -exec chmod 700 {} +
+find "$STAGE" -type f -exec chmod 600 {} +
+chmod 700 "$STAGE/bin/"*.sh
+# В установленных скриптах не должно остаться обращений к инструментам macOS.
+MAC_ONLY='launchctl|osascript|fdesetup|plutil|LaunchAgents|caffeinate|open -e|stat -f|lsof|launchd/\.|nc .*-G '
+mac_files=''
+for script in "$STAGE/bin/"*.sh "$STAGE/bin/"*.mjs; do
+  # Сам установщик содержит этот список, поэтому его не проверяем.
+  [ "$(basename -- "$script")" != install.sh ] || continue
+  ! grep -q -E "$MAC_ONLY" "$script" || mac_files="$mac_files $(basename -- "$script")"
+done
+[ -z "$mac_files" ] || fail "В скриптах для Linux остались команды macOS: $mac_files"
+
+if [ ! -e "$STAND/config.env" ] && [ ! -L "$STAND/config.env" ]; then
+  "$NODE_BINARY" "$STAGE/bin/render-template.mjs" config "$SCRIPT_DIR/config.env.template" "$STAGE/config.env" "$STAND" "$NODE_BINARY"
+  mv "$STAGE/config.env" "$STAND/config.env"
+fi
+[ ! -L "$STAND/config.env" ] || fail 'config.env не должен быть символической ссылкой.'
+chmod 600 "$STAND/config.env"
+load_stand_config "$STAGE/app"
+# При повторной установке сохраняется и записанный в config.env путь к Node.
+for template in "$SCRIPT_DIR/systemd/"*.template "$SCRIPT_DIR/systemd/"*.template.manual; do
+  [ -f "$template" ] && [ -s "$template" ] || continue
+  # Когда рядом есть обычный шаблон, .manual — метка, а не второй шаблон.
+  if [[ "$template" = *.manual ]] && [ -f "${template%.manual}" ]; then
+    continue
+  fi
+  name=$(basename -- "$template")
+  name=${name%.manual}
+  unit=${name%.template}
+  base_label=$(agent_label "$unit")
+  label=$base_label$LABEL_SUFFIX
+  extension=${unit##*.}
+  # Суффикс стенда (если он задан) входит в имя файла службы; таймер по имени находит свою службу.
+  "$NODE_BINARY" "$STAGE/bin/render-template.mjs" unit "$template" "$STAGE/systemd/$label.$extension" "$STAND" "$PLAN_FACT_NODE_BIN"
+  if [ "$extension" = service ] && { [[ "$template" = *.manual ]] || [ -f "$template.manual" ]; }; then
+    : > "$STAGE/systemd/$label.manual"
+  fi
+done
+for file in "$STAGE/systemd/"*.timer; do
+  [ -f "$file" ] || continue
+  [ -f "${file%.timer}.service" ] || fail "У таймера $(basename -- "$file") нет своей службы."
+done
+
+STAGE_SERVICE_DIR="$STAGE/systemd"
+if [ "$NO_SYSTEMD" = false ]; then
+  # Службу другого стенда с той же меткой не перезаписываем и не останавливаем: так репетиция без своего
+  # суффикса не заменит службы настоящего стенда.
+  for file in "$STAGE_SERVICE_DIR/"*.service "$STAGE_SERVICE_DIR/"*.timer; do
+    [ -f "$file" ] || continue
+    unit=$(basename -- "$file")
+    if [ -e "$UNIT_DIR/$unit" ] && ! cmp -s -- "$UNIT_DIR/$unit" "$SERVICE_DIR/$unit" && ! cmp -s -- "$UNIT_DIR/$unit" "$file"; then
+      fail "В папке служб уже есть $unit другого стенда. Для второго стенда на этом компьютере задайте свой суффикс меток, например PLANFACT_LABEL_SUFFIX=.rehearsal."
+    fi
+  done
+  # Останавливаем прежние процессы до замены установленного кода.
+  stop_agents
+fi
+mv "$STAND/app" "$STAGE/old-app"
+mv "$STAGE/app" "$STAND/app"
+mv "$STAND/bin" "$STAGE/old-bin"
+mv "$STAGE/bin" "$STAND/bin"
+for file in "$STAGE_SERVICE_DIR/"*; do
+  [ -f "$file" ] || continue
+  cp "$file" "$SERVICE_DIR/"
+done
+for file in "$STAGE_SERVICE_DIR/"*.service; do
+  [ -f "$file" ] || continue
+  label=$(agent_label "$file")
+  if [ ! -f "$STAGE_SERVICE_DIR/$label.manual" ]; then
+    rm -f -- "$SERVICE_DIR/$label.manual"
+  fi
+done
+printf '%s\n' "$LABEL_SUFFIX" > "$LABEL_SUFFIX_FILE"
+
+if [ "$NO_SYSTEMD" = true ]; then
+  : > "$SERVICE_DIR/.no-systemd"
+  printf 'Проверочная установка: автозапуск не включён, службы сохранены внутри стенда.\n'
+else
+  rm -f -- "$SERVICE_DIR/.no-systemd"
+  mkdir -p -- "$UNIT_DIR"
+  for file in "$STAGE_SERVICE_DIR/"*.service "$STAGE_SERVICE_DIR/"*.timer; do
+    [ -f "$file" ] || continue
+    cp "$file" "$UNIT_DIR/$(basename -- "$file")"
+    chmod 600 "$UNIT_DIR/$(basename -- "$file")"
+  done
+  user_systemctl daemon-reload >/dev/null 2>&1 || fail 'systemd не принял файлы служб (daemon-reload).'
+  # Автозапуск после перезагрузки — у всех служб, кроме ручных (туннель включает enable-tunnel.sh).
+  for label in $(stand_labels); do
+    [ ! -f "$SERVICE_DIR/$label.manual" ] || continue
+    user_systemctl enable "$(agent_unit "$label")" >/dev/null 2>&1 || fail "Не удалось включить автозапуск службы $label."
+  done
+  if [ "$NO_START" = false ]; then
+    start_agents
+  else
+    printf 'Службы установлены. Запуск отложен по флагу --no-start.\n'
+  fi
+  # Без «linger» пользовательские службы работают, только пока пользователь вошёл в систему.
+  linger=$(loginctl show-user "$(id -un)" --property=Linger --value 2>/dev/null) || linger=''
+  if [ "$linger" != yes ]; then
+    printf 'Внимание: службы стенда запустятся после перезагрузки только когда вы войдёте в систему.\n'
+    printf 'Чтобы стенд поднимался сам, один раз выполните: sudo loginctl enable-linger %s\n' "$(id -un)"
+  fi
+fi
+printf 'Стенд установлен: %s\n' "$STAND"
