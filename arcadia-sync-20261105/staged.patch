+"use strict";
+
+const assert = require("node:assert/strict");
+const test = require("node:test");
+const { CorporateRoles, createTvmRolesSource } = require("../src/corporate-roles.js");
+
+function fixture({ maxFreshnessMs } = {}) {
+  let now = 1_800_000_000_000;
+  let raw = { systemSlug: "fixture-app", confirmedAt: now,
+    body: { revision: "r1", born_date: 1_700_000_000, tvm: {}, user: {
+      "101": { "/role/member/": [{}] }, "102": { "/role/admin/": [{}], "/role/member/": [{}] },
+      "103": { "/role/admin/": [{}] }, "104": { "/role/member/": [] },
+      "105": { "/role/superadmin/": [{}] }
+    } } };
+  const roles = new CorporateRoles({ systemSlug: "fixture-app", clock: () => now, maxFreshnessMs,
+    source: async () => { if (raw instanceof Error) throw raw; return structuredClone(raw); } });
+  return { roles, get raw() { return raw; }, set raw(value) { raw = value; }, advance(ms) { now += ms; }, get now() { return now; } };
+}
+
+test("CorporateRoles_UsesExactRolesAndUid_NotTvmOrEmptyAssignments", async () => {
+  const f = fixture();
+  f.raw.body.tvm = { "106": { "/role/admin/": [{}] } };
+  await f.roles.refresh();
+  assert.equal(f.roles.roleFor("101"), "member");
+  assert.equal(f.roles.roleFor("102"), "admin");
+  assert.equal(f.roles.roleFor("103"), "admin");
+  for (const uid of ["104", "105", "106", "999"]) assert.equal(f.roles.roleFor(uid), null);
+  assert.deepEqual(Object.keys(f.roles.diagnostics()).sort(), ["lastConfirmedAt", "maxFreshnessMs", "refreshMs", "status"]);
+});
+
+test("CorporateRoles_FullReplacementHandlesDowngradeAndEmptyExport", async () => {
+  const f = fixture();
+  await f.roles.refresh();
+  delete f.raw.body.user["102"]["/role/admin/"];
+  delete f.raw.body.user["103"];
+  await f.roles.refresh();
+  assert.equal(f.roles.roleFor("102"), "member");
+  assert.equal(f.roles.roleFor("103"), null);
+  f.raw.body.user = {};
+  await f.roles.refresh();
+  assert.equal(f.roles.roleFor("101"), null);
+});
+
+test("CorporateRoles_InvalidResponseFailsAtomicallyWithoutKeepingOldAdmin", async () => {
+  const invalid = [
+    (raw) => { raw.systemSlug = "another-app"; },
+    (raw) => { raw.body.user["103"]["/role/admin/"] = "admin"; },
+    (raw) => { raw.body.user["103"]["/role/admin/"] = [{ location: "office" }]; },
+    (raw) => { raw.body.user["103"] = []; },
+    (raw) => { raw.body.user = null; },
+    (raw) => { raw.body.revision = 1; },
+    (raw) => { raw.body.born_date = "yesterday"; },
+    (raw) => { raw.confirmedAt = undefined; },
+    (raw) => { raw.confirmedAt += 1; }
+  ];
+  for (const change of invalid) {
+    const f = fixture();
+    await f.roles.refresh();
+    change(f.raw);
+    await assert.rejects(f.roles.refresh(), { code: "corporate_roles_unavailable" });
+    assert.throws(() => f.roles.roleFor("103"), { statusCode: 503 });
+  }
+});
+
+test("CorporateRoles_NetworkFailureAndSleepCloseAccess_200DoesNotRenewConfirmation", async () => {
+  const f = fixture({ maxFreshnessMs: 300_000 });
+  assert.throws(() => f.roles.roleFor("101"), { statusCode: 503 });
+  await f.roles.refresh();
+  f.advance(60_001);
+  assert.throws(() => f.roles.roleFor("101"), { statusCode: 503 });
+  // Повторный успешный HTTP-ответ не меняет upstream confirmedAt.
+  await f.roles.refresh();
+  f.advance(240_000);
+  await assert.rejects(f.roles.refresh(), { statusCode: 503 });
+  f.raw.confirmedAt = f.now;
+  await f.roles.refresh();
+  f.raw = new Error("fake-secret-in-error");
+  await assert.rejects(f.roles.refresh(), (error) => error.statusCode === 503 && !error.message.includes("fake-secret"));
+  assert.equal(f.roles.diagnostics().status, "unavailable");
+});
+
+test("CorporateRoles_SerializesRefreshAndWaitsForSessionInvalidation", async () => {
+  let calls = 0;
+  let release;
+  const f = fixture();
+  f.roles.source = () => { calls += 1; return new Promise((resolve) => { release = () => resolve(f.raw); }); };
+  let applied = 0;
+  f.roles.subscribe(async () => { await Promise.resolve(); applied += 1; });
+  const a = f.roles.refresh();
+  const b = f.roles.refresh();
+  release();
+  await Promise.all([a, b]);
+  assert.equal(calls, 1);
+  assert.equal(applied, 1);
+});
+
+const sourceConfig = { baseUrl: "http://127.0.0.1:12345", selfAlias: "fixture", systemSlug: "fixture-app", localToken: "fixture-token" };
+test("CorporateRoles_TenMinuteConfirmationLimit_Repeated200DoesNotExtendIt", async () => {
+  const f = fixture();
+  const confirmedAt = f.now;
+  let responses = 0;
+  f.roles.source = createTvmRolesSource(sourceConfig, {
+    clock: () => f.now,
+    fetch: async () => { responses += 1; return new Response(JSON.stringify(f.raw.body)); },
+    verifyBinding: async () => true,
+    verifyFreshness: async () => confirmedAt
+  });
+  assert.equal(f.roles.diagnostics().maxFreshnessMs, 600_000);
+  assert.equal(fixture({ maxFreshnessMs: 600_000 }).roles.maxFreshnessMs, 600_000);
+  for (const maxFreshnessMs of [600_001, 601_000]) assert.throws(() => fixture({ maxFreshnessMs }));
+  await f.roles.refresh();
+  for (let elapsed = 30_000; elapsed <= 600_000; elapsed += 30_000) {
+    f.advance(30_000);
+    await f.roles.refresh();
+    assert.equal(f.roles.roleFor("103"), "admin");
+    assert.equal(f.roles.diagnostics().lastConfirmedAt, new Date(confirmedAt).toISOString());
+  }
+  f.advance(1_000);
+  assert.throws(() => f.roles.roleFor("103"), { statusCode: 503 });
+  await assert.rejects(f.roles.refresh(), { code: "corporate_roles_unavailable" });
+  assert.equal(responses, 22);
+  assert.equal(f.roles.diagnostics().status, "unavailable");
+  assert.equal(f.roles.diagnostics().lastConfirmedAt, new Date(confirmedAt).toISOString());
+});
+
+test("CorporateRoles_TenMinuteWindowStillRequiresUpstreamConfirmation", async () => {
+  for (const verifyFreshness of [undefined, async () => undefined]) {
+    const f = fixture();
+    await f.roles.refresh();
+    f.roles.source = createTvmRolesSource(sourceConfig, {
+      clock: () => f.now,
+      fetch: async () => new Response(JSON.stringify(f.raw.body)),
+      verifyBinding: async () => true,
+      verifyFreshness
+    });
+    await assert.rejects(f.roles.refresh(), { code: "corporate_roles_unavailable" });
+    assert.throws(() => f.roles.roleFor("103"), { statusCode: 503 });
+    assert.equal(f.roles.diagnostics().status, "unavailable");
+  }
+});
+
+test("TvmRolesSource_UsesAuthenticatedLoopbackDocumentedContractAndTrustedVerifier", async () => {
+  const f = fixture();
+  const source = createTvmRolesSource(sourceConfig, {
+    fetch: async (url, options) => {
+      assert.equal(String(url), "http://127.0.0.1:12345/v2/roles?self=fixture");
+      assert.equal(options.headers.Authorization, "fixture-token");
+      assert.equal(options.redirect, "error");
+      assert.ok(options.signal);
+      return new Response(JSON.stringify(f.raw.body));
+    },
+    verifyBinding: async (binding) => binding.selfAlias === "fixture" && binding.systemSlug === "fixture-app",
