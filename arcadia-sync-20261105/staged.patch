+"""Выдать личный код доступа (перенос issue-access-code из backend/src/cli.js).
+
+Код записывается в <PLAN_FACT_CODES_DIR>/<логин>.txt: каталог 700, файл 600, запись атомарная.
+На экран выводится только путь к файлу, сам код — никогда.
+"""
+
+from __future__ import annotations
+
+import os
+import secrets
+import stat
+import sys
+from pathlib import Path
+
+from django.conf import settings
+from django.core.management.base import BaseCommand
+
+from planfact import access_codes
+from planfact.errors import AppError
+
+
+def access_code_login(value: str) -> str:
+    """Логин становится именем файла, поэтому проверка строгая: без «/», «\\» и «..»."""
+    login = access_codes.normalize_staff_login(value)
+    if ".." in login:
+        raise AppError("Некорректный логин: «..» в логине недопустимо")
+    return login
+
+
+def access_code_file_path(directory: Path, login: str) -> Path:
+    target = directory / f"{login}.txt"
+    if target.parent != directory:
+        raise AppError("Некорректный логин: имя файла выходит за каталог кодов")
+    return target
+
+
+def ensure_codes_directory(directory: Path) -> None:
+    """Каталог кодов открывает только владелец: создаём с правами 700, иначе — исправляем."""
+    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
+    if stat.S_IMODE(directory.stat().st_mode) != 0o700:
+        os.chmod(directory, 0o700)
+
+
+def write_access_code_file(directory: Path, login: str, code: str) -> Path:
+    """Атомарная запись: временный файл 600 в том же каталоге, затем rename."""
+    target = access_code_file_path(directory, login)
+    temporary = directory / f".{login}.{secrets.token_hex(8)}.tmp"
+    text = f"{code}\nЛичный код доступа к тестовому стенду «План Факт» для {login}. Никому не пересылайте.\n"
+    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        os.fchmod(descriptor, 0o600)
+        os.write(descriptor, text.encode("utf-8"))
+        os.fsync(descriptor)
+    except BaseException:
+        os.close(descriptor)
+        temporary.unlink(missing_ok=True)
+        raise
+    os.close(descriptor)
+    try:
+        os.replace(temporary, target)
+    except BaseException:
+        temporary.unlink(missing_ok=True)
+        raise
+    return target
+
+
+class Command(BaseCommand):
+    help = "Выдать личный код доступа: issue_access_code <логин>"
+
+    def add_arguments(self, parser) -> None:
+        parser.add_argument("login")
+
+    def handle(self, *args, **options) -> None:
+        from planfact.runtime import get_service
+
+        try:
+            login = access_code_login(options["login"])
+            directory = settings.PLAN_FACT.codes_dir
+            service = get_service()
+            # Каталог готовим до выдачи: иначе из-за ошибки прав прежний код уже перестал бы работать, а нового нет.
+            ensure_codes_directory(directory)
+            issued = service.issue_access_code(login)
+            try:
+                path = write_access_code_file(directory, issued["login"], issued["code"])
+            except OSError as error:
+                raise AppError(
+                    f"Не удалось записать файл с кодом ({error.strerror or 'ошибка записи'}). "
+                    "Прежний код уже недействителен: выполните команду ещё раз"
+                ) from None
+        except AppError as error:
+            sys.stderr.write(f"{error.message}\n")
+            sys.exit(1)
+        self.stdout.write(f"{path}\n", ending="")
