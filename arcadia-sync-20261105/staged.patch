+            "alice": session_cookie_of(self.api.login("alice", self.codes["alice"]))[0],
+            "bob": session_cookie_of(self.api.login("bob", self.codes["bob"]))[0],
+            "erin": session_cookie_of(self.api.login("erin", erin_code))[0],
+        }
+        streams = {name: self.open_events(cookie) for name, cookie in cookies.items()}
+        try:
+            self.wait_until(lambda: all("event: ready" in stream["text"] for stream in streams.values()), "потоки не открылись")
+            # Новый код bob выдаёт команда в отдельном процессе — как владелец стенда.
+            database = connection.settings_dict["NAME"]
+            url = os.environ["PLAN_FACT_DATABASE_URL"].rsplit("/", 1)[0] + "/" + database
+            issued = subprocess.run(
+                [sys.executable, "manage.py", "issue_access_code", "bob"], cwd=BACKEND_DIR, capture_output=True, text=True,
+                env={**os.environ, "PLAN_FACT_DATABASE_URL": url, "PLAN_FACT_CODES_DIR": str(self.root / "codes")}, timeout=120,
+            )
+            self.assertEqual(issued.returncode, 0, issued.stderr)
+            self.wait_until(lambda: streams["bob"]["ended"], "поток bob должен закрыться после выдачи нового кода")
+            self.assertRegex(streams["bob"]["text"], r'event: session-ended\ndata: \{"reason":"session_closed"\}\n\n$')
+            archived = self.api.post("/api/mutate", {"type": "archiveAccount", "mutationId": "archive-erin-1",
+                                                     "payload": {"id": erin["id"], "archived": True}}, cookie=cookies["alice"])
+            self.assertEqual(archived.status, 200)
+            self.wait_until(lambda: streams["erin"]["ended"], "поток erin должен закрыться после отключения")
+            self.assertRegex(streams["erin"]["text"], r'event: session-ended\ndata: \{"reason":"session_closed"\}\n\n$')
+            self.wait_until(lambda: streams["alice"]["text"].count(": heartbeat") >= 3, "сигналы alice не приходят")
+            self.assertFalse(streams["alice"]["ended"])
+            renamed = self.api.post("/api/mutate", {"type": "updateLocation", "baseRevision": 0, "mutationId": "rename-stream-1",
+                                                    "payload": {"id": "default", "name": "Офис", "code": ""}}, cookie=cookies["alice"])
+            self.assertEqual(renamed.status, 200)
+            self.wait_until(lambda: "event: state-changed" in streams["alice"]["text"], "alice не получила событие")
+            self.assertNotIn("Алиса", streams["alice"]["text"], "событие не раскрывает, кто внёс изменение")
+            self.assertNotIn("state-changed", streams["bob"]["text"] + streams["erin"]["text"])
+        finally:
+            for stream in streams.values():
+                stream["connection"].close()
