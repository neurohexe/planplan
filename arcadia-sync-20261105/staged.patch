+function staleSessionService(calls, loginResult) {
+  const stale = { id: "stale-session", userId: "user-a", user: { name: "A", staff_uid: "uid-a" } };
+  return {
+    async sessionByToken(token, options) {
+      calls.push(["sessionByToken", token, options]);
+      return token === "stale-token" ? stale : null;
+    },
+    sessionMatchesIdentity(session, identity) {
+      return session.user.staff_uid === identity.uid;
+    },
+    async touchSession(session) {
+      calls.push(["touchSession", session.id]);
+      return session;
+    },
+    async logout(session, options) {
+      calls.push(["logout", session && session.id, options]);
+    },
+    async loginWithStaff(input) {
+      calls.push(["loginWithStaff", input.identity.uid, input.ip]);
+      return loginResult(input);
+    }
+  };
+}
