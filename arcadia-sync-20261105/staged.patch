+# Подменённая домашняя папка: LaunchAgents и «настоящий» ~/PlanFactMVP — только внутри теста.
+FAKE_HOME="$TEST_ROOT/home"
+AGENTS="$FAKE_HOME/Library/LaunchAgents"
+STUBS="$TEST_ROOT/stubs"
