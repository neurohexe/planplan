+        raise DomainError("Расход не найден")
+    validate_expense_payload(nxt, payload)
+    period_locks.assert_month_editable(nxt, _month_key(og(expense, "expenseDate")))
+    period_locks.assert_month_editable(nxt, _month_key(_p(payload, "expenseDate")))
+    article = _find(nxt["articles"], lambda item: strict_eq(og(item, "id"), _p(payload, "articleId")))
+    resolved = resolve_optional_subarticle(article, _p(payload, "subarticleId"))
