+"""Импорт бюджета из Excel — серверная часть app/budget-import.js.
+
+Разбор файла Excel выполняет браузер; на сервер приходят уже подготовленные строки. Здесь перенесены
+функции, которые применяют импорт к состоянию, и помощники, которыми пользуется normalizeState.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from typing import Any
+
+from planfact.errors import DomainError
+
+from . import dates, period_locks
+from .collation import ru_key
+from .context import now_ms
+from .js import (
+    JS_WS, S, UNDEF, add, clone, collapse_ws, entries, imul, is_dict, is_finite, is_list, is_number, is_str,
+    js_slice, js_trim, keys, map_get, og, or_, pk, sort_strings, spread, tail, to_base36, to_number, truthy, uniq,
+    values,
+)
+
+LEGACY_IMPORT_QUARTER = "2026-Q3"
+DEFAULT_PROJECT_ARTICLE_ID = "default"
+MONTH_ABBREVIATIONS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
+BUDGET_TYPES = ("opex", "capex")
+LEGACY_SAMPLE_PROJECTS = (
+    {"id": "cleaning", "name": "T_Уборка помещений"},
+    {"id": "equipment-rent", "name": "T_Аренда оборудования"},
+    {"id": "office-greening", "name": "T_Озеленение офиса"},
+    {"id": "food", "name": "Т_Продукты питания"},
+    {"id": "household-supplies", "name": "Т_Хоз инвентарь и расходные материалы"},
+    {"id": "furniture", "name": "T_Мебель и предметы интерьера"},
+    {"id": "furniture-main", "name": "T_Мебель и предметы интерьера (осн)"},
+    {"id": "other-office", "name": "Т_Прочие офисные расходы"},
+    {"id": "other-office-main", "name": "Т_Прочие офисные расходы (осн)"},
+    {"id": "navigation", "name": "Т_Навигация"},
+    {"id": "appliances", "name": "T_Бытовая техника"},
+    {"id": "secretariat", "name": "Т_Секретариат"},
+    {"id": "moving", "name": "T_Дост.гр.и расх.на переезд"},
+    {"id": "repairs-main", "name": "Т_Ремонтные работы (осн)"},
+)
+LEGACY_SAMPLE_BY_ID = {project["id"]: project for project in LEGACY_SAMPLE_PROJECTS}
+
+_CURRENCY_RE = re.compile(r"[A-Z]{3}\Z")
+_QUARTER_RE = re.compile(r"([0-9]{4})-Q([1-4])\Z")
+_CAPEX_SUFFIX_RE = re.compile(r"\(осн\)" + JS_WS + r"*\Z", re.IGNORECASE)
+_RESPONSIBLE_ALIASES = ("лилит", "степанян лилит", "лилит степанян")
+
+
+def clean_text(value: Any, max_length: int = 160) -> str:
+    return js_slice(collapse_ws(js_trim(value)), 0, max_length) if is_str(value) else ""
+
+
+def normalize_currency_code(value: Any) -> str:
+    code = clean_text(value, 3).upper()
+    return code if _CURRENCY_RE.match(code) else ""
+
+
+def normalize_budget_type(value: Any) -> str:
+    kind = S(or_(value, "")).lower()
+    return kind if kind in BUDGET_TYPES else ""
+
+
+def lower_ru(text: str) -> str:
+    """.normalize("NFKC").toLocaleLowerCase("ru-RU")."""
+    return unicodedata.normalize("NFKC", text).lower()
+
+
+def normalize_responsible_name(value: Any) -> str:
+    name = clean_text(value, 80)
+    if lower_ru(name) in _RESPONSIBLE_ALIASES:
+        return "Лилит Степанян"
+    return name
+
+
+def comparison_key(value: Any) -> str:
+    return lower_ru(clean_text(value))
+
+
+def normalize_code(value: Any) -> str:
+    return clean_text(value, 80).upper()
+
+
+def normalize_quarter_key(value: Any) -> str:
+    match = _QUARTER_RE.match(S(or_(value, "")))
+    return f"{match.group(1)}-Q{match.group(2)}" if match else ""
+
+
+def quarter_months(quarter_key: Any) -> list[dict]:
+    normalized = normalize_quarter_key(quarter_key)
+    if not normalized:
+        return []
+    year_part, quarter_part = normalized.split("-Q")
+    year = to_number(year_part)
+    first_month = (to_number(quarter_part) - 1) * 3 + 1
+    result = []
+    for offset in (0, 1, 2):
+        month = first_month + offset
+        result.append({
+            "key": f"{S(year)}-{S(month).rjust(2, '0')}",
+            "label": f"{MONTH_ABBREVIATIONS[month - 1]} {S(year)[-2:]}",
+        })
+    return result
+
+
+def ensure_capex_suffix(value: Any) -> str:
+    name = clean_text(value, 120) or "Проект"
+    return name if _CAPEX_SUFFIX_RE.search(name) else f"{name} (осн)"
+
+
+def display_project_name(kind: str, value: Any) -> str:
+    name = clean_text(value, 120) or "Проект"
+    return ensure_capex_suffix(name) if kind == "capex" else name
+
+
+def normalize_imported_exchange_rates(value: Any) -> dict:
+    normalized: dict = {}
+    if not truthy(value) or not (is_dict(value) or is_list(value)):
+        return normalized
+    for currency, entry in entries(value):
+        code = normalize_currency_code(currency)
+        rate = to_number(entry if is_number(entry) else og(entry, "rateToRub"))
+        if not code or code == "RUB" or not is_finite(rate) or rate <= 0:
+            continue
+        normalized[code] = {"rateToRub": rate, "direction": "currencyToRub"}
+    return normalized
+
+
+def choose_canonical_names(rows: list[dict], key_selector, name_selector) -> dict:
+    names_by_key: dict = {}
+    for row in rows:
+        key = key_selector(row)
+        name = clean_text(name_selector(row), 120)
+        variants = names_by_key.setdefault(key, {})
+        spellings = variants.setdefault(comparison_key(name), {})
+        spellings[name] = spellings.get(name, 0) + 1
+    chosen: dict = {}
+    conflicts = []
+    for key, variants in names_by_key.items():
+        options = []
+        for semantic, spellings in variants.items():
+            ordered = sorted(spellings.items(), key=lambda item: -item[1])
+            options.append({"semantic": semantic, "name": ordered[0][0], "count": sum(count for _, count in ordered)})
+        options.sort(key=lambda item: -item["count"])
+        chosen[key] = options[0]["name"]
+        if len(options) > 1:
+            conflicts.append({"key": key, "names": [item["name"] for item in options], "chosen": options[0]["name"]})
+    return {"chosen": chosen, "conflicts": conflicts}
+
+
+def _ru_sort(names: list[str]) -> list[str]:
+    return sorted(names, key=ru_key)
+
+
+def sanitize_import_rows(raw_rows: Any, quarter_key: Any) -> dict:
+    if not is_list(raw_rows):
+        raise DomainError("В импорте отсутствуют строки бюджета")
+    normalized_quarter = normalize_quarter_key(quarter_key)
+    if not normalized_quarter:
+        raise DomainError("Выберите корректный период импорта")
+    import_months = quarter_months(normalized_quarter)
+    month_keys_all = [month["key"] for month in import_months]
+    rows = []
+    for row in raw_rows:
+        months_value = og(row, "months")
+        has_months = truthy(months_value) and is_dict(months_value)
+        month_keys = list(months_value.keys()) if has_months else []
+        months_match = has_months and len(month_keys) == len(import_months) and all(
+            month_key in month_keys_all for month_key in month_keys
+        )
+        months = (
+            {month["key"]: to_number(months_value.get(month["key"], UNDEF)) for month in import_months}
+            if has_months and months_match else None
+        )
+        if months is not None:
+            amount: Any = 0
+            for month in import_months:
+                amount = add(amount, months[month["key"]])
+        else:
+            amount = to_number(og(row, "amount"))
+        project_name = clean_text(og(row, "projectName"), 120)
+        budget_type = normalize_budget_type(og(row, "budgetType"))
+        groups_source = og(row, "responsibleGroups")
+        responsible = uniq(
+            name for name in (normalize_responsible_name(item) for item in (
+                groups_source if is_list(groups_source) else [og(row, "responsibleGroup")]
+            )) if name
+        )
+        rows.append({
+            "budgetType": budget_type,
+            "locationCode": normalize_code(og(row, "locationCode")),
+            "locationName": clean_text(og(row, "locationName"), 120),
+            "projectCode": normalize_code(og(row, "projectCode")),
+            "projectName": project_name,
+            "projectArticleName": clean_text(og(row, "projectArticleName"), 120) or display_project_name(budget_type, project_name),
+            "responsibleGroups": _ru_sort(responsible),
+            "serviceName": clean_text(og(row, "serviceName"), 120),
+            "legalEntity": clean_text(og(row, "legalEntity"), 160),
+            "cfoName": clean_text(og(row, "cfoName"), 160),
+            "currency": normalize_currency_code(og(row, "currency")),
+            "amount": amount,
+            "months": months,
+            "monthsMatchQuarter": months_match,
+        })
+
+    def invalid(row: dict) -> bool:
+        if (not row["budgetType"] or not row["locationCode"] or not row["locationName"] or not row["projectCode"]
+                or not row["projectName"] or not row["projectArticleName"] or not row["currency"]):
+            return True
+        if not is_finite(row["amount"]) or row["amount"] < 0:
+            return True
+        if not row["monthsMatchQuarter"]:
+            return True
+        if row["months"] is not None and any(not is_finite(amount) or amount < 0 for amount in row["months"].values()):
+            return True
+        return False
+
+    if any(invalid(row) for row in rows):
+        raise DomainError("В подготовленных данных Excel есть некорректная строка")
+    if not rows:
+        raise DomainError("В листах OPEX и CAPEX не найдено строк бюджета")
+    for row in rows:
+        del row["monthsMatchQuarter"]
+
+    locations = choose_canonical_names(rows, lambda row: row["locationCode"], lambda row: row["locationName"])
+    projects = choose_canonical_names(
+        rows, lambda row: f"{row['budgetType']}:{row['projectCode']}",
+        lambda row: display_project_name(row["budgetType"], row["projectName"]),
+    )
+    project_articles = choose_canonical_names(
+        rows, lambda row: f"{row['budgetType']}:{row['projectCode']}:{comparison_key(row['projectArticleName'])}",
+        lambda row: row["projectArticleName"],
+    )
+
+    def attribute_key(row: dict) -> str:
+        return f"{row['budgetType']}|{row['locationCode']}|{row['projectCode']}"
+
+    services = choose_canonical_names(rows, attribute_key, lambda row: row["serviceName"])
+    legal_entities = choose_canonical_names(rows, attribute_key, lambda row: row["legalEntity"])
+    cfo_names = choose_canonical_names(rows, attribute_key, lambda row: row["cfoName"])
+    grouped: dict = {}
+    for row in rows:
+        project_key = f"{row['budgetType']}:{row['projectCode']}"
+        article_key = f"{project_key}:{comparison_key(row['projectArticleName'])}"
+        attr_key = attribute_key(row)
+        key = f"{row['budgetType']}|{row['locationCode']}|{row['projectCode']}|{row['currency']}|{comparison_key(row['projectArticleName'])}"
+        if key not in grouped:
+            grouped[key] = {
+                "budgetType": row["budgetType"],
+                "locationCode": row["locationCode"],
+                "locationName": map_get(locations["chosen"], row["locationCode"]),
+                "projectCode": row["projectCode"],
+                "projectName": map_get(projects["chosen"], project_key),
+                "projectArticleName": map_get(project_articles["chosen"], article_key),
+                "serviceName": or_(map_get(services["chosen"], attr_key), ""),
+                "legalEntity": or_(map_get(legal_entities["chosen"], attr_key), ""),
+                "cfoName": or_(map_get(cfo_names["chosen"], attr_key), ""),
+                "responsibleGroups": {},
+                "currency": row["currency"],
+                "amount": 0,
+                "months": {month["key"]: 0 for month in import_months} if row["months"] is not None else None,
+                "hasMonthlyRows": False,
+                "hasLegacyRows": False,
+            }
+        target = grouped[key]
+        target["amount"] = add(target["amount"], row["amount"])
+        for name in row["responsibleGroups"]:
+            target["responsibleGroups"][name] = True
+        if row["months"] is not None:
+            target["hasMonthlyRows"] = True
+            if target["months"] is None:
+                target["months"] = {month["key"]: 0 for month in import_months}
+            for month in import_months:
+                target["months"][month["key"]] = add(target["months"][month["key"]], row["months"][month["key"]])
+        else:
+            target["hasLegacyRows"] = True
+    if any(item["hasMonthlyRows"] and item["hasLegacyRows"] for item in grouped.values()):
+        raise DomainError("Нельзя смешивать квартальные и помесячные строки одного проекта")
+    groups = []
+    for item in grouped.values():
+        row = {key: value for key, value in item.items() if key not in ("hasMonthlyRows", "hasLegacyRows")}
+        row["responsibleGroups"] = _ru_sort(list(row["responsibleGroups"].keys()))
+        if row["months"] is not None:
+            total: Any = 0
+            for month in import_months:
+                total = add(total, row["months"][month["key"]])
+            row["amount"] = total
+        groups.append(row)
+    groups.sort(key=lambda row: (ru_key(row["locationName"]), row["budgetType"], ru_key(row["projectName"]), row["currency"]))
+    return {"groups": groups, "locationConflicts": locations["conflicts"], "projectConflicts": projects["conflicts"]}
+
+
+def current_location_by_code(state: dict, code: str) -> list:
+    return [location for location in or_(state.get("locations", UNDEF), []) if normalize_code(og(location, "code")) == code]
+
+
+def current_article_by_identity(state: dict, budget_type: str, code: str) -> list:
+    return [
+        article for article in or_(state.get("articles", UNDEF), [])
+        if normalize_budget_type(og(article, "budgetType")) == budget_type and normalize_code(og(article, "code")) == code
+    ]
+
+
+def current_project_article_by_name(project: Any, name: Any) -> Any:
+    key = comparison_key(name)
+    for item in or_(og(project, "subarticles"), []):
+        if comparison_key(og(item, "name")) == key:
+            return item
+    return None
+
+
+def fnv_hash(text: str, seed: int = 2166136261) -> int:
+    value = seed & 0xFFFFFFFF
+    for ch in text:
+        value = (value ^ ord(ch)) & 0xFFFFFFFF
+        value = imul(value, 16777619) & 0xFFFFFFFF
+    return value
+
+
+def stable_project_article_id(name: Any, used_ids: set) -> str:
+    normalized = comparison_key(name) or "article"
+    base = f"excel:{to_base36(fnv_hash(normalized))}"
+    if base not in used_ids:
+        return base
+    suffix = 2
+    while f"{base}:{suffix}" in used_ids:
+        suffix += 1
+    return f"{base}:{suffix}"
+
+
+def _ids_of(items: list) -> set:
+    result = set()
+    for item in items:
+        identifier = og(item, "id")
+        try:
+            result.add(identifier)
+        except TypeError:
+            pass
+    return result
+
+
+def ensure_imported_project_article(project: dict, name: Any) -> dict:
+    if not truthy(project.get("subarticles", UNDEF)):
+        project["subarticles"] = []
+    article_name = clean_text(name, 120) or clean_text(project.get("name", UNDEF), 120) or "Основная статья"
+    existing = current_project_article_by_name(project, article_name)
+    if existing is not None:
+        existing["archived"] = False
+        existing["code"] = clean_text(project.get("code", UNDEF), 80)
+        return existing
+    if comparison_key(article_name) == comparison_key(project.get("name", UNDEF)) and not any(
+        og(item, "id") == DEFAULT_PROJECT_ARTICLE_ID for item in project["subarticles"]
+    ):
+        return create_default_project_article(project, {"name": article_name})
+    used_ids = _ids_of(project["subarticles"])
+    project_article = {
+        "id": stable_project_article_id(article_name, used_ids),
+        "name": article_name,
+        "code": clean_text(project.get("code", UNDEF), 80),
+        "archived": False,
+    }
+    project["subarticles"].append(project_article)
+    return project_article
+
+
+def budget_currency_object(value: Any) -> dict:
+    if not truthy(value) or not is_dict(value):
+        return {}
+    return value
+
+
+monthly_budget_currency_object = budget_currency_object
+
+
+def project_article_item_key(project_id: Any, project_article_id: Any) -> str:
+    return f"{S(project_id)}|{S(project_article_id)}"
+
+
+def next_project_article_id(project: dict, preferred_id: str = DEFAULT_PROJECT_ARTICLE_ID) -> str:
+    used = _ids_of(or_(project.get("subarticles", UNDEF), []))
+    if preferred_id not in used:
+        return preferred_id
+    suffix = 2
+    while f"{preferred_id}-{suffix}" in used:
+        suffix += 1
+    return f"{preferred_id}-{suffix}"
+
+
+def create_default_project_article(project: dict, options: dict | None = None) -> dict:
+    options = options or {}
+    if not truthy(project.get("subarticles", UNDEF)):
+        project["subarticles"] = []
+    preferred_id = clean_text(options.get("id", UNDEF), 80) or DEFAULT_PROJECT_ARTICLE_ID
+    existing = next((item for item in project["subarticles"] if og(item, "id") == preferred_id), None)
+    if existing is not None and options.get("forceNew") is not True:
+        existing["archived"] = False
+        return existing
+    project_article = {
+        "id": next_project_article_id(project, preferred_id),
+        "name": clean_text(options.get("name", UNDEF), 120) or clean_text(project.get("name", UNDEF), 120) or "Основная статья",
+        "code": clean_text(project.get("code", UNDEF), 80),
+        "archived": False,
+    }
+    project["subarticles"].append(project_article)
+    return project_article
+
+
+def has_nested_project_article_references(state: dict, project_id: Any, project_article_id: Any) -> bool:
+    item_key = project_article_item_key(project_id, project_article_id)
+    has_budget = False
+    for collection in (state.get("budgets", UNDEF), state.get("monthlyBudgets", UNDEF)):
+        for store in values(or_(collection, {})):
+            if truthy(store) and (is_dict(store) or is_list(store)) and len(keys(or_(og(store, item_key), {}))) > 0:
+                has_budget = True
+    has_expense = any(
+        og(expense, "articleId") == project_id and og(expense, "subarticleId") == project_article_id
+        for expense in or_(state.get("expenses", UNDEF), []) if truthy(expense)
+    )
+    has_forecast = any(
+        truthy(allocation) and og(allocation, "articleId") == project_id and og(allocation, "subarticleId") == project_article_id
+        for ticket in or_(state.get("forecastTickets", UNDEF), [])
+        for allocation in or_(og(ticket, "allocations"), [])
+    )
+    return has_budget or has_expense or has_forecast
+
+
+def _store_items(collection: Any) -> list:
+    return values(or_(collection, {}))
+
+
+def ensure_project_article_hierarchy(state: Any, options: dict | None = None) -> dict:
+    options = options or {}
+    if not truthy(state) or not is_dict(state):
+        return {"created": 0, "migratedBudgets": 0, "migratedExpenses": 0, "migratedForecasts": 0}
+    for key, default in (("articles", []), ("budgets", {}), ("monthlyBudgets", {}), ("expenses", []), ("forecastTickets", [])):
+        if not truthy(state.get(key, UNDEF)):
+            state[key] = default
+    created = migrated_budgets = migrated_expenses = migrated_forecasts = 0
+    # Ускорение без изменения смысла: корневые суммы проекта (ключ = id проекта) бывают только в старых
+    # данных, поэтому хранилища перебираются лишь для проектов, чей id вообще встречается среди ключей.
+    root_keys: set = set()
+    for collection in ("budgets", "monthlyBudgets"):
+        for store in _store_items(state[collection]):
+            if truthy(store) and (is_dict(store) or is_list(store)):
+                root_keys.update(keys(store))
+    for project in state["articles"]:
+        subarticles = project.get("subarticles", UNDEF)
+        project["subarticles"] = subarticles if is_list(subarticles) else []
+        for project_article in project["subarticles"]:
+            project_article["code"] = clean_text(project.get("code", UNDEF), 80)
+        project_id = project.get("id", UNDEF)
+        project_key = pk(project_id)
+        has_root = project_key in root_keys
+        root_budget_stores = [
+            store for store in _store_items(state["budgets"])
+            if truthy(store) and (is_dict(store) or is_list(store)) and len(keys(or_(og(store, project_key), {}))) > 0
+        ] if has_root else []
+        root_monthly_stores = [
+            store for store in _store_items(state["monthlyBudgets"])
+            if truthy(store) and (is_dict(store) or is_list(store)) and len(keys(or_(og(store, project_key), {}))) > 0
+        ] if has_root else []
+        migrate_root = options.get("migrateRootTransactions") is not False
+        root_expenses = [
+            expense for expense in state["expenses"]
+            if truthy(expense) and og(expense, "articleId") == project_id and not truthy(og(expense, "subarticleId"))
+        ] if migrate_root else []
+        root_forecasts = [
+            allocation for ticket in state["forecastTickets"] for allocation in or_(og(ticket, "allocations"), [])
+            if truthy(allocation) and og(allocation, "articleId") == project_id and not truthy(og(allocation, "subarticleId"))
+        ] if migrate_root else []
+        needs_migration = bool(root_budget_stores or root_monthly_stores or root_expenses or root_forecasts)
+        active_articles = [item for item in project["subarticles"] if not truthy(og(item, "archived"))]
+        target = next((item for item in project["subarticles"] if og(item, "id") == DEFAULT_PROJECT_ARTICLE_ID), None)
+        if target is None and (needs_migration or not active_articles):
+            target = create_default_project_article(project)
+            created += 1
+        elif target is not None and truthy(og(target, "archived")) and not active_articles:
+            target["archived"] = False
+        if needs_migration and target is not None and has_nested_project_article_references(state, project_id, target.get("id", UNDEF)):
+            target = create_default_project_article(project, {
+                "id": "legacy",
+                "name": f"{clean_text(project.get('name', UNDEF), 100) or 'Проект'} — ранее без статьи",
+                "forceNew": True,
+            })
+            created += 1
+        if needs_migration and target is None:
+            target = create_default_project_article(project)
+            created += 1
+        if target is not None:
+            item_key = project_article_item_key(project_id, target.get("id", UNDEF))
+            for store in root_budget_stores:
+                store[item_key] = og(store, project_key)
+                root_keys.add(item_key)
+                migrated_budgets += 1
+            for store in root_monthly_stores:
+                store[item_key] = og(store, project_key)
+                root_keys.add(item_key)
+                migrated_budgets += 1
+            for expense in root_expenses:
+                expense["subarticleId"] = target.get("id", UNDEF)
+                migrated_expenses += 1
+            for allocation in root_forecasts:
+                allocation["subarticleId"] = target.get("id", UNDEF)
+                migrated_forecasts += 1
+        if has_root:
+            for store in _store_items(state["budgets"]):
+                if truthy(store) and is_dict(store):
+                    store.pop(project_key, None)
+            for store in _store_items(state["monthlyBudgets"]):
+                if truthy(store) and is_dict(store):
+                    store.pop(project_key, None)
+    return {"created": created, "migratedBudgets": migrated_budgets, "migratedExpenses": migrated_expenses,
+            "migratedForecasts": migrated_forecasts}
+
+
+def prune_unused_imported_project_defaults(state: Any) -> int:
+    if not truthy(state) or not is_dict(state):
+        return 0
+    removed = 0
+    for project in or_(state.get("articles", UNDEF), []):
+        if og(project, "imported") is not True or not is_list(og(project, "subarticles")):
+            continue
+        default_article = next((item for item in project["subarticles"] if og(item, "id") == DEFAULT_PROJECT_ARTICLE_ID), None)
+        detailed = [
+            item for item in project["subarticles"]
+            if og(item, "id") != DEFAULT_PROJECT_ARTICLE_ID and og(item, "archived") is not True
+        ]
+        if default_article is None or not detailed:
+            continue
+        if has_nested_project_article_references(state, project.get("id", UNDEF), default_article.get("id", UNDEF)):
+            continue
+        project["subarticles"] = [item for item in project["subarticles"] if og(item, "id") != DEFAULT_PROJECT_ARTICLE_ID]
+        removed += 1
+    return removed
+
+
+def has_budget_amount(value: Any) -> bool:
+    if is_number(value):
+        return is_finite(value) and value != 0
+    return any(is_finite(to_number(amount)) and to_number(amount) != 0 for amount in values(budget_currency_object(value)))
+
+
+def has_monthly_budget_amount(value: Any) -> bool:
+    for months in values(budget_currency_object(value)):
+        if truthy(months) and is_dict(months) and any(
+            is_finite(to_number(amount)) and to_number(amount) != 0 for amount in months.values()
+        ):
+            return True
+    return False
+
+
+def legacy_sample_for(article: Any) -> Any:
+    sample = map_get(LEGACY_SAMPLE_BY_ID, og(article, "id"), None)
+    if sample is None:
+        return None
+    if normalize_budget_type(og(article, "budgetType")) or og(article, "imported") is True:
+        return None
+    return sample
+
+
+def imported_target_for_sample(articles: list, sample: dict, source: Any) -> Any:
+    source_names = {name for name in (comparison_key(og(source, "name")), comparison_key(sample["name"])) if name}
+    candidates = [
+        article for article in articles
+        if og(article, "id") != og(source, "id")
+        and normalize_budget_type(og(article, "budgetType"))
+        and normalize_code(og(article, "code"))
+        and comparison_key(og(article, "name")) in source_names
+    ]
+    expected_type = "capex" if _CAPEX_SUFFIX_RE.search(clean_text(og(source, "name")) or sample["name"]) else "opex"
+    preferred = [article for article in candidates if normalize_budget_type(og(article, "budgetType")) == expected_type]
+    if len(preferred) == 1:
+        return preferred[0]
+    return candidates[0] if len(candidates) == 1 else None
+
+
+def cleanup_legacy_sample_projects(state: Any) -> dict:
+    if not truthy(state) or not is_dict(state):
+        return {"removed": 0, "remapped": 0, "preserved": 0}
+    for key, default in (("articles", []), ("expenses", []), ("forecastTickets", []), ("budgets", {}), ("monthlyBudgets", {})):
+        if not truthy(state.get(key, UNDEF)):
+            state[key] = default
+    removed_ids: dict = {}
+    remapped = 0
+    preserved = 0
+    for article in state["articles"]:
+        sample = legacy_sample_for(article)
+        if sample is None:
+            continue
+        target = imported_target_for_sample(state["articles"], sample, article)
+        article_id = og(article, "id")
+        article_key = pk(article_id)
+        linked_expenses = [expense for expense in state["expenses"] if og(expense, "articleId") == article_id]
+        linked_forecasts = [
+            allocation for ticket in state["forecastTickets"] for allocation in or_(og(ticket, "allocations"), [])
+            if og(allocation, "articleId") == article_id
+        ]
+        has_detailed_expense = any(truthy(og(expense, "subarticleId")) for expense in linked_expenses)
+        has_detailed_forecast = any(truthy(og(allocation, "subarticleId")) for allocation in linked_forecasts)
+        has_root_budget = False
+        has_detailed_budget = False
+        for store in _store_items(state["budgets"]):
+            if not truthy(store) or not (is_dict(store) or is_list(store)):
+                continue
+            if has_budget_amount(og(store, article_key)):
+                has_root_budget = True
+            for item_key, value in entries(store):
+                if item_key.startswith(f"{article_key}|") and has_budget_amount(value):
+                    has_detailed_budget = True
+        for store in _store_items(state["monthlyBudgets"]):
+            if not truthy(store) or not (is_dict(store) or is_list(store)):
+                continue
+            if has_monthly_budget_amount(og(store, article_key)):
+                has_root_budget = True
+            for item_key, value in entries(store):
+                if item_key.startswith(f"{article_key}|") and has_monthly_budget_amount(value):
+                    has_detailed_budget = True
+        has_references = bool(linked_expenses or linked_forecasts or has_root_budget or has_detailed_budget)
+        if target is None and has_references:
+            preserved += 1
+            continue
+        if target is not None and (has_detailed_expense or has_detailed_forecast or has_detailed_budget):
+            preserved += 1
+            continue
+        if target is not None:
+            target_id = og(target, "id")
+            target_key = pk(target_id)
+            for expense in linked_expenses:
+                expense["articleId"] = target_id
+                expense["subarticleId"] = None
+                remapped += 1
+            for allocation in linked_forecasts:
+                allocation["articleId"] = target_id
+                allocation["subarticleId"] = None
+                remapped += 1
+            for collection in ("budgets", "monthlyBudgets"):
+                for store in _store_items(state[collection]):
+                    if not truthy(store) or not is_dict(store):
+                        continue
+                    source_amounts = budget_currency_object(store.get(article_key, UNDEF))
+                    target_amounts = budget_currency_object(store.get(target_key, UNDEF))
+                    if source_amounts or target_amounts:
+                        merged = {**source_amounts, **target_amounts}
+                        if merged:
+                            store[target_key] = merged
+                    store.pop(article_key, None)
+        removed_ids[article_key] = True
+    if removed_ids:
+        state["articles"] = [article for article in state["articles"] if pk(og(article, "id")) not in removed_ids]
+        for collection in ("budgets", "monthlyBudgets"):
+            for store in _store_items(state[collection]):
+                if not truthy(store) or not is_dict(store):
+                    continue
+                for item_key in list(store.keys()):
+                    if item_key.split("|")[0] in removed_ids:
+                        del store[item_key]
+    return {"removed": len(removed_ids), "remapped": remapped, "preserved": preserved}
+
+
+def build_budget_import_preview(state: dict, raw_rows: Any, meta: dict) -> dict:
+    quarter_key = normalize_quarter_key(meta.get("quarterKey", UNDEF))
+    if not quarter_key:
+        raise DomainError("Выберите период импорта")
+    period_closed = period_locks.is_quarter_closed(state, quarter_key) or any(
+        period_locks.is_month_closed(state, month_key) for month_key in period_locks.quarter_months(quarter_key)
+    )
+    sanitized = sanitize_import_rows(raw_rows, quarter_key)
+    groups = sanitized["groups"]
+    active_groups = [row for row in groups if row["amount"] != 0]
+    location_codes = uniq(row["locationCode"] for row in groups)
+    project_keys = uniq(f"{row['budgetType']}:{row['projectCode']}" for row in groups)
+    project_article_keys = uniq(
+        f"{row['budgetType']}:{row['projectCode']}:{comparison_key(row['projectArticleName'])}" for row in groups
+    )
+    responsibles = uniq(name for row in groups for name in row["responsibleGroups"])
+    services = uniq(row["serviceName"] for row in groups if row["serviceName"])
+    legal_entities = uniq(row["legalEntity"] for row in groups if row["legalEntity"])
+    cfo_values = uniq(row["cfoName"] for row in groups if row["cfoName"])
+    currencies = sort_strings(uniq(row["currency"] for row in groups))
+    new_locations = 0
+    new_projects = 0
+    new_project_article_keys: dict = {}
+    replaced_values = 0
+    existing_conflicts = []
+    for code in location_codes:
+        matches = current_location_by_code(state, code)
+        if len(matches) > 1:
+            raise DomainError(f"В приложении несколько локаций с кодом {code}")
+        if not matches:
+            new_locations += 1
+        else:
+            incoming = next((row["locationName"] for row in groups if row["locationCode"] == code), None)
+            if incoming and comparison_key(og(matches[0], "name")) != comparison_key(incoming):
+                existing_conflicts.append({"kind": "location", "key": code, "names": [og(matches[0], "name"), incoming],
+                                           "chosen": og(matches[0], "name")})
+    for key in project_keys:
+        separator = key.index(":")
+        kind = key[:separator]
+        code = key[separator + 1:]
+        matches = current_article_by_identity(state, kind, code)
+        if len(matches) > 1:
+            raise DomainError(f"В приложении несколько проектов {kind.upper()} с кодом {code}")
+        if not matches:
+            new_projects += 1
+        else:
+            incoming = next((row["projectName"] for row in groups if row["budgetType"] == kind and row["projectCode"] == code), None)
+            if incoming and comparison_key(og(matches[0], "name")) != comparison_key(incoming):
+                existing_conflicts.append({"kind": "project", "key": key, "names": [og(matches[0], "name"), incoming],
+                                           "chosen": incoming})
+    for row in groups:
+        project = next(iter(current_article_by_identity(state, row["budgetType"], row["projectCode"])), None)
+        if project is None or current_project_article_by_name(project, row["projectArticleName"]) is None:
+            new_project_article_keys[f"{row['budgetType']}:{row['projectCode']}:{comparison_key(row['projectArticleName'])}"] = True
+    checked: dict = {}
+    for row in groups:
+        location = next(iter(current_location_by_code(state, row["locationCode"])), None)
+        article = next(iter(current_article_by_identity(state, row["budgetType"], row["projectCode"])), None)
+        store = og(og(state, "budgets"), f"{S(og(location, 'id'))}|{quarter_key}") if location is not None else None
+        replacement_key = f"{row['locationCode']}:{row['budgetType']}:{row['projectCode']}:{row['currency']}"
+        if replacement_key in checked:
+            continue
+        checked[replacement_key] = True
+        article_key = pk(og(article, "id")) if article is not None else ""
+        has_existing = article is not None and any(
+            (item_key == article_key or item_key.startswith(f"{article_key}|"))
+            and row["currency"] in budget_currency_object(amounts)
+            for item_key, amounts in entries(or_(store, {}))
+        )
+        if has_existing:
+            replaced_values += 1
+    amounts_by_currency: dict = {}
+    for row in groups:
+        amounts_by_currency[row["currency"]] = add(or_(amounts_by_currency.get(row["currency"], UNDEF), 0), row["amount"])
+    conflicts = [
+        *({"kind": "location", **item} for item in sanitized["locationConflicts"]),
+        *({"kind": "project", **item} for item in sanitized["projectConflicts"]),
+        *existing_conflicts,
+    ]
+    source_rows = to_number(meta.get("sourceRows", UNDEF))
+    return {
+        "quarterKey": quarter_key,
+        "periodClosed": bool(period_closed),
+        "sourceFile": clean_text(or_(meta.get("sourceFile", UNDEF), "budget.xlsx"), 200),
+        "rows": groups,
+        "conflicts": conflicts,
+        "stats": {
+            "sourceRows": source_rows if truthy(source_rows) else len(raw_rows),
+            "groups": len(groups),
+            "nonZeroGroups": len(active_groups),
+            "locations": len(location_codes),
+            "projects": len(project_keys),
+            "projectArticles": len(project_article_keys),
+            "responsibles": len(responsibles),
+            "services": len(services),
+            "legalEntities": len(legal_entities),
+            "cfoValues": len(cfo_values),
+            "nonZeroLocations": len(uniq(row["locationCode"] for row in active_groups)),
+            "nonZeroProjects": len(uniq(f"{row['budgetType']}:{row['projectCode']}" for row in active_groups)),
+            "nonZeroProjectArticles": len(uniq(
+                f"{row['budgetType']}:{row['projectCode']}:{comparison_key(row['projectArticleName'])}" for row in active_groups
+            )),
+            "currencies": currencies,
+            "newLocations": new_locations,
+            "newProjects": new_projects,
+            "newProjectArticles": len(new_project_article_keys),
+            "replacedValues": replaced_values,
+            "skippedRows": _num_or_zero(meta.get("skippedRows", UNDEF)),
+            "ignoredAmountCells": _num_or_zero(meta.get("ignoredAmountCells", UNDEF)),
+            "recoveredProjectCodes": _num_or_zero(meta.get("recoveredProjectCodes", UNDEF)),
+            "amountsByCurrency": amounts_by_currency,
+        },
+    }
+
+
