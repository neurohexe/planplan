+#!/bin/bash
+# Состояние версии на Django на стенде (задача 41): какой сервер работает, службы, готовность, база, копии.
+# shellcheck source=common-django.sh
+. "$(dirname -- "${BASH_SOURCE[0]}")/common-django.sh"
+shopt -s nullglob
+load_django_config
+if [ -e "$ACTIVE_MARK" ]; then
+  say "Стенд работает на Django с $(sed -n 's/^switched_at=//p' "$ACTIVE_MARK")."
+else
+  say 'Стенд работает на прежнем сервере (Node и SQLite).'
+fi
+say "Версия на Django: коммит $(version_value commit), PostgreSQL $(version_value postgresql)."
+for unit in "$APP_UNIT" "$PG_UNIT" "${BACKUP_UNIT%.service}.timer"; do
+  say "  $unit: $(user_systemctl is-active "$unit" 2> /dev/null || true)"
+done
+code=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 5 "http://127.0.0.1:$PLAN_FACT_PORT/api/ready") || code=000
+say "  /api/ready на порту $PLAN_FACT_PORT: HTTP $code"
+pg_client_env
+size=$(pg_tool psql --no-psqlrc --tuples-only --no-align \
+  --command "SELECT pg_size_pretty(pg_database_size('$PG_DATABASE'))" 2> /dev/null) || size='нет ответа'
+say "  База PostgreSQL: $size"
+hourly=("$PG_BACKUPS"/hourly/plan-fact-*.dump)
+daily=("$PG_BACKUPS"/daily/plan-fact-*.dump)
