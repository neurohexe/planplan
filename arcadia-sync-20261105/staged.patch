+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/healthcheck.sh
@@ -0,0 +1,52 @@
+#!/bin/bash
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=maintenance-common.sh
+. "$SCRIPT_DIR/maintenance-common.sh"
+[ "$#" -eq 0 ] || fail 'Использование: healthcheck.sh'
+load_stand_config
+private_directory "$STAND/logs"
+DOWN_FILE="$STAND/logs/.healthcheck-down"
+TIME_FILE="$STAND/logs/.healthcheck-last-notification"
+ordinary_or_missing "$DOWN_FILE"
+ordinary_or_missing "$TIME_FILE"
+
+notify() {
+  # Для живых тестов уведомления отключаются, обращения к GUI нет.
+  [ "${PLANFACT_NO_NOTIFICATIONS:-0}" != 1 ] || return 0
+  case "$1" in
+    down) osascript -e 'display notification "Стенд не отвечает. Проверьте его состояние." with title "План Факт MVP"' >/dev/null 2>&1 ;;
+    up) osascript -e 'display notification "Стенд снова работает" with title "План Факт MVP"' >/dev/null 2>&1 ;;
+  esac
+}
+
+http_code=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 5 "http://127.0.0.1:$PLAN_FACT_PORT/api/ready") || http_code=000
+if [ "$http_code" = 200 ]; then
+  if [ -f "$DOWN_FILE" ]; then
+    notify up || maintenance_log healthcheck.log 'Не удалось показать уведомление macOS о восстановлении.'
+    maintenance_log healthcheck.log 'Стенд снова работает.'
+    rm -f -- "$DOWN_FILE"
+  fi
+  exit 0
+fi
+maintenance_log healthcheck.log "Стенд не отвечает или не готов (HTTP $http_code)."
+if [ ! -f "$DOWN_FILE" ]; then
+  : > "$DOWN_FILE"
+  chmod 600 "$DOWN_FILE"
+fi
+now=$(date +%s)
+last=0
+if [ -f "$TIME_FILE" ]; then
+  read -r last < "$TIME_FILE" || last=0
+  [[ "$last" =~ ^[0-9]{1,12}$ ]] || last=0
+fi
+if [ "$last" = 0 ] || [ "$((now - 10#$last))" -ge 1800 ]; then
+  if notify down; then
+    printf '%s\n' "$now" > "$TIME_FILE"
+    chmod 600 "$TIME_FILE"
+  else
+    maintenance_log healthcheck.log 'Не удалось показать уведомление macOS о сбое.'
+  fi
+fi
+exit 1
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/laptop/install.sh b/junk/padolskiye/plan_fact_minipc/deploy/laptop/install.sh
new file mode 100755
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/install.sh
@@ -0,0 +1,146 @@
+#!/bin/bash
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=common.sh
+. "$SCRIPT_DIR/common.sh"
+
+NO_START=false
+NO_LAUNCHD=false
+for argument in "$@"; do
+  case "$argument" in
+    --no-start) NO_START=true ;;
+    --no-launchd) NO_LAUNCHD=true ;;
+    *) fail 'Использование: install.sh [--no-start] [--no-launchd]' ;;
+  esac
+done
+
+PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)
+[ -f "$PROJECT_ROOT/scripts/build-static.mjs" ] || fail 'Запустите deploy/laptop/install.sh из мастерской с исходниками.'
+[ "$STAND" != "$PROJECT_ROOT" ] || fail 'Папка стенда должна отличаться от мастерской.'
+NODE_BINARY=$(command -v node) || fail 'Не найден Node. Нужен Node 22.5 или новее.'
+case "$NODE_BINARY" in
+  /*) ;;
+  *) NODE_BINARY="$(CDPATH= cd -- "$(dirname -- "$NODE_BINARY")" && pwd -P)/$(basename -- "$NODE_BINARY")" ;;
+esac
+require_node "$NODE_BINARY"
+# Стенд, уже установленный без суффикса меток, на другие метки не переводим: прежние агенты остались бы загружены.
+if [ -n "$LABEL_SUFFIX" ] && [ ! -e "$LABEL_SUFFIX_FILE" ]; then
+  for file in "$STAND/launchd"/ru.planfact.mvp.*.plist; do
+    [ ! -f "$file" ] || fail 'Стенд уже установлен без суффикса меток. Уберите PLANFACT_LABEL_SUFFIX или выберите другую папку.'
+  done
+fi
+
+STAGE=''
+DIST_EXISTED=false
+[ ! -e "$PROJECT_ROOT/dist" ] || DIST_EXISTED=true
+cleanup() {
+  [ -z "$STAGE" ] || rm -rf -- "$STAGE"
+  # Сборка нужна только на время установки: в мастерской её не оставляем, иначе git видит лишнюю папку dist/.
+  [ "$DIST_EXISTED" = true ] || rm -rf -- "$PROJECT_ROOT/dist"
+}
+trap cleanup EXIT
+
+printf 'Собираю страницы и сервер для установки…\n'
+"$NODE_BINARY" "$PROJECT_ROOT/scripts/build-static.mjs"
+for directory in "$STAND" "$STAND/app" "$STAND/data" "$STAND/backups" "$STAND/backups/hourly" "$STAND/backups/daily" "$STAND/logs" "$STAND/codes" "$STAND/bin" "$STAND/launchd"; do
+  [ ! -L "$directory" ] || fail 'Каталоги стенда не должны быть символическими ссылками.'
+  mkdir -p -- "$directory"
+  chmod 700 "$directory"
+done
+STAND=$(CDPATH= cd -- "$STAND" && pwd -P)
+export PLANFACT_HOME="$STAND"
+STAGE=$(mktemp -d "$STAND/.install.XXXXXX")
+
+mkdir -p "$STAGE/app/backend" "$STAGE/bin" "$STAGE/launchd"
+cp -R "$PROJECT_ROOT/dist/app" "$STAGE/app/app"
+cp -R "$PROJECT_ROOT/dist/backend/src" "$STAGE/app/backend/src"
+cp -R "$PROJECT_ROOT/dist/backend/migrations" "$STAGE/app/backend/migrations"
+cp "$PROJECT_ROOT/dist/backend/package.json" "$STAGE/app/backend/package.json"
+for script in "$SCRIPT_DIR"/*.sh "$SCRIPT_DIR"/*.mjs; do
+  [ -f "$script" ] || continue
+  case "$(basename -- "$script")" in test-*.sh) continue ;; esac
+  cp "$script" "$STAGE/bin/"
+done
+find "$STAGE" -type d -exec chmod 700 {} +
+find "$STAGE" -type f -exec chmod 600 {} +
+chmod 700 "$STAGE/bin/"*.sh
+
+if [ ! -e "$STAND/config.env" ] && [ ! -L "$STAND/config.env" ]; then
+  "$NODE_BINARY" "$SCRIPT_DIR/render-template.mjs" config "$SCRIPT_DIR/config.env.template" "$STAGE/config.env" "$STAND" "$NODE_BINARY"
+  mv "$STAGE/config.env" "$STAND/config.env"
+fi
+[ ! -L "$STAND/config.env" ] || fail 'config.env не должен быть символической ссылкой.'
+chmod 600 "$STAND/config.env"
+load_stand_config "$STAGE/app"
+# При повторной установке сохраняется и записанный в config.env путь к Node.
+for template in "$SCRIPT_DIR/launchd/"*.plist.template "$SCRIPT_DIR/launchd/"*.plist.template.manual; do
+  [ -f "$template" ] && [ -s "$template" ] || continue
+  # Когда рядом есть обычный шаблон, .manual — метка, а не второй шаблон.
+  if [[ "$template" = *.manual ]] && [ -f "${template%.manual}" ]; then
+    continue
+  fi
+  name=$(basename -- "$template")
+  name=${name%.manual}
+  plist=${name%.template}
+  base_label=$(agent_label "$plist")
+  label=$base_label$LABEL_SUFFIX
+  "$NODE_BINARY" "$SCRIPT_DIR/render-template.mjs" plist "$template" "$STAGE/launchd/$label.plist" "$STAND" "$PLAN_FACT_NODE_BIN"
+  plutil -lint -- "$STAGE/launchd/$label.plist" >/dev/null
+  [ "$(plutil -extract Label raw -o - -- "$STAGE/launchd/$label.plist")" = "$base_label" ] || fail 'Метка внутри plist должна совпадать с именем своего агента.'
+  # Суффикс стенда (если он задан) дописывается к метке готового plist.
+  [ -z "$LABEL_SUFFIX" ] || plutil -replace Label -string "$label" -- "$STAGE/launchd/$label.plist"
+  if [[ "$template" = *.manual ]] || [ -f "$template.manual" ] || [ -f "$SCRIPT_DIR/launchd/$base_label.manual" ]; then
+    : > "$STAGE/launchd/$label.manual"
+  fi
+done
+
+if [ "$NO_LAUNCHD" = false ]; then
+  # Агента другого стенда с той же меткой не перезаписываем и не останавливаем: так репетиция без своего
+  # суффикса не заменит агентов настоящего стенда.
+  for file in "$STAGE/launchd/"*.plist; do
+    [ -f "$file" ] || continue
+    label=$(agent_label "$file")
+    if ! agent_is_ours "$label" && ! cmp -s -- "$AGENT_DIR/$label.plist" "$file"; then
+      fail "В LaunchAgents уже есть агент $label другого стенда. Для второго стенда на этом ноутбуке задайте свой суффикс меток, например PLANFACT_LABEL_SUFFIX=.rehearsal."
+    fi
+  done
+  # Останавливаем прежние процессы до замены установленного кода.
+  stop_agents
+fi
+mv "$STAND/app" "$STAGE/old-app"
+mv "$STAGE/app" "$STAND/app"
+mv "$STAND/bin" "$STAGE/old-bin"
+mv "$STAGE/bin" "$STAND/bin"
+for file in "$STAGE/launchd/"*; do
+  [ -f "$file" ] || continue
+  cp "$file" "$STAND/launchd/"
+done
+for file in "$STAGE/launchd/"*.plist; do
+  [ -f "$file" ] || continue
+  label=$(agent_label "$file")
+  if [ ! -f "$STAGE/launchd/$label.manual" ]; then
+    rm -f -- "$STAND/launchd/$label.manual"
+  fi
+done
+printf '%s\n' "$LABEL_SUFFIX" > "$STAND/launchd/.label-suffix"
+
+if [ "$NO_LAUNCHD" = true ]; then
+  : > "$STAND/launchd/.no-launchd"
+  printf 'Проверочная установка: автозапуск не включён, агенты сохранены внутри стенда.\n'
+else
+  rm -f -- "$STAND/launchd/.no-launchd"
+  mkdir -p -- "$AGENT_DIR"
+  for file in "$STAGE/launchd/"*.plist; do
+    [ -f "$file" ] || continue
+    label=$(agent_label "$file")
+    cp "$file" "$AGENT_DIR/$label.plist"
+    chmod 600 "$AGENT_DIR/$label.plist"
+  done
+  if [ "$NO_START" = false ]; then
+    start_agents
+  else
+    printf 'Агенты установлены. Запуск отложен по флагу --no-start.\n'
+  fi
+fi
+printf 'Стенд установлен: %s\n' "$STAND"
