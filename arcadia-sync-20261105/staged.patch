+    let loadingSession = false;
+    f.service.sessionByToken = async (...args) => {
+      loadingSession = true;
+      try { return await sessionByToken(...args); } finally { loadingSession = false; }
+    };
+    f.service.requireSession = async session => {
+      const live = await requireSession(session);
+      // Expire proof during the explicit final check in /api/events, after the
+      // ordinary token lookups and online identity check have already passed.
+      if (!loadingSession) f.advance(30_001);
+      return live;
+    };
+    const denied = await f.request("/api/events", { headers });
+    assert.equal(denied.status, 503);
+    assert.match(denied.headers.get("content-type"), /application\/json/);
