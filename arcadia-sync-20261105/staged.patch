+# Дополнение к обычному config.env после разрешённого подключения.
+# НЕ ГОТОВАЯ конфигурация: сначала заменить placeholders подтверждёнными параметрами.
+# Секретов здесь нет. TVMTOOL_LOCAL_AUTHTOKEN передаётся только окружением службы.
+# /api/ready = 503, пока WebAuth и свежая выгрузка Tirole не проверены успешно.
+# Порядок настройки tvmtool: AUTH-IDM-OPERATIONS.md.
+PLAN_FACT_AUTH_MODE=corporate-idm
+PLAN_FACT_ROLE_SOURCE=tirole
+PLAN_FACT_DEPLOYMENT_PROFILE=laptop-mvp
+PLAN_FACT_SECURE_COOKIES=true
+PLAN_FACT_CORPORATE_PUBLIC_URL='https://<подтверждённый-адрес-туннеля>'
+PLAN_FACT_ALLOWED_ORIGINS='https://<подтверждённый-адрес-туннеля>'
+PLAN_FACT_IDM_SYSTEM_SLUG='<подтверждённый-slug-IDM>'
+PLAN_FACT_IDM_REQUEST_URL='https://idm.yandex-team.ru/<проверенная-ссылка-на-запрос-роли>'
+PLAN_FACT_TVM_SELF_ALIAS='<подтверждённый-alias-tvmtool>'
+DEPLOY_TVM_TOOL_URL='http://127.0.0.1:<локальный-порт-tvmtool>'
+# Должен совпадать с --proxy-port helper, отличаться от порта приложения и tvmtool.
+PLAN_FACT_TIROLE_PROXY_PORT=18769
+# PLAN_FACT_NODE_BIN, DATABASE, STATIC_DIR, CODES_DIR, STORAGE_DRIVER, HOST, PORT
+# остаются из config.env выбранного стенда. Для репетиции PORT >= 18767.
+# Не задавать PLAN_FACT_STAFF_SUPERADMINS и PLAN_FACT_STAFF_USERS для corporate-idm.
