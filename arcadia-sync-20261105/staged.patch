+function fakeTvmtool(handler) {
+  const calls = [];
+  return {
+    calls,
+    fetchFn: async (url, options) => {
+      calls.push({ url: String(url), headers: options.headers });
+      return handler(String(url), options);
+    }
+  };
+}
