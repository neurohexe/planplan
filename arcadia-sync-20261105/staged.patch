+check 'архив открывается введённым паролем (компьютер без secrets)' said 'Копия расшифрована и проверена'
+"$NODE_BINARY" -e 'const fs=require("node:fs"),f=process.argv[1],b=fs.readFileSync(f);b[b.length-40]^=1;fs.writeFileSync(f,b);' "$TEST_ROOT/plan-fact-download.pfbak"
+sleep 1
+run "$STAND/bin/offsite-open.sh" "$TEST_ROOT/plan-fact-download.pfbak"
+check 'испорченный архив не открывается' failed_saying 'Пароль не подходит или архив повреждён'
+check 'после отказов лишних расшифрованных файлов нет' test "$(ls "$STAND/backups" | grep -c '^offsite-restored-')" -eq 2
