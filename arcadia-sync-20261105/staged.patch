+def _update_forecast_allocation(nxt: dict, payload: dict, now: str) -> None:
+    validate_forecast_payload(nxt, payload)
+    ticket, allocation = _ticket_and_allocation(nxt, payload)
+    if ticket is None or allocation is None:
+        raise DomainError("Прогнозное распределение не найдено")
+    if og(allocation, "lifecycle") not in ("active", "review"):
+        raise DomainError("Этот прогноз уже освобождён или оплачен")
+    old_quarter = og(allocation, "quarterKey")
+    new_quarter = quarter_key_from_date_input(_p(payload, "expectedDate"))
+    if strict_ne(old_quarter, new_quarter):
+        raise DomainError("Перенос прогноза разрешён только между месяцами одного квартала")
+    article = _find(nxt["articles"], lambda item: strict_eq(og(item, "id"), _p(payload, "articleId")))
+    resolved = resolve_optional_subarticle(article, _p(payload, "subarticleId"))
+    if (strict_ne(og(allocation, "locationId"), _p(payload, "locationId"))
+            or strict_ne(og(allocation, "articleId"), _p(payload, "articleId"))
+            or strict_ne(og(allocation, "subarticleId"), resolved)
+            or strict_ne(og(allocation, "currency"), normalize_currency_code(_p(payload, "currency")))):
+        raise DomainError(
+            "Прогноз можно переносить только внутри той же локации, статьи и валюты. "
+            "Для перераспределения освободите его и создайте новый тикет."
+        )
+    period_locks.assert_month_editable(nxt, _month_key(og(allocation, "expectedDate")))
+    period_locks.assert_month_editable(nxt, _month_key(_p(payload, "expectedDate")))
+    previous = {
+        "locationId": og(allocation, "locationId"),
+        "articleId": og(allocation, "articleId"),
+        "subarticleId": og(allocation, "subarticleId"),
+        "currency": og(allocation, "currency"),
+        "amount": og(allocation, "amount"),
+        "expectedDate": og(allocation, "expectedDate"),
+        "ticketUrl": og(ticket, "ticketUrl"),
+        "description": og(ticket, "description"),
+    }
+    allocation["locationId"] = _p(payload, "locationId")
+    allocation["articleId"] = _p(payload, "articleId")
+    allocation["subarticleId"] = resolved
+    allocation["currency"] = normalize_currency_code(_p(payload, "currency"))
+    allocation["amount"] = to_number(_p(payload, "amount"))
+    allocation["expectedDate"] = _p(payload, "expectedDate")
+    allocation["quarterKey"] = new_quarter
+    allocation["comment"] = clean_text(_p(payload, "comment"), 500)
+    if og(ticket, "sourceType") != expense_import.SOURCE_TYPE:
+        allocation["lifecycleSource"] = "manual"
+    allocation["stale"] = False
+    ticket["ticketUrl"] = safe_http_url(_p(payload, "ticketUrl"))
+    ticket["description"] = clean_text(_p(payload, "comment"), 500)
+    ticket["updatedAt"] = now
+    ticket["updatedBy"] = _author(payload)
+    ticket["lifecycle"] = expense_import.ticket_lifecycle(ticket.get("allocations", UNDEF))
+    _push_history(ticket, {"changedAt": now, "changedBy": ticket["updatedBy"], "action": "forecast-update", "previous": previous})
+
