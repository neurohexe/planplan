+class ServeCommandTests(TransactionTestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory(prefix="plan-fact-serve-")
+        self.root = Path(self._tmp.name)
+        database = connection.settings_dict["NAME"]
+        self.database_url = os.environ["PLAN_FACT_DATABASE_URL"].rsplit("/", 1)[0] + "/" + database
+
+    def tearDown(self) -> None:
+        self._tmp.cleanup()
+
+    def env(self, **overrides: str) -> dict:
+        return {"PATH": os.environ["PATH"], "HOME": str(self.root),
+                **stand_env(self.root, PLAN_FACT_DATABASE_URL=self.database_url, PLAN_FACT_PORT=str(free_port())), **overrides}
+
+    def test_refuses_to_start_in_production_or_with_other_modes(self):
+        for overrides, message in (
+            ({"NODE_ENV": "production"}, "Вход по личным кодам (PLAN_FACT_AUTH_MODE=access-code) запрещён в production"),
+            ({"PLAN_FACT_AUTH_MODE": "webauth"}, "Режим входа PLAN_FACT_AUTH_MODE=webauth в версии на Django пока не перенесён"),
+            ({"PLAN_FACT_STORAGE_DRIVER": "sqlite"}, "Версия на Django хранит данные только в PostgreSQL"),
+            ({"PLAN_FACT_DATABASE_URL": ""}, "Не задан PLAN_FACT_DATABASE_URL"),
+        ):
+            result = subprocess.run([sys.executable, "manage.py", "serve"], cwd=BACKEND_DIR, capture_output=True, text=True,
+                                    env=self.env(**overrides), timeout=120)
+            self.assertEqual(result.returncode, 1, result.stderr)
+            self.assertIn(f"Plan Fact backend failed to start: {message}", result.stderr)
+            self.assertNotIn("Plan Fact backend: http", result.stdout)
+
+    def test_starts_announces_the_mode_and_stops_on_sigterm(self):
+        env = self.env()
+        port = env["PLAN_FACT_PORT"]
+        child = subprocess.Popen([sys.executable, "manage.py", "serve"], cwd=BACKEND_DIR, env=env, stdout=subprocess.PIPE,
+                                 stderr=subprocess.PIPE, text=True)
+        try:
+            lines = []
+            deadline = time.monotonic() + 60
+            while "auth_mode access-code" not in "".join(lines):
+                if time.monotonic() > deadline or child.poll() is not None:
+                    self.fail(f"сервер не запустился: {child.stderr.read() if child.poll() is not None else ''}")
+                lines.append(child.stdout.readline())
+            output = "".join(lines)
+            self.assertIn(f"Plan Fact backend: http://127.0.0.1:{port}\n", output)
+            self.assertIn("auth_mode access-code secure_cookies=off\n", output)
+            request = urllib.request.Request(f"http://127.0.0.1:{port}/api/auth")
+            with self.assertRaises(urllib.error.HTTPError) as answer:
+                urllib.request.urlopen(request, timeout=10)
+            self.assertEqual(answer.exception.code, 401)
+            self.assertEqual(answer.exception.headers.get("Server"), "plan-fact")
+            ready = urllib.request.urlopen(f"http://127.0.0.1:{port}/api/ready", timeout=10)
+            self.assertEqual(ready.status, 200)
+        finally:
+            child.send_signal(signal.SIGTERM)
+            try:
+                code = child.wait(30)
+            except subprocess.TimeoutExpired:
+                child.kill()
+                code = child.wait(10)
+            child.stdout.close()
+            child.stderr.close()
+        self.assertEqual(code, 0, "сервер штатно останавливается по SIGTERM")
+
