+def _author(payload: dict) -> str:
+    return clean_text(_p(payload, "author"), 80) or "Не указано"
+
+
+def _push_history(record: dict, entry: dict) -> None:
+    history = record.get("history", UNDEF)
+    record["history"] = tail(history, 49) if is_list(history) else []
+    record["history"].append(entry)
+
