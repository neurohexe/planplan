+# Сервер стенда. Перезапускается при любом завершении, как агент launchd с KeepAlive на Mac.
+[Unit]
+Description=План Факт MVP: сервер
+StartLimitIntervalSec=0
+
+[Service]
+Type=simple
+ExecStart=/bin/bash {{BIN}}/run-app.sh
+Environment=PLANFACT_HOME={{STAND}}
+Environment=PLAN_FACT_NODE_BIN={{NODE}}
+WorkingDirectory={{STAND}}/app
+Restart=always
+RestartSec=10
+TimeoutStopSec=20
+UMask=0077
+NoNewPrivileges=yes
+
+[Install]
+WantedBy=default.target
