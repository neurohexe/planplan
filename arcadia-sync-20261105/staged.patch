+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const { createRequire } = require("node:module");
+const test = require("node:test");
+const vm = require("node:vm");
+const app = require("../app.js");
+const BudgetImport = require("../budget-import.js");
+
+const QUARTER = "2026-Q4";
+const APP_PATH = path.resolve(__dirname, "../app.js");
+const SOURCE = fs.readFileSync(APP_PATH, "utf8");
+const clone = (value) => JSON.parse(JSON.stringify(value));
+
+function payload(overrides = {}) {
+  return {
+    quarterKey: QUARTER, sourceFile: "fictional-budget.xlsx",
+    rows: [{
+      budgetType: "opex", locationCode: "OFFICE-A", locationName: "Вымышленный офис",
+      projectCode: "PROJECT-A", projectName: "Вымышленный проект", projectArticleName: "Статья А",
+      currency: "RUB", responsibleGroups: ["alice"],
+      months: { "2026-10": 1000, "2026-11": 2000, "2026-12": 3000 }
+    }],
+    ...overrides
+  };
+}
+
+function fixture() {
+  let state = app.applyLocalMutation(app.createInitialState(), "importBudget", payload());
+  const locationId = state.locations.find((item) => item.code === "OFFICE-A").id;
+  const article = state.articles.find((item) => item.code === "PROJECT-A");
+  const subarticleId = article.subarticles.find((item) => item.name === "Статья А").id;
+  state = app.applyLocalMutation(state, "addExpense", {
+    id: "expense-alice", locationId, articleId: article.id, subarticleId,
+    expenseDate: "2026-10-14", currency: "RUB", amount: 125,
+    ticketUrl: "https://example.com/TEST-1", comment: "Вымышленный расход", author: "alice"
+  });
+  state = app.applyLocalMutation(state, "addComment", {
+    id: "comment-bob", expenseId: "expense-alice", text: "Вымышленный комментарий", author: "bob"
+  });
+  state = app.applyLocalMutation(state, "addForecast", {
+    id: "forecast-alice", allocationId: "allocation-alice", locationId,
+    articleId: article.id, subarticleId, expectedDate: "2026-11-14",
+    currency: "RUB", amount: 250, ticketUrl: "https://example.com/TEST-2", author: "alice"
+  });
+  return state;
+}
+
+function transactions(state) {
+  return Object.fromEntries(["expenses", "comments", "forecastTickets"].map((key) => [key, state[key]]));
+}
+
+test("BudgetImport_RepeatedQuarterKeepsEveryExpenseCommentAndForecastUnchanged", () => {
+  const before = fixture();
+  const unchanged = clone(before);
+  const after = app.applyLocalMutation(before, "importBudget", payload());
+  assert.deepEqual(transactions(after), transactions(before));
+  assert.deepEqual(before, unchanged, "исходное состояние не изменяется");
+  assert.equal(after.revision, before.revision + 1);
+});
+
+test("BudgetImport_ChangedPlanAndRenamedItemKeepTheOriginalExpenseAndItsItem", () => {
+  const before = fixture();
+  const changed = payload();
+  changed.rows[0].projectArticleName = "Статья Б";
+  changed.rows[0].months = { "2026-10": 4000, "2026-11": 5000, "2026-12": 6000 };
+  const after = app.applyLocalMutation(before, "importBudget", changed);
+  assert.deepEqual(transactions(after), transactions(before));
+  const expense = after.expenses[0];
+  const project = after.articles.find((item) => item.id === expense.articleId);
+  assert.ok(project.subarticles.some((item) => item.id === expense.subarticleId));
+  assert.equal(Object.values(after.budgets[`${expense.locationId}|${QUARTER}`])
+    .reduce((sum, amounts) => sum + (amounts.RUB || 0), 0), 15000);
+});
+
+test("BudgetImport_NewYearAndZeroPlanKeepCanceledExpensesAndOldQuarter", () => {
+  const before = fixture();
+  before.expenses[0].status = "canceled";
+  const changed = payload({ quarterKey: "2027-Q1" });
+  changed.rows[0].months = { "2027-01": 0, "2027-02": 0, "2027-03": 0 };
+  const after = app.applyLocalMutation(before, "importBudget", changed);
+  assert.deepEqual(transactions(after), transactions(before));
+  const key = `${before.expenses[0].locationId}|${QUARTER}`;
+  assert.deepEqual(after.budgets[key], before.budgets[key]);
+  assert.deepEqual(after.monthlyBudgets[key], before.monthlyBudgets[key]);
+});
+
+const harmfulChanges = [
+  ["deletedExpense", (state) => { state.expenses = []; }],
+  ["changedAmount", (state) => { state.expenses[0].amount = 999; }],
+  ["canceledExpense", (state) => { state.expenses[0].status = "canceled"; }],
+  ["movedExpenseDate", (state) => { state.expenses[0].expenseDate = "2027-01-01"; }],
+  ["lostItemBinding", (state) => { state.expenses[0].subarticleId = null; }],
+  ["lostComment", (state) => { state.comments = []; }],
+  ["releasedForecast", (state) => { state.forecastTickets[0].allocations[0].lifecycle = "released"; }],
+  ["deletedForecast", (state) => { state.forecastTickets = []; }]
+];
+
+for (const [name, change] of harmfulChanges) {
+  test(`BudgetImport_Rejects_${name}_BeforeAnyDataCanBeSaved`, (t) => {
+    const before = fixture();
+    const unchanged = clone(before);
+    const originalImport = BudgetImport.applyBudgetImport;
+    t.mock.method(BudgetImport, "applyBudgetImport", (state, data) => {
+      const after = originalImport(state, data);
+      change(after);
+      return after;
+    });
+    assert.throws(() => app.applyLocalMutation(before, "importBudget", payload()), {
+      code: "budget_import_changes_records", statusCode: 400
+    });
+    assert.deepEqual(before, unchanged);
+  });
+}
+
+function importUi(state, accept = false, options = {}) {
+  const dom = {
+    applyExcelImportBtn: { disabled: false }, excelImportStatus: { textContent: "", classList: { add() {} } }
+  };
+  const confirmations = [];
+  const mutations = [];
+  const notifications = [];
+  const context = vm.createContext({
+    require: createRequire(APP_PATH), initialState: state, pendingPayload: payload(), uiDom: dom, uiOptions: options,
+    confirmations, mutations, notifications, URL,
+    window: { confirm(message) { confirmations.push(message); return accept; } },
+    localStorage: { getItem: () => null, setItem() {} }, console
+  });
+  vm.runInContext(SOURCE.replace(/\}\)\(\);\s*$/, `
+    state = initialState;
+    currentUser = { role: "admin" };
+    selectedLocation = uiOptions.location || state.locations[0]?.id || "default";
+    pendingBudgetImport = { ...pendingPayload, preview: { rows: pendingPayload.rows } };
+    Object.assign(dom, uiDom);
+    mutate = async (type, data) => {
+      mutations.push({ type, data });
+      if (uiOptions.complete) {
+        state = applyLocalMutation(state, type, data);
+        return;
+      }
+      throw new Error("Тест останавливает обновление интерфейса после отправки");
+    };
+    saveSelectedLocation = () => {};
+    populateYearOptions = () => {};
+    setPeriodControls = () => {};
+    closeExcelImportDialog = () => {};
+    renderAll = () => {};
+    showToast = (message) => notifications.push(message);
+    globalThis.importUi = { applyPendingBudgetImport, selectedLocation: () => selectedLocation };
+  })();`), context, { filename: APP_PATH });
+  return { api: context.importUi, confirmations, mutations, notifications, dom };
+}
+
+test("BudgetImportUi_CancelingRepeatedQuarterDoesNotSendImport", async () => {
+  const ui = importUi(fixture());
+  await ui.api.applyPendingBudgetImport();
+  assert.equal(ui.confirmations.length, 1);
+  assert.match(ui.confirmations[0], /(?:Q4 2026|4 квартал 2026)/);
+  assert.match(ui.confirmations[0], /расходы.*сохранятся/);
+  assert.deepEqual(ui.mutations, []);
+  assert.equal(ui.dom.applyExcelImportBtn.disabled, false);
+});
+
+test("BudgetImportUi_AcceptingRepeatedQuarterSendsOnlyBudgetImport", async () => {
+  const ui = importUi(fixture(), true);
+  await ui.api.applyPendingBudgetImport();
+  assert.equal(ui.confirmations.length, 1);
+  assert.equal(ui.mutations.length, 1);
+  assert.equal(ui.mutations[0].type, "importBudget");
+  assert.equal(ui.mutations[0].data.quarterKey, QUARTER);
+});
+
+test("BudgetImportUi_FirstImportDoesNotAskToReplaceAnotherQuarter", async () => {
+  const state = fixture();
+  state.imports = state.imports.map((item) => ({ ...item, quarterKey: "2026-Q3" }));
+  state.budgets = {};
+  state.monthlyBudgets = {};
+  const ui = importUi(state);
+  await ui.api.applyPendingBudgetImport();
+  assert.deepEqual(ui.confirmations, []);
+  assert.equal(ui.mutations.length, 1);
+});
+
+test("BudgetImportUi_RepeatedImportKeepsTheSelectedOfficeInsteadOfShowingAnotherOfficesFacts", async () => {
+  const state = fixture();
+  state.locations.push({ id: "office-b", code: "OFFICE-B", name: "Другой вымышленный офис", archived: false });
+  const ui = importUi(state, true, { location: "office-b", complete: true });
+  await ui.api.applyPendingBudgetImport();
+  assert.equal(ui.mutations.length, 1);
+  assert.equal(ui.notifications.length, 1, ui.dom.excelImportStatus.textContent);
+  assert.equal(ui.api.selectedLocation(), "office-b");
+});
+
+test("BudgetImportUi_RepeatedImportKeepsAllLocations", async () => {
+  const ui = importUi(fixture(), true, { location: "__all__", complete: true });
+  await ui.api.applyPendingBudgetImport();
+  assert.equal(ui.notifications.length, 1, ui.dom.excelImportStatus.textContent);
+  assert.equal(ui.api.selectedLocation(), "__all__");
+});
