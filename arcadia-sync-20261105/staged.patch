diff --git a/junk/padolskiye/plan_fact_minipc/deploy/laptop/rotate-logs.mjs b/junk/padolskiye/plan_fact_minipc/deploy/laptop/rotate-logs.mjs
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/rotate-logs.mjs
@@ -0,0 +1,36 @@
+import { chmodSync, closeSync, copyFileSync, fstatSync, ftruncateSync, lstatSync, openSync, readdirSync, renameSync, rmSync } from 'node:fs';
+import { join } from 'node:path';
+
+const directory = process.argv[2];
+const limit = 10 * 1024 * 1024;
+// Открытый файл launchd/Node остаётся тем же: копируем содержимое в .1 и
+// обнуляем его, вместо переименования файла, в который продолжают писать.
+for (const name of readdirSync(directory).filter((name) => name.endsWith('.log')).sort()) {
+  const file = join(directory, name);
+  if (!lstatSync(file).isFile() || lstatSync(file).isSymbolicLink()) continue;
+  for (const suffix of ['', '.1', '.2', '.3']) {
+    const candidate = `${file}${suffix}`;
+    try {
+      if (lstatSync(candidate).isSymbolicLink() || !lstatSync(candidate).isFile()) {
+        throw new Error('Журналы должны быть обычными файлами.');
+      }
+    } catch (error) {
+      if (error.code !== 'ENOENT') throw error;
+    }
+  }
+  const descriptor = openSync(file, 'r+');
+  try {
+    chmodSync(file, 0o600);
+    if (fstatSync(descriptor).size <= limit) continue;
+    rmSync(`${file}.3`, { force: true });
+    for (const index of [2, 1]) {
+      try { renameSync(`${file}.${index}`, `${file}.${index + 1}`); }
+      catch (error) { if (error.code !== 'ENOENT') throw error; }
+    }
+    copyFileSync(file, `${file}.1`);
+    chmodSync(`${file}.1`, 0o600);
+    ftruncateSync(descriptor, 0);
+  } finally {
+    closeSync(descriptor);
+  }
+}
