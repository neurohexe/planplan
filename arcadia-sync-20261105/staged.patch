+    """Старые форматы: бюджет по кварталу без локации, валюта у локации, расходы без статьи и т. п."""
+    result = json.loads(json.dumps(state))
+    result["schemaVersion"] = rng.choice([1, 5, 12, 13, 15, None, "12"])
+    if result.get("budgets"):
+        key = next(iter(result["budgets"]))
+        store = result["budgets"].pop(key)
+        result["budgets"][key.split("|")[-1]] = {
+            item_key.split("|")[0]: (list(value.values())[0] if isinstance(value, dict) and value else 5) for item_key, value in store.items()
+        }
+    for location in result.get("locations", []):
+        if rng.random() < 0.5:
+            location["currency"] = rng.choice(["USD", "uzs", "", None])
+    for expense in result.get("expenses", []):
+        if rng.random() < 0.3:
+            expense.pop("subarticleId", None)
+        if rng.random() < 0.2:
+            expense["createdAt"] = rng.choice(["Nov 3 2026", "2026/11/03", "garbage", None])
+            expense["expenseDate"] = rng.choice(["2026-11-31", None, "2026-11-03"])
+    tracker = result.setdefault("trackerSync", {})
+    first_article = (result.get("articles") or [{}])[0].get("id")
+    first_location = (result.get("locations") or [{}])[0].get("id")
+    tracker["mappingRules"] = {"SRC-P|SRC-L": {"articleId": first_article, "locationId": first_location}, "bad": {}, "A|B|C": {}}
+    tracker["warnings"] = [{"id": "w", "issueKey": "TAXIASSIST-1", "changes": [{"field": "amount", "previous": 1, "current": "2"}, {"field": ""}],
+                            "validationErrors": ["e", 5, ""], "currentSnapshot": {"amount": "7"}}]
+    tracker["lastResult"] = {"created": "3", "periodKey": "2026-Q4", "searchScope": "queue"}
+    result["closedPeriods"] = {"months": {"2026-10": {"closedAt": "2026-11-01T00:00:00.000Z"}, "2026-13": {"closedAt": "x"}, "bad": 1},
+                               "quarters": {"2026-Q3": {"closedAt": "2026-10-02T00:00:00.000Z", "snapshot": {"byLocation": {}}}}}
+    result["periodCloseHistory"] = [{"action": "close", "level": "month", "periodKey": "2026-10", "at": "bad"}, None, {"periodKey": 5}]
+    result["exchangeRates"] = {"USD": 90}
+    result.pop("legacyExchangeRates", None)
+    return result
+
+
+def sample_states(seeds: range, length: int) -> list[dict]:
+    initial = json.loads(js.dumps(state_module.normalize_state(state_module.create_initial_state())))
+    seeded = seeded_state()
+    states = [initial, seeded]
+    for seed in seeds:
+        sequence = build_sequence(seed, seeded if seed % 2 else initial, length)
+        outcomes = [item["value"] for item in python_sequence(sequence["initial"], sequence["steps"]) if item["ok"]]
+        if outcomes:
+            states.extend([outcomes[len(outcomes) // 2], outcomes[-1]])
+    return states
