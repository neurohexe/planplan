+    ])
+    if count > 0:
+        raise DomainError(f"Невозможно удалить: есть {count} {plural_expenses(count)}.")
+    forecast_count = len([
+        allocation for ticket in nxt["forecastTickets"] for allocation in or_(og(ticket, "allocations"), [])
+        if strict_eq(og(allocation, "articleId"), article_id) and strict_eq(og(allocation, "subarticleId"), subarticle_id)
+    ])
+    if forecast_count > 0:
+        raise DomainError(f"Невозможно удалить: есть {forecast_count} прогнозных распределений.")
+    item_key = pk(budget_item_key(article_id, subarticle_id))
+    if budget_item_has_values(nxt, item_key):
+        raise DomainError("Невозможно удалить статью: сначала обнулите её бюджет во всех периодах")
+    article["subarticles"] = [item for item in or_(article.get("subarticles", UNDEF), []) if strict_ne(og(item, "id"), subarticle_id)]
+    for collection in ("budgets", "monthlyBudgets"):
+        for store in values(or_(nxt.get(collection, UNDEF), {})):
+            if is_dict(store):
+                store.pop(item_key, None)
+
+
+def _period_action(nxt: dict, payload: dict, close: bool) -> None:
