new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/django/backup-postgres.sh
@@ -0,0 +1,63 @@
+#!/bin/bash
+# Резервная копия базы PostgreSQL (служба ru.planfact.mvp.backup после switch-to-django.sh; таймер прежний —
+# раз в час). Порядок хранения как у копий SQLite: 48 почасовых и 14 ежедневных в backups/postgres.
+# Каждая копия проверяется чтением (pg_restore --list) до того, как попадёт в папку копий.
+# shellcheck source=common-django.sh
+. "$(dirname -- "${BASH_SOURCE[0]}")/common-django.sh"
+[ "$#" -eq 0 ] || fail 'Использование: backup-postgres.sh'
+export LC_ALL=C
+shopt -s nullglob
+pg_client_env
+maintenance_lock
+private_dir "$STAND/backups" "$PG_BACKUPS" "$PG_BACKUPS/hourly" "$PG_BACKUPS/daily" "$STAND/logs"
+
+log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$STAND/logs/backup.log"; }
+temporary=$(mktemp -d "$PG_BACKUPS/.dump-XXXXXX")
+finish() {
+  local result=$?
+  rm -rf -- "$temporary"
+  [ "$result" -eq 0 ] || log "Не удалось создать резервную копию PostgreSQL (код $result)."
+  exit "$result"
+}
+trap finish EXIT
+
+name="plan-fact-$(date '+%Y%m%d-%H%M%S').dump"
+while [ -e "$PG_BACKUPS/hourly/$name" ] || [ -e "$PG_BACKUPS/daily/$name" ]; do
+  sleep 1
+  name="plan-fact-$(date '+%Y%m%d-%H%M%S').dump"
+done
+pg_tool pg_dump --format=custom --no-owner --file "$temporary/$name" "$PG_DATABASE"
+pg_tool pg_restore --list "$temporary/$name" > /dev/null
+chmod 600 "$temporary/$name"
+today=("$PG_BACKUPS/daily/plan-fact-${name:10:8}-"*.dump)
+check_restore=false
+if [ "${#today[@]}" -eq 0 ]; then
+  cp -- "$temporary/$name" "$PG_BACKUPS/daily/$name"
+  check_restore=true
+fi
+mv -- "$temporary/$name" "$PG_BACKUPS/hourly/$name"
+if [ ! -f "$PG_BACKUPS/.last-restore-check" ] || ! grep -q "^$(date '+%Y-%m-%d')" "$PG_BACKUPS/.last-restore-check"; then
+  check_restore=true
+fi
+if [ "$check_restore" = true ]; then
+  if check_dump "$PG_BACKUPS/hourly/$name" "$PG_BACKUPS/hourly/$name.summary"; then
+    printf '%s %s\n' "$(date -Iseconds)" "$name" > "$PG_BACKUPS/.last-restore-check"
+    log "Пробное восстановление PostgreSQL успешно: $name."
+  else
+    log "Пробное восстановление PostgreSQL не пройдено: $name. Дамп сохранён."
+    exit 1
+  fi
+fi
+
+# Имена упорядочены по времени: удаляются самые старые сверх нормы.
+rotate() {
+  local keep=$2 files i
+  files=("$1"/plan-fact-*.dump)
+  for ((i = 0; i < ${#files[@]} - keep; i++)); do
+    rm -f -- "${files[$i]}"
+    rm -f -- "${files[$i]}.summary"
+  done
+}
+rotate "$PG_BACKUPS/hourly" 48
+rotate "$PG_BACKUPS/daily" 14
+log "Резервная копия PostgreSQL: $name ($(du -h "$PG_BACKUPS/hourly/$name" | cut -f1))."
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/django/build-bundle.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/django/build-bundle.sh
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/django/build-bundle.sh
@@ -0,0 +1,90 @@
+#!/bin/bash
+# Сборка комплекта версии на Django для стенда на Linux (задача 41). Запускается на Mac в мастерской, нужен Docker.
+# Пакеты PostgreSQL 16 скачивает apt в контейнере Ubuntu 24.04 нужной архитектуры (подписи архива Ubuntu
+# проверяет apt), пакеты Python — pip там же, только готовые сборки (wheel) по requirements.txt.
+# Код — из последнего коммита (git archive); с --dev — из рабочей папки, только для репетиций.
+# Результат: .sandbox/django-bundle/planfact-django-<коммит>-<архитектура>.tar.gz и .sha256 рядом.
+# Использование: build-bundle.sh [--arch amd64|arm64] [--dev]
+set -euo pipefail
+umask 077
+fail() { printf 'Ошибка: %s\n' "$*" >&2; exit 1; }
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd -P)
+ARCH=amd64
+DEV=false
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    --arch) ARCH=${2:-}; shift 2 ;;
+    --dev) DEV=true; shift ;;
+    *) fail 'Использование: build-bundle.sh [--arch amd64|arm64] [--dev]' ;;
+  esac
+done
+case "$ARCH" in amd64 | arm64) ;; *) fail 'Архитектура — amd64 (мини-ПК) или arm64.' ;; esac
+command -v docker > /dev/null || fail 'Нужен Docker.'
+paths=(backend_django deploy/linux/django deploy/linux/common.sh app scripts/build-static.mjs)
+if [ "$DEV" = false ] && [ -n "$(git -C "$PROJECT_ROOT" status --porcelain -- "${paths[@]}")" ]; then
+  fail 'В backend_django или deploy/linux/django есть незакоммиченные изменения: закоммитьте их или соберите с --dev.'
+fi
+commit=$(git -C "$PROJECT_ROOT" rev-parse HEAD)
+label=${commit:0:12}
+[ "$DEV" = false ] || label="$label-dev"
+NAME="planfact-django-$label-$ARCH"
+OUT="$PROJECT_ROOT/.sandbox/django-bundle"
+requirements="$PROJECT_ROOT/backend_django/requirements.txt"
+CACHE="$OUT/cache-$ARCH-$(shasum -a 256 "$requirements" | cut -c1-16)"
+mkdir -p "$OUT"
+
+if [ ! -f "$CACHE/.ready" ]; then
+  echo "Скачиваю пакеты Ubuntu 24.04 ($ARCH) и Python в $CACHE."
+  rm -rf -- "$CACHE"
+  mkdir -p "$CACHE"
+  docker run --rm --platform "linux/$ARCH" -v "$CACHE:/out" -v "$requirements:/requirements.txt:ro" ubuntu:24.04 \
+    bash -euo pipefail -c '
+      export DEBIAN_FRONTEND=noninteractive
+      apt-get update -qq
+      apt-get install -qq -y --download-only --no-install-recommends postgresql-16 postgresql-client-16 > /dev/null
+      mkdir -p /out/debs /out/wheels/bootstrap
+      for deb in /var/cache/apt/archives/*.deb; do
+        case "$(basename "$deb")" in
+          postgresql-16_* | postgresql-client-16_*) cp "$deb" /out/debs/ ;;
+          libllvm* | libperl* | lib*-perl_*) ;;
+          lib*) cp "$deb" /out/debs/ ;;
+        esac
+      done
+      apt-get install -qq -y --no-install-recommends python3-pip > /dev/null
+      pip download --quiet --disable-pip-version-check --only-binary=:all: --dest /out/wheels -r /requirements.txt
+      pip download --quiet --disable-pip-version-check --only-binary=:all: --no-deps --dest /out/wheels/bootstrap pip
+    '
+  touch "$CACHE/.ready"
+fi
+
+STAGE=$(mktemp -d "$OUT/.stage.XXXXXX")
+trap 'rm -rf -- "$STAGE"' EXIT
+ROOT="$STAGE/$NAME"
+mkdir -p "$ROOT"
+if [ "$DEV" = true ]; then
+  COPYFILE_DISABLE=1 tar -C "$PROJECT_ROOT" --exclude .venv --exclude __pycache__ --exclude '*.pyc' -cf - "${paths[@]}" |
+    tar -C "$ROOT" -xf -
+else
+  git -C "$PROJECT_ROOT" archive --format=tar HEAD "${paths[@]}" | tar -C "$ROOT" -xf -
+fi
+cp -R "$CACHE/debs" "$CACHE/wheels" "$ROOT/"
+node "$PROJECT_ROOT/scripts/build-static.mjs"
+cp -R "$PROJECT_ROOT/dist/app" "$ROOT/static-app"
+pg_deb=$(cd "$ROOT/debs" && ls postgresql-16_*.deb)
+pg_version=${pg_deb#postgresql-16_}
+{
+  printf 'commit=%s%s\n' "$commit" "$([ "$DEV" = false ] || printf '+dev')"
+  printf 'legacy_common_sha256=e594e204750809d150f02bc212bc5809b80ed4dd9f0734c96abdfda25a0c6ae2\n'
+  printf 'legacy_guard_sha256=%s\n' "$(shasum -a 256 "$ROOT/deploy/linux/common.sh" | cut -d ' ' -f 1)"
+  printf 'arch=%s\n' "$ARCH"
+  printf 'built_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
+  printf 'postgresql=%s\n' "${pg_version%%_*}"
+  printf 'pip=%s\n' "$(cd "$ROOT/wheels/bootstrap" && ls)"
+  printf 'wheels=%s\n' "$(cd "$ROOT/wheels" && ls ./*.whl | sed 's|^\./||' | tr '\n' ' ')"
+} > "$ROOT/VERSION"
+(cd "$ROOT" && find . -type f ! -name MANIFEST.sha256 -print0 | LC_ALL=C sort -z | xargs -0 shasum -a 256 > MANIFEST.sha256)
+COPYFILE_DISABLE=1 tar --no-mac-metadata --no-xattrs -C "$STAGE" -czf "$OUT/$NAME.tar.gz" "$NAME"
+(cd "$OUT" && shasum -a 256 "$NAME.tar.gz" > "$NAME.tar.gz.sha256")
+echo "Комплект: $OUT/$NAME.tar.gz ($(du -h "$OUT/$NAME.tar.gz" | cut -f1))"
+cat "$OUT/$NAME.tar.gz.sha256"
diff --git a/junk/padolskiye/plan_fact_minipc/deploy/linux/django/common-django.sh b/junk/padolskiye/plan_fact_minipc/deploy/linux/django/common-django.sh
new file mode 100644
--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/linux/django/common-django.sh
@@ -0,0 +1,245 @@
+#!/bin/bash
+# Общие пути и функции версии на Django для стенда на Linux (задача 41). Подключается остальными скриптами
+# этой папки. Прежние скрипты стенда (bin/*.sh) и config.env не меняются: config.env общий для обеих версий,
+# а хранилище PostgreSQL версии на Django подставляет load_django_config.
+set -euo pipefail
+umask 077
+
+fail() { printf 'Ошибка: %s\n' "$*" >&2; exit 1; }
+say() { printf '%s\n' "$*"; }
+
+STAND=${PLANFACT_HOME:-$HOME/PlanFactMVP}
+case "$STAND" in /*) ;; *) fail 'PLANFACT_HOME должен быть полным путём, начиная с /.' ;; esac
+[ -d "$STAND" ] && [ ! -L "$STAND" ] || fail "Не найдена папка стенда $STAND."
+STAND=$(CDPATH= cd -- "$STAND" && pwd -P)
+export PLANFACT_HOME="$STAND"
+
+# Установка версии на Django: код, окружение Python, программы PostgreSQL и эти скрипты. Установленные скрипты
+# (<установка>/bin) управляют своей установкой; скрипты из комплекта ставят в PLANFACT_DJANGO_HOME,
+# по умолчанию ~/planfact. Данные (pgdata, копии, журналы) — в папке стенда.
+SCRIPT_PARENT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
+if [ "$(basename -- "$(dirname -- "${BASH_SOURCE[0]}")")" = bin ] && [ -f "$SCRIPT_PARENT/VERSION" ]; then
+  DJANGO_HOME=$SCRIPT_PARENT
+else
+  DJANGO_HOME=${PLANFACT_DJANGO_HOME:-$HOME/planfact}
+fi
+case "$DJANGO_HOME" in /*) ;; *) fail 'PLANFACT_DJANGO_HOME должен быть полным путём, начиная с /.' ;; esac
+DJANGO_BIN="$DJANGO_HOME/bin"
+DJANGO_CODE="$DJANGO_HOME/backend_django"
+DJANGO_VENV="$DJANGO_HOME/venv"
+PG_HOME="$DJANGO_HOME/postgres"      # распакованные пакеты PostgreSQL 16 из Ubuntu 24.04
+PG_BIN="$PG_HOME/usr/lib/postgresql/16/bin"
+PG_LIBS="$PG_HOME/lib"               # библиотеки, которых не оказалось в системе (их отбирает установщик)
+PGDATA_DIR="$STAND/pgdata"           # данные PostgreSQL
+# PostgreSQL слушает только сокет в закрытой папке стенда: без TCP, входит только учётная запись стенда (peer).
+PG_SOCKET_DIR="$STAND/run/postgres"
+PG_PORT=18770                        # номер в имени сокета .s.PGSQL.18770
+PG_DATABASE=${PLANFACT_DJANGO_DATABASE:-planfact}
+[[ "$PG_DATABASE" =~ ^[a-z][a-z0-9_]{0,31}$ ]] || fail 'Некорректное имя базы PostgreSQL.'
+UNIT_DIR="$HOME/.config/systemd/user"
+SERVICE_DIR="$STAND/systemd"
+NODE_UNITS_SAVED="$SERVICE_DIR/node-units"   # службы прежнего сервера для отката
+ACTIVE_MARK="$SERVICE_DIR/.backend-django"   # есть файл — стенд работает на Django
+PG_BACKUPS="$STAND/backups/postgres"
+
+# Имена служб — как у bin/common.sh: ru.planfact.mvp.<имя><суффикс стенда>.
+LABEL_SUFFIX=''
+if [ -f "$SERVICE_DIR/.label-suffix" ] && [ ! -L "$SERVICE_DIR/.label-suffix" ]; then
+  read -r LABEL_SUFFIX < "$SERVICE_DIR/.label-suffix" || true
+  LABEL_SUFFIX=${LABEL_SUFFIX#.}
+  [ -z "$LABEL_SUFFIX" ] || [[ "$LABEL_SUFFIX" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || fail 'Неверный systemd/.label-suffix.'
+  LABEL_SUFFIX=${LABEL_SUFFIX:+.$LABEL_SUFFIX}
+fi
+APP_UNIT="ru.planfact.mvp.app$LABEL_SUFFIX.service"
+BACKUP_UNIT="ru.planfact.mvp.backup$LABEL_SUFFIX.service"
+PG_UNIT="ru.planfact.mvp.postgres$LABEL_SUFFIX.service"
+
+# Настройки стенда из config.env плюс хранилище версии на Django.
+load_django_config() {
+  [ -f "$STAND/config.env" ] && [ ! -L "$STAND/config.env" ] || fail 'Не найден обычный файл config.env стенда.'
+  set -a
+  # shellcheck disable=SC1091
+  . "$STAND/config.env"
+  set +a
+  export PLANFACT_HOME="$STAND"
+  [ "${NODE_ENV:-}" = development ] || fail 'В config.env требуется NODE_ENV=development.'
+  [ "${PLAN_FACT_AUTH_MODE:-}" = access-code ] || fail 'Версия на Django работает только со входом по личным кодам (PLAN_FACT_AUTH_MODE=access-code).'
+  [ "${PLAN_FACT_HOST:-}" = 127.0.0.1 ] || fail 'Сервер должен слушать только 127.0.0.1.'
+  [[ "${PLAN_FACT_PORT:-}" =~ ^[0-9]{1,5}$ ]] || fail 'В config.env неверный номер порта.'
+  # Путь к SQLite нужен только переносу данных: серверу на Django его не передаём.
+  SQLITE_DATABASE=${PLAN_FACT_DATABASE:-}
+  unset PLAN_FACT_DATABASE
+  export PLAN_FACT_STORAGE_DRIVER=postgres
+  export PLAN_FACT_DATABASE_URL="postgres://:$PG_PORT/$PG_DATABASE?host=$PG_SOCKET_DIR"
+  # Пробный сервер при установке работает на запасном порту рядом с прежним (install-django.sh).
+  if [ -n "${PLANFACT_DJANGO_SERVE_PORT:-}" ]; then
+    export PLAN_FACT_PORT=$PLANFACT_DJANGO_SERVE_PORT
+  fi
+  PLAN_FACT_BUILD_COMMIT=$(version_value commit)
+  export PLAN_FACT_BUILD_COMMIT
+}
+
+# Значение из файла VERSION установленного комплекта: version_value commit → d477faa…
+version_value() {
+  local file=${2:-$DJANGO_HOME/VERSION}
+  [ -f "$file" ] || { printf 'unknown\n'; return; }
+  sed -n "s/^$1=//p" "$file" | head -n 1
+}
+
+# Программы PostgreSQL: с библиотеками из комплекта, если каких-то нет в системе.
+pg_tool() {
+  local name=$1
+  shift
+  if [ -d "$PG_LIBS" ] && [ -n "$(ls -A "$PG_LIBS" 2>/dev/null)" ]; then
+    LD_LIBRARY_PATH="$PG_LIBS" "$PG_BIN/$name" "$@"
+  else
+    "$PG_BIN/$name" "$@"
+  fi
+}
+
+# Подключение программ PostgreSQL к базе стенда; переменные PG* из окружения не учитываются.
+pg_client_env() {
+  unset PGUSER PGPASSWORD PGPASSFILE PGSERVICE PGSERVICEFILE PGSSLMODE PGOPTIONS
+  export PGHOST="$PG_SOCKET_DIR" PGPORT="$PG_PORT" PGDATABASE="$PG_DATABASE" PGCONNECT_TIMEOUT=10
+}
+
+user_systemctl() { systemctl --user "$@"; }
+
+# Отрисовка шаблона службы: {{STAND}}, {{DJANGO_BIN}}, {{LOGS}}, {{PG_UNIT}}.
+render_unit() {
+  local template=$1 target=$2 temporary
+  temporary=$(mktemp "$UNIT_DIR/.unit.XXXXXX")
+  sed -e "s|{{STAND}}|$STAND|g" -e "s|{{DJANGO_BIN}}|$DJANGO_BIN|g" -e "s|{{LOGS}}|$STAND/logs|g" \
+    -e "s|{{PG_UNIT}}|$PG_UNIT|g" "$template" > "$temporary"
+  chmod 600 "$temporary"
+  mv -f -- "$temporary" "$target"
+}
+
+# Ждёт ответа 200 от /api/ready на порту стенда. wait_ready <порт> <секунд>
+wait_ready() {
+  local port=$1 seconds=$2 code=000 i
+  for ((i = 0; i < seconds; i++)); do
+    code=$(curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 3 "http://127.0.0.1:$port/api/ready") || code=000
+    [ "$code" = 200 ] && return 0
+    sleep 1
+  done
+  printf 'Сервер на порту %s не ответил готовностью за %s с (последний ответ HTTP %s).\n' "$port" "$seconds" "$code" >&2
+  return 1
+}
+
+# Целостная копия базы SQLite прежнего сервера (штатное копирование SQLite, работает и при запущенном
+# сервере) с проверкой integrity_check. sqlite_snapshot <база> <копия>
+sqlite_snapshot() {
+  python3 - "$1" "$2" <<'PY'
+import os, sqlite3, sys
+source_path, target_path = sys.argv[1], sys.argv[2]
+source = sqlite3.connect(f"file:{source_path}?mode=ro", uri=True)
+target = sqlite3.connect(target_path)
+with target:
+    source.backup(target)
+source.close()
+result = target.execute("PRAGMA integrity_check").fetchone()[0]
+target.close()
+os.chmod(target_path, 0o600)
+if result != "ok":
+    sys.exit(f"Копия базы SQLite не прошла проверку целостности: {result}")
+PY
+}
+
+private_dir() {
+  mkdir -p -- "$@"
+  chmod 700 "$@"
+}
+
+# Один процесс обслуживания базы: обновление, восстановление или резервная копия.
+maintenance_lock() {
+  private_dir "$STAND/run"
+  exec 9> "$STAND/run/postgres-maintenance.lock"
+  flock -w 60 9 || fail 'Уже выполняется обслуживание PostgreSQL.'
+}
+
+pg_safety_dump() {
+  local target=$1 temporary="$1.tmp.$$"
+  [ ! -e "$target" ] || fail "Копия уже существует: $target"
+  private_dir "$(dirname -- "$target")"
+  if ! pg_tool pg_dump --format=custom --no-owner --file "$temporary" "$PG_DATABASE"; then
+    rm -f -- "$temporary"; return 1
+  fi
+  if ! pg_tool pg_restore --list "$temporary" > /dev/null; then
+    rm -f -- "$temporary"; return 1
+  fi
+  chmod 600 "$temporary"
+  mv -- "$temporary" "$target"
+}
+
+database_summary() {
+  (
+    export PLAN_FACT_DATABASE_URL="postgres://:$PG_PORT/$1?host=$PG_SOCKET_DIR"
+    cd -- "${SUMMARY_CODE:-$DJANGO_CODE}"
+    "${SUMMARY_PYTHON:-$DJANGO_VENV/bin/python}" manage.py state_summary
+  )
+}
+state_summary() { database_summary "$PG_DATABASE"; }
+
+build_venv() {
+  local bundle=$1 destination=$2 pip_wheel
+  python3 -m venv --without-pip "$destination/venv"
+  pip_wheel=$(find "$bundle/wheels/bootstrap" -name 'pip-*.whl' | head -n 1)
+  [ -n "$pip_wheel" ] || fail 'В комплекте нет pip.'
+  "$destination/venv/bin/python" "$pip_wheel/pip" install --quiet --no-index --no-cache-dir --disable-pip-version-check \
+    --find-links "$bundle/wheels" -r "$bundle/backend_django/requirements.txt"
+  "$destination/venv/bin/python" -c 'import django, gunicorn, ada_url; from psycopg import pq; assert pq.__impl__ == "binary"'
+}
+
+copy_code() {
+  local bundle=$1 destination=$2
+  cp -R "$bundle/backend_django" "$destination/backend_django"
+  mkdir -p "$destination/bin" "$destination/systemd"
+  cp "$bundle"/deploy/linux/django/*.sh "$destination/bin/"
+  cp "$bundle"/deploy/linux/django/systemd/*.template "$destination/systemd/"
+  cp "$bundle/VERSION" "$destination/VERSION"
+  chmod 700 "$destination/bin/"*.sh
+}
+
+# Настоящее чтение дампа во временную базу с проверкой состояния и таблиц.
+check_dump() {
+  local dump=$1 summary=$2 temporary_db="${PG_DATABASE}_check_$(date +%s)_$RANDOM"
+  pg_tool pg_restore --list "$dump" > /dev/null || return 1
+  pg_tool createdb --template=template0 "$temporary_db" || return 1
+  if ! pg_tool pg_restore --exit-on-error --single-transaction --no-owner --no-privileges --dbname="$temporary_db" "$dump"; then
+    pg_tool dropdb --if-exists "$temporary_db"; return 1
+  fi
+  if ! database_summary "$temporary_db" > "$summary"; then
+    pg_tool dropdb --if-exists "$temporary_db"; return 1
+  fi
+  pg_tool dropdb "$temporary_db"
+  chmod 600 "$summary"
+}
+
+terminate_database_connections() {
+  local database=$1
+  [[ "$database" =~ ^[a-z][a-z0-9_]{0,62}$ ]] || fail 'Некорректное имя базы.'
+  pg_tool psql --no-psqlrc --dbname=postgres --set=ON_ERROR_STOP=1 --quiet --output=/dev/null \
+    --command "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='$database' AND pid<>pg_backend_pid()"
+}
+
+# Вызывается только при остановленных приложении и резервном копировании.
+# Прежняя база сохраняется под другим именем; при сбое переименования возвращается.
+restore_db_from_dump() {
+  local dump=$1 temporary_db="${PG_DATABASE}_restore_$(date +%s)_$RANDOM"
+  RESTORED_PREVIOUS_DATABASE="${PG_DATABASE}_before_$(date +%s)_$RANDOM"
+  pg_tool createdb --template=template0 "$temporary_db" || return 1
+  if ! pg_tool pg_restore --exit-on-error --single-transaction --no-owner --no-privileges --dbname="$temporary_db" "$dump"; then
+    pg_tool dropdb --if-exists "$temporary_db"; return 1
+  fi
+  if ! database_summary "$temporary_db"; then
+    pg_tool dropdb --if-exists "$temporary_db"; return 1
+  fi
+  terminate_database_connections "$PG_DATABASE"
+  pg_tool psql --no-psqlrc --dbname=postgres --set=ON_ERROR_STOP=1 --command "ALTER DATABASE $PG_DATABASE RENAME TO $RESTORED_PREVIOUS_DATABASE" || return 1
+  if ! pg_tool psql --no-psqlrc --dbname=postgres --set=ON_ERROR_STOP=1 --command "ALTER DATABASE $temporary_db RENAME TO $PG_DATABASE"; then
+    pg_tool psql --no-psqlrc --dbname=postgres --set=ON_ERROR_STOP=1 --command "ALTER DATABASE $RESTORED_PREVIOUS_DATABASE RENAME TO $PG_DATABASE"
+    return 1
+  fi
+  say "Прежняя база сохранена как $RESTORED_PREVIOUS_DATABASE."
+}
