+def _release_forecast_ticket(nxt: dict, payload: dict, now: str) -> None:
+    ticket = _find(nxt["forecastTickets"], lambda item: strict_eq(og(item, "id"), _p(payload, "ticketId")))
+    if ticket is None:
+        raise DomainError("Прогнозный тикет не найден")
+    reason = clean_text(_p(payload, "reason"), 500)
+    if not reason:
+        raise DomainError("Укажите причину освобождения резерва")
+    releasable = [allocation for allocation in ticket["allocations"] if og(allocation, "lifecycle") in ("active", "review")]
+    if not releasable:
+        raise DomainError("В тикете нет активного резерва")
+    for allocation in releasable:
+        period_locks.assert_month_editable(nxt, _month_key(og(allocation, "expectedDate")))
+        allocation["lifecycle"] = "released"
+        allocation["lifecycleSource"] = "manual"
+        allocation["releaseReason"] = reason
+    ticket["lifecycle"] = expense_import.ticket_lifecycle(ticket["allocations"])
+    ticket["updatedAt"] = now
+    ticket["updatedBy"] = _author(payload)
+    _push_history(ticket, {"changedAt": now, "changedBy": ticket["updatedBy"], "action": "forecast-release", "reason": reason})
