+++ b/junk/padolskiye/plan_fact_minipc/scripts/pilot-preflight.mjs
@@ -0,0 +1,91 @@
+import { spawnSync } from "node:child_process";
+import process from "node:process";
+
+const allowPostgresSkips = process.argv.includes("--allow-postgres-skips");
+const requiredVariables = [
+  "PLAN_FACT_TEST_DATABASE_URL",
+  "PLAN_FACT_MIGRATION_TEST_DATABASE_URL",
+  "PLAN_FACT_MULTI_INSTANCE_TEST_URLS"
+];
+
+function assertLocalPostgresUrl(name, raw) {
+  const value = String(raw || "").trim();
+  if (!value) return false;
+  const url = new URL(value);
+  const localHost = url.hostname === "127.0.0.1" || url.hostname === "localhost";
+  if (!localHost || !url.pathname.endsWith("_test")) {
+    throw new Error(`${name} должен указывать на локальную БД с именем *_test`);
+  }
+  return true;
+}
+
+function assertLocalHttpUrls(name, raw) {
+  const values = String(raw || "")
+    .split(",")
+    .map((value) => value.trim())
+    .filter(Boolean);
+  if (!values.length) return false;
+  if (values.length !== 2) throw new Error(`${name} должен содержать два URL`);
+  for (const value of values) {
+    const url = new URL(value);
+    if (url.protocol !== "http:" || !["127.0.0.1", "localhost"].includes(url.hostname)) {
+      throw new Error(`${name} разрешает только локальные HTTP URL`);
+    }
+  }
+  return true;
+}
+
+function validateEnvironment(env = process.env) {
+  const present = {
+    PLAN_FACT_TEST_DATABASE_URL: assertLocalPostgresUrl(
+      "PLAN_FACT_TEST_DATABASE_URL",
+      env.PLAN_FACT_TEST_DATABASE_URL
+    ),
+    PLAN_FACT_MIGRATION_TEST_DATABASE_URL: assertLocalPostgresUrl(
+      "PLAN_FACT_MIGRATION_TEST_DATABASE_URL",
+      env.PLAN_FACT_MIGRATION_TEST_DATABASE_URL
+    ),
+    PLAN_FACT_MULTI_INSTANCE_TEST_URLS: assertLocalHttpUrls(
+      "PLAN_FACT_MULTI_INSTANCE_TEST_URLS",
+      env.PLAN_FACT_MULTI_INSTANCE_TEST_URLS
+    )
+  };
+  return requiredVariables.filter((name) => !present[name]);
+}
+
+function run(command, args) {
+  const printable = [command, ...args].join(" ");
+  process.stdout.write(`\n[pilot-preflight] ${printable}\n`);
+  const result = spawnSync(command, args, {
+    cwd: process.cwd(),
+    env: process.env,
+    stdio: "inherit"
+  });
+  if (result.error) throw result.error;
+  if (result.status !== 0) {
+    throw new Error(`${printable} завершилась с кодом ${result.status ?? "unknown"}`);
+  }
+}
+
+try {
+  const missing = validateEnvironment();
+  if (missing.length && !allowPostgresSkips) {
+    throw new Error(
+      `Не настроены обязательные локальные контуры: ${missing.join(", ")}. `
+      + "Для проверки только исходников используйте npm run pilot:preflight:source."
+    );
+  }
+  if (missing.length) {
+    process.stdout.write(
+      `[pilot-preflight] Проверка исходников: PostgreSQL-контуры будут пропущены (${missing.join(", ")}).\n`
+    );
+  }
+
+  run("npm", ["run", "check"]);
+  run("npm", ["run", "nots:build"]);
+  run("npm", ["run", "nots:test"]);
+  process.stdout.write("\n[pilot-preflight] Все запрошенные проверки прошли.\n");
+} catch (error) {
+  process.stderr.write(`\n[pilot-preflight] ОШИБКА: ${error.message}\n`);
+  process.exitCode = 1;
+}
