+#!/usr/bin/env python3
+"""Проверка стенда по HTTP для репетиций переключения (задача 41): вход личным кодом, данные, выход.
+
+Только для учебных стендов с выдуманными людьми: код читается из файла (первая строка) и на экран
+не выводится. Печатает ревизию, число записей и SHA-256 данных, которые видит пользователь, — по ним
+сравниваются прежний сервер и сервер на Django. С --write ещё и меняет название первой локации
+и возвращает его обратно (две новые ревизии).
+
+Использование: python3 rehearsal-check.py --port 18767 --login alice --code-file ~/PlanFactMVP/codes/alice.txt [--write]
+"""
+
+import argparse
+import hashlib
+import json
+import sys
+import urllib.error
+import urllib.request
+import uuid
+
+
+def call(base: str, method: str, path: str, body=None, cookie: str | None = None):
+    data = None if body is None else json.dumps(body).encode()
+    request = urllib.request.Request(base + path, data=data, method=method)
+    request.add_header("Origin", base)
+    if data is not None:
+        request.add_header("Content-Type", "application/json")
+    if cookie:
+        request.add_header("Cookie", cookie)
+    try:
+        with urllib.request.urlopen(request, timeout=30) as response:
+            return response.status, response.headers, json.loads(response.read() or b"null")
+    except urllib.error.HTTPError as error:
+        return error.code, error.headers, json.loads(error.read() or b"null")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--port", type=int, required=True)
+    parser.add_argument("--login", required=True)
+    parser.add_argument("--code-file", required=True)
+    parser.add_argument("--write", action="store_true")
+    args = parser.parse_args()
+    base = f"http://127.0.0.1:{args.port}"
+    with open(args.code_file, encoding="utf-8") as file:
+        code = file.readline().strip()
+
+    status, headers, _ = call(base, "POST", "/api/login", {"login": args.login, "code": code})
+    if status != 200:
+        print(f"вход: HTTP {status}")
+        return 1
+    cookie = headers.get("Set-Cookie", "").split(";", 1)[0]
+    status, _, auth = call(base, "GET", "/api/auth", cookie=cookie)
+    status_state, _, body = call(base, "GET", "/api/state", cookie=cookie)
+    if status != 200 or status_state != 200 or auth["user"]["staffLogin"] != args.login:
+        print(f"данные: /api/auth HTTP {status}, /api/state HTTP {status_state}")
+        return 1
+    state = body["state"]
+    counts = {key: len(value) for key, value in sorted(state.items()) if isinstance(value, list)}
+    digest = hashlib.sha256(json.dumps(body, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+    print(f"вход {args.login}: 200; ревизия {state['revision']}; записи {counts}")
+    print(f"SHA-256 данных пользователя: {digest}")
+
+    if args.write:
+        location = state["locations"][0]
+        revision = state["revision"]
+        for name in (location["name"] + " (проверка)", location["name"]):
+            payload = {"id": location["id"], "name": name, "code": location.get("code", "")}
+            status, _, result = call(base, "POST", "/api/mutate", {
+                "type": "updateLocation", "baseRevision": revision, "mutationId": str(uuid.uuid4()), "payload": payload,
+            }, cookie=cookie)
+            if status != 200:
+                print(f"изменение: HTTP {status} {result}")
+                return 1
+            revision = result["state"]["revision"]
+        print(f"изменение и возврат названия локации: 200, ревизия {revision}")
+
+    status, _, _ = call(base, "POST", "/api/logout", {}, cookie=cookie)
+    status_after, _, _ = call(base, "GET", "/api/auth", cookie=cookie)
+    print(f"выход: {status}; /api/auth после выхода: {status_after}")
+    return 0 if status == 200 and status_after == 401 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
