+            raise DomainError("Связанный с прогнозом факт нельзя переносить в другой квартал")
+        if (strict_ne(_p(payload, "locationId"), og(linked_allocation, "locationId"))
+                or strict_ne(_p(payload, "articleId"), og(linked_allocation, "articleId"))
+                or strict_ne(resolved, og(linked_allocation, "subarticleId"))
+                or strict_ne(normalize_currency_code(_p(payload, "currency")), og(linked_allocation, "currency"))):
+            raise DomainError("Локация, статья и валюта связанного факта должны совпадать с прогнозом")
+    previous = {
+        "locationId": og(expense, "locationId"),
+        "articleId": og(expense, "articleId"),
+        "subarticleId": og(expense, "subarticleId"),
+        "currency": og(expense, "currency"),
+        "amount": og(expense, "amount"),
+        "ticketUrl": og(expense, "ticketUrl"),
+        "comment": og(expense, "comment"),
+        "expenseDate": og(expense, "expenseDate"),
+    }
+    expense["locationId"] = _p(payload, "locationId")
+    expense["articleId"] = _p(payload, "articleId")
+    expense["subarticleId"] = resolved
+    expense["currency"] = normalize_currency_code(_p(payload, "currency"))
+    expense["amount"] = to_number(_p(payload, "amount"))
+    expense["ticketUrl"] = safe_http_url(_p(payload, "ticketUrl"))
+    expense["comment"] = clean_text(_p(payload, "comment"), 500)
+    expense["expenseDate"] = _p(payload, "expenseDate")
+    expense["quarterKey"] = quarter_key_from_date_input(_p(payload, "expenseDate"))
+    expense["updatedAt"] = now
+    expense["updatedBy"] = _author(payload)
+    expense["history"].append({"changedAt": now, "changedBy": expense["updatedBy"], "previous": previous})
+    if linked_ticket is not None and linked_allocation is not None:
+        refresh_forecast_conversion_state(nxt, linked_ticket, linked_allocation)
