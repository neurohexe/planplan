@@ -0,0 +1,215 @@
+"""Перенос данных из базы SQLite прежнего сервера (Node) в PostgreSQL.
+
+Переносятся бизнес-данные (документ состояния с ревизией), пользователи и права по локациям, коды
+доступа (выданные коды продолжают работать: в базе только хэши с параметрами), журнал, личные
+скрытия предупреждений и задания синхронизации. Сессии по умолчанию не переносятся — люди входят
+заново своими кодами; блокировки записей и роли IDM не переносятся.
+
+База SQLite открывается только на чтение. Если в PostgreSQL уже есть данные, перенос останавливается;
+--replace заменяет их целиком.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import sqlite3
+import sys
+from pathlib import Path
+
+from django.core.management.base import BaseCommand
+from django.db import connection, transaction
+
+from planfact.domain import js
+from planfact.models import (
+    AccessCode, AppSession, AppUser, ApplicationState, AuditEvent, PersonalWarningState, SyncJob, UserLocationAccess,
+)
+from planfact.store import from_iso
+
+REQUIRED_TABLES = ("application_state", "users", "user_location_access", "sessions", "access_codes", "audit_events",
+                   "personal_warning_state", "sync_jobs")
+TARGET_TABLES = ("audit_events", "edit_locks", "personal_warning_state", "sync_jobs", "access_codes", "sessions",
+                 "user_location_access", "users", "application_state")
+
+
+class ImportProblem(Exception):
+    pass
+
+
+def _time(value, column: str):
+    if value is None:
+        return None
+    try:
+        return from_iso(str(value))
+    except ValueError:
+        raise ImportProblem(f"Некорректное время в колонке {column}: {value!r}") from None
+
+
+def _json(value, column: str):
+    if value is None:
+        return None
+    try:
+        return js.loads(value)
+    except ValueError:
+        raise ImportProblem(f"Некорректный JSON в колонке {column}") from None
+
+
+def _text(value):
+    return None if value is None else str(value)
+
+
+class Command(BaseCommand):
+    help = "Перенести данные из базы SQLite прежнего сервера в PostgreSQL"
+
+    def add_arguments(self, parser) -> None:
+        parser.add_argument("sqlite_path", help="путь к plan-fact.sqlite")
+        parser.add_argument("--replace", action="store_true", help="заменить данные, которые уже есть в PostgreSQL")
+        parser.add_argument("--discard-newer-postgres", action="store_true", help="явно разрешить потерю более новых данных PostgreSQL")
+        parser.add_argument("--with-sessions", action="store_true", help="перенести и действующие сессии (люди не войдут заново)")
+        parser.add_argument("--dry-run", action="store_true", help="только проверить базу и показать, что будет перенесено")
+
+    def handle(self, *args, **options) -> None:
+        try:
+            summary = self._import(Path(options["sqlite_path"]).expanduser(), options)
+        except ImportProblem as problem:
+            sys.stderr.write(f"Перенос не выполнен: {problem}\n")
+            sys.exit(1)
+        for line in summary:
+            self.stdout.write(line)
+
+    def _import(self, path: Path, options: dict) -> list[str]:
+        if not path.is_file():
+            raise ImportProblem(f"файл базы не найден: {path}")
+        source = sqlite3.connect(f"file:{path.resolve()}?mode=ro", uri=True)
+        source.row_factory = sqlite3.Row
+        try:
+            tables = {row["name"] for row in source.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
+            missing = [table for table in REQUIRED_TABLES if table not in tables]
+            if missing:
+                raise ImportProblem(f"в базе нет таблиц {', '.join(missing)} — это не база сервера «План Факт»")
+            integrity = source.execute("PRAGMA integrity_check").fetchone()[0]
+            if integrity != "ok":
+                raise ImportProblem(f"проверка целостности SQLite не пройдена: {integrity}")
+            data = {table: [dict(row) for row in source.execute(f"SELECT * FROM {table}")] for table in REQUIRED_TABLES}
+            idm_roles = source.execute("SELECT count(*) FROM idm_roles").fetchone()[0] if "idm_roles" in tables else 0
+            edit_locks = source.execute("SELECT count(*) FROM edit_locks").fetchone()[0] if "edit_locks" in tables else 0
+        finally:
+            source.close()
+
+        if len(data["application_state"]) != 1:
+            raise ImportProblem("в базе нет строки состояния application_state")
+        state_row = data["application_state"][0]
+        state_text = state_row["body_json"]
+        state = _json(state_text, "application_state.body_json")
+        state_hash = hashlib.sha256(state_text.encode("utf-8")).hexdigest()
+        roundtrip = js.dumps(state) == state_text
+        sessions = data["sessions"] if options["with_sessions"] else []
+        summary = [
+            f"База SQLite: {path}",
+            f"Ревизия {state_row['revision']}, схема {state_row['schema_version']}, SHA-256 состояния {state_hash}",
+            f"Пользователей {len(data['users'])}, прав по локациям {len(data['user_location_access'])}, "
+            f"кодов доступа {len(data['access_codes'])}, записей журнала {len(data['audit_events'])}, "
+            f"скрытых предупреждений {len(data['personal_warning_state'])}, заданий {len(data['sync_jobs'])}",
+            f"Сессий {len(data['sessions'])} (переносится {len(sessions)}); не переносятся: блокировок записей {edit_locks}, "
+            f"ролей IDM {idm_roles}",
+        ]
+        if not roundtrip:
+            summary.append("Внимание: текст состояния после переноса будет записан в каноническом виде JSON (данные те же).")
+        if options["dry_run"]:
+            summary.append("Проверка без записи (--dry-run): PostgreSQL не менялся.")
+            return summary
+
+        occupied = AppUser.objects.exists() or AuditEvent.objects.exists() or ApplicationState.objects.filter(revision__gt=0).exists()
+        if occupied and not options["replace"]:
+            raise ImportProblem("в PostgreSQL уже есть данные. Чтобы заменить их данными из SQLite, запустите с --replace")
+
+        with transaction.atomic():
+            current = ApplicationState.objects.select_for_update().filter(singleton=1).first()
+            source_ids = [row["id"] for row in data["audit_events"]]
+            newer_events = AuditEvent.objects.exclude(id__in=source_ids).count()
+            current_revision = current.revision if current else 0
+            if (current_revision > int(state_row["revision"]) or newer_events) and not options["discard_newer_postgres"]:
+                raise ImportProblem(
+                    f"PostgreSQL содержит более новые данные: ревизия {current_revision}, SQLite {state_row['revision']}, "
+                    f"новых записей журнала {newer_events}. Сначала сохраните дамп; для явного удаления нужен --discard-newer-postgres"
+                )
+            summary.append(f"До переноса: пользователей {AppUser.objects.count()}, записей журнала {AuditEvent.objects.count()}")
+            if occupied or ApplicationState.objects.exists():
+                with connection.cursor() as cursor:
+                    # TRUNCATE не вызывает построчных триггеров, запрещающих удалять записи журнала.
+                    cursor.execute(f"TRUNCATE {', '.join(TARGET_TABLES)} RESTART IDENTITY CASCADE")
+            ApplicationState.objects.create(
+                singleton=1, revision=int(state_row["revision"]), schema_version=int(state_row["schema_version"]),
+                body_json=state,
+                updated_at=_time(state_row["updated_at"], "application_state.updated_at"),
+            )
+            AppUser.objects.bulk_create([
+                AppUser(
+                    id=row["id"], name=row["name"], name_key=row["name_key"], staff_login=row["staff_login"],
+                    staff_uid=row["staff_uid"], role=row["role"], default_location_access=row["default_location_access"] or "hidden",
+                    active=bool(row["active"]), created_at=_time(row["created_at"], "users.created_at"),
+                    created_by_id=row["created_by_id"], updated_at=_time(row["updated_at"], "users.updated_at"),
+                    updated_by_id=row["updated_by_id"],
+                )
+                for row in data["users"]
+            ])
+            UserLocationAccess.objects.bulk_create([
+                UserLocationAccess(user_id=row["user_id"], location_id=row["location_id"], access=row["access"])
+                for row in data["user_location_access"]
+            ])
+            AccessCode.objects.bulk_create([
+                AccessCode(
+                    user_id=row["user_id"], code_hash=row["code_hash"], salt=row["salt"], kdf_params=row["kdf_params"],
+                    issued_at=_time(row["issued_at"], "access_codes.issued_at"), failed_attempts=int(row["failed_attempts"] or 0),
+                    locked_until=_time(row["locked_until"], "access_codes.locked_until"),
+                    last_failed_at=_time(row["last_failed_at"], "access_codes.last_failed_at"),
+                )
+                for row in data["access_codes"]
+            ])
+            AppSession.objects.bulk_create([
+                AppSession(
+                    id=row["id"], user_id=row["user_id"], token_hash=row["token_hash"],
+                    created_at=_time(row["created_at"], "sessions.created_at"),
+                    last_seen_at=_time(row["last_seen_at"], "sessions.last_seen_at"),
+                    expires_at=_time(row["expires_at"], "sessions.expires_at"), ip=row["ip"], user_agent=row["user_agent"],
+                    auth_mode=row.get("auth_mode") or "legacy", auth_role=row.get("auth_role"),
+                    auth_expires_at=_time(row.get("auth_expires_at"), "sessions.auth_expires_at"),
+                )
+                for row in sessions
+            ])
+            AuditEvent.objects.bulk_create([
+                AuditEvent(
+                    id=row["id"], revision=row["revision"], actor_id=row["actor_id"], actor_name=row["actor_name"],
+                    session_id=_text(row["session_id"]), action=row["action"], mutation_id=_text(row["mutation_id"]),
+                    entity_type=_text(row["entity_type"]), entity_id=_text(row["entity_id"]),
+                    location_id=_text(row.get("location_id")),
+                    payload_json=_json(row["payload_json"], "audit_events.payload_json"),
+                    before_json=_json(row["before_json"], "audit_events.before_json"),
+                    after_json=_json(row["after_json"], "audit_events.after_json"),
+                    reverses_event_id=row["reverses_event_id"], created_at=_time(row["created_at"], "audit_events.created_at"),
+                )
+                for row in sorted(data["audit_events"], key=lambda item: (item["created_at"], item["id"]))
+            ], batch_size=500)
+            PersonalWarningState.objects.bulk_create([
+                PersonalWarningState(user_id=row["user_id"], warning_id=row["warning_id"], fingerprint=row["fingerprint"],
+                                     hidden_at=_time(row["hidden_at"], "personal_warning_state.hidden_at"))
+                for row in data["personal_warning_state"]
+            ])
+            SyncJob.objects.bulk_create([
+                SyncJob(
+                    id=row["id"], kind=row["kind"], status=row["status"], requested_by_id=row["requested_by_id"],
+                    session_id=_text(row["session_id"]), scope_json=_json(row["scope_json"], "sync_jobs.scope_json"),
+                    result_json=_json(row["result_json"], "sync_jobs.result_json"), error_text=row["error_text"],
+                    created_at=_time(row["created_at"], "sync_jobs.created_at"),
+                    started_at=_time(row["started_at"], "sync_jobs.started_at"),
+                    finished_at=_time(row["finished_at"], "sync_jobs.finished_at"),
+                    cancel_if_session_ends=bool(row["cancel_if_session_ends"]),
+                )
+                for row in data["sync_jobs"]
+            ])
+            stored = ApplicationState.objects.get(singleton=1)
+            if js.dumps(stored.body_json) != js.dumps(state):
+                raise ImportProblem("Состояние после переноса отличается: все изменения PostgreSQL отменены")
+        stored_hash = hashlib.sha256(js.dumps(stored.body_json).encode("utf-8")).hexdigest()
+        summary.append(f"Перенесено в PostgreSQL. SHA-256 состояния после переноса {stored_hash}"
+                       + (" — совпадает с исходным." if stored_hash == state_hash else " — совпадает после приведения к единой записи."))
+        return summary
