--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/backend_django/planfact/config.py
@@ -0,0 +1,181 @@
+"""Настройки сервера из переменных PLAN_FACT_* (перенос backend/src/config.js).
+
+Имена переменных прежние, поэтому config.env стенда подходит с двумя отличиями: хранилище теперь
+PostgreSQL (PLAN_FACT_DATABASE_URL), а вход — только по личным кодам (PLAN_FACT_AUTH_MODE=access-code).
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass, field
+from pathlib import Path
+from urllib.parse import parse_qs, unquote, urlsplit
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+from planfact.errors import AppError
+
+ACCESS_CODE_AUTH_MODE = "access-code"
+BACKEND_DIR = Path(__file__).resolve().parents[1]
+REPO_DIR = BACKEND_DIR.parent
+
+
+def integer(value: str | None, fallback: int, minimum: int = 0, maximum: int = 2**53 - 1) -> int:
+    text = str(value if value is not None else "").strip()
+    sign = 1
+    digits = ""
+    if text[:1] in "+-" and text[:1]:
+        sign = -1 if text[0] == "-" else 1
+        text = text[1:]
+    for ch in text:
+        if not ch.isdigit() or not ch.isascii():
+            break
+        digits += ch
+    if not digits:
+        return fallback
+    return min(maximum, max(minimum, sign * int(digits)))
+
+
+def boolean(value: str | None, fallback: bool = False) -> bool:
+    if value is None or value == "":
+        return fallback
+    return str(value).lower() in ("1", "true", "yes", "on")
+
+
+def metadata(value: str | None, fallback: str = "unknown") -> str:
+    normalized = str(value or "").strip()
+    return (normalized or fallback)[:200]
+
+
+def access_codes_directory(env: dict | os._Environ = os.environ) -> Path:
+    """Каталог личных кодов: PLAN_FACT_CODES_DIR, по умолчанию ~/PlanFactMVP/codes."""
+    return Path(env.get("PLAN_FACT_CODES_DIR") or Path.home() / "PlanFactMVP" / "codes").expanduser().resolve()
+
+
+def time_zone(env: dict | os._Environ = os.environ) -> str:
+    name = env.get("PLAN_FACT_TIME_ZONE")
+    if not name:
+        path = str(Path("/etc/localtime").resolve())
+        name = path.split("/zoneinfo/", 1)[-1] if "/zoneinfo/" in path else "UTC"
+    try:
+        ZoneInfo(name)
+    except (ZoneInfoNotFoundError, ValueError):
+        raise AppError("Некорректный PLAN_FACT_TIME_ZONE", 500, "invalid_time_zone") from None
+    return name
+
+
+def database_settings(url: str, *, ssl_mode: str, statement_timeout_ms: int) -> dict:
+    """postgres://user:password@host:port/name?sslmode=… → настройки DATABASES для Django."""
+    parts = urlsplit(url)
+    if parts.scheme not in ("postgres", "postgresql"):
+        raise AppError("PLAN_FACT_DATABASE_URL должен начинаться с postgres:// или postgresql://", 500, "postgres_storage_not_configured")
+    query = {key: values[-1] for key, values in parse_qs(parts.query).items()}
+    options: dict = {"options": f"-c statement_timeout={statement_timeout_ms}"}
+    sslmode = query.pop("sslmode", None) or ssl_mode
+    if sslmode:
+        options["sslmode"] = sslmode
+    for key in ("sslrootcert", "sslcert", "sslkey", "application_name", "connect_timeout", "gssencmode"):
+        if key in query:
+            options[key] = query.pop(key)
+    # Шифрование через GSSAPI (Kerberos) стенду не нужно, а на macOS загруженный им системный Kerberos
+    # роняет рабочий процесс сервера после fork(). Включается явно: ?gssencmode=prefer.
+    options.setdefault("gssencmode", "disable")
+    host = query.pop("host", None) or unquote(parts.hostname or "")
+    return {
+        "ENGINE": "django.db.backends.postgresql",
+        "NAME": unquote(parts.path.lstrip("/")) or "planfact",
+        "USER": unquote(parts.username or ""),
+        "PASSWORD": unquote(parts.password or ""),
+        "HOST": host,
+        "PORT": str(parts.port or ""),
+        "OPTIONS": options,
+        "CONN_MAX_AGE": 60,
+        "CONN_HEALTH_CHECKS": True,
+    }
+
+
+@dataclass(frozen=True)
+class Config:
+    production: bool
+    host: str
+    port: int
+    database_url: str
+    database_ssl: str
+    database_statement_timeout_ms: int
+    storage_driver: str
+    auth_mode: str
+    backend_version: str
+    build_commit: str
+    image_digest: str
+    static_dir: Path | None
+    codes_dir: Path
+    allowed_origins: tuple[str, ...]
+    trusted_proxy_ips: tuple[str, ...]
+    secure_cookies: bool
+    session_max_age_ms: int
+    lock_ttl_ms: int
+    max_request_bytes: int
+    require_locks: bool
+    heartbeat_ms: int
+    threads: int
+    time_zone: str
+    extra: dict = field(default_factory=dict)
+
+
+def load_config(env: dict | os._Environ = os.environ) -> Config:
+    environment = (env.get("PLAN_FACT_ENV") or env.get("NODE_ENV") or "").strip().lower()
+    production = environment == "production"
+    port = integer(env.get("PLAN_FACT_PORT") or env.get("PORT"), 18766, 1, 65535)
+    allowed_origins = [item.strip() for item in str(env.get("PLAN_FACT_ALLOWED_ORIGINS") or "").split(",") if item.strip()]
+    if not allowed_origins and not production:
+        allowed_origins = [f"http://127.0.0.1:{port}", f"http://localhost:{port}"]
+    trusted = [item.strip() for item in str(env.get("PLAN_FACT_TRUSTED_PROXY_IPS") or "").split(",") if item.strip()]
+    static = env.get("PLAN_FACT_STATIC_DIR")
+    return Config(
+        production=production,
+        host=env.get("PLAN_FACT_HOST") or ("0.0.0.0" if production else "127.0.0.1"),
+        port=port,
+        database_url=str(env.get("PLAN_FACT_DATABASE_URL") or env.get("DATABASE_URL") or "").strip(),
+        database_ssl=str(env.get("PLAN_FACT_DATABASE_SSL") or ("verify-full" if production else "disable")).strip().lower(),
+        database_statement_timeout_ms=integer(env.get("PLAN_FACT_DATABASE_STATEMENT_TIMEOUT_MS"), 30_000, 1_000, 300_000),
+        storage_driver=str(env.get("PLAN_FACT_STORAGE_DRIVER") or "postgres").strip().lower(),
+        auth_mode=str(env.get("PLAN_FACT_AUTH_MODE") or ACCESS_CODE_AUTH_MODE).strip().lower(),
+        backend_version=metadata(env.get("PLAN_FACT_BACKEND_VERSION"), "0.2.0-django"),
+        build_commit=metadata(env.get("PLAN_FACT_BUILD_COMMIT")),
+        image_digest=metadata(env.get("PLAN_FACT_IMAGE_DIGEST")),
+        static_dir=Path(static).expanduser().resolve() if static else None,
+        codes_dir=access_codes_directory(env),
+        allowed_origins=tuple(allowed_origins),
+        trusted_proxy_ips=tuple(trusted),
+        secure_cookies=boolean(env.get("PLAN_FACT_SECURE_COOKIES"), production),
+        session_max_age_ms=integer(env.get("PLAN_FACT_SESSION_MAX_AGE_MS"), 24 * 60 * 60 * 1000, 60_000),
+        lock_ttl_ms=integer(env.get("PLAN_FACT_LOCK_TTL_MS"), 120_000, 30_000, 15 * 60_000),
+        max_request_bytes=integer(env.get("PLAN_FACT_MAX_REQUEST_BYTES"), 5 * 1024 * 1024, 1024),
+        require_locks=boolean(env.get("PLAN_FACT_REQUIRE_LOCKS"), True),
+        heartbeat_ms=integer(env.get("PLAN_FACT_EVENTS_HEARTBEAT_MS"), 25_000, 20, 300_000),
+        threads=integer(env.get("PLAN_FACT_THREADS"), 32, 2, 256),
+        time_zone=time_zone(env),
+    )
+
+
+def assert_supported(config: Config) -> None:
+    """Проверки при запуске: понятная ошибка вместо работы в неверном режиме."""
+    if config.auth_mode != ACCESS_CODE_AUTH_MODE:
+        raise AppError(
+            f"Режим входа PLAN_FACT_AUTH_MODE={config.auth_mode} в версии на Django пока не перенесён: "
+            "используйте PLAN_FACT_AUTH_MODE=access-code",
+            500, "auth_mode_not_supported",
+        )
+    if config.production:
+        raise AppError(
+            "Вход по личным кодам (PLAN_FACT_AUTH_MODE=access-code) запрещён в production: "
+            "уберите NODE_ENV=production (PLAN_FACT_ENV=production) или выберите другой режим входа",
+            500, "access_code_mode_production",
+        )
+    if config.storage_driver != "postgres":
+        raise AppError(
+            "Версия на Django хранит данные только в PostgreSQL: задайте PLAN_FACT_STORAGE_DRIVER=postgres "
+            "(или уберите переменную) и PLAN_FACT_DATABASE_URL",
+            500, "storage_driver_not_available",
+        )
+    if not config.database_url:
+        raise AppError("Не задан PLAN_FACT_DATABASE_URL", 500, "postgres_storage_not_configured")
