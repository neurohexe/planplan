+TEST_ROOT=$(mktemp -d "$PROJECT_ROOT/.sandbox/task-10.XXXXXX")
+FINISHED=false
+cleanup() {
+  local status=$?
+  rm -rf -- "$TEST_ROOT"
+  [ "$DIST_EXISTED" = true ] || rm -rf -- "$PROJECT_ROOT/dist"
+  rmdir "$PROJECT_ROOT/.sandbox" 2>/dev/null || true
