+cp "$TEST_ROOT/offsite-last.saved" "$STAND/backups/.offsite-last"
+
+# 9. Перезапуск стенда и повторная установка возвращают включённый таймер; выключение.
+"$STAND/bin/stop.sh" >/dev/null
+"$STAND/bin/start.sh" >/dev/null
+check 'start.sh возвращает в работу включённую копию в Трекер' grep -qx ru.planfact.mvp.offsite.timer "$STATE/active.txt"
