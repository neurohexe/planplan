--- /dev/null
+++ b/junk/padolskiye/plan_fact_minipc/deploy/laptop/test-tunnel.sh
@@ -0,0 +1,584 @@
+#!/bin/bash
+# Тест туннеля без сети и без настоящего launchd. Всё — в собственной .sandbox, на порту 18769.
+# Вместо launchctl, curl, nc, dk и id стоят заглушки: ни dk, ни ssh, ни Tunneler не запускаются,
+# а логины в тесте только вымышленные (alice, bob, carol).
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)
+NODE_BINARY=$(command -v node)
+PASSED=0
+DIST_EXISTED=false
+[ ! -e "$PROJECT_ROOT/dist" ] || DIST_EXISTED=true
+mkdir -p "$PROJECT_ROOT/.sandbox"
+TEST_ROOT=$(mktemp -d "$PROJECT_ROOT/.sandbox/task-09.XXXXXX")
+STAND_A="$TEST_ROOT/стенд А & 'туннель'"
+STAND_B="$TEST_ROOT/stand-b"
+FAKE_HOME="$TEST_ROOT/fake-home"
+STUBS="$TEST_ROOT/stubs"
+LAST="$TEST_ROOT/last-output.txt"
+TUNNEL_A_URL='https://alice-28766-ws1.tunneler-si.yandex.ru'
+FINISHED=false
+cleanup() {
+  local status=$?
+  if [ -f "$STAND_A/data/app.pid" ] && [ -f "$STAND_A/bin/maintenance-server.mjs" ]; then
+    "$NODE_BINARY" "$STAND_A/bin/maintenance-server.mjs" stop-test "$STAND_A" >/dev/null 2>&1 || true
+  fi
+  rm -rf -- "$TEST_ROOT"
+  [ "$DIST_EXISTED" = true ] || rm -rf -- "$PROJECT_ROOT/dist"
+  rmdir "$PROJECT_ROOT/.sandbox" 2>/dev/null || true
+  # bash 3.2 после ошибки «unbound variable» выходит с кодом последней команды ловушки (0): без отметки о завершении это сбой.
+  [ "$FINISHED" = true ] || [ "$status" -ne 0 ] || status=1
+  exit "$status"
+}
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+check() {
+  local title=$1
+  shift
+  "$@" || { printf 'Не пройдена проверка: %s\n' "$title" >&2; exit 1; }
+  PASSED=$((PASSED + 1))
+  printf 'Пройдена проверка %s: %s.\n' "$PASSED" "$title"
+}
+# Запускает команду, сохраняет вывод в $LAST и код возврата в $LAST_STATUS; сам тест при этом не падает.
+run() {
+  LAST_STATUS=0
+  "$@" > "$LAST" 2>&1 || LAST_STATUS=$?
+}
+status_is() { [ "$LAST_STATUS" -eq "$1" ]; }
+status_is_not_zero() { [ "$LAST_STATUS" -ne 0 ]; }
+says() { grep -q -F -- "$1" "$LAST"; }
+does_not_say() { ! grep -q -F -- "$1" "$LAST"; }
+port_is_free() { ! lsof -nP -iTCP:18769 -sTCP:LISTEN >/dev/null 2>&1; }
+file_mode_is() { [ "$(stat -f '%Lp' "$2")" = "$1" ]; }
+log_has() { grep -q -F -- "$2" "$1"; }
+log_lacks() { ! grep -q -F -- "$2" "$1"; }
+
+check 'порт 18769 свободен' port_is_free
+for script in tunnel-common.sh tunnel-run.sh tunnel-check.sh enable-tunnel.sh disable-tunnel.sh test-tunnel.sh; do
+  check "синтаксис $script (bash 3.2)" /bin/bash -n "$SCRIPT_DIR/$script"
+done
+
+# --- заглушки ----------------------------------------------------------------------------------------------
+mkdir "$STUBS"
+export STUB_DIR="$STUBS"
+cat > "$STUBS/launchctl" <<'SH'
+#!/bin/bash
+# Без STUB_LAUNCHCTL_DIR любое обращение к launchd — ошибка теста. С ним — модель загруженных агентов.
+[ -n "${STUB_LAUNCHCTL_DIR:-}" ] || { printf 'Недопустимое обращение к launchd в тесте.\n' >&2; exit 99; }
+printf '%s\n' "$*" >> "$STUB_LAUNCHCTL_DIR/calls.log"
+loaded="$STUB_LAUNCHCTL_DIR/loaded.txt"
+touch "$loaded"
+case "${1:-}" in
+  print) grep -qx -- "${2##*/}" "$loaded" ;;
+  bootout) { grep -vx -- "${2##*/}" "$loaded" || true; } > "$loaded.new"; mv "$loaded.new" "$loaded" ;;
+  bootstrap) basename -- "$3" .plist >> "$loaded" ;;
+  *) exit 98 ;;
+esac
+SH
+cat > "$STUBS/curl" <<'SH'
+#!/bin/bash
+url=''; insecure=no; write_out=no
+for argument in "$@"; do
+  case "$argument" in
+    --insecure) insecure=yes ;;
+    '%{http_code}') write_out=yes ;;
+    http://*|https://*) url=$argument ;;
+  esac
+done
+printf '%s insecure=%s\n' "$url" "$insecure" >> "$STUB_DIR/curl.log"
+case "$url" in
+  *'/api/v1/instances'*)
+    case "${STUB_API:-ok}" in
+      ok) printf '[["2001:db8::1","2022"]]' ;;
+      cert) if [ "$insecure" = yes ]; then printf '[["2001:db8::1","2022"]]'; else exit 60; fi ;;
+      badjson) printf 'это не JSON' ;;
+      bracket) printf '["[2001:db8::1]:2022"]' ;;
+      strings) printf '["ws-test.example:2022"]' ;;
+      *) exit 28 ;;
+    esac
+    exit 0 ;;
+  http://127.0.0.1:*) code=${STUB_LOCAL_CODE:-200} ;;
+  *) [ -z "${STUB_TUNNEL_DELAY:-}" ] || sleep "$STUB_TUNNEL_DELAY"; code=${STUB_TUNNEL_CODE:-200} ;;
+esac
+[ "$code" != CERT ] || exit 60
+[ "$write_out" = no ] || printf '%s' "$code"
+[ "$code" != 000 ] || exit 28
+exit 0
+SH
+cat > "$STUBS/nc" <<'SH'
+#!/bin/bash
+printf '%s\n' "$*" >> "$STUB_DIR/nc.log"
+result=${STUB_NC:-ok}
+[ "${@: -1}" != 2022 ] || result=${STUB_NC_2022:-$result}
+case "$result" in
+  ok) printf 'Connection to %s port %s [tcp/*] succeeded!\n' "${@: -2:1}" "${@: -1}" >&2 ;;
+  timeout) printf 'nc: connectx to %s port %s (tcp) failed: Operation timed out\n' "${@: -2:1}" "${@: -1}" >&2; exit 1 ;;
+  dns) printf 'nc: getaddrinfo for host "%s" port %s: nodename nor servname provided, or not known\n' "${@: -2:1}" "${@: -1}" >&2; exit 1 ;;
+  refused) printf 'nc: connectx to %s port %s (tcp) failed: Connection refused\n' "${@: -2:1}" "${@: -1}" >&2; exit 1 ;;
+esac
+SH
+cat > "$STUBS/id" <<'SH'
+#!/bin/bash
+if [ "$#" -eq 1 ] && [ "$1" = -un ]; then printf 'carol\n'; exit 0; fi
+exec /usr/bin/id "$@"
+SH
+cat > "$STUBS/dk" <<'SH'
+#!/bin/bash
+[ "${1:-}" != --version ] || { printf '@yandex-int/devkit/0.5.2 darwin-arm64 node-v22.23.2\n'; exit 0; }
+{
+  printf 'PID=%s\n' "$$"
+  printf 'ARGS:'; printf ' [%s]' "$@"; printf '\n'
+  printf 'TUNNELER_USERNAME=%s\n' "${TUNNELER_USERNAME:-}"
+  printf 'TUNNELER_HOST=%s\n' "${TUNNELER_HOST:-}"
+  printf 'PATH_FIRST=%s\n' "${PATH%%:*}"
+  printf 'SSH_AUTH_SOCK_SET=%s\n' "${SSH_AUTH_SOCK:+yes}"
+  printf 'DEBUG=%s\n' "${DEBUG:-}"
+  sed 's/^/SHIM: /' "$(command -v ssh)"
+  # ssh из PATH — обёртка туннеля; ssh -G только печатает настройки и никуда не подключается.
+  ssh -G -p 2022 "alice@2001:db8::1" 2>/dev/null | grep -E '^(serveraliveinterval|serveralivecountmax|batchmode|exitonforwardfailure|connecttimeout|hostkeyalgorithms|pubkeyacceptedalgorithms) '
+} >> "$STUB_DIR/dk.log" || true
+[ "${STUB_DK_MODE:-exit}" != sleep ] || exec sleep 30
+exit "${STUB_DK_EXIT:-0}"
+SH
+chmod 700 "$STUBS"/*
+export PATH="$STUBS:$PATH"
+reset_logs() { rm -f "$STUBS"/*.log "$STUBS/loaded.txt"; }
+
+# --- шаблоны и настройки по умолчанию ---------------------------------------------------------------------
+RENDER_STAND="$TEST_ROOT/стенд & 'рендер'"
+"$NODE_BINARY" "$SCRIPT_DIR/render-template.mjs" plist "$SCRIPT_DIR/launchd/ru.planfact.mvp.tunnel.plist.template" "$TEST_ROOT/rendered.plist" "$RENDER_STAND" "$NODE_BINARY"
+check 'шаблон агента туннеля: plutil -lint проходит' plutil -lint -- "$TEST_ROOT/rendered.plist"
+check 'шаблон агента: метка, абсолютные пути, KeepAlive только при неудаче, пауза 30 с, лог logs/tunnel.log' "$NODE_BINARY" - "$TEST_ROOT/rendered.plist" "$RENDER_STAND" <<'NODE'
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { execFileSync } = require('node:child_process');
+const [file, root] = process.argv.slice(2);
+const plist = JSON.parse(execFileSync('/usr/bin/plutil', ['-convert', 'json', '-o', '-', '--', file], { encoding: 'utf8' }));
+assert.equal(plist.Label, 'ru.planfact.mvp.tunnel');
+assert.deepEqual(plist.ProgramArguments, ['/bin/bash', path.join(root, 'bin/tunnel-run.sh')]);
+assert(plist.ProgramArguments.every((item) => path.isAbsolute(item)));
+assert.deepEqual(plist.KeepAlive, { SuccessfulExit: false });
+assert.equal(plist.RunAtLoad, true);
+assert.equal(plist.ThrottleInterval, 30);
+assert.equal(plist.WorkingDirectory, root);
+assert.equal(plist.StandardOutPath, path.join(root, 'logs/tunnel.log'));
+assert.equal(plist.StandardErrorPath, path.join(root, 'logs/tunnel.log'));
+assert.equal(plist.EnvironmentVariables.PLANFACT_HOME, root);
+assert(!/\{\{|\$|~\//.test(fs.readFileSync(file, 'utf8')));
+NODE
+check 'рядом с шаблоном лежит пустая метка .manual: install.sh не загружает агент' /bin/bash -c 'test -f "$1/ru.planfact.mvp.tunnel.plist.template.manual" && test ! -s "$1/ru.planfact.mvp.tunnel.plist.template.manual"' _ "$SCRIPT_DIR/launchd"
+check 'значения туннеля в config.env.template совпадают со значениями по умолчанию в tunnel-common.sh' /bin/bash -c '
+  . "$1/tunnel-common.sh"
+  grep -qx "PLAN_FACT_TUNNEL_HOST=$TUNNEL_DEFAULT_HOST" "$1/config.env.template" && grep -qx "PLAN_FACT_TUNNEL_REMOTE_PORT=$TUNNEL_DEFAULT_PORT" "$1/config.env.template" && grep -qx "PLAN_FACT_ALLOWED_ORIGINS='"''"'" "$1/config.env.template"
+' _ "$SCRIPT_DIR"
+
+# --- установка проверочного стенда А (без launchd) ---------------------------------------------------------
+PLANFACT_HOME="$STAND_A" /bin/bash "$SCRIPT_DIR/install.sh" --no-launchd --no-start
+check 'скрипты туннеля установлены с правами 700, тест туннеля в bin не попал' "$NODE_BINARY" - "$STAND_A" <<'NODE'
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const root = process.argv[2];
+for (const name of ['tunnel-common', 'tunnel-run', 'tunnel-check', 'enable-tunnel', 'disable-tunnel']) {
+  assert.equal(fs.statSync(`${root}/bin/${name}.sh`).mode & 0o777, 0o700, name);
+}
+assert(!fs.readdirSync(`${root}/bin`).some((name) => /^test-.*\.sh$/.test(name)));
+NODE
+check 'агент туннеля и ручная метка лежат в launchd/ стенда, права 600' /bin/bash -c '
+  test "$(stat -f %Lp "$1/launchd/ru.planfact.mvp.tunnel.plist")" = 600 && test -f "$1/launchd/ru.planfact.mvp.tunnel.manual" && plutil -lint -- "$1/launchd/ru.planfact.mvp.tunnel.plist" >/dev/null
+' _ "$STAND_A"
+check 'config.env нового стенда: адрес туннеля пока пуст, сервер и порт закреплены' /bin/bash -c '
+  grep -qx "PLAN_FACT_ALLOWED_ORIGINS='"''"'" "$1/config.env" && grep -qx "PLAN_FACT_TUNNEL_HOST=ws1-tunnelerapi.tunneler-si.yandex-team.ru" "$1/config.env" && grep -qx "PLAN_FACT_TUNNEL_REMOTE_PORT=28766" "$1/config.env"
+' _ "$STAND_A"
+# Настройки тестового стенда: свой порт, вымышленный логин и заглушка вместо dk.
+{
+  printf '\nPLAN_FACT_PORT=18769\n'
+  printf 'PLAN_FACT_TUNNEL_USERNAME=alice\n'
+  printf 'PLAN_FACT_TUNNEL_DK_BIN=%q\n' "$STUBS/dk"
+} >> "$STAND_A/config.env"
+cp "$STAND_A/config.env" "$TEST_ROOT/config-a.before"
+with_setting() {  # with_setting ИМЯ ЗНАЧЕНИЕ — временно добавляет строку в config.env стенда А (позднее значение главнее)
+  cp "$TEST_ROOT/config-a.before" "$STAND_A/config.env"
+  printf '%s=%s\n' "$1" "$2" >> "$STAND_A/config.env"
+}
+restore_config() { cp "$TEST_ROOT/config-a.before" "$STAND_A/config.env"; chmod 600 "$STAND_A/config.env"; }
+config_unchanged() { cmp -s "$TEST_ROOT/config-a.before" "$STAND_A/config.env"; }
+
+# --- tunnel-run.sh ----------------------------------------------------------------------------------------
+reset_logs
+export PLANFACT_TUNNEL_PAUSE_SECONDS=0
+run "$STAND_A/bin/tunnel-run.sh"
+check 'без метки «включён» tunnel-run.sh выходит с кодом 0 и не запускает dk' /bin/bash -c '
+  test "$1" = 0 && grep -q "Туннель не включён" "$2" && test ! -e "$3/dk.log"
+' _ "$LAST_STATUS" "$LAST" "$STUBS"
+: > "$STAND_A/launchd/.tunnel-enabled"
