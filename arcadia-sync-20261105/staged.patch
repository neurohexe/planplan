+  assert.match(detailRows(screen.dom.overviewTableBody.innerHTML, "chairs")[0], / hidden>/);
+  screen.toggle();
+  const row = detailRows(screen.dom.overviewTableBody.innerHTML, "chairs")[0];
+  assert.doesNotMatch(row, / hidden>/);
+  assert.match(text(row), /Тестовые стулья TEST1 office-a UZS 1 400 сум 200 сум 100 сум 1 100 сум/);
+  assert.match(text(screen.dom.summaryFact.innerHTML), /200 сум/);
