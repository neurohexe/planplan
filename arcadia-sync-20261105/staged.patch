@@ -0,0 +1,26 @@
+#!/bin/bash
+set -euo pipefail
+umask 077
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
+# shellcheck source=maintenance-common.sh
+. "$SCRIPT_DIR/maintenance-common.sh"
+
+finish_backup() {
+  local result=$?
+  release_data_lock
+  if [ "$result" -ne 0 ]; then
+    maintenance_log backup.log "Не удалось создать резервную копию (код $result)." || true
+  fi
+  exit "$result"
+}
+trap finish_backup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+[ "$#" -eq 0 ] || fail 'Использование: backup.sh'
+load_stand_config
+# До первого запуска базы нет: это штатный случай, без сообщений и копий.
+if [ ! -e "$PLAN_FACT_DATABASE" ] && [ ! -L "$PLAN_FACT_DATABASE" ]; then
+  exit 0
+fi
+acquire_data_lock
+NODE_NO_WARNINGS=1 "$PLAN_FACT_NODE_BIN" --experimental-sqlite "$SCRIPT_DIR/backup-store.mjs" backup "$STAND"
