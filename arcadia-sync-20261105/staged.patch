+await mkdir(join(outputRoot, "deploy", "certs"), { recursive: true });
+await copyFile(
+  join(projectRoot, "deploy", "certs", "YandexInternalRootCA.pem"),
+  join(outputRoot, "deploy", "certs", "YandexInternalRootCA.pem")
+);
