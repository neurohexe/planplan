+_TRACKER_KEY_RE = re.compile(r"TAXIASSIST-[0-9]+\Z")
+_TRACKER_URL_RE = re.compile(r"TAXIASSIST-[0-9]+", re.IGNORECASE)
+
+SERVER_MUTATIONS = frozenset({
+    "saveTrackerManualMapping", "deleteTrackerManualMapping", "addForecast", "updateForecastAllocation",
+    "releaseForecastTicket", "restoreForecastTicket", "convertForecastAllocation", "addExpense", "updateExpense",
+    "cancelExpense", "restoreExpense", "addComment", "saveBudget", "copyBudget", "addLocation", "updateLocation",
+    "archiveLocation", "deleteLocation", "addArticle", "updateArticle", "archiveArticle", "deleteArticle",
+    "addSubarticle", "updateSubarticle", "deleteSubarticle", "closePeriod", "reopenPeriod", "importBudget",
+    "importExpenses",
+})
+
+CURRENT_ACTOR_NAME = "Не указано"  # currentActorName() на сервере: ни пользователя страницы, ни профиля нет
+
+
+def _p(payload: dict, key: str) -> Any:
+    return payload.get(key, UNDEF)
+
+
+def tracker_issue_key_from_ticket(ticket: Any) -> str:
+    explicit = normalize_code(
+        or_(og(ticket, "trackerIssueKey"), og(ticket, "sourceTicketKey") if og(ticket, "sourceType") == tracker_sync.SOURCE_TYPE else "")
+    )
+    if _TRACKER_KEY_RE.match(explicit):
+        return explicit
+    match = _TRACKER_URL_RE.search(S(or_(og(ticket, "ticketUrl"), "")))
+    return normalize_code(match.group(0) if match else UNDEF)
+
+
+def linked_forecast_expenses(current: dict, ticket_id: Any, allocation_id: Any) -> list:
+    return [
+        expense for expense in or_(current.get("expenses", UNDEF), [])
+        if og(expense, "status") != "canceled"
+        and strict_eq(og(expense, "forecastTicketId"), ticket_id)
+        and strict_eq(og(expense, "forecastAllocationId"), allocation_id)
+    ]
+
+
+def _amount_or_zero(value: Any) -> Any:
+    number = to_number(value)
+    return number if truthy(number) else 0
+
+
+def refresh_forecast_conversion_state(current: dict, ticket: dict, allocation: dict) -> None:
+    linked = linked_forecast_expenses(current, ticket.get("id", UNDEF), allocation.get("id", UNDEF))
+    spent: Any = 0
+    for expense in linked:
+        spent = add(spent, _amount_or_zero(og(expense, "amount")))
+    epsilon = js_max(0.01, js_abs(_amount_or_zero(og(allocation, "amount"))) * 1e-9)
+    allocation["convertedExpenseIds"] = tail([og(expense, "id") for expense in linked], 100)
+    allocation["convertedExpenseId"] = or_(og(last(linked), "id") if linked else UNDEF, None)
+    allocation["convertedAmount"] = spent
+    planned = to_number(or_(og(allocation, "amount"), 0))
+    if not (og(allocation, "lifecycle") == "released" and og(allocation, "lifecycleSource") == "manual"):
+        if spent + epsilon >= planned:
+            allocation["lifecycle"] = "converted"
+            allocation["lifecycleSource"] = "conversion"
+            allocation["releaseReason"] = f"Оплата превысила резерв на {S(sub(spent, planned))}" if spent > planned + epsilon else ""
+        elif spent > epsilon:
+            allocation["lifecycle"] = "active"
+            allocation["lifecycleSource"] = "conversion"
+            allocation["releaseReason"] = f"Частично оплачено: {S(spent)}; осталось в резерве: {S(sub(planned, spent))}"
+        else:
+            if og(ticket, "sourceType") == expense_import.SOURCE_TYPE:
+                allocation["lifecycle"] = expense_import.forecast_status_lifecycle(og(allocation, "sourceStatus"), og(allocation, "amount"))
+            else:
+                allocation["lifecycle"] = "active"
+            allocation["lifecycleSource"] = "source"
+            allocation["releaseReason"] = ""
+    ticket["lifecycle"] = expense_import.ticket_lifecycle(ticket.get("allocations", UNDEF))
+
+
+def budget_import_records(current: dict) -> dict:
+    return {key: clone(or_(current.get(key, UNDEF), [])) for key in ("expenses", "forecastTickets", "comments")}
+
+
+def _same_fields(left: dict, right: dict, fields: tuple) -> bool:
+    return all(not has_own(left, field) or strict_eq(left[field], og(right, field)) for field in fields)
+
+
+def preserve_budget_import_records(original: dict, normalized_records: dict, imported: dict) -> None:
+    def fail() -> None:
+        raise DomainError(
+            "Импорт отменён: он может изменить или удалить записанные расходы, прогнозы или комментарии. Данные не сохранены.",
+            400, "budget_import_changes_records",
+        )
+
+    for key in ("expenses", "forecastTickets", "comments"):
+        before = or_(original.get(key, UNDEF), [])
+        after = or_(imported.get(key, UNDEF), [])
+        if dumps(normalized_records[key]) != dumps(after) or len(before) != len(after):
+            fail()
+        by_id: dict = {}
+        for item in after:
+            by_id[og(item, "id")] = item
+        before_ids = uniq(og(item, "id") for item in before)
+        if len(by_id) != len(after) or len(before_ids) != len(before) or any(og(item, "id") not in by_id for item in before):
+            fail()
+        if key == "expenses" and any(
+            not _same_fields(item, by_id[og(item, "id")], (
+                "locationId", "articleId", "subarticleId", "amount", "currency", "expenseDate", "quarterKey", "status",
+            )) for item in before
+        ):
+            fail()
+        if key == "forecastTickets":
+            for ticket in before:
+                allocations = or_(og(ticket, "allocations"), [])
+                imported_allocations = or_(og(by_id[og(ticket, "id")], "allocations"), [])
+                allocations_by_id: dict = {}
+                for item in imported_allocations:
+                    allocations_by_id[og(item, "id")] = item
+                if (len(allocations) != len(imported_allocations) or len(allocations_by_id) != len(allocations)
+                        or len(uniq(og(item, "id") for item in allocations)) != len(allocations)):
+                    fail()
+                if any(
+                    og(item, "id") not in allocations_by_id or not _same_fields(item, allocations_by_id[og(item, "id")], (
+                        "locationId", "articleId", "subarticleId", "amount", "currency", "expectedDate", "quarterKey", "lifecycle",
+                    )) for item in allocations
+                ):
+                    fail()
+    imported.update(budget_import_records(original))
+
+
+def resolve_subarticle(article: Any, subarticle_id: Any) -> Any:
+    active = [item for item in or_(og(article, "subarticles"), []) if not truthy(og(item, "archived"))]
+    if not active:
+        return None
+    if not truthy(subarticle_id) and len(active) == 1:
+        return og(active[0], "id")
+    if not truthy(subarticle_id):
+        raise DomainError("Выберите статью проекта")
+    found = next((item for item in active if strict_eq(og(item, "id"), subarticle_id)), None)
+    if found is None:
+        raise DomainError("Статья проекта не найдена")
+    return og(found, "id")
+
+
+def resolve_optional_subarticle(article: Any, subarticle_id: Any) -> Any:
+    if not truthy(subarticle_id):
+        return None
+    return resolve_subarticle(article, subarticle_id)
+
+
+def planned_currencies_for_selection(current: dict, location_id: Any, quarter: Any, article_id: Any, subarticle_id: Any) -> list[str]:
+    store = or_(og(og(current, "budgets"), budget_store_key(location_id, quarter)), {})
+    if truthy(subarticle_id):
+        return sort_strings(keys(normalize_currency_amounts(og(store, pk(budget_item_key(article_id, subarticle_id))), DEFAULT_CURRENCY)))
+    currencies = uniq(keys(normalize_currency_amounts(og(store, pk(article_id)), DEFAULT_CURRENCY)))
+    prefix = f"{S(article_id)}|"
+    for item_key, amounts in entries(store) if is_dict(store) or is_list(store) else []:
+        if not item_key.startswith(prefix):
+            continue
+        currencies = uniq([*currencies, *keys(normalize_currency_amounts(amounts, DEFAULT_CURRENCY))])
+    return sort_strings(currencies)
+
+
+def _find(items: Any, predicate) -> Any:
+    for item in or_(items, []):
+        if predicate(item):
+            return item
+    return None
+
