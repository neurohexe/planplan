+def _save_budget(nxt: dict, payload: dict, now: str) -> None:
+    quarter = _p(payload, "quarterKey")
+    if not period_locks.test(_QUARTER_RE, quarter):
+        raise DomainError("Некорректный квартал")
+    period_locks.assert_quarter_editable(nxt, quarter)
+    location_id = _p(payload, "locationId")
+    if not truthy(location_id) or strict_eq(location_id, ALL_LOCATIONS):
+        raise DomainError("Выберите локацию")
+    store_key = f"{S(location_id)}|{S(quarter)}"
+    if not truthy(og(nxt["budgets"], store_key)):
+        nxt["budgets"][store_key] = {}
+    if not truthy(nxt.get("monthlyBudgets", UNDEF)):
+        nxt["monthlyBudgets"] = {}
+    if not truthy(og(nxt["monthlyBudgets"], store_key)):
+        nxt["monthlyBudgets"][store_key] = {}
+    items = _p(payload, "items") if is_list(_p(payload, "items")) else []
+    item_keys = _p(payload, "itemKeys")
+    if is_list(item_keys):
+        touched = list(item_keys)
+    else:
+        touched = []
+        for item in items:
+            article = _find(nxt["articles"], lambda candidate: strict_eq(og(candidate, "id"), g(item, "articleId")))
+            touched.append(budget_item_key(g(item, "articleId"), resolve_subarticle(article, g(item, "subarticleId"))))
+    budgets_store = nxt["budgets"][store_key]
+    monthly_store = nxt["monthlyBudgets"][store_key]
+    for item_key in uniq(touched):
+        if is_dict(budgets_store):
+            budgets_store.pop(pk(item_key), None)
+        if is_dict(monthly_store):
+            monthly_store.pop(pk(item_key), None)
+    for item in items:
+        article = _find(nxt["articles"], lambda candidate: strict_eq(og(candidate, "id"), g(item, "articleId")))
+        if article is None or truthy(og(article, "archived")):
+            continue
+        subarticle_id = resolve_subarticle(article, g(item, "subarticleId"))
+        item_key = pk(budget_item_key(article["id"], subarticle_id))
+        currency = normalize_currency_code(og(item, "currency"))
+        if not currency:
+            raise DomainError("Проверьте валюты и суммы бюджета")
+        if not truthy(og(budgets_store, item_key)):
+            budgets_store[item_key] = {}
+        if has_own(budgets_store[item_key], currency):
+            raise DomainError(f"Валюта {currency} повторяется у статьи проекта {S(or_(og(article, 'code'), og(article, 'name')))}")
+        months = og(item, "months")
+        if truthy(months) and is_dict(months):
+            closed_month = next(
+                (month_key for month_key in quarter_month_keys(quarter) if period_locks.is_month_closed(nxt, month_key)), None
+            )
+            if closed_month:
+                raise DomainError(f"Нельзя менять помесячный план: месяц {closed_month} закрыт. Сначала переоткройте его.")
+            validated = _validate_month_amounts(months, quarter)
+            if not truthy(og(monthly_store, item_key)):
+                monthly_store[item_key] = {}
+            monthly_store[item_key][currency] = validated
+            budgets_store[item_key][currency] = sum_month_amounts(validated, quarter)
+        else:
+            amount = to_number(og(item, "amount"))
+            if not is_finite(amount) or amount < 0:
+                raise DomainError("Проверьте валюты и суммы бюджета")
+            budgets_store[item_key][currency] = amount
+    if not keys(nxt["monthlyBudgets"][store_key]):
+        nxt["monthlyBudgets"].pop(store_key, None)
+
+
+def _validate_month_amounts(value: Any, quarter: Any) -> dict:
+    month_keys = quarter_month_keys(quarter)
+    supplied = list(value.keys()) if truthy(value) and is_dict(value) else []
+    if len(month_keys) != 3 or len(supplied) != 3 or any(key not in month_keys for key in supplied):
+        raise DomainError("Помесячный план не соответствует выбранному кварталу")
+    result = {}
+    for month_key in month_keys:
+        amount = to_number(value.get(month_key, UNDEF))
+        if not is_finite(amount) or amount < 0:
+            raise DomainError("Проверьте помесячные суммы бюджета")
+        result[month_key] = amount
+    return result
+
