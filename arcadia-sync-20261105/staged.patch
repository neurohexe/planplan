+class AccessCodeCommandTests(ServiceTestMixin, TestCase):
+    def run_issue(self, login: str) -> tuple[int, str, str]:
+        out, err = io.StringIO(), io.StringIO()
+        try:
+            call_command("issue_access_code", login, stdout=out, stderr=err)
+            return 0, out.getvalue(), err.getvalue()
+        except SystemExit as exit_error:
+            return int(exit_error.code or 0), out.getvalue(), err.getvalue()
+
+    def setUp(self) -> None:
+        super().setUp()
+        self._settings = self.settings(PLAN_FACT=self.config)
+        self._settings.enable()
+
+    def tearDown(self) -> None:
+        self._settings.disable()
+        super().tearDown()
+
+    def test_writes_private_file_and_prints_only_the_path(self):
+        with mock.patch("sys.stderr", new_callable=io.StringIO):
+            status, output, _ = self.run_issue("alice")
+        self.assertEqual(status, 0)
+        directory = self.config.codes_dir
+        path = directory / "alice.txt"
+        self.assertEqual(output.strip(), str(path))
+        self.assertEqual(stat.S_IMODE(directory.stat().st_mode), 0o700)
+        self.assertEqual(stat.S_IMODE(path.stat().st_mode), 0o600)
+        code, note = path.read_text(encoding="utf-8").splitlines()
+        self.assertRegex(code, CODE_RE)
+        self.assertNotIn(code, output)
+        self.assertIn("Никому не пересылайте", note)
+        self.assertTrue(self.login("alice", code)["token"])
+
+    def test_fixes_loose_directory_permissions_and_replaces_the_file(self):
+        directory = self.config.codes_dir
+        directory.mkdir(mode=0o755)
+        os.chmod(directory, 0o755)
+        (directory / "alice.txt").write_text("old\n")
+        self.assertEqual(self.run_issue("alice")[0], 0)
+        self.assertEqual(stat.S_IMODE(directory.stat().st_mode), 0o700)
+        self.assertNotEqual((directory / "alice.txt").read_text().splitlines()[0], "old")
+        self.assertEqual([item.name for item in directory.iterdir()], ["alice.txt"])
+
+    def test_refuses_unsafe_logins_without_writing_anything(self):
+        for login in ("../evil", "a/b", "..", "alice..bob", "", "ALICE\\x"):
+            with mock.patch("sys.stderr", new_callable=io.StringIO):
+                status, output, _ = self.run_issue(login)
+            self.assertEqual(status, 1, login)
+            self.assertEqual(output, "")
+        self.assertFalse(self.config.codes_dir.exists())
+
+    def test_leaves_no_temporary_files_when_the_write_fails(self):
+        with mock.patch("planfact.management.commands.issue_access_code.os.fsync", side_effect=OSError(28, "No space left on device")):
+            with mock.patch("sys.stderr", new_callable=io.StringIO) as err:
+                status, _, _ = self.run_issue("alice")
+        self.assertEqual(status, 1)
+        self.assertIn("Прежний код уже недействителен", err.getvalue())
+        self.assertEqual(list(self.config.codes_dir.iterdir()), [])
